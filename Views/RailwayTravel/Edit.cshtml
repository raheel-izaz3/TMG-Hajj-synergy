                                    <div class="col-sm-12 mb-3">
                                        <label class="form-label" for="basic-icon-default-fullname">Select Packages</label>
                                        <br />
                                        @{
                                            int i = 0;
                                        }
                                        @foreach (var package in ViewBag.Packages)
                                        {
                                            bool found = false;
                                            foreach (RailwayTravelPackages fp in ViewBag.RailwayTravelPackages)
                                            {
                                                if (fp.PackageId == package.PackageId)
                                                {
                                                    found = true;
                                                    break;
                                                }
                                            }

                                            <div class="form-check form-check-inline">
                                                <input type="hidden" value="@package.PackageId"
                                                       asp-for="PackageIds" />

                                                @if (found)
                                                {
                                                    <input class="form-check-input"
                                                           type="checkbox" id="@package.PackageId"
                                                           asp-for="PackagesSelected[i]" checked>
                                                }
                                                else
                                                {
                                                    <input class="form-check-input"
                                                           type="checkbox" id="@package.PackageId"
                                                           asp-for="PackagesSelected[i]">
                                                }

                                                <label class="form-check-label"
                                                       for="@package.PackageId">@package.Name</label>
                                            </div>
                                            i++;
                                        }
                                    </div>


                                </div>


