@model RailwayIndexModel
@{
    string modelName = "Train Travel";
    string modelNamePlural = "Train Travels";
    string modelControllerRoute = "RailwayTravel";
}

@if (TempData.ContainsKey("created"))
{
    if ((bool)TempData["created"]! == true)
    {
        <script>
            toastr.options.closeDuration = 100;
            toastr.options.closeButton = true;
            toastr.options.positionClass = "toast-top-center";
            toastr.options.showMethod = 'slideDown';
            toastr.options.hideMethod = 'slideUp';
            toastr.options.closeMethod = 'slideUp';
            toastr.success('', '@modelName Created Successfully!', { timeOut: 2000 })
        </script>
        TempData["created"] = false;
    }
}
@if (TempData.ContainsKey("deleted"))
{
    if ((bool)TempData["deleted"]! == true)
    {
        <script>
            toastr.options.closeDuration = 100;
            toastr.options.closeButton = true;
            toastr.options.positionClass = "toast-top-center";
            toastr.options.showMethod = 'slideDown';
            toastr.options.hideMethod = 'slideUp';
            toastr.options.closeMethod = 'slideUp';
            toastr.success('', '@modelName Trashed Successfully!', { timeOut: 2000 })
        </script>
        TempData["deleted"] = false;
    }
}
@if (TempData.ContainsKey("updated"))
{
    if ((bool)TempData["updated"]! == true)
    {
        <script>
            toastr.options.closeDuration = 100;
            toastr.options.closeButton = true;
            toastr.options.positionClass = "toast-top-center";
            toastr.options.showMethod = 'slideDown';
            toastr.options.hideMethod = 'slideUp';
            toastr.options.closeMethod = 'slideUp';
            toastr.success('', '@modelName Updated Successfully!', { timeOut: 2000 })
        </script>
        TempData["updated"] = false;
    }
}

<div class="container-xxl flex-grow-1 container-p-y">
    <h4 class="fw-bold"><span class="text-muted fw-light"></span> @modelNamePlural</h4>

    <hr class="mb-4" />

    @* @if (ViewBag.CreateAllowed == true)
    { *@
    <a asp-action="Create" class="btn btn-info">Create New</a>
    @* }
    @if (ViewBag.RestoreAllowed == true)
    { *@
    <a asp-action="ViewTrash" class="btn btn-info float-end"><i class="bx bx-trash me-1"></i> Trash (@ViewBag.TrashCount)</a>
    @* } *@
    <br />
    <br />
    <div class="card p-2">
        <div class="table-responsive text-nowrap ">
            <table class="table table-hover" id="table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Train</th>
                        <th>Train #</th>
                        <th>Departure</th>
                        <th>Arrival</th>
                        <th>Economy / Business</th>
                        <th>Bookings</th>
                        <th>Balance</th>
                        <th>Packages</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody class="table-border-bottom-1">
                    @foreach (RailwayIndexEntryModel railwayTravel in Model.Entries)
                    {
                        <tr>
                            <td>
                                <i class="fab fa-bootstrap fa-lg text-primary me-3"></i> <strong>@railwayTravel.RailwayTravelId</strong>
                            </td>
                            <td>@railwayTravel.RailwayName</td>
                            <td>@railwayTravel.TrainNumber</td>
                            <td>@railwayTravel.DepartureDateTime</td>
                            <td>@railwayTravel.ArrivalDateTime</td>
                            <td>@railwayTravel.Economy / @railwayTravel.Business</td>
                            <td>@railwayTravel.EconomyBookings / @railwayTravel.BusinessBookings</td>
                            <td>@railwayTravel.EconomyBalance / @railwayTravel.BusinessBalance</td>
                            <td>
                                <ul>
                                    @foreach (string p in railwayTravel.Packages)
                                    {
                                        <li>@p</li>
                                    }
                                </ul>
                            </td>
                            <td>
                                <div class="dropdown">
                                    <a class="btn btn-info"
                                       asp-action="PNRList" asp-route-id="@railwayTravel.RailwayTravelId">
                                        <i class="bx bx-list-ol me-1"></i> PNRs
                                    </a>

                                    <div class="btn-group" id="dropdown-icon-demo">
                                        <button type="button" class="btn btn-primary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                                            <i class="bx bxs-report"></i> Reports
                                        </button>
                                        <ul class="dropdown-menu" style="">
                                            <li>
                                                <a asp-controller="RailwayTravel"
                                                   asp-action="PNRReport"
                                                   asp-route-id="@railwayTravel.RailwayTravelId"
                                                   class="dropdown-item d-flex align-items-center">
                                                    1. Travel Report
                                                </a>
                                            </li>
                                            <li>
                                                <a asp-controller="RailwayTravel"
                                                   asp-action="PNRReportV2"
                                                   asp-route-id="@railwayTravel.RailwayTravelId"
                                                   class="dropdown-item d-flex align-items-center">
                                                    2. Travel Report V2
                                                </a>
                                            </li>
                                        </ul>
                                    </div>


                                    @* @if (ViewBag.EditAllowed == true)
                                { *@
                                    <a class="btn btn-warning" asp-action="Edit" asp-route-id="@railwayTravel.RailwayTravelId"><i class="bx bx-edit-alt me-1"></i> Edit</a>
                                    @* }
                                @if (ViewBag.TrashAllowed == true)
                                { *@
                                    <button onclick="confirmDelete(@railwayTravel.RailwayTravelId)"
                                            class="btn btn-outline-danger">
                                        <i class="bx bx-trash me-1"></i> Trash
                                    </button>
                                    @* } *@
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
<script>
    function confirmDelete(id) {
        let del = confirm("Are you sure?")
        if (del) {
            location.href = `/@modelControllerRoute/Trash/${id}`;
        }
    }

    let table = new DataTable('#table', {
    });
</script>

