    <!-- Summernote JS -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/summernote/0.8.18/summernote-lite.min.js"></script>

    <script>
        $(document).ready(function () {
            $.ajax({
                url: '/Admin/GetSelectedHajjSeason',
                type: 'GET',
                success: function (sessionResponse) {
                    var selectedSessionId = sessionResponse.selectedSessionId;

                    $.ajax({
                        url: '/Admin/GetHajjSeasons',
                        type: 'GET',
                        success: function (response) {
                            var select = $('#hajjSeason');
                            select.empty();

                            $.each(response, function (index, item) {
                                var option = $('<option>', {
                                    value: item.id,
                                    text: item.name
                                });

                                if (item.id == selectedSessionId) {
                                    option.attr('selected', 'selected');
                                }

                                select.append(option);
                            });
                        },
                        error: function (xhr, status, error) {
                            console.error('AJAX Error:', error);
                        }
                    });
                },
                error: function (xhr, status, error) {
                    console.error('AJAX Error:', error);
                }
            });

            $('#hajjSeason').on('change', function () {
                var selectedValue = $(this).val();

                $.ajax({
                    url: '/Admin/SetHajjSessions',
                    type: 'POST',
                    data: { sessionId: selectedValue },
                    success: function (response) {
                        if (response.success) {
                            window.location.reload()
                            console.log(response.message);
                        }
                    },
                    error: function (xhr, status, error) {
                        console.error('AJAX Error:', error);
                    }
                });
            });
        });

    </script>

</body>

