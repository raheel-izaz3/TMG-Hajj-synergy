<script>
    function calculateDaysNights(element) {
        // Get the parent div with class 'row'
        let row = element.closest('.row');

        // Get the check-in and check-out times
        let checkInTime = row.querySelector('[name="AccomodationActualCheckInTime[]"]').value;
        let checkOutTime = row.querySelector('[name="AccomodationActualCheckOutTime[]"]').value;

        // If both check-in and check-out times are available
        if (checkInTime && checkOutTime) {
            let checkInDate = new Date(checkInTime);
            let checkOutDate = new Date(checkOutTime);

            // Ensure check-out is after check-in
            if (checkOutDate > checkInDate) {
                // Get only the date (ignore time) for accurate calculation
                let checkInDateOnly = new Date(checkInDate.getFullYear(), checkInDate.getMonth(), checkInDate.getDate());
                let checkOutDateOnly = new Date(checkOutDate.getFullYear(), checkOutDate.getMonth(), checkOutDate.getDate());

                // Calculate total days and nights
                let timeDifference = checkOutDateOnly - checkInDateOnly;
                let totalDays = Math.ceil(timeDifference / (1000 * 60 * 60 * 24)) + 1; // +1 to include check-in day
                let totalNights = totalDays - 1; // Nights are one less than days

                // Set the calculated values
                row.querySelector('[name="AccomodationDays[]"]').value = totalDays;
                row.querySelector('[name="AccomodationNights[]"]').value = totalNights;
            } else {
                alert("Check-out date and time must be after check-in date and time.");
                row.querySelector('[name="AccomodationDays[]"]').value = 0;
                row.querySelector('[name="AccomodationNights[]"]').value = 0;
            }
        }
    }



