<script>
    function searchFriend() {
        const inputCNIC = document.querySelector("#FriendCNIC")
        const cnic = inputCNIC.value

        const inputSurName = document.querySelector("#FriendSurName")
        const inputGivenName = document.querySelector("#FriendGivenName")
        const inputGender = document.querySelector("#FriendGender")
        const inputPassportNumber = document.querySelector("#FriendPassportNumber")


        $.ajax({
            url: "/FamilyHead/GetFriend/",
            method: "GET",
            data: {
                cnic: cnic
            },
            success: res => {
                if (res.status == 200) {
                    console.log(res.data.surName)
                    inputSurName.value = res.data.surName
                    inputGivenName.value = res.data.givenName
                    inputGender.value = res.data.gender
                    inputPassportNumber.value = res.data.passport
                }
                else if (res.status == 201) {
                    alert(res.msg)
                    inputSurName.value = ""
                    inputGivenName.value = ""
                    inputGender.value = ""
                    inputPassportNumber.value = ""
                }
            },
            error: err => {
                console.log(err)
            }
        })
    }

