@model RailwayPNRAddMembersModel

@{
    string modelName = "PNR";
    string modelNamePlural = "PNRs";
    string modelControllerRoute = "RailwayPNR";
}

@if (TempData.ContainsKey("created"))
{
    if ((bool)TempData["created"]! == true)
    {
        <script>
            toastr.options.closeDuration = 100;
            toastr.options.closeButton = true;
            toastr.options.positionClass = "toast-top-center";
            toastr.options.showMethod = 'slideDown';
            toastr.options.hideMethod = 'slideUp';
            toastr.options.closeMethod = 'slideUp';
            toastr.success('', '@modelName Created Successfully!', { timeOut: 2000 })
        </script>
        TempData["created"] = false;
    }
}
@if (TempData.ContainsKey("deleted"))
{
    if ((bool)TempData["deleted"]! == true)
    {
        <script>
            toastr.options.closeDuration = 100;
            toastr.options.closeButton = true;
            toastr.options.positionClass = "toast-top-center";
            toastr.options.showMethod = 'slideDown';
            toastr.options.hideMethod = 'slideUp';
            toastr.options.closeMethod = 'slideUp';
            toastr.success('', '@modelName Trashed Successfully!', { timeOut: 2000 })
        </script>
        TempData["deleted"] = false;
    }
}
@if (TempData.ContainsKey("updated"))
{
    if ((bool)TempData["updated"]! == true)
    {
        <script>
            toastr.options.closeDuration = 100;
            toastr.options.closeButton = true;
            toastr.options.positionClass = "toast-top-center";
            toastr.options.showMethod = 'slideDown';
            toastr.options.hideMethod = 'slideUp';
            toastr.options.closeMethod = 'slideUp';
            toastr.success('', '@modelName Updated Successfully!', { timeOut: 2000 })
        </script>
        TempData["updated"] = false;
    }
}

<div class="container-xxl flex-grow-1 container-p-y">
    <h4 class="fw-bold">Add / Remove Members To PNR</h4>

    <hr class="mb-4" />

    <div class="row mb-3">
        <div class="col-sm-12 col-md-3">
            <label class="fw-bold">Train</label>
            <p>@Model.Railway</p>
        </div>
        <div class="col-sm-12 col-md-3">
            <label class="fw-bold">PNR</label>
            <p>@Model.PNR</p>
        </div>
        <div class="col-sm-12 col-md-3">
            <label class="fw-bold">PNR PAX</label>
            <p>@Model.PAX</p>
        </div>
        <div class="col-sm-12 col-md-3">
            <label class="fw-bold">Selected</label>
            <p id="selected">@Model.Selected</p>
        </div>
        <div class="col-sm-12 col-md-6">
            <label class="fw-bold">Departure - Arrival</label>
            <p>@Model.DepartureArrivalDateTime</p>
        </div>
    </div>

    <button onclick="distribute()" class="btn btn-info">Distribute Families</button>
    <br><br>

    <div class="card p-2">
        <div class="table-responsive text-nowrap ">
            <table class="table table-hover" id="table">
                <thead>
                    <tr>
                        <th></th>
                        <th>Company Code</th>
                        <th>Package</th>
                        <th>F ID</th>
                        <th>C ID</th>
                        <th>Name</th>
                        <th>Age</th>
                        <th>Gender</th>
                        <th>Passport</th>
                        <th>Passport D.O.E</th>
                    </tr>
                </thead>
                <tbody class="table-border-bottom-1" id="table">
                    @foreach (RailwayPNRMemberModel m in Model.Entries)
                    {
                        string textAlign = m.IsHead ? "left" : "right";
                        string border = m.IsHead ? "border-top: 2px solid black" : "";
                        string selected = m.Selected ? "checked" : "";

                        string disabled = "";
                        if (m.InSamePnr is null)
                        {
                            disabled = "";
                        }
                        else if (m?.InSamePnr == true)
                        {
                            disabled = "";
                        }
                        else if (m?.InSamePnr == false)
                        {
                            disabled = "disabled";
                        }

                        <tr>
                            <td>
                                <input class="form-check-input" name="selected[]" @disabled
                                       onchange="updateSelected(this, @m.FamilyHeadId, @Model.PNRId)"
                                       type="checkbox" data-is-head="@m.IsHead"
                                       data-hb-number="@m.FamilyHeadId" data-head-id="@m.HeadId" @selected />
                            </td>
                            <td style="text-align: @textAlign; @border;">@m.Company</td>
                            <td style="text-align: @textAlign; @border;">@m.Package</td>
                            <td style="text-align: @textAlign; @border;">@m.FCId</td>
                            <td style="text-align: @textAlign; @border;">@m.CId</td>
                            <td style="text-align: @textAlign; @border;">@m.Name</td>
                            <td style="text-align: @textAlign; @border;">@m.Age</td>
                            <td style="text-align: @textAlign; @border;">@m.Gender</td>
                            <td style="text-align: @textAlign; @border;">@m.Passport</td>
                            <td style="text-align: @textAlign; @border;">@m.PassportExpiry</td>
                        </tr>
                    }

                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    let table = new DataTable('#table', {
        dom: 'fp',
        paging: false,
        lengthChange: false
    });

    function updateSelectedCount() {
        const selectedCheckboxes = $('input:checkbox[name="selected[]"]:checked');
        $("#selected").html(selectedCheckboxes.length);
    }

    function updateSelected(elem, familyHeadId, pnrId) {

        const MAX = @Model.PAX;

        const selectedCheckboxes = $('input:checkbox[name="selected[]"]:checked');

        const length = selectedCheckboxes.length;

        if (length > MAX) {
            alert("Limit Exceeded");
            elem.checked = false
            return;
        }

        updateSelectedCount()

        const isHead = elem.getAttribute("data-is-head")
        const headId = elem.getAttribute("data-head-id")
        const elemFcId = elem.getAttribute("data-hb-number")

        if (isHead == "True" && elem.checked) {
            const attributeName = 'data-head-id';
            const elements = document.querySelectorAll(`[${attributeName}="${headId}"]`);

            if ((elements.length - 1) + length > @Model.PAX) {
                if (confirm("Cannot select this family. Limit will exceed. would you like to proceed w/ selection?")) {
                    elem.checked = true;
                    addMember(pnrId, fcId)
                    updateSelectedCount()
                    return;
                }
                else {
                    elem.checked = false
                    removeMember(pnrId, fcId)
                    updateSelectedCount()
                    return;
                }
            }

            if (elem.checked) {
                for (let check of elements) {
                    if (check.hasAttribute('disabled')) continue;
                    check.checked = true
                    let fcId = check.getAttribute('data-hb-number')
                    addMember(pnrId, fcId)
                }
            }
            else {
                elem.checked = false;
                removeMember(pnrId, elemFcId)
            }
            updateSelectedCount()
        }
        else if (elem.checked && isHead == "False") {
            addMember(pnrId, elemFcId)
        }
        else {
            removeMember(pnrId, elemFcId)
        }

        // if (elem.checked) {

        // }
        // else {

        // }

    }

    function addMember(pnrId, familyHeadId) {
        $.ajax({
            url: "/RailwayPNR/AddMember",
            method: "POST",
            data: {
                familyHeadId: familyHeadId,
                pnrId: pnrId
            },
            success: res => {
                console.log(res)
            },
            error: err => {
                console.log(err)
            }
        });
    }

    function removeMember(pnrId, familyHeadId) {
        $.ajax({
            url: "/RailwayPNR/RemoveMember",
            method: "post",
            data: {
                familyHeadId: familyHeadId,
                pnrId: pnrId
            },
            success: res => {
                console.log(res)
            },
            error: err => {
                console.log(err)
            }
        });
    }

    function distribute() {
        if (!confirm("Are you sure?")) return

        const familyHeads = document.querySelectorAll(`[data-is-head="True"]`)
        const limit = @Model.PAX

            const selectedCheckboxes = $('input:checkbox[name="selected[]"]:checked');
        const length = selectedCheckboxes.length;
        let pnrId = @Model.PNRId;

        // reset all checks
        for (let check of selectedCheckboxes) {
            if (check.hasAttribute('disabled')) continue;

            let fcId = check.getAttribute('data-hb-number');

            if (check.checked) removeMember(pnrId, fcId)
            check.checked = false
        }

        // loop over all family heads
        for (let fh of familyHeads) {
            const selectedCheckboxes = $('input:checkbox[name="selected[]"]:checked');
            const length = selectedCheckboxes.length;

            let headId = fh.getAttribute("data-head-id")
            const familyMembers = document.querySelectorAll(`[data-head-id="${headId}"]`)
            const memberCount = familyMembers.length

            if ((memberCount + length) > @Model.PAX) {
                continue
            }

            // loop over all members of the current family head
            for (let m of familyMembers) {
                if (m.hasAttribute('disabled')) continue;
                if (m.checked) continue;

                m.checked = true
                let fcId = m.getAttribute('data-hb-number')
                addMember(pnrId, fcId)
            }
        }
        updateSelectedCount()
    }
</script>




