    </style>

    <script>
        function showCalendar(elem) {
            const calendarElems = document.getElementsByClassName('calendar')
            if (elem.checked) {
                for (let e of calendarElems) {
                    e.style.display = ''
                }
            }
            else {
                for (let e of calendarElems) {
                    e.style.display = 'none'
                }
            }
        }
    </script>

</head>


<body>

    <h1 style="text-align: center; margin-bottom: 30px;">Before Hajj</h1>
    <br />
    <div id="myTable" class="myTable" style="margin-bottom: 30px;" id="summaryData">

        <table id="table1" class="display nowrap" style="width: 100%;">

            <thead>
                <tr>
                    <th>Munazzim Name</th>
                    <th>Co</th>
                    <th>Package</th>
                    <th>Pax</th>
                    <th>Med_ChkIn</th>
                    <th>Med_ChkOut</th>
                    <th>Mak_ChkIn</th>
                    <th>Mak_ChkOut</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model)
                {
                    <tr>
                        <td>@row.MunazzimName</td>
                        <td>@row.CompanyCode</td>
                        <td>@row.PackageName</td>
                        <td>@row.Pax</td>
                        <td>@row.MedinaCheckIn</td>
                        <td>@row.MedinaCheckOut</td>
                        <td>@row.MakkahCheckIn</td>
                        <td>@row.MakkahCheckOut</td>

                    </tr>
                }


            </tbody>
        </table>
    </div>
    <script>
        // Initialize DataTable
        $(document).ready(function () {
            $('#table1').DataTable({
                dom: 'Bfrtip',
                buttons: [{
                    text: 'Export to Excel',
                    extend: 'excelHtml5',
                    className: 'btn btn-dark',
                    exportOptions: {
                        columns: ':visible'
                    }
                }],
                "scrollCollapse": true,
                "paging": false, // Disable pagination if necessary
                "info": false,
                "ordering": true,
            });
        });
    </script>
</body>

</html>