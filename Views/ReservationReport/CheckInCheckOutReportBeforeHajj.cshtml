}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hotel-Summary</title>
    <!-- Jquery  -->
    <script src="https://code.jquery.com/jquery-1.11.3.min.js"></script>

    <!-- Data Tables.min.js  -->
