<div class="container-xxl flex-grow-1 container-p-y">
    <h4 class="fw-bold" style="color:  #404040;"><span class="text-muted fw-light">Daily Hotel Summary Selection</span>
    </h4>

    <hr class="mb-4" />

    <div class="row">
        <div class="col-sm-12">
            <div class="card">
                <div class="card-body">
                    <form method="get" action="DailyHotelRoomSummary">
                        <div class="row">
                            <div class="col-sm-12 col-md-4 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname">Hotel</label>
                                <div class="input-group input-group-merge">
                                    <select class="form-control" name="HotelId" required id="select-hotel">
                                        @foreach (Hotel hotel in ViewBag.Hotels)
                                        {
                                            <option value="@hotel.HotelId">@hotel.HotelName</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="col-sm-12 col-md-4 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname">Medina Arrival</label>
                                <div class="input-group input-group-merge">
                                    <select class="form-control" id="select-company" name="MedinaArrival" required>
                                        <option value="BEFORE">BEFORE HAJJ</option>
                                        <option value="AFTER">AFTER HAJJ</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-sm-12 col-md-4 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname">Date</label>
                                <div class="input-group input-group-merge">
                                    <input class="form-control" name="Date" type="date" required />
                                </div>
                            </div>
                            <div class="col-sm-12 mt-4">
                                <button type="submit" class="btn btn-success float-end">Search</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>