@model List<PlaceAndPackageWiseCheckInCheckOut>
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CheckIn/CheckOut-Summary</title>
    <!-- Jquery  -->
    <script src="https://code.jquery.com/jquery-1.11.3.min.js"></script>

    <!-- Data Tables.min.js  -->
    <script type="text/javascript"
            src="https://cdn.datatables.net/v/dt/jszip-2.5.0/dt-1.10.16/b-1.5.1/b-colvis-1.5.1/b-html5-1.5.1/b-print-1.5.1/fh-3.1.3/datatables.min.js"></script>

    <!-- DataTable min.css -->
    <link rel="stylesheet" type="text/css"
          href="https://cdn.datatables.net/v/dt/jszip-2.5.0/dt-1.10.16/b-1.5.1/b-colvis-1.5.1/b-html5-1.5.1/b-print-1.5.1/fh-3.1.3/datatables.min.css" />

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        div#example_filter {
            margin-bottom: 10px;
        }

        body {
            width: 100vw;
            height: 100vh;
            /* overflow-x: hidden; */
            font-family: monospace;
            /* font-family: sans-serif; */
        }

        h1,
        h2,
        h3,
        h4,
        h5,
        h6,
        p {
            padding: 0;
            margin: 0;
        }

        table {
            border-collapse: collapse;
            width: 100%;
            /* border: none; */
        }

            table th {
                /* border: 1px solid #fedf7b !important; */
                padding: 3px 4px !important;
                font-size: 10px !important;
                /* width: fit-content !important; */
                text-align: center !important;
                background-color: #f6f3ee !important;
                color: #b49164;
                font-weight: bold;
                border: 1px solid #b49164 !important;
            }

            table td {
                font-size: 8px !important;
                /* outline: 1px solid #fedf7b; */
                /* border: 1px solid #fedf7b; */
                padding: 5px 2px !important;
                margin: 0 !important;
                text-align: center;
                border: 1px solid #b0872e;
            }



        caption {
            background-color: #b0872e;
            color: white;
            padding: 7px;
            font-size: 18px !important;
        }


        table.dataTable thead .sorting {
            background-image: none !important;
        }

        th.sorting {
            /* background: none !important; */
            /* border: none !important; */
        }

        .check-box {
            display: flex;
            justify-content: left;
            align-items: center;
            flex-wrap: wrap;
        }

        @@media print {

            label,
            input {
                display: none;
            }

            .dt-button {
                display: none !important;
            }
        }

        label {
            font-size: 9px !important;
        }

        .check-box input {
            width: 20px;
        }

        .check-box {
            margin: 10px 0;
        }

        table.dataTable.row-border tbody th, table.dataTable.row-border tbody td, table.dataTable.display tbody th, table.dataTable.display tbody td{
            border-top: none !important;
        }
    </style>



</head>

<body>

    <h1 style="text-align: center; margin-bottom: 30px;">After Hajj</h1>
    <br />
    <div class="myTable" style="margin-bottom: 30px;" id="summaryData">
        <table id="table1" class="display nowrap" style="width: 100%; border: none !important;">
           
            <thead>
                <tr>
                    <th>Munazzim Name</th>
                    <th>Co</th>
                    <th>Package</th>
                    <th>Pax</th>
                    <th>Mak_ChkIn</th>
                    <th>Mak_ChkOut</th>
                    <th>Med_ChkIn</th>
                    <th>Med_ChkOut</th>
                    
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model)
                {
                    <tr>
                        <td>@row.MunazzimName</td>
                        <td>@row.CompanyCode</td>
                        <td>@row.PackageName</td>
                        <td>@row.Pax</td>
                        <td>@row.MakkahCheckIn</td>
                        <td>@row.MakkahCheckOut</td>
                        <td>@row.MedinaCheckIn</td>
                        <td>@row.MedinaCheckOut</td>
                       
                    </tr>
                }


            </tbody>
        </table>
    </div>
    <script>
        // Initialize DataTable
        $(document).ready(function () {
            $('#table1').DataTable({
                dom: 'Bfrtip',
                buttons: [{
                    text: 'Export to Excel',
                    extend: 'excelHtml5',
                    className: 'btn btn-dark',
                    exportOptions: {
                        columns: ':visible'
                    }
                }],
                "scrollCollapse": true,
                "paging": false, // Disable pagination if necessary
                "info": false,
                "ordering": true,
            });
        });
    </script>
</body>

</html>