@model Coordinator

@{
    string modelName = "Coordinator";
    string modelNamePlural = "Coordinators";
    string modelControllerRoute = "Coordinator";
    TMG.Data.TMGDbContext _db;
}


<div class="container-xxl flex-grow-1 container-p-y">
    <h4 class="fw-bold" style="color:  #404040;"><span class="text-muted fw-light"> @modelName / </span>  Edit</h4>

    <hr class="mb-4" />

    <div class="row">
        <div class="col-sm-12">
            <div class="card mb-4">
                <div class="card-body">
                    <form method="post">
                        <input type="hidden" asp-for="CoordinatorId">
                        <div class="row">
                            <div class="col-sm-12 col-md-4 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname" asp-for="Name"></label>
                                <div class="input-group input-group-merge">
                                    <span id="basic-icon-default-fullname2" class="input-group-text"><i class="bx bx-building"></i></span>
                                    <input asp-for="Name" class="form-control">
                                </div>
                                <span class="text-danger" asp-validation-for="Name"></span>
                            </div>
                            <div class="col-sm-12 col-md-4 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname" asp-for="LocalNumber"></label>
                                <div class="input-group input-group-merge">
                                    <span id="basic-icon-default-fullname2" class="input-group-text"><i class="bx bx-building"></i></span>
                                    <input asp-for="LocalNumber" class="form-control">
                                </div>
                                <span class="text-danger" asp-validation-for="LocalNumber"></span>
                            </div>
                            <div class="col-sm-12 col-md-4 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname" asp-for="InternationalNumber"></label>
                                <div class="input-group input-group-merge">
                                    <span id="basic-icon-default-fullname2" class="input-group-text"><i class="bx bx-building"></i></span>
                                    <input asp-for="InternationalNumber" class="form-control">
                                </div>
                                <span class="text-danger" asp-validation-for="InternationalNumber"></span>
                            </div>

                            <div class="col-sm-12 col-md-6 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname" asp-for="CoordinatorRoleId"></label>
                                <div class="input-group input-group-merge">
                                    <span id="basic-icon-default-fullname2" class="input-group-text"><i class="bx bx-building"></i></span>
                                    <select class="form-select" asp-for="CoordinatorRoleId">
                                        <option>Select Role...</option>
                                        @foreach (CoordinatorRole coordinator in ViewBag.Roles)
                                        {
                                            <option value="@coordinator.CoordinatorRoleId">@coordinator.Role</option>
                                        }
                                    </select>
                                </div>
                                <span class="text-danger" asp-validation-for="CoordinatorRoleId"></span>
                            </div>
                            <div class="col-sm-12 col-md-6 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname" asp-for="GroupId"></label>
                                <div class="input-group input-group-merge">
                                    <span id="basic-icon-default-fullname2" class="input-group-text"><i class="bx bx-building"></i></span>
                                    <select class="form-select" asp-for="GroupId">
                                        <option>Select Group...</option>
                                        @foreach (Group group in ViewBag.Groups)
                                        {
                                            <option value="@group.GroupId">@group.Name</option>
                                        }
                                    </select>
                                </div>
                                <span class="text-danger" asp-validation-for="GroupId"></span>
                            </div>

                            <div class="col-sm-12 mt-4">
                                <button type="submit" class="btn btn-warning float-end">Save Changes</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>

</div>