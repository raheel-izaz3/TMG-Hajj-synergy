@using Newtonsoft.Json
@model List<TMG.Models.FormModels.AziziaRoomCountModel>
@inject TMG.Data.TMGDbContext _db
@using Microsoft.AspNetCore.Http
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor http

@{
    Layout = "~/Views/Shared/_AccountsLayout.cshtml";

    var hotels = ViewBag.Hotel as List<dynamic>;
    var roomCounts = ViewBag.AziziaRoomCounts as List<dynamic>;
}

<!-- AnyChart Core and Bundle -->
<script src="https://cdn.anychart.com/releases/8.12.0/js/anychart-core.min.js"></script>
<script src="https://cdn.anychart.com/releases/8.12.0/js/anychart-bundle.min.js"></script>

<!-- AnyChart Base -->
<script src="https://cdn.anychart.com/releases/8.12.0/js/anychart-base.min.js"></script>

<!-- AnyChart UI and Exports -->
<script src="https://cdn.anychart.com/releases/8.12.0/js/anychart-ui.min.js"></script>
