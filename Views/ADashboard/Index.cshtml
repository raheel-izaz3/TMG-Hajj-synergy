    // Hotel Rooms
    anychart.onDocumentReady(function () {
    // Access data from ViewBag
    var roomCounts = JSON.parse(@Html.Raw(Json.Serialize(ViewBag.roomCounts)));

    // Extract labels and data values
    var dataValuesR = [];
    for (var i = 0; i < roomCounts.length; i++) {
    var roomName = roomCounts[i].RoomName;
    var totalRooms = roomCounts[i].TotalRooms;
    dataValuesR.push([roomName, totalRooms]);
    }

    // Create pie chart with dynamic data
    var chart = anychart.pie3d(dataValuesR);

    // set chart title text settings
    chart
    .title('Hotel Rooms')
    // set chart radius
    .radius('43%');
    chart.background("#f8f8f8");
    // set container id for the chart
    chart.container('HotelRooms');
    // initiate chart drawing
    chart.draw();
    });
    // Booking by Munazzam
    anychart.onDocumentReady(function () {
    // Access data from ViewBag
    var totalBookingsByMunazim = JSON.parse(@Html.Raw(Json.Serialize(ViewBag.totalBookingsByMunazim)));

    // Create data array for pie chart
    var pieData = totalBookingsByMunazim.map(function (item) {
    return [item.MunazzimName, item.TotalBookings];
    });

    // Create pie chart with dynamic data
    var chart = anychart.pie3d(pieData);

    // Set chart title text settings
    chart.title('Booking by Munazzam');

    // Set chart radius
