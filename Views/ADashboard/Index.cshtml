<div class="container-xxl flex-grow-1 container-p-y">
    <div class="row">
        <div class="col-sm-12 order-1">


            <div class="row" style="align-content: center !important; justify-content: center !important; margin-bottom: 15px !important">
                <div class="row" style="align-content: center !important; justify-content: center !important;">
                    <div class="row mt-3">
                        <div class="col-md-12">
                            <div style="overflow-y: auto; border: 1px solid #ddd;">
                                <table class="table mt-3">
                                    <thead>
                                        <tr>
                                            <th>Bank</th>
                                            <th>Bank Name</th>
                                            <th>Balance</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var banks in ViewBag.Banks)
                                        {
                                            <tr>
                                                <td>@banks.Bank</td>
                                                <td>@banks.BankName - @banks.Currency</td>
                                                <td>
                                                    <a asp-controller="ADashboard" asp-action="BanksReport" asp-route-id="@banks.BankId" target="_blank">
                                                        @banks.Balance.ToString("N2")
                                                    </a>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script>
        $(document).ready(function () {
            $('#hotelDropdown').change(function () {
                var hotelId = $(this).val();

                if (hotelId) {
                    $.ajax({
                        url: '@Url.Action("Index", "Admin")',
                        type: 'GET',
                        data: { hotelId: hotelId },
                        success: function (response) {
                            $('#roomCountContainer').html(response);
                        },
                        error: function () {
                            alert('Error fetching data.');
                        }
                    });
                }
            });
        });


    </script>

