    });



    document.addEventListener('DOMContentLoaded', function () {
    document.getElementById('GexportButton').addEventListener('click', function () {
    // Get table data
    var table = document.getElementById('GroupCount');
    var wb = XLSX.utils.table_to_book(table, { sheet: "Group Wise Count" });
    // Save as Excel file
    XLSX.writeFile(wb, 'GroupWiseCount.xlsx');
    });

