        function deleteRow(button) {
            const row = $(button).closest('tr'); // Find the closest row
            console.log("Selected Row:", row.html()); // Check the HTML of the selected row

            const index = row.attr('data-ticketdetailsbody-index'); // Try to get attribute directly
            console.log("Index from attr:", index);

            if (index !== undefined) {
                // Remove all rows with the same index (from ticket details and postfnf)
                $(`tr[data-ticketdetailsbody-index="${index}"]`).remove();
            }

            row.remove(); // Remove the ticket row itself

            reindexAfterDeletion(); // Reindex after row deletion

            // Recalculate totals
            calculateTableTotals();
        }



        function reindexAfterDeletion() {
            // Update ticket indices
            $('#ticketDetailsBody tr').each(function(ticketIndex) {
                $(this).attr('data-ticketDetailsBody-index', ticketIndex); // Update the index for the <tr> tag
                $(this).find('input[name^="PoInvoice"]').each(function() {
                    const newName = $(this).attr('name').replace(/\[\d+\]/, `[${ticketIndex}]`);
                    $(this).attr('name', newName);
                });
            });

            // Update flight details indices
            let flightIndex = 0;

            $('#flightDetailsBody tr').each(function() {
                // Get the ticket index from the closest ticket row
                const newTicketIndex = $(this).closest('tr').attr('data-ticketdetailsbody-index');

                // Update flight row's ticket index
                $(this).attr('data-ticketdetailsbody-index', newTicketIndex);

                // Update POFlightDetails indices
                $(this).find('input[name^="POFlightDetails"]').each(function() {
                    const newName = $(this).attr('name').replace(/POFlightDetails\[\d+\]/, `POFlightDetails[${flightIndex}]`);
                    $(this).attr('name', newName);
                });

                flightIndex++;
            });

            // Update postfnf indices
            $('#postfnf tr').each(function(postfnfIndex) {
                // Update the data-ticketDetailsBody-index for <tr> in postfnf
                $(this).attr('data-ticketDetailsBody-index', postfnfIndex);

                // Update the name attributes of the hidden inputs inside postfnf
                $(this).find('input').each(function() {
                    const newName = $(this).attr('name').replace(/\[\d+\]/, `[${postfnfIndex}]`);
                    $(this).attr('name', newName);
                });
            });
        }




        function resetForm() {
