        function addPaymentRow() {
            const tableBody = document.getElementById('paymentScheduleBody');
            const rowCount = tableBody.rows.length + 1;

            const newRow = document.createElement('tr');
            newRow.innerHTML = `
                <td>${rowCount}</td>
                <td><input type="date" name="Payments[${rowCount - 1}].DueDate" class="form-control"></td>
                <td><input type="number" name="Payments[${rowCount - 1}].Persentage" class="form-control percentage-input" placeholder="Enter %" oninput="validatePaymentPercentages()"></td>
                <td><input type="text" readonly name="Payments[${rowCount - 1}].Amount" class="form-control amount-output"></td>
                <td><button type="button" class="btn btn-danger" onclick="removePaymentRow(this)">Remove</button></td>
            `;
            tableBody.appendChild(newRow);
        }

        function removePaymentRow(button) {
            const row = button.closest('tr');
            row.remove();
            updatePaymentRowNumbers();
            validatePaymentPercentages();
        }

        function updatePaymentRowNumbers() {
            const rows = document.querySelectorAll('#paymentScheduleBody tr');
            rows.forEach((row, index) => {
                row.cells[0].innerText = index + 1;
            });
        }

        function validatePaymentPercentages() {
            const percentageInputs = document.querySelectorAll('.percentage-input');
            let totalPercentage = 0;

            percentageInputs.forEach(input => {
                totalPercentage += parseFloat(input.value) || 0;
            });

            const warningElement = document.getElementById('percentageWarning');
            const submitButton = document.getElementById('submitButton');

            if (totalPercentage > 100) {
                warningElement.classList.remove('d-none');
                warningElement.innerText = "Total percentage cannot exceed 100%.";
                submitButton.disabled = true;
            } else if (totalPercentage < 100) {
                warningElement.classList.remove('d-none');
                warningElement.innerText = "Total percentage must equal 100%.";
                submitButton.disabled = true;
            } else {
                warningElement.classList.add('d-none');
                submitButton.disabled = false;
            }

            updatePaymentAmounts();
        }

        function updatePaymentAmounts() {
            const totalAmount = parseFloat($('#totalNetAirline').text()) || 0;
            const percentageInputs = document.querySelectorAll('.percentage-input');
            const amountOutputs = document.querySelectorAll('.amount-output');

            percentageInputs.forEach((input, index) => {
                const percentage = parseFloat(input.value) || 0;
                const amount = Math.round((totalAmount * (percentage / 100)) * 100) / 100;
                amountOutputs[index].value = amount.toLocaleString('en-US', {
                    minimumFractionDigits: 2,
                    maximumFractionDigits: 2
                });
            });
        }

        // Add this to your existing calculateTotals function to update payment amounts when totals change
        const existingCalculateTotals = calculateTotals;
        calculateTotals = function () {
            existingCalculateTotals();
            updatePaymentAmounts();
        }

        // Add this function to calculate totals from the table
        function calculateTableTotals() {
            let totalGrossClient = 0;
            let totalGrossAirline = 0;
            let totalNetClient = 0;
            let totalNetAirline = 0;

            $('#ticketDetailsBody tr').each(function () {
                totalGrossClient += parseFloat($(this).find('td:eq(6)').text()) || 0;
                totalGrossAirline += parseFloat($(this).find('td:eq(7)').text()) || 0;
                totalNetClient += parseFloat($(this).find('td:eq(8)').text()) || 0;
                totalNetAirline += parseFloat($(this).find('td:eq(9)').text()) || 0;
            });

            $('#totalGrossClient').text(totalGrossClient.toFixed(2));
            $('#totalGrossAirline').text(totalGrossAirline.toFixed(2));
            $('#totalNetClient').text(totalNetClient.toFixed(2));
            $('#totalNetAirline').text(totalNetAirline.toFixed(2));

            // Update payment schedule amounts based on total net client
            updatePaymentAmounts();
        }

        function getVendors(selectElement) {
            const vendorTypeId = selectElement.value;
            const vendorSelect = selectElement.closest(".vendor-row").querySelector(".vendor-select");

            $.ajax({
                url: `/VendorType/GetVendors/${vendorTypeId}`,
                success: res => {
                    vendorSelect.innerHTML = "";
                    res.forEach(vendor => {
                        const option = document.createElement("option");
                        option.value = vendor.vendorId;
                        option.text = vendor.vendorName;
                        vendorSelect.appendChild(option);
                    });
                },
                error: err => {
                    console.error("Error fetching vendors:", err);
                }
            });
        }


