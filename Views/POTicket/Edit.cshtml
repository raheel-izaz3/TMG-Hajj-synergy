        function fetchFlightData(selectElement) {
            const flightId = selectElement.value;

            if (!flightId) {
                alert('Please select a valid flight.');
                return;
            }

            // Get the current row
            const currentRow = selectElement.closest('tr');

            // AJAX call with cache-busting timestamp
            fetch(`/POTicket/GetFlightDetails?flightId=${flightId}&t=${Date.now()}`)
                .then(response => {
                    if (!response.ok) {
                        throw new Error('Network response was not ok');
                    }
                    return response.json();
                })
                .then(data => {
                    console.log("Fetched flight data:", data);

                    $(currentRow).find('input[name="Departure"]').val(`${data.depatureCode} - ${data.departure}`);
                    $(currentRow).find('input[name="DepartureAirportId[]"]').val(data.departureId);
                    $(currentRow).find('input[name="Arrival"]').val(`${data.arrivalCode} - ${data.arrival}`);
                    $(currentRow).find('input[name="ArrivalAirportId[]"]').val(data.arrivalId);
                    $(currentRow).find('input[name="FlightDepartureTime[]"]').val(data.departureTime);
                    $(currentRow).find('input[name="FlightArrivalTime[]"]').val(data.arrivalTime);
                    $(currentRow).find('input[name="AirlineName"]').val(data.airlineName);
                    $(currentRow).find('input[name="Airline[]"]').val(data.airlineIds);

                    updateTransectTime(); // Call your time calculation function
                })
                .catch(error => {
                    console.error('There was a problem with the fetch operation:', error);
                    alert('Could not fetch flight details. Please try again.');
                });
        }



        function formatTicketNumber(input) {
            // Remove any non-digit characters
            let value = input.value.replace(/\D/g, '');

            // Apply formatting based on length
            if (value.length > 3 && value.length <= 7) {
            value = value.substring(0, 3) + '-' + value.substring(3);
            } else if (value.length > 7 && value.length <= 10) {
            value = value.substring(0, 3) + '-' + value.substring(3, 7) + '-' + value.substring(7);
            } else if (value.length > 10 && value.length <= 13) {
            value = value.substring(0, 3) + '-' + value.substring(3, 7) + '-' + value.substring(7, 10) + '-' + value.substring(10);
            } else if (value.length === 13) {
            // Jaise hi 13 digits enter hoon, '/' add kar do
            value = value.substring(0, 3) + '-' + value.substring(3, 7) + '-' + value.substring(7, 10) + '-' + value.substring(10) + '/';
            } else if (value.length > 13) {
            // '/' ke baad bhi 3 digits enter karne ki ijazat do
            value = value.substring(0, 3) + '-' + value.substring(3, 7) + '-' + value.substring(7, 10) + '-' + value.substring(10, 13) + '/' + value.substring(13, 16);
            }

            // Update the input value
            input.value = value;
        }




