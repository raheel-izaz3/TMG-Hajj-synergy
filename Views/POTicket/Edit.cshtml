                            let convertedGross = gross * conversionRate; // ✅ conversion applied

                            $(grossClientFromInvoiceField).val(formatNumberWithCommas(convertedGross.toFixed(2)));
                            @* $(netClientFromInvoiceField).val(formatNumberWithCommas(convertedGross.toFixed(2))); *@
                            calculateSVC(); // ✅ update svc when gross client comes
                        } else {
                            $(grossClientFromInvoiceField).val("0.00");
                            @* $(netClientFromInvoiceField).val("0.00"); *@
                            $(svcField).val("0.00");
                            @* $(svcNetField).val("0.00"); *@
                        }
                    }
                });
            });


        });


