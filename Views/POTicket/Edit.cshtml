@using TMG.Models.Updated_Accounts
@model POTicketEditModel
@using Microsoft.AspNetCore.Http
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor http
@{
    string modelName = "PO - Ticket";
    string modelNamePlural = "PO - Tickets";
    string modelControllerRoute = "POVisa";
}

<div class="container-xxl flex-grow-1 container-p-y">
    <h4 class="fw-bold" style="color:  #404040;"><span class="text-muted fw-light"> @modelName / </span> Create</h4>

    <hr class="mb-4" />

    <form method="post" asp-action="Edit" enctype="multipart/form-data">
        <input type="hidden" asp-for="@Model.POTicketId" />
        <input type="hidden" asp-for="@Model.NetTaxesForRefund" />

        <div class="row">
            <div class="col-sm-12">
                <div class="card mb-4">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-sm-12 col-md-2 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname">XO #</label>
                                <div class="input-group input-group-merge">
                                    <input type="text" class="form-control" name="XONumber" value="@Model.XONumber" />
                                </div>
                            </div>
                            <div class="col-sm-12 col-md-2 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname">PO Date</label>
                                <div class="input-group input-group-merge">
                                    <input type="date" class="form-control" value="@DateTimeManager.DateToHtmlFormat(Model.Date)" max="@DateTimeManager.Today" id="PODate" name="Date">
                                </div>
                            </div>
                            <div class="col-sm-12 col-md-2 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname">Client Due Date</label>
                                <div class="input-group input-group-merge">
                                    <input type="date" class="form-control" value="@DateTimeManager.DateToHtmlFormat(Model.DueDate)" name="DueDate">
                                </div>
                            </div>

                            <div class="col-sm-12 col-md-3 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname">Select Hajji</label>
                                <div class="input-group input-group-merge">
                                    <select name="familyHeadId" id="familyHeadId" class="form-control">
                                        <option value="">Select Haji Booking...</option>
                                        @foreach (FamilyHead fh in ViewBag.FamilyHeads)
                                        {
                                            <!option value="@fh.FamilyHeadId" @(fh.FamilyHeadId == Model.familyHeadId ? "selected" : "")>@fh.FullName - @fh.FcId (@fh.Currencies.ToString())</!option>
                                        }
                                    </select>
                                </div>
                                <span class="text-danger"></span>
                            </div>

                            <div class="col-sm-12 col-md-2 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname">TP-RF #</label>
                                <div class="input-group input-group-merge">
                                    <input class="form-control" type="text" name="TPRFNo" value="@Model.TPRFNo" />
                                </div>
                                <span class="text-danger"></span>
                            </div>

                            <div class="col-sm-12 col-md-3 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname">Ticket Type</label>
                                <div class="input-group input-group-merge">
                                    <select class="form-control" id="ticketType" name="TicketType">
                                        <option value="">Select Ticket Type</option>
                                        @foreach (var ticket in ViewBag.TicketType)
                                        {
                                            @if (ticket.Id == (int)Model.TicketType)
                                            {
                                                <option value="@ticket.Id" selected>@ticket.Name</option>
                                            }
                                            else
                                            {
                                                <option value="@ticket.Id">@ticket.Name</option>
                                            }
                                        }
                                    </select>
                                </div>
                                <span class="text-danger"></span>
                            </div>

                            <div class="col-sm-12 col-md-3 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname">Fare Type</label>
                                <div class="input-group input-group-merge">
                                    <select class="form-control" id="fareType" name="FareType">
                                        <option value="">Select Fare Type</option>
                                        @foreach (var fare in ViewBag.FareType)
                                        {
                                            @if (fare.Id == (int)Model.FareType)
                                            {
                                                <option value="@fare.Id" selected>@fare.Name</option>
                                            }
                                            else
                                            {
                                                <option value="@fare.Id">@fare.Name</option>
                                            }
                                        }
                                    </select>
                                </div>
                                <span class="text-danger"></span>
                            </div>
                            <div class="col-sm-12 col-md-3 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname">Issued Type</label>
                                <div class="input-group input-group-merge">
                                    <select class="form-control" id="IssuedType" name="IssuedType">
                                        <option value="">Select Ticket Type</option>
                                        @foreach (var ticket in ViewBag.IssuedType)
                                        {
                                            @if (ticket.Id == (int)Model.IssuedType)
                                            {
                                                <option value="@ticket.Id" selected>@ticket.Name</option>
                                            }
                                            else
                                            {
                                                <option value="@ticket.Id">@ticket.Name</option>
                                            }
                                        }
                                    </select>
                                </div>
                                <span class="text-danger"></span>
                            </div>
                            <div class="col-sm-12 col-md-4 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname">Family Member</label>
                                <div class="input-group input-group-merge">
                                    <select name="FamilyMembersId" id="familyMembersId" class="form-control">
                                        <option value="">Select Family Member</option>
                                        @foreach (FamilyHead fm in ViewBag.FamilyMembers)
                                        {
                                            <!option value="@fm.FamilyHeadId" @(fm.FamilyHeadId == Model.FamilyMembersId ? "selected" : "")>@fm.FullName</!option>
                                        }
                                    </select>
                                </div>
                                <span class="text-danger"></span>
                            </div>
                            <div class="col-sm-12 col-md-2 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname">Conversion Rate</label>
                                <div class="input-group input-group-merge">
                                    <input class="form-control" type="text" id="conersionRate" name="ConersionRate" value="@Model.ConersionRate.Value.ToString("N2")" />
                                </div>
                                <span class="text-danger"></span>
                            </div>
                            <div class="col-sm-12 col-md-2 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname">Passenger Category</label>
                                <div class="input-group input-group-merge">
                                    <input class="form-control" type="text" id="passengerCategory" name="PassengerCategory" value="@Model.PassengerCategory" readonly />
                                </div>
                                <span class="text-danger"></span>
                            </div>

                            <div class="col-sm-12 col-md-2 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname">Passport Number</label>
                                <div class="input-group input-group-merge">
                                    <input class="form-control" type="text" id="passportNumber" name="PassportNumber" value="@Model.PassportNumber" readonly />
                                </div>
                                <span class="text-danger"></span>
                            </div>

                            <div class="col-sm-12 col-md-2 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname">Date Of Birth</label>
                                <div class="input-group input-group-merge">
                                    <input class="form-control" type="date" id="dateOfBirth" name="DateofBirth" value="@DateTimeManager.DateToHtmlFormat(Model.DateofBirth)" readonly />
                                </div>
                                <span class="text-danger"></span>
                            </div>

                            <div class="col-sm-12 col-md-2 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname">Passport Date Of Expiry</label>
                                <div class="input-group input-group-merge">
                                    <input class="form-control" type="date" id="passportExpiry" name="PassportExpiry" value="@DateTimeManager.DateToHtmlFormat(Model.PassportExpiry)" readonly />
                                </div>
                                <span class="text-danger"></span>
                            </div>

                            <div class="col-sm-12 col-md-2 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname">Frequent Flyer</label>
                                <div class="input-group input-group-merge">
                                    <input class="form-control" type="text" id="frequentFlyer" name="frequentFlyer" value="@Model.FrequentFlyer" readonly />
                                </div>
                                <span class="text-danger"></span>
                            </div>

                            <div class="col-sm-12 col-md-3 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname">Posting Type</label>
                                <div class="input-group input-group-merge">
                                    <select class="form-control" id="postingTypeDropdown" name="PostingType">
                                        <option value="">Select Posting Type</option>
                                        @foreach (var fl in ViewBag.PostingType)
                                        {
                                            <!option value="@fl.Id" @(fl.Id == (int)Model.PostingType ? "selected" : "")>@fl.Name</!option>
                                        }
                                    </select>
                                </div>
                                <span class="text-danger"></span>
                            </div>

                            <!-- Issue Date Input (Initially hidden) -->
                            <div id="issueDateDiv" class="col-sm-12 col-md-2 mb-3" style="display: none;">
                                <label class="form-label" for="basic-icon-default-fullname">Issue Date</label>
                                <div class="input-group input-group-merge">
                                    <input type="date" id="issueDate" class="form-control" name="IssueDate" value="@DateTimeManager.DateToHtmlFormat(Model.IssueDate)">
                                </div>
                            </div>

                            <!-- Company Dropdown (Initially hidden) -->
                            <div id="hgoDropdownDiv" class="col-sm-12 col-md-6 mb-3" style="display: none;">
                                <label class="form-label" for="basic-icon-default-fullname">Select Company</label>
                                <div class="input-group input-group-merge">
                                    <select class="form-control" id="hgoDropdown" name="CompanyId">
                                        <option value="">Select Company</option>
                                        @foreach (Company company in ViewBag.Companies)
                                        {
                                            @if (company.CompanyId == Model.CompanyId)
                                            {
                                                <option value="@company.CompanyId" selected>@company.CompanyName</option>
                                            }
                                            else
                                            {
                                                <option value="@company.CompanyId">@company.CompanyName</option>
                                            }
                                        }
                                    </select>
                                </div>
                                <span class="text-danger"></span>
                            </div>

                            <hr />

                            <div class="vendor-row row mb-3">
                                <div class="col-sm-12 col-md-6 mb-3">
                                    <label class="form-label">Vendor Type</label>
                                    <div class="input-group input-group-merge">
                                        <select class="form-control vendor-type" id="VendorType" onchange="getVendors(this)" name="VendorTypeId">
                                            <option value="">Select Type...</option>
                                            @foreach (VendorType type in ViewBag.VendorTypes)
                                            {
                                                @if (type.VendorTypeId == Model.VendorTypeId)
                                                {
                                                    <option value="@type.VendorTypeId" selected>@type.TypeName</option>
                                                }
                                                else
                                                {
                                                    <option value="@type.VendorTypeId">@type.TypeName</option>
                                                }
                                            }
                                        </select>
                                    </div>
                                    <span class="text-danger"></span>
                                </div>

                                <div class="col-sm-12 col-md-6 mb-3">
                                    <label class="form-label">Vendor</label>
                                    <div class="input-group input-group-merge">
                                        <select class="form-control vendor-select" id="vendor" name="VendorId">
                                            @foreach (Vendor vendor in ViewBag.Vendor)
                                            {
                                                @if (vendor.VendorId == Model.VendorId)
                                                {
                                                    <option value="@vendor.VendorId" selected>@vendor.VendorName</option>
                                                }
                                                else
                                                {
                                                    <option value="@vendor.VendorId">@vendor.VendorName</option>
                                                }
                                            }
                                        </select>
                                    </div>
                                    <span class="text-danger"></span>
                                </div>
                            </div>

                            <hr />

                            <div class="row mb-3">

                                <div class="col-sm-12 col-md-3 mb-3">
                                    <label class="form-label">Booking Agent</label>
                                    <div class="input-group input-group-merge">
                                        <select class="form-control" id="bookingAgentSelect" name="BookingAgentId">
                                            <option value="">Select Booking Agent...</option>
                                            @foreach (SPO sp in ViewBag.SPOS)
                                            {
                                                @if (sp.SPOId == Model.BookingAgentId)
                                                {
                                                    <option value="@sp.SPOId" selected>@sp.Name</option>
                                                }
                                                else
                                                {
                                                    <option value="@sp.SPOId">@sp.Name</option>
                                                }
                                            }
                                        </select>
                                    </div>
                                    <span class="text-danger"></span>
                                </div>

                                <div class="col-sm-12 col-md-3 mb-3">
                                    <label class="form-label">Ticketing Agent</label>
                                    <div class="input-group input-group-merge">
                                        <select class="form-control" id="ticketingAgentSelect" name="TicketingAgentId">
                                            <option value="">Select Ticketing Agent...</option>
                                            @foreach (SPO sp in ViewBag.SPOS)
                                            {
                                                @if (sp.SPOId == Model.TicketingAgentId)
                                                {
                                                    <option value="@sp.SPOId" selected>@sp.Name</option>
                                                }
                                                else
                                                {
                                                    <option value="@sp.SPOId">@sp.Name</option>
                                                }
                                            }
                                        </select>
                                    </div>
                                    <span class="text-danger"></span>
                                </div>

                                <div class="col-sm-12 col-md-3 mb-3">
                                    <label class="form-label">Recovery Officer</label>
                                    <div class="input-group input-group-merge">
                                        <select class="form-control" id="recoveryOfficerSelect" name="RecoveryOfficerId">
                                            <option value="">Select Recovery Officer...</option>
                                            @foreach (SPO sp in ViewBag.SPOS)
                                            {
                                                @if (sp.SPOId == Model.RecoveryOfficerId)
                                                {
                                                    <option value="@sp.SPOId" selected>@sp.Name</option>
                                                }
                                                else
                                                {
                                                    <option value="@sp.SPOId">@sp.Name</option>
                                                }
                                            }
                                        </select>
                                    </div>
                                    <span class="text-danger"></span>
                                </div>

                                <div class="col-sm-12 col-md-3 mb-3">
                                    <label class="form-label">Posting Agent</label>
                                    <div class="input-group input-group-merge">
                                        <select class="form-control" id="postingAgentSelect" name="PostingAgentId">
                                            <option value="">Select Posting Agent...</option>
                                            @foreach (SPO sp in ViewBag.SPOS)
                                            {
                                                @if (sp.SPOId == Model.PostingAgentId)
                                                {
                                                    <option value="@sp.SPOId" selected>@sp.Name</option>
                                                }
                                                else
                                                {
                                                    <option value="@sp.SPOId">@sp.Name</option>
                                                }
                                            }
                                        </select>
                                    </div>
                                    <span class="text-danger"></span>
                                </div>

                            </div>

                            <hr />
                            <div class="col-sm-12 mt-4">
                                <button type="button" onclick="" id="submitButton" class="btn btn-success float-end">Add Row</button>
                            </div>
                            <div class="col-sm-12 col-md-12 mt-3">
                                <div class="table-responsive">
                                    <table class="table" id="flightDetailsTable">
                                        <thead>
                                            <tr>
                                                <th>Ticket No</th>
                                                <th>Flight No</th>
                                                <th>Departure Airport</th>
                                                <th>Arrival Airport</th>
                                                <th>Departure Time</th>
                                                <th>Arrival Time</th>
                                                <th>Transit Time</th>
                                                <th>Departure Date</th>
                                                <th>Arrival Date</th>
                                                <th>Airline</th>
                                                <th>Class</th>
                                                <th>Sub Class</th>
                                                <th>Type</th>
                                                <th>PNR No</th>
                                                <th>PNR GDS</th>
                                                <th>Seat Number</th>
                                                <th>Prefered Meals</th>
                                                <th>Ticket Category</th>
                                                <th>City Tax / Amount</th>
                                            </tr>
                                        </thead>
                                        <tbody id="flightDetailsBody">
                                            @foreach (POFlightDetail flights in ViewBag.FlightDetails)
                                            {
                                                <tr>
                                                    <input type='hidden' name='POFlightDetailId[]' id="flightid_@flights.POFlightDetailId" class='form-control' style='width: 200px;' value="@flights.POFlightDetailId" />
                                                    <td><input type="text" name="TicketNumber[]" class="form-control" style="width: 200px;" maxlength="20" oninput="formatTicketNumber(this)" value="@flights.TicketNumber" placeholder="000-0000-000-000" required /></td>

                                                    <td>
                                                        <div style="display: flex; align-items: center; gap: 10px; width:100px;">
                                                            <select name="POTicketFlightDataId[]" id="POTicketFlightDataId_@flights.POFlightDetailId" class="form-control flightId" onchange="fetchFlightData(this)" style="width: 200px;">
                                                                <option value="">Select Flight</option>
                                                                @foreach (var flightData in ViewBag.Flight)
                                                                {
                                                                    <!option value="@flightData.POTicketFlightDataId" @(flightData.POTicketFlightDataId == flights.POTicketFlightDataId ? "selected" : "")>
                                                                    @flightData.FlightNumber
                                                                    </!option>
                                                                }
                                                            </select>
                                                        </div>
                                                    </td>
                                                    <td>
                                                        <input type='text' name='Departure' class='form-control' style='width: 200px;' value="@($"{flights.Departure.Code} - {flights.Departure.AirportName}")" readonly />
                                                        <input type='hidden' name='DepartureAirportId[]' class='form-control' style='width: 200px;' value="@flights.DepartureAirportId" readonly />
                                                    </td>
                                                    <td>
                                                        <input type='text' name='Arrival' class='form-control' style='width: 200px;' value="@($"{flights.Arrival.Code} - {flights.Arrival.AirportName}")" readonly />
                                                        <input type='hidden' name='ArrivalAirportId[]' class='form-control' style='width: 200px;' value="@flights.ArrivalAirportId" readonly />
                                                    </td>
                                                    <td><input type='time' name='FlightDepartureTime[]' class='form-control departureTime' style='width: 200px;' value="@DateTimeManager.TimeToHtmlFormat(flights.FlightDepartureTime)" /></td>
                                                    <td><input type='time' name='FlightArrivalTime[]' class='form-control arrivalTime' style='width: 200px;' value="@DateTimeManager.TimeToHtmlFormat(flights.FlightArrivalTime)" /></td>
                                                    <td>
                                                        <input type='text' name='TransectTime[]' class='form-control transectTime' style='width: 200px;' value="@flights.TransectTime" readonly />
                                                        <span class="error-message" style="color: red;"></span>
                                                    </td>
                                                    <td><input name='DepartureDate[]' type="date" class="form-control" style='width: 200px;' value="@DateTimeManager.DateToHtmlFormat(flights.DepartureDate)" /></td>
                                                    <td><input name='ArrivalDate[]' type="date" class="form-control" style='width: 200px;' value="@DateTimeManager.DateToHtmlFormat(flights.ArrivalDate)" /></td>
                                                    <td>
                                                        <input type='text' name='AirlineName' class='form-control' value="@flights.Airline.Name" style='width: 200px;' readonly />
                                                        <input type='hidden' name='Airline[]' value="@flights.AirlineId" class='form-control' style='width: 200px;' />
                                                    </td>
                                                    <td>
                                                        <div style="display: flex; align-items: center; gap: 10px;">
                                                            <select name='FlightClass[]' class='form-control' style="width: 200px;">
                                                                <option value=''>Select Class</option>
                                                                @foreach (var tc in ViewBag.FlightClass)
                                                                {
                                                                    if (tc.Id == (int)flights.FlightClass)
                                                                    {
                                                                        <option value="@tc.Id" selected>@tc.Name</option>
                                                                    }
                                                                    else
                                                                    {
                                                                        <option value="@tc.Id">@tc.Name</option>
                                                                    }
                                                                }
                                                            </select>
                                                        </div>
                                                    </td>
                                                    <td>
                                                        <div style="display: flex; align-items: center; gap: 10px;">
                                                            <select name='SubClass[]' class='form-control' style="width: 200px;">
                                                                <option value=''>Select Sub Class</option>
                                                                @foreach (SubClasses sbClass in ViewBag.SubClasses)
                                                                {
                                                                    <!option value="@sbClass.SubClassesId" @(flights.SubClassesId == sbClass.SubClassesId ? "selected" : "") >@sbClass.Name</!option>
                                                                }
                                                            </select>
                                                        </div>
                                                    </td>
                                                    <td>
                                                        <div style="display: flex; align-items: center; gap: 10px;">
                                                            <select name='AirportsType[]' class='form-control' style="width: 200px;">
                                                                @foreach (var tc in ViewBag.AirportsType)
                                                                {
                                                                    if (flights.AirportsType.HasValue && tc.Id == (int)flights.AirportsType)
                                                                    {
                                                                        <option value="@tc.Id" selected>@tc.Name</option>
                                                                    }
                                                                    else
                                                                    {
                                                                        <option value="@tc.Id">@tc.Name</option>
                                                                    }
                                                                }
                                                            </select>
                                                        </div>
                                                    </td>
                                                    <td><input type='text' name='PNRNo[]' class='form-control' style='width: 200px;' value="@flights.PNRNo" /></td>
                                                    <td><input type='text' name='PNRGDSNo[]' class='form-control' style='width: 200px;' value="@flights.PNRGDSNo" /></td>
                                                    <td><input type='text' name='SeatNumber[]' class='form-control' style='width: 200px;' value="@flights.SeatNumber" /></td>
                                                    <td><input name='PreferedMeals[]' type="text" class="form-control" style='width: 200px;' value="@flights.PreferedMeals" /></td>
                                                    <td>
                                                        <div style="display: flex; align-items: center; gap: 10px;">
                                                            <select name='TicketCategory[]' class='form-control' style="width: 200px;">
                                                                <option value="">Select Ticket Category</option>
                                                                @foreach (var tc in ViewBag.TicketCategory)
                                                                {
                                                                    <option value="@tc.Id" selected="@(flights.TicketCategory.HasValue && (int)flights.TicketCategory.Value == tc.Id)">
                                                                        @tc.Name
                                                                    </option>
                                                                }
                                                            </select>
                                                        </div>
                                                    </td>

                                                    @* <td>
														<!-- File Upload Input -->
														<input type="file" class="fileInput form-control" style="width: 200px;" />
														<a href="#" class="imagebtn" data-flight-id="@flights.POFlightDetailId" style="cursor: pointer;">Submit</a>


														<!-- View Document Link (Hidden if no file) -->
														@if (!string.IsNullOrEmpty(flights.TicketImages))
														{
															<a id="viewDocument" href="@flights.TicketImages" target="_blank">View Document</a>
															<input type="hidden" name='Url[]' value="@flights.TicketImages" />
														}
														else
														{
															<a id="viewDocument" href="#" style="display: none;">View Document</a>
														}
													</td> *@
                                                    <td>
                                                        <!-- File Upload Input -->
                                                        <input type="file" name="Url[]" class="fileInput form-control" style="width: 200px;" />
                                                        <a href="#" class="imagebtn" data-flight-id="@flights.POFlightDetailId" style="cursor: pointer;">Submit</a>

                                                        <!-- Hidden input to keep existing image path if user doesn't upload new -->
                                                        <input type="hidden" name="ExistingUrls[]" value="@flights.TicketImages" />

                                                        <!-- View existing document if available -->
                                                        @if (!string.IsNullOrEmpty(flights.TicketImages))
                                                        {
                                                            <a id="viewDocument" href="@flights.TicketImages" target="_blank">View Document</a>
                                                        }
                                                        else
                                                        {
                                                            <a id="viewDocument" href="#" style="display: none;">View Document</a>
                                                        }
                                                    </td>
                                                    <td>
                                                        <div style="display: flex; align-items: center; gap: 10px;">
                                                            <select name='CityTax[]' class='form-control' style="width: 200px;">
                                                                <option value=''>Select City Tax</option>
                                                                @foreach (CityTax tax in ViewBag.CityTax)
                                                                {
                                                                    if (tax.CityTaxId == flights.CityTaxId)
                                                                    {
                                                                        <option value="@tax.CityTaxId" selected>@tax.Code</option>
                                                                    }
                                                                    else
