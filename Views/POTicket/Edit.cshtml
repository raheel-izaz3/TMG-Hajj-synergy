                    alert("Please enter conversion rate first.");
                    $(this).val(""); // reset select box
                    return;
                }

                if (!memberId) {
                    $(grossClientFromInvoiceField).val('');
                    @* $(netClientFromInvoiceField).val(''); *@
                    $(svcField).val('0.00');
                    @* $(svcNetField).val('0.00'); *@
                    return;
                }

                $.ajax({
                    url: '/POTicket/GetGrossClientAmount',
                    type: 'GET',
                    data: { memberId: memberId },
                    success: function (res) {
                        if (res && res.amount) {
