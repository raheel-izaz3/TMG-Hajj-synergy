<script>

        $(document).ready(function () {
            $(document).on("click", ".imagebtn", function (e) {
                e.preventDefault();

                var $row = $(this).closest("tr");
                var fileInput = $row.find(".fileInput")[0].files[0];
                var flightId = $(this).data("flight-id");

                if (!fileInput) {
                    alert("Please select a file.");
                    return;
                }

                var formData = new FormData();
                formData.append("file", fileInput);
                formData.append("flightId", flightId);

                $.ajax({
                    url: "/POTicket/UploadImage",
