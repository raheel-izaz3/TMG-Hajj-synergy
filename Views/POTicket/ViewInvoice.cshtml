@model IEnumerable<TMG.Controllers.POControllers.POTicketInvoiceForView>

@{
    string modelName = "POTicket";
    string modelNamePlural = "POTickets";
    string modelControllerRoute = "POTicket";

    var hajjiBookingStatuses = ViewBag.HajjiBookingStatus;

    if (hajjiBookingStatuses == null)
    {
        hajjiBookingStatuses = new List<dynamic>();
    }
}

<style>
    .tooltip {
        position: fixed;
        top: 10px;
        left: 50%;
        transform: translateX(-50%);
        background-color: rgba(0, 0, 0, 0.8);
        color: #fff;
        padding: 10px 20px;
        border-radius: 5px;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.3s ease;
    }

        .tooltip.show {
            opacity: 1;
        }
</style>

<div class="container-xxl flex-grow-1 container-p-y">
    <div class="tooltip" id="tooltip">Link copied</div>

    <h4 class="fw-bold" style="color:  #404040;"><span class="text-muted fw-light"></span> @modelNamePlural</h4>

    <hr class="mb-4" />
    @* <a class="btn btn-success float-start" asp-action="AddMember" asp-route-familyHeadId="@ViewBag.FamilyHeadId">
        <i class="bx bx-add-to-queue me-1"></i> Add
    </a> *@


    @* @if (ViewBag.RestoreAllowed == true)
    {
        
    } *@
    @* <a asp-controller="FamilyHead" asp-action="Index" class="btn btn-warning">Back</a> *@
    <a asp-action="ViewTrashTicket" asp-route-id="@Model.ElementAtOrDefault(0)?.POTicketHeadId" class="btn btn-info float-end">
        <i class="bx bx-trash me-1"></i> Trash
        (@ViewBag.TrashedCounts)
    </a>
    <br />
    <br />
    <div class="card p-2 mt-2">
        <div class="table-responsive text-nowrap " style="padding-bottom: 200px;">
            <table class="table table-hover" id="table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Member Name</th>
                        @* <th>Head Name</th>
                        <th>Departure Date</th>
                        <th>Arrival Time</th>
                        <th>Net Amount</th> *@
                        <th>AirLine</th>
                        <th>Fare Type</th>
                        <th>Issue Type</th>
                        <th>Payable to AirLine</th>
                        <th>Recievable from AirLine</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody class="table-border-bottom-1">

                    @{
                        var SrNo = 1;
                    }


                    @foreach (TMG.Controllers.POControllers.POTicketInvoiceForView fm in Model)
                    {
                        <tr>
                            <td>
                                <i class="fab fa-bootstrap fa-lg text-primary me-3"></i>
                                <strong>@(SrNo++)</strong>
                            </td>
                            <td>@fm.FullName</td>
                            <td>@fm.AirlineName</td>
                            <td>@fm.FareType</td>
                            <td>@fm.IssueType</td>
                            <td>@(fm.IssueType == "Refund" ? "0.00" : fm.FareAmount.Value.ToString("N2"))</td>
                            <td>@(fm.IssueType == "Refund" ? fm.FareAmount.Value.ToString("N2") : "0.00")</td>
                            <td>
                                <div class="dropdown">
                                        <a class="btn btn-warning" asp-action="Edit" asp-route-id="@fm.POTicketId">
                                            <i class="bx bx-edit-alt me-1"></i> Edit
                                        </a>

                                        <a class="btn btn-warning" asp-action="NewTicket" asp-route-id="@fm.POTicketId">
                                            <i class="bx bx-edit-alt me-1"></i> Copy
                                        </a>
                                        <a class="btn btn-warning" asp-action="ReIssueForm" asp-route-id="@fm.POTicketId">
                                            <i class="bx bx-edit-alt me-1"></i> Re-Issue
                                        </a>
                                        <a class="btn btn-warning" asp-action="RefundForm" asp-route-id="@fm.POTicketId">
                                            <i class="bx bx-edit-alt me-1"></i> Refund
                                        </a>
                                        @if(fm.IsPrimary == false)
                                        {
                                            <button onclick="confirmDelete(@fm.POTicketId)" class="btn btn-outline-danger">
                                                <i class="bx bx-trash me-1"></i> Trash
                                            </button>
                                        }
                                    
                                </div>
                            </td>
                        </tr>
                    }

                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    function copyHref(event, link) {
        event.preventDefault();
        var href = link.href;

        var tempInput = document.createElement('input');
        tempInput.setAttribute('value', href);
        document.body.appendChild(tempInput);

        tempInput.select();
        tempInput.setSelectionRange(0, 99999); // For mobile devices

        document.execCommand('copy');

        document.body.removeChild(tempInput);

        var tooltip = document.getElementById('tooltip');
        tooltip.classList.add('show');
        setTimeout(function () {
            tooltip.classList.remove('show');
        }, 2000); // Hide tooltip after 2 seconds
    }

    function confirmDelete(id) {
        let del = confirm("Are you sure?")
        if (del) {
            location.href = `/@modelControllerRoute/TrashTicket/${id}`;
        }
    }

    let table = new DataTable('#table', {

    });

    function verifyMember(elem, id) {
        $.ajax({
            url: "/FamilyHead/VerifyMember/" + id,
            method: "POST",
            data: {
                value: elem.checked
            },
            success: res => {
                console.log(res)
            },
            error: err => {
                console.error(err)
            }

        });
    }

    function bookMember(elem, id) {
        $.ajax({
            url: "/FamilyHead/BookMember/" + id,
            method: "POST",
            data: {
                value: elem.checked
            },
            success: res => {
                console.log(res)
            },
            error: err => {
                console.error(err)
            }

        });
    }

    function updateStatus(familyHeadId, status) {
        var formData = new FormData();
        formData.append('familyHeadId', familyHeadId);
        formData.append('status', status);
        formData.append('date', new Date().toISOString());

        fetch('/FamilyHead/UpdateStatus', {
            method: 'POST',
            body: formData,
            headers: {
                'X-Requested-With': 'XMLHttpRequest'
            }
        })
        .then(response => response.json())
        .then(data => {
            if (data.success === false) {
                alert(data.message);
                location.reload();
            }
            else if(data.success === true)
            {
                alert(data.message);
            }
        })
        .catch(error => {
            console.error('Error:', error);
        });
    }

    $("#hajjiBookingStatus").on('change', function () {
        var id = "@ViewBag.FamilyHeadId";

        $.ajax({
            url: `/Email/SendBooking/${id}`,
            method: "POST",
            data: id,
            success: res => {
                console.log(res)
            },
            error: err => {
                console.error(err)
            }
        })
    });

</script>
