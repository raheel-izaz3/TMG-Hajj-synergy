                                <input type="hidden" name="PoInvoice[${index}].FlightDetails[${branchIndex}].CityTax" value="${branch.cityTax}" />
                                <input type="hidden" name="PoInvoice[${index}].FlightDetails[${branchIndex}].Amount" value="${branch.amount}" />
                            `).join('')}

                    </tr>

                `;

        $('#ticketDetailsBody').append(newRow);

        // Calculate new totals after adding row
        calculateTableTotals();
    }



    function deleteRow(button) {
        const row = $(button).closest('tr'); // Find the closest row
        console.log("Selected Row:", row.html()); // Check the HTML of the selected row

        const index = row.attr('data-ticketdetailsbody-index'); // Try to get attribute directly
        console.log("Index from attr:", index);

        if (index !== undefined) {
            // Remove all rows with the same index (from ticket details and postfnf)
            $(`tr[data-ticketdetailsbody-index="${index}"]`).remove();
        }

        row.remove(); // Remove the ticket row itself

        reindexAfterDeletion(); // Reindex after row deletion

        // Recalculate totals
        calculateTableTotals();
    }



    function reindexAfterDeletion() {
        // Update ticket indices
        $('#ticketDetailsBody tr').each(function(ticketIndex) {
            $(this).attr('data-ticketDetailsBody-index', ticketIndex); // Update the index for the <tr> tag
            $(this).find('input[name^="PoInvoice"]').each(function() {
                const newName = $(this).attr('name').replace(/\[\d+\]/, `[${ticketIndex}]`);
                $(this).attr('name', newName);
            });
        });

        // Update flight details indices
        let flightIndex = 0;

        $('#flightDetailsBody tr').each(function() {
            // Get the ticket index from the closest ticket row
            const newTicketIndex = $(this).closest('tr').attr('data-ticketdetailsbody-index');

            // Update flight row's ticket index
            $(this).attr('data-ticketdetailsbody-index', newTicketIndex);

            // Update POFlightDetails indices
            $(this).find('input[name^="POFlightDetails"]').each(function() {
                const newName = $(this).attr('name').replace(/POFlightDetails\[\d+\]/, `POFlightDetails[${flightIndex}]`);
                $(this).attr('name', newName);
            });

            flightIndex++;
        });

        // Update postfnf indices
        $('#postfnf tr').each(function(postfnfIndex) {
            // Update the data-ticketDetailsBody-index for <tr> in postfnf
            $(this).attr('data-ticketDetailsBody-index', postfnfIndex);

            // Update the name attributes of the hidden inputs inside postfnf
            $(this).find('input').each(function() {
                const newName = $(this).attr('name').replace(/\[\d+\]/, `[${postfnfIndex}]`);
                $(this).attr('name', newName);
            });
        });
    }




    function resetForm() {
        $('#POForm')[0].reset();
        $('#flightDetailsBody').empty();
        calculateTotals();
    }

    function addPaymentRow() {
        const tableBody = document.getElementById('paymentScheduleBody');
        const rowCount = tableBody.rows.length + 1;

        const newRow = document.createElement('tr');
        newRow.innerHTML = `
            <td>${rowCount}</td>
            <td><input type="date" name="Payments[${rowCount - 1}].DueDate" class="form-control"></td>
            <td><input type="number" name="Payments[${rowCount - 1}].Persentage" class="form-control percentage-input" placeholder="Enter %" oninput="validatePaymentPercentages()"></td>
            <td><input type="text" readonly name="Payments[${rowCount - 1}].Amount" class="form-control amount-output"></td>
            <td><button type="button" class="btn btn-danger" onclick="removePaymentRow(this)">Remove</button></td>
        `;
        tableBody.appendChild(newRow);
    }

    function removePaymentRow(button) {
        const row = button.closest('tr');
        row.remove();
        updatePaymentRowNumbers();
        validatePaymentPercentages();
    }

    function updatePaymentRowNumbers() {
        const rows = document.querySelectorAll('#paymentScheduleBody tr');
        rows.forEach((row, index) => {
            row.cells[0].innerText = index + 1;
        });
    }

    function validatePaymentPercentages() {
        const percentageInputs = document.querySelectorAll('.percentage-input');
        let totalPercentage = 0;

        percentageInputs.forEach(input => {
            totalPercentage += parseFloat(input.value) || 0;
        });

        const warningElement = document.getElementById('percentageWarning');
        const submitButton = document.getElementById('submitButton');

        if (totalPercentage > 100) {
            warningElement.classList.remove('d-none');
            warningElement.innerText = "Total percentage cannot exceed 100%.";
            submitButton.disabled = true;
        } else if (totalPercentage < 100) {
            warningElement.classList.remove('d-none');
            warningElement.innerText = "Total percentage must equal 100%.";
            submitButton.disabled = true;
        } else {
            warningElement.classList.add('d-none');
            submitButton.disabled = false;
        }

        updatePaymentAmounts();
    }

    function updatePaymentAmounts() {
        const totalAmount = parseFloat($('#totalNetAirline').text()) || 0;
        const percentageInputs = document.querySelectorAll('.percentage-input');
        const amountOutputs = document.querySelectorAll('.amount-output');

        percentageInputs.forEach((input, index) => {
            const percentage = parseFloat(input.value) || 0;
            const amount = Math.round((totalAmount * (percentage / 100)) * 100) / 100;
            amountOutputs[index].value = amount.toLocaleString('en-US', {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
            });
        });
    }

    // Add this to your existing calculateTotals function to update payment amounts when totals change
    const existingCalculateTotals = calculateTotals;
    calculateTotals = function () {
        existingCalculateTotals();
        updatePaymentAmounts();
    }

    // Add this function to calculate totals from the table
    function calculateTableTotals() {
        let totalGrossClient = 0;
        let totalGrossAirline = 0;
        let totalNetClient = 0;

        $('#ticketDetailsBody tr').each(function () {
            totalGrossClient += parseFloat($(this).find('td:eq(6)').text().replace(/,/g, '')) || 0;
            totalGrossAirline += parseFloat($(this).find('td:eq(7)').text().replace(/,/g, '')) || 0;
            totalNetClient += parseFloat($(this).find('td:eq(8)').text().replace(/,/g, '')) || 0;
        });

        $('#totalGrossClient').text(totalGrossClient.toFixed(2));
        $('#totalGrossAirline').text(totalGrossAirline.toFixed(2));
        $('#totalNetClient').text(totalNetClient.toFixed(2));

        console.log(totalGrossClient);
        console.log(totalGrossAirline);
        console.log(totalNetClient);

        // Update payment schedule amounts based on total net client
        updatePaymentAmounts();
    }


    function getVendors(selectElement) {
        const vendorTypeId = selectElement.value;
        const vendorSelect = selectElement.closest(".vendor-row").querySelector(".vendor-select");

        $.ajax({
            url: `/VendorType/GetVendors/${vendorTypeId}`,
            success: res => {
                vendorSelect.innerHTML = "";
                res.forEach(vendor => {
                    const option = document.createElement("option");
                    option.value = vendor.vendorId;
                    option.text = vendor.vendorName;
                    vendorSelect.appendChild(option);
                });
            },
            error: err => {
                console.error("Error fetching vendors:", err);
            }
        });
    }


    function RenderRows(){

    $( "#postfnf tr.alt" ).each(function( index, elem ) {
        $(elem).find("input").each(function() {
            var inputName = $(this).attr('name');
             var newName = inputName.replace('rownum', index);
            $(this).attr('name', newName);
        });
    });

    $('#FnfSub').click()
    }

</script>