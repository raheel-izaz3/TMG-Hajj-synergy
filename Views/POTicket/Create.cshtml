    let fetchTimeout;

    function fetchFlightData(selectElement) {
        clearTimeout(fetchTimeout);

        fetchTimeout = setTimeout(() => {
            const flightId = selectElement.value;
            if (!flightId) return;

            const currentRow = selectElement.closest('tr');

            fetch(`/POTicket/GetFlightDetails?flightId=${flightId}`)
                .then(response => {
                    if (!response.ok) throw new Error('Network error');
                    return response.json();
                })
                .then(data => {
                    currentRow.querySelector("input[name='Departure']").value = (data.depatureCode || '') + ' - ' + (data.departure || '');
                    currentRow.querySelector("input[name='Arrival']").value = (data.arrivalCode || '') + ' - ' + (data.arrival || '');
                    currentRow.querySelector("input[name='FlightDepartureTime']").value = data.departureTime || '';
                    currentRow.querySelector("input[name='FlightArrivalTime']").value = data.arrivalTime || '';
                    currentRow.querySelector("input[name='DepartureId']").value = data.departureId || '';
                    currentRow.querySelector("input[name='ArrivalId']").value = data.arrivalId || '';
                    currentRow.querySelector("input[name='AirlineName']").value = data.airlineName || '';
                    currentRow.querySelector("input[name='AirlineId']").value = data.airlineIds || '';

                    updateTransectTime();
                })
                .catch(error => {
                    console.error('Fetch error:', error);
                    alert('Failed to fetch flight details.');
                });
        }, 300); // Debounce time in ms
    }


    function formatTicketNumber(input) {
        // Remove any non-digit characters
        let value = input.value.replace(/\D/g, '');

        // Apply formatting based on length
        if (value.length > 3 && value.length <= 7) {
        value = value.substring(0, 3) + '-' + value.substring(3);
        } else if (value.length > 7 && value.length <= 10) {
        value = value.substring(0, 3) + '-' + value.substring(3, 7) + '-' + value.substring(7);
        } else if (value.length > 10 && value.length <= 13) {
        value = value.substring(0, 3) + '-' + value.substring(3, 7) + '-' + value.substring(7, 10) + '-' + value.substring(10);
        } else if (value.length === 13) {
        // Jaise hi 13 digits enter hoon, '/' add kar do
        value = value.substring(0, 3) + '-' + value.substring(3, 7) + '-' + value.substring(7, 10) + '-' + value.substring(10) + '/';
        } else if (value.length > 13) {
        // '/' ke baad bhi 3 digits enter karne ki ijazat do
        value = value.substring(0, 3) + '-' + value.substring(3, 7) + '-' + value.substring(7, 10) + '-' + value.substring(10, 13) + '/' + value.substring(13, 16);
        }

        // Update the input value
        input.value = value;
    }



