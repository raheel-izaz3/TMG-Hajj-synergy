                            </div>

                            <div class="col-sm-12 col-md-1 mt-3">
                                <label class="form-label" for="basic-icon-default-fullname">SP</label>
                                <div class="input-group input-group-merge">
                                    <input type="text" class="form-control" name="sp" id="spAmount" value="0" />
                                </div>
                                <span class="text-danger"></span>
                            </div>

                            <div class="col-sm-12 col-md-1 mt-3">
                                <label class="form-label" for="basic-icon-default-fullname">YD</label>
                                <div class="input-group input-group-merge">
                                    <input type="text" class="form-control" name="ydAmount" id="ydAmount" value="0" />
                                </div>
                                <span class="text-danger"></span>
                            </div>

                            <div class="col-sm-12 col-md-1 mt-3">
                                <label class="form-label" for="basic-icon-default-fullname">G4</label>
                                <div class="input-group input-group-merge">
                                    <input type="text" class="form-control" name="gtaxAmount" id="gtaxAmount" value="0" />
                                </div>
                                <span class="text-danger"></span>
                            </div>

                            <div class="col-sm-12 col-md-1 mt-3">
                                <label class="form-label" for="basic-icon-default-fullname">PZ</label>
                                <div class="input-group input-group-merge">
                                    <input type="text" class="form-control" name="pzAmount" id="pzAmount" value="0" />
                                </div>
                                <span class="text-danger"></span>
                            </div>

                            <div class="col-sm-12 col-md-1 mt-3">
                                <label class="form-label" for="basic-icon-default-fullname">QA</label>
                                <div class="input-group input-group-merge">
                                    <input type="text" class="form-control" name="qaAmount" id="qaAmount" value="0" />
                                </div>
                                <span class="text-danger"></span>
                            </div>

                            <div class="col-sm-12 col-md-1 mt-3">
                                <label class="form-label" for="basic-icon-default-fullname">R9</label>
                                <div class="input-group input-group-merge">
                                    <input type="text" class="form-control" name="rtaxAmount" id="rtaxAmount" value="0" />
