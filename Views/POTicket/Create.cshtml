@using TMG.Models.Updated_Accounts
@model POTicketViewModel
@using Microsoft.AspNetCore.Http
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor http
@{
    string modelName = "PO - Ticket";
    string modelNamePlural = "PO - Tickets";
    string modelControllerRoute = "POVisa";
}

<div class="container-xxl flex-grow-1 container-p-y">
    <h4 class="fw-bold" style="color:  #404040;"><span class="text-muted fw-light"> @modelName / </span> Create</h4>

    <hr class="mb-4" />

    <form method="post" asp-action="Create" id="POTKTForm">

        <div class="row">
            <div class="col-sm-12">
                <div class="card mb-4">
                    <div class="card-body">
                        <div class="row">
                           

                            <div class="col-sm-12 col-md-2 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname">XO #</label>
                                <div class="input-group input-group-merge">
                                    <input type="text" class="form-control" name="XONumber" />
                                </div>
                            </div>
                            <div class="col-sm-12 col-md-2 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname">Ticket Issue Date</label>
                                <div class="input-group input-group-merge">
                                    <input type="date" class="form-control" value="@DateTimeManager.Today" max="@DateTimeManager.Today" id="PODate" name="Date">
                                </div>
                            </div>
                            <div class="col-sm-12 col-md-2 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname">Client Due Date</label>
                                <div class="input-group input-group-merge">
                                    <input type="date" class="form-control" value="@DateTimeManager.Today" name="DueDate">
                                </div>
                            </div>

                            <div class="col-sm-12 col-md-3 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname">Select Hajji</label>
                                <div class="input-group input-group-merge">
                                    <select name="familyHeadId" id="familyHeadId" class="form-control">
                                        <option value="">Select Haji Booking...</option>
                                        @foreach (FamilyHead fh in ViewBag.FamilyHeads)
                                        {
                                            <option value="@fh.FamilyHeadId">@fh.FullName - @fh.FcId (@fh.Currencies.ToString())</option>
                                        }
                                    </select>
                                </div>
                                <span class="text-danger"></span>
                            </div>

                            <div class="col-sm-12 col-md-2 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname">TP-RF #</label>
                                <div class="input-group input-group-merge">
                                    <input class="form-control" type="text" name="TPRFNo" />
                                </div>
                                <span class="text-danger"></span>
                            </div>

                            <div class="col-sm-12 col-md-3 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname">Ticket Type</label>
                                <div class="input-group input-group-merge">
                                    <select class="form-control" id="ticketType" name="TicketType">
                                        <option value="">Select Ticket Type</option>
                                        @foreach (var ticket in ViewBag.TicketType)
                                        {
                                            <option value="@ticket.Id">@ticket.Name</option>
                                        }
                                    </select>
                                </div>
                                <span class="text-danger"></span>
                            </div>

                            <div class="col-sm-12 col-md-3 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname">Fare Type</label>
                                <div class="input-group input-group-merge">
                                    <select class="form-control" id="fareType" name="FareType">
                                        <option value="">Select Fare Type</option>
                                        @foreach (var fare in ViewBag.FareType)
                                        {
                                            <option value="@fare.Id">@fare.Name</option>
                                        }
                                    </select>
                                </div>
                                <span class="text-danger"></span>
                            </div>
                            <div class="col-sm-12 col-md-3 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname">Issued Type</label>
                                <div class="input-group input-group-merge">
                                    <select class="form-control" id="IssuedType" name="IssuedType">
                                        <option value="">Select Ticket Type</option>
                                        @foreach (var ticket in ViewBag.IssuedType)
                                        {
                                            <option value="@ticket.Id">@ticket.Name</option>
                                        }
                                    </select>
                                </div>
                                <span class="text-danger"></span>
                            </div>
                            <div class="col-sm-12 col-md-4 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname">Family Member</label>
                                <div class="input-group input-group-merge">
                                    <select name="FamilyMembersId" id="familyMembersId" class="form-control">
                                        <option value="">Select Family Member</option>
                                    </select>
                                </div>
                                <span class="text-danger"></span>
                            </div>
                            <div class="col-sm-12 col-md-2 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname">Conversion Rate</label>
                                <div class="input-group input-group-merge">
                                    <input class="form-control" type="text" id="conersionRate" />
                                </div>
                                <span class="text-danger"></span>
                            </div>
                            <div class="col-sm-12 col-md-2 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname">Passenger Category</label>
                                <div class="input-group input-group-merge">
                                    <input class="form-control" type="text" id="passengerCategory" readonly />
                                </div>
                                <span class="text-danger"></span>
                            </div>
                            <div class="col-sm-12 col-md-2 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname">Passport Number</label>
                                <div class="input-group input-group-merge">
                                    <input class="form-control" type="text" id="passportNumber" name="passportNumber" readonly />
                                </div>
                                <span class="text-danger"></span>
                            </div>

                            <div class="col-sm-12 col-md-2 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname">Date Of Birth</label>
                                <div class="input-group input-group-merge">
                                    <input class="form-control" type="text" id="dateOfBirth" name="dateOfBirth" readonly />
                                </div>
                                <span class="text-danger"></span>
                            </div>

                            <div class="col-sm-12 col-md-2 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname">Passport Date Of Expiry</label>
                                <div class="input-group input-group-merge">
                                    <input class="form-control" type="text" id="passportExpiry" name="passportExpiry" readonly />
                                </div>
                                <span class="text-danger"></span>
                            </div>

                            <div class="col-sm-12 col-md-2 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname">Frequent Flyer</label>
                                <div class="input-group input-group-merge">
                                    <input class="form-control" type="text" id="frequentFlyer" name="frequentFlyer" readonly />
                                </div>
                                <span class="text-danger"></span>
                            </div>


                            <div class="col-sm-12 col-md-3 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname">Posting Type</label>
                                <div class="input-group input-group-merge">
                                    <select class="form-control" id="postingTypeDropdown" name="PostingType">
                                        <option value="">Select Posting Type</option>
                                        @foreach (var fl in ViewBag.PostingType)
                                        {
                                            <option value="@fl.Id">@fl.Name</option>
                                        }
                                    </select>
                                </div>
                                <span class="text-danger"></span>
                            </div>

                            <!-- Issue Date Input (Initially hidden) -->
                            <div id="issueDateDiv" class="col-sm-12 col-md-2 mb-3" style="display: none;">
                                <label class="form-label" for="basic-icon-default-fullname">Issue Date</label>
                                <div class="input-group input-group-merge">
                                    <input type="date" id="issueDate" class="form-control" name="IssueDate">
                                </div>
                            </div>

                            <!-- Company Dropdown (Initially hidden) -->
                            <div id="hgoDropdownDiv" class="col-sm-12 col-md-6 mb-3" style="display: none;">
                                <label class="form-label" for="basic-icon-default-fullname">Select Company</label>
                                <div class="input-group input-group-merge">
                                    <select class="form-control" id="hgoDropdown" name="CompanyId">
                                        <option value="">Select Company</option>
                                        @foreach (Company company in ViewBag.Companies)
                                        {
                                            <option value="@company.CompanyId">@company.CompanyName</option>
                                        }
                                    </select>
                                </div>
                                <span class="text-danger"></span>
                            </div>

                            <hr />

                            <div class="vendor-row row mb-3">
                                <div class="col-sm-12 col-md-6 mb-3">
                                    <label class="form-label">Vendor Type</label>
                                    <div class="input-group input-group-merge">
                                        <select class="form-control vendor-type" id="VendorType" onchange="getVendors(this)" name="VendorTypeId">
                                            <option value="">Select Type...</option>
                                            @foreach (VendorType type in ViewBag.VendorTypes)
                                            {
                                                <option value="@type.VendorTypeId">@type.TypeName</option>
                                            }
                                        </select>
                                    </div>
                                    <span class="text-danger"></span>
                                </div>

                                <div class="col-sm-12 col-md-6 mb-3">
                                    <label class="form-label">Vendor</label>
                                    <div class="input-group input-group-merge">
                                        <select class="form-control vendor-select" id="vendor" name="VendorId">
                                        </select>
                                    </div>
                                    <span class="text-danger"></span>
                                </div>
                            </div>

                            <hr />

                            <div class="row mb-3">

                                <div class="col-sm-12 col-md-3 mb-3">
                                    <label class="form-label">Booking Agent</label>
                                    <div class="input-group input-group-merge">
                                        <select class="form-control" id="bookingAgentSelect" name="BookingAgentId">
                                            <option value="">Select Booking Agent...</option>
                                            @foreach (SPO sp in ViewBag.SPOS)
                                            {
                                                <option value="@sp.SPOId">@sp.Name</option>
                                            }
                                        </select>
                                    </div>
                                    <span class="text-danger"></span>
                                </div>

                                <div class="col-sm-12 col-md-3 mb-3">
                                    <label class="form-label">Ticketing Agent</label>
                                    <div class="input-group input-group-merge">
                                        <select class="form-control" id="ticketingAgentSelect" name="TicketingAgentId">
                                            <option value="">Select Ticketing Agent...</option>
                                            @foreach (SPO sp in ViewBag.SPOS)
                                            {
                                                <option value="@sp.SPOId">@sp.Name</option>
                                            }
                                        </select>
                                    </div>
                                    <span class="text-danger"></span>
                                </div>

                                <div class="col-sm-12 col-md-3 mb-3">
                                    <label class="form-label">Recovery Officer</label>
                                    <div class="input-group input-group-merge">
                                        <select class="form-control" id="recoveryOfficerSelect" name="RecoveryOfficerId">
                                            <option value="">Select Recovery Officer...</option>
                                            @foreach (SPO sp in ViewBag.SPOS)
                                            {
                                                <option value="@sp.SPOId">@sp.Name</option>
                                            }
                                        </select>
                                    </div>
                                    <span class="text-danger"></span>
                                </div>

                                <div class="col-sm-12 col-md-3 mb-3">
                                    <label class="form-label">Posting Agent</label>
                                    <div class="input-group input-group-merge">
                                        <select class="form-control" id="postingAgentSelect" name="PostingAgentId">
                                            <option value="">Select Posting Agent...</option>
                                            @foreach (SPO sp in ViewBag.SPOS)
                                            {
                                                <option value="@sp.SPOId">@sp.Name</option>
                                            }
                                        </select>
                                    </div>
                                    <span class="text-danger"></span>
                                </div>

                            </div>

                            <hr />
                            <div class="col-sm-12 mt-4">
                                <button type="button" onclick="" id="submitButton" class="btn btn-success float-end">Add Row</button>
                            </div>
                            <div class="col-sm-12 col-md-12 mt-3">
                                <div class="table-responsive">
                                    <table class="table" id="flightDetailsTable">
                                        <thead>
                                            <tr>
                                                <th>Ticket No</th>
                                                <th>Flight No</th>
                                                <th>Departure Airport</th>
                                                <th>Arrival Airport</th>
                                                <th>Departure Time</th>
                                                <th>Arrival Time</th>
                                                <th>Transit Time</th>
                                                <th>Departure Date</th>
                                                <th>Arrival Date</th>
                                                <th>Airline</th>
                                                <th>Class</th>
                                                <th>Sub Class</th>
                                                <th>Type</th>
                                                <th>PNR No</th>
                                                <th>PNR GDS</th>
                                                <th>Seat Number</th>
                                                <th>Prefered Meals</th>
                                                <th>Ticket Category</th>
                                                <th>City Tax / Amount</th>
                                                <th>Action</th>
                                            </tr>
                                        </thead>
                                        <tbody id="flightDetailsBody">
                                            <!-- Flight details will be dynamically inserted here -->
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                            <hr class="mt-3" />

                            <div class="col-sm-12 col-md-2 mt-3">
                                <label class="form-label" for="basic-icon-default-fullname">Basic Fare</label>
                                <div class="input-group input-group-merge">
                                    <input type="text" class="form-control" id="basicfair" name="basicFare" value="0" />
                                </div>
                                <span class="text-danger"></span>
                            </div>

                            <div class="col-sm-12 col-md-2 mt-3">
                                <label class="form-label" for="basic-icon-default-fullname">Discount to TMG</label>
                                <div class="input-group input-group-merge">
                                    <input type="text" name="Discount" id="discount" class="form-control" value="0" oninput="formatInputValue(this)" />
                                </div>
                                <span class="text-danger"></span>
                            </div>

                            <div class="col-sm-12 col-md-2 mt-3">
                                <label class="form-label" for="basic-icon-default-fullname">Commission to TMG %</label>
                                <div class="input-group input-group-merge">
                                    <input type="text" name="CommissionPersentage" id="commissionPer" class="form-control" value="0" />
                                </div>
                                <span class="text-danger"></span>
                            </div>

                            <div class="col-sm-12 col-md-2 mt-3">
                                <label class="form-label" for="basic-icon-default-fullname">Commission</label>
                                <div class="input-group input-group-merge">
                                    <input type="text" name="Commission" id="Commi" class="form-control" readonly />
                                </div>
                                <span class="text-danger"></span>
                            </div>

                             <div class="col-sm-12 col-md-2 mt-3">
                                <label class="form-label" for="basic-icon-default-fullname">Agent Fee %</label>
                                <div class="input-group input-group-merge">
                                    <input type="text" name="AgentPersentage" id="agentper" class="form-control" value="0" />
                                </div>
                                <span class="text-danger"></span>
                            </div>

                            <div class="col-sm-12 col-md-2 mt-3">
                                <label class="form-label" for="basic-icon-default-fullname">Agent Fee Amount</label>
                                <div class="input-group input-group-merge">
                                    <input type="text" name="AgentAmount" id="agentAmount" class="form-control" readonly />
                                </div>
                                <span class="text-danger"></span>
                            </div>

                            <div class="col-sm-12 col-md-2 mt-3">
                                <label class="form-label" for="basic-icon-default-fullname">Agent Amount</label>
                                <div class="input-group input-group-merge">
                                    <input type="text" name="AgentFixedAmount" id="agentfixedAmount" class="form-control" />
                                </div>
                                <span class="text-danger"></span>
                            </div>

                            <div class="col-sm-12 col-md-2 mt-3">
                                <label class="form-label" for="basic-icon-default-fullname">Net Total</label>
                                <div class="input-group input-group-merge">
                                    <input type="text" name="NetTotal" id="NetTo" class="form-control" readonly />
                                </div>
                                <span class="text-danger"></span>
                            </div>

                            <hr class="mt-3" />
                            <div class="col-sm-12 col-md-1 mt-3">
                                <label class="form-label" for="basic-icon-default-fullname">N9</label>
                                <div class="input-group input-group-merge">
                                    <input type="text" class="form-control" name="ntax" id="ntaxAmount" value="0" />
                                </div>
                                <span class="text-danger"></span>
                            </div>

                            <div class="col-sm-12 col-md-1 mt-3">
                                <label class="form-label" for="basic-icon-default-fullname">RG</label>
                                <div class="input-group input-group-merge">
                                    <input type="text" class="form-control" name="rg" value="0" />
                                </div>
                                <span class="text-danger"></span>
                            </div>

                            <div class="col-sm-12 col-md-1 mt-3">
                                <label class="form-label" for="basic-icon-default-fullname">SF</label>
                                <div class="input-group input-group-merge">
                                    <input type="text" class="form-control" name="sf" value="0" />
                                </div>
