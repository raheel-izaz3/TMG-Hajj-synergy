    function formatTime(dateTimeString) {
        const date = new Date(dateTimeString);
        const hours = String(date.getHours()).padStart(2, '0');
        const minutes = String(date.getMinutes()).padStart(2, '0');
        return `${hours}:${minutes}`; // Format: HH:mm
    }

    function updateTransectTime() {
        let rows = document.querySelectorAll("#flightDetailsTable tbody tr");

        for (let i = 1; i < rows.length; i++) { // Skip the first row
            let prevRow = rows[i - 1];
            let currentRow = rows[i];

            let prevArrivalField = prevRow.querySelector(".arrivalTime");
            let currentDepartureField = currentRow.querySelector(".departureTime");
            let transectField = prevRow.querySelector(".transectTime");
            let errorSpan = prevRow.querySelector(".error-message"); // Find the span

            if (!prevArrivalField || !currentDepartureField || !transectField || !errorSpan) {
                continue; // Skip if any field is missing
            }

            let prevArrival = prevArrivalField.value.trim();
            let currentDeparture = currentDepartureField.value.trim();

            if (prevArrival && currentDeparture) {
                let timeDiff = calculateTimeDifference(prevArrival, currentDeparture);
                transectField.value = timeDiff;

                // Convert the time difference into minutes for validation
                let [hours, minutes] = timeDiff.split("h ").map(t => parseInt(t) || 0);
                let totalMinutes = (hours * 60) + minutes;

                // Show or hide the warning message based on the time difference
                if (totalMinutes < 60) {
                    transectField.style.border = "2px solid red"; // Highlight input
                    errorSpan.textContent = "TransitTime less than 60 minutes!";
                } else {
                    transectField.style.border = ""; // Reset border
                    errorSpan.textContent = ""; // Clear message
                }
            }
        }

        // **New Code:** If only one row is left, clear its Transit Time
        if (rows.length === 1) {
            let singleRow = rows[0];
            let transectField = singleRow.querySelector(".transectTime");
            let errorSpan = singleRow.querySelector(".error-message");

            if (transectField) transectField.value = ""; // Clear Transit Time
            if (errorSpan) errorSpan.textContent = ""; // Clear warning
        }
    }



    function calculateTimeDifference(start, end) {
        let startTime = new Date(`1970-01-01T${start}:00`);
        let endTime = new Date(`1970-01-01T${end}:00`);
        let diffMs = endTime - startTime;

        if (diffMs < 0) {
            diffMs += 24 * 60 * 60 * 1000; // Handle overnight flights
        }

        let diffHrs = Math.floor(diffMs / (1000 * 60 * 60));
        let diffMins = Math.floor((diffMs % (1000 * 60 * 60)) / (1000 * 60));

        return `${diffHrs}h ${diffMins}m`;
    }

