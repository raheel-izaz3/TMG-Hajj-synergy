<script>

    



    // document.getElementById("addPassengerBtn").addEventListener("click", function () {
    //     let tableBody = document.getElementById("flightDetailsBody");

    //     tableBody.innerHTML = "";
    // });


    document.addEventListener("DOMContentLoaded", function () {
        // Select all tax fields
        const taxFields = document.querySelectorAll("input[name='ntax'], input[name='rg'], input[name='sf'], input[name='sp'], input[name='ydAmount'], input[name='gtaxAmount'], input[name='pzAmount'], input[name='qaAmount'], input[name='rtaxAmount'], input[name='etaxAmount'], input[name='ioAmount'], input[name='yq'], input[name='yr'], input[name='ttax'], input[name='Ftax'], input[name='Zrtax'], input[name='Aetax'], input[name='Tptax'], input[name='Catax'], input[name='Sqtax'], input[name='Rctax'], input[name='Xttax'], input[name='Aytax'], input[name='Ustax'], input[name='Xatax'], input[name='Xftax'], input[name='Xytax'], input[name='Yctax'], input[name='Ubtax'], input[name='Gbtax'], input[name='srb'], input[name='pk'], input[name='ptt'], input[name='pb'], input[name='otherTaxes'], input[name='kpr'], input[name='kbp']");

        const basicFareField = document.getElementById("basicfair");
        const discountField = document.getElementById("discount");
        const commissionPercentageField = document.getElementById("commissionPer");
        const commissionAmountField = document.getElementById("Commi");
        const wthPercentageField = document.getElementById("WTHPers");
        const wthAmountField = document.getElementById("WTHAmount");
        const netTaxField = document.getElementById("NetTax");
        const netTotalField = document.getElementById("NetTo");
        const svcField = document.querySelector("input[name='svc']");
        const svcNetField = document.querySelector("input[name='svcNet']");
        const finalskb = document.querySelector("input[name='finalkb']");
        const grossAirlineField = document.querySelector("input[name='grossAirline']");
        const grossClientField = document.querySelector("input[name='grossClient']");
        const grossNetClientField = document.querySelector("input[name='netClient']");
        const spTaxPercentageField = document.querySelector("input[name='spTaxPercentage']");
        const spTaxField = document.querySelector("input[name='spTax']");
        const grossClientFromInvoiceField = document.querySelector("input[name='grossClientFromInvoice']");
        const netClientFromInvoiceField = document.querySelector("input[name='netClientFromInvoice']");
        // Define the Agent Percentage and Agent Fixed Amount fields
        const agentPercentageField = document.getElementById("agentper");
        const agentFixedAmountField = document.getElementById("agentfixedAmount");
        let agentAmountField = document.getElementById("agentAmount");

        // Function to format numbers with commas
        function formatNumberWithCommas(value) {
            value = value.replace(/,/g, '').replace(/[^\d.]/g, '');
            let parts = value.split('.');
            if (parts.length > 2) {
                value = parts[0] + '.' + parts.slice(1).join('');
            }
            parts = value.split('.');
            parts[0] = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, ',');
            return parts.join('.');
        }

        function newformatNumberWithCommas(number) {
                const num = parseFloat(number);
                if (isNaN(num)) return "0";

                // check if negative
                const isNegative = num < 0;
                const absValue = Math.abs(num).toString().replace(/\B(?=(\d{3})+(?!\d))/g, ",");

                return (isNegative ? "-" : "") + absValue;
            }


        // Function to toggle readonly fields based on the inputs
        function toggleReadonlyFields() {
            let commissionPercentage = parseFloat(commissionPercentageField?.value) || 0;
            let discount = parseFloat(discountField?.value.replace(/,/g, '')) || 0;
            let agentPercentage = parseFloat(agentPercentageField?.value) || 0;
            let agentFixedAmount = parseFloat(agentFixedAmountField?.value.replace(/,/g, '')) || 0;

            // If Commission or Discount is entered, disable Agent Percentage and Agent Fixed Amount
            if (commissionPercentage > 0 || discount > 0) {
                agentPercentageField.setAttribute("readonly", "true");
                agentFixedAmountField.setAttribute("readonly", "true");

                // Enable Commission and Discount fields if Agent fields are disabled
                commissionPercentageField.removeAttribute("readonly");
                discountField.removeAttribute("readonly");
            }
            // If Agent Percentage or Agent Fixed Amount is entered, disable Commission and Discount
            else if (agentPercentage > 0 || agentFixedAmount > 0) {
                commissionPercentageField.setAttribute("readonly", "true");
                discountField.setAttribute("readonly", "true");

                // Enable Agent fields if Commission and Discount are disabled
                agentPercentageField.removeAttribute("readonly");
                agentFixedAmountField.removeAttribute("readonly");
            } else {
                // If neither is selected, enable all fields
                commissionPercentageField.removeAttribute("readonly");
                discountField.removeAttribute("readonly");
                agentPercentageField.removeAttribute("readonly");
                agentFixedAmountField.removeAttribute("readonly");
            }
        }

        // Function to calculate Net Total
        function calculateNetTotal() {
            let basicFare = parseFloat(basicFareField?.value.replace(/,/g, '')) || 0;
            let discount = parseFloat(discountField?.value.replace(/,/g, '')) || 0;
            let commissionPercentage = parseFloat(commissionPercentageField?.value) || 0;
            let commissionAmount = (basicFare * commissionPercentage) / 100;
            commissionAmountField.value = formatNumberWithCommas(commissionAmount.toFixed(2));

            // Agent Percentage and Agent Fixed Amount
            let agentPercentage = parseFloat(agentPercentageField?.value) || 0;
            let agentAmount = (basicFare * agentPercentage) / 100;

            agentAmountField.value = formatNumberWithCommas(agentAmount.toFixed(2)); // Agent Amount فیلڈ میں سیٹ کرنا

            let agentFixedAmount = parseFloat(agentFixedAmountField?.value.replace(/,/g, '')) || 0;

            let netTotal = basicFare - discount - commissionAmount + agentAmount + agentFixedAmount;
            netTotalField.value = formatNumberWithCommas(netTotal.toFixed(2));
        }

        // Function to calculate Gross Client based on discount or commission, or agent amount
        function calculateGrossClient() {
            let basicFare = parseFloat(basicFareField?.value.replace(/,/g, '')) || 0;
            let discount = parseFloat(discountField?.value.replace(/,/g, '')) || 0;
            let commissionPercentage = parseFloat(commissionPercentageField?.value) || 0;
            let agentPercentage = parseFloat(agentPercentageField?.value) || 0;
            let agentFixedAmount = parseFloat(agentFixedAmountField?.value.replace(/,/g, '')) || 0;
            let netTaxAmount = parseFloat(netTaxField?.value.replace(/,/g, '')) || 0;
            let svcTaxAmount = parseFloat(svcField?.value.replace(/,/g, '')) || 0;
            let finalkb = parseFloat(finalskb?.value.replace(/,/g, '')) || 0;

            let grossClient = 0;

            if (agentPercentage > 0 || agentFixedAmount > 0) {
                let netTotalAmount = parseFloat(netTotalField?.value.replace(/,/g, '')) || 0;
                grossClient = netTotalAmount + netTaxAmount + svcTaxAmount;
            } else if (discount > 0 || commissionPercentage > 0) {
                grossClient = basicFare + netTaxAmount + svcTaxAmount;
            } else {
                // Agar sab kuch zero hai to sirf basic fare dikhayen
                grossClient = basicFare + netTaxAmount + svcTaxAmount;
            }

             // Subtract finalkb in all cases
            grossClient -= finalkb;

            grossClientField.value = formatNumberWithCommas(grossClient.toFixed(2));
        }



        // Function to calculate Taxes (Now correctly handles SP Tax removal)
        function calculateTaxes() {
            let totalTax = 0;
            taxFields.forEach(field => {
                let value = parseFloat(field.value.replace(/,/g, '')) || 0;
                totalTax += value;
            });

            let basicFare = parseFloat(basicFareField?.value.replace(/,/g, '')) || 0;
            let wthPercentage = parseFloat(wthPercentageField?.value) || 0;
            let wthAmount = (basicFare * wthPercentage) / 100;
            wthAmountField.value = formatNumberWithCommas(wthAmount.toFixed(2));

            // SP Tax Calculation
            let spTaxPercentage = parseFloat(spTaxPercentageField?.value.replace(/,/g, '')) || 0;
            let spTax = (spTaxPercentage > 0) ? (basicFare * spTaxPercentage) / 100 : 0;
            spTaxField.value = formatNumberWithCommas(spTax.toFixed(2));

            // Update Net Taxes (Properly removes SP Tax when percentage is removed)
            let netTaxes = totalTax + wthAmount + spTax;
            netTaxField.value = formatNumberWithCommas(netTaxes.toFixed(2));

            let netTotalAmount = parseFloat(netTotalField?.value.replace(/,/g, '')) || 0;
            let finalkb = parseFloat(finalskb?.value.replace(/,/g, '')) || 0;

            // Fix for Gross Airline (Now includes SP Tax correctly)
            let grossAir = netTotalAmount + netTaxes - finalkb;
            grossAirlineField.value = formatNumberWithCommas(grossAir.toFixed(2));

            // Ensure correct calculations for Client amounts
            calculateGrossClient();
            calculateNetClient();
            calculateSVC();
            // calculateNetSVC();
        }


        // Function to calculate Net Client
        function calculateNetClient() {
            let netTotalClient = parseFloat(netTotalField?.value.replace(/,/g, '')) || 0;
            let netTaxAmount = parseFloat(netTaxField?.value.replace(/,/g, '')) || 0;
            let svcTaxAmount = parseFloat(svcField?.value.replace(/,/g, '')) || 0;
            let finalkb = parseFloat(finalskb?.value.replace(/,/g, '')) || 0;

            let netClient = netTotalClient + netTaxAmount + svcTaxAmount;

            // Subtract finalkb
            netClient -= finalkb;

            grossNetClientField.value = formatNumberWithCommas(netClient.toFixed(2));
        }

        function calculateSVC() {
            let grossFromInvoice = parseFloat(grossClientFromInvoiceField?.value.replace(/,/g, '')) || 0;
            let basicFare = parseFloat(basicFareField?.value.replace(/,/g, '')) || 0;
            let netTaxAmount = parseFloat(netTaxField?.value.replace(/,/g, '')) || 0;
            let svc = 0;

            if (basicFare > 0 && grossFromInvoice > 0) {
                svc = grossFromInvoice - basicFare - netTaxAmount;

            }

            svcField.value = newformatNumberWithCommas(svc.toFixed(2));
        }

        // function calculateNetSVC() {
        //     let netFromInvoice = parseFloat(netClientFromInvoiceField?.value.replace(/,/g, '')) || 0;
        //     let netTotalClient = parseFloat(netTotalField?.value.replace(/,/g, '')) || 0;
        //     let netTaxAmount = parseFloat(netTaxField?.value.replace(/,/g, '')) || 0;
        //     let svc = 0;

        //     if (netTotalClient > 0 && netFromInvoice > 0) {
        //         svc = netFromInvoice - netTotalClient - netTaxAmount;

        //     }

        //     svcNetField.value = newformatNumberWithCommas(svc.toFixed(2));
        // }

       

        // Event listener to update values dynamically
        [...taxFields, basicFareField, discountField, commissionPercentageField, wthPercentageField, netTotalField, svcField , finalskb , spTaxPercentageField, agentPercentageField, agentFixedAmountField].forEach(field => {
            if (field) {
                field.addEventListener("input", () => {
                    calculateNetTotal();
                    calculateTaxes();
                    calculateGrossClient(); // Recalculate Gross Client after every change
                    calculateNetClient();
                    calculateSVC();
                    // calculateNetSVC();
                    // Toggle readonly based on input
                    toggleReadonlyFields();
                });
            }
        });

        // ✅ Member select ajax (example)
        $('#familyMembersId').on('change', function () {
            let memberId = $(this).val();
            let conversionRate = parseFloat($('#conersionRate').val()) || 0;

            // Pehle check karo conversion rate dala hua hai ya nahi
            if (!conversionRate) {
                alert("Please enter conversion rate first.");
                $(this).val(""); // reset select box
                return;
            }

            if (!memberId) {
                $(grossClientFromInvoiceField).val('');
                // $(netClientFromInvoiceField).val('');
                $(svcField).val('0.00');
                // $(svcNetField).val('0.00');
