                            </div>

                            <div class="col-sm-12 col-md-1 mt-3">
                                <label class="form-label" for="basic-icon-default-fullname">E3</label>
                                <div class="input-group input-group-merge">
                                    <input type="text" class="form-control" name="etaxAmount" id="etaxAmount" value="0" />
                                </div>
                                <span class="text-danger"></span>
                            </div>

                            <div class="col-sm-12 col-md-1 mt-3">
                                <label class="form-label" for="basic-icon-default-fullname">IO</label>
                                <div class="input-group input-group-merge">
                                    <input type="text" class="form-control" name="ioAmount" id="ioAmount" value="0" />
                                </div>
                                <span class="text-danger"></span>
                            </div>

                            <div class="col-sm-12 col-md-1 mt-3">
                                <label class="form-label" for="basic-icon-default-fullname">YR</label>
                                <div class="input-group input-group-merge">
                                    <input type="text" class="form-control" name="yr" id="yrAmount" value="0" />
                                </div>
                                <span class="text-danger"></span>
                            </div>

                            <div class="col-sm-12 col-md-1 mt-3">
                                <label class="form-label" for="basic-icon-default-fullname">T2</label>
                                <div class="input-group input-group-merge">
                                    <input type="text" class="form-control" name="ttax" id="ttaxAmount" value="0" />
                                </div>
                                <span class="text-danger"></span>
                            </div>

                            <div class="col-sm-12 col-md-1 mt-3">
                                <label class="form-label" for="basic-icon-default-fullname">F6</label>
                                <div class="input-group input-group-merge">
                                    <input type="text" class="form-control" name="Ftax" id="FtaxAmount" value="0" />
                                </div>
                                <span class="text-danger"></span>
                            </div>

                            <div class="col-sm-12 col-md-1 mt-3">
                                <label class="form-label" for="basic-icon-default-fullname">ZR</label>
                                <div class="input-group input-group-merge">
                                    <input type="text" class="form-control" name="Zrtax" id="ZrtaxAmount" value="0" />
                                </div>
