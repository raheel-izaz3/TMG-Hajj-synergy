@model IEnumerable<Role>

@if (TempData.ContainsKey("created"))
{
    if ((bool)TempData["created"]! == true)
    {
        <script>
            toastr.options.closeDuration = 100;
            toastr.options.closeButton = true;
            toastr.options.positionClass = "toast-top-center";
            toastr.options.showMethod = 'slideDown';
            toastr.options.hideMethod = 'slideUp';
            toastr.options.closeMethod = 'slideUp';
            toastr.success('', 'Role Created Successfully!', { timeOut: 2000 })
        </script>
        TempData["created"] = false;
    }
}
@if (TempData.ContainsKey("deleted"))
{
    if ((bool)TempData["deleted"]! == true)
    {
        <script>
            toastr.options.closeDuration = 100;
            toastr.options.closeButton = true;
            toastr.options.positionClass = "toast-top-center";
            toastr.options.showMethod = 'slideDown';
            toastr.options.hideMethod = 'slideUp';
            toastr.options.closeMethod = 'slideUp';
            toastr.success('', 'Role Trashed Successfully!', { timeOut: 2000 })
        </script>
        TempData["deleted"] = false;
    }
}
@if (TempData.ContainsKey("updated"))
{
    if ((bool)TempData["updated"]! == true)
    {
        <script>
            toastr.options.closeDuration = 100;
            toastr.options.closeButton = true;
            toastr.options.positionClass = "toast-top-center";
            toastr.options.showMethod = 'slideDown';
            toastr.options.hideMethod = 'slideUp';
            toastr.options.closeMethod = 'slideUp';
            toastr.success('', 'Role Updated Successfully!', { timeOut: 2000 })
        </script>
        TempData["updated"] = false;
    }
}

<div class="container-xxl flex-grow-1 container-p-y">
    <h4 class="fw-bold"><span class="text-muted fw-light"></span> Roles</h4>

    <hr class="mb-4" />

    @if (ViewBag.CreateAllowed == true)
    {
        <a asp-action="Create" class="btn btn-info">Create New</a>
    }
    @if (ViewBag.TrashAllowed == true)
    {
        <a asp-action="ViewTrash" class="btn btn-info float-end"><i class="bx bx-trash me-1"></i> Trash (@ViewBag.TrashCount)</a>
    }
    <br />
    <br />
    <div class="card p-2">
        <div class="table-responsive text-nowrap ">
            <table class="table table-hover" id="table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Role</th>
                        <th>Created At</th>
                        <th>Updated At</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody class="table-border-bottom-1">
                    @{
                        int i = 0;
                    }
                    @*  @if (Model.Count() == 0)
                    {
                    <tr>
                    <td colspan="5" class="text-danger text-center">No Data Found!</td>
                    </tr>
                    } *@
                    @foreach (Role role in Model)
                    {
                        i++;
                        <tr>
                            <td>
                                <i class="fab fa-bootstrap fa-lg text-primary me-3"></i> <strong>@i</strong>
                            </td>
                            <td>@role.RoleName</td>
                            <td>@role.CreatedAt</td>
                            <td>@role.UpdatedAt</td>
                            <td>
                                <div class="dropdown">
                                    @if (ViewBag.SetPrivilegeAllowed == true)
                                    {
                                        <a class="btn btn-info" asp-action="SetPrivileges" asp-route-id="@role.RoleId"><i class="bx bx-lock me-1"></i> Privileges</a>
                                    }
                                    @if (ViewBag.EditAllowed == true)
                                    {
                                        <a class="btn btn-warning" asp-action="Edit" asp-route-id="@role.RoleId"><i class="bx bx-edit-alt me-1"></i> Edit</a>
                                    }
                                    @if (ViewBag.TrashAllowed == true)
                                    {
                                        <button onclick="confirmDelete(@role.RoleId)" class="btn btn-outline-danger"><i class="bx bx-trash me-1"></i> Trash</button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
<script>
    function confirmDelete(id) {
        let del = confirm("Are you sure?")
        if (del) {
            location.href = `/Role/Trash/${id}`;
        }
    }
    let table = new DataTable('#table', {
    });
</script>

