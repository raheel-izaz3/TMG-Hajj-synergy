@model Role

<div class="container-xxl flex-grow-1 container-p-y">
    <h4 class="fw-bold" style="color:  #404040;"><span class="text-muted fw-light"> Roles / </span>  Edit</h4>

    <hr class="mb-4" />

    <div class="row">
        <div class="col-sm-12">
            <div class="card mb-4">
                <div class="card-body">
                    <form method="post">
                        <input type="hidden" asp-for="RoleId">
                        <div class="row">
                            <div class="col-sm-12 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname" asp-for="RoleName"></label>
                                <div class="input-group input-group-merge">
                                    <span id="basic-icon-default-fullname2" class="input-group-text"><i class="bx bx-cog"></i></span>
                                    <input asp-for="RoleName" class="form-control" id="basic-icon-default-fullname" placeholder="Enter Role Name..." aria-describedby="basic-icon-default-fullname2">
                                </div>
                                <span class="text-danger" asp-validation-for="RoleName"></span>
                            </div>
                            <div class="col-sm-12 mb-3">
                                <div class="col-sm-12 mb-3">
                                    <label class="form-label" for="basic-icon-default-fullname">Grant Module(s)</label>
                                    <br />

                                    <div class="form-check form-check-inline m-1">
                                        <input class="form-check-input" type="checkbox" asp-for="UserModuleAllowed">
                                        <label class="form-check-label" asp-for="UserModuleAllowed"></label>
                                    </div>

                                    <div class="form-check form-check-inline m-1">
                                        <input class="form-check-input" type="checkbox" asp-for="CompanyModuleAllowed">
                                        <label class="form-check-label" asp-for="CompanyModuleAllowed"></label>
                                    </div>

                                    <div class="form-check form-check-inline m-1">
                                        <input class="form-check-input" type="checkbox" asp-for="AccommodationModuleAllowed">
                                        <label class="form-check-label" asp-for="AccommodationModuleAllowed"></label>
                                    </div>

                                    <div class="form-check form-check-inline m-1">
                                        <input class="form-check-input" type="checkbox" asp-for="MiscModuleAllowed">
                                        <label class="form-check-label" asp-for="MiscModuleAllowed"></label>
                                    </div>

                                    <div class="form-check form-check-inline m-1">
                                        <input class="form-check-input" type="checkbox" asp-for="PackageModuleAllowed">
                                        <label class="form-check-label" asp-for="PackageModuleAllowed"></label>
                                    </div>

                                    <div class="form-check form-check-inline m-1">
                                        <input class="form-check-input" type="checkbox" asp-for="AccountsModuleAllowed">
                                        <label class="form-check-label" asp-for="AccountsModuleAllowed"></label>
                                    </div>

                                    <div class="form-check form-check-inline m-1">
                                        <input class="form-check-input" type="checkbox" asp-for="TransportationModuleAllowed">
                                        <label class="form-check-label" asp-for="TransportationModuleAllowed"></label>
                                    </div>

                                    <div class="form-check form-check-inline m-1">
                                        <input class="form-check-input" type="checkbox" asp-for="FamilyModuleAllowed">
                                        <label class="form-check-label" asp-for="FamilyModuleAllowed"></label>
                                    </div>

                                    <div class="form-check form-check-inline m-1">
                                        <input class="form-check-input" type="checkbox" asp-for="QurbaniModuleAllowed">
                                        <label class="form-check-label" asp-for="QurbaniModuleAllowed"></label>
                                    </div>

                                    <div class="form-check form-check-inline m-1">
                                        <input class="form-check-input" type="checkbox" asp-for="GroupsModuleAllowed">
                                        <label class="form-check-label" asp-for="GroupsModuleAllowed"></label>
                                    </div>

                                    <div class="form-check form-check-inline m-1">
                                        <input class="form-check-input" type="checkbox" asp-for="ReservationModuleAllowed">
                                        <label class="form-check-label" asp-for="ReservationModuleAllowed"></label>
                                    </div>

                                    <div class="form-check form-check-inline m-1">
                                        <input class="form-check-input" type="checkbox" asp-for="ReceiptModuleAllowed">
                                        <label class="form-check-label" asp-for="ReceiptModuleAllowed"></label>
                                    </div>

                                    <div class="form-check form-check-inline m-1">
                                        <input class="form-check-input" type="checkbox" asp-for="DemandModuleAllowed">
                                        <label class="form-check-label" asp-for="DemandModuleAllowed"></label>
                                    </div>

                                    <div class="form-check form-check-inline m-1">
                                        <input class="form-check-input" type="checkbox" asp-for="PurchaseOrderModuleAllowed">
                                        <label class="form-check-label" asp-for="PurchaseOrderModuleAllowed"></label>
                                    </div>

                                    @* <div class="form-check form-check-inline m-1">
                                    <input class="form-check-input" type="checkbox" asp-for="RegistrationModuleAllowed"
                                    >
                                    <label class="form-check-label" asp-for="RegistrationModuleAllowed"></label>
                                    </div>

                                    <div class="form-check form-check-inline m-1">
                                    <input class="form-check-input" type="checkbox" asp-for="MemberModuleAllowed"
                                    >
                                    <label class="form-check-label" asp-for="MemberModuleAllowed"></label>
                                    </div>
                                    <div class="form-check form-check-inline m-1">
                                    <input class="form-check-input" type="checkbox" asp-for="ReportsModuleAllowed"
                                    >
                                    <label class="form-check-label" asp-for="ReportsModuleAllowed"></label>
                                    </div>*@
                                </div>
                               
                            </div>
                        </div>

                        <button type="submit" class="btn btn-warning float-end">Save Changes</button>
                    </form>
                </div>
            </div>

        </div>
    </div>

</div>