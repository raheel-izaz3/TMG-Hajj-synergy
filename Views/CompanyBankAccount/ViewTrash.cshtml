@model IEnumerable<CompanyBankAccount>

@{
    string modelName = "Company Bank Account";
    string modelNamePlural = "Company Bank Accounts";
    string modelControllerRoute = "CompanyBankAccount";
    TMG.Data.TMGDbContext _db;
}


@if (TempData.ContainsKey("restored"))
{
    if ((bool)TempData["restored"]! == true)
    {
        <script>
            toastr.options.closeDuration = 100;
            toastr.options.closeButton = true;
            toastr.options.positionClass = "toast-top-center";
            toastr.options.showMethod = 'slideDown';
            toastr.options.hideMethod = 'slideUp';
            toastr.options.closeMethod = 'slideUp';
            toastr.success('', '@modelName Restored Successfully!', { timeOut: 2000 })
        </script>
        TempData["restored"] = false;
    }
}

<div class="container-xxl flex-grow-1 container-p-y">
    <h4 class="fw-bold" style="color:  #404040;"><span class="text-muted fw-light">@modelNamePlural</span>  / Trash</h4>

    <hr class="mb-4" />
    <div class="card p-2">
        <div class="table-responsive text-nowrap ">
            <table class="table table-hover" id="table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Company</th>
                        <th>Bank</th>
                        <th>Title</th>
                        <th>Account No.</th>
                        <th>IBAN</th>
                        <th>Swift</th>
                        <th>Beneficiary Address</th>
                        <th>Bank Address</th>
                        <th>NTN</th>
                        <th>Account's Balance</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody class="table-border-bottom-1">
                    @{
                        int i = 0;
                    }
                    @*     @if (Model.Count() == 0)
                    {
                    <tr>
                    <td colspan="10" class="text-danger text-center">No Data Found!</td>
                    </tr>
                    } *@
                    @foreach (CompanyBankAccount account in Model)
                    {
                        i++;
                        <tr>
                            <td>
                                <i class="fab fa-bootstrap fa-lg text-primary me-3"></i> <strong>@i</strong>
                            </td>
                            <td>@account.Company.CompanyName</td>
                            <td>@account.Bank</td>
                            <td>@account.Title</td>
                            <td>@account.Number</td>
                            <td>@account.IBAN</td>
                            <td>@account.Swift</td>
                            <td>@account.BeneficiaryAddress</td>
                            <td>@account.BankAddress</td>
                            <td>@account.NTN</td>
                            <td>@account.AccountBalance</td>
                            <td>
                                <div class="dropdown">
                                    <button class="btn btn-info" onclick="confirmRestore(@account.CompanyBankAccountId)">
                                        <i class="bx bx-recycle me-1"></i> Restore
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

        </div>
    </div>
</div>
<script>
    function confirmRestore(id) {
        let del = confirm("Are you sure?")
        if (del) {
            location.href = `/@modelControllerRoute/Restore/${id}`;
        }
    }

    let table = new DataTable('#table', {
    });
</script>

