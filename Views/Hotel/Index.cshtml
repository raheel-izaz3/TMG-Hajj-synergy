@model HotelIndexModel
@{
    string modelName = "Hotel";
    string modelNamePlural = "Hotels";
    string modelControllerRoute = "Hotel";
}

@if (TempData.ContainsKey("created"))
{
    if ((bool)TempData["created"]! == true)
    {
        <script>
            toastr.options.closeDuration = 100;
            toastr.options.closeButton = true;
            toastr.options.positionClass = "toast-top-center";
            toastr.options.showMethod = 'slideDown';
            toastr.options.hideMethod = 'slideUp';
            toastr.options.closeMethod = 'slideUp';
            toastr.success('', '@modelName Created Successfully!', { timeOut: 2000 })
        </script>
        TempData["created"] = false;
    }
}
@if (TempData.ContainsKey("deleted"))
{
    if ((bool)TempData["deleted"]! == true)
    {
        <script>
            toastr.options.closeDuration = 100;
            toastr.options.closeButton = true;
            toastr.options.positionClass = "toast-top-center";
            toastr.options.showMethod = 'slideDown';
            toastr.options.hideMethod = 'slideUp';
            toastr.options.closeMethod = 'slideUp';
            toastr.success('', '@modelName Trashed Successfully!', { timeOut: 2000 })
        </script>
        TempData["deleted"] = false;
    }
}
@if (TempData.ContainsKey("updated"))
{
    if ((bool)TempData["updated"]! == true)
    {
        <script>
            toastr.options.closeDuration = 100;
            toastr.options.closeButton = true;
            toastr.options.positionClass = "toast-top-center";
            toastr.options.showMethod = 'slideDown';
            toastr.options.hideMethod = 'slideUp';
            toastr.options.closeMethod = 'slideUp';
            toastr.success('', '@modelName Updated Successfully!', { timeOut: 2000 })
        </script>
        TempData["updated"] = false;
    }
}

<div class="container-xxl flex-grow-1 container-p-y">
    <h4 class="fw-bold"><span class="text-muted fw-light"></span> @modelNamePlural</h4>

    <hr class="mb-4" />

    @if (ViewBag.CreateAllowed == true)
    {
        <a asp-action="Create" class="btn btn-info">Create New</a>
    }
    @if (ViewBag.RestoreAllowed == true)
    {
        <a asp-action="ViewTrash" class="btn btn-info float-end"><i class="bx bx-trash me-1"></i> Trash
            (@ViewBag.TrashCount)</a>
    }
    <br />
    <br />
    <div class="card p-2">
        <div class="table-responsive text-nowrap ">
            <table class="table table-hover" id="table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Code</th>
                        <th>Name</th>
                        <th>Type</th>
                        <th>Category</th>
                        <th>Place</th>
                        <th>Alloted Rooms</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody class="table-border-bottom-1">
                    @{
                        int i = 0;
                    }
                    @foreach (HotelIndexEntryModel entry in Model.Entries)
                    {
                        i++;
                        <tr>
                            <td>
                                <i class="fab fa-bootstrap fa-lg text-primary me-3"></i>
                                <strong>@entry.Hotel.HotelId</strong>
                            </td>
                            @* <td><img src="~/@entry.Hotel.HotelLogo" width="64" /></td> *@
                            <td>@entry.Hotel.HotelCode</td>
                            <td>@entry.Hotel.HotelName</td>
                            <td>@entry.Hotel.Accomodation?.AccomodationName</td>
                            <td>@entry.Hotel.AccomodationCategory?.Category</td>
                            <td>@entry.Hotel.Place?.PlaceName</td>
                            <td>@entry.AllotedRooms</td>
                            <td>
                                <div class="dropdown">
                                    @if (ViewBag.EditAllowed == true)
                                    {
                                        <a class="btn btn-warning" asp-action="Edit" asp-route-id="@entry.Hotel.HotelId"><i
                                            class="bx bx-edit-alt me-1"></i> Edit</a>
                                    }
                                    @if (ViewBag.TrashAllowed == true)
                                    {
                                        <button onclick="confirmDelete(@entry.Hotel.HotelId)" class="btn btn-outline-danger"><i
                                            class="bx bx-trash me-1"></i> Trash</button>
                                    }
                                    @if (entry.Hotel.PlaceId == 4)
                                    {
                                        <a class="btn btn-primary" asp-controller="Hotel" asp-action="CheckInReport"
                                        asp-route-id="@entry.Hotel.HotelId">CheckInReport</a>
                                        <a class="btn btn-primary" asp-controller="Hotel" asp-action="AvailabilityChart"
                                        asp-route-id="@entry.Hotel.HotelId">Availability Chart</a>
                                        <a class="btn btn-success" asp-controller="Floor" asp-action="Create"
                                        asp-route-id="@entry.Hotel.HotelId"><i class="bx bx-edit-alt me-1"></i> Add
                                            Floor</a>
                                        <a class="btn btn-info" asp-controller="Floor" asp-action="Details"
                                        asp-route-id="@entry.Hotel.HotelId"><i class="bx bx-building me-1"></i>Floor
                                            Details</a>
                                        <button class="btn btn-success" onclick="bookHotel(@entry.Hotel.HotelId)"><i
                                            class="bx bx-check me-1"></i>Book Hotel</button>
                                    }
                                    else
                                    {
                                         <a class="btn btn-primary" asp-controller="RoomDetails" asp-action="Index"
                                            asp-route-id="@entry.Hotel.HotelId">Room Detail</a>
                                         <a class="btn btn-success" asp-controller="Floor" asp-action="Create"
                                         asp-route-id="@entry.Hotel.HotelId"><i class="bx bx-edit-alt me-1"></i> Add
                                             Floor</a>
                                         <a class="btn btn-info" asp-controller="Floor" asp-action="Details"
                                         asp-route-id="@entry.Hotel.HotelId"><i class="bx bx-building me-1"></i>Floor
                                             Details</a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
<script>
    function bookHotel(id) {
        let con = confirm("Are you sure you want to proceed?")
        if (con) {
            location.href = `/RoomAllotment/BookHotel/${id}`;
        }
    }

    function confirmDelete(id) {
        let del = confirm("Are you sure?")
        if (del) {
            location.href = `/@modelControllerRoute/Trash/${id}`;
        }
    }

    let table = new DataTable('#table', {
        paging: false
    });

</script>
