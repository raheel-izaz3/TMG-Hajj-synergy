@model HotelLogoUpdateRequest


@{
    string modelName = "Hotel";
    string modelNamePlural = "Hotels";
    string modelControllerRoute = "Hotel";
    TMG.Data.TMGDbContext _db;
}


<div class="container-xxl flex-grow-1 container-p-y">
    <h4 class="fw-bold" style="color:  #404040;"><span class="text-muted fw-light"> @modelName / </span> Edit</h4>

    <hr class="mb-4" />

    <div class="row">
        <div class="col-sm-12">
            <div class="card mb-4">
                <div class="card-body">
                    <form method="post" enctype="multipart/form-data">
                        <input type="hidden" asp-for="HotelId" />
                        <div class="row">
                            <div class="col-sm-12 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname" asp-for="NewLogo"></label>
                                <div class="input-group input-group-merge">
                                    <input asp-for="NewLogo" class="form-control">
                                </div>
                                <span class="text-danger" asp-validation-for="NewLogo"></span>
                            </div>
                            <div class="col-sm-12 mt-4">
                                <button type="submit" class="btn btn-warning float-end">Save Changes</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>

</div>