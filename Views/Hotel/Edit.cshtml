@model HotelEditRequest


@{
    string modelName = "Hotel";
    string modelNamePlural = "Hotels";
    string modelControllerRoute = "Hotel";
    TMG.Data.TMGDbContext _db;
}


<div class="container-xxl flex-grow-1 container-p-y">
    <h4 class="fw-bold" style="color:  #404040;"><span class="text-muted fw-light"> @modelName / </span> Edit</h4>

    <hr class="mb-4" />

    <div class="row">
        <div class="col-sm-12">
            <div class="card mb-4">
                <div class="card-body">
                    <form method="post" enctype="multipart/form-data">
                        <input type="hidden" asp-for="HotelId"/>
                        <div class="row">
                            <div class="col-sm-6 col-md-2 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname" asp-for="HotelNumber"></label>
                                <div class="input-group input-group-merge">
                                    <span id="basic-icon-default-fullname2" class="input-group-text"><i class="bx bx-building"></i></span>
                                    <input asp-for="HotelNumber" class="form-control">
                                </div>
                                <span class="text-danger" asp-validation-for="HotelNumber"></span>
                            </div>
                            <div class="col-sm-12 col-md-3 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname" asp-for="HotelCode"></label>
                                <div class="input-group input-group-merge">
                                    <span id="basic-icon-default-fullname2" class="input-group-text"><i class="bx bx-building"></i></span>
                                    <input asp-for="HotelCode" class="form-control">
                                </div>
                                <span class="text-danger" asp-validation-for="HotelCode"></span>
                            </div>
                            <div class="col-sm-12 col-md-7 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname" asp-for="HotelName"></label>
                                <div class="input-group input-group-merge">
                                    <span id="basic-icon-default-fullname2" class="input-group-text"><i class="bx bx-building"></i></span>
                                    <input asp-for="HotelName" class="form-control">
                                </div>
                                <span class="text-danger" asp-validation-for="HotelName"></span>
                            </div>

                            <div class="col-sm-12 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname" asp-for="HotelAddress"></label>
                                <div class="input-group input-group-merge">
                                    <span id="basic-icon-default-fullname2" class="input-group-text"><i class="bx bx-building"></i></span>
                                    <input asp-for="HotelAddress" class="form-control">
                                </div>
                                <span class="text-danger" asp-validation-for="HotelAddress"></span>
                            </div>
                            <div class="col-sm-12 col-md-6 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname" asp-for="HotelContact"></label>
                                <div class="input-group input-group-merge">
                                    <span id="basic-icon-default-fullname2" class="input-group-text"><i class="bx bx-phone"></i></span>
                                    <input asp-for="HotelContact" class="form-control">
                                </div>
                                <span class="text-danger" asp-validation-for="HotelContact"></span>
                            </div>
                            <div class="col-sm-12 col-md-6 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname" asp-for="HotelEmail"></label>
                                <div class="input-group input-group-merge">
                                    <span id="basic-icon-default-fullname2" class="input-group-text"><i class="bx bx-envelope"></i></span>
                                    <input asp-for="HotelEmail" class="form-control">
                                </div>
                                <span class="text-danger" asp-validation-for="HotelEmail"></span>
                            </div>
                            <div class="col-sm-12 col-md-4 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname" asp-for="PlaceId"></label>
                                <div class="input-group input-group-merge">
                                    <span id="basic-icon-default-fullname2" class="input-group-text"><i class="bx bx-building"></i></span>
                                    <select asp-for="PlaceId" class="form-control" asp-items="@ViewBag.Places">
                                        <option value="" >Select Place...</option>
                                    </select>
                                </div>
                                <span class="text-danger" asp-validation-for="PlaceId"></span>
                            </div>
                            <div class="col-sm-12 col-md-4 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname" asp-for="AccomodationId"></label>
                                <div class="input-group input-group-merge">
                                    <span id="basic-icon-default-fullname2" class="input-group-text"><i class="bx bx-building"></i></span>
                                    <select asp-for="AccomodationId" class="form-control" asp-items="@ViewBag.Accomodations">
                                        <option value="" >Select Accomodation...</option>
                                    </select>
                                </div>
                                <span class="text-danger" asp-validation-for="AccomodationId"></span>
                            </div>
                            <div class="col-sm-12 col-md-4 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname" asp-for="AccomodationCategoryId"></label>
                                <div class="input-group input-group-merge">
                                    <span id="basic-icon-default-fullname2" class="input-group-text"><i class="bx bx-building"></i></span>
                                    <select asp-for="AccomodationCategoryId" class="form-control" asp-items="@ViewBag.AccomodationCategories">
                                        <option value="" >Select Category...</option>
                                    </select>
                                </div>
                                <span class="text-danger" asp-validation-for="AccomodationCategoryId"></span>
                            </div>
                            <div class="col-sm-12 col-md-6 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname" asp-for="Location"></label><span class="asterisk"> *</span>
                                <div class="input-group input-group-merge">
                                    <input asp-for="Location" class="form-control">
                                </div>
                                <span class="text-danger" asp-validation-for="Location"></span>
                            </div>
                            <div class="col-sm-12 mb-3">
                               <a asp-action="ChangeLogo" asp-route-id="@Model.HotelId">Change Logo</a>
                            </div>
                            <div class="col-sm-12 mt-4">
                                <button type="submit" class="btn btn-warning float-end">Save Changes</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>

</div>