<div class="container-xxl flex-grow-1 container-p-y">
    <h4 class="fw-bold" style="color:  #404040;">
        <span class="text-muted fw-light">CheckIn Report</span>
    </h4>

    <hr class="mb-4" />

    <div class="row">
        <div class="col-sm-12">
            <div class="card">
                <div class="card-body">
                    <form method="get">
                        @* action="/Hotel/CheckInReportView" *@
                        <div class="row">
                            <div class="col-sm-12 col-md-4 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname">Date</label>
                                <div class="input-group input-group-merge">
                                    <input class="form-control" name="Date" id="Dateinput" type="date" required />
                                </div>
                            </div>
                            <div class="col-sm-12 mt-4">
                                <input type="hidden" name="HotelId" id="HotelId" value="@ViewBag.HotelId" />
                                <button type="submit" class="btn btn-success float-end" onclick="openLinkWithDate()">Search</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        <script>
            function openLinkWithDate() {
                // Get the value from the date input
                var dateValue = document.getElementById('Dateinput').value;
                var hotelvalue = document.getElementById('HotelId').value;
                console.log(dateValue);
                console.log(HotelId);

                // Construct the URL with the date parameter
                var url = '/Hotel/CheckInReportView?HotelId=' + encodeURIComponent(hotelvalue) + '&Date=' + encodeURIComponent(dateValue);

                // Open the URL in a new tab
                window.open(url, '_blank');
            }
        </script>
    </div>
</div>