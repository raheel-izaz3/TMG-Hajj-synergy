@model IEnumerable<TMG.Models.NewChartOfAccounts.NewAccount.NewAccount>
@{
    Layout = "~/Views/Shared/_AccountsLayout.cshtml";
    string modelName = "NewAccount";
    string modelNamePlural = "NewAccount";
    string modelControllerRoute = "NewAccount";
    TMG.Data.TMGDbContext _db;
}

@if (TempData.ContainsKey("created"))
{
    if ((bool)TempData["created"]! == true)
    {
        <script>
            toastr.options.closeDuration = 100;
            toastr.options.closeButton = true;
            toastr.options.positionClass = "toast-top-center";
            toastr.options.showMethod = 'slideDown';
            toastr.options.hideMethod = 'slideUp';
            toastr.options.closeMethod = 'slideUp';
            toastr.success('', '@modelName Created Successfully!', { timeOut: 2000 })
        </script>
        TempData["created"] = false;
    }
}
@if (TempData.ContainsKey("deleted"))
{
    if ((bool)TempData["deleted"]! == true)
    {
        <script>
            toastr.options.closeDuration = 100;
            toastr.options.closeButton = true;
            toastr.options.positionClass = "toast-top-center";
            toastr.options.showMethod = 'slideDown';
            toastr.options.hideMethod = 'slideUp';
            toastr.options.closeMethod = 'slideUp';
            toastr.success('', '@modelName Trashed Successfully!', { timeOut: 2000 })
        </script>
        TempData["deleted"] = false;
    }
}
@if (TempData.ContainsKey("updated"))
{
    if ((bool)TempData["updated"]! == true)
    {
        <script>
            toastr.options.closeDuration = 100;
            toastr.options.closeButton = true;
            toastr.options.positionClass = "toast-top-center";
            toastr.options.showMethod = 'slideDown';
            toastr.options.hideMethod = 'slideUp';
            toastr.options.closeMethod = 'slideUp';
            toastr.success('', '@modelName Updated Successfully!', { timeOut: 2000 })
        </script>
        TempData["updated"] = false;
    }
}

<div class="container-xxl flex-grow-1 container-p-y">
    <h4 class="fw-bold"><span class="text-muted fw-light"></span> @modelNamePlural</h4>

    <hr class="mb-4" />
    <a asp-action="CreateSubAccount" asp-route-id="@ViewBag.FirstParentAccountId" class="btn btn-info">Create New</a>
    <a asp-action="ViewSubChildAccountsTrash" asp-route-id="@ViewBag.FirstParentAccountId" class="btn btn-info float-end"><i class="bx bx-trash me-1"></i> Trash (@ViewBag.TrashCount)</a>
    <br />
    <br />
    <div class="card p-2">
        <div class="table-responsive text-nowrap ">
            <table class="table table-hover" id="table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Company Name</th>
                        <th>Account Name</th>
                        <th>Account Code</th>
                        <th>Parent Account</th>
                        <th>Group Name</th>
                        <th>Opening Debit Balance</th>
                        <th>Opening Credit Balance</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody class="table-border-bottom-1">
                    @{
                        int i = 0;
                    }
                    @foreach (NewAccount newAccount in Model)
                    {
                        i++;
                        <tr>
                            <td>
                                <i class="fab fa-bootstrap fa-lg text-primary me-3"></i> <strong>@i</strong>
                            </td>
                            <td>@(newAccount.Company.CompanyName ?? "Unknown")</td>
                            <td>@newAccount.AccountName</td>
                            <td>@newAccount.AccountCode</td>
                            <td>@(newAccount.ParentAccount != null ? newAccount.ParentAccount.AccountName : "Root")</td>
                            <td>@newAccount.NewAccountGroup.GroupName</td>
                            <td>
                                @((int)newAccount.OpeningType == 1
                                    ? string.Format("{0:N2}", newAccount.OpeningDebit)
                                    : "")
                            </td>
                            <td>
                                @((int)newAccount.OpeningType == 2
                                    ? string.Format("{0:N2}", newAccount.OpeningCredit)
                                    : "")
                            </td>
                            <td>
                                <div class="dropdown">
                                    
                                        <a class="btn btn-warning" asp-action="Edit" asp-route-id="@newAccount.NewAccountId"><i class="bx bx-edit-alt me-1"></i> Edit</a>
                                    <button onclick="confirmDelete(@newAccount.NewAccountId)" class="btn btn-outline-danger"><i class="bx bx-trash me-1"></i> Trash</button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
<script>
    function confirmDelete(id) {
        let del = confirm("Are you sure?")
        if (del) {
            location.href = `/@modelControllerRoute/SingleTrash/${id}`;
        }
    }

    let table = new DataTable('#table', {
    });
</script>

