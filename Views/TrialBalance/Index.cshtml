@model IEnumerable<TrialBalanceModel>

<div class="container-xxl flex-grow-1 container-p-y">
    <h4 class="fw-bold" style="color:  #404040;"><span class="text-muted fw-light">Accounts / </span>Trial Balance</h4>

    <hr class="mb-4" />
    <div class="card pt-3">
        <div class="table-responsive text-nowrap ">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Category</th>
                        <th>Debit</th>
                        <th>Credit</th>
                    </tr>
                </thead>
                <tbody class="table-border-bottom-1">
                    @{
                        int i = 0;
                        float totalDebit = 0, totalCredit = 0;
                    }
                    @if (Model.Count() == 0)
                    {
                        <tr>
                            <td colspan="5" class="text-danger text-center">No Data Found!</td>
                        </tr>
                    }
                    @foreach (TrialBalanceModel item in Model)
                    {
                        i++;
                        totalDebit += item.Debit;
                        totalCredit += item.Credit;

                        <tr>
                            <td>
                                <i class="fab fa-bootstrap fa-lg text-primary me-3"></i> <strong>@i</strong>
                            </td>
                            <td>@item.Category.SubType.TypeId - @item.Category.SubTypeId - @item.Category.CategoryId - <b>@item.Category.Name</b></td>
                            <td>@item.Debit.ToString("N0")</td>
                            <td>@item.Credit.ToString("N0")</td>
                        </tr>
                    }
                </tbody>
                @{
                    string balanced = totalCredit == totalDebit ? "green" : "red";
                }
                <tfoot>
                    <tr>
                        <td></td>
                        <td></td>
                        <td><b style="color: @balanced;">@totalDebit.ToString("N0")</b></td>
                        <td><b style="color: @balanced;">@totalCredit.ToString("N0")</b></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>


