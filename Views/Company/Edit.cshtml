                                            <h5 class="float-start">Address</h5>
                                            <button class="btn btn-outline-info float-end" type="button" onclick="addAddress(event)">Add <i class="bx bx-add-to-queue"></i></button>
                                        </div>
                                        @{
                                            int caCount = 0;
                                        }
                                        @foreach (CompanyAddresses c in ViewBag.AssignedAddresses)
                                        {
                                            <div class="row" id="address_@c.CompanyAddressesId">
                                                <div class="col-sm-12 col-md-3 mb-3" id="">
                                                    <label class="form-label" for="basic-icon-default-fullname" name="">Address Of</label>
                                                    <span class="text-danger fw-bold"> *</span>
                                                    <div class="input-group input-group-merge">
                                                        <span id="basic-icon-default-fullname2" class="input-group-text"><i class="bx bx-building"></i></span>
                                                        <select class="form-select" name="AddressTypeId[]">
                                                            <option>Select Address...</option>
                                                            @foreach (CompanyAddressType ca in ViewBag.AddressTypes)
                                                            {
                                                                if (ca.CompanyAddressTypeId == c?.CompanyAddressId)
                                                                {
                                                                    <option value="@ca.CompanyAddressTypeId" selected>@ca.AddressType</option>
                                                                }
                                                                else
                                                                {
                                                                    <option value="@ca.CompanyAddressTypeId">@ca.AddressType</option>
                                                                }
                                                            }
                                                        </select>
                                                    </div>
                                                    <span class="text-danger"></span>
                                                </div>
                                                <div class="col-sm-12 col-md-6 mb-3">
                                                    <label class="form-label" for="basic-icon-default-fullname" name="">Address</label>
                                                    <span class="text-danger fw-bold"> *</span>
                                                    <div class="input-group input-group-merge">
                                                        <span id="basic-icon-default-fullname2" class="input-group-text"><i class="bx bx-building"></i></span>
                                                        <input value="@c.Address" type="text" name="Address[]" class="form-control" placeholder="Enter Address" />
                                                    </div>
                                                    <span class="text-danger"></span>
                                                </div>
                                                <div class="col-sm-6 col-md-3 mb-3">
                                                    <label class="form-label" for="basic-icon-default-fullname" name="">Country</label>
                                                    <span class="text-danger fw-bold"> *</span>
                                                    <div class="input-group input-group-merge">
                                                        <span id="basic-icon-default-fullname2" class="input-group-text"><i class="bx bx-building"></i></span>
                                                        <input value="@c.Country" type="text" name="Country[]" class="form-control" placeholder="Enter Country" />
                                                    </div>
                                                    <span class="text-danger"></span>
                                                </div>
                                                <div class="col-sm-6 col-md-3 mb-3">
                                                    <label class="form-label" for="basic-icon-default-fullname" name="">City</label>
                                                    <span class="text-danger fw-bold"> *</span>
                                                    <div class="input-group input-group-merge">
                                                        <span id="basic-icon-default-fullname2" class="input-group-text"><i class="bx bx-building"></i></span>
                                                        <input value="@c.City" type="text" name="City[]" class="form-control" placeholder="Enter City" />
                                                    </div>
                                                    <span class="text-danger"></span>
                                                </div>

                                                <div class="col-sm-12 col-md-3 mb-3">
                                                    <label class="form-label" for="basic-icon-default-fullname" name="">Po Box</label>
                                                    <span class="text-danger fw-bold"> *</span>
                                                    <div class="input-group input-group-merge">
                                                        <span id="basic-icon-default-fullname2" class="input-group-text"><i class="bx bx-building"></i></span>
                                                        <input value="@c.PoBox" type="text" name="PoBox[]" class="form-control" placeholder="Enter City" />
                                                    </div>
                                                    <span class="text-danger"></span>
                                                </div>
                                                <div class="col-sm-6 col-md-3 mb-3">
                                                    <label class="form-label" for="basic-icon-default-fullname" name="">Zip Code</label>
                                                    <span class="text-danger fw-bold"> *</span>
                                                    <div class="input-group input-group-merge">
                                                        <span id="basic-icon-default-fullname2" class="input-group-text"><i class="bx bx-building"></i></span>
                                                        <input value="@c.ZipCode" type="text" name="Zip[]" class="form-control" placeholder="Enter City" />
                                                    </div>
                                                    <span class="text-danger"></span>
                                                </div>

                                                <div class="col-sm-6 col-md-2 mb-3">
                                                    <label class="form-label" for="basic-icon-default-fullname" name="">Preferred</label>

                                                    <div class="input-group input-group-merge">
                                                        <span id="basic-icon-default-fullname2" class="input-group-text"><i class="bx bx-check"></i></span>
                                                        <select class="form-select" name="AddressPreferred[]">
                                                            @if (c.Preferred)
                                                            {
                                                                <option value="true" selected>Yes</option>
                                                                <option value="false">No</option>
                                                            }
                                                            else
                                                            {
                                                                <option value="true">Yes</option>
                                                                <option value="false" selected>No</option>
                                                            }
                                                        </select>
                                                    </div>
                                                </div>

                                                <div class="col-sm-12 col-md-1 mb-3 d-flex justify-content-center align-items-end ">
                                                    <button type="button" class="btn btn-icon btn-danger" onclick="removeAddress(@c.CompanyAddressesId)" id="buttonChange"><i class="bx bx-trash"></i></button>
                                                </div>
                                                <hr />
