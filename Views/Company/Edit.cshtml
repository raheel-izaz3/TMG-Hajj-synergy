@model CompanyEditRequest


<style>
    nav ul {
        list-style: none;
        padding: 0;
        margin: 0;
    }

        nav ul li {
            position: relative;
            display: inline-block;
        }

            nav ul li a {
                display: block;
                padding: 10px;
                color: #333;
                text-decoration: none;
            }

            nav ul li:hover > a {
                background-color: #ccc;
            }

        nav ul ul {
            display: none;
            position: absolute;
            top: 100%;
            left: 0;
            background-color: #f2f2f2;
            padding: 0;
        }

        nav ul li:hover > ul {
            display: inherit;
        }

        nav ul ul li {
            width: 200px;
            float: none;
        }

        nav ul ul a {
            padding: 10px;
            color: #333;
        }

        nav ul ul ul {
            top: 0;
            left: 100%;
        }

        nav ul ul li:hover > a {
            background-color: #ccc;
        }
</style>
