                                        <label class="form-label" for="basic-icon-default-fullname" asp-for="POD"></label>
                                        <div class="input-group input-group-merge">
                                            <span id="basic-icon-default-fullname2" class="input-group-text"><i class="bx bx-building"></i></span>
                                            <input asp-for="POD" class="form-control" id="basic-icon-default-fullname" placeholder="Enter POD...">
                                        </div>
                                        <span class="text-danger" asp-validation-for="POD"></span>
                                    </div> *@
