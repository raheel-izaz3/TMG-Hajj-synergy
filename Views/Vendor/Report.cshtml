    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.9.2/html2pdf.bundle.js"></script>
    <script>
        async function generatePDF() {
            const content = document.getElementById('content');
            // const footer = document.querySelector('footer');
            // const checkBoxes = document.querySelectorAll('.check_box_container');

            // Save current styles
            // const originalFooterPosition = footer.style.position;
            // const originalFooterMarginTop = footer.style.marginTop;

            // Show checkboxes and adjust footer
            // checkBoxes.forEach(el => el.style.visibility = 'visible');
            // footer.style.position = 'relative';
            // footer.style.marginTop = "16px";

            const options = {
                margin: [25, 25, 25, 25],
                filename: 'MiniStatement.pdf',
                image: { type: 'jpeg', quality: 0.98 },
                html2canvas: { scale: 2 },
                jsPDF: { unit: 'pt', format: 'a4', orientation: 'portrait' }
            };

            try {
                await html2pdf().set(options).from(content).save();
            } catch (error) {
                console.error("PDF generation failed:", error);
            }

            // Reset styles after PDF generation
            // checkBoxes.forEach(el => el.style.visibility = 'hidden');
            // footer.style.position = originalFooterPosition;
            // footer.style.marginTop = originalFooterMarginTop;
        }
    </script>

