@model IEnumerable<Vendor>
@{
    string modelName = "Vendor";
    string modelNamePlural = "Vendors";
    string modelControllerRoute = "Vendor";
}


@if (TempData.ContainsKey("restored"))
{
    if ((bool)TempData["restored"]! == true)
    {
        <script>
            toastr.options.closeDuration = 100;
            toastr.options.closeButton = true;
            toastr.options.positionClass = "toast-top-center";
            toastr.options.showMethod = 'slideDown';
            toastr.options.hideMethod = 'slideUp';
            toastr.options.closeMethod = 'slideUp';
            toastr.success('', '@modelName Restored Successfully!', { timeOut: 2000 })
        </script>
        TempData["restored"] = false;
    }
}

<div class="container-xxl flex-grow-1 container-p-y">
    <h4 class="fw-bold" style="color:  #404040;"><span class="text-muted fw-light"></span> @modelNamePlural / Trash</h4>

    <hr class="mb-4" />
    <div class="card p-2">
        <div class="table-responsive text-nowrap ">
            <table class="table table-hover" id="table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Type</th>
                        <th>Name</th>
                        <th>Account Title</th>
                        <th>Account Number</th>
                        <th>IBAN</th>
                        <th>Swift Code</th>
                        <th>NTN</th>
                        <th>VAT Number</th>
                        <th>Beneficiary Address</th>
                        <th>Bank Address</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                @{
                    int i = 0;
                }
                <tbody class="table-border-bottom-1">
                    @foreach (Vendor type in Model)
                    {
                        i++;
                        <tr>
                            <td>
                                <i class="fab fa-bootstrap fa-lg text-primary me-3"></i> <strong>@i</strong>
                            </td>
                            <td>@type.VendorType.TypeName</td>
                            <td>@type.VendorName</td>
                            <td>@type.AccountTitle</td>
                            <td>@type.AccountNumber</td>
                            <td>@type.IBAN</td>
                            <td>@type.SwiftCode</td>
                            <td>@type.NTN</td>
                            <td>@type.VATNo</td>
                            <td>@type.BeneficiaryAddress</td>
                            <td>@type.BankAddress</td>
                            <td>
                                <div class="dropdown">
                                    <button class="btn btn-info" onclick="confirmRestore(@type.VendorId)">
                                        <i class="bx bx-recycle me-1"></i> Restore
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
<script>
    function confirmRestore(id) {
        let del = confirm("Are you sure?")
        if (del) {
            location.href = `/@modelControllerRoute/Restore/${id}`;
        }
    }

    let table = new DataTable('#table', {
    });
</script>

