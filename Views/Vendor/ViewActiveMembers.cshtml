@model IEnumerable<VendorContactPerson>
@{
    string modelNamePlural = "Active Members";
}

<div class="container-xxl flex-grow-1 container-p-y">
    <h4 class="fw-bold"><span class="text-muted fw-light">@ViewBag.Vendname | </span> @modelNamePlural</h4>

    <hr class="mb-4" />

    <div class="card p-2">
        <div class="table-responsive text-nowrap">
            <table class="table table-hover" id="table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Contact</th>
                        <th>Designation</th>
                        <th>Address</th>
                    </tr>
                </thead>
                <tbody class="table-border-bottom-1">
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center">No active memebers found.</td>
                        </tr>
                    }
                    else
                    {
                        int i = 0;
                        @foreach (var BCP in Model)
                        {
                            i++;
                            <tr>
                                <td>
                                    <i class="fab fa-bootstrap fa-lg text-primary me-3"></i> <strong>@i</strong>
                                </td>
                                <td>@BCP.Name</td>
                                <td>@BCP.Email</td>
                                <td>@BCP.Contact</td>
                                <td>@BCP.Designation.Name</td>
                                <td>@BCP.Address</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
