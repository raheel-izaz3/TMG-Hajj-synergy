@model IEnumerable<DataFormMember>

@{
    string modelName = "Hajj 2026 Registration";
    string modelNamePlural = "Hajj 2026 Registrations";
    string modelControllerRoute = "DataForm";

    var hajjiBookingStatuses = ViewBag.HajjiBookingStatus;
    var ticketStatus = ViewBag.TicketStatus;
    var VisaStatus = ViewBag.VisaStatus;

    if (hajjiBookingStatuses == null)
    {
        hajjiBookingStatuses = new List<dynamic>();
    }

    if (ticketStatus == null)
    {
        ticketStatus = new List<dynamic>();
    }

    if (VisaStatus == null)
    {
        VisaStatus = new List<dynamic>();
    }
}

<style>
    .tooltip {
        position: fixed;
        top: 10px;
        left: 50%;
        transform: translateX(-50%);
        background-color: rgba(0, 0, 0, 0.8);
        color: #fff;
        padding: 10px 20px;
        border-radius: 5px;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.3s ease;
    }

        .tooltip.show {
            opacity: 1;
        }
</style>

<div class="container-xxl flex-grow-1 container-p-y">
    <div class="tooltip" id="tooltip">Link copied</div>

    <h4 class="fw-bold" style="color:  #404040;"><span class="text-muted fw-light"></span> @modelNamePlural</h4>

    <hr class="mb-4" />
    <a class="btn btn-success float-start" asp-action="AddMember" asp-route-familyHeadId="@ViewBag.FamilyHeadId">
        <i class="bx bx-add-to-queue me-1"></i> Add
    </a>


    @if (ViewBag.RestoreAllowed == true)
    {
        <a asp-action="ViewTrash" asp-route-id="@Model.ElementAtOrDefault(0)?.HeadId" class="btn btn-info float-end">
            <i class="bx bx-trash me-1"></i> Trash
            (@ViewBag.TrashCount)
        </a>
    }
    <a asp-controller="DataForm" asp-action="Index" class="btn btn-warning">Back</a>
    <br />
    <br />
    <div class="card p-2 mt-2">
        <div class="table-responsive text-nowrap " style="padding-bottom: 200px;">
            @Html.AntiForgeryToken()
            <table class="table table-hover" id="table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Name</th>
                        <th>Family Head</th>
                        <th>Age</th>
                        <th>D.O.B</th>
                        <th>CNIC</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody class="table-border-bottom-1">

                    @{
                        var SrNo = 1;
                    }


                    @foreach (DataFormMember fm in Model)
                    {
                        // Save today's date.
                        var today = DateTime.Today;

                        // Calculate the age.
                        var age = today.Year - fm.DataForm.DOB.Year;

                        // Go back to the year in which the person was born in case of a leap year
                        if (fm.DataForm.DOB.Date > today.AddYears(-age)) age--;

                        <tr>
                            <td>
                                <i class="fab fa-bootstrap fa-lg text-primary me-3"></i>
                                <strong>@(SrNo++)</strong>
                            </td>
                            <td>@fm.DataForm.GivenName</td>
                            <td>@(fm.DataForm.IsHead ? "Yes" : "No")</td>
                            <td>@age</td>
                            <td>@DateTimeManager.GetDate(@fm.DataForm.DOB)</td>
                            <td>@fm.DataForm.CNICNo</td>
                            <td>
                                <div class="dropdown">
                                    @if (ViewBag.EditAllowed == true)
                                    {
                                        <a class="btn btn-warning" asp-action="Edit" asp-route-id="@fm.DataFormId">
                                            <i class="bx bx-edit-alt me-1"></i> Edit
                                        </a>
                                    }
                                    @if (ViewBag.TrashAllowed == true && !fm.IsHead)
                                    {
                                        <button onclick="confirmDelete(@fm.DataFormId)" class="btn btn-outline-danger">
                                            <i class="bx bx-trash me-1"></i> Trash
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }

                </tbody>
            </table>
        </div>
    </div>
</div>

<script>



    function updaRecieverStatus(familyHeadId, receiverName) {
        var token = document.querySelector('input[name="__RequestVerificationToken"]').value;

        $.ajax({
            type: "POST",
            url: '/FamilyHead/UpdateRecieverName',
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            headers: {
                'RequestVerificationToken': token
            },
            data: JSON.stringify({
                FamilyHeadId: familyHeadId,
                ReceiverName: receiverName
            }),
            success: function (response) {
                if (response.success) {
                    alert('Receiver name updated successfully!');
                } else {
                    alert('Error: ' + response.message);
                }
            },
            error: function (xhr, status, error) {
                alert('AJAX error: ' + error);
            }
        });
    }

