             },
             success: res => {
                 console.log(res)
             },
             error: err => {
                 console.error(err)
             }

         });
     }

     function updateStatus(familyHeadId, status) {
         var formData = new FormData();
         formData.append('familyHeadId', familyHeadId);
         formData.append('status', status);
         formData.append('date', new Date().toISOString());

         fetch('/FamilyHead/UpdateStatus', {
             method: 'POST',
             body: formData,
             headers: {
                 'X-Requested-With': 'XMLHttpRequest'
             }
         })
         .then(response => response.json())
         .then(data => {
             if (data.success === false) {
                 alert(data.message);
                 location.reload();
             }
             else if(data.success === true)
             {
                 alert(data.message);
             }
         })
         .catch(error => {
             console.error('Error:', error);
         });
     }

      function updateTicket(familyHeadId, status) {
          var formData = new FormData();
          formData.append('familyHeadId', familyHeadId);
          formData.append('status', status);
          formData.append('date', new Date().toISOString());

          fetch('/FamilyHead/UpdateTicket', {
              method: 'POST',
              body: formData,
              headers: {
                  'X-Requested-With': 'XMLHttpRequest'
              }
          })
          .then(response => response.json())
          .then(data => {
              if (data.success === false) {
                  alert(data.message);
                  location.reload();
              }
              else if(data.success === true)
              {
                  alert(data.message);
              }
          })
          .catch(error => {
              console.error('Error:', error);
          });
      }

