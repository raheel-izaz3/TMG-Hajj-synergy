@model IEnumerable<FamilyHead>

@{
    string modelName = "Family Member";
    string modelNamePlural = "Family Members";
    string modelControllerRoute = "FamilyHead";
}

@if (TempData.ContainsKey("restored"))
{
    if ((bool)TempData["restored"]! == true)
    {
        <script>
            toastr.options.closeDuration = 100;
            toastr.options.closeButton = true;
            toastr.options.positionClass = "toast-top-center";
            toastr.options.showMethod = 'slideDown';
            toastr.options.hideMethod = 'slideUp';
            toastr.options.closeMethod = 'slideUp';
            toastr.success('', '@modelName Restored Successfully!', { timeOut: 2000 })
        </script>
        TempData["restored"] = false;
    }
}

<div class="container-xxl flex-grow-1 container-p-y">
    <h4 class="fw-bold" style="color:  #404040;"><span class="text-muted fw-light"></span> @modelNamePlural / Trash</h4>

    <hr class="mb-4" />
    <div class="card p-2">
        <div class="table-responsive text-nowrap ">
            <table class="table table-hover" id="table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Family Code</th>
                        <th>Name</th>
                        <th>Family Head</th>
                        <th>Gender</th>
                        <th>Age</th>
                        <th>D.O.B</th>
                        <th>CNIC</th>
                        <th>Passport</th>
                        <th>Contact Person</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody class="table-border-bottom-1">
                    @{
                        int i = 0;
                    }
                    @*     @if (Model.Count() == 0)
                    {
                    <tr>
                    <td colspan="5" class="text-danger text-center">No Data Found!</td>
                    </tr>
                    } *@
                    @foreach (FamilyHead fm in Model)
                    {
                        i++;
                        <tr>
                            <td>
                                <i class="fab fa-bootstrap fa-lg text-primary me-3"></i> <strong>@fm.FamilyHeadId</strong>
                            </td>
                            <td>HB #01</td>
                            <td>@fm.GivenName</td>
                            <td>Y</td>
                            <td>@fm.Gender</td>
                            <td>0</td>
                            <td>@fm.DateOfBirth</td>
                            <td>@fm.CNIC</td>
                            <td>@fm.PassportNumber</td>
                            <td>Y</td>
                            <td>
                                <div class="dropdown">
                                    <button class="btn btn-info" onclick="confirmRestore(@fm.FamilyHeadId)">
                                        <i class="bx bx-recycle me-1"></i> Restore
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

        </div>
    </div>
</div>
<script>
    function confirmRestore(id) {
        let del = confirm("Are you sure?")
        if (del) {
            location.href = `/@modelControllerRoute/Restore/${id}`;
        }
    }

    let table = new DataTable('#table', {
    });
</script>

