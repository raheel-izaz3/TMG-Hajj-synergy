@model FamilyHeadIndexModel
@using Microsoft.AspNetCore.Http
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor http

@{
    string modelName = "Hajj 2026 Registration";
    string modelNamePlural = "Hajj 2026 Registrations";
    string modelControllerRoute = "DataForm";
}

<style>
    #congratulations-dropdown:hover .dropdown-menu {
        display: block;
    }
</style>
@if (TempData.ContainsKey("created"))
{
    if ((bool)TempData["created"]! == true)
    {
        <script>
            toastr.options.closeDuration = 100;
            toastr.options.closeButton = true;
            toastr.options.positionClass = "toast-top-center";
            toastr.options.showMethod = 'slideDown';
            toastr.options.hideMethod = 'slideUp';
            toastr.options.closeMethod = 'slideUp';
            toastr.success('', '@modelName Created Successfully!', { timeOut: 2000 })
        </script>
        TempData["created"] = false;
    }
}
@if (TempData.ContainsKey("deleted"))
{
    if ((bool)TempData["deleted"]! == true)
    {
        <script>
            toastr.options.closeDuration = 100;
            toastr.options.closeButton = true;
            toastr.options.positionClass = "toast-top-center";
            toastr.options.showMethod = 'slideDown';
            toastr.options.hideMethod = 'slideUp';
            toastr.options.closeMethod = 'slideUp';
            toastr.success('', '@modelName Trashed Successfully!', { timeOut: 2000 })
        </script>
        TempData["deleted"] = false;
    }
}
@if (TempData.ContainsKey("updated"))
{
    if ((bool)TempData["updated"]! == true)
    {
        <script>
            toastr.options.closeDuration = 100;
            toastr.options.closeButton = true;
            toastr.options.positionClass = "toast-top-center";
            toastr.options.showMethod = 'slideDown';
            toastr.options.hideMethod = 'slideUp';
            toastr.options.closeMethod = 'slideUp';
            toastr.success('', '@modelName Updated Successfully!', { timeOut: 2000 })
        </script>
        TempData["updated"] = false;
    }
}

<style>
    .tooltip {
        position: fixed;
        top: 10px;
        left: 50%;
        transform: translateX(-50%);
        background-color: rgba(0, 0, 0, 0.8);
        color: #fff;
        padding: 10px 20px;
        border-radius: 5px;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.3s ease;
    }

        .tooltip.show {
            opacity: 1;
        }

    .custom-dropdown {
        display: inline-block;
    }

    .custom-dropdown-button {
        padding: 6px 12px;
        font-size: 14px;
        cursor: pointer;
        background-color: #007bff;
        color: white;
        border: 1px solid #007bff;
        border-radius: 4px;
    }

    .custom-dropdown-menu {
        display: none;
        position: absolute;
        background-color: white;
        min-width: 160px;
        box-shadow: 0px 8px 16px rgba(0, 0, 0, 0.2);
        z-index: 1;
        border: 1px solid #ddd;
        border-radius: 4px;
        padding: 0;
        margin-top: 8px;
    }

        .custom-dropdown-menu.show {
            display: block;
        }

    .custom-dropdown-item {
        padding: 8px 12px;
        text-decoration: none;
        display: block;
        color: black;
    }

        .custom-dropdown-item:hover {
            background-color: #f1f1f1;
        }

</style>

<div class="container-xxl flex-grow-1 container-p-y">
    <h4 class="fw-bold">
        <span class="text-muted fw-light"></span> @modelNamePlural

    </h4>


    <hr class="mb-4" />

    @if (ViewBag.CreateAllowed == true)
    {
        @* <a asp-action="Create" class="btn btn-info">Create New</a> *@
        <a asp-action="CreateTentative" class="mx-2 btn btn-info">Registration of Hajj 2026</a>
    }

    <a asp-action="HajjRegistration" class="mx-2 btn btn-info">Online Registration of Hajj 2026</a>

    @* @if (Model.IsAdmin)
    { *@
        <a asp-action="ViewTrashMainPage" class="btn btn-info float-end">
            <i class="bx bx-trash me-1"></i> Trash
            (@ViewBag.TrashCount)
        </a>
    @* } *@
    <br />
    <br />
    <div class="card p-2">
        <div class="table-responsive text-nowrap ">

            @* <button id="exportPDF" class="btn btn-success">PDF</button>
            <button id="exportExcel" class="btn btn-outline-success">Excel</button> *@
            <div id="dataGrid"></div>

        </div>
    </div>
</div>

@{
    var options = new System.Text.Json.JsonSerializerOptions
            {
                NumberHandling = System.Text.Json.Serialization.JsonNumberHandling.AllowNamedFloatingPointLiterals
            };

    var dataSource = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DataEntries, options));
}

<script src="https://cdnjs.cloudflare.com/ajax/libs/exceljs/4.3.0/exceljs.min.js"></script>
<script src="https://cdn3.devexpress.com/jslib/22.2.3/js/jquery.min.js"></script>
<script src="https://cdn3.devexpress.com/jslib/22.2.3/js/jszip.min.js"></script>

<script>

    $(function () {
        var gridData = @dataSource;
        var isAdmin = @Html.Raw(Model.IsAdmin.ToString().ToLower());
        var viewFamilyAllowed = @Html.Raw(ViewBag.ViewFamilyAllowed.ToString().ToLower());
        var modelControllerRoute = '@modelControllerRoute';
        var currentUserId = @Html.Raw(Json.Serialize(int.Parse(http.HttpContext.Session.GetString("UserId"))));

        console.log(gridData);

        var dataGrid = $("#dataGrid").dxDataGrid({
            dataSource: gridData,
            keyExpr: "FamilyHeadId",
            columnAutoWidth: true,
            showBorders: true,
            hoverStateEnabled: true,
            showColumnHeaders: true,
            paging: {
                pageSize: 50
            },
            pager: {
                showPageSizeSelector: true,
                allowedPageSizes: [10, 25, 50, 100],
                showInfo: true
            },
            filterRow: {
                visible: true
            },
            headerFilter: {
                visible: true
            },
            scrolling: {
                mode: "virtual",
                showScrollbar: "always"
            },
            columns: [
                { dataField: "SerialNumber", caption: "#" },
                { dataField: "BookedBy", caption: "Booked By" },
                { dataField: "FeedBy", caption: "Feed By" },
                { dataField: "GroupNo", caption: "Registration Code" },
                { dataField: "Head", caption: "Family Head Name" },
                { dataField: "CNIC", caption: "CNIC #" },
                { dataField: "Status", caption: "Status" },
                { dataField: "PAX", caption: "PAX" },
                {
                    caption: "Actions",
                    cellTemplate: function (container, options) {
                        let familyHeadId = options.data.FamilyHeadId;

                        if (isAdmin) {
                            $("<button>")
                                .addClass("btn btn-danger")
                                .text("Trash")
                                .on("click", function () { confirmDelete(familyHeadId); })
                                .appendTo(container);
                        }

                        if (viewFamilyAllowed) {
                            $("<a>")
                                .addClass("btn btn-warning")
                                .attr("href", `/${modelControllerRoute}/ViewFamily?id=` + familyHeadId)
                                .text("View Family")
                                .appendTo(container);
                        }
                    }
                }
            ],
        }).dxDataGrid("instance");

        $("#exportPDF").on("click", function () {
            const { jsPDF } = window.jspdf;
            const doc = new jsPDF("protrait");

            const dataSource = dataGrid.getDataSource();
            const combinedFilter = dataGrid.getCombinedFilter();

            dataSource.store().load({ filter: combinedFilter }).then(filteredData => {
                doc.setFontSize(10);
                doc.text("Family Head Report", 10, 10);

                const tableData = [];
                let currencyTotals = {};

                filteredData.forEach((row, index) => {
                    const rowData = [
                        index + 1,
                        row.BookedBy,
                        row.FeedBy,
                        row.Company,
                        row.Package,
                        row.FcId,
                        row.Head,
                        row.NumberOfMembers
                    ];

                    if (currentUserId == 1 || currentUserId == 5 || currentUserId == 11 || currentUserId == 12) {
                        let currency = row.Currency || "Unknown";
                        let amount = parseFloat(row.RemaingAmount) || 0;

                        if (!currencyTotals[currency]) {
                            currencyTotals[currency] = 0;
                        }
                        currencyTotals[currency] += amount;

                        rowData.push(`${currency} ${amount.toLocaleString()}`);
                    }

                    tableData.push(rowData);
                });

                if (currentUserId == 1 || currentUserId == 5 || currentUserId == 11 || currentUserId == 12) {
                    Object.keys(currencyTotals).forEach(currency => {
                        tableData.push([
                            "", "", "", "", "", "", `Total (${currency}):`, "", `${currency} ${currencyTotals[currency].toLocaleString()}`
                        ]);
                    });
                }

                const headers = [
                    "#", "Booked By", "Feed By", "HGO", "PKG", "HB #", "Family Head Name", "PAX"
                ];

                if (currentUserId == 1 || currentUserId == 5 || currentUserId == 11 || currentUserId == 12) {
                    headers.push("Remaining Amount");
                }

                const columnStyles = {
                    0: { cellWidth: 10 },
                    1: { cellWidth: 20 },
                    2: { cellWidth: 20 },
                    3: { cellWidth: 23 },
                    4: { cellWidth: 25 },
                    5: { cellWidth: 15 },
                    6: { cellWidth: 25 },
                    7: { cellWidth: 20 },
                    8: { cellWidth: 28 },
                    9: { cellWidth: 25 }
                };

                doc.autoTable({
                    head: [headers],
                    body: tableData,
                    startY: 30,
                    theme: 'striped',
                    columnStyles: columnStyles,
                });

                doc.save("FamilyHeadReport.pdf");
            });
        });

        $("#exportExcel").on("click", function () {
            let workbook = new ExcelJS.Workbook();
            let worksheet = workbook.addWorksheet("Family Head Report");

            let headers = ["#", "Booked By", "Feed By", "HGO", "PKG", "HB #", "Family Head Name", "PAX"];
            if (currentUserId == 1) {
                headers.push("Remaining Amount");
            }
            worksheet.addRow(headers);

            // Check if any filters are applied
            const combinedFilter = dataGrid.getCombinedFilter();
            const hasFilters = combinedFilter && combinedFilter.length > 0;

            // Get data based on whether filters are applied
            const dataToExport = hasFilters ? dataGrid.getDataSource().items() : gridData;
            let currencyTotals = {};

            dataToExport.forEach((row, index) => {
                let rowData = [
                    index + 1,
                    row.BookedBy,
                    row.FeedBy,
                    row.Company,
                    row.Package,
                    row.FcId,
                    row.Head,
                    row.NumberOfMembers
                ];

                if (currentUserId == 1 || currentUserId == 5 || currentUserId == 11 || currentUserId == 12) {
                    let currency = row.Currency || "Unknown";
                    let amount = parseFloat(row.RemaingAmount) || 0;

                    if (!currencyTotals[currency]) {
                        currencyTotals[currency] = 0;
                    }
                    currencyTotals[currency] += amount;

                    rowData.push(`${currency} ${amount.toLocaleString()}`);
                }

                worksheet.addRow(rowData);
            });

            // Add totals at the bottom
            Object.keys(currencyTotals).forEach(currency => {
                worksheet.addRow([
                    "",
                    "",
                    "",
                    "",
                    "",
                    "",
                    `Total (${currency}):`,
                    "",
                    `${currency} ${currencyTotals[currency].toLocaleString()}`
                ]);
            });

            // Auto-fit columns
            worksheet.columns.forEach(column => {
                column.width = 15;
            });

            workbook.xlsx.writeBuffer().then(function (buffer) {
                var blob = new Blob([buffer], { type: "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" });
                var link = document.createElement("a");
                link.href = URL.createObjectURL(blob);
                link.download = "FamilyHeadReport.xlsx";
                link.click();
            });
        });
    });

    function confirmDelete(id) {
        let del = confirm("Are you sure?")
        if (del) {
            location.href = `/DataForm/TrashFamily/${id}`;
        }
    }

    function copyHref(event, link) {
        event.preventDefault();
        var href = link.href;

        var tempInput = document.createElement('input');
        tempInput.setAttribute('value', href);
        document.body.appendChild(tempInput);

        tempInput.select();
        tempInput.setSelectionRange(0, 99999); // For mobile devices

        document.execCommand('copy');

        document.body.removeChild(tempInput);

        var tooltip = document.getElementById('tooltip');
        tooltip.classList.add('show');
        setTimeout(function () {
            tooltip.classList.remove('show');
        }, 2000); // Hide tooltip after 2 seconds
    }

    $(document).ready(function () {
        $('#congratulations-dropdown').hover(function () {
            $(this).find('.dropdown-toggle').dropdown('toggle');
        });
    });

    let tablee = new DataTable('#table', {
        dom: 'Bfrtip',
        buttons: [{
            text: 'Export to Excel',
            extend: 'excelHtml5',
            className: 'btn btn-dark',
            exportOptions: {
                columns: ':visible'
            }
        }],
        paging: true,
        pageLength: 50,
        order: [0, 'desc']
    });

</script>