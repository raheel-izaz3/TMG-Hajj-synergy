@model RequiredDocument


@{
    string modelName = "Required Document";
    string modelNamePlural = "Required Documents";
    string modelControllerRoute = "RequiredDocument";
    TMG.Data.TMGDbContext _db;
}


<div class="container-xxl flex-grow-1 container-p-y">
    <h4 class="fw-bold" style="color:  #404040;"><span class="text-muted fw-light"> @modelName / </span> Create</h4>

    <hr class="mb-4" />

    <div class="row">
        <div class="col-sm-12">
            <div class="card mb-4">
                <div class="card-body">
                    <form method="post">
                        <div class="row">
                            <div class="col-sm-12 col-md-3 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname" asp-for="DocumentsCode"></label>
                                <div class="input-group input-group-merge">
                                    <span id="basic-icon-default-fullname2" class="input-group-text"><i class="bx bx-building"></i></span>
                                    <input asp-for="DocumentsCode" class="form-control">
                                </div>
                                <span class="text-danger" asp-validation-for="DocumentsCode"></span>
                            </div>
                            <div class="col-sm-12 col-md-9 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname" asp-for="Documents"></label>
                                <div class="input-group input-group-merge">
                                    <span id="basic-icon-default-fullname2" class="input-group-text"><i class="bx bx-building"></i></span>
                                    <input asp-for="Documents" class="form-control">
                                </div>
                                <span class="text-danger" asp-validation-for="Documents"></span>
                            </div>
                            <div class="col-sm-12 mt-4">
                                <button type="submit" class="btn btn-success float-end">Create</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>

</div>