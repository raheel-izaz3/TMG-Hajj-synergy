@model LetterHead

@{
	string modelName = "LetterHead";
	string modelNamePlural = "Cities";
	string modelControllerRoute = "LetterHead";
}


<div class="container-xxl flex-grow-1 container-p-y">
	<h4 class="fw-bold" style="color:  #404040;"><span class="text-muted fw-light"> @modelName / </span> Create</h4>

	<hr class="mb-4" />

	<div class="row">
		<div class="col-sm-12">
			<div class="card mb-4">
				<div class="card-body">
					<form method="post" enctype="multipart/form-data">
						<div class="row">
							<div class="col-sm-12 col-md-6 mb-3">
								<label class="form-label" for="basic-icon-default-fullname">Company</label>
								<div class="input-group input-group-merge">
									<select class="form-control" asp-for="CompanyId">
										@foreach (Company company in ViewBag.Company)
										{
											<option value="@company.CompanyId">@company.CompanyName</option>
										}
									</select>
								</div>
								<span class="text-danger" asp-validation-for="CompanyId"></span>
							</div>
							<div class="col-sm-12 col-md-6 mb-3">
								<label class="form-label" for="basic-icon-default-fullname">Department</label>
								<div class="input-group input-group-merge">
									<select class="form-control" asp-for="CompanyDepartmentId">
										@foreach (CompanyDepartment dep in ViewBag.Department)
										{
											<option value="@dep.CompanyDepartmentId">@dep.CompanyDepartmentName</option>
										}
									</select>
								</div>
								<span class="text-danger" asp-validation-for="CompanyDepartmentId"></span>
							</div>
							<div class="col-sm-12 mb-3">
								<label class="form-label" for="basic-icon-default-fullname" asp-for="Data"></label>
								<div class="input-group input-group-merge">
									<textarea asp-for="Data" id="summernote"></textarea>
								</div>
								<span class="text-danger" asp-validation-for="Data"></span>
							</div>
							<div class="col-sm-12 mt-4">
								<button type="submit" class="btn btn-success float-end">Create</button>
							</div>
						</div>
					</form>
				</div>
			</div>

		</div>
	</div>

</div>



<script>

	$(document).ready(function () {
		$('#summernote').summernote({
			placeholder: 'Write your content here...',
			tabsize: 2,
			height: 200,
			fontSizes: ['8', '10', '12', '14', '18', '24', '36'],
			toolbar: [
				['style', ['bold', 'italic', 'underline', 'clear']],
				['font', ['strikethrough', 'superscript', 'subscript']],
				['fontsize', ['fontsize']], // Font size dropdown enable karega
				['color', ['color']],
				['para', ['ul', 'ol', 'paragraph']],
				['height', ['height']]
			]
		});

		$('select[name="CompanyId"]').select2({
			placeholder: "Select Company",
			allowClear: true,
			width: '100%', // Adjust the width as needed
			dropdownCssClass: 'form-control',  // For the dropdown
			selectionCssClass: 'form-control'  // For the selected item
		});

		$('select[name="CompanyDepartmentId"]').select2({
			placeholder: "Select Company",
			allowClear: true,
			width: '100%', // Adjust the width as needed
			dropdownCssClass: 'form-control',  // For the dropdown
			selectionCssClass: 'form-control'  // For the selected item
		});
	});

</script>