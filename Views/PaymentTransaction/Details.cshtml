@model TMG.Models.ClientModels.ClientCompanyTransactionIndexViewModel

@{
    ViewData["Title"] = "Transaction Details";
}

<div class="container-xxl flex-grow-1 container-p-y">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="fw-bold m-0"><span class="text-muted fw-light">Transactions /</span> Details</h4>
        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-success">
                <i class="bx bx-pencil me-1"></i> Edit
            </a>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="bx bx-arrow-back me-1"></i> Back
            </a>
        </div>
    </div>

    <hr class="mb-4" />

    <div class="row">
        <div class="col-lg-8 mx-auto">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-light d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0 fw-bold">Transaction Details #@Model.Id</h5>
                    @{
                        string statusClass = Model.Status switch
                        {
                            "Confirmed" => "bg-success",
                            "Pending" => "bg-warning text-dark",
                            "Bounced" => "bg-danger",
                            "Cancelled" => "bg-danger",
                            _ => "bg-secondary"
                        };
                    }
                    <span class="badge @statusClass fs-6">@Model.Status</span>
                </div>
                <div class="card-body mt-3">
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted font-weight-bold">Booking For:</div>
                        <div class="col-sm-8"><span class="badge bg-label-primary">@Model.BookingFor</span></div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted font-weight-bold">Partner Name:</div>
                        <div class="col-sm-8 fw-bold text-dark">@Model.PartnerName</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted font-weight-bold">Booking Reference:</div>
                        <div class="col-sm-8 text-primary fw-bold">@Model.BookingCode</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted font-weight-bold">Amount (PKR):</div>
                        <div class="col-sm-8 text-success fw-bold fs-5">@Model.AmountPkr.ToString("N2") PKR</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted font-weight-bold">Payment Type:</div>
                        <div class="col-sm-8">@Model.PaymentType</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted font-weight-bold">Payment Date:</div>
                        <div class="col-sm-8">@Model.PaymentDate.ToString("dd-MMM-yyyy")</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted font-weight-bold">Ref / Cheque No:</div>
                        <div class="col-sm-8">@(string.IsNullOrEmpty(Model.ReferenceChequeNo) ? "-" : Model.ReferenceChequeNo)</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted font-weight-bold">Proof Document:</div>
                        <div class="col-sm-8">
                            @if (!string.IsNullOrEmpty(Model.ProofFilePath))
                            {
                                <a href="@Model.ProofFilePath" target="_blank" class="btn btn-sm btn-outline-primary">
                                    <i class="bx bx-file me-1"></i> Open Proof File
                                </a>
                            }
                            else
                            {
                                <span class="text-muted">No proof uploaded</span>
                            }
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted font-weight-bold">Notes:</div>
                        <div class="col-sm-8">@(string.IsNullOrEmpty(Model.Notes) ? "-" : Model.Notes)</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted font-weight-bold">Created At:</div>
                        <div class="col-sm-8 text-muted">@Model.CreatedAt.ToString("dd-MMM-yyyy hh:mm tt")</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
