@model ReservationAllocateModel

@{
    string modelName = "Reservation";
    string modelNamePlural = "Reservations";
    string modelControllerRoute = "Reservation";
}

<div class="container-xxl flex-grow-1 container-p-y">
    <h4 class="fw-bold"><span class="text-muted fw-light">@modelNamePlural</span> / Allocate</h4>

    <hr class="mb-4" />

    <div class="row">
        <div class="col-sm-12 col-md-2">
            <b>Hotel #: @Model.HotelNumber</b>
        </div>
        <div class="col-sm-12 col-md-2 mb-2">
            <b>Hotel Code: @Model.HotelCode</b>
        </div>
        <div class="col-sm-12 col-md-2 mb-2">
            <b>Place: @Model.Place</b>
        </div>
        <div class="col-sm-12 col-md-3 mb-2">
            <b>Reserved By: @Model.CompanyName</b>
        </div>
        <div class="col-sm-12 col-md-3 mb-2">
            <b>RSV #: @Model.RSVNumber</b>
        </div>
        <div class="col-sm-12 col-md-3 mb-2">
            <b>Check In: @Model.CheckIn</b>
        </div>
        <div class="col-sm-12 col-md-3 mb-2">
            <b>Check Out: @Model.CheckOut</b>
        </div>

    </div>


    <hr class="mb-4" />

    <h5>Reserved Rooms</h5>
    <div class="card p-2">
        <div class="table-responsive text-nowrap ">
            <table class="table table-hover" id="table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Type</th>
                        <th>Code</th>
                        <th>Room #</th>
                    </tr>
                </thead>
                <tbody class="table-border-bottom-1">

                    @foreach (RoomDetailEntryModel entry in Model.RoomDetails)
                    {
                        <tr>
                            <td>
                                <i class="fab fa-bootstrap fa-lg text-primary me-3"></i> <strong>@entry.Sno</strong>
                            </td>
                            <td>@entry.RoomType</td>
                            <td>@entry.RoomCode</td>
                            <td>@entry.RoomNumber</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <hr class="my-4" />

    <h5>Sub Group Members</h5>
    <div class="card p-2">
        <div class="row">
            <form method="post">
                <div class="col-sm-12">
                    <div class="table-responsive text-nowrap ">
                        <table class="table table-hover" id="table">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>CID</th>
                                    <th>Name</th>
                                    <th>Gender</th>
                                    <th>Passport</th>
                                    <th>F#</th>
                                    <th>Room Type</th>
                                    <th>Allocate Room</th>
                                </tr>
                            </thead>
                            <tbody class="table-border-bottom-1">
                                @{
                                    int i = 0;
                                }
                                @foreach (ReservationAllocateSubMemberEntryModel entry in Model.SubMembers)
                                {
                                    <input type="hidden" name="FamilyHeadIds[@i]" value="@entry.FamilyHeadId" />

                                    <tr>
                                        <td>
                                            <i class="fab fa-bootstrap fa-lg text-primary me-3"></i> <strong>@entry.Sno</strong>
                                        </td>
                                        <td>@entry.CID</td>
                                        <td>@Html.Raw(entry.Name)</td>
                                        <td>@entry.Gender</td>
                                        <td>@entry.PassportNumber</td>
                                        <td>@entry.FNumber</td>
                                        <td>@entry.RoomType</td>
                                        <td>
                                            <select name="RoomReservationIds[@i]" class="form-control">
                                                <option value="">Select a Room</option>
                                                @foreach (RoomDetailEntryModel item in Model.RoomDetails)
                                                {
                                                    <option value="@item.ReservationRoomsId">@item.RoomCode</option>
                                                }
                                            </select>
                                        </td>
                                    </tr>
                                    i++;
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="col-sm-12 my-2">
                    <button type="submit" class="btn btn-success">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>


