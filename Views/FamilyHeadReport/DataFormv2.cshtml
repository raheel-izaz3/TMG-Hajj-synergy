                            ACCOMMODATION TYPE: <span class="fillable">
                                @item.MakkahAccomodation?.AccommodationType
                            </span>
                        </p>
                        <p>Name: <span class="fillable">
                                @item.MakkahAccomodation?.AccomodationName
                            </span></p>
                        <p>
                            Category: <span class="fillable">
                                @item.MakkahAccomodation?.Category
                            </span>
                        </p>
                        <p class="d-inline">CHECK IN: <span class="fillable">@item.MakkahAccomodation?.CheckIn</span></p>
                        <p class="d-inline">DAYS: <span class="fillable">@item.MakkahAccomodation?.Days</span></p>
                        <p>DISTANCE (METERS): <span class="fillable">@item.MakkahAccomodation?.Distance</span></p>
                        <p>FOOD PACKAGE: <span class="fillable">@item.MakkahAccomodation?.FoodPackage</span></p>
                        <p>LOAD PER ROOM / WASHROOM: <span class="fillable">@* @item.MakkahAccomodation?.LoadPerRoom /
                                @item.MakkahAccomodation?.LoadPerWashroom *@</span> <b>@item.MakkahAccomodation?.IADF</b></p>
                        <p>ROOM SHARING: <span class="fillable">@item.MakkahAccomodation?.RoomSharing</span></p>
                            @* <p STYLE="text-decoration: underline;">If "Family Room" is selected, please refer to the details
                                provided in the "Individual Facilities" column below.</p> *@
                        }
                        else
                        {
                            <p class="text-center">N/A</p>
                        }
                    </td>
                    <td class="border-right" colspan="5" style="width: 25%;">
                        <u class="d-block text-center">IN AZIZIA</u>
                        @if (item.AziziaAccomodation is not null)
                        {
                            <p>
                                ACCOMMODATION TYPE: <span class="fillable">
                                    @item.AziziaAccomodation?.Type
                                </span>
                            </p>
                            <p>Name: <span class="fillable">
                                    @item.AziziaAccomodation?.Name
                                </span></p>
                            @* <p class="d-inline">CATEGORY: <span class="fillable">@item.AziziaAccomodation?.Category</span></p> *@
                            <p class="d-inline">CHECK IN: <span class="fillable">@item.AziziaAccomodation?.CheckIn</span></p> <br>
                            <p class="d-inline">DAYS: <span class="fillable">@item.AziziaAccomodation?.Days</span></p>
                            @Html.Raw("&nbsp; &nbsp;")
                            <p class="d-inline">DISTANCE (METER): <span class="fillable">@item.AziziaAccomodation?.Distance</span></p>
                            <p>FOOD PACKAGE: <span class="fillable">@item.AziziaAccomodation?.FoodPackage</span></p>
                            <p>LOAD PER ROOM / WASHROOM: <span class="fillable">@* @item.AziziaAccomodation?.LoadPerRoom / @item.AziziaAccomodation?.LoadPerWashroom *@</span>
                            <b>@item.AziziaAccomodation?.IADF</b> </p>
                            <p>HARAM SHUTTLE: <span class="fillable">@item.AziziaAccomodation?.HaramShuttle</span></p>
                            <p>RELIGIOUS LECTURES: <span class="fillable">@item.AziziaAccomodation?.ReligiousLectures</span></p>
                        }
                        else
                        {
                            <p class="text-center">N/A</p>
                        }
                    </td>
                    <td class="border-right" colspan="3" style="width: 25%;">
                        <u class="d-block text-center">IN MASHAIR</u>
                        @if (item.MinaAccomodation is not null)
                        {
                            <p>
                                MAKTAB: <span class="fillable">
                                    @item.MinaAccomodation?.Category
                                </span>
                            </p>
                            <p class="d-inline">CHECK IN: <span class="fillable">08ZH 1445-H</span></p>

                            <p class="d-inline">DAYS: <span class="fillable">5 (MINA/ ARAFAT/ MUZDALIFAH)</span></p>
                            <p>FOOD PACKAGE: <span class="fillable">@item.MinaAccomodation?.FoodPackage</span></p>
                            <p>SOFA MATTRESS / SITTING: <span class="fillable">@item.MinaAccomodation?.SofaSitting</span> <br>
                                CAMP/TENT SHARING: <span class="fillable">>@item.MinaAccomodation?.CampTent</span> <br>
                                ARAFAT: <span class="fillable">>@item.MinaAccomodation?.Arafat</span> <br>
                                RELIGIOUS LECTURES: <span class="fillable">>@item.MinaAccomodation?.ReligiousLectures</span>
                            </p>
                        }
                        else
                        {
                            <p class="text-center">N/A</p>
                        }
                    </td>
                    <td class="border-right" colspan="5" style="width: 25%;">
                        <u class="d-block text-center">IN MEDINA</u>
                        @if (item.MedinaAccomodation is not null)
                        {
                        <p>
                            ACCOMMODATION TYPE: <span class="fillable">
                                @item.MedinaAccomodation?.AccommodationType
                            </span>
                        </p>
                        <p>Name: <span class="fillable">
                                @item.MedinaAccomodation?.AccomodationName
                            </span></p>
                        <p>
                            Category: <span class="fillable">
                                @item.MedinaAccomodation?.Category
                            </span>
                        </p>
                        <p class="d-inline">CHECK IN: <span class="fillable">@item.MedinaAccomodation?.CheckIn</span></p>
                        <p class="d-inline">DAYS: <span class="fillable">@item.MedinaAccomodation?.Days</span></p>
                        <p>DISTANCE (METERS): <span class="fillable">@item.MedinaAccomodation?.Distance</span></p>
                        <p>FOOD PACKAGE: <span class="fillable">@item.MedinaAccomodation?.FoodPackage</span></p>
                        <p>LOAD PER ROOM / WASHROOM: <span class="fillable">@* @item.MedinaAccomodation?.LoadPerRoom /
                                @item.MedinaAccomodation?.LoadPerWashroom  *@
                            </span> <b>@item.MedinaAccomodation.IADF</b>
                        </p>
                        <p>ROOM SHARING: <span class="fillable">@item.MedinaAccomodation?.RoomSharing</span></p>
                        @* <p STYLE="text-decoration: underline;">If "Family Room" is selected, please refer to the details
                                provided in the "Individual Facilities" column below.</p> *@
                        }
                        else
                        {
                            <p class="text-center">N/A</p>
                        }
                    </td>
                }


            </tr>

        </table>

        <table class="table accommodation">
            <tr class="border">
                <td class="border-right" colspan="10">
                    <p class="h5 text-center mb-0">INDIVIDUAL FACILITIES AND GIVEAWAYS</p>
                </td>
            </tr>
            <tr>
                <td class="border-right col-4">
                    <h6>* Individual ADDITIONAL Facilities (I-ADF)
                        <span class="fillable show-prices-fac">
                            <label>show prices</label>
                            <input type="checkbox" class="show-prices-fac" onchange="onFacPricesCheck(this)" checked />
                        </span>
                    </h6>
                    
                    @foreach (DataFormIndividualFacility fac in item.IndividualFacilities)
                    {
                        <span>
                            <b>* @fac.Id</b> - @fac.Description
                            <b class="pkr-fac-prices fac-prices" style="display: none;">(PKR @fac.PricePkr/-)</b>
                            <b class="sar-fac-prices fac-prices" style="display: none;">(SAR @fac.PriceSar/-)</b>
                            <b class="usd-fac-prices fac-prices" style="display: inline;">(USD $@fac.PriceUsd/-)</b>
                        </span>

                        <br />

                    }
                </td>
                <td class="border-right col-4">
                    <h6>** Extra INDIVIDUAL ADDITIONAL Facilities (EI-ADF)
                        <span class="fillable show-prices-extra hideInPrint">
                            <label class="hideInPrint">show prices</label>
                            <input type="checkbox" class="show-prices-extra hideInPrint" id="check-extra"
                                onchange="onExtraPricesCheck(this)" checked />
                        </span>
                    </h6>

                    @{
                        int n = 1;
                    }
                    @foreach (DataFormExtraFacility fac in item.ExtraFacilities)
                    {
                        <span>
                            <b>** @n</b> - @fac.Description
                            <b class="pkr-extra-prices extra-prices" style="display: none;">(PKR @fac.PricePkr/-)</b>
                            <b class="sar-extra-prices extra-prices" style="display: none;">(SAR @fac.PriceSar/-)</b>
                            <b class="usd-extra-prices extra-prices" style="display: inline;">(USD $@fac.PriceUsd/-)</b>
                        </span>

                        <br />

                        n++;
                    }
                </td>
                <td class="border-right col-4">
                    <h6>GIVEAWAYS</h6>
                    @{
                        int m = 1;
                    }
                    @foreach (DataFormGift gift in item.Gifts)
                    {
                        <span class="" style="padding-right: 10px">
                            <b>@m</b> - @gift.Gift
                        </span>

                        m++;
                    }
                </td>
            </tr>
            <tr class="border">
                <td class="border-right" colspan="10">
                    <p class="d-inline fw-bold">Remarks: </p>
                    @{
                        int r = 0;
                    }
                    @if(item.Remarks.Count == 0){
                        <p class="d-inline fw-bold">N/A</p>
                    }
                    @foreach(string s in item.Remarks){
                        r++;
                        <p class="d-inline">@r: @s</p>
                    }
                </td>
            </tr>
            <tr class="border">
                <td class="border-right" colspan="10">
                    <ul id="l1">
                        <li data-list-text="-">
                            I have read and accepted all terms and conditions of the package, including the agreement and
                            details.
                            I confirm my choices for Additional & Individual Additional Facilities. All provided information
                            is accurate, and I commit to following MORA/MOH KSA regulations and Taleemat.
                        </li>
                    </ul>
                </td>
            </tr>
            <tr class="border">
                <td class="border-right" colspan="10">
                    <div class="d-flex justify-content-around align-items-stretch  ">
                        <div class="col-4 d-flex-column px-3 ">
                            <p class="border-bottom border-dark  d-flex justify-content-center align-items-end" style="height: 90px;">@item.SignedDate</p>
                            <p class="text-center text-nowrap ">Date</p>
                        </div>
                        <div class="col-5 d-flex-column px-3 ">
                            @if (item.SignatureBase64 is not null && item.ShowSignature)
                            {
                                <p class="text-center border-bottom border-dark">
                                    <img loading="lazy" src="@item.SignatureBase64" width="180px" />
                                </p>
                            }
                            else
                            {
                                <p class="text-center ">
                                <div style="height: 90px;" class="border-bottom border-dark"></div>
                                </p>
                            }
                            <p class="text-center text-nowrap ">
                                SIGNATURE &amp; THUMB IMPRESSION OF APPLICANT
                            </p>
                        </div>
                    </div>
                </td>

            </tr>
        </table>
    </div>
    <div class="page-break"></div>
}
<script>
    function onFacPricesCheck(elem) {
        const prices = document.getElementsByClassName('fac-prices')
        for (let price of prices) {
            price.style.display = elem.checked ? "inline" : "none"
        }
    }

    function onExtraPricesCheck(elem) {
        const prices = document.getElementsByClassName('extra-prices')
        for (let price of prices) {
            price.style.display = elem.checked ? "inline" : "none"
        }
    }


    function onHajjPackageCurrencyChange(val) {
        const pkrs = document.getElementsByClassName("package-pkr")
        const sars = document.getElementsByClassName("package-sar")
        const usds = document.getElementsByClassName("package-usd")

        const pkrs_fac = document.getElementsByClassName("pkr-fac-prices")
        const sars_fac = document.getElementsByClassName("sar-fac-prices")
        const usds_fac = document.getElementsByClassName("usd-fac-prices")

        const pkrs_extra_fac = document.getElementsByClassName("pkr-extra-prices")
        const sars_extra_fac = document.getElementsByClassName("sar-extra-prices")
        const usds_extra_fac = document.getElementsByClassName("usd-extra-prices")

        const checkExtra = document.getElementById("check-extra")


        if (val == "pkr") {
            for (let e of pkrs) {
                e.style.display = 'inline';
            }
            for (let e of pkrs_fac) {
                e.style.display = 'inline';
            }

            for (let e of sars) {
                e.style.display = 'none';
            }
            for (let e of sars_fac) {
                e.style.display = 'none';
            }

            for (let e of usds) {
                e.style.display = 'none';
            }
            for (let e of usds_fac) {
                e.style.display = 'none';
            }

            if (checkExtra.checked) {
                for (let e of pkrs_extra_fac) {
                    e.style.display = 'inline';
                }
                for (let e of sars_extra_fac) {
                    e.style.display = 'none';
                }
                for (let e of usds_extra_fac) {
                    e.style.display = 'none';
                }
            }

        }
        else if (val == 'sar') {
            for (let e of pkrs) {
                e.style.display = 'none';
            }
            for (let e of pkrs_fac) {
                e.style.display = 'none';
            }

            for (let e of sars) {
                e.style.display = 'inline';
            }
            for (let e of sars_fac) {
                e.style.display = 'inline';
            }

            for (let e of usds) {
                e.style.display = 'none';
            }
            for (let e of usds_fac) {
                e.style.display = 'none';
            }

            if (checkExtra.checked) {
                for (let e of pkrs_extra_fac) {
                    e.style.display = 'none';
                }
                for (let e of sars_extra_fac) {
                    e.style.display = 'inline';
                }
                for (let e of usds_extra_fac) {
                    e.style.display = 'none';
                }
            }
        }
        else {
            for (let e of pkrs) {
                e.style.display = 'none';
            }
            for (let e of pkrs_fac) {
                e.style.display = 'none';
            }

            for (let e of sars) {
                e.style.display = 'none';
            }
            for (let e of sars_fac) {
                e.style.display = 'none';
            }

            for (let e of usds) {
                e.style.display = 'inline';
            }
            for (let e of usds_fac) {
                e.style.display = 'inline';
            }

            if (checkExtra.checked) {
                for (let e of pkrs_extra_fac) {
                    e.style.display = 'none';
                }
                for (let e of sars_extra_fac) {
                    e.style.display = 'none';
                }
                for (let e of usds_extra_fac) {
                    e.style.display = 'inline';
                }
            }
        }
    }

</script>