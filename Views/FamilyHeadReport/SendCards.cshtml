        /* Print Styling  */
        @@media print {
            body {
                margin: 0 !important; /* Remove default margin */
                padding: 40px !important; /* Add padding for print */
            }

            table {
                width: 100% !important; /* Ensure tables take full width */
            }

            .card-images img {
                width: 80px !important;
                height: 50px !important;
            }

            table.dataTable thead .sorting {
                background-image: none !important;
            }

            .print-btn {
                display: none !important;
            }

            div#first-table_wrapper,
            div#secound-table_wrapper {
                display: none;
            }

            .terms-conditions {
                max-width: 100%; /* Ensure it fits within the printable area */
                overflow: hidden; /* Allow overflow for printing */
            }


            .zulhaj-date {
                grid-template-columns: repeat(5, 1fr); /* Ensure 5 equal columns for print */
                overflow: hidden; /* Prevent overflow */
            }

                .zulhaj-date h5 {
                    white-space: nowrap; /* Prevent text wrapping */
                    overflow: hidden; /* Hide overflow */
                    text-overflow: ellipsis; /* Add ellipsis for overflow text */
                }
        }

        /* Print Styling End  */

        /* Add this CSS for page breaks */
        .page-break {
            display: block;
            height: 0;
            page-break-after: always;
        }

        /* Adjust image styles to prevent extra space */
        .card-images img {
            width: 80px !important; /* Adjust width as needed */
            height: auto; /* Maintain aspect ratio */
            display: block; /* Ensure no extra space */
            margin: 0 auto; /* Center the image */
            page-break-inside: avoid; /* Prevent page break inside images */
        }

        /* Prevent extra space around elements */
        .itinerary {
            margin: 0; /* Remove margin */
            padding: 0; /* Remove padding */
            overflow: hidden; /* Prevent overflow */
        }

        /* Ensure tables do not exceed page height */
        table {
            page-break-inside: avoid; /* Prevent page break inside tables */
            width: 100%; /* Ensure tables take full width */
            border-collapse: collapse; /* Prevent extra space */
        }

        /* Remove any default margins from headings */
        h1, h2, h3, h4, h5, h6 {
            /* margin: 0; */ /* Remove margin */
            /* padding: 0; */ /* Remove padding */
        }

        /* Remove padding and margin from paragraphs */
        p {
            margin: 0; /* Remove margin */
            padding: 0; /* Remove padding */
        }

        /* Ensure content fits within the page */
        .itinerary > * {
            page-break-inside: avoid; /* Prevent page break inside content */
        }
