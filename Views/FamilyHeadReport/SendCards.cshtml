    <script>
        // Show/hide multiple elements of a class
        function toggleSection(className) {
          const elements = document.querySelectorAll(`.${className}`);
          elements.forEach(el => {
            el.style.display = el.style.display === "none" ? "" : "none";
          });
        }

        // Collect unchecked class names
        function getUncheckedSectionClasses() {
          const checkboxes = document.querySelectorAll('input[type="checkbox"][data-section]');
          const uncheckedClasses = [];
          checkboxes.forEach(cb => {
            if (!cb.checked) {
              uncheckedClasses.push(cb.getAttribute("data-section"));
            }
          });
          return uncheckedClasses;
        }

        // Wrapper around your existing downloadPDF function
        async function handlePDFDownload() {
          const hiddenSections = [];

          // Hide unchecked sections
          const uncheckedClasses = getUncheckedSectionClasses();
          uncheckedClasses.forEach(className => {
            const elements = document.querySelectorAll(`.${className}`);
            elements.forEach(el => {
              if (el.style.display !== "none") {
                hiddenSections.push(el);
                el.style.display = "none";
              }
            });
          });

          // Call your unchanged downloadPDF function
          await downloadPDF();

          // Restore visibility
          hiddenSections.forEach(el => {
            el.style.display = "";
          });
        }

        async function downloadPDF() {
          const button = document.getElementById("downloadBtn");
          button.disabled = true;
          const originalText = button.innerText;
          button.innerText = "Generating PDF...";

          const { jsPDF } = window.jspdf;
          const doc = new jsPDF();

          // Only select visible sections
          const sections = document.querySelectorAll('.lower-section');
          const visibleSections = Array.from(sections).filter(section => section.style.display !== "none");

          const padding = 10;
          const pdfPageWidth = doc.internal.pageSize.getWidth();
          const pdfPageHeight = doc.internal.pageSize.getHeight();
          const pdfWidth = pdfPageWidth - 2 * padding;
          const pdfHeight = pdfPageHeight - 2 * padding;

          for (let i = 0; i < visibleSections.length; i++) {
            const section = visibleSections[i];
            const canvasEl = section.querySelector("canvas");

            let canvas;

            if (canvasEl) {
              // PDF rendered to <canvas>
              canvas = canvasEl;
            } else {
              // Fallback: generate canvas from HTML using html2canvas
              const clone = section.cloneNode(true);
              clone.style.position = 'absolute';
              clone.style.top = '-9999px';
              document.body.appendChild(clone);

              canvas = await html2canvas(clone, {
                scale: 1.5,
                backgroundColor: '#ffffff',
                useCORS: true,
                allowTaint: false,
                removeContainer: true,
              });

              document.body.removeChild(clone);
            }

            const imgData = canvas.toDataURL("image/png");
            const imgProps = doc.getImageProperties(imgData);

            // Calculate image dimensions
            let imgWidth = pdfWidth;
            let imgHeight = (imgProps.height * imgWidth) / imgProps.width;

            // Define minimum readable dimensions
            const minReadableHeight = 150; // Adjust as needed
            const minReadableWidth = 250;  // Adjust as needed

            // Check height first
            if (imgHeight < minReadableHeight) {
              imgHeight = Math.min(minReadableHeight, pdfPageHeight - 2 * padding);
              imgWidth = (imgProps.width * imgHeight) / imgProps.height;
            }

            // Then check width (and recalculate height again if needed)
            if (imgWidth < minReadableWidth) {
              imgWidth = Math.min(minReadableWidth, pdfPageWidth - 2 * padding);
              imgHeight = (imgProps.height * imgWidth) / imgProps.width;
            }

            const totalPages = Math.ceil(imgHeight / pdfHeight);

            for (let page = 0; page < totalPages; page++) {
              if (page > 0 || i > 0) doc.addPage();

              const yOffset = page * pdfHeight;
              const pageHeight = Math.min(pdfHeight, imgHeight - yOffset);
              const cropHeight = (canvas.height * pageHeight) / imgHeight;
              const sourceY = (canvas.height * yOffset) / imgHeight;

              const tempCanvas = document.createElement("canvas");
              tempCanvas.width = canvas.width;
              tempCanvas.height = cropHeight;

              const tempCtx = tempCanvas.getContext("2d");
              tempCtx.drawImage(
                canvas,
                0, sourceY,
                canvas.width, cropHeight,
                0, 0,
                canvas.width, cropHeight
              );

              const pageImgData = tempCanvas.toDataURL("image/png");
              doc.addImage(pageImgData, "PNG", padding, padding, pdfWidth, pageHeight);
            }
          }

          doc.save("all-sections.pdf");
          button.disabled = false;
          button.innerText = originalText;
        }


        async function handleEmailPDFDownload() {
          const hiddenSections = [];

          const uncheckedClasses = getUncheckedSectionClasses();
          uncheckedClasses.forEach(className => {
            const elements = document.querySelectorAll(`.${className}`);
            elements.forEach(el => {
              if (el.style.display !== "none") {
                hiddenSections.push(el);
                el.style.display = "none";
              }
            });
          });

          // Now generate and send to server
          await downloadEmailPDF();

          hiddenSections.forEach(el => {
            el.style.display = "";
          });
        }

        async function downloadEmailPDF() {
          const button = document.getElementById("downloadEmailBtn");
          button.disabled = true;
          const originalText = button.innerText;
          button.innerText = "Generating PDF...";

          const { jsPDF } = window.jspdf;
          const doc = new jsPDF();

          const sections = document.querySelectorAll('.lower-section');
          const visibleSections = Array.from(sections).filter(section => section.style.display !== "none");

          const padding = 10;
          const pdfPageWidth = doc.internal.pageSize.getWidth();
          const pdfPageHeight = doc.internal.pageSize.getHeight();
          const pdfWidth = pdfPageWidth - 2 * padding;
          const pdfHeight = pdfPageHeight - 2 * padding;

          for (let i = 0; i < visibleSections.length; i++) {
            const section = visibleSections[i];
            const canvasEl = section.querySelector("canvas");

            let canvas;

            if (canvasEl) {
              canvas = canvasEl;
            } else {
              const clone = section.cloneNode(true);
              clone.style.position = 'absolute';
              clone.style.top = '-9999px';
              document.body.appendChild(clone);

              canvas = await html2canvas(clone, {
                scale: 0.5,
                backgroundColor: '#ffffff',
                useCORS: true,
                allowTaint: false,
                removeContainer: true,
              });

              document.body.removeChild(clone);
            }

            const imgData = canvas.toDataURL("image/png");
            const imgProps = doc.getImageProperties(imgData);

            let imgWidth = pdfWidth;
            let imgHeight = (imgProps.height * imgWidth) / imgProps.width;

            const minReadableHeight = 150;
            const minReadableWidth = 250;

            if (imgHeight < minReadableHeight) {
              imgHeight = Math.min(minReadableHeight, pdfPageHeight - 2 * padding);
              imgWidth = (imgProps.width * imgHeight) / imgProps.height;
            }

            if (imgWidth < minReadableWidth) {
              imgWidth = Math.min(minReadableWidth, pdfPageWidth - 2 * padding);
              imgHeight = (imgProps.height * imgWidth) / imgProps.width;
            }

            const totalPages = Math.ceil(imgHeight / pdfHeight);

            for (let page = 0; page < totalPages; page++) {
              if (page > 0 || i > 0) doc.addPage();

              const yOffset = page * pdfHeight;
              const pageHeight = Math.min(pdfHeight, imgHeight - yOffset);
              const cropHeight = (canvas.height * pageHeight) / imgHeight;
              const sourceY = (canvas.height * yOffset) / imgHeight;

              const tempCanvas = document.createElement("canvas");
              tempCanvas.width = canvas.width;
              tempCanvas.height = cropHeight;

              const tempCtx = tempCanvas.getContext("2d");
              tempCtx.drawImage(
                canvas,
                0, sourceY,
                canvas.width, cropHeight,
                0, 0,
                canvas.width, cropHeight
              );

              const pageImgData = tempCanvas.toDataURL("image/png");
              doc.addImage(pageImgData, "PNG", padding, padding, pdfWidth, pageHeight);
            }
          }

        const pdfBlob = doc.output("blob");
        const id = "@ViewBag.Id"; 

        const formData = new FormData();
        formData.append("pdfFile", pdfBlob, "generated.pdf");
        formData.append("id", id);

        try {
          const response = await fetch("/Email/SendCard", {
            method: "POST",
            body: formData,
          });

          if (!response.ok) throw new Error("PDF upload failed");
          alert("PDF sent successfully!");
        } catch (error) {
          console.error("Upload error:", error);
          alert("Something went wrong while uploading PDF.");
        }

          button.disabled = false;
          button.innerText = originalText;
        }


    </script>
</body>

</html>