@model ItineraryReportModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!-- <title>Itenerary New Design </title> -->
    <!-- Jquery  -->
    <script src="https://code.jquery.com/jquery-1.11.3.min.js"></script>

    <!-- Data Tables.min.js  -->
    <script type="text/javascript"
            src="https://cdn.datatables.net/v/dt/jszip-2.5.0/dt-1.10.16/b-1.5.1/b-colvis-1.5.1/b-html5-1.5.1/b-print-1.5.1/fh-3.1.3/datatables.min.js"></script>

    <!-- DataTable min.css -->
    <link rel="stylesheet" type="text/css"
          href="https://cdn.datatables.net/v/dt/jszip-2.5.0/dt-1.10.16/b-1.5.1/b-colvis-1.5.1/b-html5-1.5.1/b-print-1.5.1/fh-3.1.3/datatables.min.css" />

    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.9.2/html2pdf.bundle.min.js"></script>



    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            font-weight: 600;
            box-sizing: border-box;
        }

        h1,
        h2,
        h3,
        h4,
        h5 {
            margin: 0 !important;
            padding: 0 !important;
        }

        table.dataTable.row-border tbody th,
        table.dataTable.row-border tbody td,
        table.dataTable.display tbody th,
        table.dataTable.display tbody td {
            border-top: none !important;
        }

        p {
            margin: 0 !important;
            padding: 0 !important;
            font-size: 10px;
        }

        table th {
            padding: 2px;
            font-size: 12px !important;
            text-align: center;
            background-color: #b0872e;
            color: white;
            font-weight: bold;
            border: 1px solid #b49164 !important;
        }

        table td {
            font-size: 10px !important;
            text-align: center;
            border: 1px solid #b0872e;
            background-color: white !important;
        }


        /* Custom Styling Start  */
        table.dataTable tbody th,
        table.dataTable tbody td {
            padding: 3px 10px !important;
        }

        .voucher-title {
            color: hsla(34, 76%, 36%, 0.979);
            text-transform: uppercase;
            font-size: 18px;
            margin-left: 25px;
        }

        .airline-title {
            margin-bottom: 35px !important;
        }

            .airline-title img {
                height: 85px;
            }

            .airline-title h1 {
                font-size: 18px !important;
                text-transform: uppercase;
                text-align: center;
                display: flex;
                justify-content: center;
                align-items: center;
                flex-wrap: wrap;
            }

        .primary-width {
            width: 95%;
        }

        .passenger-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 15px;
            margin-bottom: 5px;
        }


            .passenger-grid > div {
                text-align: center;
                border: 1px solid #b0872e;
            }

            .passenger-grid h3 {
                margin: 0 !important;
                padding: 0 !important;
                background-color: #b0872e;
                color: white;
                text-transform: uppercase;
            }

            .passenger-grid p {
                font-size: 12px;
            }

        #first-table {
            border-collapse: separate;
            width: 100%;
            border: none !important;
            margin-bottom: 10px;
        }

        #secound-table {
            border: 1px solid #a17014 !important;
        }

        .third-table {
            border-collapse: separate !important;
            table-layout: fixed !important;
            margin-top: 10px !important;
        }

            .third-table th {
                border-radius: 50px !important;
            }

            .third-table td {
                border: none !important;
            }


        .card-images {
            display: flex;
            gap: 15px;
        }

        .img-div {
            width: 100px !important;
            flex-grow: 1;
        }

            .img-div img {
                width: 100%;
                height: 100%;
                border: 4px solid #a17014;
            }



        .card-images h5 {
            font-size: 10px;
            text-align: center;
            width: 100%;
        }

        .zulhaj-date {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(100px, 1fr)) !important;
            font-size: 20px !important;
            color: #a17014;
            margin-top: 25px;
            margin: 0;
            padding: 0;
        }

            .zulhaj-date h5 {
                border: 1px solid white;
                box-shadow: 2px 2px 10px gray;
                margin: 10px;
                width: 65px;
                text-align: center;
                padding: 5px;
                font-size: 10px;
            }

            .zulhaj-date .box {
                display: flex;
                justify-content: center;
                align-items: center;
            }



            .zulhaj-date img {
                margin-left: 10px !important;
                display: inline-block;
                width: 20px;
                height: 20px;
            }

        .family-record {
            width: 100%;
            border: none !important;
            margin-bottom: 15px;
        }

            .family-record thead th {
                border: none !important;
                background-color: none !important;
                background-color: white;
                color: black;
                font-size: 20px;
            }

            .family-record td {
                border: none !important;
            }

        .print-btn {
            display: inline-block;
            padding: 0.5em 1em;
            margin-bottom: 15px;
            font-size: 16px;
            outline: gray;
            border-radius: 2px;
            border: 1px solid #999;
            background-color: #e9e9e9;
        }

        table.dataTable thead th,
        table.dataTable thead td {
            padding: 0px !important;
        }

        table.dataTable thead .sorting {
            background-size: 12px !important;
        }


        /* Print Styling  */
        @@media print {
            body {
                margin: 0px !important;
                padding: 0px !important;
            }

            .card-images img {
                width: 80px !important;
                height: 80px !important;
            }

            table.dataTable thead .sorting {
                background-image: none !important;
            }

            .print-btn {
                display: none !important;
            }

            div#first-table_wrapper,
            div#secound-table_wrapper {
                display: none;
            }
        }

        /* Print Styling End  */
    </style>
</head>

<body>

    <div class="itinerary">

        <button onclick="print()" class="print-btn">Print</button>
        <button id="download-pdf" class="print-btn">Download PDF</button>


        <h1 class="voucher-title">Voucher</h1>
        <br />
        <h2 class="voucher-title" style="font-size: 15px">Medinah Coordinator #:</h2>
        [Contact Here]
        <h2 class="voucher-title" style="font-size: 15px">Makkah Coordinator  #: </h2>
        [Contact Here]

        <table class="family-record">
            <thead>
            <th>CID</th>
            <th>PASSENGER NAME</th>
            <th>PASSPORT NO</th>
            <th>TICKET NUMBER</th>
            <th>PNR NO</th>
            <th>QURBANI</th>
            </thead>
            <tbody>
                @foreach (var m in Model.Members)
                {
                    <tr>
                        <td>@m.CID</td>
                        <td>@m.Name</td>
                        <td>@m.Passport</td>
                        <td>@m.TicketNumber</td>
                        <td>@m.PnrNumber</td>
                        <td>@m.Qurbani</td>

                    </tr>
                }
            </tbody>
        </table>

        <!-- First Flight Table Start  -->
        <table id="first-table" class="display nowrap " style="width: 100%; margin-top: 20px; ">
            <thead>
            <th>Flight #</th>
            <th>Sector</th>
            <th>Dep.Date</th>
            <th>Dep.Time</th>
            <th>Arr.Date</th>
            <th>Arr.Time</th>
            <th>
                Luggage
            </th>
            <th>Class</th>
            </thead>

            <tbody>
                @foreach (var s in Model.FlightSectors)
                {
                    <tr>
                        <td>@s.FlightNumber</td>
                        <td>@s.Sector</td>
                        <td>@s.DepartureDate</td>
                        <td>@s.DepartureTime</td>
                        <td>@s.ArrivalDate</td>
                        <td>@s.ArrivalTime</td>
                        <td>As Per Airline Policy</td>
                        <td>@s.Class</td>
                    </tr>
                }
            </tbody>


        </table>

        <!-- First Flight Table END -->
        <!-- Secound_table Start  -->
        <table id="secound-table" class="display nowrap " style="width: 100%; margin-top: 20px; ">
            <thead>
            <th>Hotel Name</th>
            <th>Check in</th>
            <th>Check out</th>
            <th>Night</th>
            <th>Room Type</th>
            <th>Qty</th>
            <th>Meal Plan</th>
            <th>View</th>
            <th>Confirmation #</th>
            </thead>

            <tbody>

                @foreach (var a in Model.Accommodations)
                {
                    <tr>
                        @if (a.CheckIn?.ToString() == "14 Jun" && (a.HotelName == null || a.HotelName == ""))
                        {
                            <td>Mashair (Mina/Arafat/Muzdalifah)</td>
                        }
                        else
                        {
                            <td>@a.HotelName</td>
                        }

                        <td>
                            @a.CheckIn?.Substring(0, 6)<br>
                        </td>
                        <td>
                            @a.CheckOut
                        </td>
                        <td>@a.Nights</td>
                        <td>@a.RoomType</td>
                        <td>@a.Quantity</td>
                        <td>@a.MealPlan</td>
                        <td>@a.View</td>
                        <td>@a.ConfimationNumber</td>
                    </tr>
                }
            </tbody>


        </table>

        <!-- Secound_table END  -->
        <!-- Third-custom Table  Start-->
        <table id="first-table" class="third-table">
            <thead>
            <th style="width: 100px;">Sector/Route</th>
            <th style="width: 60px">Vehicle</th>
            <th style="width: 60px;">Type</th>
            <th style="width: 60px;">Quantity</th>
            <th style="width: 60px;">Date</th>
            </thead>
            <tbody>
                @{
                    int counter = 0;
                    var location = "";
                }
                @foreach (var s in Model.Routes)
                {
                    counter++;
                    <tr>
                        <td>@s.Route</td>
                        <td>@s.Vehicle</td>
                        <td>@s.Type</td>
                        <td>@s.Quantity</td>

                        @if (location == "")
                        {
                            location = s.Route.ToString().Contains("Jeddah Airport to") ? "After Hajj" : "Before Hajj";
                        }
                        @if (location == "Before Hajj")
                        {
                            //before hajj

                            @for (int i = 0; i < Model.Accommodations.Count; i++)
                            {
                                @if (counter == 1 && i == 0)
                                {
                                    <td>@Model.Accommodations[i].CheckIn</td>
                                    break;
                                }
                                else if (counter == 2 && i == 1)
                                {
                                    <td>@Model.Accommodations[i].CheckIn</td>
                                    break;
                                }
                                else if (counter == 3 && i == 1 && (s.Route.ToString().Contains("Medinah Train Station") ||
                                s.Route.ToString().Contains("Medinah to Makkah")))
                                {
                                    <td>@Model.Accommodations[i].CheckIn</td>
                                    break;
                                }
                                else if (counter == 3 && i == 2)
                                {
                                    <td>@Model.Accommodations[i].CheckIn</td>
                                    break;
                                }

                                else if (s.Route.ToString().Contains("to Azizia") && (Model.Accommodations[i].HotelName != null ?
                                Model.Accommodations[i].HotelName.Contains("Azizia") : false))
                                {
                                    <td>@Model.Accommodations[i].CheckIn</td>
                                    break;
                                }
                                else if (s.Route.ToString().Contains("to Jeddah Airport"))
                                {
                                    int abc = 0;
                                    string ab = "";
                                    foreach (var item in Model.FlightSectors)
                                    {
                                        if (item.DepartureDate.Contains("Jul"))
                                        {
                                            abc = Convert.ToInt32(item.DepartureDate.Substring(0, 2));
                                            ab = item.DepartureDate;
                                            if ((item.Sector.Substring(0, 3).Contains("JED") || item.Sector.Substring(0, 3).Contains("MED")) && !item.Sector.Contains("JED-MED"))
                                            {
                                                break;
                                            }
                                        }
                                        else
                                        {
                                            if (Convert.ToInt32(item.DepartureDate.Substring(0, 2)) > abc)
                                            {
                                                abc = Convert.ToInt32(item.DepartureDate.Substring(0, 2));
                                                ab = item.DepartureDate;
                                                if ((item.Sector.Substring(0, 3).Contains("JED") || item.Sector.Substring(0, 3).Contains("MED")) && !item.Sector.Contains("JED-MED"))
                                                {
                                                    break;
                                                }
                                            }
                                        }

                                    }
                                    var count = Model.FlightSectors.Count;
                                    <td>@ab </td>
                                    break;
                                }
                                else if (s.Route.Contains("Azizia to Mashair"))
                                {
                                    <td>14 Jun </td>
                                    break;
                                }
                                else if (counter == 4 && i == 1 && s.Route.ToString().Contains("Makkah Train Station"))
                                {
                                    <td>@Model.Accommodations[i].CheckIn</td>
                                    break;
                                }
                                else if (counter == 4 && i == 2 && s.Route.ToString().Contains("Azizia Building to Makkah Hotel"))
                                {
                                    <td>@Model.Accommodations[i].CheckOut</td>
                                    break;
                                }
                                else if (counter == 4 && i == 2)
                                {
                                    <td>@Model.Accommodations[i].CheckIn</td>
                                    break;
                                }
                                else if (counter == 5 && i == 2 && s.Route.ToString().Contains("Makkah Hotel to Mashair"))
                                {
                                    <td>@Model.Accommodations[i].CheckIn</td>
                                    break;
                                }
                                else if (counter == 5 && i == 3)
                                {
                                    <td>@Model.Accommodations[i].CheckIn</td>
                                    break;
                                }
                                else if (s.Route.ToString().Contains("Azizia to Makkah Hotel"))
                                {
                                    foreach (var item in Model.Accommodations)
                                    {
                                        if (item.HotelName == "Rafahya Hotel Azizia" || item.HotelName == "Azizia Building")
                                        {
                                            <td>@item.CheckOut</td>
                                        }

                                    }

                                    break;
                                }
                                else if (counter == 6 && i == 3)
                                {
                                    <td>@Model.Accommodations[i].CheckIn</td>
                                    break;
                                }
                                else if (counter == 7 && i == 3)
                                {
                                    <td>@Model.Accommodations[i].CheckOut</td>
                                    break;
                                }
                            }
                        }
                        else
                        {
                            //after hajj
                            @for (int i = 0; i < Model.Accommodations.Count; i++)
                            {
                                @if (counter == 1 && i == 0)
                                {
                                    <td>@Model.Accommodations[i].CheckIn</td>
                                    break;
                                }
                                else if (counter == 2 && s.Route.ToString().Contains("Makkah Hotel to Azizia"))
                                {
                                    if (Model.Accommodations[i].HotelName.Contains("Azizia"))
                                    {
                                        <td>@Model.Accommodations[i].CheckIn</td>
                                        break;
                                    }
                                    @* <td>@Model.Accommodations[i].CheckIn</td>
                    break; *@
                                }
                                else if (counter == 2 && s.Route.ToString().Contains("to Mashair"))
                                {
                                    <td>14 Jun</td>
                                    break;
                                }
                                else if (counter == 3 && i == 2)
                                {
                                    <td>@Model.Accommodations[i].CheckIn</td>
                                    break;
                                }
                                else if (counter == 3 && i == 1 && (s.Route.ToString().Contains("Makkah  to Medinah") || s.Route.ToString().Contains("Azizia  to Jeddah Airport") || s.Route.ToString().Contains("Azizia to Jeddah Airport") || s.Route.ToString().Contains("Makkah to Medinah") || s.Route.ToString().Contains("Station  to Medinah Hotel")))
                                {
                                    if (Model.Accommodations.Count == 2)
                                    {
                                        <td>@Model.Accommodations[i].CheckIn</td>
                                        break;
                                    }
                                    else if (Model.Accommodations.Count == 3)
                                    {
                                        <td>@Model.Accommodations[2].CheckIn</td>
                                        break;
                                    }

                                }
                                else if (counter == 3 && i == 1 && (s.Route.ToString().Contains("Azizia  to Jeddah Airport") || s.Route.ToString().Contains("Azizia to Jeddah Airport")))
                                {
                                    int abc = 0;
                                    string ab = "";
                                    foreach (var item in Model.FlightSectors)
                                    {
                                        if (Convert.ToInt32(item.DepartureDate.Substring(0, 2)) > abc)
                                        {
                                            abc = Convert.ToInt32(item.DepartureDate.Substring(0, 2));
                                            ab = item.DepartureDate;
                                            if ((item.Sector.Substring(0, 3).Contains("JED") || item.Sector.Substring(0, 3).Contains("MED")) && !item.Sector.Contains("JED-MED"))
                                            {
                                                break;
                                            }
                                        }
                                    }
                                    var count = Model.FlightSectors.Count;
                                    <td>@ab </td>
                                    break;
                                }
                                else if (Model.Accommodations.Count == 3 && counter == 4 && i == 2 && (s.Route.ToString().Contains("Makkah Train Station") ||
                                s.Route.ToString().Contains("Makkah  to Medinah") || s.Route.ToString().Contains("Makkah to Medinah") || s.Route.ToString().Contains("Station  to Medinah Hotel") ||
                                s.Route.ToString().Contains("Station to Medinah Hotel")))
                                {
                                    <td>@Model.Accommodations[i].CheckIn</td>
                                    break;
                                }
                                else if (Model.Accommodations.Count == 3 && counter == 5 && i == 2 && (s.Route.ToString().Contains("Makkah Train Station") ||
                                s.Route.ToString().Contains("Makkah  to Medinah") || s.Route.ToString().Contains("Makkah to Medinah") || s.Route.ToString().Contains("Station to Medinah Hotel") ||
                                s.Route.ToString().Contains("Station  to Medinah Hotel")))
                                {
                                    <td>@Model.Accommodations[i].CheckIn</td>
                                    break;
                                }
                                else if (counter == 4 && i == 3 && (s.Route.ToString().Contains("Makkah Train Station") ||
                                s.Route.ToString().Contains("Makkah  to Medinah") || s.Route.ToString().Contains("Makkah to Medinah") || s.Route.ToString().Contains("Station  to Medinah Hotel") ||
                                s.Route.ToString().Contains("Station to Medinah Hotel")))
                                {
                                    <td>@Model.Accommodations[i].CheckIn</td>
                                    break;
                                }

                                else if (counter == 5 && i == 3 && (s.Route.ToString().Contains("Makkah Train Station") ||
                                s.Route.ToString().Contains("Makkah  to Medinah") || s.Route.ToString().Contains("Makkah to Medinah") || s.Route.ToString().Contains("Station  to Medinah Hotel") ||
                                s.Route.ToString().Contains("Station to Medinah Hotel")))
                                {
                                    if (Model.Accommodations.Count == 5)
                                    {
                                        <td>@Model.Accommodations[i].CheckOut</td>
                                        break;
                                    }
                                    else
                                    {
                                        <td>@Model.Accommodations[i].CheckIn</td>
                                        break;
                                    }

                                }

                                else if (s.Route.ToString().Contains("to Medinah Airport") || s.Route.ToString().Contains("to Jeddah Airport"))
                                {
                                    int abc = 0;
                                    string ab = "";
                                    foreach (var item in Model.FlightSectors)
                                    {
                                        if (Convert.ToInt32(item.DepartureDate.Substring(0, 2)) > abc)
                                        {
                                            abc = Convert.ToInt32(item.DepartureDate.Substring(0, 2));
                                            ab = item.DepartureDate;
                                            if ((item.Sector.Substring(0, 3).Contains("JED") || item.Sector.Substring(0, 3).Contains("MED")) && !item.Sector.Contains("JED-MED"))
                                            {
                                                break;
                                            }
                                        }
                                    }
                                    var count = Model.FlightSectors.Count;
                                    <td>@ab </td>
                                    break;
                                }
                                else if (s.Route.Contains("Azizia to Mashair"))
                                {
                                    <td>14 Jun </td>
                                    break;
                                }

                                else if (counter == 4 && i == 2 && s.Route.ToString().Contains("Azizia Building to Makkah Hotel"))
                                {
                                    <td>@Model.Accommodations[i].CheckOut</td>
                                    break;
                                }

                                else if (counter == 5 && i == 2 && s.Route.ToString().Contains("Makkah Hotel to Mashair"))
                                {
                                    <td>@Model.Accommodations[i].CheckIn</td>
                                    break;
                                }
                                else if (counter == 5 && i == 3)
                                {
                                    <td>@Model.Accommodations[i].CheckIn</td>
                                    break;
                                }
                                else if (s.Route.ToString().Contains("Azizia to Makkah Hotel"))
                                {
                                    foreach (var item in Model.Accommodations)
                                    {
                                        if (item.HotelName == "Rafahya Hotel Azizia" || item.HotelName == "Azizia Building")
                                        {
                                            <td>@item.CheckOut</td>
                                        }

                                    }

                                    break;
                                }
                                else if (counter == 6 && i == 3)
                                {
                                    <td>@Model.Accommodations[i].CheckIn</td>
                                    break;
                                }
                                else if (counter == 7 && i == 3)
                                {
                                    <td>@Model.Accommodations[i].CheckOut</td>
                                    break;
                                }
                            }
                        }

                    </tr>
                }
            </tbody>
        </table>

        <div class="ADF_Container" style="margin-bottom: 20px; width: 100%;" id="Start_E_IADF_table">
            <div class="ADF_Details_Box">
                <table style="border: 1px solid black; width: 100%;">
                    <tr>
                        <th class="Description_align">DESCRIPTION</th>
                        <th class="Description_align">MEMBERS</th>
                    </tr>
                    @foreach (var e in Model.EIADFDetails)
                    {
                        <tr>
                            <td style="text-align: left;"> @e.Description</td>
                            <td style="text-align: left;"> @e.Ids</td>
                        </tr>
                    }
                </table>
            </div>
        </div>
        <!-- Third-custom Table END -->
        <div class="ADF_Container" style="margin-bottom: 25px; width: 100%;" id="Remarks_table">
            <div class="ADF_Details_Box">
                <table style="border: 1px solid black; width: 100%;">
                    <tr>
                        @* <th>SR</th> *@
                        <th class="Description_align">REMARKS</th>
                        <th class="Description_align">MEMBERS</th>
                    </tr>
                    @foreach (var e in Model.Remarks)
                    {
                        <tr>
                            @* <td>@e.Sr</td> *@
                            <td style="text-align: left;">@e.Remarks</td>
                            <td style="text-align: left;">@e.IndivdualId</td>
                        </tr>
                    }
                </table>
            </div>
        </div>

        <div class="zulhaj-date">
            <div class="box">
                <h5>08 ZH</h5>
                <img src="~/60X60 PIX.png" alt="">
            </div>

            <div class="box">
                <h5>08/09 ZH</h5>
                <img src="~/60X60 PIX.png" alt="">
            </div>
            <div class="box">
                <h5>09/10 ZH</h5>
                <img src="~/60X60 PIX.png" alt="">
            </div>
            <div class="box">
                <h5>10 ZH</h5>
                <img src="~/60X60 PIX.png" alt="">
            </div>
            <div class="box">
                <h5>11 ZH</h5>
                <img src="~/60X60 PIX.png" alt="">
