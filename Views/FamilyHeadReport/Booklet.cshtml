    <script>
        document.getElementById("downloadButton").addEventListener("click", function () {
            var familyHeadId = "@ViewBag.FamilyHeadId";

            console.log(familyHeadId);

            $.ajax({
                type: 'POST',
                url: '/FamilyHeadReport/DownloadBookletImages',
                data: {
                    id: familyHeadId,
                },
                xhrFields: {
                    responseType: 'blob' // Set the response type to 'blob' to handle binary data
                },
                success: function (data) {
                    // Create a Blob object from the binary data
                    var blob = new Blob([data], { type: 'application/zip' });
                    // Create a temporary URL for the Blob
                    var url = window.URL.createObjectURL(blob);
                    // Create a temporary <a> element to trigger the download
                    var link = document.createElement('a');
                    link.href = url;
                    link.download = 'images.zip'; // Specify the download filename
                    // Append the <a> element to the document and trigger the download
                    document.body.appendChild(link);
                    link.click();
                    // Clean up
                    document.body.removeChild(link);
                    window.URL.revokeObjectURL(url);
                },
                error: function (error) {
                    console.error(error);
                }
            });
        });
    </script>

   
</body>
</html>
