@using System.Text.RegularExpressions;
@{
    Layout = null;
}
@model CardModel

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
          integrity="sha512-SnH5WK+bZxgPHs44uWIX+LLJAJ9/2PkPKZ5QiAj6Ta86w+fsb2TkcmfRyVX3pBnMFcV7oQPJkl9QevSCWr3W6A=="
          crossorigin="anonymous" referrerpolicy="no-referrer" />
          <title>Government-Card</title>

    <style>
        * {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin: 0;
            padding: 0;
        }

        .top-heading {
            margin: 0 auto;
            text-align: center;
        }

        /* .top-hajj-title { */
        /*     /* background-color: #00904b; */ */
        /*     color: white; */
        /*     font-size: 12px; */
        /*     display: inline-block; */
        /*     padding: 5px; */
        /* } */

        .main-title {
            /* background-color: #00904b; */
            color: white;
            padding: 3px 10px;
            /* padding-top: 12px; */
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            font-weight: bolder;
        }

        .fourth-card {
            width: 3.4in;
            height: 2.1in;
            box-shadow: rgba(99, 99, 99, 0.2) 0px 2px 8px 0px;
            border-radius: 15px;
            overflow: hidden;
            position: relative;
            margin: 10px;
            background-image: url('/GovermentCard/GovermentCardFront.jpg');
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
        }


        .hajj-clinet-info-conatiner {
            width: 100%;
        }



        .govt_logo {
            width: 67px;
            height: 53px;
            position: absolute;
            left: 14px;
            top: 5px;
        }

            .govt_logo img {
                width: 100%;
                height: 100%;
            }

        .pak-flag-pic {
            width: 30px;
            height: 20px;
            position: absolute;
            right: 54px;
            top: 20px;
            ;
        }

            .pak-flag-pic img {
                width: 100%;
                height: 100%;
            }


        .islamic-jumeriya-pic {
            width: 135px;
            margin: 2px auto;
        }

            .islamic-jumeriya-pic img {
                width: 100%;
            }

        .islamic-republic-text {
            text-transform: uppercase;
            text-align: center;
        }



        .student-card .passport-image {
            width: 50px;
            height: 57px;
            float: left;
            margin-right: 10px;
            box-shadow: rgba(0, 0, 0, 0.05) 0px 6px 24px 0px, rgba(0, 0, 0, 0.08) 0px 0px 0px 1px;
            margin-top: 4px;
            margin-left: 15px;
           
        }

            .student-card .passport-image img {
                margin-left: 7px;
                margin-top: 42px;
                width: 129%;
                height: 150%;
            }

        .student-info {
            overflow: hidden;
            position: relative;
            top: -5px;
        }

            /*  */
            .student-info p {
                /* text-transform: uppercase; */
                /* border-bottom: 0.5px solid #0202028a; */
                font-size: 6px;
                margin-top: 2px;
            }

        .cid-no {
            display: inline-block;
            font-size: 5px;
            font-weight: 500;
            position: relative;
            top: -5px;
        }

            .maktab-number-container{
            width: 42px;
            padding: 1px 3px;
            height: 35px;
            line-height: 8px;
            border-radius: 8px;
            text-align: center;
            color: white;
            background: #bc9635 !important;
            position: absolute;
            bottom: 2px;
            left: 16px;
        
        }

        .maktab-text {
            letter-spacing: 1px;
            text-transform: uppercase;
        }

        .no-text {
            font-size: 43px;
        }

        .left-side-text {
            float: left;
        }

        .right-side-text {
            float: right;
        }




        /* BACK-CARD-STYLING ################## */
        .back-side-design {
            width: 3.4in;
            height: 2.1in;
            box-shadow: rgba(99, 99, 99, 0.2) 0px 2px 8px 0px;
            border-radius: 15px;
            overflow: hidden;
            position: relative;
            margin: 10px;
        }


            .back-side-design img {
                width: 100%;
            }

        .front-card-left-side {
            float: left;
        }

        .backcard-right-side {  
            float: left;
        }

        .zone {
            position: relative;
            top: 0px;
        }

        .mina {
            position: relative;
            top: 1px;
        }
       
    </style>

</head>
    <body>
   
    @foreach (var m in Model.Members)
    {
        <section class="fourth-card" style="position: relative;">
            <!-- Background Image as actual <img> -->
            <img src="~/GovermentCard/GovermentCardFront.jpg"
                 style="width: 100%; height: 100%; position: absolute; top: 0; left: 0; z-index: 0;"
                 alt="Front Card Background" />

            <!-- All content on top of the background -->
            <div style="position: relative; z-index: 1;">
                <div class="bg-pink-color">
                    <div class="top-heading"></div>

                    <div class="pak-flag-pic">
                        @* <img src="~/Images/Cards/pak-flag.png" alt="pak-flag"> *@
                    </div>

                    <div class="islamic-jumeriya-pic">
                        <img src="~/Images/Cards/urdu-img.png" alt="">
                    </div>
                </div>

                <div class="main-title">
                    <div class="left-side-text">
                        <span style="font-size: 6px;">@Model.MunazimNo</span>
                    </div>
                    <div style="clear: both;"></div>
                </div>

                <div class="hajj-clinet-info-conatiner">
                    <div class="student-card">
                        <div class="passport-image">
                            <img src="~/@m.HajiImg" alt="" class="men-image">
                        </div>

                        <div class="student-info">
                            <!-- App No & Passport No -->
                            <p style="margin-bottom: 5px;font-size: 5px;margin-top: 48px;margin-left: 50px;font-weight: bolder;">
                                @m.HajjAppNo
                                <strong style="margin-left: 40%; display: inline-block; font-weight: normal;"></strong> @m.Passport
                            </p>

                            <!-- Full Name -->
                            <p style="margin-left: 48px; font-size: 5px; text-transform: uppercase;">
                                <strong>@m.HajiName @m.HajiSurName</strong>
                            </p>

                            <!-- Father Name -->
                            <p style="margin-left: 60px; margin-top: 5px; font-size: 5px;">
                                <strong>@m.FatherName</strong>
                            </p>

                            <!-- DOB & Phone -->
                            <div style="margin-left: 60px; margin-top: 6px; font-size: 5px;">
                                <p style="margin: 0;">
                                    <strong class="dob">@m.DOB</strong>
                                    <span class="phoneno" style="margin-left: 42px;">
                                        <strong>@m.PhoneNo</strong>
                                    </span>
                                </p>
                            </div>

                            <!-- Arrival Flight -->
                            <div style="margin-left: 60px; margin-top: 5px; font-size: 5px;">
                                <p style="margin: 0;">
                                    <span class="Flight-no" style="margin-left: 42px;">
                                        <strong>@m.ArrFlightNo / @m.ArrDate?.ToString("dd/MMM/yyyy")</strong>
                                    </span>
                                </p>
                            </div>

                            <!-- Return Flight -->
                            <div style="margin-left: 60px; margin-top: 5px; font-size: 5px;">
                                <p style="margin: 0;">
                                    <span class="Flight-no" style="margin-left: 42px;">
                                        <strong>@m.DepFlightNo / @m.DepDate?.ToString("dd/MMM/yyyy")</strong>
                                    </span>
                                </p>
                            </div>

                            <!-- Maktab & Zone -->
                            <div style="margin-left: 60px; margin-top: 3px; font-size: 5px;">
                                <p style="margin: 0;">
                                    <strong class="mina">@m.MaktabNumber</strong>
                                    <span class="zone" style="margin-left: 96px;">
                                        <strong>@m.ZoneNo</strong>
                                    </span>
                                </p>
                            </div>

                            <!-- Accommodations -->
                            <div class="accommodation-section" style="margin-top: 2px; margin-left: 93px; font-size: 3px;">
                                <p><strong>@m.AziziaAccomodation</strong></p>
                            </div>

                            <div class="accommodation-section" style="margin-top: 4px; margin-left: 67px; font-size: 3px;">
                                <p>
                                    <strong>@m.MedinahAccomodation</strong>
                                    <span style="font-weight: 500;margin-left: 45px;font-size: 6px;">@m.MoraNo</span>
                                </p>
                            </div>

                            <div class="accommodation-section" style="margin-top: 2px; margin-left: 102px; font-size: 3px;">
                                <p><strong>@m.Munazzim</strong></p>
                            </div>

                            <div class="accommodation-section" style="margin-top: 2px; margin-left: 102px; font-size: 3px;">
                                <p><strong>@m.MunazzimNo</strong></p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>


        <!-- Back side of card -->
        <div class="backcard-right-side">
            <div class="back-side-design">
                <img src="~/GovermentCard/GovermentCardBack.jpg" alt="">
            </div>
        </div>

        <div style="page-break-after: always;"></div>



    }
    </body>

</html>
