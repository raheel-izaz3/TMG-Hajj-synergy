@{
    Layout = null;
}
@model ItineraryRouteVehiclesModel
<!DOCTYPE html>
<html>

<head>
    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <!-- DataTables CSS -->
    <link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/1.11.5/css/jquery.dataTables.min.css">

    <!-- DataTables JavaScript -->
    <script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>

    <!-- DataTables Buttons CSS -->
    <link rel="stylesheet" type="text/css"
          href="https://cdn.datatables.net/buttons/2.4.2/css/buttons.dataTables.min.css">

    <!-- DataTables Buttons JavaScript -->
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js"></script>

    <!-- Additional DataTables Extensions (optional) -->
    <link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/select/1.3.4/css/select.dataTables.min.css">
    <script src="https://cdn.datatables.net/select/1.3.4/js/dataTables.select.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.1.3/jszip.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.32/pdfmake.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js"></script>

    <!-- Bootstrap CSS (optional) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.0.0/dist/css/bootstrap.min.css"
          integrity="sha384-Gn5384xqQ1aoWXA+058RXPxPg6fy4IWvTNh0E263XmFcJlSAwiGgFAW/dAiS6JXm" crossorigin="anonymous">

    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.17.3/xlsx.full.min.js"></script>


    <style>
        body {
            font-size: 10px !important;
        }

        .table {
            border: solid 1px black !important;
            font-size: 8.5px !important;
        }

        thead {
            border: solid 1px black !important;
        }

        .chk-buttons {
            display: flex;
        }

        @@media print {
            body {
                overflow-x: hidden !important;
            }

            table {
                overflow-x: hidden !important;
            }

            .chk-buttons {
                display: none !important;
            }

            button {
                display: none !important;
            }

            label {
                display: none;
            }
        }
    </style>
</head>

<body>
    <div class="container-xxl flex-grow-1 container-p-y">
        <h4 class="fw-bold"><span class="text-muted fw-light"></span></h4>

        <hr class="mb-4" />
        <br><br>
        <form action="" method="post">
            <input type="hidden" asp-for="FamilyHeadId">
            <button class="btn btn-success">Show Itinerary</button>
            <br><br>
            <div class="card p-2">
                <div class="table-responsive text-nowrap ">
                    <table class="table table-hover table-bordered" id="reportTable" border="1">
                        <thead>
                            <tr>
                                <th>Route</th>
                                <th>Vehicle</th>
                                <th>Type</th>
                                <th>Quantity</th>
                            </tr>
                        </thead>
                        <tbody class="table-border-bottom-1" style="border: solid 1px black !important;">
                            @{
                                int i = 0;
                            }
                            @foreach (var m in Model.Rows)
                            {
                                <tr>
                                    <input type="hidden" name="RouteIds[]" value="@m.RouteId">
                                    <input type="hidden" name="TravelRouteIds[]" value="@m.TravelRouteId">
                                    <td>@m.Route</td>
                                    @if (m.RouteId.ToString() == "34")
                                    {
                                        <td>
                                            <select name="VehicleIds[]" class="form-control" id="">
                                                @foreach (var v in ViewBag.Vehicles)
                                                {
                                                    <option value="@v.VehicleId" selected="@((v.VehicleId == 7) ? "selected" : null)">@v.VehicleType</option>
                                                }
                                            </select>
                                        </td>
                                        <td>
                                            @* asp-items="@Html.GetEnumSelectList<VehicleType>
                                    ()" *@
                                            <select name="VehicleTypes[]" class="form-control" id="">
                                                <option value="0">GroupSharing</option>
                                                <option value="1">Group</option>
                                                <option value="2">Private</option>
                                                <option value="3" selected>Economy</option>
                                            </select>
                                        </td>
                                        <td>
                                            <input name="Quantities[]" class="form-control" id="" value="@(m.Quantity != 0 ? m.Quantity : 1)">
                                        </td>
                                    }
                                    else
                                    {
                                        <td>
                                            <select name="VehicleIds[]" class="form-control" id="">
                                                @if (ViewBag.itineraryVehicles.Count == 0)
                                                {
                                                    @foreach (var v in ViewBag.Vehicles)
                                                    {
                                                        <option value="@v.VehicleId">@v.VehicleType</option>
                                                    }
                                                }
                                                else
                                                {
                                                    @if (ViewBag.itineraryVehicles.Count == Model.Rows.Count)
                                                    {
                                                        @foreach (var v in ViewBag.Vehicles)
                                                        {
                                                            if (ViewBag.itineraryVehicles[i]?.VehicleId == v.VehicleId)
                                                            {
                                                                <option selected value="@v.VehicleId">@v.VehicleType</option>

                                                            }
                                                            else
                                                            {
                                                                <option value="@v.VehicleId">@v.VehicleType</option>

                                                            }
                                                        }
                                                    }
                                                    else
                                                    {
                                                        @foreach (var v in ViewBag.Vehicles)
                                                        {
                                                            <option value="@v.VehicleId">@v.VehicleType</option>
                                                        }
                                                    }
                                                }

                                            </select>
                                        </td>
                                        <td>
                                            <select name="VehicleTypes[]" class="form-control" id="">
                                                @if (ViewBag.itineraryVehicles.Count == 0)
                                                {
                                                    @foreach (var v in Html.GetEnumSelectList<VehicleType>())
                                                    {
                                                        <option value="@v.Value">@v.Text</option>
                                                    }
                                                }
                                                else
                                                {
                                                    @if (ViewBag.itineraryVehicles.Count == Model.Rows.Count)
                                                    {
                                                        @foreach (var v in Html.GetEnumSelectList<VehicleType>())
                                                        {
                                                            if (ViewBag.itineraryVehicles[i]?.VehicleType.ToString() == v.Text) // check value to compare
                                                            {
                                                                <option selected value="@v.Value">@v.Text</option>
                                                            }
                                                            else
                                                            {
                                                                <option value="@v.Value">@v.Text</option>

                                                            }
                                                        }
                                                    }
                                                    else
                                                    {
                                                        @foreach (var v in Html.GetEnumSelectList<VehicleType>())
                                                        {
                                                            <option value="@v.Value">@v.Text</option>
                                                        }
                                                    }
                                                }
                                            </select>
                                        </td>
                                        <td>
                                            @* <input name="Quantities[]" class="form-control" id="" value="@m.Quantity"> *@
                                            <input name="Quantities[]" class="form-control" id="" value="@(m.Quantity != 0 ? m.Quantity : 1)">
                                        </td>
                                    }
                                </tr>
                                i++;
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </form>
    </div>

    <script>
        var table = $('#reportTable').DataTable({
            dom: 'Bfrtip',
            fixedHeader: true,
            paging: false,
            info: false,
            ordering: false
        });
    </script>
</body>

</html>
