@model MedicalAffidavitModel

@{
    Layout = "";
}
<!DOCTYPE html
    PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml" xml:lang="en" lang="en">

<head>

    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.0.1/css/bootstrap.min.css"
        integrity="sha512-Ez0cGzNzHR1tYAv56860NLspgUGuQw16GiOOp/I2LuTmpSK9xDXlgJz3XN4cnpXWDmkNBKXR/VDMTCnAaEooxA=="
        crossorigin="anonymous" referrerpolicy="no-referrer" />

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.0/jquery.min.js"
        integrity="sha512-3gJwYpMe3QewGELv8k/BX9vcqhryRdzRMxVfq6ngyWXwo03GFEzjsUm8Q7RZcHPHksttq7/GFoxjCVUjkjvPdw=="
        crossorigin="anonymous" referrerpolicy="no-referrer"></script>

    <title>Ticket Boarding Stamp</title>
    <style>
        .toper-header-pic {
            /* object-fit: cover; */
            width: 100%;
            height: 900px;

        }

        .toper-header-pic img {
            width: 100%;

        }

        .corona-vaccine table {
            margin: 0;
            padding: 0;
        }

        .corona-vaccine td {
            /* margin: 2px; */
            padding: 2px;
        }

        /* .wrapper ol li {
            line-height: 16px;
        } */

        .bolder-font {

            font-weight: 700;
            color: rgba(0, 0, 0, 0.788);

        }



        @@media print {
            .hideInPrint {
                display: none;
            }
        }

        .page-break {
            page-break-after: always;
        }

        body {
            margin: 0 !important;
            padding: 0 !important;
            box-sizing: border-box !important;
            overflow-x: hidden !important;
        }

        .user-img img,
        .img-stamp {
            height: 100%;
            width: 100%;
            object-fit: contain;
            /* border: 1px solid black; */

        }

        .user-img {
            height: 140px;
            width: 140px;
        }

        .user-img img {
            width: 100% !important;
        }

        .doc-approval table {
            height: 100px;
            text-transform: capitalize;
            text-align: center;
        }

        .doc-approval table td:not(td[class='seal-sig-doc']) {
            vertical-align: middle;
        }

        .urdu {
            src: url('https://www.fontsaddict.com/fontface/jameel-noori-nastaleeq.ttf');
            font-family: 'Jameel Noori Nastaleeq';
        }

        .half-nama-bold {
            font-family: Jameel Noori;
            font-weight: bolder;
        }


        @@media print {
            .hide-in-print {
                display: none;
            }

            .img-stamp {
                object-fit: contain;
            }

            title {
                display: none
            }

            @@page {
                margin: 0;
                margin-top: 20px;
                margin-inline: 30px;

            }


            .seal-sig-doc p {
                text-wrap: nowrap;
                font-size: 6pt !important;
                font-weight: 100 !important;
            }

            .seal-sig-doc {
                overflow-y: hidden !important;
            }

            .stamp-img {
                border-top: .5px solid !important;
            }
        }

        .mr-2 {
            margin-right: 1%;
        }

        * {
            font-size: 8pt;
            line-height: 12px;
        }

        .fillable {
            font-family: monospace;
            text-transform: uppercase;
        }

        table td {
            border: 0.5px solid black !important;
        }

        .seal-sig-doc {
            vertical-align: bottom !important;
            margin: 0 !important;
            padding: 0 !important;
        }

        .seal-sig-doc p {
            text-wrap: nowrap;
            font-size: xx-small;
            font-weight: 100 !important;
        }

        .halaf-nama {
            direction: rtl !important;

        }

        .halaf-nama li {
            line-height: 22px;
        }



        .page-break {
            page-break-after: always;
            /* or 'auto' or 'avoid' */
        }
    </style>

    </script>
</head>

<body>

    <div class="row hide-in-print p-3">
        @{
            int i = 0;
        }
        @foreach (BoardingStamp stamp in ViewBag.BoardingStamps)
        {
            <div>
                <input type="radio" name="stamps" id="stamp_@i" value="@stamp.BoardingStampId" onchange="showStamp(@i)" />
                <label for="stamp_@i">Stamp @(i + 1)</label>
            </div>

            i++;
        }
    </div>
    <div class="row hide-in-print p-3">
        @{
            int j = 0;
        }
        @foreach (BoardingStamp stamp in ViewBag.BoardingStamps)
        {
            <img src="~/@stamp.FilePath" style="width: 200px; display:none;" name="imgs" id="img_@j" />

            j++;
        }
    </div>

    <script>
        function showStamp(index) {
            for (let i of document.getElementsByName('imgs')) {
                i.style.display = 'none'
            }
            document.getElementById("img_" + index).style.display = 'block'
        }
    </script>

    <iframe src="~/@ViewBag.Ticket" width="800px" height="500px" frameborder="1"></iframe>
    <br><br>

    <button class="btn btn-lg btn-success" onclick="mark()">Stamp</button>


    <script>
        function mark() {
            let familyHeadId = @ViewBag.FamilyHeadId;

            var radios = document.getElementsByName('stamps');
            let stampId = null;
            for (var i = 0; i < radios.length; i++) {
                if (radios[i].checked) {
                    stampId = radios[i].value;
                    break;
                }
            }

            $.ajax({
                url: "/FamilyHeadReport/MarkBoardingStamp",
                method: "",
                data: {
                    familyHeadId: familyHeadId,
                    stampId: stampId
                },
                success: res => {
                    console.log(res)
                }
            })
        }
    </script>

</body>

</html>