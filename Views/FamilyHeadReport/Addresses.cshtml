@model AddressReportModel
@{
    Layout = "";
}


<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Report</title>
    <style>
        @@media print {

            label,
            input,
            .button {
                display: none;
            }

            body {
                font-family: Arial, sans-serif;
                font-size: 8px;
            }
        }

        body {
            font-family: Arial, sans-serif;
            font-size: 10px;
        }

        .main {
            margin: -8px 20px;
            width: 900px;
            height: 100vh;
            float: left;
        }

        .main-1 {
            width: 425px;
            float: left;
        }

        .main-2 {
            width: 400px;
            float: right;
            margin-right: -350px;
        }

        .mysticker {
            width: 285px;
            margin-top: 15px;
            margin-left: -70px;
        }

        .mysticker2 {
            width: 284px;
            margin-left: -70px;
        }

        .mysticker2 table {
            margin-left: -2px;
            width: 100%;

        }

        .mysticker2 table td {
            width: 50%;
            margin-right: 10px;
        }


        .sticker {
            padding: 2px;
            width: 120%;
        }

        .sticker p {
            margin: 5px 0;
        }

        .accommodation-detail {
            padding: 2px;
            width: 97%;
        }

        .accommodation-detail p {
            margin: 5px 0;
        }

        .toggle-label {
            cursor: pointer;
        }

        .hide {
            display: none;
        }
    </style>
</head>

<body>

    <label for="toggleOFFICE" class="toggle-label"> For Office</label>
    <input type="checkbox" id="toggleOFFICE" class="toggle-checkbox" checked>

    <label for="toggleCid" class="toggle-label"> CID</label>
    <input type="checkbox" id="toggleCid" class="toggle-checkbox" checked>

    <label for="toggleCnic" class="toggle-label"> CNIC</label>
    <input type="checkbox" id="toggleCnic" class="toggle-checkbox" checked>

    <label for="togglePassport" class="toggle-label"> PASSPORT</label>
    <input type="checkbox" id="togglePassport" class="toggle-checkbox" checked>

    <label for="togglePackage" class="toggle-label"> PACKAGE</label>
    <input type="checkbox" id="togglePackage" class="toggle-checkbox" checked>

    <label for="toggleCategory" class="toggle-label">CATEGORY</label>
    <input type="checkbox" id="toggleCategory" class="toggle-checkbox" checked>

    <label for="toggleName" class="toggle-label"> Name</label>
    <input type="checkbox" id="toggleName" class="toggle-checkbox" checked>

    <label for="toggleAdd" class="toggle-label"> ADD</label>
    <input type="checkbox" id="toggleAdd" class="toggle-checkbox" checked>

    <label for="toggleMob" class="toggle-label"> MOBILE</label>
    <input type="checkbox" id="toggleMob" class="toggle-checkbox" checked>

    <label for="toggleEmail" class="toggle-label"> EMAIL</label>
    <input type="checkbox" id="toggleEmail" class="toggle-checkbox" checked>

    <label for="toggleAccommodation" class="toggle-label">ACCOMMODATION DETAIL</label>
    <input type="checkbox" id="toggleAccommodation" class="toggle-checkbox" checked>

    <label for="toggleMedinah" class="toggle-label">MEDINAH</label>
    <input type="checkbox" id="toggleMedinah" class="toggle-checkbox" checked>

    <label for="toggleMakkah" class="toggle-label"> MAKKAH</label>
    <input type="checkbox" id="toggleMakkah" class="toggle-checkbox" checked>


    <label for="toggleAzizia" class="toggle-label"> AZIZIA</label>
    <input type="checkbox" id="toggleAzizia" class="toggle-checkbox" checked>

    <label for="toggleMina" class="toggle-label"> MINA/ ARAFA</label>
    <input type="checkbox" id="toggleMina" class="toggle-checkbox" checked>

    <label for="toggleOne" class="toggle-label"> 1</label>
    <input type="checkbox" id="toggleOne" class="toggle-checkbox" checked>


    <label for="toggleTwo" class="toggle-label"> 2</label>
    <input type="checkbox" id="toggleTwo" class="toggle-checkbox" checked>


    <label for="toggleusd" class="toggle-label"> USD</label>
    <input type="checkbox" id="toggleusd" class="toggle-checkbox" checked>


    <label for="toggletotal-amount" class="toggle-label"> TOTAL AMOUNT</label>
    <input type="checkbox" id="toggletotal-amount" class="toggle-checkbox" checked>

    <label for="togglediscount" class="toggle-label"> DISCOUNT</label>
    <input type="checkbox" id="togglediscount" class="toggle-checkbox" checked>

    <label for="togglenet-receivable" class="toggle-label"> NET RECEIVABLE</label>
    <input type="checkbox" id="togglenet-receivable" class="toggle-checkbox" checked>

    <label for="toggleamount-receive" class="toggle-label"> AMOUNT RECEIVED</label>
    <input type="checkbox" id="toggleamount-receive" class="toggle-checkbox" checked>

    <label for="togglebalance-receive" class="toggle-label"> BALANCE RECEIVABLE</label>
    <input type="checkbox" id="togglebalance-receive" class="toggle-checkbox" checked>


    <div style="margin: 20px;" class="button">
        <button id="increaseFontSizeBtn"> Font Increase (+)</button>
        <button id="decreaseFontSizeBtn"> Font Decrease(-)</button>
        <br>
        <br>
        <button onclick="increaseFontSize()">Name (+)</button>
        <button onclick="decreaseFontSize()">Name (-)</button>
    </div>


    <div id="main-before" class="main">
        <div class="main-1">
            <div class="sticker">
                <div class="toggle-section office">
                    <p><span style="text-decoration: underline; font-weight: bold;">FOR OFFICE USE ONLY</span> <span
                            style="float: right;">HAJJ APP SERIAL: <span>@Model.HajjAppSerial</span></span></p>
                </div>
                <div class="toggle-section cid">
                    <p> CID: <span>@Model.HeadCID</span> <span style="float: right; text-align: left;">HAJJ APP NO:
                            <span>@Model.HajjAppNo</span></span> </p>
                </div>
                <div class="toggle-section cnic">
                    <p> CNIC# <span style="margin-right: 75px;">@Model.HeadCNIC</span> <span
                            style=" float: right; text-align: left;">MEGA REF:
                            <span>@Model.MegaReference</span></span></p>
                </div>
                <div class="toggle-section passport">
                    <p> PASSPORT# <span style="margin-right: 80px;">@Model.HeadPassport</span> <span
                            style=" float: right; text-align: left;">@Model.Group<span></span></span>
                    </p>
                </div>
                <div class="toggle-section package">
                    <p> PACKAGE: <span style="margin-right: 80px;">@Model.Package</span> <span
                            style="float: right; text-align: left;">PAX: <span>@Model.PAX</span></span></p>
                </div>
                <div class="toggle-section category">
                    <p> CATEGORY: <span>@Model.HeadCategory</span> </p>
                </div>
            </div>

            <div class="sticker">
                <div class="toggle-section name">
                    <p class="nameSpan" style="font-weight: bold; margin-right: 78px;">@Model.HeadName</p>
                </div>
                <div class="toggle-section add">
                    <p>ADD: <span>@Model.HeadAddress</span></p>
                </div>
                <div class="toggle-section mob">
                    <p> MOBILE#: <span>@Model.HeadContact</span></p>
                </div>
                <div class="toggle-section email">
                    <p> EMAIL: <span>@Model.HeadEmail</span> </p>
                </div>
            </div>

            <div class="accommodation-detail">
                <div class="toggle-section accommodation">
                    <p style="font-weight: bold; margin-right: 78px;">ACCOMMODATION DETAIL:</p>
                </div>
                <div class="toggle-section medinah">
                    <p> <strong>MEDINAH:</strong> @Model.MedinahAccommodation</p>
                </div>
                <div class="toggle-section makkah">
                    <p> <strong>MAKKAH:</strong> @Model.MakkahAccommodation</p>
                </div>
                <div class="toggle-section azizia">
                    <p> <strong>AZIZIA:</strong> @Model.AziziahAccommodation</p>
                </div>
                <div class="toggle-section mina">
                    <p> <strong>MINA / ARAFAT:</strong> @Model.MinaAccommodation</p>
                </div>
            </div>
        </div>

        <div class="main-2">
            <div class="mysticker">
                @foreach (string m in Model.Members)
                {
                    <div class="toggle-section one">
                        <p style="font-weight: bold; margin-top: -8px;">@m</p>
                    </div>

                }
            </div>

            <div class="mysticker2">
                <table>
                    <tr class="toggle-section usd">
                        <td></td>
                        <td style="text-align:right; padding-left: 80px;">USD</td>
                    </tr>
                    <tr class="toggle-section total-amount">
                        <td>TOTAL AMOUNT:</td>
                        <td style="text-align:right; padding-left: 70px;">@Model.TotalAmount</td>
                    </tr>
                    <tr class="toggle-section discount">
                        <td>DISCOUNT:</td>
                        <td style="text-align:right; padding-left: 75px;">@Model.Discount</td>
                    </tr>
                    <tr class="toggle-section net-receivable">
                        <td>NET RECEIVABLE:</td>
                        <td style="text-align:right; padding-left: 70px;">@Model.NetReceivable</td>
                    </tr>
                    <tr class="toggle-section amount-receive">
                        <td>AMOUNT RECEIVED:</td>
                        <td style="text-align:right; padding-left: 70px;">@Model.AmountReceived</td>
                    </tr>
                    <tr class="toggle-section balance-receive">
                        <td>BALANCE RECEIVABLE:</td>
                        <td style="text-align:right; padding-left: 75px;">@Model.BalanceReceivable</td>
                    </tr>
                </table>
            </div>

        </div>
    </div>


    <script>
        document.querySelectorAll('.toggle-checkbox').forEach(function (checkbox) {
            checkbox.addEventListener('change', function () {
                var sectionClass = this.id.replace('toggle', '').toLowerCase();
                var toggleSections = document.querySelectorAll('.toggle-section.' + sectionClass);
                toggleSections.forEach(function (section) {
                    if (checkbox.checked) {
                        section.classList.remove('hide');

                    } else {
                        section.classList.add('hide');
                    }
                });
            });
        });

        document.getElementById('increaseFontSizeBtn').addEventListener('click', function () {
            var stickerContent = document.querySelectorAll('p,td');
            stickerContent.forEach(function (element) {
                var currentFontSize = parseFloat(window.getComputedStyle(element).fontSize);
                element.style.fontSize = (currentFontSize + 1) + 'px';
            });
        });

        document.getElementById('decreaseFontSizeBtn').addEventListener('click', function () {
            var stickerContent = document.querySelectorAll('p,td');
            stickerContent.forEach(function (element) {
                var currentFontSize = parseFloat(window.getComputedStyle(element).fontSize);
                element.style.fontSize = (currentFontSize - 1) + 'px';
            });
        });

        function increaseFontSize() {
            var spanElements = document.querySelectorAll('.nameSpan');
            spanElements.forEach(function (spanElement) {
                var currentSize = parseFloat(window.getComputedStyle(spanElement, null).getPropertyValue('font-size'));
                var increaseFactor = 1; // You can adjust the increase factor as per your requirement
                spanElement.style.fontSize = (currentSize + increaseFactor) + 'px';
            });
        }

        function decreaseFontSize() {
            var spanElements = document.querySelectorAll('.nameSpan');
            spanElements.forEach(function (spanElement) {
                var currentSize = parseFloat(window.getComputedStyle(spanElement, null).getPropertyValue('font-size'));
                var decreaseFactor = 1; // You can adjust the decrease factor as per your requirement
                spanElement.style.fontSize = (currentSize - decreaseFactor) + 'px';
            });
        }
    </script>


</body>

</html>