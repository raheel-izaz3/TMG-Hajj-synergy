@model CardMemberModel

@{
	Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<title>Qurbani Slip</title>
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<style>
		body {
			margin: 0;
			padding: 20px;
			font-family: Arial, sans-serif;
			background: #fff;
		}

		.challan:not(:last-child)::after {
			content: "";
			position: absolute;
			top: 0;
			right: -10px;
			width: 0;
			height: 120%;
			border-right: 1px dashed #000;
		}

		.challan-container {
			display: flex;
			justify-content: space-between;
			gap: 10px;
			flex-wrap: nowrap;
			width: 100%;
		}

		.challan {
			width: 27%;
			border: 1px solid #000;
			padding: 10px;
			box-sizing: border-box;
			position: relative;
		}

		.stamp {
			height: 70px;
			display: flex;
			justify-content: center;
			align-items: center;
		}

		h2, p {
			margin: 4px 0;
		}

		.header-content {
			display: flex;
			align-items: center;
			justify-content: space-between;
			margin-bottom: 10px;
		}

			.header-content .title {
				flex-grow: 1;
				font-weight: bold;
				font-size: 16px;
				text-align: center;
			}

		.logo {
			width: 81px;
			height: auto;
		}

		.section {
			margin-bottom: 8px;
			font-size: 13px;
		}

		.issue-date {
			text-align: left;
			font-weight: bold;
		}

		.package-name {
			text-align: center;
			font-weight: bold;
			margin-top: 4px;
			font-style: oblique;
			color: red;
			font-stretch: expanded;
		}

		.hajji-name {
			text-align: left;
		}

		.fee-table {
			width: 100%;
			border-collapse: collapse;
			font-size: 13px;
		}

			.fee-table th, .fee-table td {
				border: 1px solid #000;
				padding: 4px;
				text-align: left;
			}

		.footer {
			margin-top: 10px;
			font-size: 12px;
		}

		.barcode {
			height: 30px;
			background: #ccc;
			margin: 8px 0;
		}

		.due-box {
			height: auto;
			margin-top: 10px;
			padding: 6px;
			border: 1px solid #000;
			font-size: 12px;
			line-height: 1.6;
		}

			.due-box h3 {
				text-align: center;
				text-decoration: underline;
				margin-bottom: 8px;
			}

			.due-box p {
				text-align: justify;
				margin: 4px 0;
			}

		.no-print button {
			padding: 8px 16px;
			background-color: #f60000;
			color: white;
			border: none;
			border-radius: 4px;
			cursor: pointer;
			margin-bottom: 10px;
		}

		@@media print {
			body{
			margin: 0;
			padding: 0;
		}

		.no-print {
			display: none;
		}

		.challan-container {
			flex-wrap: nowrap;
			justify-content: space-between;
			gap: 10px;
			page-break-inside: avoid;
		}

		.challan {
			width: 32%;
			margin: 0;
			padding: 8px;
		}

		.stamp {
			display: flex !important;
			justify-content: flex-end !important;
			align-items: flex-end !important;
		}

		}
	</style>
</head>
<body>
	<div class="no-print">
		<button onclick="window.print()">Print</button>
		<hr />
	</div>

	<div class="challan-container">
		<!-- First slip -->
		<div class="challan">
			<div class="challan_header">
				<div class="header-content">
					<img src="~/TMG Group.png" alt="Left Logo" class="logo" />
					<div class="title">TMG<br /><small>Qurbani Slip</small></div>
					<img src="~/Group Logo.png" alt="Right Logo" class="logo" />
				</div>
			</div>

			<hr />

			<div class="section">
				<p class="issue-date">Issue Date: @DateTime.Now.ToString("dd/MMM/yyyy")</p>
				<p class="package-name">@Model.PackageName</p>
				<p class="hajji-name"><strong>Hajji Name:</strong> @Model.HajiName (@Model.HbNo)</p>
				<div class="barcode"></div>
			</div>

			<div class="due-box">
				@* <p><strong>Hajj Accessories:</strong> Gift</p> *@
				<div class="Gift_Terms_and_Conditions" style="font-size: 10px;">
					<h3>Terms and Conditions</h3>
					<p><strong>1. Dummy:</strong> is simply dummy text of the printing and typesetting industry. Lorem Ipsum has.</p>
					<p><strong>2. Dummy:</strong> been the industry's standard been the industry's standard.</p>
					<p><strong>3. Dummy:</strong> been the industry's standard.been the industry's standard been the industry's standard.</p>
					<div style="display: flex; justify-content: center; align-items: center; margin-top: 30px;">
						<div class="stamp">
							<img src="~/hajj mabroor By TMG 1.png" alt="Company Stamp" style="margin-left: 219px;max-height: 60px;" />
						</div>
					</div>
				</div>
			</div>
		</div>

		<!-- Second slip -->
		<div class="challan">
			<div class="challan_header">
				<div class="header-content">
					<img src="~/TMG Group.png" alt="Left Logo" class="logo" />
					<div class="title">TMG<br /><small>Qurbani Slip</small></div>
					<img src="~/Group Logo.png" alt="Right Logo" class="logo" />
				</div>
			</div>

			<hr />

			<div class="section">
				<p class="issue-date">Issue Date: @DateTime.Now.ToString("dd/MMM/yyyy")</p>
				<p class="package-name">@Model.PackageName</p>
				<p class="hajji-name"><strong>Hajji Name:</strong> @Model.HajiName (@Model.HbNo)</p>
				<div class="barcode"></div>
			</div>

			<div class="due-box">
				@* <p><strong>Hajj Accessories:</strong> Gift</p> *@
				<div class="Gift_Terms_and_Conditions" style="font-size: 10px;">
					<h3>Terms and Conditions</h3>
					<p><strong>1. Dummy:</strong> is simply dummy text of the printing and typesetting industry. Lorem Ipsum has.</p>
					<p><strong>2. Dummy:</strong> been the industry's standard been the industry's standard.</p>
					<p><strong>3. Dummy:</strong> been the industry's standard.been the industry's standard been the industry's standard.</p>
					<div style="display: flex; justify-content: center; align-items: center; margin-top: 30px;">
						<div class="stamp">
							<img src="~/hajj mabroor By TMG 1.png" alt="Company Stamp" style="margin-left: 219px;max-height: 60px;" />
						</div>
					</div>
				</div>
			</div>
		</div>

		<!-- Empty third box to maintain layout -->
		<div class="challan" style="border: none; background: transparent;"></div>
	</div>

</body>
</html>
