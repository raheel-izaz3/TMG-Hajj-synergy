@model EHajjReportModel

@{
    Layout = "";
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>E-Hajj Report (For Office Use Only)</title>
    <style>
        @@media print {
            .check-box {
                display: none !important;
            }

        }

        * {
            margin: 0;
            padding: 0;
            font-size: 9px;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .check-box {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            padding: 10px;

        }

        .check-box label {
            font-size: 10px;
            margin: 5px;
        }

        h5 {
            color: #fff;
            padding: 5px;
            background-color: burlywood;
            width: 60px;
            font-size: 13px;
        }

        h4 {
            font-size: 20px;
        }

        caption {
            background-color: burlywood;
            color: #fff;
            font-size: 13px;
        }

        table {
            padding: 0;
            margin: 0;
            margin: 7px;
            width: 98%;
            border-collapse: collapse;
        }

        td {
            margin: 0;
            padding: 5px 3px;
            border: 1px solid black;
        }

        .main {
            margin: 30px;
            width: 65%;
        }

        .container {
            width: 150%;
            height: 600px;
            border: 1px solid red;
        }
        .cnic-infobox {
            display: flex;
            margin-left: 30px;
        }

        .cnic-pic {
            width: 500px;
            height: 240px;
        }

        .user-info {
            font-size: 8px;
            padding: 15px;
            width: 180px;
            margin-left: -20px;
        }

        .main-container {
            margin-left: -10px;
            display: flex;
        }

        .user-info1 {
            font-size: 8px;
            padding: 10px;
            width: 180px;
            margin-left: -70px;
            margin-top: 10px;
        }

        .hide {
            display: none;
        }
    </style>
</head>

<body>

    <div class="check-box">
        <label for="toggleFcid" class="toggle-label"> HB #</label>
        <input type="checkbox" id="toggleFcid" class="toggle-checkbox" checked>

        <label for="togglePackage" class="toggle-label"> PACKAGE</label>
        <input type="checkbox" id="togglePackage" class="toggle-checkbox" checked>

        <label for="toggleGroup" class="toggle-label"> GROUP NO</label>
        <input type="checkbox" id="toggleGroup" class="toggle-checkbox" checked>

        <label for="toggleCategory" class="toggle-label"> CATEGORY</label>
        <input type="checkbox" id="toggleCategory" class="toggle-checkbox" checked>

        <label for="toggleContact" class="toggle-label"> CONTACT</label>
        <input type="checkbox" id="toggleContact" class="toggle-checkbox" checked>

        <label for="toggleCnic" class="toggle-label">CNIC NO</label>
        <input type="checkbox" id="toggleCnic" class="toggle-checkbox" checked>

        <label for="toggleSpo" class="toggle-label"> SPO</label>
        <input type="checkbox" id="toggleSpo" class="toggle-checkbox" checked>

        <label for="toggleMega" class="toggle-label"> MEGA</label>
        <input type="checkbox" id="toggleMega" class="toggle-checkbox" checked>

        <label for="togglePax" class="toggle-label"> PAX</label>
        <input type="checkbox" id="togglePax" class="toggle-checkbox" checked>

        <label for="toggleOne" class="toggle-label"> 1</label>
        <input type="checkbox" id="toggleOne" class="toggle-checkbox" checked>

        <label for="toggleTwo" class="toggle-label">2</label>
        <input type="checkbox" id="toggleTwo" class="toggle-checkbox" checked>

        <label for="toggleMedcheckin" class="toggle-label"> MED CHECK IN </label>
        <input type="checkbox" id="toggleMedcheckin" class="toggle-checkbox" checked>

        <label for="toggleMakcheckout" class="toggle-label"> MED CHECK OUT</label>
        <input type="checkbox" id="toggleMakcheckout" class="toggle-checkbox" checked>

        <label for="togglePermitdate" class="toggle-label"> RAWDAH PERMIT DATE</label>
        <input type="checkbox" id="togglePermitdate" class="toggle-checkbox" checked>

        <label for="toggleMedcontractid" class="toggle-label"> MED CONTRACT ID &amp; CAPACITY</label>
        <input type="checkbox" id="toggleMedcontractid" class="toggle-checkbox" checked>

        <label for="toggleMedhotel" class="toggle-label"> MED HOTEL</label>
        <input type="checkbox" id="toggleMedhotel" class="toggle-checkbox" checked>

        <label for="toggleMakcontractid" class="toggle-label">MAK CONTRACT ID &amp; CAPACITY</label>
        <input type="checkbox" id="toggleMakcontractid" class="toggle-checkbox" checked>

        <label for="togglemakhotel" class="toggle-label"> MAK HOTEL</label>
        <input type="checkbox" id="togglemakhotel" class="toggle-checkbox" checked>

        <label for="toggleAziziacontractidcapacity" class="toggle-label"> AZIZIA CONTRACT ID &amp; CAPACITY</label>
        <input type="checkbox" id="toggleAziziacontractidcapacity" class="toggle-checkbox" checked>

        <label for="toggleAziziahotel" class="toggle-label"> AZIZIA HOTEL</label>
        <input type="checkbox" id="toggleAziziahotel" class="toggle-checkbox" checked>

        <label for="toggleKsaarrivaldate" class="toggle-label"> KSA ARRIVAL DATE</label>
        <input type="checkbox" id="toggleKsaarrivaldate" class="toggle-checkbox" checked>

        <label for="togglearrivaltime" class="toggle-label">ARRIVAL TIME</label>
        <input type="checkbox" id="togglearrivaltime" class="toggle-checkbox" checked>

        <label for="toggleKsadeparturedate" class="toggle-label"> KSA DEPARTURE DATE</label>
        <input type="checkbox" id="toggleKsadeparturedate" class="toggle-checkbox" checked>

        <label for="toggleDeparturetime" class="toggle-label">DEPARTURE TIME</label>
        <input type="checkbox" id="toggleDeparturetime" class="toggle-checkbox" checked>
    </div>

    <div class="main-container">
        <div class="main">
            <h4 style="width: 180px;">E-HAJJ REPORT</h4>
            <div class="container">
                
                @* ADD IMAGE HERE *@

                <img src="~/@Model.EhajjPath" class="container-image" style="max-width: 150%; max-height: 100%" alt="">
                </p>

            </div>
        </div>

        
    </div>

    <div class="cnic-infobox">
        <div class="cnic-pic">
            <figure>
                <img src="~/@Model.PassportImagePath" alt="" width="400px" height="300px">
            </figure>
        </div>
        <div style="display: flex">
            <div class="user-info1" style="margin-left: 0">
                <p class="toggle-section medcheckin" id="medCheckIn"><strong>MED CHECK IN:</strong> @Model.MedinaCheckIn</p>
                <p class="toggle-section makcheckout" id="medCheckOut"><strong>MED CHECK OUT:</strong> @Model.MedinaCheckIn</p>
                <p class="toggle-section permitdate" id="rawdahPermitDate"><strong>RAWDAH PERMIT DATE:</strong> @Model.RawdahPermitDate</p>
                <p class="toggle-section medcontractid" id="medContractIdCapacity"><strong>MED CONTRACT ID &amp;
                    CAPACITY:</strong> @Model.MedinaContractAndCapacity</p>
                <p class="toggle-section medhotel" id="medHotel"><strong>MED HOTEL:</strong> @Model.MedinaHotel</p>
                <p class="toggle-section makcontractid" id="makContractIdCapacity"><strong>MAK CONTRACT ID &amp;
                    CAPACITY:</strong>  @Model.MakkahContractAndCapacity </p>
            <p class="toggle-section makhotel" id="makHotel"><strong>MAK HOTEL:</strong> @Model.MakkahHotel</p>
            <p class="toggle-section aziziacontractidcapacity" id="aziziaContractIdCapacity"><strong>AZIZIA CONTRACT ID
                    &amp; CAPACITY:</strong> @Model.AziziaContractAndCapacity</p>
            <p class="toggle-section aziziahotel" id="aziziaHotel"><strong>AZIZIA HOTEL:</strong> @Model.AziziaHotel</p>
            <p class="toggle-section ksaarrivaldate" id="ksaArrivalDate"><strong>KSA ARRIVAL DATE:</strong> </p>
            <p class="toggle-section arrivaltime" id="arrivalTime"><strong>ARRIVAL TIME:</strong> </p>
            <p class="toggle-section ksadeparturedate" id="ksaDepartureDate"><strong>KSA DEPARTURE DATE:</strong></p>
            <p class="toggle-section departuretime" id="departureTime"><strong>DEPARTURE TIME:</strong> </p>
            </div>
            <div class="user-info">
                <p class="toggle-section fcid" id="fcid"><strong>HB #:</strong> @Model.HeadCID</p>
                <p class="toggle-section package" id="package"><strong>PACKAGE:</strong> @Model.Package</p>
                <p class="toggle-section group" id="group"><strong>GROUP NO: </strong> @Model.Group </p>
                <p class="toggle-section category" id="category"><strong>CATEGORY: </strong> @Model.Category</p>
                <p class="toggle-section contact" id="contact"><strong>CONTACT: </strong> @Model.Contact</p>
                <p class="toggle-section cnic" id="cnic"><strong>CNIC NO:</strong> @Model.CNIC</p>
                <p class="toggle-section spo" id="spo"><strong>SPO:</strong> @Model.SPO</p>
                <p class="toggle-section mega" id="mega"><strong>MEGA:</strong> @Model.Mega</p>
                <p class="toggle-section pax" id="pax"><strong>PAX:</strong> @Model.PAX</p>
                @foreach (string s in Model.Members)
                {
                    <p class="toggle-section one" id="one">@s</p>
                }
            </div>
       
    </div>

</body>
<script>
    document.querySelectorAll('.toggle-checkbox').forEach(function (checkbox) {
        checkbox.addEventListener('change', function () {
            var sectionClass = this.id.replace('toggle', '').toLowerCase();
            var toggleSections = document.querySelectorAll('.toggle-section.' + sectionClass);
            toggleSections.forEach(function (section) {
                if (checkbox.checked) {
                    section.classList.remove('hide');

                } else {
                    section.classList.add('hide');
                }
            });
        });
    });
</script>

</html>
