@{
    Layout = null;
}
@model CardModel
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ID  Card </title>
    <style>
        * {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin: 0;
            padding: 0;
        }

        body {
            font-weight: bolder;
        }

        .card {
            float: left;
            width: 3.0in;
            height: 4.0in;
            background-color: black;
            border-radius: 15px;
            margin: 10px;
            position: relative;
            overflow: hidden;
        }

        .background-image {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 1;
        }

        .name-container {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 1000; 
        }

        .hajj-name-title {
            color: white;
            font-size: 18px;
            margin: 0;
            line-height: 22px;
            border-radius: 16px;
            padding: 15px;
            position: absolute;
            top: 30px;
            left: 50%;
            transform: translateX(-50%);
            width: 80%;
            text-align: center;
            z-index: 1000;
            text-shadow: 1px 1px 2px rgba(0,0,0,0.8);
        }

        .al-barkha-img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: center 10%;
        }

        .hajjwithkhairlogo {
            width: 200px;
            height: 200px;
            text-align: center;
            margin: 0 auto;
            display: block;
            margin-top: 30px;
            position: relative;
        }

            .hajjwithkhairlogo img {
                width: 100%;
                text-align: center;
            }
        .Hajji_name {
            color: white;
            text-align: center;
            position: relative;
        }

        .password-box {
            color: black;
            position: absolute;
            top: 200px;
            left: 25px;
            z-index: 1000;
            padding: 5px;
            border-radius: 5px;
        }
        
        .office-box {
            color: black;
            position: absolute;
            top: 100px;
            left: 10px;
            z-index: 1000;
            padding: 5px;
            border-radius: 5px;
        }

            .password-box h3 {
                color: red;
            }
            .office-box h3 {
                color: red;
            }

        .HB-Box {
            color: black;
            position: absolute;
            top: 250px;
            left: 25px;
            z-index: 1000;
            padding: 5px;
            border-radius: 5px;
        }

            .HB-Box h3 {
                color: red;
            }

        .no-text {
            font-size: 9px;
            color: black;
        }

        .luggage-company-name {
            color: black;
            text-align: center;
            position: absolute;
            bottom: 15px;
            width: 100%;
            z-index: 1000;
            padding: 5px;
        }
        .backcard-desin {
            float: left;
            width: 3.0in;
            height: 4.0in;
            background-color: black;
            border-radius: 15px;
            margin: 10px;
            position: relative;
            overflow: hidden;
        }

            .backcard-desin > div:first-child {
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
            }

            .backcard-desin .al-barkha-img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                object-position: center;
            }

        .jwithkhairlogo {
            width: 200px;
            height: 200px;
            text-align: center;
            margin: 0 auto;
            display: block;
            margin-top: 30px;
        }

        .compnay-name-title {
            text-align: center;
            text-transform: uppercase;
            color: white;
            margin-top: 30px;
            position: relative;
            z-index: 1000;
        }

            .compnay-name-title h2 {
                color: black;
                margin-right: 20px;
            }

        .hajj-name-title {
            color: black;
            font-size: 25px;
            margin: 0;
            border-radius: 16px;
            padding: 15px;
            position: absolute;
            top: 30px;
            left: 50%;
            width: 80%;
            text-align: center;
            z-index: 1000;
          
        }

        .Luggage-card-text {
            text-align: center;
            color: white;
            font-size: 13px;
            border-radius: 3px;
            padding: 3px 5px;
            text-transform: uppercase;
        }

        .box-img {
            position: absolute;
            height: 70px;
            width: 70px;
            right: 25px;
            top: 200px;
            border-radius: 14px;
            z-index: 1000; 
        }

            .box-img img {
                z-index: -999;
                width: 100%;
                border-radius: 10px;
            }

        .luggage-box {
            width: 70px;
            position: absolute;
            top: 250px;
            right: 25px;
            text-align: center;
            text-transform: uppercase;
            border-radius: 10px;
            padding: 5px;
            color: white;
            background-color: white;
            z-index: 1000;
        }

        .name-gradient-image {
            width: 190px;
            position: relative;
        }

            .name-gradient-image img {
                width: 100%;
                height: 75px;
                border-radius: 20px;
                position: absolute;
                left: 45px;
            }

        .packeg-title-name {
            margin-left: -45px;
            color: black;
            font-size: 14px;
            position: absolute;
            top: 115px;
            left: 35%;
        }

            .packeg-title-name::after {
                position: absolute;
                content: "";
                left: -40px;
                bottom: 0;
                width: 200%;
                border: 1px solid white;
                background-color: white;
            }

        .qr-back-container {
            position: absolute;
            bottom: 90px;
            left: 50%;
            transform: translateX(-50%);
            display: flex;
            justify-content: right;
            width: 75%;
            gap: 10px;
            z-index: 1000;
        }

        .qr-back {
            width: 45%;
            padding: 6px;
            border-radius: 8px;
            text-align: center;
        }

            .qr-back img {
                width: 60px;
                height: 60px;
                object-fit: cover;
                margin-bottom: 4px;
            }

            .qr-back p {
                margin: 2px 0;
                font-size: 8px;
                color: black;
            }

        .al_bait {
            color: black;
        }

        .maktab {
            color: black;
        }

        .Service_Center {
            color: black;
        }
    </style>
</head>
<body>

    @foreach (var m in Model.Members)
    {
        <div class="card">
            <div class="background-image">
                <img src="~/Cards/Idcarback.jpg" alt="" class="al-barkha-img">
            </div>

            <div class="name-container">
                <h1 class="hajj-name-title" style="margin-top:120px !important">
                    @m.HajiName <br> @m.HajiSurName
                </h1>
                <h2 class="packeg-title-name"> @m.PackageName </h2>
            </div>

            <div class="password-box">
                <h3 style="font-size: 13px;">Passport NO</h3>
                <p style="font-size: 13px; "> @m.Passport </p>

            </div>

            <div class="maktab-box-container">
                <div class="HB-Box">
                    <h3 style="font-size: 13px;">HB # @m.HbNo</h3>
                    <p style="font-size: 13px; width: 150px; ">
                        @m.CID</p>
                </div>

                <div class="box-img">
                    @* <img src="~/Images/Cards/card.jpeg"> *@
                </div>
               @*  <div class="luggage-box">
                    <h3 style="font-size: 10px;"><u class="al_bait">@m.CompanyName</u></h3>
                    <h3 class="maktab" style="font-size: 13px;">Maktab</h3>
                    <h1 class="no-text">@m.MaktabNumber</h1>
                    <h5 class="Service_Center" style="font-size: 8px; color:black;">Service Center </h5>
                </div> *@
            </div>

            <div class="cleard" style="clear: both;"></div>
            <div class="luggage-company-name">
                <h4 style="font-size: 12px;margin-top:6px;text-color:red;"> @m.CompanyVisaName </h4>
            </div>

        </div>

        <!-- backdesign Start here  okey -->
        <div class="backcard-desin">
            <div>
                <img src="~/Cards/Idcardfront.jpg" alt="" class="al-barkha-img">
            </div>

            <div class="hajjwithkhairlogo">
                <img src="~/Images/Cards/HAJJ WITH KHAIR.png" alt="">
            </div>

         @*    <div class="office-box">
                <h3 style="font-size: 13px;">Office Address</h3>
                <p style="font-size: 8px; "> @m.OfficeAddress </p>
            </div> *@

            <!-- QR Code (Back Center) -->
          @*   <div class="qr-back-container">
                <div class="qr-back">
                    <img src="~/left.jpg" alt="QR Back 1" />
                    <p><strong>PARK IN BY RADISSON</strong></p>
                    <p>lorem ispum lorem ispum lorem </p>
                </div>
                <div class="qr-back">
                    <img src="~/right.jpg" alt="QR Back 2"/>
                    <p><strong>SAN INN AZIZIA</strong></p>
                    <p>lorem ispum lorem ispum lorem</p>
                </div>
            </div> *@
            <div class="qr-back-container">
                <div class="qr-back">
                    <img src="~/left.jpg" alt="QR Back 1" />
                    <p><strong>PARK INN BY RADISSON</strong></p>
                    <p>AZIZIYAH, 2516 AL MASJID AL HARAM ROAD ALMURSALAT, MAKKAH 24247, SAUDI ARABIA</p>
                </div>
                <div class="qr-back">
                    <img src="~/right.jpg" alt="QR Back 2" />
                    <p><strong>SNAF INN AZIZIA</strong></p>
                    <p>3501 AL MASJID AL HARAM RD, AL MURSALAT، 7851, MAKKAH 24243, SAUDI ARABIA</p>
                </div>
            </div>
           

            <div style="position: absolute; bottom: 40px; width: 100%; text-align: center; z-index: 1000;">
                <h3 style="color: #ff0000;font-size: 19px;margin-bottom: 17px;">HAJJ With TMG</h3>
            </div>
            <div style="position: absolute; bottom: 10px; left: 10px; text-align: left; font-size: 10px; z-index: 1000;">
                <p><strong style="color: red;">HAJJ (MEDINAH):</strong></p>
                <p>0096-59-826 2771</p>
                <p>00966-58-038 0049</p>
            </div>

            <div style="position: absolute; bottom: 10px; right: 10px; text-align: right;  font-size: 10px; z-index: 1000;">
                <p><strong style="color: red;">HAJJ (MAKKAH):</strong></p>
                <p>00966-50 871 9876</p>
                <p>00966-56 881 1786</p>
            </div>

        <!-- backdesign Endnd Card  -->
        </div>
    }

</body>

</html>