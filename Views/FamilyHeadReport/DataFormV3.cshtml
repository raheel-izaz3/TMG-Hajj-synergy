@model DataFormModel

@{
    Layout = "_PrintReportLayout";
}


<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.9.2/html2pdf.bundle.min.js"></script>


<style type="text/css">

    .accommodation-row p {
        padding: 3px 2px;
    }

    p {
        margin: 0;
    }

    .user-img img,
    .monogram img {
        height: 100%;
        width: 100%;
        object-fit: contain;
    }

    .border-dark span {
        border: none !important;
    }

    .monogram {
        height: 60px;
    }

    .fields div {
        border: none !important;
    }

    .user-img {
        width: 130px;
        height: 130px;
    }

    .h5,
    .h6,
    .border-right p {
        font-weight: 500 !important;
    }

    p.h6 {
        margin-bottom: 0;
    }

    * {
        margin: 0;
        padding: 0;
        text-indent: 0;
        font-size: small;
        text-transform: uppercase;
    }

    .page-break {
        page-break-after: always;
    }

    .border-dark {
        border: 0;
        border-bottom-width: 1pt;
        border-style: dashed !important;
    }

    .accommodation td {
        border-bottom: none !important;
        border-top: none !important;
    }

    .accommodation tr {
        border-top-style: solid;
        width: 33% !important;
    }

    table,
    tbody {
        /* vertical-align: middle !important; */
        overflow: visible;
        width: 99vw;
    }

    @@media print {

        body {
            -webkit-print-color-adjust: exact;
        }

        #noteBackground {
            background-color: rgb(226, 226, 226) !important;
            print-color-adjust: exact;
        }

        * {
            font-size: 8.6pt !important;
        }

        .title {
            font-size: 18px !important;
            margin: 0;
        }

        .sub-title {
            font-size: 14px !important;
            margin: 0;
        }

        table {
            vertical-align: middle;
            overflow: visible;
            width: 100vw;
        }

        .show-prices-fac {
            display: none
        }

        .hideInPrint {
            display: none;
        }

        p.totalPackage {
            font-size: 16px !important;
            font-weight: bold !important;
        }

        span.totalPackage {
            font-size: 16px !important;
            font-weight: bolder !important;
        }
    }

    p,
    h6 span {
        font-weight: 100 !important;
    }

    .table tr td {
        border-top-style: solid;
        border-top-width: 1pt;
        border-left-style: solid;
        border-left-width: 1pt;
        border-bottom-style: solid;
        border-bottom-width: 1pt;
        border-right-style: solid;
        border-right-width: 1pt;
    }

    .additional-facility tr {
        text-align: center;
    }

    .border {
        border-width: 1pt !important;
    }

    .fillable {
        font-weight: 400 !important;
    }

    .signature-section, .members-section {
        page-break-inside: avoid;
    }

</style>


<div class="dataform">

    @{
        int counter = 0;
    }

    @foreach (DataFormModelEntry item in Model.Entries)
    {
        if (counter > 0) break;
        <div class="form-container container-fluid">
            <div class="header-section  d-flex justify-content-end ">
                <div class="mid-div col-4 text-center">
                    <h1 class="fw-bold title">
                        HAJJ FORM @ViewBag.HajjSeason?.Season (@ViewBag.HajjSeason?.Hijri AH)
                    </h1>
                    @* <h3 class="fw-bold sub-title">
                @Model.MunazzimName
                </h3> *@
                </div>
                <div class="additional-fields d-flex justify-content-end col-4">
                    <table class="table">
                        <tr>

                            <td class="fields text-right" style="text-wrap: nowrap;">
                                <div class="border d-flex-column  ">
                                    <p class="d-block border border-dark p-1 mb-2" style="text-align: center;">
                                        APPLICANT TYPE:
                                    </p>
                                    <p class="d-block border border-dark p-1" style="text-align: center;">Hajj App #</p>
                                </div>
                            </td>
                            <td class="fields text-right" style="text-wrap: nowrap;">
                                <p></p>
                                <div class="border ">
                                    <p class="d-block border border-dark p-1  mb-2" style="text-align: center;">
                                        <span>@item.ApplicantType</span>
                                    </p>
                                    <p class="d-block border border-dark p-1 " style="text-align: center;">
                                        <span>@item.HajjAppNumber</span>
                                    </p>
                                </div>
                            </td>

                        </tr>
                    </table>
                </div>
            </div>

            <table class="table m-0 p-0">
                <tr>
                    <td class="border-right user-img" colspan="1" rowspan="3">
                        <img loading="lazy" src="~/@item.FamilyHeadImage" alt="" class=" ">
                    </td>
                    <td class="border-right" colspan="2">
                        <p class="d-inline">CID</p>
                        <span class="fillable">@item.CID</span>
                    </td>
                    <td class="border-right" colspan="2">
                        <p class="d-inline">PACKAGE: </p>
                        <span class="fillable">@item.PackageNameDuration</span>
                    </td>
                    <td class="border-right" colspan="2">
                        <p class="d-inline">HGO NAME: </p>
                        <span class="fillable">@item.HGOName</span>
                    </td>
                    <td class="border-right" colspan="2">
                        <p class="d-inline">Cluster NAME: </p>
                        <span class="fillable">@Model.MunazzimName</span>
                    </td>
                </tr>
                <tr>
                    <td class="border-right">
                        @* <p class="d-inline">
                    MORA PACKAGE #:
                    <span class="fillable">@item.MoraPackageNumber</span>
                    </p> *@
                        <p class="d-inline">ENROLLMENT NO.</p>
                        <span class="fillable">@item.EnrollmentNumber</span>
                    </td>

                    <td class="border-right">
                        <p class="d-inline">STAY DURATION: <span class="fillable">@item.StayDuration</span></p>
                    </td>
                    <td>
                        <p class="h6 d-inline">MARRIED? </p>
                        <p class="fillable d-inline">@item.IsMarried</p>
                    </td>
                    <td>
                        <p class="h6 d-inline">BLOOD GROUP:</p>
                        <p class="fillable d-inline">@item.BloodGroup</p>
                    </td>
                    <td>
                        <p class="h6 d-inline">FIQAH: <span class="fillable">@item.Fiqah</span></p>
                    </td>
                    <td>
                        <p class="h6 d-inline">GENDER: <span class="fillable">@item.Gender</span></p>
                    </td>
                    <td colspan="2">
                        <p class="text-nowrap h6 d-inline">CNIC No.</p>
                        <p class="fillable d-inline">@item.CNIC</p>
                    </td>

                </tr>
                <tr>
                    <td>
                        <p class="h6 mt-1">
                            GIVEN NAME:
                        </p>
                        <span class="fillable">@item.GivenName</span>
                    </td>
                    <td>
                        <p class="h6 mt-1">
                            SURNAME:
                        </p>
                        <span class="fillable">@item.SurName</span>
                    </td>
                    <td>
                        <p class="h6">
                            D.O.B:
                        </p>
                        <p class="fillable">@item.DateOfBirth</p>
                    </td>
                    <td colspan="2">
                        <p class="h6">
                            FATHER’S /
                            HUSBAND’S NAME
                        </p>
                        <p class="fillable">@item.FatherHusbandName</p>

                    </td>
                    <td>
                        <p class="text-nowrap h6">
                            PASSPORT NO.
                        </p>
                        <p class="fillable">@item.PassportNumber </p>
                    </td>
                    <td>
                        <p class="text-nowrap h6">
                            DATE OF
                            EXPIRY
                        </p>
                        <p class="fillable">@item.PassportDateOfExpiry</p>
                    </td>
                </tr>
                <tr style="">
                    <td class="border-right" style="vertical-align: top;" colspan="4">
                        <p>
                            ADDRESS: <span class="fillable d-inline">@item.PresentPostalAddress</span>
                        </p>
                    </td>
                    <td class="border-right" colspan="1">
                        <p>
                            TEHSIL CODE: <span class="fillable d-inline">@item.TehsilCode</span>
                        </p>
                    </td>
                    <td class="border-right" colspan="1">
                        <p>
                            MOBILE: <span class="fillable d-inline">@item.MobileNumber</span>
                        </p>
                    </td>
                    <td class="border-right border-left" colspan="2">
                        <p>
                            EMAIL: <span class="fillable d-inline">@item.Email</span>
                        </p>
                    </td>
                </tr>

                <tr style="height:15pt" class="text-nowrap">
                    <td class="border-right" colspan="2">
                        <p>
                            PERFORMED HAJJ IN LAST FIVE YEARS?
                            <span class="fillable px-3">@item.PerformedHajjInLast5Years</span>
                        </p>
                        @if (item.PerformedHajjInLast5Years.Equals("YES"))
                        {
                            <p>Years: @item.YearsPerformedHajj</p>
                        }
                    </td>
                    <td class="border-right" colspan="2">
                        <p>
                            WANT TO PERFORM HAJJ-E-BADAL?
                            <span class="fillable px-3">@item.WantToHajjEBadal</span>
                        </p>
                    </td>
                    <td class="border-right" colspan="2">
                        <p>
                            WANT TO PERFORM HAJJ AS GROUP WORKER?
                            <span class="fillable px-3">@item.WantToPerformHajjAsGroupWorker</span>
                        </p>
                    </td>
                    <td class="border-right" colspan="3">
                        <p>
                            ARE YOU MEHRAM OF A LADY?
                            <span class="fillable px-3">@item.AreYouMehramOfALady</span>
                        </p>
                    </td>

                </tr>
                <tr style="height: 70pt">
                    <td class="border-right" colspan="4">
                        <p><u>NOMINEE IN CASE OF DEATH (MUST BE ADULT/RELATIVE)</u></p>
                        <p>NAME: <span class="fillable">@item.NomineeName</span></p>
                        <p>RELATIONSHIP: <span class="fillable">@item.NomineeRelation</span></p>
                        <p>CNIC NO. <span class="fillable">@item.NomineeCNIC</span></p>
                        <p>MOBILE NO. <span class="fillable">@item.NomineeContact</span></p>
                        <p>TELEPHONE NO. <span class="fillable">@item.NomineeTelephone</span></p>
                    </td>

                    <td class="border-right p-1" colspan="5">
                        <p>
                            <u>MEHRAM'S DETAILS <small>(FOR LADIES ONLY)</small></u> &nbsp;
                            APPLICATION NO. CODE: <span>@item.MehramAppNumber</span> <SMALL style="COLOR: GRAY">
                                (FOR OFFICE
                                USE)
                            </SMALL>
                        </p>
                        <p>MEHRAM'S NAME: @item.MehramName RELATIONSHIP: @item.MehramRelationship</p>
                        <p style="min-height: 80px;" class="border">
                            <img loading="lazy" src="@item.MehramSignatureBase64" height="80" alt="">
                        </p>
                        <p class="text-center"> SIGNATURE &amp; THUMB IMPRESSION</p>
                    </td>
                </tr>
                <tr style="">
                    <td class="border-right" colspan="9" id="noteBackground">
                        <p class="d-inline">Note: </p>
                        <p class="d-inline" style="font-weight: 400 !important; font-size: 0.9rem !important;">
                            Every Hajji is required to personally complete their biometrics using the Saudi Bio App, if
                            applicable (self-biometrics). The costs, charges, and results are the individual's responsibility.
                        </p>
                    </td>
                </tr>

            </table>
            <table cellspacing="0" class="table mb-0">
                @* <tr>
            <td class="border-right" colspan="17">
            <p class="h5 text-center mb-0">HAJJ PACKAGE DETAILS (MEDINA ARRIVAL: @item.MedinahArrival HAJJ)</p>
            <input type="radio" class="hideInPrint" name="hajjPackagePrices" value="pkr"
            onchange="onHajjPackageCurrencyChange(this.value)">
            <span class="hajjPackagePricesSpan hideInPrint">PKR</span>
            <input type="radio" class="hideInPrint" name="hajjPackagePrices" value="sar"
            onchange="onHajjPackageCurrencyChange(this.value)">
            <span class="hajjPackagePricesSpan hideInPrint">SAR</span>
            <input type="radio" class="hideInPrint" name="hajjPackagePrices" value="usd"
            onchange="onHajjPackageCurrencyChange(this.value)" checked="checked">
            <span class="hajjPackagePricesSpan hideInPrint">USD</span>
            </td>
            </tr> *@

                <tr style="">
                    <td class="border-right" colspan="8">

                        <p>
                            HAJJ PACKAGE W/O TICKET INCLUDING ROOMS:
                            <span class="fillable package-usd" style="display:inline">
                                @Model.BaseCurrency @((Model.BasePackagePrice + Model.RoomPrice + Model.TrainPrice).ToString("N2")) /-
                            </span>
                        </p>
                        <p>
                            ** Add-ons:
                            <span class="fillable package-usd" style="display:inline">@Model.BaseCurrency @Model.AddonsPrice.ToString("N2")/-</span>
                        </p>
                        <p>
                            ** Add-ons Discount:
                            <span class="fillable package-usd" style="display:inline">@Model.BaseCurrency @Model.AddonsDiscount.ToString("N2")/-</span>
                        </p>
                        <p>
                            Discount :
                            <span class="fillable package-usd" style="display:inline">@Model.BaseCurrency @Model.TotalDiscount.ToString("N2")/-</span>
                        </p>
                        <p>
                            Flight TICKET:
                            <span class="fillable package-usd" style="display:inline">
                                @Model.BaseCurrency
                                @Model.FlightPrice.ToString("N2")/-
                            </span>
                        </p>
                        <p class="totalPackage">
                            TOTAL PACKAGE:
                            <span class="fillable package-usd  totalPackage" style="display:inline">@Model.BaseCurrency @Model.TotalPackagePrice.ToString("N2")/-</span>
                        </p>
                    </td>
                    @* <td class="border-right" colspan="3" >
                @if (!item.TicketIncluded.Equals("Excluded"))
                {
                <p class="h6">
                FLIGHT TYPE: <span class="fillable">@item.FlightType </span>
                </p>
                <p class="h6">CLASS: <span class="fillable">@item.FlightClass </p>
                <p class="h6">PLACE OF DEPARTURE:<span class="fillable"> @item.POD</span></p>
                <p class="h6">AIR TICKET: <span class="fillable">@item.TicketIncluded</span></p>

