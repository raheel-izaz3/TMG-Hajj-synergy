                </td> *@
                    <td class="border-right" colspan="9">
                        @{
                            int x = 1, y = 1, z = 1;
                        }
                        <p class="m-0">TRAINING SESSION</p>
                        @foreach (DataFormTrainingSession t in item.TrainingSessions)
                        {
                            <span class="fillable mb-1"><b>@x</b>. <b>Session:</b> @t.TrainingSession <b>Expected Time:</b> @t.ExpectedTime<b> Expected Venue:</b> @t.ExpectedVenue</span>

                            <br />
                            x++;
                        }

                    </td>
                </tr>
                <tr>
                    <td class="border-right" colspan="17">
                        <p class="h5 text-center mb-0">TRANSPORT</p>
                    </td>
                </tr>
                <tr>
                    <td class="border-right" colspan="6">
                        <p>ROUTES:</p>
                        <input class="hideInPrint" type="checkbox" id="toggleRoutes" onchange="toggleAllDateTimes('routeDateTime', this.checked)" checked>
                        <label class="hideInPrint" for="toggleRoutes">Show All Routes DateTime</label>
                        <ul>
                            @if (ViewBag.Routes != null && ViewBag.Routes.Count > 0)
                            {
                                foreach (var route in ViewBag.Routes)
                                {
                                    <li style="margin-bottom: 10px">
                                        <span class="fillable"><strong>Route:</strong> @route.TravelRoutes</span><br />
                                        <span class="fillable"><strong>Vehicle:</strong> @route.VehicleName</span><br />
                                        <div id="routeDateTime_@route.Id" class="routeDateTime" style="display:block;">
                                            @* <span><strong>Departure:</strong> @route.CheckOut.ToString("dd/MMM")</span> *@
                                            <span><strong>Arrival:</strong> @route.CheckIn.ToString("dd/MMM")</span>
                                        </div>
                                    </li>
                                }
                            }
                            else
                            {
                                <li>No route details available.</li>
                            }
                        </ul>
                    </td>

                    <td class="border-right" colspan="5">
                        <p>FLIGHTS:</p>
                        <input class="hideInPrint" type="checkbox" id="toggleFlights" onchange="toggleAllDateTimes('flightDateTime', this.checked)" checked>
                        <label class="hideInPrint" for="toggleFlights">Show All Flights DateTime</label>
                        <ul>
                            @if (ViewBag.Flights != null && ViewBag.Flights.Count > 0)
                            {
                                foreach (DataFormModelEntry flight in ViewBag.Flights)
                                {
                                    <li style="margin-bottom: 10px">
                                        <span class="fillable"><strong>Location :</strong> @flight.Origin - @flight.Destination</span><br />
                                        <span class="fillable"><strong>Airline :</strong> @flight.Airline</span><br />
                                        <div id="flightDateTime_@flight.Id" class="flightDateTime" style="display:block;">
                                            <span><strong>Departure:</strong> @flight.DepartureDateTime?.ToString("dd/MMM") @flight.DepartureTime?.ToString("HH:mm")</span>
                                            <span><strong>Arrival:</strong> @flight.ArrivalDateTime?.ToString("dd/MMM") @flight.ArrivalTime?.ToString("HH:mm")</span>
                                        </div>
                                    </li>
                                }
                            }
                            else
                            {
                                <li>No flight details available.</li>
                            }
                        </ul>
                    </td>

                    <td class="border-right" colspan="6">
                        <p>TRAIN:</p>
                        <input class="hideInPrint" type="checkbox" id="toggleTrains" onchange="toggleAllDateTimes('trainDateTime', this.checked)" checked>
