<script>
    function onFacPricesCheck(elem) {
        const prices = document.getElementsByClassName('fac-prices')
        for (let price of prices) {
            price.style.display = elem.checked ? "inline" : "none"
        }
    }

    function onExtraPricesCheck(elem) {
        const prices = document.getElementsByClassName('extra-prices')
        for (let price of prices) {
            price.style.display = elem.checked ? "inline" : "none"
        }
    }


    function onHajjPackageCurrencyChange(val) {
        const pkrs = document.getElementsByClassName("package-pkr")
        const sars = document.getElementsByClassName("package-sar")
        const usds = document.getElementsByClassName("package-usd")

        const pkrs_fac = document.getElementsByClassName("pkr-fac-prices")
        const sars_fac = document.getElementsByClassName("sar-fac-prices")
        const usds_fac = document.getElementsByClassName("usd-fac-prices")

        const pkrs_extra_fac = document.getElementsByClassName("pkr-extra-prices")
        const sars_extra_fac = document.getElementsByClassName("sar-extra-prices")
        const usds_extra_fac = document.getElementsByClassName("usd-extra-prices")

        const checkExtra = document.getElementById("check-extra")


        if (val == "pkr") {
            for (let e of pkrs) {
                e.style.display = 'inline';
            }
            for (let e of pkrs_fac) {
                e.style.display = 'inline';
            }

            for (let e of sars) {
                e.style.display = 'none';
            }
            for (let e of sars_fac) {
                e.style.display = 'none';
            }

            for (let e of usds) {
                e.style.display = 'none';
            }
            for (let e of usds_fac) {
                e.style.display = 'none';
            }

            if (checkExtra.checked) {
                for (let e of pkrs_extra_fac) {
                    e.style.display = 'inline';
                }
                for (let e of sars_extra_fac) {
                    e.style.display = 'none';
                }
                for (let e of usds_extra_fac) {
                    e.style.display = 'none';
                }
            }

        }
        else if (val == 'sar') {
            for (let e of pkrs) {
                e.style.display = 'none';
            }
            for (let e of pkrs_fac) {
                e.style.display = 'none';
            }

            for (let e of sars) {
                e.style.display = 'inline';
            }
            for (let e of sars_fac) {
                e.style.display = 'inline';
            }

            for (let e of usds) {
                e.style.display = 'none';
            }
            for (let e of usds_fac) {
                e.style.display = 'none';
            }

            if (checkExtra.checked) {
                for (let e of pkrs_extra_fac) {
                    e.style.display = 'none';
                }
                for (let e of sars_extra_fac) {
                    e.style.display = 'inline';
                }
                for (let e of usds_extra_fac) {
                    e.style.display = 'none';
                }
            }
        }
        else {
            for (let e of pkrs) {
                e.style.display = 'none';
            }
            for (let e of pkrs_fac) {
                e.style.display = 'none';
            }

            for (let e of sars) {
                e.style.display = 'none';
            }
            for (let e of sars_fac) {
                e.style.display = 'none';
            }

            for (let e of usds) {
                e.style.display = 'inline';
            }
            for (let e of usds_fac) {
                e.style.display = 'inline';
            }

            if (checkExtra.checked) {
                for (let e of pkrs_extra_fac) {
                    e.style.display = 'none';
                }
                for (let e of sars_extra_fac) {
                    e.style.display = 'none';
                }
                for (let e of usds_extra_fac) {
                    e.style.display = 'inline';
                }
            }
        }
    }

</script>


<script>
    document.getElementById('download-pdf').addEventListener('click', function () {
        var element = document.querySelector('.dataform');

        // Hide buttons before generating the PDF
        var buttons = document.querySelectorAll('.print-btn');
        buttons.forEach(button => button.style.display = 'none');

        html2pdf().from(element).set({
            margin: 1,
            filename: 'DataFormV3.pdf',
            image: { type: 'jpeg', quality: 0.98 },
            html2canvas: { scale: 2 },
            jsPDF: { unit: 'in', format: 'letter', orientation: 'portrait' }
        }).save().then(function () {
            // Show buttons after PDF is generated
            buttons.forEach(button => button.style.display = 'inline-block');
        });
    });
</script>

<script>
    function toggleAllDateTimes(className, isChecked) {
        var elements = document.getElementsByClassName(className);
        for (var i = 0; i < elements.length; i++) {
            elements[i].style.display = isChecked ? 'block' : 'none';
        }
    }
</script>