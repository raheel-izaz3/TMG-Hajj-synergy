                                            <span><strong>Departure Date:</strong> @train.TrainDepartureDateTime?.ToString("dd/MMM") @train.TrainDepartureTime?.ToString("HH:mm")</span>
                                            <span><strong>Arrival Date:</strong> @train.TrainArrivalDateTime?.ToString("dd/MMM") @train.TrainArrivalTime?.ToString("HH:mm")</span>
                                        </div>
                                    </li>
                                }
                            }
                            else
                            {
                                <li>No train details available.</li>
                            }
                        </ul>
                    </td>
                </tr>

