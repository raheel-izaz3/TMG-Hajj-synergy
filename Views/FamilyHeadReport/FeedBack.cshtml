@model FeedbackForm

@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="ur" dir="rtl">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>FeedBack Form</title>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Naskh+Arabic&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Noto Naskh Arabic', serif;
            background: #fff;
            margin: 0;
            direction: rtl;
            font-size: 10px;
            padding: 6px;
        }

        .container {
            width: 100%;
            max-width: 794px;
            margin: auto;
            padding: 8px;
        }

        .top-section {
            display: flex;
            align-items: center;
            margin-bottom: 4px;
        }

        .top-left img {
            height: 85px;
        }

        .top-right {
            text-align: right;
            font-size: 13px;
            line-height: 1.2;
            white-space: nowrap;
        }

        .form-title {
            text-align: center;
            margin: 3px 0 8px;
            font-size: 12px;
            font-weight: bold;
        }

        .header-box {
            padding: 6px;
            margin-bottom: 8px;
        }

            .header-box.bordered {
                border: 1px solid #000;
            }

        .header-row {
            display: flex;
            flex-wrap: wrap;
            justify-content: space-between;
            margin-bottom: 5px;
            border-bottom: 1px solid #000;
            padding-bottom: 2px;
        }

            .header-row > div {
                width: 32%;
                margin-bottom: 4px;
                font-size: 10px;
            }

        .with-line::after {
            content: "";
            display: block;
            margin-top: 2px;
            border-bottom: 1px solid #000;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 8px;
            font-size: 10px;
        }

        table, th, td {
            border: 1px solid #000;
        }

        th, td {
            padding: 3px;
            text-align: center;
            vertical-align: middle;
        }

        .signature {
            margin-top: 12px;
            display: flex;
            justify-content: space-between;
            padding: 0 15px;
        }

        .final-section {
            margin-top: 12px;
            font-size: 10px;
        }

            .final-section .row {
                display: flex;
                justify-content: space-between;
                margin-bottom: 4px;
            }

                .final-section .row div {
                    width: 32%;
                }

        .qr-note {
            margin-top: 8px;
            font-size: 9px;
            text-align: center;
        }

        table, .header-box, .form-title, .top-section, .header-row, .final-section, .signature {
            page-break-inside: avoid;
            break-inside: avoid;
        }

        @@media print {
            body {
                zoom: 0.43;
                margin: 0;
                padding: 0;
            }

            .container {
                width: 100%;
                max-width: 100%;
                padding: 0;
                margin: 0 auto;
                page-break-inside: avoid;
            }

            .export-btn {
                display: none !important;
            }

            html, body {
                height: auto;
                overflow: visible !important;
            }
        }

        @@page {
            size: A4;
            margin: 5mm;
        }

        th, td {
            padding: 2px !important
        }
    </style>
    <style>
        .line-wrapper {
            display: flex;
            justify-content: center;
            align-items: stretch;
            height: 100%;
        }

