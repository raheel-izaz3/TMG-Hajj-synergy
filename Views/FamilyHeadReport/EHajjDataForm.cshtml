@model EHajjReportModelList

@{
    Layout = "";
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>E-Hajj Visa Form</title>
    <link rel="icon" type="image/x-icon" href="~/FAV ICON64.png" />
    <style>
        @@media print {
            .check-box {
                display: none !important;
            }

            .page-break {
                page-break-after: always;
            }

            button {
                display: none;
            }
        }


        * {
            margin: 0;
            padding: 0;
            font-size: 9px;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .check-box {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            padding: 10px;
        }

        .check-box label {
            font-size: 10px;
            margin: 5px;
        }

        h5 {
            color: #fff;
            padding: 5px;
            background-color: burlywood;
            width: 60px;
            font-size: 13px;
        }

        h4 {
            font-size: 20px;
        }

        caption {
            background-color: burlywood;
            color: #fff;
            font-size: 13px;
        }

        table {
            padding: 0;
            margin: 0;
            margin: 7px;
            width: 98%;
            border-collapse: collapse;
        }

        td {
            margin: 0;
            padding: 5px 3px;
            border: 1px solid black;
        }

        .main {
            margin: 30px;
            width: 65%;
        }

        .container {
            width: 150%;
            height: 600px;
            border: 1px solid red;
        }

        .cnic-infobox {
            display: flex;
            margin-left: 30px;
        }

        .cnic-pic {
            width: 500px;
            height: 240px;
        }

        .user-info {
            font-size: 8px;
            padding: 15px;
            width: 180px;
            margin-left: -20px;
            margin-top: 50px;
        }

        .main-container {
            margin-left: -10px;
            display: flex;
        }

        .user-info1 {
            font-size: 8px;
            padding: 10px;
            width: 180px;
            margin-left: -70px;
            margin-top: 10px;
        }

        .hide {
            display: none;
        }
    </style>
</head>

<body>


    @foreach (EHajjReportModel item in Model.Entries)
    {
        <div class="main-container" style="margin-top: 20px;">
            <div class="main">
                <h4>E-HAJJ REPORT</h4>
                <div class="container">
                    <img src="~/@item.EhajjPath" class="container-image" style="max-width: 150%; max-height: 100%" alt="">
                </div>
            </div>
        </div>

        if (!item.Verified)
        {
            <button id="btn-@item.FamilyHeadId"
                style="cursor: pointer; padding: 10px 20px; background-color: lightgreen; margin-left: 20px; margin-bottom: 20px;"
                onclick="verify(@item.FamilyHeadId)">Verify</button>
        }
        else{
            <button disabled id="btn-@item.FamilyHeadId"
                style="cursor: pointer; padding: 10px 20px; background-color: lightgreen; margin-left: 20px; margin-bottom: 20px;"
                >Verified!</button>
        }

        <div class="cnic-infobox">
            <div class="cnic-pic">
                <figure>
                    <img src="~/@item.PassportImagePath" alt="" width="400px" height="300px">
                </figure>
            </div>
        </div>
        <br />
        <br />
        <br />
        <div class="page-break"></div>
    }

</body>
<script>
    function verify(id) {
        fetch("/FamilyHeadReport/VerifyEHajjVisa/" + id)
            .then(res => res.json())
            .then(data => {
                console.log(data)
                const btn = document.getElementById("btn-" + id);
                btn.setAttribute('disabled', '')
                btn.innerText = 'Verified!'
            })
    }

    document.querySelectorAll('.toggle-checkbox').forEach(function (checkbox) {
        checkbox.addEventListener('change', function () {
            var sectionClass = this.id.replace('toggle', '').toLowerCase();
            var toggleSections = document.querySelectorAll('.toggle-section.' + sectionClass);
            toggleSections.forEach(function (section) {
                if (checkbox.checked) {
                    section.classList.remove('hide');

                } else {
                    section.classList.add('hide');
                }
            });
        });
    });
</script>

</html>
