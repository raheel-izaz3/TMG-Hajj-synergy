@model TMG.Models.NewChartOfAccounts.NewVoucher.NewVoucherTypes

@{
    Layout = "~/Views/Shared/_AccountsLayout.cshtml";
    string modelName = "NewVoucherTypes";
    string modelNamePlural = "NewVoucherTypes";
    string modelControllerRoute = "NewVoucherTypes";
}


<div class="container-xxl flex-grow-1 container-p-y">
    <h4 class="fw-bold" style="color:  #404040;"><span class="text-muted fw-light"> @modelName / </span> Edit</h4>

    <hr class="mb-4" />

    <div class="row">
        <div class="col-sm-12">
            <div class="card mb-4">
                <div class="card-body">
                    <form method="post">
                        <input type="hidden" asp-for="NewVoucherTypesId" />
                        <div class="row">
                            <div class="col-sm-3 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname" asp-for="VoucherTypeName"></label>
                                <div class="input-group input-group-merge">
                                    <span id="basic-icon-default-fullname2" class="input-group-text"><i class="bx bx-building"></i></span>
                                    <input asp-for="VoucherTypeName" type="text" class="form-control">
                                </div>
                                <span class="text-danger" asp-validation-for="VoucherTypeName"></span>
                            </div>
                            <div class="col-sm-3 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname" asp-for="VoucherTypeCode"></label>
                                <div class="input-group input-group-merge">
                                    <span id="basic-icon-default-fullname2" class="input-group-text"><i class="bx bx-building"></i></span>
                                    <input asp-for="VoucherTypeCode" type="text" class="form-control">
                                </div>
                                <span class="text-danger" asp-validation-for="VoucherTypeCode"></span>
                            </div>
                            <div class="col-sm-12 mt-4">
                                <button type="submit" class="btn btn-success float-end">Save Changes</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>

</div>