@model AuthorizationAgent

@{
    string modelName = "Authorization Agent";
    string modelNamePlural = "Authorization Agent";
    string modelControllerRoute = "AuthorizationAgent";
}

<div class="container-xxl flex-grow-1 container-p-y">
    <h4 class="fw-bold" style="color:  #404040;"><span class="text-muted fw-light"> @modelName / </span> Create</h4>

    <hr class="mb-4" />

    <div class="row">
        <div class="col-sm-12">
            <div class="card mb-4">
                <div class="card-body">
                    <form method="post">
                        <div class="row">
                            <!-- Row containing Name, Contact, and Email fields -->
                            <div class="col-sm-4 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname" asp-for="Name"></label>
                                <div class="input-group input-group-merge">
                                    <span id="basic-icon-default-fullname2" class="input-group-text">
                                        <i class="bx bx-building"></i>
                                    </span>
                                    <input asp-for="Name" class="form-control">
                                </div>
                                <span class="text-danger" asp-validation-for="Name"></span>
                            </div>

                            <div class="col-sm-4 mb-3">
                                <label class="form-label" for="basic-icon-default-contact" asp-for="Contact"></label>
                                <div class="input-group input-group-merge">
                                    <span id="basic-icon-default-contact" class="input-group-text">
                                        <i class="bx bx-phone"></i>
                                    </span>
                                    <input asp-for="Contact" class="form-control">
                                </div>
                                <span class="text-danger" asp-validation-for="Contact"></span>
                            </div>

                            <div class="col-sm-4 mb-3">
                                <label class="form-label" for="basic-icon-default-email" asp-for="Email"></label>
                                <div class="input-group input-group-merge">
                                    <span id="basic-icon-default-email" class="input-group-text">
                                        <i class="bx bx-envelope"></i>
                                    </span>
                                    <input asp-for="Email" class="form-control">
                                </div>
                                <span class="text-danger" asp-validation-for="Email"></span>
                            </div>

                            <!-- Description Field -->
                            <div class="col-sm-12 mb-3">
                                <label class="form-label" for="basic-icon-default-description" asp-for="Description"></label>
                                <div class="input-group input-group-merge">
                                    <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                                </div>
                                <span class="text-danger" asp-validation-for="Description"></span>
                            </div>

                            <div class="col-sm-12 mt-4">
                                <button type="submit" class="btn btn-success float-end">Create</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
