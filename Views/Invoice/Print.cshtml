
@{
    Layout = "_InvoiceLayout";
    
    ViewData["title"] = "Print";
}

<script>
    window.onload = function () {
        document.getElementById("download")
            .addEventListener("click", () => {
                const invoice = this.document.getElementById("acknowledgment");
                console.log(invoice);
                console.log(window);
                var opt = {
                    margin: 0.2,
                    filename: '@ViewBag.HeadNameWithId' + ' Slip.pdf',
                    image: { type: 'jpeg', quality: 0.98 },
                    html2canvas: { scale: 2 },
                    jsPDF: { unit: 'in', format: 'a4', orientation: 'portrait' }
                };
                html2pdf().from(invoice).set(opt).save();
            })
    }
</script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.9.2/html2pdf.bundle.js"></script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.4.1/dist/css/bootstrap.min.css" integrity="sha384-Vkoo8x4CGsO3+Hhxv8T/Q5PaXtkKtu6ug5TOeNV6gBiFeWPGFN9MuhOf23Q9Ifjh" crossorigin="anonymous">
<style>
    * {
        font-size: 14px;
    }
    body{
        background-color:white
    }
    .f-600{
        font-weight:600;
    }
    .bg-custome{
        background-color: #696969;
    }
     .custome{
        color: #696969;
    }
    .table {
        border: none;
        caption-side: bottom;
        border-collapse: separate;
        border-color: black;
        margin-top: 0px;
    }
    .table thead th {
        border-bottom: 0px solid #dee2e6;
    }

    .b-right{
        border-right: 1px solid black;
    }
    
    .table td, .table th {
        padding: 0.1rem;
        vertical-align: top;
        border-top: 1px solid #757575;
    }

    .table td, .table th {
        padding: 0.1rem;
        vertical-align: top;
        border-top: 1px solid #6f6f6f;
    }
    .table {
        border: none;
        caption-side: bottom;
        border-collapse: collapse;
        border-color: black;
        margin-top: 0px;
    }

    .table td, .table th {
        padding: 0.1rem;
        vertical-align: top;
        border-top: 1px solid #6f6f6f;
    }
    .acknowledgment td,th{
        border: 1px solid #6f6f6f;
    }
</style>


<div class="container mt-f">
    <div class="row">
        <div class="col-md-6">
            <button class="btn btn-success" id="download">Download</button>
        </div>
        <div class="col-md-6">
            <input type="checkbox" onclick="stampToggle(this)" checked/>
            <label>Stamp</label>
        </div>
    </div>
</div>

<div class="container mt-3" id="acknowledgment">
    <div class="row mt-2">
        <div class="col-md-10 text-center">
            <h5 id="company_name" style="font-weight: 600;">@ViewBag.Company.CompanyName</h5>
            <div ><span style="font-size: 10px" id="company_address" >@ViewBag.CompanyAddress.Address</span> <span style="font-size: 10px" id="company_zip" >@ViewBag.CompanyAddress.ZipCode</span>, <span style="font-size: 10px" id="company_city" >@ViewBag.CompanyAddress.City</span> <span style="font-size: 10px" id="company_country" >@ViewBag.CompanyAddress.Country</span></div>
            <div ><b style="font-size: 10px;">Phone :</b> <span id="company_phone" >@ViewBag.CompanyContact.CompanyContact</span> <b style="font-size: 10px;">Email :</b>@ViewBag.CompanyEmail.CompanyEmail <span id="company_email" ></span> <b style="font-size: 10px;"> Website :</b> <span id="company_website" >@ViewBag.Company.Website</span></div>                            
        </div>
        <div class="col-md-2">
            <img src="~/@ViewBag.Company.Logo" id="company_logo" width="80" height="80"/>
        </div>
        
    </div>
    <div class="row">
        <div class="col-md-12">
            <div class="row mt-1">
                <div class="col-md-12">
                    <table class="table acknowledgment">
                        <thead>
                            <thead>
                                <tr class="bg-custome">
                                    <td colspan=4>
                                        <h4 class="text-center text-white">Acknowledgment Slip</h4>
                                    </td>
                                </tr>
                            </thead>
                            <tbody>
                            <tr>
                                <td width="20%" style="background-color: rgb(232, 232, 232);" ><b>Received From</b></td>
                                <td width="30%" class="b-right">@(ViewBag.Invoice != null ? (ViewBag.Invoice.FamilyHead.GivenName + " " +  ViewBag.Invoice.FamilyHead.SurName)  : "N/A")</td>
                                <td width="20%" style="background-color: rgb(232, 232, 232);" ><b>Receipt Date</b></td>
                                <td width="30%">@(ViewBag.Invoice != null ? ViewBag.Invoice.Invoice.CreatedAt.ToString("yyyy-MM-dd") : "N/A")</td>
                                
                            </tr>
                            <tr>
                                <td width="20%" style="background-color: rgb(232, 232, 232);" ><b>Amount Received</b></td>
                                <td width="30%" class="b-right">@(ViewBag.Invoice != null ? ViewBag.Invoice.Invoice.AmountRecived : "N/A")</td>
                                <td width="20%" style="background-color: rgb(232, 232, 232);" ><b>Receipt Number</b></td>
                                <td width="30%">HB #@ViewBag.Invoice.FamilyHead.ExtractedFamilyNumber R#@(ViewBag.Invoice != null ? ViewBag.Invoice.Invoice.InvoiceId : "N/A")</td>
                            </tr>
                            <tr>
                                <td width="20%" style="background-color: rgb(232, 232, 232);" ><b>Currency</b></td>
                                <td width="30%" class="b-right">@(ViewBag.Invoice != null ? ViewBag.Invoice.Invoice.Currency : "N/A")</td>                                
                                <td width="20%" style="background-color: rgb(232, 232, 232);" ><b>SPO Name</b></td>
                                <td width="30%">@(ViewBag.spoName)</td>
                            </tr>
                            <tr>
                                <td width="20%" style="background-color: rgb(232, 232, 232);" ><b>Payment Mode</b></td>
                                <td width="30%" class="b-right">@(ViewBag.Invoice != null ? ViewBag.Invoice.Invoice.ModeOfPayment : "N/A")</td>
                                <td width="20%" style="background-color: rgb(232, 232, 232);" ><b>ROE (USD)</b></td>
                                <td width="30%"> @(ViewBag.Invoice != null ? ViewBag.Invoice.Invoice.USDROE : "N/A")</td>
                            </tr>
                            <tr>
                                <td width="20%" style="background-color: rgb(232, 232, 232);" ><b>Instrument Number</b></td>
                                <td width="30%" class="b-right">@(ViewBag.Invoice != null ? ViewBag.Invoice.Invoice.Instrument : "N/A")</td>
                                <td width="20%"  style="background-color: rgb(232, 232, 232);" ><b>Remarks</b></td>
                                <td width="30%" >@(ViewBag.Invoice != null ? ViewBag.Invoice.Invoice.Remarks : "N/A")</td>
                            </tr>
                            <tr>
                                <td width="20%" style="background-color: rgb(232, 232, 232);" ><b>Status</b></td>
                                <td width="30%" class="b-right">@(ViewBag.Invoice != null ? ViewBag.Invoice.Invoice.InvoiceStatus : "N/A")</td>
                                <td width="20%" style="background-color: rgb(232, 232, 232);" ><b>Package</b></td>
                                <td width="30%" class="b-right">@(ViewBag.Package != null ? ViewBag.Package.Name : "N/A")</td>
                            </tr>
                            @if(ViewBag.Invoice.Invoice.ImagePath is not null || ViewBag.Invoice.Invoice.ImageBase64 is not null){
                                <tr>
                                    <td colspan="4" style="background-color: rgb(232, 232, 232);" class="text-center" ><b>Proof Of Payment</b></td>
                                </tr>
                            }
                            <tr>                               
                            <td colspan="4">
                                    @if (ViewBag.Invoice.Invoice.ImagePath is not null)
                                    {
                                        <img  src="~/@ViewBag.Invoice.Invoice.ImagePath" class="img-fluid" alt="Image not Available"/>
                                    }
                                    else if(ViewBag.Invoice.Invoice.ImageBase64 is not null)
                                    {
                                        <img loading="lazy" src="@ViewBag.Invoice.Invoice.ImageBase64" class="img-fluid" alt="Image not Available"/>
                                    }
                                </td>
                            </tr>

                            </tbody>
                        
                    </table>
                </div>
                <div class="col-md-12">
                       <b>Note: Received payment is subject to realization in the bank</b>
                       <br>
                       <br>
                       <img src="~/@ViewBag.Company.Stamp" id="company_stamp" width="130" height="130" class="mt-3"/>
                </div>
            </div>

            <style>
                .mytable {
                    border: none;
                    caption-side: bottom;
                    border-collapse: separate;
                    border-color: green;
                    margin-top: 200px;
                }
                .mytable  tr td {
                    border-top: 1px solid black
                }
            </style>
            @* <div class="row mt-5">
                        <div class="col-md-12">
                            <table class=" table mytable">
                                <tr>
                                    <td >Prepared By</td>
                                    <td >Posted By</td>
                                    <td >Checked By</td>
                                    <td >Approved By</td>
                                    <td >Recived By</td>
                                </tr>
                            </table>
                        </div>
            </div> *@
             
        </div>
    </div>
</div>
<script>
    function stampToggle(input){
        if(input.checked == true){
            document.getElementById('company_stamp').style.display = "block"
        }else{
            document.getElementById('company_stamp').style.display = "none"
        }
    }
</script>

