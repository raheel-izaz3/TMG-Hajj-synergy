<h1>Accomodation Summary Report</h1>

@{
    Dictionary<string, int> OutBonddateDict = new();
}


<div class="big-table-record" id="summaryData">
    <form method="get" action="AccomodationReport">
        <div class="form-group" style="float: left;">
            <label for="dateType">Filter by:</label>
            <select id="dateType" name="dateType" class="form-control">
                <option value="arrival">CheckIn Date</option>
                <option value="departure">CheckOut Date</option>
            </select>
        </div>
        <div class="form-group" style="float: left;">
            <label for="filterDate">Select Date:</label>
            <input type="date" id="filterDate" name="filterDate" class="form-control">
        </div>
        <button type="submit" class="btn btn-primary">Filter</button>
        <a href="AccomodationReport" class="btn-clear">Clear Filter</a>
    </form>
    <table style="width:100%" id="myTable" class="table-responsive">
        <thead>
            <tr>
                <th>SNo</th>
                <th>Company Code</th>
                <th>Package Name</th>
                <th>Group Code</th>
                <th>Hb Number</th>
                <th>Haji Name</th>
                <th style="background-color: #ffd4d4 !important;">Makkah Hotel Name</th>
                <th style="background-color: #ffd4d4 !important;">Makkah Check In Date</th>
                <th style="background-color: #ffd4d4 !important;">Makkah Check In Time</th>
                <th style="background-color: #ffd4d4 !important;">Makkah Check Out Date</th>
                <th style="background-color: #ffd4d4 !important;">Makkah Check Out Time</th>
                <th style="background-color: #e6ffe6 !important;">Medinah Hotel Name</th>
                <th style="background-color: #e6ffe6 !important;">Medinah Check In Date</th>
                <th style="background-color: #e6ffe6 !important;">Medinah Check In Time</th>
                <th style="background-color: #e6ffe6 !important;">Medinah Check Out Date</th>
                <th style="background-color: #e6ffe6 !important;">Medinah Check Out Time</th>
                <th style="background-color: #ededff !important;">Azizia Hotel Name</th>
                <th style="background-color: #ededff !important;">Azizia Check In Date</th>
                <th style="background-color: #ededff !important;">Azizia Check In Time</th>
                <th style="background-color: #ededff !important;">Azizia Check Out Date</th>
                <th style="background-color: #ededff !important;">Azizia Check Out Time</th>
                <th>Mina Camp Name</th>
                <th>Mina Check In Date</th>
                <th>Mina Check In Time</th>
                <th>Mina Check Out Date</th>
                <th>Mina Check Out Time</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.SNo</td>
                    <td>@item.CompanyCode</td>
                    <td>@item.PackageName</td>
                    <td>@item.GroupCode</td>
                    <td>@item.HbNumber</td>
                    <td>@item.HajiName</td>
                    <td>@item.MakkahHotel.Hotel</td>
                    <td>@item.MakkahHotel.CheckInDate</td>
                    <td>@item.MakkahHotel.CheckInTime</td>
                    <td>@item.MakkahHotel.CheckOutDate</td>
                    <td>@item.MakkahHotel.CheckOutTime</td>
                    <td>@item.MedinaHotel.Hotel</td>
                    <td>@item.MedinaHotel.CheckInDate</td>
                    <td>@item.MedinaHotel.CheckInTime</td>
                    <td>@item.MedinaHotel.CheckOutDate</td>
                    <td>@item.MedinaHotel.CheckOutTime</td>
                    <td>@item.AziziaHotel.Hotel</td>
                    <td>@item.AziziaHotel.CheckInDate</td>
                    <td>@item.AziziaHotel.CheckInTime</td>
                    <td>@item.AziziaHotel.CheckOutDate</td>
                    <td>@item.AziziaHotel.CheckOutTime</td>
                    <td>@item.MinaCamp.Hotel</td>
                    <td>@item.MinaCamp.CheckInDate</td>
                    <td>@item.MinaCamp.CheckInTime</td>
                    <td>@item.MinaCamp.CheckOutDate</td>
                    <td>@item.MinaCamp.CheckOutTime</td>
                </tr>
            }
        </tbody>
    </table>

</div>
<script>
    // Initialize DataTable
    $(document).ready(function () {
        $('#myTable').DataTable({
            dom: '<"dom_wrapper fh-fixedHeader"Bf>tip',
            buttons: [
                {
                    extend: "excel",
                    footer: true,
                    text: "Excel",
                    filename: 'TrainSummaryReport'
                },
                {
                    extend: "copy",
                    text: "Copy",
                },
                {
                    extend: "print",
                    text: "Print",
                }
            ],
            "scrollCollapse": true,
            "paging": false,
            "info": false,
            "ordering": false,
            "searching": true,
        });
    });

    document.querySelectorAll('.toggle-checkbox').forEach(function (checkbox) {
        checkbox.addEventListener('change', function () {
            var sectionClass = this.id.replace('toggle', '').toLowerCase();
            var toggleSections = document.querySelectorAll('.toggle-section.' + sectionClass);
            toggleSections.forEach(function (section) {
                if (checkbox.checked) {
                    section.classList.remove('hide');
                } else {
                    section.classList.add('hide');
                }
            });

            // Check if checkbox is for hiding Outbound or Inbound
            if (checkbox.id === 'toggleHideOB') {
                var hideOBCheckbox = document.getElementById('toggleHideOB');
                if (hideOBCheckbox.checked) {
                    document.querySelectorAll('.toggle-section.OB').forEach(function (section) {
                        section.classList.add('hide');
                    });
                } else {
                    document.querySelectorAll('.toggle-section.OB').forEach(function (section) {
                        section.classList.remove('hide');
                    });
                }
            }

            if (checkbox.id === 'toggleHideIB') {
                var hideIBCheckbox = document.getElementById('toggleHideIB');
                if (hideIBCheckbox.checked) {
                    document.querySelectorAll('.toggle-section.IB').forEach(function (section) {
                        section.classList.add('hide');
                    });
                } else {
                    document.querySelectorAll('.toggle-section.IB').forEach(function (section) {
                        section.classList.remove('hide');
                    });
                }
            }
        });
    });

    // document.getElementById('exportButton').addEventListener('click', function () {
