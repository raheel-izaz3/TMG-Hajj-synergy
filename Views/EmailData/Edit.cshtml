@model EmailData

@{
    string modelName = "EmailData";
    string modelNamePlural = "Cities";
    string modelControllerRoute = "EmailData";
    TMG.Data.TMGDbContext _db;
}


<div class="container-xxl flex-grow-1 container-p-y">
    <h4 class="fw-bold" style="color:  #404040;"><span class="text-muted fw-light"> @modelName / </span>  Edit</h4>

    <hr class="mb-4" />

    <div class="row">
        <div class="col-sm-12">
            <div class="card mb-4">
                <div class="card-body">
                    <form method="post">
                        <input type="hidden" asp-for="EmailDataId">
                        <div class="row">
                            <div class="col-sm-12 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname" asp-for="Day"></label>
                                <div class="input-group input-group-merge">
                                    <input asp-for="Day" class="form-control" />
                                </div>
                                <span class="text-danger" asp-validation-for="Day"></span>
                            </div>
                            <div class="col-sm-12 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname" asp-for="SpecificDate"></label>
                                <div class="input-group input-group-merge">
                                    <input asp-for="SpecificDate" type="date" class="form-control" />
                                </div>
                                <span class="text-danger" asp-validation-for="SpecificDate"></span>
                            </div>
                            <div class="col-sm-12 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname" asp-for="Subject"></label>
                                <div class="input-group input-group-merge">
                                    <input asp-for="Subject" class="form-control" />
                                </div>
                                <span class="text-danger" asp-validation-for="Subject"></span>
                            </div>
                            <div class="col-sm-12 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname" asp-for="Email"></label>
                                <div class="input-group input-group-merge">
                                    <textarea id="summernote" asp-for="Email"></textarea>
                                </div>
                                <span class="text-danger" asp-validation-for="Email"></span>
                            </div>
                        </div>
                        <button type="submit" class="btn btn-warning float-end">Save Changes</button>
                    </form>
                </div>
            </div>

        </div>
    </div>

</div>

<script>

    $(document).ready(function () {
        $('#summernote').summernote({
            placeholder: 'Write your content here...',
            tabsize: 2,
            height: 200
        });
    });

</script>