@model IEnumerable<EVideoFiling>
@{
    string modelName = "EVideoFiling";
    string modelNamePlural = "EVideoFilings";
    string modelControllerRoute = "EVideoFiling";
    TMG.Data.TMGDbContext _db;
}

@if (TempData.ContainsKey("created"))
{
    if ((bool)TempData["created"]! == true)
    {
        <script>
            toastr.options.closeDuration = 100;
            toastr.options.closeButton = true;
            toastr.options.positionClass = "toast-top-center";
            toastr.options.showMethod = 'slideDown';
            toastr.options.hideMethod = 'slideUp';
            toastr.options.closeMethod = 'slideUp';
            toastr.success('', '@modelName Created Successfully!', { timeOut: 2000 })
        </script>
        TempData["created"] = false;
    }
}
@if (TempData.ContainsKey("deleted"))
{
    if ((bool)TempData["deleted"]! == true)
    {
        <script>
            toastr.options.closeDuration = 100;
            toastr.options.closeButton = true;
            toastr.options.positionClass = "toast-top-center";
            toastr.options.showMethod = 'slideDown';
            toastr.options.hideMethod = 'slideUp';
            toastr.options.closeMethod = 'slideUp';
            toastr.success('', '@modelName Trashed Successfully!', { timeOut: 2000 })
        </script>
        TempData["deleted"] = false;
    }
}
@if (TempData.ContainsKey("updated"))
{
    if ((bool)TempData["updated"]! == true)
    {
        <script>
            toastr.options.closeDuration = 100;
            toastr.options.closeButton = true;
            toastr.options.positionClass = "toast-top-center";
            toastr.options.showMethod = 'slideDown';
            toastr.options.hideMethod = 'slideUp';
            toastr.options.closeMethod = 'slideUp';
            toastr.success('', '@modelName Updated Successfully!', { timeOut: 2000 })
        </script>
        TempData["updated"] = false;
    }
}

<div class="container-xxl flex-grow-1 container-p-y">
    <h4 class="fw-bold"><span class="text-muted fw-light"></span> @modelNamePlural</h4>

    <hr class="mb-4" />

    @* @if (ViewBag.CreateAllowed == true)
    { *@
        <a asp-action="Create" class="btn btn-info">Create New</a>
    @* }
    @if (ViewBag.RestoreAllowed == true)
    { *@
        <a asp-action="ViewTrash" class="btn btn-info float-end"><i class="bx bx-trash me-1"></i> Trash (@ViewBag.TrashCount)</a>
    @* } *@

    <br />
    <br />
    <div class="card p-2">
        <div class="table-responsive text-nowrap ">
            <div id="dataGridContainer"></div>
        </div>
    </div>
</div>
<script>

    $(function () {
        var dataSource = @Html.Raw(Json.Serialize(Model));
        console.log(dataSource);

        $("#dataGridContainer").dxDataGrid({
            dataSource: dataSource,
            columns: [
                { dataField: "eVideoFilingId", caption: "#", width: 50 },
                { dataField: "name", caption: "Name" },
                {
                    dataField: "video",
                    caption: "EFiling",
                    cellTemplate: function (container, options) {
                        $("<a>", {
                            "href": options.value,
                            "target": "_blank"
                        }).text("View " + options.data.documentType).appendTo(container);
                    }
                },
                { dataField: "mediaDocument.name", caption: "Department" },
                {
                    type: "buttons",
                    buttons: [
                        {
                            text: "Send",
                            hint: "Send",
                            cssClass: "btn btn-success text-decoration-none text-lightest",
                            onClick: function (e) {
                                location.href = `/@modelControllerRoute/Email/${e.row.data.eVideoFilingId}`;
                            }
                        },
                        {
                            text: "Edit",
                            hint: "Edit",
                            cssClass: "btn btn-warning text-decoration-none text-lightest",
                            onClick: function (e) {
                                location.href = `/@modelControllerRoute/Edit/${e.row.data.eVideoFilingId}`;
                            }
                        },
                        {
                            text: "Trash",
                            hint: "Trash",
                            cssClass: "btn btn-danger text-decoration-none text-lightest",
                            onClick: function (e) {
                                confirmDelete(e.row.data.eVideoFilingId);
                            }
                        }
                    ]
                }
            ],
            paging: {
                pageSize: 50
            },
            pager: {
                showPageSizeSelector: true,
                allowedPageSizes: [10, 25, 50, 100],
                showInfo: true
            },
            filterRow: {
                visible: true
            },
            headerFilter: {
                visible: true
            },
            scrolling: {
                mode: "virtual",
                showScrollbar: "always"
            },
        });
    });


    function confirmDelete(id) {
        let del = confirm("Are you sure?")
        if (del) {
            location.href = `/@modelControllerRoute/Trash/${id}`;
        }
    }

    let table = new DataTable('#table', {
    });

</script>

