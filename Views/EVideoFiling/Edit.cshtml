@model EVideoFiling

@{
    string modelName = "EVideoFiling";
    string modelNamePlural = "EVideoFilings";
    string modelControllerRoute = "EVideoFiling";
    TMG.Data.TMGDbContext _db;
}


<div class="container-xxl flex-grow-1 container-p-y">
    <h4 class="fw-bold" style="color:  #404040;"><span class="text-muted fw-light"> @modelName / </span>  Edit</h4>

    <hr class="mb-4" />

    <div class="row">
        <div class="col-sm-12">
            <div class="card mb-4">
                <div class="card-body">
                    <form method="post" enctype="multipart/form-data">
                        <input type="hidden" asp-for="EVideoFilingId" />
                        <div class="row">
                            <div class="col-sm-12 col-md-3 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname" asp-for="Name"></label>
                                <div class="input-group input-group-merge">
                                    <span id="basic-icon-default-fullname2" class="input-group-text"><i class="bx bx-building"></i></span>
                                    <input asp-for="Name" class="form-control">
                                </div>
                                <span class="text-danger" asp-validation-for="Name"></span>
                            </div>
                            <div class="col-sm-12 col-md-3 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname">Upload Video</label>
                                <div class="input-group input-group-merge">
                                    <span id="basic-icon-default-fullname2" class="input-group-text"><i class="bx bx-building"></i></span>
                                    <input type="file" name="videoFile" class="form-control" />
                                </div>
                            </div>
                            <div class="col-sm-12 col-md-3 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname">File Type</label>
                                <div class="input-group input-group-merge">
                                    <select asp-for="DocumentType" class="form-control">
                                        @if (Model.DocumentType == "Video")
                                        {
                                            <option value="Video" selected>Video</option>
                                            <option value="PDF">PDF</option>
                                            <option value="Image">Image</option>
                                        }
                                        else if (Model.DocumentType == "PDF")
                                        {
                                            <option value="Video">Video</option>
                                            <option value="PDF" selected>PDF</option>
                                            <option value="Image">Image</option>
                                        }
                                        else
                                        {
                                            <option value="Video">Video</option>
                                            <option value="PDF">PDF</option>
                                            <option value="Image" selected>Image</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="col-sm-12 col-md-3 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname">Department</label>
                                <div class="input-group input-group-merge">
                                    <select asp-for="MediaDocumentId" class="form-control">
                                        @foreach (MediaDocument media in ViewBag.Media)
                                        {
                                            @if (media.MediaDocumentId == Model.MediaDocumentId)
                                            {
                                                <option value="@media.MediaDocumentId" selected>@media.Name</option>

                                            }
                                            else
                                            {
                                                <option value="@media.MediaDocumentId">@media.Name</option>
                                            }
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="col-sm-12 mt-4">
                                <button type="submit" class="btn btn-success float-end">Save Changes</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>

</div>