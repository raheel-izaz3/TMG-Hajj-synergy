@{
    string modelName = "Family ROE Request";
    string modelNamePlural = "Family ROE Requests";
    string modelControllerRoute = "RoeRequest";
}

@if (TempData.ContainsKey("created"))
{
    if ((bool)TempData["created"]! == true)
    {
        <script>
            toastr.options.closeDuration = 100;
            toastr.options.closeButton = true;
            toastr.options.positionClass = "toast-top-center";
            toastr.options.showMethod = 'slideDown';
            toastr.options.hideMethod = 'slideUp';
            toastr.options.closeMethod = 'slideUp';
            toastr.success('', '@modelName Created Successfully!', { timeOut: 2000 })
        </script>
        TempData["created"] = false;
    }
}
@if (TempData.ContainsKey("deleted"))
{
    if ((bool)TempData["deleted"]! == true)
    {
        <script>
            toastr.options.closeDuration = 100;
            toastr.options.closeButton = true;
            toastr.options.positionClass = "toast-top-center";
            toastr.options.showMethod = 'slideDown';
            toastr.options.hideMethod = 'slideUp';
            toastr.options.closeMethod = 'slideUp';
            toastr.success('', '@modelName Trashed Successfully!', { timeOut: 2000 })
        </script>
        TempData["deleted"] = false;
    }
}
@if (TempData.ContainsKey("updated"))
{
    if ((bool)TempData["updated"]! == true)
    {
        <script>
            toastr.options.closeDuration = 100;
            toastr.options.closeButton = true;
            toastr.options.positionClass = "toast-top-center";
            toastr.options.showMethod = 'slideDown';
            toastr.options.hideMethod = 'slideUp';
            toastr.options.closeMethod = 'slideUp';
            toastr.success('', '@modelName Updated Successfully!', { timeOut: 2000 })
        </script>
        TempData["updated"] = false;
    }
}

<div class="container-xxl flex-grow-1 container-p-y">
    <h4 class="fw-bold"><span class="text-muted fw-light"></span> @modelNamePlural</h4>

    <hr class="mb-4" />
        <a asp-action="Create" class="btn btn-info">Create New</a>
         <a asp-action="ViewTrash" class="btn btn-info float-end"><i class="bx bx-trash me-1"></i> Trash (@ViewBag.TrashCount)</a>
    
    <br />
    <br />
    <div class="card p-2">
        <div class="table-responsive text-nowrap ">
            <table class="table table-hover" id="table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Family Head</th>                        
                        <th>Currency</th>
                        <th>PKRROE</th>      
                        <th>SARROE</th>      
                        <th>USDROE</th>                        
                        <th>Created By</th>
                        <th>Status</th>                      
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody class="table-border-bottom-1">
                    @{
                        int i = 0;
                    }
                    @*     @if (Model.Count() == 0)
                    {
                    <tr>
                    <td colspan="6" class="text-danger text-center">No Data Found!</td>
                    </tr>
                    } *@
                    @foreach (var roe in  ViewBag.RoeRequest)
                    {
                        i++;
                        <tr>
                            <td>
                                <i class="fab fa-bootstrap fa-lg text-primary me-3"></i> <strong>@roe.RoeRequest.RoeRequestId</strong>
                            </td>
                            <td>@roe.RoeRequest.FamilyHead.GivenName</td>                               
                            <td>@roe.RoeRequest.Currency</td>
                            <td>@roe.RoeRequest.PKRROE</td>
                            <td>@roe.RoeRequest.SARROE</td>
                            <td>@roe.RoeRequest.USDROE</td>                 
                            <td>@roe.User.Username</td>
                            <td>@roe.RoeRequest.Status</td>
                            <td>
                                <div class="dropdown">      
                                    @if(@roe.RoeRequest.Status == 0){

                                            <button onclick="statusApproved(@roe.RoeRequest.RoeRequestId)" class="btn btn-outline-success"><i class="bx bx-trash me-1"></i> Approved</button> 
                                            <button onclick="statusReject(@roe.RoeRequest.RoeRequestId)" class="btn btn-outline-danger"><i class="bx bx-trash me-1"></i> Reject</button>      
                                        
                                    }                    
                                    <a class="btn btn-warning" asp-action="Edit" asp-route-id="@roe.RoeRequest.RoeRequestId"><i class="bx bx-edit-alt me-1"></i> Edit</a>  
                                    <button onclick="confirmDelete(@roe.RoeRequest.RoeRequestId)" class="btn btn-outline-danger"><i class="bx bx-trash me-1"></i> Trash</button>                                    
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
<script>
    function confirmDelete(id) {
        let del = confirm("Are you sure?")
        if (del) {
            location.href = `/@modelControllerRoute/Trash/${id}`;
        }
    }

    function statusApproved(id) {
        let del = confirm("Are you sure?")
        if (del) {
            location.href = `/@modelControllerRoute/Approved/${id}`;
        }
    }

    function statusReject(id) {
        let del = confirm("Are you sure?")
        if (del) {
            location.href = `/@modelControllerRoute/Reject/${id}`;
        }
    }

    let table = new DataTable('#table', {
    });
    
</script>

