@model Airline


@{
    string modelName = "Airline";
    string modelNamePlural = "Airlines";
    string modelControllerRoute = "Airline";
    TMG.Data.TMGDbContext _db;
}


<div class="container-xxl flex-grow-1 container-p-y">
    <h4 class="fw-bold" style="color:  #404040;"><span class="text-muted fw-light"> @modelName / </span> Create</h4>

    <hr class="mb-4" />

    <div class="row">
        <div class="col-sm-12">
            <div class="card mb-4">
                <div class="card-body">
                    <form method="post" asp-action="Create" method="post" enctype="multipart/form-data">
                        <div class="row">
                            <div class="col-sm-12 col-md-6 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname" asp-for="Name"></label>
                                <div class="input-group input-group-merge">
                                    <span id="basic-icon-default-fullname2" class="input-group-text"><i class="bx bx-cog"></i></span>
                                    <input asp-for="Name" class="form-control" id="basic-icon-default-fullname">
                                </div>
                                <span class="text-danger" asp-validation-for="Name"></span>
                            </div>
                            <div class="col-sm-12 col-md-6 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname" asp-for="Code"></label>
                                <div class="input-group input-group-merge">
                                    <input asp-for="Code" class="form-control" id="basic-icon-default-fullname">
                                </div>
                                <span class="text-danger" asp-validation-for="Code"></span>
                            </div>
                            <div class="col-sm-12 col-md-6 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname" asp-for="IATACode"></label>
                                <div class="input-group input-group-merge">
                                    <span id="basic-icon-default-fullname2" class="input-group-text"><i class="bx bx-cog"></i></span>
                                    <input asp-for="IATACode" class="form-control" id="basic-icon-default-fullname">
                                </div>
                                <span class="text-danger" asp-validation-for="IATACode"></span>
                            </div>
                            <div class="col-sm-12 col-md-6 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname" asp-for="ICAOCode"></label>
                                <div class="input-group input-group-merge">
                                    <span id="basic-icon-default-fullname2" class="input-group-text"><i class="bx bx-cog"></i></span>
                                    <input asp-for="ICAOCode" class="form-control" id="basic-icon-default-fullname">
                                </div>
                                <span class="text-danger" asp-validation-for="ICAOCode"></span>
                            </div>

                            <div class="col-sm-12 col-md-6 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname" asp-for="Country"></label>
                                <div class="input-group input-group-merge">
                                    <span id="basic-icon-default-fullname2" class="input-group-text"><i class="bx bx-cog"></i></span>
                                    <input asp-for="Country" class="form-control" id="basic-icon-default-fullname">
                                </div>
                                <span class="text-danger" asp-validation-for="Country"></span>
                            </div>
                            <div class="col-sm-12 col-md-6 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname" asp-for="CallSign"></label>
                                <div class="input-group input-group-merge">
                                    <span id="basic-icon-default-fullname2" class="input-group-text"><i class="bx bx-cog"></i></span>
                                    <input asp-for="CallSign" class="form-control" id="basic-icon-default-fullname">
                                </div>
                                <span class="text-danger" asp-validation-for="CallSign"></span>
                            </div>
                            <div class="col-sm-12 col-md-6 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname" asp-for="AirlineLogoPic"></label>
                                <div class="input-group input-group-merge">
                                    <span id="basic-icon-default-fullname2" class="input-group-text"><i class="bx bx-cog"></i></span>
                                    <input asp-for="AirlineLogoPic" type="file" class="form-control" id="basic-icon-default-fullname">
                                </div>
                                <span class="text-danger" asp-validation-for="AirlineLogoPic"></span>
                            </div>
                            <div class="col-sm-12 col-md-6 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname" asp-for="FFNumber"></label>
                                <div class="input-group input-group-merge">
                                    <span id="basic-icon-default-fullname2" class="input-group-text"><i class="bx bx-cog"></i></span>
                                    <input asp-for="FFNumber" class="form-control" id="basic-icon-default-fullname">
                                </div>
                                <span class="text-danger" asp-validation-for="FFNumber"></span>
                            </div>
                            <div class="col-sm-12 mb-3">
                                <button type="submit" class="btn btn-success float-end">Create</button>
                            </div>

                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>

</div>