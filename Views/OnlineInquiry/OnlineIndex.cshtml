@model IEnumerable<CustomerPortfolioViewModel>

@{
	string modelName = "Family Head";
	string modelNamePlural = "Family Heads";
	string modelControllerRoute = "FamilyHead";
}


<style>
	#congratulations-dropdown:hover .dropdown-menu {
		display: block;
	}

	.dx-pager {
		display: block !important;
	}
</style>
@if (TempData.ContainsKey("created"))
{
	if ((bool)TempData["created"]! == true)
	{
		<script>
			toastr.options.closeDuration = 100;
			toastr.options.closeButton = true;
			toastr.options.positionClass = "toast-top-center";
			toastr.options.showMethod = 'slideDown';
			toastr.options.hideMethod = 'slideUp';
			toastr.options.closeMethod = 'slideUp';
			toastr.success('', '@modelName Created Successfully!', { timeOut: 2000 })
		</script>
		TempData["created"] = false;
	}
}
@if (TempData.ContainsKey("deleted"))
{
	if ((bool)TempData["deleted"]! == true)
	{
		<script>
			toastr.options.closeDuration = 100;
			toastr.options.closeButton = true;
			toastr.options.positionClass = "toast-top-center";
			toastr.options.showMethod = 'slideDown';
			toastr.options.hideMethod = 'slideUp';
			toastr.options.closeMethod = 'slideUp';
			toastr.success('', '@modelName Trashed Successfully!', { timeOut: 2000 })
		</script>
		TempData["deleted"] = false;
	}
}
@if (TempData.ContainsKey("updated"))
{
	if ((bool)TempData["updated"]! == true)
	{
		<script>
			toastr.options.closeDuration = 100;
			toastr.options.closeButton = true;
			toastr.options.positionClass = "toast-top-center";
			toastr.options.showMethod = 'slideDown';
			toastr.options.hideMethod = 'slideUp';
			toastr.options.closeMethod = 'slideUp';
			toastr.success('', '@modelName Updated Successfully!', { timeOut: 2000 })
		</script>
		TempData["updated"] = false;
	}
}

<style>
	.tooltip {
		position: fixed;
		top: 10px;
		left: 50%;
		transform: translateX(-50%);
		background-color: rgba(0, 0, 0, 0.8);
		color: #fff;
		padding: 10px 20px;
		border-radius: 5px;
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.3s ease;
	}

		.tooltip.show {
			opacity: 1;
		}
</style>

<div class="container-xxl flex-grow-1 container-p-y">
	<hr class="mb-4" />

	<a asp-action="Inquiry" class="mx-2 btn btn-info">Online Inquiry Form</a>
	<a asp-action="ViewTrash" class="btn btn-info float-end">
		<i class="bx bx-trash me-1"></i> Trash
		(@ViewBag.TrashCount)
	</a>
	
	<br />
	<br />
	<div class="card p-2">
		<div class="table-responsive text-nowrap ">
			@* <button id="downloadPdfButton" class="btn btn-primary">Download PDF</button> *@
			<div id="dataGridContainer"></div>
		</div>
	</div>
</div>

<script src="https://cdn3.devexpress.com/jslib/22.2.3/js/jquery.min.js"></script>
<script src="https://cdn3.devexpress.com/jslib/22.2.3/js/jszip.min.js"></script>

<script>

	$(function () {
		var numbers = @Html.Raw(Json.Serialize(ViewBag.Numbers));
		var membersCount = @Html.Raw(Json.Serialize(ViewBag.MembersCount));
		var applicantTypeNames = @Html.Raw(Json.Serialize(ViewBag.ApplicantTypeNames));
		var dataSource = @Html.Raw(Json.Serialize(Model));
		console.log(dataSource);

		var store = new DevExpress.data.ArrayStore({
			data: dataSource.map(function (item) {
				return {
					...item,
					number: numbers[item.customerPortfolioId] || "-",
					pax: membersCount[item.customerPortfolioId] || 0
				};
			})
		});

		$("#dataGridContainer").dxDataGrid({
			dataSource: store,
			keyExpr: "customerPortfolioId",
			showBorders: true,
			columnAutoWidth: true,
			paging: {
				pageSize: 10,
			},
			filterRow: {
				visible: true
			},
			headerFilter: {
				visible: true
			},
			scrolling: {
				mode: "virtual",
				showScrollbar: "always"
			},
			searchPanel: {
				visible: true,
				width: 240,
				placeholder: "Search..."
			},
			columns: [
				{ dataField: "serialNumber", caption: "#", width: 50 },
				{ dataField: "fullName", caption: "Family Head Name" },
				{ dataField: "contact", caption: "Number" },
				{ dataField: "email", caption: "Email" },
				{ dataField: "dateOfInquiry", caption: "Date Of Inquiry" },
				{ dataField: "package", caption: "Package" },
				{ dataField: "department", caption: "Department" },
				{
					type: "buttons",
					buttons: [
						{
							text: "Trash",
							hint: "Trash",
							cssClass: "btn btn-danger text-decoration-none text-lightest",
							onClick: function (e) {
								confirmDelete(e.row.data.customerPortfolioId);
							}
						},
					]
				}
			]
		});

		$("#downloadPdfButton").on("click", function () {
			const { jsPDF } = window.jspdf;
			const doc = new jsPDF("landscape");

			const grid = $("#dataGridContainer").dxDataGrid("instance");

			const dataSource = grid.getDataSource();
			const combinedFilter = grid.getCombinedFilter();

			dataSource.store().load({ filter: combinedFilter }).then(filteredData => {
				doc.setFontSize(10);
				doc.text("Enquiry Data", 10, 10);

				const tableData = [];
				filteredData.forEach(row => {
					const rowData = [
						row.serialNumber,
						row.feedby,
						row.spoName || "-",
						row.fullName,
						formatDate(row.dateOfQuery),
						row.customerStatus || "-",
						row.customerRemarks || "-",
						row.hajjDepartmentName || "-",
						row.cityName || "-",
						(row.applicantType ? applicantTypeNames[row.applicantType] : "-"),
						emails[row.customerPortfolioId] || "-",
						numbers[row.customerPortfolioId] || "-",
						membersCount[row.customerPortfolioId] || 0
					];
					tableData.push(rowData);
				});

				const headers = [
					"#", "Feed By", "SPO", "Family Head", "Date of Query",
					"Status", "Remarks", "Hajj Department", "City", "Applicant Type",
					"Email", "Number", "PAX"
				];

				const columnStyles = {
					0: { cellWidth: 10 },
					1: { cellWidth: 20 },
					2: { cellWidth: 20 },
					3: { cellWidth: 23 },
					4: { cellWidth: 25 },
					5: { cellWidth: 15 },
					6: { cellWidth: 25 },
					7: { cellWidth: 20 },
					8: { cellWidth: 28 },
					9: { cellWidth: 25 },
					10: { cellWidth: 20 },
					11: { cellWidth: 20 },
					12: { cellWidth: 17 },
				};

				doc.autoTable({
					head: [headers],
					body: tableData,
					startY: 30,
					theme: 'striped',
					columnStyles: columnStyles,
				});

				doc.save("EnquiryData.pdf");
			});
		});
	});

	function formatDate(date) {
		if (!date) return "-";
		const d = new Date(date);
		const options = { year: 'numeric', month: 'short', day: '2-digit' };
		return d.toLocaleDateString('en-GB', options);
	}

	function confirmDelete(id) {
		let del = confirm("Are you sure?")
		if (del) {
			location.href = `/OnlineInquiry/Trash/${id}`;
		}
	}

	function copyHref(event, link) {
		event.preventDefault();
		var href = link.href;

		var tempInput = document.createElement('input');
		tempInput.setAttribute('value', href);
		document.body.appendChild(tempInput);

		tempInput.select();
		tempInput.setSelectionRange(0, 99999); // For mobile devices

		document.execCommand('copy');

		document.body.removeChild(tempInput);

		var tooltip = document.getElementById('tooltip');
		tooltip.classList.add('show');
		setTimeout(function () {
			tooltip.classList.remove('show');
		}, 2000); // Hide tooltip after 2 seconds
	}

	$(document).ready(function () {
		$('#congratulations-dropdown').hover(function () {
			$(this).find('.dropdown-toggle').dropdown('toggle');
		});
	});

	let tablee = new DataTable('#table', {
		dom: 'Bfrtip',
		buttons: [{
			text: 'Export to Excel',
			extend: 'excelHtml5',
			className: 'btn btn-dark',
			exportOptions: {
				columns: ':visible'
			}
		}],
		paging: true,
		pageLength: 50,
		order: [0, 'desc']
	});

</script>