@{
    ViewData["Title"] = "ChangeRemarks";
}

<div class="container-xxl flex-grow-1 container-p-y">
    <div class="card">
        <div class="row">
            <form method="post">
                <input type="hidden" value="@ViewBag.Id" id="CustomerPortfolioId" />
                <div class="col-md-12 col-sm-12 p-5">
                    <label class="form-label">Remarks</label>
                    <input class="form-control" type="text" id="Remarks" />
                </div>
                <div class="col-sm-12 p-4">
                    <button type="submit" class="btn btn-warning float-end" id="saveRemarksButton">Save</button>
                    <a asp-action="IndexCustomerProfile" class="btn btn-success">Back</a>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        $("#saveRemarksButton").on("click", function () {
            var id = $("#CustomerPortfolioId").val();

            var passportData = {
                Remarks: $("#Remarks").val(),
            };

            $.ajax({
                url: '/CustomerPortfolioForm/SaveRemarks',
                type: 'POST',
                data: $.extend({ id: id }, passportData),
                success: function (response) {
                    console.log(response);
                    if (response.status === 200) {
                        alert("Remarks saved successfully!");
                        window.location.reload();
                    } else {
                        alert("Error: " + response.msg);
                    }
                },
                error: function (xhr, status, error) {
                    alert("An error occurred: " + xhr.responseText);
                }
            });
        });
    });
</script>
