@{
    string modelName = "Chart Of Account";
    string modelNamePlural = "Chart Of Accounts";
}

@{
    var companies = ViewBag.Company as IEnumerable<Company>;
}

<div class="container-xxl flex-grow-1 container-p-y">
    <h4 class="fw-bold" style="color:  #404040;"><span class="text-muted fw-light"></span> @modelNamePlural</h4>
    <hr class="mb-4" />

    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-12">
                            <label for="companyId">Select Company</label>
                            <div class="input-group input-group-merge">
                                <select class="form-select" id="companyId">
                                    <option value="">Select Company...</option>
                                    @foreach (var currentCompany in companies)
                                    {
                                        <option value="@currentCompany.CompanyId">@currentCompany.CompanyName</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div class="col-md-12">
                            <button type="button" class="btn btn-primary" onclick="getCOA()">Filter</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Table to display Chart of Accounts -->
    <div class="row mt-5">
        <div class="col-md-12">
            <div class="card p-3">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Account Name</th>
                        </tr>
                    </thead>
                    <tbody id="tbody"></tbody>
                </table>
            </div>
        </div>
    </div>
</div>


<script>
    function getCOA() {
        var companyId = $("#companyId").val();
        if (companyId) {
            $.ajax({
                url: "/COA/GetCOA/",
                data: { companyId: companyId },
                method: "GET",
                success: res => {
                    console.log("Response Data:", res);
                    let html = ``;

                    for (let type of res.accTypes) {
                        html += `<tr><td>${type.accountTypeId} - <span style="font-weight: bolder;">${type.name}</span></td></tr>`;

                        for (let group of res.accGroups) {
                            if (group.accountTypesId === type.accountTypeId) {
                                html += `<tr><td>${type.accountTypeId} - ${group.accountGroupId} - <span style="font-weight: 700;">${group.name}</span></td></tr>`;

                                for (let subGroup of res.accSubGroups) {
                                    if (group.accountGroupId === subGroup.accountGroupId) {
                                        html += `<tr><td>${type.accountTypeId} - ${group.accountGroupId} - ${subGroup.categoryId} - <span style="font-weight: 600;">${subGroup.name}</span></td></tr>`;

                                        for (let account of res.accounts) {
                                            console.log("Checking account:", account, "against subGroup:", subGroup);
                                            if (account.categoryId === subGroup.categoryId) {
                                                console.log("Account matches:", account);
                                                html += `<tr><td>${type.accountTypeId} - ${group.accountGroupId} - ${subGroup.categoryId} - ${account.accountsId} - <span style="font-weight: 600;">${account.name}</span></td></tr>`;
                                            }
                                            if (account.accountGroupId === group.accountGroupId) {
                                                console.log("Account matches:", account);
                                                html += `<tr><td>${type.accountTypeId} - ${group.accountGroupId} - ${account.accountsId} - <span style="font-weight: 600;">${account.name}</span></td></tr>`;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    if (!html) {
                        html = "<tr><td colspan='4' class='text-center'>No records found</td></tr>";
                    }

                    $("#tbody").html(html);
                },
                error: err => {
                    console.error(err);
                    alert('Error fetching data.');
                }
            });
        } else {
            alert("Please select a company.");
        }
    }
</script>

