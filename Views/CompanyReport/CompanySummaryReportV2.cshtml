<body>

    <div id="@Model.PackageId" class="package-div" style="display: none;">
        <div class="big-table-record" id="summaryData">
            <div id="gridWrapper" style="margin-top: 20px;"></div>
        </div>

    </div>
</body>


<script>

    $(function () {
        const dataSource = @Html.Raw(Json.Serialize(Model.FamilyMembers));

        const uniqueCurrencies = [...new Set(dataSource.map(item => item.baseCurrency))];

        uniqueCurrencies.forEach(currency => {
            const filteredData = dataSource.filter(item => item.baseCurrency === currency);

            const gridId = `gridContainer-${currency}`;
            $("#gridWrapper").append(`<h3>${currency}</h3><div id="${gridId}" class="mb-4"></div>`);

            $(`#${gridId}`).dxDataGrid({
                dataSource: filteredData,
                columns: [
                    { dataField: "companyCode", caption: "Company Code" },
                    { dataField: "packageName", caption: "Package Name" },
                    { dataField: "group", caption: "Group #" },
                    { dataField: "spoName", caption: "SPO" },
                    { dataField: "fid", caption: "HB #" },
                    { dataField: "headName", caption: "Family Head Name" },
                    { dataField: "pax", caption: "Pax", dataType: "number" },
                    { dataField: "baseCurrency", caption: "Base Currency" },
                    { dataField: "basicPackageAmount", caption: "Basic Package", dataType: "number", format: "fixedPoint" },
                    { dataField: "roomsAmount", caption: "Room Amount", dataType: "number", format: "fixedPoint" },
                    { dataField: "ticketAmount", caption: "Flight Ticket Amount", dataType: "number", format: "fixedPoint" },
                    { dataField: "trainTicketAmount", caption: "Train Ticket Amount", dataType: "number", format: "fixedPoint" },
                    { dataField: "additionalTransportAmount", caption: "Additional Transport Amount", dataType: "number", format: "fixedPoint" },
                    { dataField: "eiadfAmount", caption: "EI-ADF Amount", dataType: "number", format: "fixedPoint" },
                    { dataField: "discountAmount", caption: "General Discount", dataType: "number", format: "fixedPoint" },
                    { dataField: "packageAmount", caption: "Total Package", dataType: "number", format: "fixedPoint" },
                    { dataField: "receivedAmountTotal", caption: "Total Received Amount", dataType: "number", format: "fixedPoint" },
                    { dataField: "finalBalanceReceivable", caption: "Final Balance Receivable", dataType: "number", format: "fixedPoint" },
                    {
                        dataField: "receivedAmountPercent",
                        caption: "Received Amount %",
                        dataType: "string",
                        format: {
                            type: "fixedPoint",
                            precision: 2,
                            useGrouping: false
                        },
                        customizeText: function (data) {
                            return parseFloat(data.value).toFixed(2);
                        }
                    },
                    { dataField: "category", caption: "Category" }
                ],
                columnAutoWidth: true,
                showBorders: true,
                hoverStateEnabled: true,
                showColumnHeaders: true,
                paging: {
                    pageSize: 50
                },
                pager: {
                    showPageSizeSelector: true,
                    allowedPageSizes: [10, 25, 50, 100],
                    showInfo: true
                },
                filterRow: {
                    visible: true
                },
                headerFilter: {
                    visible: true
                },
                scrolling: {
                    mode: "virtual",
                    showScrollbar: "always"
                },
                summary: {
                    totalItems: [
                        { column: "pax", summaryType: "sum", displayFormat: "Total Pax: {0}", valueFormat: "fixedPoint", showInColumn: "pax", skipEmptyValues: false },
                        { column: "basicPackageAmount", summaryType: "sum", displayFormat: "Total Basic Package: {0}", valueFormat: "fixedPoint", showInColumn: "basicPackageAmount", skipEmptyValues: false },
                        { column: "roomsAmount", summaryType: "sum", displayFormat: "Total Room Amount: {0}", valueFormat: "fixedPoint", showInColumn: "roomsAmount", skipEmptyValues: false },
                        { column: "ticketAmount", summaryType: "sum", displayFormat: "Total Flight Ticket: {0}", valueFormat: "fixedPoint", showInColumn: "ticketAmount", skipEmptyValues: false },
                        { column: "trainTicketAmount", summaryType: "sum", displayFormat: "Total Train Ticket: {0}", valueFormat: "fixedPoint", showInColumn: "trainTicketAmount", skipEmptyValues: false },
                        { column: "additionalTransportAmount", summaryType: "sum", displayFormat: "Total Additional Transport: {0}", valueFormat: "fixedPoint", showInColumn: "additionalTransportAmount", skipEmptyValues: false },
                        { column: "eiadfAmount", summaryType: "sum", displayFormat: "Total EI-ADF: {0}", valueFormat: "fixedPoint", showInColumn: "eiadfAmount", skipEmptyValues: false },
                        { column: "discountAmount", summaryType: "sum", displayFormat: "Total Discount: {0}", valueFormat: "fixedPoint", showInColumn: "discountAmount", skipEmptyValues: false },
                        { column: "packageAmount", summaryType: "sum", displayFormat: "Grand Total Package: {0}", valueFormat: "fixedPoint", showInColumn: "packageAmount", skipEmptyValues: false },
                        { column: "receivedAmountTotal", summaryType: "sum", displayFormat: "Total Received: {0}", valueFormat: "fixedPoint", showInColumn: "receivedAmountTotal", skipEmptyValues: false },
                        { column: "finalBalanceReceivable", summaryType: "sum", displayFormat: "Total Final Balance: {0}", valueFormat: "fixedPoint", showInColumn: "finalBalanceReceivable", skipEmptyValues: false }
                    ]
                },
                export: {
                    enabled: true,
                    fileName: `FamilyMembers_${currency}`,
                    allowExportSelectedData: true
                }
            });
        });
    });


    window.onload = function () {
        SelectPackage('All');
    };
    function SelectPackage(packageId) {
        var packageDivs = document.querySelectorAll('.package-div');

        if (packageId === 'All') {
            for (var i = 0; i < packageDivs.length; i++) {
                packageDivs[i].style.display = 'block';
            }
        } else {
            for (var i = 0; i < packageDivs.length; i++) {
                var div = packageDivs[i];
                if (div.id === packageId) {
                    div.style.display = 'block';
                } else {
                    div.style.display = 'none';
                }
            }
        }
    }

    $(document).ready(function () {
        $('.package-div table').each(function () {
            $(this).DataTable({
                dom: '<"dom_wrapper fh-fixedHeader"Bf>tip',
                buttons: [
                    {
                        extend: "excel",
                        footer: true,
                        text: "Excel",
                    },
                ],
                // "scrollY": "200px", // Adjust height as needed
                "scrollCollapse": true,
                "paging": false,
                "info": false,
                // "sScrollY": false,
                "ordering": true,
                "initComplete": function () {
                    $('#packageSelect').on('change', function () {
                        SelectPackage(this.value);
                    });
                }
            });
        });
    });


</script>


