@model RoomListingModel

@{
    Layout = "_PrintReportLayout";
}
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<style>
    @@media print {
        .hideInPrint {
            display: none;
        }

        .chk-box {
            display: none;
        }

        @@page {
            size: A4;
            margin: .2cm;
            zoom: 80%;
        }
    }
</style>

<div class="chk-box">
    <input type="checkbox" id="toggleSrNo" onclick="toggleColumn('SrNo')"> SrNO
    <input type="checkbox" id="toggleCompany" onclick="toggleColumn('Company')"> Company
    <input type="checkbox" id="togglePackage" onclick="toggleColumn('Package')"> Package
    <input type="checkbox" id="toggleGroup" onclick="toggleColumn('Group')"> Group
    <input type="checkbox" id="toggleRoomType" onclick="toggleColumn('RoomType')"> Room Type
    <input type="checkbox" id="toggleFcId" onclick="toggleColumn('FcId')"> HB #
    <input type="checkbox" id="toggleName" onclick="toggleColumn('Name')"> Name
    <input type="checkbox" id="toggleAge" onclick="toggleColumn('Age')"> Age
    <input type="checkbox" id="toggleGender" onclick="toggleColumn('Gender')"> Gender
    <input type="checkbox" id="togglePassport" onclick="toggleColumn('Passport')"> Passport
    <input type="checkbox" id="toggleFloorNumber" onclick="toggleColumn('FloorNumber')"> Floor #
    <input type="checkbox" id="toggleRoomNumber" onclick="toggleColumn('RoomNumber')"> Room #
    <input type="checkbox" id="toggleStayWith" onclick="toggleColumn('StayWith')"> Stay With
    <input type="checkbox" id="toggleConnectedFloorNumber" onclick="toggleColumn('ConnectedFloorNumber')"> Floor #
    Connection
    <input type="checkbox" id="toggleConnectedRoomNumber" onclick="toggleColumn('ConnectedRoomNumber')"> Room #
</div>


<a asp-controller="Group" asp-action="Index" class="btn btn-primary text-white m-2 hideInPrint">Back To Dashboard</a>
<button onclick="document.memberForm.submit()" class="btn btn-success m-2 hideInPrint">Save</button>
<div class="container-fluid mt-3">

    <h5 class="text-center"><u>@Model.Company</u></h5>
    <p class="text-center mb-0 fw-bold">Report</p>

    <p class="text-center mt-1"><u>Group: @Model.Group</u></p>

    <hr class="my-3">

    <form action="/GroupReport/Save/@Model.GroupId" name="memberForm" method="post">
        <table style="width: 100%" class="table-bordered">
            <thead>
                <tr>
                    <th class="text-center" data-column="SrNo">#</th>
                    <th class="text-center" data-column="Company">Company</th>
                    <th class="text-center" data-column="Package">Package</th>
                    <th class="text-center" data-column="Group">Group</th>
                    <th class="text-center" data-column="RoomType">Room Type</th>
                    <th class="text-center" data-column="FcId">HB #</th>
                    <th class="text-center" data-column="Name">Name</th>
                    <th class="text-center" data-column="Age">Age</th>
                    <th class="text-center" data-column="Gender">Gender</th>
                    <th class="text-center" data-column="Passport">Passport</th>
                    <th class="text-center" data-column="FloorNumber">Floor #</th>
                    <th class="text-center" data-column="RoomNumber">Room #</th>
                    <th class="text-center" data-column="StayWith">Stay With</th>
                    <th class="text-center" data-column="ConnectedFloorNumber">Floor # Connection</th>
                    <th class="text-center" data-column="ConnectedRoomNumber">Room #</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Members)
                {
                    <input type="hidden" id="packageid" value="@item.PackageId" />
                    <input type="hidden" name="FamilyHeadIds[]" value="@item.FamilyHeadId">
                    <input type="hidden" name="RoomIds[]" value="@item.RoomId">
                    <tr style="border-top: @(item.IsHead ? "4px solid black" : "");">
                        <td class="text-center" data-column="SrNo">@item.SNo</td>
                        <td class="text-center" data-column="Company">@item.Company</td>
                        <td class="text-center" data-column="Package">@item.Package</td>
                        <td class="text-center" data-column="Group">@item.Group</td>
                        <td class="text-center" data-column="RoomType">@item.RoomType</td>
                        <td class="text-center" data-column="FcId">@item.FcId</td>
                        <td class="text-center" data-column="Name">@item.Name</td>
                        <td class="text-center" data-column="Age">@item.Age</td>
                        <td class="text-center" data-column="Gender">@item.Gender</td>
                        <td class="text-center" data-column="Passport">@item.Passport</td>
                        <td class="text-center" data-column="FloorNumber">
                            <select class="form-control" id="StayFloorNumbers[]" name="StayFloorNumbers[]"
                                onchange="getRooms(this.value, @item.SNo)">
                                <option value="0">Select Floor</option>
                                @if (ViewBag.floorNumber != null)
                                {
                                    @foreach (var item1 in ViewBag.floorNumber)
                                    {
                                        @if (item1 == item.FloorNumber)
                                        {
                                            <option selected value="@item1">@item1</option>
                                        }
                                        else
                                        {
                                            <option value="@item1">@item1</option>
                                        }
                                    }
                                }

                            </select>

                        </td>
                        <td class="text-center" data-column="RoomNumber">
                            <select class="form-control" id="select-room[@item.SNo]" name="StayRoomNumbers[]"
                                onchange="checkRoomPax(this)">
                                <option value="">Select a Room...</option>
                                @if (item.FloorRoomId is not null)
                                {
                                    <option selected value="@item.FloorRoomId" data-pax="@item.RoomNumberPax">
                                        @item.RoomNumberWithCode</option>
                                }
                            </select>
                        </td>
                        <td class="text-center" data-column="StayWith">
                            @item.StayWith
                        </td>
                        <td class="text-center" data-column="ConnectedFloorNumber">
                            <input style="width: 100px" type="text" name="ConnectedFloorNumbers[]"
                                value="@item.ConnectedFloorNumber">
                        </td>
                        <td class="text-center" data-column="ConnectedRoomNumber">
                            <input style="width: 100px" type="text" name="ConnectedRoomNumbers[]"
                                value="@item.ConnectedRoomNumber">
                        </td>
                    </tr>
                }

            </tbody>
        </table>
    </form>

    <h5 class="text-center mt-4"><u>Room Summary</u></h5>
    <div class="row">
        <div class="col-sm-6">
            <table class="table">
                <tr>
                    <th class="border-bottom text-center" colspan="3">
                        Total Members: @Model.MemberSummary.TotalMembers
                    </th>
                </tr>
                <tr>
                    <th class="text-center" colspan="3">Male: @Model.MemberSummary.MaleCount</th>
                </tr>
                <tr>
                    <td class="text-center">Adult: @Model.MemberSummary.AdultMales</td>
                    <td class="text-center">Child: @Model.MemberSummary.ChildMales</td>
                    <td class="text-center">Infant: @Model.MemberSummary.InfantMales</td>
                </tr>
                <tr>
                    <th class="text-center" colspan="3">Female: @Model.MemberSummary.FemaleCount</th>
                </tr>
                <tr>
                    <td class="text-center">Adult: @Model.MemberSummary.AdultFemales</td>
                    <td class="text-center">Child: @Model.MemberSummary.ChildFemales</td>
                    <td class="text-center">Infant: @Model.MemberSummary.InfantFemales</td>
                </tr>
            </table>
        </div>
        <div class="col-sm-6">
            <div class="table-responsive text-nowrap ">
                @* <button onclick="copyTableContent()" id="copyTableContent">Copy Table</button> *@
                <table class="table table-hover" id="ThridTable">
                    <thead>
                        <tr>
                            <th colspan="11">Room Calculation</th>
                        </tr>
                    </thead>
                    <tbody class="table border-bottom-1 table-hover">
                        <tr class="">
                            <th>MAKKAH</th>
                            @foreach (var item in Model.RoomCalculation.Makkah)
                            {
                                <td>@item.RoomType: @item.TotalMembers / @item.Pax = @item.Total</td>
                            }
                        </tr>
                        <tr class="">
                            <th>MEDINA</th>
                            @foreach (var item in Model.RoomCalculation.Medina)
                            {
                                <td>@item.RoomType: @item.TotalMembers / @item.Pax = @item.Total</td>
                            }
                        </tr>
                        <tr class="">
                            <th>AZIZIA</th>
                            @foreach (var item in Model.RoomCalculation.Azizia)
                            {
                                <td>@item.RoomType: @item.TotalMembers / @item.Pax = @item.Total</td>
                            }
                        </tr>
                        <tr class="">
                            <th>MASHAIR</th>
                            @foreach (var item in Model.RoomCalculation.Mashair)
                            {
                                <td>@item.RoomType: @item.TotalMembers / @item.Pax = @item.Total</td>
                            }
                        </tr>

                    </tbody>
                </table>
            </div>
        </div>

        @* <div class="col-sm-6">
        <table class="table">
        <tr>
        <th class="border-bottom text-center" colspan="3">Total Rooms</th>
        </tr>
        @foreach (var room in Model.Rooms)
        {
        <tr>
        <td><b>@room.RoomCode:</b> @room.Quantity</td>
        </tr>
        }
        </table>
        </div> *@
    </div>
</div>


<script>
    function toggleColumn(columnName) {
        const columnCells = document.querySelectorAll(`td[data-column="${columnName}"]`);
        const headerCell = document.querySelector(`th[data-column="${columnName}"]`);
        const isChecked = document.getElementById(`toggle${columnName}`).checked;

        columnCells.forEach(cell => {
            cell.style.display = isChecked ? '' : 'none';
        });

        headerCell.style.display = isChecked ? '' : 'none';
    }

    document.addEventListener('DOMContentLoaded', function () {
        const checkboxes = document.querySelectorAll('[id^="toggle"]');
        checkboxes.forEach(checkbox => {
            checkbox.checked = true;
        });
    });
</script>
<script>
    let colorMap = {};

    function getRandomLightColor() {
        let color;
        do {
            const r = Math.floor(Math.random() * 156) + 100;
            const g = Math.floor(Math.random() * 156) + 100;
            const b = Math.floor(Math.random() * 156) + 100;

            color = "#" + r.toString(16) + g.toString(16) + b.toString(16);
        } while (Object.values(colorMap).includes(color));

        return color;
    }



    function checkRoomPax(elem) {
        let roomPax = elem.selectedOptions[0].getAttribute('data-pax')
        let floorRoomId = elem.selectedOptions[0].value
        console.log(roomPax, floorRoomId)

        let allSelectedFloorRoomOptions = document.querySelectorAll(`option:checked[value="${floorRoomId}"]`)
        console.log(allSelectedFloorRoomOptions)

        if (allSelectedFloorRoomOptions.length > roomPax) {
            elem.selectedOptions[0].selected = false
            alert("Room Capacity Exceeded")

            elem.style.backgroundColor = "#fff";
            elem.style.color = "#000";
            selectedOption.style.backgroundColor = "#fff";

        }
        else {
            console.log("room left: " + (roomPax - allSelectedFloorRoomOptions.length))
            const selectedOption = elem.options[elem.selectedIndex];
            const optionValue = elem.value;
            let randomColor = colorMap[optionValue];
            if (!randomColor) {
                randomColor = getRandomLightColor();
                colorMap[optionValue] = randomColor;
            }

            elem.style.backgroundColor = randomColor;
            elem.style.color = "#000";
            selectedOption.style.backgroundColor = randomColor;
        }

    }

    function getRooms(val, sno) {
        if (val != '') {
            $.ajax({
                url: "/GroupReport/GetRooms",
                method: "GET",
                data: {
                    floorNumber: val,
                    hotelId: @ViewBag.HotelId
                },
                success: res => {
                    console.log(res)
                    const pack = document.getElementById('select-room[' + sno + ']');
                    let html = '<option value="">Select a Room...</option>'
                    for (let r of res) {
                        html += `<option value="${r.floorRoomId}" data-pax="${r.pax - r.count}">${r.roomInfo}</option>`
                    }
                    pack.innerHTML = html
                },
                error: err => {
                    console.log(err)
                }
            })
        }
    }
