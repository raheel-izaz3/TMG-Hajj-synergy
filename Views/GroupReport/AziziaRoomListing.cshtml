    <script>
        // increaseFontSizeBtn
        document.getElementById('increaseFontSizeBtn').addEventListener('click', function () {
            var stickerContent = document.querySelectorAll('#fontSizeBtn');
            stickerContent.forEach(function (element) {
                var currentFontSize = parseFloat(window.getComputedStyle(element).fontSize);
                element.style.fontSize = (currentFontSize + 1) + 'px';
            });
        });

        //  DecreaseFontSizeBtn
        document.getElementById('decreaseFontSizeBtn').addEventListener('click', function () {
            var stickerContent = document.querySelectorAll('#fontSizeBtn');
            stickerContent.forEach(function (element) {
                var currentFontSize = parseFloat(window.getComputedStyle(element).fontSize);
                element.style.fontSize = (currentFontSize - 1) + 'px';
            });
        });

        // rOOMS bUTTON fUNCTION
        // increaseFontSizeBtn
        document.getElementById('roomsBtnMax').addEventListener('click', function () {
            var stickerContent = document.querySelectorAll('#fontIncText1');
            stickerContent.forEach(function (element) {
                var currentFontSize = parseFloat(window.getComputedStyle(element).fontSize);
                element.style.fontSize = (currentFontSize + 1) + 'px';
            });
        });

        //  DecreaseFontSizeBtn
        document.getElementById('roomsBtnMin').addEventListener('click', function () {
            var stickerContent = document.querySelectorAll('#fontIncText1');
            stickerContent.forEach(function (element) {
                var currentFontSize = parseFloat(window.getComputedStyle(element).fontSize);
                element.style.fontSize = (currentFontSize - 1) + 'px';
            });
        });
        // Function to save content as PDF
        function saveAsPDF() {
            var excludeElements = ['.save', '.print', '#table_filter', '#roomsBtnMin', '#roomsBtnMax', '#decreaseFontSizeBtn', '#increaseFontSizeBtn']; // Add selectors for elements to exclude
            var element = document.body.cloneNode(true); // Clone the body element

            excludeElements.forEach(function (selector) {
                var elements = element.querySelectorAll(selector);
                elements.forEach(function (el) {
                    el.parentNode.removeChild(el);
                });
            });

            var opt = {
                margin: 0.5,
                filename: 'report.pdf',
                image: { type: 'jpeg', quality: 0.98 },
                html2canvas: { scale: 2 },
                jsPDF: { unit: 'in', format: 'A4', orientation: 'portrait' }
            };

            html2pdf().from(element).set(opt).save();
        }

        document.querySelector('.save').addEventListener('click', function () {
            saveAsPDF();
        });

