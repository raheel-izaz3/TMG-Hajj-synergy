@model IEnumerable<POHotels>
@{
    string modelName = "PO - Hotel";
    string modelNamePlural = "PO - Hotel";
    string modelControllerRoute = "POHotel";
}

@if (TempData.ContainsKey("created"))
{
    if ((bool)TempData["created"]! == true)
    {
        <script>
            toastr.options.closeDuration = 100;
            toastr.options.closeButton = true;
            toastr.options.positionClass = "toast-top-center";
            toastr.options.showMethod = 'slideDown';
            toastr.options.hideMethod = 'slideUp';
            toastr.options.closeMethod = 'slideUp';
            toastr.success('', '@modelName Created Successfully!', { timeOut: 2000 })
        </script>
        TempData["created"] = false;
    }
}
@if (TempData.ContainsKey("deleted"))
{
    if ((bool)TempData["deleted"]! == true)
    {
        <script>
            toastr.options.closeDuration = 100;
            toastr.options.closeButton = true;
            toastr.options.positionClass = "toast-top-center";
            toastr.options.showMethod = 'slideDown';
            toastr.options.hideMethod = 'slideUp';
            toastr.options.closeMethod = 'slideUp';
            toastr.success('', '@modelName Trashed Successfully!', { timeOut: 2000 })
        </script>
        TempData["deleted"] = false;
    }
}
@if (TempData.ContainsKey("updated"))
{
    if ((bool)TempData["updated"]! == true)
    {
        <script>
            toastr.options.closeDuration = 100;
            toastr.options.closeButton = true;
            toastr.options.positionClass = "toast-top-center";
            toastr.options.showMethod = 'slideDown';
            toastr.options.hideMethod = 'slideUp';
            toastr.options.closeMethod = 'slideUp';
            toastr.success('', '@modelName Updated Successfully!', { timeOut: 2000 })
        </script>
        TempData["updated"] = false;
    }
}
<div class="modal fade" id="summaryModal" tabindex="-1" aria-labelledby="summaryModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="summaryModalLabel">Room Summary</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="summaryModalBody">
                <!-- Data will be loaded here -->
            </div>
        </div>
    </div>
</div>
<div class="container-xxl flex-grow-1 container-p-y">
    <h4 class="fw-bold"><span class="text-muted fw-light"></span> @modelNamePlural</h4>

    <hr class="mb-4" />


    <a asp-action="Create" class="btn btn-info">Create New</a>
    <a asp-action="ViewTrash" class="btn btn-info float-end"><i class="bx bx-trash me-1"></i> Trash (@ViewBag.Trashed)</a>
    <br />
    <br />
    <div class="card p-2">
        <div class="table-responsive text-nowrap ">
            <table class="table table-hover" id="table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Hotel</th>
                        <th>Hotel Code</th>
                        <th>Vendor</th>
                        <th>NO Of Rooms</th>
                        <th>Total</th>
                        <th>SubTotal</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody class="table-border-bottom-1">
                    @{
                        int i = 0;
                    }
                    @foreach (POHotels po in Model)
                    {
                        <tr>
                            <td>
                                <i class="fab fa-bootstrap fa-lg text-primary me-3"></i> <strong>@(++i)</strong>
                            </td>
                            <td>@po.Hotel.HotelName</td>
                            <td>@po.Code</td>
                            <td>@po.Vendor.VendorName</td>
                            <td>@po.NumberOfRooms</td>
                            <td>@po.Total</td>
                            <td>@po.SubTotal</td>
                            <td>
                                <div class="dropdown">
                                    @* <a class="btn btn-warning" asp-action="Print" asp-route-id="@po.POTicketId"><i class="bx bx-printer me-1"></i> Print</a> *@
                                    <a class="btn btn-warning" asp-action="Edit" asp-route-id="@po.POHotelsId"><i class="bx bx-printer me-1"></i> Edit</a>
                                    <button onclick="openSummary(@po.POHotelsId , @po.PlaceId)" class="btn btn-outline-danger"><i class="bx bx-trash me-1"></i> Summary</button>
                                    @* <a class="btn btn-warning" asp-action="AddPassenger" asp-route-id="@po.POTicketId"><i class="bx bx-edit-alt me-1"></i> Add</a> *@
                                    <button onclick="confirmDelete(@po.POHotelsId)" class="btn btn-outline-danger"><i class="bx bx-trash me-1"></i> Trash</button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
<script>
    function confirmDelete(id) {
        let del = confirm("Are you sure?")
        if (del) {
            location.href = `/@modelControllerRoute/Trash/${id}`;
        }
    }

    let table = new DataTable('#table', {
    });

    // Open Summary
    function openSummary(id, placeId) {
        fetch(`/@modelControllerRoute/GetSummary/${id}?placeId=${placeId}`)
            .then(response => response.text())
            .then(html => {
                document.getElementById('summaryModalBody').innerHTML = html;
                var myModal = new bootstrap.Modal(document.getElementById('summaryModal'));
                myModal.show();
            });
    }

</script>

