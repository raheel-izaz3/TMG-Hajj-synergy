<h1>Reciepts</h1>

<div class="big-table-record" id="summaryData">
    <form method="post">
        <input type="hidden" value="@ViewBag.PackageId" name="PackageId" />
        <input type="submit" value="Update" />
        <table style="width:100%" id="myTable" class="table-responsive">
            <thead>
                <tr>
                    <th>SNo</th>
                    <th>Haji Name (HB#)</th>
                    <th>Base Currency</th>
                    <th>Date</th>
                    <th>Amount Received</th>
                    <th>Collection Currency</th>
                    <th>Collection ROE</th>
                    <th>Remarks</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int i = 1;
                }
                @foreach (var item in Model)
                {
                    <tr>
                        <input type="hidden" value="@item.NewInvoiceId" name="NewInvoiceIds[]" />
                        <input type="hidden" value="@item.FamilyHeadId" name="FamilyHeadIds[]" />
                        <td>@(i++)</td>
                        <td>@item.FamilyHead.FullName (@item.FamilyHead.FcId)</td>
                        <td>
                            @* @item.FamilyHead.Currency?.CurrencyName *@
                            @* <select class="base_@item.FamilyHeadId" name="BaseCurrencyIds[]">
                                @foreach (Currency currency in ViewBag.Currencies)
                                {
                                    <!option @(currency.CurrencyId == item.FamilyHead.CurrencyId ? "selected" : "") value="@currency.CurrencyId">
                                        @currency.CurrencyName
                                    </!option>
                                }
                            </select> *@
                        </td>
                        <td>
                            <input type="date" value="@DateTimeManager.DateToHtmlFormat(@item.Date)" name="Dates[]" />
                        </td>
                        <td><input value="@item.AmountRecieved" name="Amounts[]" /></td>
                        <td>
                            <select name="CollectionCurrencyIds[]">
                                @* @foreach (Currency currency in ViewBag.Currencies)
                                {
                                    <!option @(currency.CurrencyId == item.CurrencyId ? "selected" : "") value="@currency.CurrencyId">
                                        @currency.CurrencyName
                                    </!option>
                                } *@
                            </select>
                        </td>
                        <td>
                            <input value="@item.ROE" name="ROEs[]" />
                        </td>
                        <td>
                            <input value="@item.Remarks" name="Remarks[]" />
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </form>


</div>
<script>

    // Initialize DataTable
    $(document).ready(function () {
        $('#myTable').DataTable({
            "scrollCollapse": true,
            "paging": false,
            "info": false,
            "ordering": false,
            "searching": true,
        });
    });
</script>