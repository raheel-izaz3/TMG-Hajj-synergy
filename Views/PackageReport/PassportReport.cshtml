        margin: 10px 0px;
      "
         class="card-header">
        <span>@Model.PackageName</span>
        <span style="float: right"> @Model.CompanyName</span>
    </div>
    <div class="container">
        <div class="card-body">
            <table id="datatable" class="table table-bordered">
                <thead>
                    <tr>
                        <th style="width: 10px;">Sr</th>
                        <th style="width: 100px !important;">MEGA REFFERENCE</th>
                        <th style="width: 10px; ">SPO</t>
                        <th style="width: 15px;">HB #</th>
                        <th style="width: 100px !important;">FULL-NAME</th>
                        <th style="width: 10px;">PAX</th>
                        <th style="width: 10px;">PP REC</th>
                        <th style="width: 10px;">TKN REC</th>
                        <th style="width:200px!important; ">REMARKS</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var member in Model.FamilyMembers)
                    {
                        <tr>
                            <td>@member.SrNo</td>
                            <td>@member.MegaReference</td>
                            <td>@member.SPO</td>
                            <td>@member.FCID</td>
                            <td style="@(member.IsHead ? "border-top: 1px solid black !important": "")">@member.FullName</td>
                            @if (member.IsHead)
                            {
                                <td style="@(member.IsHead ? "border-top: 1px solid black" : "")" rowspan="@member.PAX">
                                    @member.PAX
                                </td>
                            }
                            else
                            {
                                <td class="hide"></td>
                            }
                            <td>@member.PassportReceived</td>
                            <td>@member.TokenReceived</td>
                            <td>@member.TokenRemarks</td>
                        </tr>
                    }
                </tbody>
                <tfoot style="background-color: lightblue; font-weight: bold">
                    <tr >
                        <td colspan="5">Total</td>
                        <td>@Model.TotalPax</td>
                        <td>@Model.TotalPassports</td>
                        <td colspan="1">@Model.TotalTokens</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>


    <script>
        $(document).ready(function () {
            var table = $("#datatable").DataTable({
                dom: 'Bfrtip',
                buttons: ["print", "excelHtml5"],
                pageLength: 20,
                fixedHeader: true,
                paging: false,
                info: false,
                autoPrint: false
            });
        });
    </script>
</body>
