    <!-- =======  Data-Table  = Start  ========================== -->
    <div class="big-table-record" id="summaryData">
        <table style="width:100%" id="myTable" class="table-responsive">
            <div style="display: flex; padding: 4px; margin: 5px 0;  background-color: #b49164; color: white; border-radius: 2px; padding:7px;">


                <h2> Package Summary: @Model.PackageName </h2>
                <h2 style="width: 80%; text-align: center; ">@Model.CompanyName </h2>


            </div>
            <button onclick="print()">Print</button>
            <thead>
            <th>Sr</th>
            <th>Mega Reference</th>
            <th>HB # </th>
            <th>Family Head Name </th>
            <th>POD </th>
                @* <th>Makkah</th>
            <th>Medinah</th>
            <th>Azizia</th> *@
            <th>Pax</th>
            <th>M</th>
            <th>F</th>
            <th>C</th>
            <th>I</th>
                @* <th>Remarks (Stay With)</th> *@
            <th>Basic Package (SAR)</th>
            <th>EI-ADF Amount (SAR)</th>
            <th>Ticket Amount (SAR)</th>
            <th>Discount (SAR)</th>
            <th>Total Package (SAR)</th>
            <th>Received Amount (SAR)</th>
                @* <th>Received Amount (PKR)</th> *@
            <th>Balance Before Transit (SAR)</th>
            <th>Payment in Transit (SAR)</th>
            <th>Final Balance Receivable (SAR)</th>
            <th>Received Amount %</th>
            <th>Last Payment Rec Date</th>
            <th>Days</th>
            <th>Receipt No:</th>
            <th>Category</th>
            <th>Residency</th>
                @* <th>Bio Status</th>
            <th>Agreement Signed</th>
            <th>Data From Signed</th>
            <th>E Hajj</th> *@
            </thead>

            @{
                int i = 0;
            }

            <tbody>

                @for (i = 0; i < Model.FamilyMembers.Count; i++)
                {

                    var currentMember = Model.FamilyMembers.ElementAt(i);

                    <tr>
                        <td>@(i + 1)</td>
                        <td>@currentMember.MegaId</td>
                        <td>@currentMember.FID</td>
                        <td>@currentMember.HeadName</td>
                        <td>@currentMember.POD</td>
                        @* <td>@currentMember.Makkah</td>
                    <td>@currentMember.Medinah</td>
                    <td>@currentMember.Azizia</td> *@
                        <td>
                            @currentMember.pax
                        </td>
                        <td>@currentMember.M</td>
                        <td>@currentMember.F</td>
                        <td>@currentMember.C</td>
                        <td>@currentMember.I</td>
                        @* <td>@currentMember.remarks</td> *@

                        <td>@currentMember.BasicPackageAmount</td>
                        <td>@currentMember.EIADFAmount</td>
                        <td>@currentMember.TicketAmount</td>
                        <td>@currentMember.DiscountAmount</td>
                        <td>@currentMember.PackageAmount</td>
                        <td>@currentMember.ReceivedAmountUSD</td>
                        @* <td>@currentMember.ReceivedAmountPKR</td> *@
                        <td>@currentMember.BalanceBeforeTransit</td>
                        <td>@currentMember.PaymentinTransit</td>
                        <td>@currentMember.FinalBalanceReceivable</td>
                        <td>@currentMember.ReceivedAmountPercent</td>
                        <td>@currentMember.LastPaymentRecDate</td>
                        <td>@currentMember.Days</td>
                        <td>@currentMember.ReceiptNo</td>
                        <td>@currentMember.Category</td>
                        <td>@currentMember.Residency</td>
                        @* <td>@currentMember.BioStatus</td>
                    <td>@currentMember.AgreementSign</td>
                    <td>@currentMember.DateFromSign</td>
                    <td>@currentMember.EHajj</td> *@

                    </tr>
                }

            </tbody>

            <tfoot>

                <tr style="background-color: #f6f3ee !important; color: #b49164; font-weight: bolder;">
                    <td colspan="5">Total</td>
                    <td>
                        @Model.totalpax
                    </td>
                    <td>
                        @Model.totalmale
                    </td>
                    <td>
                        @Model.totalfemale
                    </td>
                    <td>
                        @Model.totalchild
                    </td>
                    <td>
                        @Model.totalinfant
                    </td>
                    <td>@Model.TotalBasicPackage.ToString("N0")</td>
                    <td>@Model.TotalEIADFAmount.ToString("N0")</td>
                    <td>@Model.TotalTicketAmount.ToString("N0")</td>
                    <td>@Model.TotalDiscount.ToString("N0")</td>
                    <td>@Model.GrandTotalPackage.ToString("N0")</td>
                    <td>@Model.TotalReceivedAmount.ToString("N0")</td>
                    <td>@Model.TotalBalanceBeforeTransitAmount.ToString("N0")</td>
                    <td>@Model.TotalPaymentInTransit.ToString("N0")</td>
                    <td>@Model.TotalFinalBalanceReceivable.ToString("N0")</td>

                    <td colspan="4" style="text-align: right;">Regular / Sponser</td>
                    <td>
                        @Model.totalregular
                        @if (i > 0)
                        {
                            int percentage = (int)((decimal)Model.totalregular / i * 100);
                            @(percentage.ToString("(0.##") + "%)")
                            ;
                        }
                        else
                        {
                            @(0 + "%")
                        }
                        <br>

                        @Model.totalsponser
                        @if (i > 0)
                        {
                            int percentage = (int)((decimal)Model.totalsponser / i * 100);
                            @(percentage.ToString("(0.##") + "%)")
                            ;
                        }
                        else
                        {
                            @(0 + "%")
                        }

                    </td>
                    <td></td>
                    @*  <td> @Model.totalbiostatus
                    @if (i > 0)
                    {
                    int percentage = (int)((decimal)Model.totalbiostatus / i * 100);
                    @(percentage.ToString("(0.##") + "%)")
                    ;
                    }
                    else
                    {
                    @(0 + "%")
                    }
                    </td>
                    <td>  @Model.totalagreementsign
                    @if (i > 0)
                    {
                    int percentage = (int)((decimal)Model.totalagreementsign / i * 100);
                    @(percentage.ToString("(0.##") + "%)")
                    ;
                    }
                    else
                    {
                    @(0 + "%")
                    }
                    </td>
                    <td>  @Model.totaldataformsign
                    @if (i > 0)
                    {
                    int percentage = (int)((decimal)Model.totaldataformsign / i * 100);
                    @(percentage.ToString("(0.##") + "%)")
                    ;
                    }
                    else
                    {
                    @(0 + "%")
                    }
                    </td>
                    <td>
                    @Model.TotalEHajj <br />
                    @if (i > 0)
                    {
                    int percentage = (int)((decimal)Model.TotalEHajj / i * 100);
                    @(percentage.ToString("(0.##") + "%)");
                    }
                    else
                    {
                    @(0 + "%")
                    }
                    </td> *@
                </tr>
            </tfoot>
        </table>
    </div>


