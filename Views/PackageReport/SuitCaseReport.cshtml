@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SuitCase Token</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        .page-break {
            page-break-after: always;
        }

        .pt-btn {
            margin-bottom: 15px;
        }

        body {
            width: 100%;
            overflow-x: hidden;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif !important;
        }




        h1,
        h2,
        h3,
        h4,
        h5,
        h6,
        p {
            padding: 0;
            margin: 0;
        }

        table {
            border-collapse: collapse;
            width: 100%;
            border: none !important;
        }

            table th {
                font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
                padding: 3px 4px !important;
                font-size: 12px !important;
                text-align: center !important;
                background-color: #b0872e !important;
                color: white;
                font-weight: bold;
            }

            table td {
                font-size: 12px !important;
                padding: 5px 2px !important;
                margin: 0 !important;
                text-align: center;
                border: 1px solid #b0872e !important;
                background: transparent;
                color: #b0872e !important;
            }



        caption {
            background-color: #b0872e;
            color: white;
            padding: 7px;
            font-size: 18px !important;
        }


        @@media print {

            button {
                display: none;
            }
        }



        button {
            float: left;
            box-sizing: border-box;
            margin-left: 15px;
            margin-top: 20px;
            border-radius: 8px;
            padding: 0.5em 24px;
            cursor: pointer;
            font-size: 0.88em;
            line-height: 1.6em;
            white-space: nowrap;
            background-color: #f6f3ee !important;
            color: #b49164;
            position: relative;
            border: 1px solid rgb(255, 255, 255);
            font-weight: 600;
        }


        .logo-tmg-brown img {
            width: 100%;
        }

        .title-tokenNo {
            color: #b49164;
           
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin: 10px 0px;
            padding: 5px;
        }

            .title-tokenNo h2 {
                text-align: center;
                font-size: 25px;
                font-weight: bolder;

            }
    </style>
    <script>

    </script>
</head>

<body>
    <div class="myTable" id="summaryData">
        @{
            var dynamicResults = (IEnumerable<dynamic>)ViewBag.Results;
            var groupedResults = dynamicResults.GroupBy(x => x.FcId);
        }

        @foreach (var group in groupedResults)
        {
            <div class="logo-heading">
                <div class="logo-tmg-brown">
                    <img src="~/Images/CompanyLogos/hajj-with-khair-header.png" alt="">
                </div>
            </div>


            <div class="title-tokenNo">
                <h2>SuitCase</h2>
                <h1 style="text-align: center; font-size:28px; margin:0px; padding:0px;">@ViewBag.Results[0].Code</h1>
            </div>


            <table id="example" class="display " style="width: 100% !important; margin-top:10px;">


                <button onclick="print()" class="pt-btn">Print</button>

                <thead style="background-color: #f6f3ee; font-weight: bold;">
                    <tr>
                        <th>Sr</th>
                        
                        <th>Package</th>
                        <th>FcId</th>
                        <th>CID</th>
                        <th>Name</th>
                        <th hidden>Total Members</th>
                        <th hidden>Total Male</th>
                        <th hidden>Total Female</th>
                    </tr>
                </thead>

                <tbody>
                    @{
                        int i = 0;
                        int totalFamilyMembers = 0;
                        int totalMale = 0;
                        int totalFemale = 0;
                    }

                    @foreach (var m in group)
                    {
                        <tr>
                            <td>@(i + 1)</td>
                            
                            <td>@m.PackageName</td>
                            <td>@m.FcId</td>
                            <td>@m.CID</td>
                            <td>@m.GivenName</td>
                            <td hidden>@m.Total</td>
                            <td hidden>@m.TotalMale</td>
                            <td hidden>@m.TotalFemale</td>
                        </tr>
                        totalFamilyMembers += m.Total;
                        totalMale += m.TotalMale;
                        totalFemale += m.TotalFemale;
                        i++;
                    }
                </tbody>

                <tfoot style="color: #b49164; font-weight: bolder;">
                    <tr>
                        <td colspan="4" style="text-align: center !important">Total</td>
                        <td>@totalFamilyMembers</td>
                    </tr>
                </tfoot>
            </table>


            <h4>Total Males: @totalMale</h4>
            <h4>Total Females: @totalFemale</h4>

            // DUPLLICATE TABLE
            <div style="border-top: dotted 1px black !important; width: 100% !important; height:30px;  margin-top:100px;"></div>

            <div class="logo-heading">
                <div class="logo-tmg-brown">
                    <img src="~/Images/CompanyLogos/hajj-with-khair-header.png" alt="">
                </div>
            </div>

            <div class="title-tokenNo">
                <h2>SuitCase</h2>
                <h1 style="text-align: center; font-size:28px; margin:0px; padding:0px;">@ViewBag.Results[0].Code</h1>
            </div>


            <table id="example" class="display " style="width: 100% !important;">

                <button onclick="print()">Print</button>
                <thead style="background-color: #f6f3ee; font-weight: bold;">
                    <tr>
                        <th>Sr</th>
                        
                        <th>Package</th>
                        <th>FcId</th>
                        <th>CID</th>
                        <th>Name</th>
                        <th hidden>Total Members</th>
                        <th hidden>Total Male</th>
                        <th hidden>Total Female</th>
                    </tr>
                </thead>

                <tbody>
                    @{
                        int k = 0;
                        int ktotalFamilyMembers = 0;
                        int ktotalMale = 0;
                        int ktotalFemale = 0;
                    }

                    @foreach (var m in group)
                    {
                        <tr>
                            <td>@(k + 1)</td>
                           
                            <td>@m.PackageName</td>
                            <td>@m.FcId</td>
                            <td>@m.CID</td>
                            <td>@m.GivenName</td>
                            <td hidden>@m.Total</td>
                            <td hidden>@m.TotalMale</td>
                            <td hidden>@m.TotalFemale</td>
                        </tr>
                        ktotalFamilyMembers += m.Total;
                        ktotalMale += m.TotalMale;
                        ktotalFemale += m.TotalFemale;
                        k++;
                    }
                </tbody>

                <tfoot style="color: #b49164; font-weight: bolder;">
                    <tr>
                        <td colspan="4" style="text-align: center !important">Total</td>
                        <td>@ktotalFamilyMembers</td>
                    </tr>
                </tfoot>
            </table>


            <h4>Total Males: @totalMale</h4>
            <h4>Total Females: @totalFemale</h4>
            <div class="page-break"></div>


        }


    </div>

</body>

</html>