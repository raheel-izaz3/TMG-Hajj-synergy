@model PackageFacilitiesReportModel

<div class="container-xxl flex-grow-1 container-p-y">
    <h4 class="fw-bold"><span class="text-muted fw-light"></span> I-ADF Report</h4>
    <h5 class="fw-bold"><span class="text-muted fw-light"></span> @Model.PackageName <small>(@Model.PackageCode)</small>
    </h5>

    <div class="card my-2 p-2 mb-5">
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th class="fw-bold">Total Members: @Model.FamilyMembersCount</th>
                    </tr>
                    <tr>
                        <th></th>
                        @foreach (string h in Model.RoomHeaders)
                        {
                            <th>@h <input class="form-check form-check-inline" type="checkbox"
                                    onchange="selectAll('iadf-@(h.Replace(' ', '-'))', this)"></th>
                        }
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Booked</td>
                        @foreach (int p in Model.RoomCounts)
                        {
                            <td>@p</td>
                        }
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <form method="post">

        <button type="submit" class="btn btn-success">Save</button>
        <hr class="mb-4" />

        @{
            int i = 0;
        }
        @foreach (var group in Model.Heads)
        {
            int j = 0;

            <h3 class="mb-3 mt-4">@group.FCId</h3>
            <div class="card mb-3 p-2">
                <div class="table-responsive text-nowrap ">
                    <table class="table table-hover" id="">
                        <thead>
                            <tr>
                                <th>HB #</th>
                                <th>Name</th>
                                @foreach (string h in Model.RoomHeaders)
                                {
                                    <th>@h</th>
                                }
                            </tr>
                        </thead>
                        <tbody class="table-border-bottom-1">
                            @foreach (var member in group.Members)
                            {
                                int k = 0;

                                <tr>
                                    <th>@member.FCId</th>
                                    <th>@member.Name</th>
                                    @foreach (var entry in member.Rooms)
                                    {

                                        <td>
                                            <input type="hidden" name="FacilitySelected[]"
                                                value="@(entry.Checked ? "true" : "false")"
                                                class="selected-iadf-@entry.IADF.IndividiualFacilityDescription.Description.Replace(' ', '-')"
                                                id="ds-@i-@j-@k" />
                                            <input type="hidden" value="@member.FamilyHeadId" name="FamilyHeadIds[]" />
                                            <input type="hidden" value="@entry.IADF.AdditionalFacilitiesId" name="FacilityIds[]" />
                                            <div class="form-check form-check-inline mb-2">
                                                <input class="form-check-input check-header"
                                                    name="iadf-@entry.IADF.IndividiualFacilityDescription.Description.Replace(' ', '-')"
                                                    type="checkbox" @(entry.Checked ? "checked" : "")
                                                    onchange="document.getElementById('ds-@i-@j-@k').value = this.checked">
                                                <label
                                                    class="form-check-label">@entry.IADF.IndividiualFacilityDescription.Description</label>
                                            </div>
                                        </td>
                                        k++;
                                    }
                                </tr>
                                j++;
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            i++;
        }

    </form>


</div>

<script>
    let table = new DataTable('#reportTable', {
        dom: 'Bfrtip',
        buttons: [{
            text: 'Export to Excel',
            extend: 'excelHtml5',
            className: 'btn btn-dark',
            exportOptions: {
                columns: ':visible:not(:last-child)'
            }
        }]
    });

    function selectAll(id, elem) {
        const elems = document.getElementsByName(`${id}`);
        const sels = document.getElementsByClassName(`selected-${id}`);


        for (let e of elems) {
            e.checked = elem.checked
            for (let s of sels) {
                s.value = e.checked ? 'true' : 'false'
            }
        }



    }

</script>
