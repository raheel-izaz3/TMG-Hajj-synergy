@model SubType

@{
    string modelName = "Sub Type";
    string modelNamePlural = "Sub Types";
    string modelControllerRoute = "SubType";
}

<div class="container-xxl flex-grow-1 container-p-y">
    <h4 class="fw-bold" style="color:  #404040;"><span class="text-muted fw-light"> @modelName / </span> Create</h4>

    <hr class="mb-4" />

    <div class="row">
        <div class="col-sm-12">
            <div class="card mb-4">
                <div class="card-body">
                    <form method="post">
                        <div class="row">
                            <div class="col-sm-12 col-md-4 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname" asp-for="CompanyId"></label>
                                <select class="form-control" asp-for="CompanyId">
                                    <option value="">Select Company </option>
                                    @foreach (Company company in ViewBag.Company)
                                    {
                                        <option value="@company.CompanyId">@company.CompanyName</option>
                                    }
                                </select>
                                <span class="text-danger" asp-validation-for="CompanyId"></span>
                            </div>
                            <div class="col-sm-12 col-md-4 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname" asp-for="TypeId"></label>
                                <select class="form-control" asp-for="TypeId">
                                    <option value="">Select Account Type</option>
                                    @foreach (Type type in ViewBag.Types)
                                    {
                                        <option value="@type.TypeId">@type.Name</option>
                                    }
                                </select>
                                <span class="text-danger" asp-validation-for="TypeId"></span>
                            </div>
                            <div class="col-sm-12 col-md-4 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname" asp-for="Name"></label>
                                <div class="input-group input-group-merge">
                                    <span id="basic-icon-default-fullname2" class="input-group-text"><i class="bx bx-building"></i></span>
                                    <input asp-for="Name" class="form-control">
                                </div>
                                <span class="text-danger" asp-validation-for="Name"></span>
                            </div>
                            <div class="col-sm-12 mt-4">
                                <button type="submit" class="btn btn-success float-end">Create</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>

</div>