@model Cordinator

@{
    string modelName = "Cordinator";
    string modelNamePlural = "Cordinators";
    string modelControllerRoute = "Cordinator";
    TMG.Data.TMGDbContext _db;
}


<div class="container-xxl flex-grow-1 container-p-y">
    <h4 class="fw-bold" style="color:  #404040;"><span class="text-muted fw-light"> @modelName / </span>  Edit</h4>

    <hr class="mb-4" />

    <div class="row">
        <div class="col-sm-12">
            <div class="card mb-4">
                <div class="card-body">
                    <form method="post">
                        <input type="hidden" asp-for="CordinatorId">
                        <div class="row">
                            <div class="col-sm-12 col-md-3 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname" asp-for="Name"></label>
                                <div class="input-group input-group-merge">
                                    <span id="basic-icon-default-fullname2" class="input-group-text"><i class="bx bx-building"></i></span>
                                    <input asp-for="Name" class="form-control">
                                </div>
                                <span class="text-danger" asp-validation-for="Name"></span>
                            </div>
                            <div class="col-sm-12 col-md-3 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname" asp-for="Number"></label>
                                <div class="input-group input-group-merge">
                                    <span id="basic-icon-default-fullname2" class="input-group-text"><i class="bx bx-building"></i></span>
                                    <input asp-for="Number" class="form-control">
                                </div>
                                <span class="text-danger" asp-validation-for="Number"></span>
                            </div>
                            <div class="col-sm-12 col-md-3 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname" asp-for="PlaceId"></label>
                                <div class="input-group input-group-merge">
                                    <span id="basic-icon-default-fullname2" class="input-group-text"><i class="bx bx-building"></i></span>
                                    <select class="form-control" asp-for="PlaceId">
                                        @foreach (Place place in ViewBag.Place)
                                        {
                                            <option value="@place.PlaceId">@place.PlaceName</option>
                                        }
                                    </select>
                                </div>
                                <span class="text-danger" asp-validation-for="PlaceId"></span>
                            </div>
                        </div>
                        <button type="submit" class="btn btn-warning float-end">Save Changes</button>
                    </form>
                </div>
            </div>

        </div>
    </div>

</div>