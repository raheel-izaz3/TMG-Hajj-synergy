@model Expense
@{
    Layout = "";
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title></title>
    <style>
        * {
            box-sizing: border-box;
        }

        body {
            font-family: Calibri, Candara, Segoe, Segoe UI, Optima, Arial, sans-serif;
            overflow-x: hidden;
        }

        h1,
        h2,
        h3,
        h4,
        h5,
        h6 {
            margin: 0;
            padding: 0;
        }

        p {
            font-size: 9px;
            margin: 0;
            padding: 0;
        }

        /* Table styling  */
        table tr th {
            font-size: 10px;
        }

        table tr td {
            font-size: 9px !important;
        }

        .AMounttotelvalue {
            /* font-size: 12px !important; */
            color: white;
            background-color: black;
        }

        .TotalAMountTitle {
            /* font-size: 10px !important; */
            color: white;
            background-color: black;
        }

        /*   #discountRateHideShow {
                      display: table;
                    }

                    #totalAmountHideShow {
                      display: none;
                    } */


        /* Table styling  End */
        .downloade_btn {
            padding: 10px 45px;
            background-color: lightblue;
            outline: none;
            border: 1px solid black;
            font-weight: bold;
            font-family: Calibri, Candara, Segoe, Segoe UI, Optima, Arial, sans-serif;
            font-size: 14px;
            cursor: pointer;
        }

            .downloade_btn:hover {
                background-color: white;
            }

        /* Check-Box Styling  */
        .check_box_container {
            display: flex;
            justify-content: center;
            align-items: center;
        }

            .check_box_container .CheckBox {
                width: 20px;
                height: 12px;
                margin: 0;
                padding: 0;
            }

        @@media print {
            .check_box_container {
                display: none !important;
            }

            button {
                display: none;
            }
        }

        /* Check-Box Styling End */
        .parent {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .container {
            display: flex;
            align-items: center;
        }

            .container .logo {
                width: 55px;
            }

                .container .logo img {
                    width: 100%;
                }

        .AL_Khair_Title {
            font-size: 18px;
            margin-left: 15px;
            font-weight: bold;
        }

        .title_break {
            font-size: 12px;
            margin-left: 15px;
            font-weight: bold;
        }

        .qr-code p {
            padding: 0;
            margin: 0;
        }

        .qr-code {
            padding: 0;
            padding-top: 20px;
        }

        .qr_number {
            text-align: right;
            margin: 0px;
            font-weight: bold;
        }

        .horizantal_line {
            border: 1px solid black;
        }


        .Invoice_to_section {
            display: flex;
            justify-content: space-between;
            flex-wrap: wrap;
        }

        .proforma_title {
            text-align: center;
            padding-top: 10px;
            margin-bottom: 15px;
        }

        .Customer_Info p {
            padding: 1px 0;
            font-weight: bold !important;
        }

        .Customer_Col_2 p {
            padding: 1px 0;
            font-weight: bold;
        }

        .Customer_Col_2 span {
            font-weight: normal;
        }

        .Customer_Info span {
            font-weight: normal;
        }

        .ALL_MEMBERS_NAMES p {
            padding: 1px 0;
        }

        .ALL_MEMBERS_NAMES span {
            font-weight: bold;
        }

        /* Table Styling Start  */
        .Service_Table {
            width: 100%;
        }

            .Service_Table tr th {
                font-size: 10px;
                text-align: right;
            }

            .Service_Table tr td {
                border-bottom: 1px solid black;
                font-size: 10px;
            }

                .Service_Table tr td:nth-child(2) {
                    text-align: right;
                    width: 130px;
                }

            .Service_Table tr:nth-last-child(1) {
                font-weight: bold;
            }

        /* MEdia Querry  */
        @@media (max-width :768px) {
            .Bank_Table {
                width: 100% !important;
            }
        }

        .Bank_Table {
            margin-top: 20px;
            border: 1px solid black;
            border-collapse: collapse;
            width: 60%;
        }

            .Bank_Table tr {
                border: 1px solid black;
            }

                .Bank_Table tr th {
                    border: 1px solid black !important;
                    background-color: lightblue;
                    text-align: left;
                    padding-left: 5px;
                    font-size: 10px;
                }

                .Bank_Table tr td:nth-child(1) {
                    font-weight: bold;
                }

                .Bank_Table tr td {
                    text-align: left;
                    border: 1px solid black;
                    padding-left: 5px;
                    font-size: 10px;
                }

        /* ADF_Details_Table styling Start  */
        .Receipt_container {
            margin-top: 7px;
        }


        .ADF_Container {
            width: 60%;
        }

        .ADF_Details_Box {
            margin-bottom: 10px;
        }

        .ADF_heading {
            background-color: lightblue;
            font-weight: bold;
            font-size: 10px !important;
            text-align: center;
            color: black !important;
        }

        @@media (max-width:768px) {
            .ADF_Container {
                width: 100% !important;
            }
        }

        .ADF_Details_Box table {
            border-collapse: collapse;
            border: 1px solid black;
            width: 100%;
        }

        .ADF_Details_Box tr th {
            border: 1px solid black;
        }

        .ADF_Details_Box tr td {
            border: 1px solid black;
        }


        .totalText,
        .amountText {
            font-weight: bold !important;
            background-color: lightblue;
            font-size: 10px !important;
            color: black !important;
        }

        /*############ ADF_Details_Table styling End ############## */
        /* *********Note List ********** */
        .terms_condition_list {
            margin-left: 6px;
            margin: 20px 0px !important;
        }

        .note_heading {
            font-size: 10px;
            font-weight: bold;
            margin-top: 10px;
        }

        .Notes_order_list {
            padding: 0;
            margin: 8px;
        }

            .Notes_order_list li {
                font-size: 8px;
                padding: 2px;
            }

        /* *********Note List  END********** */
        footer {
            position: fixed;
            bottom: 0;
            left: 0;
            width: 100% !important;
        }

        .footer_address {
            border-top: 1px solid black;
            text-align: center;
        }

            .footer_address h6 {
                font-weight: normal !important;
            }



        .top_service_table {
            border: 1px solid black;
            border-collapse: collapse;
            width: 100%;
            margin-bottom: 0px;
            margin-top: 10px;
        }

            .top_service_table tr th,
            td {
                border: 1px solid black;
            }

            .top_service_table tr {
                border: 1px solid black;
            }

                .top_service_table tr:nth-child(1) {
                    border: none !important;
                    outline: none;
                }

                .top_service_table tr td:nth-child(2) {
                    text-align: left;
                }

                .top_service_table tr td:nth-child(3) {
                    text-align: right;
                }

                .top_service_table tr:nth-last-child(1) {
                    font-weight: bold;
                    font-size: 14px !important;
                    background-color: black;
                    color: white;
                }

        /* ________Content_Editable Row _____ */
        [contenteditable] {
            width: 100px;
        }

        /* ________Content_Editable Row _____ */
        /* Hide And Show Table Styling  */
        #Receipt_PaymentRecord,
        #Payment_Subject {
            display: none;
        }


        #Memberbreaktable {
            display: none;
            text-align: center;
        }

        /* Media Querry Check-box and Label button  */
        label {
            font-size: 14px !important;
        }

        @@media (max-width: 768px) {
            label {
                font-size: 14px;
            }

            input[type="checkbox"] {
                transform: scale(0.8);
            }
        }

        .check_box_container span {
            font-weight: bold;
        }

        .flex-container {
            display: flex;
            justify-content: center;
            align-items: center;
            flex-wrap: wrap;
            margin-top: 10px;
        }

        .start-iadf td {
            text-align: left !important;
        }
    </style>
    <!-- html2pdf CDN Link  -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.9.2/html2pdf.bundle.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.0/jquery.min.js"
            integrity="sha512-3gJwYpMe3QewGELv8k/BX9vcqhryRdzRMxVfq6ngyWXwo03GFEzjsUm8Q7RZcHPHksttq7/GFoxjCVUjkjvPdw=="
            crossorigin="anonymous" referrerpolicy="no-referrer"></script>

</head>

<body>
    <button class="downloade_btn" onclick="print()">Print </button>

    <div id="incoice_page_body">
        <div class="parent">
            <div class="container">
                <div class="logo">
                    <img src="~/@Model.CompanyBankAccount.Company.Logo" id="companyLogo" alt="Logo" />
                </div>

                <div class="title">
                    <p class="AL_Khair_Title" id="companyName">@Model.CompanyBankAccount.Company.CompanyName</p>
                </div>
            </div>
            @* <div class="qr-code">
            <img src="./images/QR-Code.png" alt="QR-Code" style="width: 75px; height: 75px" />
            </div> *@
        </div>

        <div class="horizantal_line"></div>
        <div class="proforma_title">
            <h4 id="miniStatement_Title">Expense</h4>
        </div>
        <div class="Invoice_to_section">
            <div>
                <div class="Customer_Info">
                    <p>Date: <span id="">@Model.Date.ToString("dd/MMM/yyyy")</span></p>
                    <p>Company: <span id="">@Model.CompanyBankAccount.Company.CompanyName</span></p>
                    <p>
                        ADDRESS: <span id="">@ViewBag.CompanyAddress</span>
                    </p>
                    <p>City: <span id="">@ViewBag.City</span></p>
                    <p>Email: <span id="">@ViewBag.Email</span></p>
                </div>
            </div>
            <div>
                <div class="Customer_Info">
                    <p>Expense Type: <span id="">@Model.ExpenseType.TypeName</span></p>
                    <p>Description: <span id="mega">@Model.Description</span> </p>
                </div>
            </div>
        </div>

        <!-- Top Service Section Start   -->
        <table class="top_service_table">
            @* <tr>
                <th style="
              text-align: left;
              font-size: 10px;
              color: black;
              background-color: lightblue;
              font-weight: bolder;
            ">
                    Vendor
                </th> *@
                <th style="
              text-align: left;
              font-size: 10px;
              color: black;
              background-color: lightblue;
              font-weight: bolder;
            ">
                    Description
                </th>

                <th style="
        text-align: left;
        font-size: 10px;
        color: black;
        background-color: lightblue;
      ">
                    AMOUNT
                </th>

            </tr>

            <tr style="height: 20px;">
                <td>Base Amount</td>
                <td>PKR @Model.Amount.ToString("N2")</td>
            </tr>

            @if (Model.WithholdingTax > 0)
            {
                <tr style="height: 20px;">
                    <td>Withholding Tax</td>
                    <td>PKR @Model.WithholdingTax.ToString("N2")</td>
                </tr>
            }

            @if (Model.AdvanceTax > 0)
            {
                <tr style="height: 20px;">
                    <td>Advance Tax</td>
                    <td>PKR @Model.AdvanceTax.ToString("N2")</td>
                </tr>
            }

            @if (Model.SalesTax > 0)
            {
                <tr style="height: 20px;">
                    <td>Sales Tax</td>
                    <td>PKR @Model.SalesTax.ToString("N2")</td>
                </tr>
            }

            @if (Model.MiscTax > 0)
            {
                <tr style="height: 20px;">
                    <td>Misc Tax</td>
                    <td>PKR @Model.MiscTax.ToString("N2")</td>
                </tr>
            }

            <tr style="height: 20px;">
                <td><strong>Total Amount</strong></td>
                <td>PKR @Model.TotalAmount.ToString("N2")</td>
            </tr>


        </table>

        <div id="banks">
            @* @foreach (CompanyBankAccount account in Model.BankDetails)
            {
            <table class="Bank_Table" style="margin-block: 10px;" id="bank_@account.CompanyBankAccountId">
            <tr>
            <th style="color: black">BANK DETAILS</th>
            <th style="color: black">CURRENCY: @account.AccountCurrency</th>
            </tr>
            <tr>
            <td>BANK NAME</td>
            <td>@account.Bank.Name</td>
            </tr>
            <tr>
            <td>ACCOUNT TITLE</td>
            <td>@account.Title</td>
            </tr>
            <tr>
            <td>ACCOUNT NUMBER</td>
            <td>@account.Number</td>
            </tr>
            <tr>
            <td>IBAN</td>
            <td>@account.IBAN</td>
            </tr>
            <tr>
            <td>BRANCH CODE</td>
            <td>@account.BranchCode</td>
            </tr>
            <tr>
            <td>SWIFT CODE</td>
            <td>@account.Swift</td>
            </tr>
            <tr>
            <td>GOVERNMENT ID / NTN</td>
            <td>@account.NTN</td>
            </tr>
            <tr>
            <td>BANK ADDRESS</td>
            <td>
            @account.BankAddress
            </td>
            </tr>
            </table>
            } *@
        </div>

        <!-- Note Section Start  -->
        <!-- Start *I-ADF_ Hide And show Table  -->
       

        <footer>
            <div class="footer_address" id="footer">
                <h6 style="position: relative; top: -15px; font-weight: bold !important;">THIS IS A SYSTEM GENERATED INVOICE. IN CASE OF ANY DISCREPANCIES, PLEASE CONTACT YOUR COORDINATOR.</h6>
                <h6>
                    Add: @ViewBag.CompanyAddress
                </h6>
                <h6>
                    Phone: @ViewBag.Contact  Email: @ViewBag.Email  Web: @Model.CompanyBankAccount.Company.Website
                </h6>
            </div>
        </footer>
    </div>

</body>

</html>