@model City

@{
    string modelName = "City";
    string modelNamePlural = "Cities";
    string modelControllerRoute = "City";
    TMG.Data.TMGDbContext _db;
}


<div class="container-xxl flex-grow-1 container-p-y">
    <h4 class="fw-bold" style="color:  #404040;"><span class="text-muted fw-light"> @modelName / </span>  Edit</h4>

    <hr class="mb-4" />

    <div class="row">
        <div class="col-sm-12">
            <div class="card mb-4">
                <div class="card-body">
                    <form method="post">
                        <input type="hidden" asp-for="CityId">
                        <div class="row">
                            <div class="col-sm-12 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname" asp-for="Name"></label>
                                <div class="input-group input-group-merge">
                                    <span id="basic-icon-default-fullname2" class="input-group-text"><i class="bx bx-building"></i></span>
                                    <input asp-for="Name" class="form-control">
                                </div>
                                <span class="text-danger" asp-validation-for="Name"></span>
                            </div>
                            <div class="col-sm-12 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname">Country</label>
                                <div class="input-group input-group-merge">
                                    <select asp-for="CountryId" class="form-control">
                                        <option value="">Select Country</option>
                                        @foreach (Country item in ViewBag.Country)
                                        {
                                            <!option value="@item.CountryId" @(Model.CountryId == item.CountryId ? "selected" : "")>
                                                @item.Name
                                            </!option>
                                        }
                                    </select>
                                </div>
                                <span class="text-danger" asp-validation-for="CountryId"></span>
                            </div>
                        </div>
                        <button type="submit" class="btn btn-warning float-end">Save Changes</button>
                    </form>
                </div>
            </div>

        </div>
    </div>

</div>