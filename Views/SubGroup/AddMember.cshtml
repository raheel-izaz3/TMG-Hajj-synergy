    function updateSelected(elem, familyHeadId, groupId) {
        const MAX = @ViewBag.SubGroupPAX;
        const selectedCheckboxes = $('input:checkbox[name="selected[]"]:checked');
        const length = selectedCheckboxes.length;

        if (length > MAX) {
            alert("Limit Exceeded");
            elem.checked = false;
            return;
        }

        updateSelectedCount();

        const isHead = elem.getAttribute("data-is-head");
        const headId = elem.getAttribute("data-head-id");
        const elemFcId = elem.getAttribute("data-hb-id");  // Corrected attribute
        console.log("Selected Family Head ID:", elemFcId); // Debugging ke liye

        if (isHead == "True" && elem.checked) {
            const elements = document.querySelectorAll(`[data-head-id="${headId}"]`);

            if ((elements.length - 1) + length > MAX) {
                if (confirm("Cannot select this family. Limit will exceed. Would you like to proceed?")) {
                    elem.checked = true;
                    addMember(elemFcId, groupId);
                    updateSelectedCount();
                    return;
                } else {
                    elem.checked = false;
                    removeMember(elemFcId, groupId);
                    updateSelectedCount();
                    return;
                }
            }

            if (elem.checked) {
                for (let check of elements) {
                    if (check.hasAttribute('disabled')) continue;
                    check.checked = true;
                    let fcId = check.getAttribute('data-hb-id');  // Corrected attribute
                    addMember(fcId, groupId);
                }
            } else {
                elem.checked = false;
                removeMember(elemFcId, groupId);
            }
            updateSelectedCount();
        }
        else if (elem.checked && isHead == "False") {
            addMember(elemFcId, groupId);
        }
        else {
            removeMember(elemFcId, groupId);
        }
    }


    function addMember(familyHeadId, groupId) {
        $.ajax({
            url: "/SubGroup/AddMember",
            method: "POST",
            data: {
                memberId: familyHeadId,
                subGroupId: groupId
            },
            success: res => {
                console.log(res)
            },
            error: err => {
                console.log(err)

            }
        });
    }

    function removeMember(familyHeadId, groupId) {
        $.ajax({
            url: "/SubGroup/RemoveMember",
            method: "POST",
            data: {
                memberId: familyHeadId,
                subGroupId: groupId
            },
            success: res => {
                console.log(res)
            },
            error: err => {
                console.log(err)
            }
        });
    }


</script>
