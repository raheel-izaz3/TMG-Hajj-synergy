<script>
	function addRoom(e) {
		const id = Date.now() + Math.floor(Math.random() * 10000)
		var row = `
					<div class="row" id="room_${id}">
											<div class="col-sm-12 col-md-3 mb-3">
												<label class="form-label" for="basic-icon-default-fullname" name="">Room</label>
												<div class="input-group input-group-merge">
													<span id="basic-icon-default-fullname2" class="input-group-text"><i class="bx bx-building"></i></span>
													<select class="form-select" name="RoomIds[]">
	@foreach (Room r in ViewBag.Rooms)
	{
																							<option value="@r.RoomId">@r.RoomName (@r.RoomCode)</option>
	}
													</select>
												</div>
												<span class="text-danger"></span>
											</div>
											<div class="col-sm-12 col-md-6 mb-3">
												<label class="form-label" for="basic-icon-default-fullname" name="">Quantity</label>
												<div class="input-group input-group-merge">
													<input type="number" value="1" min="1" name="Quantities[]" class="form-control" placeholder="Enter Quantity" required/>
												</div>
												<span class="text-danger"></span>
											</div>
											<div class="col-sm-12 col-md-1 d-flex align-items-center">
												<label class="form-label"></label>
												<button type="button" class="btn btn-icon btn-danger" onclick="removeRoom(${id})"><i class='bx bxs-trash'></i></button>
											</div>
											<hr />`;

		$("#rooms").append(row);
	}

	function removeRoom(id) {
		// console.log(id)
		// console.log(document.getElementById("room_"+id))
		document.getElementById(`room_${id}`).remove();
	}

</script>