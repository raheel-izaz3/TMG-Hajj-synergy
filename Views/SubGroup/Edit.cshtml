							<div class="row mb-3">
								<div class="col-sm-12 col-md-12 mt-3">
									<div class="table-responsive">
										<table class="table" id="table">
											<thead>
												<tr>
													<th>Select Rooms</th>
													<th>Room Number</th>
													<th>Room Type</th>
													<th>Bathroom Type</th>
													<th>View</th>
												</tr>
											</thead>
											<tbody class="table-border-bottom-1" id="tbody">
												@foreach (RoomDetails item in ViewBag.RoomDetails as List<RoomDetails> ?? new List<RoomDetails>())
												{
													// Har row ke liye correct matching record lena
													var selectedRoom = Model.SubGroupRooms.FirstOrDefault(r => r.RoomDetailsId == item.RoomDetailsId) ?? new SubGroupRoomsModel();

													<tr>
														<input type="hidden" name="POHotelsId" value="@item.POHotelsId" />
														<input type="hidden" name="PlaceIds" value="@item.POHotels.PlaceId" />
														<input type="hidden" name="POHotelRoomsId" value="@item.POHotelRoomsId" />
														<input type="hidden" name="RoomDetailsId" value="@item.RoomDetailsId" />

														<td>
															<input type="hidden" name="RoomDetailsId[]" value="@item.RoomDetailsId" />
															<input type="checkbox" class="room-checkbox" name="SelectedRoomDetailsId[]" value="@item.RoomDetailsId"
															@(selectedRoom.RoomDetailsId > 0 ? "checked" : "") />
														</td>

														<td>
															<input type="text" class="form-control" name="RoomNumber[]"
																   value="@(selectedRoom.RoomNumber ?? item.RoomNumber ?? "Unknown")" />
														</td>

														<td>
															<select class="form-control" style="width: 200px;" name="RoomId[]">
																@foreach (Room roomData in (ViewBag.Rooms as List<Room> ?? new List<Room>()))
																{
																	<option value="@roomData.RoomId"
																			selected="@(selectedRoom.RoomId == roomData.RoomId ? "selected" :
																			(item.RoomId == roomData.RoomId ? "selected" :
                                                                            (ViewBag.Rooms is List<Room> roomList && roomData == roomList.FirstOrDefault() ? "selected" : null)))">
																		@roomData.RoomName (@roomData.RoomCode)
																	</option>
																}
															</select>
														</td>


														<td>
															<select class="form-control" style="width: 200px;" name="BathroomType[]">
																@foreach (var bath in ViewBag.BathType)
																{
																	<!option value="@bath.Id" @(selectedRoom.BathroomType == (BathroomType)bath.Id ? "selected" :
																				(item.BathroomType.HasValue && (int)item.BathroomType.Value == bath.Id ? "selected" :
																				(ViewBag.BathType is List<BathTypeModel> bathList && bath == bathList.FirstOrDefault() ? "selected" : null)))>
																		@bath.Name
																	</!option>
																}
															</select>
														</td>

														<td>
															<select class="form-control" style="width: 200px;" name="RoomViewId[]">
																@foreach (RoomView roomView in ViewBag.RoomViews)
																{
																	<!option value="@roomView.RoomViewId" @(selectedRoom.RoomViewId == roomView.RoomViewId ? "selected" :
																			(item.RoomViewId == roomView.RoomViewId ? "selected" :
																			(ViewBag.RoomViews is List<RoomView> roomViewList && roomView == roomViewList.FirstOrDefault() ? "selected" : null)))>
																		@roomView.Name
																	</!option>
																}
															</select>
														</td>
													</tr>
												}
											</tbody>

										</table>
									</div>
								</div>
							</div>
