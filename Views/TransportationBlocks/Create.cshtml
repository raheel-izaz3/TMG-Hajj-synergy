@model TransportationBlocks

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    string modelName = "TransportationBlocks";
    string modelNamePlural = "TransportationBlocks";
    string modelControllerRoute = "TransportationBlocks";
}


<div class="container-xxl flex-grow-1 container-p-y">
    <h4 class="fw-bold" style="color:  #404040;"><span class="text-muted fw-light"> @modelName / </span> Create</h4>

    <hr class="mb-4" />

    <div class="row">
        <div class="col-sm-12">
            <div class="card mb-4">
                <div class="card-body">
                    <form method="post">
                        <div class="row">
                            <div class="col-sm-12 col-md-3 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname">Select Route</label>
                                <div class="input-group input-group-merge">
                                    <select name="RouteId" id="RouteId" class="form-control">
                                        <option value="">Select Code...</option>
                                        @foreach (Route fh in ViewBag.Routes)
                                        {
                                            <option value="@fh.RouteId">@fh.FullRoute</option>
                                        }
                                    </select>
                                </div>
                                <span class="text-danger"></span>
                            </div>
                            <div class="col-sm-12 col-md-3 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname">Select Place</label>
                                <div class="input-group input-group-merge">
                                    <select name="PlaceId" class="form-control">
                                        <option value="">Select Place...</option>
                                        @foreach (Place fh in ViewBag.Place)
                                        {
                                            <option value="@fh.PlaceId">@fh.PlaceName</option>
                                        }
                                    </select>
                                </div>
                                <span class="text-danger"></span>
                            </div>
                            <div class="col-sm-12 col-md-4 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname" asp-for="PAX"></label>
                                <div class="input-group input-group-merge">
                                    <span id="basic-icon-default-fullname2" class="input-group-text"><i class="bx bx-building"></i></span>
                                    <input asp-for="PAX" class="form-control">
                                </div>
                                <span class="text-danger" asp-validation-for="PAX"></span>
                            </div>
                            <div class="col-sm-12 col-md-4 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname" asp-for="Date"></label>
                                <div class="input-group input-group-merge">
                                    <span id="basic-icon-default-fullname2" class="input-group-text"><i class="bx bx-building"></i></span>
                                    <input type="date" asp-for="Date" class="form-control">
                                </div>
                                <span class="text-danger" asp-validation-for="Date"></span>
                            </div>
                            <div class="col-sm-12 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname">
                                    Select
                                    Packages
                                </label>
                                <br />
                                @{
                                    int i = 0;
                                }
                                @foreach (var package in ViewBag.Packages1)
                                {
                                    <div class="form-check form-check-inline">
                                        <input type="hidden" value="@package.PackageId" asp-for="PackageIds" />

                                        <input class="form-check-input" type="checkbox" id="@package.PackageId"
                                               asp-for="PackagesSelected[i]">

                                        <label class="form-check-label"
                                               for="@package.PackageId">@package.Name</label>
                                    </div>
                                    i++;
                                }
                            </div>
                            <div class="col-sm-12 mt-4">
                                <button type="submit" class="btn btn-success float-end">Create</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>

</div>

<script>
    $(document).ready(function () {
       $('select[name="RouteId"]').select2({
           placeholder: "Select Family Head",
           allowClear: true,
           width: '100%',
           dropdownCssClass: 'form-control',
           selectionCssClass: 'form-control'
       });
    });
</script>