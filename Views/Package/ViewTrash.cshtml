@model IEnumerable<Package>



@{
    string modelName = "Package";
    string modelNamePlural = "Packages";
    string modelControllerRoute = "Package";
    TMG.Data.TMGDbContext _db;
}


@if (TempData.ContainsKey("restored"))
{
    if ((bool)TempData["restored"]! == true)
    {
        <script>
            toastr.options.closeDuration = 100;
            toastr.options.closeButton = true;
            toastr.options.positionClass = "toast-top-center";
            toastr.options.showMethod = 'slideDown';
            toastr.options.hideMethod = 'slideUp';
            toastr.options.closeMethod = 'slideUp';
            toastr.success('', 'Role Restored Successfully!', { timeOut: 2000 })
        </script>
        TempData["restored"] = false;
    }
}

<div class="container-xxl flex-grow-1 container-p-y">
    <h4 class="fw-bold" style="color:  #404040;"><span class="text-muted fw-light">Package /</span> Trash</h4>

    <hr class="mb-4" />
    <div class="card p-2">
        <div class="table-responsive text-nowrap ">
            <table class="table table-hover" id="table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Company</th>
                        <th>PKG Code</th>
                        <th>PKG Name</th>
                        <th>Quota</th>
                        <th>Booked</th>
                        <th>Balance</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody class="table-border-bottom-1">
                    @{
                        int i = 0;
                    }
                    @*    @if (Model.Count() == 0)
                    {
                    <tr>
                    <td colspan="9" class="text-danger text-center">No Data Found!</td>
                    </tr>
                    } *@
                    @foreach (Package package in Model)
                    {
                        i++;
                        <tr>
                            <td>
                                <i class="fab fa-bootstrap fa-lg text-primary me-3"></i> <strong>@package.PackageId</strong>
                            </td>
                            <td>@package.Company.CompanyName</td>
                            <td>@package.Code</td>
                            <td>@package.Name</td>
                            <td>@package.Quota</td>
                            <td>0</td>
                            <td>@package.Quota</td>
                            <td>
                                <div class="dropdown">
                                    <a class="btn btn-info" asp-action="Restore" asp-route-id="@package.PackageId"><i class="bx bx-recycle me-1"></i> Restore</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
<script>
    function confirmDelete(id) {
        let del = confirm("Are you sure?")
        if (del) {
            location.href = `/@modelControllerRoute/Trash/${id}`;
        }
    }

    let table = new DataTable('#table', {
    });
</script>

