                                        </div>

                                        <div class="row mb-2 mt-1">
                                            <div class="col-sm-10 col-md-3">
                                                <label class="form-label mt-3">Makkah</label>
                                                <div class="input-group input-group-merge">
                                                    <select class="form-control" name="PackageFacilitiesIds">
                                                        <option value="">Select Makkah Type</option>
                                                        @foreach (IndividualFacilityDescription makkah in ViewBag.MakkahRooms)
                                                        {
                                                            <!option value="@makkah.IndividualFacilityDescriptionId"
                                                            @(ViewBag.SelectedIADFRoom.Contains(makkah.IndividualFacilityDescriptionId) ? "selected" : "")>
                                                                @makkah.Description
                                                            </!option>
                                                        }
                                                    </select>
                                                </div>
                                            </div>

                                            <div class="col-sm-10 col-md-3">
                                                <label class="form-label mt-3">Medinah</label>
                                                <div class="input-group input-group-merge">
                                                    <select class="form-control" name="PackageFacilitiesIds">
                                                        <option value="">Select Medinah Type</option>
                                                        @foreach (IndividualFacilityDescription medinah in ViewBag.Medinah)
                                                        {
                                                            <!option value="@medinah.IndividualFacilityDescriptionId"
                                                            @(ViewBag.SelectedIADFRoom.Contains(medinah.IndividualFacilityDescriptionId) ? "selected" : "")>
                                                                @medinah.Description
                                                            </!option>
                                                        }
                                                    </select>
                                                </div>
                                            </div>

                                            <div class="col-sm-10 col-md-3">
                                                <label class="form-label mt-3">Azizia</label>
                                                <div class="input-group input-group-merge">
                                                    <select class="form-control" name="PackageFacilitiesIds">
                                                        <option value="">Select Azizia Type</option>
                                                        @foreach (IndividualFacilityDescription azizia in ViewBag.Azizia)
                                                        {
                                                            <!option value="@azizia.IndividualFacilityDescriptionId"
                                                            @(ViewBag.SelectedIADFRoom.Contains(azizia.IndividualFacilityDescriptionId) ? "selected" : "")>
                                                                @azizia.Description
                                                            </!option>
                                                        }
                                                    </select>
                                                </div>
                                            </div>

                                            <div class="col-sm-10 col-md-3">
                                                <label class="form-label mt-3">Mina</label>
                                                <div class="input-group input-group-merge">
                                                    <select class="form-control" name="PackageFacilitiesIds">
                                                        <option value="">Select Mina</option>
                                                        @foreach (IndividualFacilityDescription camp in ViewBag.Camps)
                                                        {
                                                            <!option value="@camp.IndividualFacilityDescriptionId"
                                                            @(ViewBag.SelectedIADFRoom.Contains(camp.IndividualFacilityDescriptionId) ? "selected" : "")>
