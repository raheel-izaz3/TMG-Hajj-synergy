                                                    </select>
                                                </div>
                                            </div>
                                        </div>


                                         <div class="row mt-3">
                                            <!-- Adult PKR and SAR -->
                                            <div class="col-sm-12 col-md-4">
                                                <label class="form-label" asp-for="AdultPkr"></label>
                                                <span class="text-danger" asp-validation-for="AdultPkr"></span>
                                                <div class="input-group input-group-merge">
                                                    <span class="input-group-text">PKR</span>
                                                    <input class="form-control" asp-for="AdultPkr" readonly
                                                           oninput="pkrToOtherCurr('AdultPkr', 'AdultSar', 'AdultUsd'); formatCurrency(this);"
                                                           >
                                                </div>

                                                <label class="form-label mt-2" asp-for="AdultSar"></label>
                                                <span class="text-danger" asp-validation-for="AdultSar"></span>
                                                <div class="input-group input-group-merge">
                                                    <span class="input-group-text">SAR</span>
                                                    <input class="form-control" asp-for="AdultSar"
                                                           oninput="sarToOtherCurr('AdultSar', 'AdultPkr', 'AdultUsd', 'AdultEuro', 'AdultGbp', 'AdultAed'); formatCurrency(this);"
                                                           >
                                                </div>

                                                <label class="form-label mt-2" asp-for="AdultUsd"></label>
                                                <span class="text-danger" asp-validation-for="AdultUsd"></span>
                                                <div class="input-group input-group-merge">
                                                    <span class="input-group-text">USD</span>
                                                    <input class="form-control" asp-for="AdultUsd" readonly
                                                           oninput="usdToOtherCurr('AdultUsd', 'AdultPkr', 'AdultSar'); formatCurrency(this);"
                                                           >
                                                </div>

                                                <label class="form-label mt-2" asp-for="AdultEuro"></label>
                                                <span class="text-danger" asp-validation-for="AdultEuro"></span>
                                                <div class="input-group input-group-merge">
                                                    <span class="input-group-text">EUR</span>
                                                    <input class="form-control" asp-for="AdultEuro" readonly >
                                                </div>

                                                <label class="form-label mt-2" asp-for="AdultGbp"></label>
                                                <span class="text-danger" asp-validation-for="AdultGbp"></span>
                                                <div class="input-group input-group-merge">
                                                    <span class="input-group-text">GBP</span>
                                                    <input class="form-control" asp-for="AdultGbp" readonly >
                                                </div>

                                                <label class="form-label mt-2" asp-for="AdultAed"></label>
                                                <span class="text-danger" asp-validation-for="AdultAed"></span>
                                                <div class="input-group input-group-merge">
                                                    <span class="input-group-text">AED</span>
                                                    <input class="form-control" asp-for="AdultAed" readonly >
                                                </div>
                                            </div>

                                            <!-- Child Section -->
                                            <div class="col-sm-12 col-md-4">
                                                <label class="form-label" asp-for="ChildPkr"></label>
                                                <span class="text-danger" asp-validation-for="ChildPkr"></span>
                                                <div class="input-group input-group-merge">
