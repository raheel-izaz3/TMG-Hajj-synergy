    $(document).ready(function () {
        var travelRouteStops = @Html.Raw(Json.Serialize(ViewBag.Transportation));

        function populateTableByRouteId(selectedTravelRouteId) {
            var tableBody = $('#travelRouteTable tbody');
            tableBody.empty(); // Clear the table

            if (selectedTravelRouteId) {
                var filteredStops = travelRouteStops.filter(function (stop) {
                    return stop.travelRouteId == selectedTravelRouteId;
                });

                if (filteredStops.length > 0) {
                    $.each(filteredStops, function (index, stop) {
                        var row = `<tr>
                                        <td>${stop.startPlace} to ${stop.destination}</td>
                                        <td>${stop.checkIn}</td>
                                        <td>${stop.checkOut}</td>
                                        <td>${stop.transportType}</td>
                                        <td>${stop.vehicleType}</td>
                                    </tr>`;
                        tableBody.append(row);
                    });
                } else {
                    tableBody.append('<tr><td colspan="5">No data found.</td></tr>');
                }
            }
        }

        // Attach change event handler
        $('#travelRouteId').change(function () {
            var selectedTravelRouteId = $(this).val();
            populateTableByRouteId(selectedTravelRouteId);
        });

        // Check if there's a pre-selected value and trigger the data population
        var preSelectedTravelRouteId = $('#travelRouteId').val();
        if (preSelectedTravelRouteId) {
            populateTableByRouteId(preSelectedTravelRouteId);
        }

    });

    function showBox(elem) {
        var roomId = $(elem).val();
        var $currentSelect = $(elem);
        if (roomId) {
            $.ajax({
                url: '@Url.Action("GetDescriptionsForRoom", "Package")',
                type: 'POST',
                data: { roomId: roomId },
                success: function (data) {
                    $currentSelect.closest('.row').find('.facilityDescriptionsEdit').html(data);
                },
                error: function (xhr, status, error) {
                    console.log("An error occurred: " + xhr.responseText);
                }
            });
        } else {
            $currentSelect.closest('.row').find('.facilityDescriptionsEdit').empty();
        }
    }


