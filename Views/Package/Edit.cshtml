                                        @if (ViewBag.TrainingSessionsCount == 0)
                                        {
                                            <p class="text-danger">No Training Sessions Exists! <a asp-controller="Training" asp-action="Create">Please create training sessions first</a></p>
                                        }
                                        @{
                                            int i = 0;
                                        }
                                        @foreach (Training ts in ViewBag.TrainingSessions)
                                        {
                                            bool found = false;
                                            @foreach (PackageTrainings assigned in ViewBag.AssignedTrainings)
                                            {
                                                if (assigned.TrainingId == ts.TrainingId)
                                                {
                                                    found = true;
                                                    break;
                                                }
                                            }

                                            if (found)
                                            {
                                                <div class="col-sm-12">
                                                    <div>
                                                        <input asp-for="TrainingIds[i]" value="@ts.TrainingId" type="hidden" />
                                                        <input checked type="checkbox" asp-for="TrainingSelected[i]" class="form-check-input mr-1" id="ts_@i">
                                                        <label class="mx-2" for="ts_@i">@ts.TrainingCode - @ts.TrainingSession</label>
                                                    </div>
                                                </div>
                                            }
                                            else
                                            {
