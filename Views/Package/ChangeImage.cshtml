@{
    string modelName = "Package";
    string modelNamePlural = "Packages";
    string modelControllerRoute = "Package";
    TMG.Data.TMGDbContext _db;
}


<div class="container-xxl flex-grow-1 container-p-y">
    <h4 class="fw-bold" style="color:  #404040;"><span class="text-muted fw-light"> @modelName / </span> Change Image
    </h4>

    <hr class="mb-4" />

    <div class="row">
        <div class="col-sm-12">
            <div class="card mb-4">
                <div class="card-body">
                    <form method="post" enctype="multipart/form-data">
                        <input type="hidden" name="PackageId" value="@Model.PackageId" />
                        <div class="row">
                            <div class="col-sm-12 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname">Current Image</label>
                                <div class="input-group input-group-merge">
                                    <img src="~/@Model.Image" alt="" width="300">
                                </div>
                            </div>
                            <div class="col-sm-12 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname">New Image</label>
                                <span class="text-danger fw-bold"> *</span>
                                <div class="input-group input-group-merge">
                                    <input name="File" class="form-control" id="basic-icon-default-fullname" required type="file">
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-sm-12 mb-3">
                                <button type="submit" class="btn btn-warning float-end">Save Changes</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>