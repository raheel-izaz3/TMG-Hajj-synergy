@model PackageRegisterRequest

<style>
	.d-width {
		width: 111px;
	}

	.f-width {
		width: 185px;
	}
</style>

<div class="container-xxl flex-grow-1 container-p-y">
	<h4 class="fw-bold" style="color:  #404040;"><span class="text-muted fw-light">Package / </span> Create</h4>

	<hr class="mb-4" />

	<div class="row">
		<div class="col-sm-12">
			<div class="nav-align-top mb-4">
				<ul class="nav nav-pills mb-3 nav-fill" role="tablist">
					<li class="nav-item">
						<button type="button" class="nav-link active" role="tab" data-bs-toggle="tab"
								data-bs-target="#navs-pills-justified-company" aria-controls="navs-pills-justified-company"
								aria-selected="true">
							<i class='bx bx-package'></i>
							PACKAGE
						</button>
					</li>
					<li class="nav-item">
						<button type="button" class="nav-link " role="tab" data-bs-toggle="tab"
								data-bs-target="#navs-pills-justified-accommodation"
								aria-controls="navs-pills-justified-accommodation" aria-selected="false">
							<i class='bx bx-bed'></i>
							ACCOMMODATION
						</button>
					</li>
					<li class="nav-item">
						<button type="button" class="nav-link  form-control" role="tab" data-bs-toggle="tab"
								data-bs-target="#navs-pills-justified-career" aria-controls="navs-pills-justified-career"
								aria-selected="false">
							<i class='bx bx-medal'></i>
							TRANSPORT
						</button>
					</li>
					<li class="nav-item">
					<li class="nav-item">
						<button type="button" class="nav-link " role="tab" data-bs-toggle="tab"
								data-bs-target="#navs-pills-justified-training"
								aria-controls="navs-pills-justified-training" aria-selected="false">
							<i class='bx bx-gift'></i>
							TRAINING / GIFTS
						</button>
					</li>
					<li class="nav-item">
						<button type="button" class="nav-link " role="tab" data-bs-toggle="tab"
								data-bs-target="#navs-pills-justified-terms" aria-controls="navs-pills-justified-terms"
								aria-selected="false">
							<i class='bx bx-medal'></i>
							TERMS & CONDITION
						</button>
					</li>
					<li class="nav-item">
						<button type="button" class="nav-link " role="tab" data-bs-toggle="tab"
								data-bs-target="#navs-pills-justified-itinerary" aria-controls="navs-pills-justified-itinerary"
								aria-selected="false">
							<i class='bx bx-medal'></i>
							ITINERARY
						</button>
					</li>

					<li class="nav-item">
						<button type="button" class="nav-link " role="tab" data-bs-toggle="tab"
								data-bs-target="#navs-pills-justified-address" aria-controls="navs-pills-justified-address"
								aria-selected="false">
							<i class='bx bx-medal'></i>
							MAKTAB ADDRESS
						</button>
					</li>

				</ul>
				<form method="post" enctype="multipart/form-data">
					<div class="card">
						<div class="tab-content">
							<div class="tab-pane fade  show active" id="navs-pills-justified-company" role="tabpanel">
								<div class="col-xs-4">
									<h4 class="underline">Package Details</h4>
								</div>
								<div class="clearfix"></div>
								<hr>
								<div class="row">
									<div class="col-sm-6 col-md-3 mb-3">
										<label class="form-label" for="basic-icon-default-fullname"
											   asp-for="CompanyId"></label>
										<div class="input-group input-group-merge">
											<select class="form-select" asp-for="CompanyId"
													onchange="getQuota(this.value)">
												<option value="">Select Company...</option>
												@foreach (var c in ViewBag.Companies)
												{
													<option value="@c.CompanyId">@c.Company.CompanyName</option>
												}
											</select>
										</div>
										<span class="text-danger" asp-validation-for="CompanyId"></span>
									</div>
									<div class="col-sm-12 mb-3 col-md-2">
										<label class="form-label" for="basic-icon-default-fullname"
											   asp-for="PackageNumber"></label>
										<div class="input-group input-group-merge">
											<input class="form-control" placeholder="Enter Package #..."
												   asp-for="PackageNumber">
										</div>
										<span class="text-danger" asp-validation-for="PackageNumber"></span>
									</div>
									<div class="col-sm-12 mb-3 col-md-3">
										<label class="form-label" for="basic-icon-default-fullname"
											   asp-for="PackageCategoryZone"></label>
										<div class="input-group input-group-merge">
											<input class="form-control" asp-for="PackageCategoryZone">
										</div>
										<span class="text-danger" asp-validation-for="PackageCategoryZone"></span>
									</div>
									<div class="col-sm-12 mb-3 col-md-3">
										<label class="form-label" for="basic-icon-default-fullname"
											   asp-for="NearBy"></label>
										<div class="input-group input-group-merge">
											<input class="form-control" asp-for="NearBy">
										</div>
										<span class="text-danger" asp-validation-for="NearBy"></span>
									</div>
									<div class="col-sm-6 col-md-3 mb-3">
										<label class="form-label" for="basic-icon-default-fullname"
											   asp-for="PackageName"></label>
										<div class="input-group input-group-merge">
											<input asp-for="PackageName" class="form-control">
										</div>
										<span class="text-danger" asp-validation-for="PackageName"></span>
									</div>
									<div class="col-sm-12 col-md-3 mb-3">
										<label class="form-label" for="basic-icon-default-fullname"
											   asp-for="PackageCode"></label>
										<div class="input-group input-group-merge">
											<input class="form-control" asp-for="PackageCode">
										</div>
										<span class="text-danger" asp-validation-for="PackageCode"></span>
									</div>
									@* <div class="col-sm-12 col-md-3 mb-3">
                                        <label class="form-label" for="basic-icon-default-fullname"
                                               asp-for="PackageNumber"></label>
                                        <div class="input-group input-group-merge">
                                            <input class="form-control" asp-for="PackageNumber">
                                        </div>
                                        <span class="text-danger" asp-validation-for="PackageNumber"></span>
                                    </div> *@
									<div class="col-sm-12 col-md-2 mb-3">
										<label class="form-label" for="basic-icon-default-fullname"
											   asp-for="Days"></label>
										<div class="input-group input-group-merge">
											<input class="form-control" asp-for="Days">
										</div>
										<span class="text-danger" asp-validation-for="Days"></span>
									</div>
									<div class="col-sm-12 col-md-5 mb-3">
										<label class="form-label" for="basic-icon-default-fullname"
											   asp-for="TravelRouteId"></label>
										<div class="input-group input-group-merge">
											<select class="form-select" asp-for="TravelRouteId" id="travelRouteId">
												<option value="">Select Route...</option>
												@foreach (TravelRoute c in ViewBag.TravelRoutes)
												{
													<option value="@c.TravelRouteId">@c.RouteName</option>
												}
											</select>
										</div>
										<span class="text-danger" asp-validation-for="TravelRouteId"></span>
									</div>
									<div class="col-sm-12 col-md-2 mb-3">
										<label class="form-label" for="basic-icon-default-fullname"
											   asp-for="Color"></label>
										<div class="input-group input-group-merge">
											<input type="color" class="form-control" asp-for="Color" />
										</div>
										<span class="text-danger" asp-validation-for="Color"></span>
									</div>

									<div class="col-sm-12 col-md-4  mb-3">
										<label class="form-label" for="basic-icon-default-fullname" asp-for="Maktab"></label>
										<span class="fw-bold text-danger"> *</span>
										<div class="input-group input-group-merge">
											<input asp-for="Maktab" id="Maktab" class="form-control">
										</div>
										<span class="text-danger" asp-validation-for="Maktab"></span>
									</div>

									<div class="col-sm-12 col-md-4 mb-3">
										<label class="form-label" for="basic-icon-default-fullname" asp-for="MaktabNumber"></label>
										<span class="fw-bold text-danger"> *</span>
										<div class="input-group input-group-merge">
											<input asp-for="MaktabNumber" id="MaktabNumber" class="form-control">
										</div>
										<span class="text-danger" asp-validation-for="MaktabNumber"></span>
									</div>

									<div class="col-sm-12 col-md-3 mb-3">
										<label class="form-label" for="basic-icon-default-fullname"
											   asp-for="MedinaArrival"></label>
										<div class="input-group input-group-merge">
											<div class="form-check form-check-inline">
												<input class="form-check-input" asp-for="MedinaArrival" type="radio"
													   value="Before" id="before" checked>
												<label class="form-check-label" for="before">Before Hajj</label>
											</div>
											<div class="form-check form-check-inline">
												<input class="form-check-input" asp-for="MedinaArrival" type="radio"
													   value="After" id="after">
												<label class="form-check-label" for="after">After Hajj</label>
											</div>
										</div>
										<span class="text-danger" asp-validation-for="MedinaArrival"></span>
									</div>
									<div class="col-sm-12 col-md-3 mb-3">
										<label class="form-label" for="basic-icon-default-fullname"
											   asp-for="HajjDuration"></label>
										<div class="input-group input-group-merge">
											<div class="form-check form-check-inline">
												<input class="form-check-input" asp-for="HajjDuration" type="radio"
													   value="Short" id="shortDurationRadio" checked>
												<label class="form-check-label" for="shortDurationRadio">Short</label>
											</div>
											<div class="form-check form-check-inline">
												<input class="form-check-input" asp-for="HajjDuration" type="radio"
													   value="Long" id="longDurationRadio">
												<label class="form-check-label" for="longDurationRadio">Long</label>
											</div>
										</div>
										<span class="text-danger" asp-validation-for="HajjDuration"></span>
									</div>

									@* <div class="col-sm-12 col-md-3 mb-3">
                                    <label class="form-label" for="basic-icon-default-fullname"
                                    asp-for="PackageFoodIncluded"> </label>
                                    <div class="input-group input-group-merge">
                                    <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="checkbox" checked
                                    asp-for="PackageFoodIncluded" id="food">
                                    <label class="form-check-label" for="food">Yes</label>
                                    </div>

                                    </div>
                                    <span class="text-danger" asp-validation-for="PackageFoodIncluded"></span>
                                    </div>*@

									@* <div class="col-sm-12 col-md-3 mb-3">
                                        <label class="form-label" for="basic-icon-default-fullname"
                                               asp-for="PackageQurbaniIncluded"> </label>
                                        <div class="input-group input-group-merge">
                                            <div class="form-check form-check-inline">
                                                <input class="form-check-input" type="checkbox"
                                                       asp-for="PackageQurbaniIncluded" id="qurbani">
                                                <label class="form-check-label" for="qurbani">Yes</label>
                                            </div>

                                        </div>
                                        <span class="text-danger" asp-validation-for="PackageQurbaniIncluded"></span>
                                    </div> *@

									<hr class="col-sm-12 my-4">
									<div class="col-sm-12 mb-3">
										<label class="form-label" for="basic-icon-default-fullname">
											Upload Package
											Image
										</label>
										<div class="input-group input-group-merge">
											<input class="form-control" asp-for="FileImage">
										</div>
										<span class="text-danger" asp-validation-for="FileImage"></span>
									</div>

									<hr class="col-sm-12 my-4">

									<div class="col-sm-12 mb-3">
										<div class="row mb-2">
											<div class="col-xs-4">
												<h4 class="underline float-start">Package Category</h4>
											</div>
											<div class="col-sm-12 col-md-2">
												<label class="form-label" asp-for="PKRROE"></label>
												<div class="input-group input-group-merge">
													<span class="input-group-text">PKR </span>
													<input class="form-control" asp-for="PKRROE" id="PKRROE" value="@ViewBag.SARROE">
												</div>
											</div>
											<div class="col-sm-12 col-md-2">
												<label class="form-label" asp-for="USDROE"></label>
												<div class="input-group input-group-merge">
													<span class="input-group-text">USD </span>
													<input class="form-control" asp-for="USDROE" id="USDROE" value="@ViewBag.USDROE">
												</div>
											</div>
											<div class="col-sm-12 col-md-2">
												<label class="form-label" asp-for="GBPROE"></label>
												<div class="input-group input-group-merge">
													<span class="input-group-text">GBP </span>
													<input class="form-control" asp-for="GBPROE" id="GBPROE">
												</div>
											</div>
											<div class="col-sm-12 col-md-2">
												<label class="form-label" asp-for="EUROROE"></label>
												<div class="input-group input-group-merge">
													<span class="input-group-text">EUR </span>
													<input class="form-control" asp-for="EUROROE" id="EUROROE">
												</div>
											</div>
											<div class="col-sm-12 col-md-2">
												<label class="form-label" asp-for="AEDROE"></label>
												<div class="input-group input-group-merge">
													<span class="input-group-text">AED </span>
													<input class="form-control" asp-for="AEDROE" id="AEDROE">
												</div>
											</div>
										</div>

										<div class="row mb-2 mt-2">
											<div class="col-sm-10 col-md-3">
												<label class="form-label mt-3">Room Type</label>
												<div class="input-group input-group-merge">
													<select class="roomTypeSelect form-control" name="RoomIds">
														<option value="">Select Room Type</option>
														@foreach (var item in ViewBag.RoomName)
														{
															<option value="@item.RoomId">@item.RoomName</option>
														}
													</select>
												</div>
											</div>
											@* <div class="facilityDescriptions mt-4"></div> *@
											<div class="col-sm-10 col-md-3">
												<label class="form-label mt-3">Azizia Room Type</label>
												<div class="input-group input-group-merge">
													<select class="roomTypeSelect form-control" name="RoomTypesId">
														<option value="">Select Room Type</option>
														@foreach (var item in ViewBag.RoomName)
														{
															<option value="@item.RoomId">@item.RoomName</option>
														}
													</select>
												</div>
											</div>
										</div>



										<div class="row mb-2 mt-1">
											<div class="col-sm-10 col-md-3">
												<label class="form-label mt-3">Makkah</label>
												<div class="input-group input-group-merge">
													<select class="form-control" name="PackageFacilitiesIds">
														<option value="">Select Makkah Type</option>
														@foreach (IndividualFacilityDescription makkah in ViewBag.MakkahRooms)
														{
															<option value="@makkah.IndividualFacilityDescriptionId">@makkah.Description</option>
														}
													</select>
												</div>
											</div>
											<div class="col-sm-10 col-md-3">
												<label class="form-label mt-3">Medinah</label>
												<div class="input-group input-group-merge">
													<select class="form-control" name="PackageFacilitiesIds">
														<option value="">Select Medinah Type</option>
														@foreach (IndividualFacilityDescription medinah in ViewBag.Medinah)
														{
															<option value="@medinah.IndividualFacilityDescriptionId">@medinah.Description</option>
														}
													</select>
												</div>
											</div>
											<div class="col-sm-10 col-md-3">
												<label class="form-label mt-3">Azizia</label>
												<div class="input-group input-group-merge">
													<select class="form-control" name="PackageFacilitiesIds">
														<option value="">Select Azizia Type</option>
														@foreach (IndividualFacilityDescription azizia in ViewBag.Azizia)
														{
															<option value="@azizia.IndividualFacilityDescriptionId">@azizia.Description</option>
														}
													</select>
												</div>
											</div>
											<div class="col-sm-10 col-md-3">
												<label class="form-label mt-3">Mina</label>
												<div class="input-group input-group-merge">
													<select class="form-control" name="PackageFacilitiesIds">
														<option value="">Select Camp</option>
														@foreach (IndividualFacilityDescription mina in ViewBag.Mina)
														{
															<option value="@mina.IndividualFacilityDescriptionId">@mina.Description</option>
														}
													</select>
												</div>
											</div>
										</div>

										@* <div class="row mb-2 mt-2">
                                            <div class="col-sm-10 col-md-3">
                                                <label class="form-label mt-3">Camps</label>
                                                <div class="input-group input-group-merge">
                                                    <select class="form-control" asp-for="Camps">
                                                        <option value="">Select Camp</option>
                                                        @foreach (IndividualFacilityDescription camp in ViewBag.Camps)
                                                        {
                                                            <option value="@camp.IndividualFacilityDescriptionId">@camp.Description</option>
                                                        }
                                                    </select>
                                                </div>
                                            </div>
                                        </div> *@

										<div class="row mt-3">
											<!-- Adult PKR and SAR -->
											<div class="col-sm-12 col-md-4">
												<label class="form-label" asp-for="AdultPkr"></label>
												<span class="text-danger" asp-validation-for="AdultPkr"></span>
												<div class="input-group input-group-merge">
													<span class="input-group-text">PKR</span>
													<input class="form-control" asp-for="AdultPkr" readonly
														   oninput="pkrToOtherCurr('AdultPkr', 'AdultSar', 'AdultUsd'); formatCurrency(this);"
														   value="0">
												</div>

												<label class="form-label mt-2" asp-for="AdultSar"></label>
												<span class="text-danger" asp-validation-for="AdultSar"></span>
												<div class="input-group input-group-merge">
													<span class="input-group-text">SAR</span>
													<input class="form-control" asp-for="AdultSar"
														   oninput="sarToOtherCurr('AdultSar', 'AdultPkr', 'AdultUsd', 'AdultEuro', 'AdultGbp', 'AdultAed'); formatCurrency(this);"
														   value="0">
												</div>

												<label class="form-label mt-2" asp-for="AdultUsd"></label>
												<span class="text-danger" asp-validation-for="AdultUsd"></span>
												<div class="input-group input-group-merge">
													<span class="input-group-text">USD</span>
													<input class="form-control" asp-for="AdultUsd" readonly
														   oninput="usdToOtherCurr('AdultUsd', 'AdultPkr', 'AdultSar'); formatCurrency(this);"
														   value="0">
												</div>

												<label class="form-label mt-2" asp-for="AdultEuro"></label>
												<span class="text-danger" asp-validation-for="AdultEuro"></span>
												<div class="input-group input-group-merge">
													<span class="input-group-text">EUR</span>
													<input class="form-control" asp-for="AdultEuro" readonly value="0">
												</div>

												<label class="form-label mt-2" asp-for="AdultGbp"></label>
												<span class="text-danger" asp-validation-for="AdultGbp"></span>
												<div class="input-group input-group-merge">
													<span class="input-group-text">GBP</span>
													<input class="form-control" asp-for="AdultGbp" readonly value="0">
												</div>

												<label class="form-label mt-2" asp-for="AdultAed"></label>
												<span class="text-danger" asp-validation-for="AdultAed"></span>
												<div class="input-group input-group-merge">
													<span class="input-group-text">AED</span>
													<input class="form-control" asp-for="AdultAed" readonly value="0">
												</div>
											</div>

											<!-- Child Section -->
											<div class="col-sm-12 col-md-4">
												<label class="form-label" asp-for="ChildPkr"></label>
												<span class="text-danger" asp-validation-for="ChildPkr"></span>
												<div class="input-group input-group-merge">
													<span class="input-group-text">PKR</span>
													<input class="form-control" asp-for="ChildPkr" readonly
														   oninput="pkrToOtherCurr('ChildPkr', 'ChildSar', 'ChildUsd'); formatCurrency(this);"
														   value="0">
												</div>

												<label class="form-label mt-2" asp-for="ChildSar"></label>
												<span class="text-danger" asp-validation-for="ChildSar"></span>
												<div class="input-group input-group-merge">
													<span class="input-group-text">SAR</span>
													<input class="form-control" asp-for="ChildSar"
														   oninput="sarToOtherCurr('ChildSar', 'ChildPkr', 'ChildUsd', 'ChildEuro', 'ChildGbp', 'ChildAed'); formatCurrency(this);"
														   value="0">
												</div>

												<label class="form-label mt-2" asp-for="ChildUsd"></label>
												<span class="text-danger" asp-validation-for="ChildUsd"></span>
												<div class="input-group input-group-merge">
													<span class="input-group-text">USD</span>
													<input class="form-control" asp-for="ChildUsd" readonly
														   oninput="usdToOtherCurr('ChildUsd', 'ChildPkr', 'ChildSar'); formatCurrency(this);"
														   value="0">
												</div>

												<label class="form-label mt-2" asp-for="ChildEuro"></label>
												<span class="text-danger" asp-validation-for="ChildEuro"></span>
												<div class="input-group input-group-merge">
													<span class="input-group-text">EUR</span>
													<input class="form-control" asp-for="ChildEuro" readonly value="0">
												</div>

												<label class="form-label mt-2" asp-for="ChildGbp"></label>
												<span class="text-danger" asp-validation-for="ChildGbp"></span>
												<div class="input-group input-group-merge">
													<span class="input-group-text">GBP</span>
													<input class="form-control" asp-for="ChildGbp" readonly value="0">
