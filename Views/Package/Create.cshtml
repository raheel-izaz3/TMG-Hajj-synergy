	let firstRowTemplate = null;

	function addFlights() {
		var table = document.getElementById("flightsTable");
		if (!table) {
			console.error("Table element with ID 'flightsTable' not found.");
			return;
		}

		var tbody = table.getElementsByTagName('tbody')[0];
		if (!tbody) {
			// Create and append <tbody> if it doesn't exist
			tbody = document.createElement('tbody');
			table.appendChild(tbody);
		}

		// Initialize firstRowTemplate if not already done
		if (!firstRowTemplate) {
			firstRowTemplate = document.createElement('tr');
			firstRowTemplate.innerHTML = `
												<td>
													<button class="btn btn-icon btn-danger" type="button" onclick="deleteRow(this, null)">
														<i class='bx bxs-trash'></i>
													</button>
												</td>
												<td>
													<label class="form-label">Flight Type</label>
														<select class="form-control f-width" name="FlightTypes">
	@foreach (var item in ViewBag.FlightType)
	{
																										<option value="@item.Value">@item.Name</option>
	}
													</select>
												</td>
												<td>
													<label class="form-label">Airline</label>
														<select class="form-control f-width" name="AirlineIds">
	@foreach (var item in ViewBag.Airline)
	{
																										<option value="@item.AirlineId">@item.Name</option>
	}
													</select>
												</td>
												<td>
													<label class="form-label">Flight No.</label>
													<input type="text" class="form-control f-width" name="FlightNos" />
												</td>
												<td>
													<label class="form-label">Flight Class</label>
													<select class="form-control f-width" name="FlightClasses">
	@foreach (var item in ViewBag.FlightClass)
	{
																										<option value="@item.Value">@item.Name</option>
	}
													</select>
