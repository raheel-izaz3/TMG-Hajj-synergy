<script>
    // Bookings by Day Line Chart
    document.addEventListener('DOMContentLoaded', function () {
    // Access data from ViewBag
    var bookingCountsDaybyDay = JSON.parse(@Html.Raw(Json.Serialize(ViewBag.bookingCountsDaybyDay)));

    // Extract labels and data values
    var labels = [];
    var dataValues = [];
    for (var i = 0; i < bookingCountsDaybyDay.length; i++) {
    labels.push(bookingCountsDaybyDay[i].BookingDate);
    dataValues.push(bookingCountsDaybyDay[i].Bookings);
    }

    // Set chart theme
    anychart.theme('wines');

    // Create data set using the dynamic data
    var dataSet = anychart.data.set(getData());

    // Create line chart
    var chart = anychart.line();

    // Turn on chart animation
    chart.animation(true);

    // Turn on the crosshair
    chart.crosshair().enabled(true).yLabel(false).yStroke(null);

    // Set tooltip mode to point
    chart.tooltip().positionMode('point');
    chart.background("#f8f8f8");

    // Set yAxis title
    chart.yAxis().title('Number of Bookings');
    chart.xAxis().labels().padding(5);

    // Create series with mapped data
    var firstSeriesData = dataSet.mapAs({ x: 0, value: 1 });
    var firstSeries = chart.line(firstSeriesData);
    firstSeries.name('Bookings By Day');
    firstSeries.hovered().markers().enabled(true).type('circle').size(4);
    firstSeries.tooltip().position('right').anchor('left-center').offsetX(5).offsetY(5);
    firstSeries.stroke('#BB0000');

    // Set container id for the chart
    chart.container('BookingsByDayLine');

    // Draw the chart
    chart.draw();

    // Function to get dynamic data
    function getData() {
    var data = [];
    for (var i = 0; i < labels.length; i++) {
    data.push([labels[i], dataValues[i]]);
    }
    return data;
    }

    // Over all Booking
    var OverAllQuota = @Html.Raw(ViewBag.OverAllQuota);
    var OverAllQuotaTotalBooking = @Html.Raw(ViewBag.OverAllQuotaTotalBooking);
    var RemainingQuota = OverAllQuota - OverAllQuotaTotalBooking;

    anychart.onDocumentReady(function () {
    // create pie chart with passed data
    var chart = anychart.pie3d([
    ['Bookings', OverAllQuotaTotalBooking],
    ['Remaining', RemainingQuota],

    ]);

    // set chart title text settings
    chart
    .title('Overall Company Quota')
    // set chart radius
    .radius('43%');
    chart.background("#f8f8f8");
    // set container id for the chart
    chart.container('BookingsByDayPie');
    // initiate chart drawing
    chart.draw();
    });
    // Azziza Rooms
    anychart.onDocumentReady(function () {
    // create column chart
    var chart = anychart.column3d();

    // turn on chart animation
    chart.animation(true);

    // set chart title text settings
    chart.title('Azizia Hotel Rooms');

    // Access data from ViewBag
    var AziziaRoom = JSON.parse(@Html.Raw(Json.Serialize(ViewBag.AziziaRooms)));

    // Extract labels and data values
    var labelsA = [];
    var dataValuesA = [];
    for (var i = 0; i < AziziaRoom.length; i++) {
    labelsA.push(AziziaRoom[i].RoomName);
    dataValuesA.push(AziziaRoom[i].TotalRooms);
    }

    // create area series with dynamic data
    var series = chart.column(dataValuesA);

    var darkenedColor = anychart.color.darken("#BB0000", 0.01);
    series.fill(darkenedColor);
    chart.background("#f8f8f8");

    chart
    .tooltip()
    .position('center-top')
    .anchor('center-bottom')
    .offsetX(0)
    .offsetY(5)
    .format('{%Value}');

    // set scale minimum
    chart.yScale().minimum(0);

    // set yAxis labels formatter
    chart.yAxis().labels().format('{%Value}{groupsSeparator: }');
    chart.xAxis().labels().format(function () {
    return labelsA[this.index];
    });

    chart.tooltip().positionMode('point');
    chart.interactivity().hoverMode('by-x');

    chart.xAxis().title('Room Categories');
    chart.yAxis().title('Bookings');

    // set container id for the chart
    chart.container('AziziaRooms');

    // initiate chart drawing
    chart.draw();
    // console.log(AziziaRoom);
    });


