@{
    var clearedList = ViewBag.RecentReceiptsCleared as IEnumerable<Invoice> ?? Enumerable.Empty<Invoice>();
    var transitList = ViewBag.RecentReceiptsInTransit as IEnumerable<Invoice> ?? Enumerable.Empty<Invoice>();
    var totalCleared = clearedList.Sum(i => i.AmountRecived);
    var totalTransit = transitList.Sum(i => i.AmountRecived);

    long overAllQuota = 0;
    long overAllQuotaTotalBooking = 0;

    if (ViewBag.OverAllQuota != null) {
        long.TryParse(ViewBag.OverAllQuota.ToString(), out overAllQuota);
    }
    if (ViewBag.OverAllQuotaTotalBooking != null) {
        long.TryParse(ViewBag.OverAllQuotaTotalBooking.ToString(), out overAllQuotaTotalBooking);
    }
    long remainingQuota = overAllQuota - overAllQuotaTotalBooking;
}

