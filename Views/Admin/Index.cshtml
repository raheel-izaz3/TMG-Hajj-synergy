                            </thead>
                            <tbody>
                                @foreach (var spoC in ViewBag.SPOsCount)
                                {
                                    if (spoC.SPOEmail == currentUserEmail)
                                    {
                                        <tr>
                                            <td class="ps-3 fw-semibold text-dark">@spoC.SPOName</td>
                                            <td class="fw-bold text-dark" style="font-size: 14px;">
                                                <a class="text-success text-decoration-none" target="_blank" href="@Url.Action("SPOSummaryReport", "Report", new { spoId = spoC.SPOId, status = HajjiBookingStatus.Booked })">@spoC.Booked</a>
                                                <span class="text-muted mx-1">/</span>
                                                <a class="text-warning text-decoration-none" target="_blank" href="@Url.Action("SPOSummaryReport", "Report", new { spoId = spoC.SPOId, status = HajjiBookingStatus.Tentative })">@spoC.Tentative</a>
                                            </td>
                                            <td class="pe-3 text-end">
                                                <a target="_blank" href="@Url.Action("SPOPaymentReport", "Report", new { spoId = spoC.SPOId })" class="btn btn-sm btn-outline-crimson py-1 px-2 font-size-12 rounded">P/S</a>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- HOTEL OCCUPANCY & EXPORT CONTROLS FILTER BAR -->
    <div class="filter-bar d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div class="d-flex align-items-center gap-3 flex-wrap">
            <div class="d-flex align-items-center gap-2">
                <i class="bx bx-filter-alt text-muted fs-4"></i>
                <span class="fw-bold text-dark m-0">Hotel Occupancy Filter:</span>
            </div>
            <select class="form-select" name="HotelId" id="hotelDropdown" style="width: 250px; height: 38px; border-radius: 6px;">
                <option value="">All Hotels</option>
                @foreach (var hotel in ViewBag.Hotels)
                {
                    <option value="@hotel.HotelId">@hotel.HotelName</option>
                }
            </select>
        </div>
        <div>
            <button onclick="exportToPDF()" class="btn-pdf-export d-inline-flex align-items-center gap-2">
                <i class="bx bxs-file-pdf fs-5"></i> Export to PDF
            </button>
        </div>
    </div>

    <!-- Hotel Room Allocations Table -->
    <div id="roomCountContainer" class="card shadow-sm border-0 p-3 mb-4">
        @if (ViewBag.RoomCount != null)
        {
            @Html.Partial("_RoomCountTable", (List<AziziaRoomCountModel>)ViewBag.RoomCount)
        }
    </div>

    @if (ViewBag.IsAdmin)
    {
        <!-- BOOKINGS BY DAY LINE CHART -->
        <div class="row mb-4">
            <div class="col-12">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-white py-3 border-bottom d-flex align-items-center">
                        <i class="bx bx-trending-up me-2 fs-4 text-crimson"></i>
                        <h5 class="m-0 fw-bold text-dark fs-6">Bookings By Day</h5>
                    </div>
                    <div class="card-body p-3" style="height: 350px;">
                        <div id="BookingsByDayLine" style="width: 100%; height: 100%"></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- MUNAZZAM & OVERALL COMPANY QUOTA CHARTS -->
        <div class="row g-4 mb-4">
            <div class="col-12 col-md-6">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-white py-3 border-bottom d-flex align-items-center">
                        <i class="bx bx-pie-chart-alt me-2 fs-4 text-crimson"></i>
                        <h5 class="m-0 fw-bold text-dark fs-6">Booking by Munazzam</h5>
                    </div>
                    <div class="card-body p-3 d-flex align-items-center justify-content-center" style="height: 320px; overflow: hidden;">
                        <div id="Munazzam" style="width: 100%; height: 100%;"></div>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-6">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-white py-3 border-bottom d-flex align-items-center">
                        <i class="bx bx-doughnut-chart me-2 fs-4 text-crimson"></i>
                        <h5 class="m-0 fw-bold text-dark fs-6">Overall Company Quota</h5>
                    </div>
                    <div class="card-body p-3 d-flex align-items-center justify-content-center" style="height: 320px; overflow: hidden;">
                        <div id="BookingsByDayPie" style="width: 100%; height: 100%;"></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- RECEIPTS SECTIONS -->
        <div class="row g-4 mb-4">
            <!-- Receipts Cleared -->
            <div class="col-12 col-md-6">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-white py-3 border-bottom d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center">
                            <i class="bx bx-check-shield me-2 fs-4 text-success"></i>
                            <h5 class="card-title m-0 fw-bold text-dark fs-6">Receipts (Cleared)</h5>
                        </div>
                    </div>
                    <div class="card-body p-3">
                        @{
                            var recentCleared = ViewBag.RecentReceiptsCleared as List<Invoice>;
                        }
                        @if (recentCleared != null && recentCleared.Any())
                        {
                            <ul class="p-0 m-0 list-unstyled">
                                @foreach (Invoice inv in recentCleared)
                                {
                                    <li class="d-flex my-2 pb-2 border-bottom border-light">
                                        <div class="d-flex w-100 flex-wrap align-items-center justify-content-between gap-2">
                                            <div class="me-2">
                                                <small class="text-muted d-block mb-1">R#@inv.ProformaNumber</small>
                                                <h6 class="mb-0 text-dark fw-semibold">(@(inv.FamilyHead != null ? inv.FamilyHead.FcId : "")) @inv.Remarks</h6>
                                            </div>
                                            <div class="user-progress d-flex align-items-center gap-1">
                                                <h6 class="mb-0 text-success fw-bold">
                                                    +@inv.AmountRecived.ToString("N0")
                                                </h6> <span class="text-muted text-xs">@inv.Currency</span>
                                            </div>
                                        </div>
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <div class="text-center py-4 text-muted">
                                <i class="bx bx-info-circle fs-3 mb-2 d-block"></i>
                                No cleared receipts found.
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Receipts In Transit -->
            <div class="col-12 col-md-6">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-white py-3 border-bottom d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center">
                            <i class="bx bx-time me-2 fs-4 text-warning"></i>
                            <h5 class="card-title m-0 fw-bold text-dark fs-6">Receipts (In Transit)</h5>
                        </div>
                    </div>
                    <div class="card-body p-3">
                        @{
                            var recentTransit = ViewBag.RecentReceiptsInTransit as List<Invoice>;
                        }
                        @if (recentTransit != null && recentTransit.Any())
                        {
                            <ul class="p-0 m-0 list-unstyled">
                                @foreach (Invoice inv in recentTransit)
                                {
                                    <li class="d-flex my-2 pb-2 border-bottom border-light">
                                        <div class="d-flex w-100 flex-wrap align-items-center justify-content-between gap-2">
                                            <div class="me-2">
                                                <small class="text-muted d-block mb-1">R#@inv.ProformaNumber</small>
                                                <h6 class="mb-0 text-dark fw-semibold">(@(inv.FamilyHead != null ? inv.FamilyHead.FcId : "")) @inv.Remarks</h6>
                                            </div>
                                            <div class="user-progress d-flex align-items-center gap-1">
                                                <h6 class="mb-0 text-warning fw-bold">
                                                    +@inv.AmountRecived.ToString("N0")
                                                </h6> <span class="text-muted text-xs">@inv.Currency</span>
                                            </div>
                                        </div>
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <div class="text-center py-4 text-muted">
                                <i class="bx bx-info-circle fs-3 mb-2 d-block"></i>
                                No in-transit receipts found.
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<script>
    $(document).ready(function () {
        $('#hotelDropdown').change(function () {
            var hotelId = $(this).val();

            if (hotelId) {
                $.ajax({
                    url: '@Url.Action("Index", "Admin")',
                    type: 'GET',
                    data: { hotelId: hotelId },
                    success: function (response) {
                        $('#roomCountContainer').html(response);
                    },
                    error: function () {
                        alert('Error fetching data.');
                    }
                });
            }
        });
    });
</script>
