@model EmailVendor

@{
    string modelName = "EmailVendor";
    string modelNamePlural = "EmailVendor";
    string modelControllerRoute = "EmailVendor";
}


<div class="container-xxl flex-grow-1 container-p-y">
    <h4 class="fw-bold" style="color:  #404040;"><span class="text-muted fw-light"> @modelName / </span></h4>

    <hr class="mb-4" />

    <div class="row">
        <div class="col-sm-12">
            <div class="card mb-4">
                <div class="card-body">
                    <form method="post" asp-action="EmailVendor" enctype="multipart/form-data">
                        <div class="row">
                            <div class="col-sm-12 col-md-4 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname">Vendor</label>
                                <select class="form-control" name="VendorId">
                                    <option value="">Select Vendor</option>
                                    @foreach(VendorContactPerson vendor in ViewBag.Vendors)
                                    {
                                        <option value="@vendor.VendorContactPersonId">@vendor.Name - @vendor.Vendor.VendorName</option>
                                    }
                                </select>
                                <span class="text-danger"></span>
                            </div>
                            <div class="col-sm-12 col-md-4 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname" asp-for="Subject"></label>
                                <div class="input-group input-group-merge">
                                    <input asp-for="Subject" class="form-control">
                                </div>
                                <span class="text-danger" asp-validation-for="Subject"></span>
                            </div>
                            <div class="col-sm-12 col-md-4 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname" asp-for="Attachment"></label>
                                <div class="input-group input-group-merge">
                                    <input type="file" name="attachment" class="form-control">
                                </div>
                                <span class="text-danger" asp-validation-for="Attachment"></span>
                            </div>
                            <div class="col-sm-12 col-md-12 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname" asp-for="Message"></label>
                                <div class="input-group input-group-merge">
                                    <textarea asp-for="Message" class="form-control" id="summernote"></textarea>
                                </div>
                                <span class="text-danger" asp-validation-for="Message"></span>
                            </div>
                            <div class="col-sm-12 mt-4">
                                <button type="submit" class="btn btn-success float-end">Send & Save Email</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        $('select[name="VendorId"]').select2({
            placeholder: "Select Vendor",
            allowClear: true,
            width: '100%'
        });

        $('#summernote').summernote({
            height: 200,   
            placeholder: 'Write your message here...',
        });
    });
</script>