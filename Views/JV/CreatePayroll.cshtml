@model TMG.Models.Updated_Accounts.JV
@{
    string modelName = "PaymentVoucher";
    string modelNamePlural = "Payment Voucher";
    string modelControllerRoute = "NewPaymentVoucher";
}

<div class="container-xxl flex-grow-1 container-p-y">
    <h4 class="fw-bold" style="color: #404040;"><span class="text-muted fw-light"> @modelNamePlural / </span> Create</h4>
    <hr class="mb-4" />

    <div class="row">
        <div class="col-sm-12">
            <div class="card mb-4">
                <div class="card-body">
                    <form method="post" asp-action="CreatePayroll" id="PVForm" enctype="multipart/form-data">
                        <div class="row">

                            <div class="col-sm-12 col-md-5 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname">Date</label>
                                <div class="input-group input-group-merge">
                                    <input type="date" class="form-control" value="@DateTimeManager.Today" max="@DateTimeManager.Today" asp-for="Date">
                                </div>
                            </div>

                            <div class="col-sm-12 col-md-4 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname">Amount</label>
                                <div class="input-group input-group-merge">
                                    <input type="text" id="Amount" class="form-control" style="display: inline-block; width: auto;" oninput="formatNumber(this)" asp-for="Amount">
                                </div>
                                <span asp-validation-for="Amount" class="text-danger"></span>
                            </div>

                            <div class="col-sm-12 col-md-3 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname">Proof</label>
                                <div class="input-group input-group-merge">
                                    <input class="form-control" type="file" name="image">
                                </div>
                                <span asp-validation-for="InstrumentNumber" class="text-danger"></span>
                            </div>

                            <div class="col-sm-12 col-md-12 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname">Debit | Receiver Remarks</label>
                                <div class="input-group input-group-merge">
                                    <input class="form-control" id="debitRemarks" type="text" placeholder="Debit Remarks..." asp-for="DebitRemarks">
                                </div>
                                <span asp-validation-for="DebitRemarks" class="text-danger"></span>
                            </div>

                            <div class="col-sm-12 col-md-12 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname">Credit | Sender Remarks</label>
                                <div class="input-group input-group-merge">
                                    <input class="form-control" id="remarks" type="text" placeholder="Enter remarks..." asp-for="CreditRemarks">
                                </div>
                                <span asp-validation-for="CreditRemarks" class="text-danger"></span>
                            </div>

                            <hr class="my-3">

                            <div class="row pb-3 p-0">
                                <div class="col-sm-6">
                                    <p><b>Payment List</b></p>
                                </div>
                                <div class="col-sm-6 text-end">
                                    <button type="button" class="btn btn-primary btn-sm" onclick="addDebitRow()">Add Debit</button>
                                    <button type="button" class="btn btn-primary btn-sm" onclick="addCreditRow()">Add Credit</button>
                                </div>
                            </div>

                            <table class="table table-bordered">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Type</th>
                                        <th>Accounts</th>
                                        <th>Currency</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody id="paymentsBody">
                                </tbody>
                            </table>

                            <div class="col-sm-12 col-md-3 mb-3 mt-3">
                                <label class="form-label" for="basic-icon-default-fullname">ROE</label>
                                <div class="input-group input-group-merge">
                                    <input type="number" step="0.01" min="1" id="ROE" class="form-control" style="display: inline-block; width: auto;" asp-for="ROE">
                                </div>
                                <span asp-validation-for="ROE" class="text-danger"></span>
                            </div>

                            <hr class="my-3">

                            <div class="col-sm-12 col-md-6">
                                <p>
                                    <b>TOTAL DEBIT | RECEIVER: </b>
                                    <input id="totalDebit" readonly class="form-control" asp-for="TotalDebit" style="display: inline-block; width: auto;">
                                </p>
                            </div>

                            <div class="col-sm-12 col-md-6 text-end">
                                <p>
                                    <b>TOTAL CREDIT | SENDER: </b>
                                    <input id="totalCredit" readonly class="form-control" asp-for="TotalCredit" style="display: inline-block; width: auto;">
                                </p>
                            </div>

                        </div>

                        <div class="col-sm-12 mt-4">
                            <button type="button" onclick="submitForm()" class="btn btn-success float-end">Create</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    const accounts = @Html.Raw(Json.Serialize(ViewBag.Accounts));
    const accountNatures = @Html.Raw(Json.Serialize(ViewBag.AccountNatures));
    let paymentRowIndex = 0;

    // Function to add debit row
    function addDebitRow() {
    const $tableBody = $('#paymentsBody');

        const hajjiOptions = `
    @foreach (var employee in ViewBag.Hajji)
    {
            <option value="@employee.FamilyHeadId" data-type="Hajji">@employee.FullName</option>
    }

    @foreach (var vendors in ViewBag.Vendors)
    {
            <option value="@vendors.VendorId" data-type="Vendor">@vendors.VendorName</option>
    }

    @foreach (var expenses in ViewBag.Expenses)
    {
            <option value="@expenses.ExpenseSubTypeId" data-type="Expense">@expenses.ExpenseSubTypeName</option>
    }
    `;


    const $debitRow = $(`
    <tr class="payment-row" data-type="debit">
    <td>${paymentRowIndex + 1}</td>
    <td>
    <select class="form-control" name="Payments[${paymentRowIndex}].AccountNature" required readonly>
    <option value="0">Debit | Receiver</option>
    </select>
    </td>
    <td>
    <select class="form-control account-select" name="DebitId" required>
    <option value="">Select Hajji</option>
    ${hajjiOptions}
    </select>
    </td>
    <td>
    <input type="text" class="form-control currency" name="CurrencyD" readonly style="width: 80px;">
    </td>
    <td>
    <button type="button" class="btn btn-danger btn-sm" onclick="removeRow(this)">Remove</button>
    </td>
    </tr>
    `);

    $tableBody.append($debitRow);
    paymentRowIndex++;

    // Initialize Select2 for the new select element
    $debitRow.find('.account-select').select2({
    placeholder: "Select Account",
    allowClear: true,
    width: '100%',
    dropdownCssClass: 'form-control',
    selectionCssClass: 'form-control'
    });

    // Add event handler for account selection
    $debitRow.find('.account-select').on('change', function() {
    const selectedOption = $(this).find("option:selected");
    const selectedId = selectedOption.val();
    const selectedType = selectedOption.data("type"); // 👈 yeh zaroori hai
    const $row = $(this).closest('tr');


    if (selectedId) {
        $.ajax({
            url: '@Url.Action("GetCurrency", "JV")',
            type: 'GET',
            data: { id: selectedId, type: selectedType }, 
            success: function (currency) {
                $row.find('.currency').val(currency || 'PKR');
                calculateTotals();
            },
            error: function () {
                $row.find('.currency').val('PKR');
                console.log('Error fetching currency, defaulting to PKR');
                calculateTotals();
            }
        });

    }
    });

    // Add event handler for amount change
    $debitRow.find('.amount').on('input', function() {
    calculateTotals();
    });
    }

    // Function to add credit row
    function addCreditRow() {
    const $tableBody = $('#paymentsBody');

        const hajjiOptions = `
    @foreach (var employee in ViewBag.Hajji)
    {
            <option value="@employee.FamilyHeadId" data-type="Hajji">@employee.FullName</option>
    }

    @foreach (var vendors in ViewBag.Vendors)
    {
            <option value="@vendors.VendorId" data-type="Vendor">@vendors.VendorName</option>
    }

    @foreach (var expenses in ViewBag.Expenses)
    {
            <option value="@expenses.ExpenseSubTypeId" data-type="Expense">@expenses.ExpenseSubTypeName</option>
    }
    `;


        const $creditRow = $(`
            <tr class="payment-row" data-type="credit">
                <td>${paymentRowIndex + 1}</td>
                <td>
                    <select class="form-control" name="Payments[${paymentRowIndex}].AccountNature" required readonly>
                        <option value="1">Credit | Sender</option>
                    </select>
                </td>
                <td>
                    <select class="form-control account-select" name="CreditId" required>
                        <option value="">Select Hajji</option>
                        ${hajjiOptions}
                    </select>
                </td>
                <td>
                    <input type="text" class="form-control currency" name="CurrencyC" readonly style="width: 80px;">
                </td>
                <td>
                    <button type="button" class="btn btn-danger btn-sm" onclick="removeRow(this)">Remove</button>
                </td>
            </tr>
        `);

        $tableBody.append($creditRow);
        paymentRowIndex++;

        // Initialize Select2 for the new select element
        $creditRow.find('.account-select').select2({
            placeholder: "Select Account",
            allowClear: true,
            width: '100%',
            dropdownCssClass: 'form-control',
            selectionCssClass: 'form-control'
        });

        // Add event handler for account selection
        $creditRow.find('.account-select').on('change', function() {
            const selectedOption = $(this).find("option:selected");
            const selectedId = selectedOption.val();
            const selectedType = selectedOption.data("type"); // 👈 yeh zaroori hai
            const $row = $(this).closest('tr');


            if (selectedId) {
                $.ajax({
                    url: '@Url.Action("GetCurrency", "JV")',
                    type: 'GET',
                    data: { id: selectedId, type: selectedType },
                    success: function (currency) {
                        $row.find('.currency').val(currency || 'PKR');
                        calculateTotals();
                    },
                    error: function () {
                        $row.find('.currency').val('PKR');
                        console.log('Error fetching currency, defaulting to PKR');
                        calculateTotals();
                    }
                });
            }
        });

        // Add event handler for amount change
        $creditRow.find('.amount').on('input', function() {
            calculateTotals();
        });
    }

    // Function to remove a row
    function removeRow(button) {
        $(button).closest('tr').remove();
        renumberRows();
        calculateTotals();
    }

    // Function to renumber rows after deletion
    function renumberRows() {
        $('#paymentsBody tr').each(function(index) {
            $(this).find('td:first').text(index + 1);
        });
    }

    // Function to calculate totals
    // function calculateTotals() {
    //     let totalDebit = 0;
    //     let totalCredit = 0;

    //     $('.payment-row').each(function() {
    //         const amount = parseFloat($(this).find('.amount').val().replace(/,/g, '')) || 0;
    //         const rowType = $(this).data('type');

    //         if (rowType === 'debit') {
    //             totalDebit += amount;
    //         } else if (rowType === 'credit') {
    //             totalCredit += amount;
    //         }
    //     });

    //     $('#totalDebit').val(totalDebit.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
    //     $('#totalCredit').val(totalCredit.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
    // }

    function calculateTotals() {
        let amount = parseFloat($('#Amount').val().replace(/,/g, '')) || 0;

        $('#totalDebit').val(amount.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
        $('#totalCredit').val(amount.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
    }


    // For formatting input
    function formatNumber(input) {
        let value = input.value.replace(/,/g, ''); // Remove commas

        if (value === "") return;

        // Check if user typed decimal point at the end
        let hasDecimalWithoutFraction = value.endsWith(".");

        // Split parts
        let parts = value.split('.');
        let integerPart = parts[0];
        let decimalPart = parts[1] || '';

        // Format integer part with commas
        let formattedInteger = parseInt(integerPart).toLocaleString('en-US');

        // If user typed only '.', keep it at the end
        if (hasDecimalWithoutFraction) {
            input.value = `${formattedInteger}.`;
        }
        // If user typed decimal + digits, show both properly
        else if (decimalPart) {
            input.value = `${formattedInteger}.${decimalPart}`;
        }
        // If no decimal at all
        else {
            input.value = formattedInteger;
        }

        // Trigger totals calculation
        calculateTotals();
    }

    // Function to submit the form
    function submitForm() {
        const totalDebit = parseFloat($('#totalDebit').val().replace(/,/g, '')) || 0;
        const totalCredit = parseFloat($('#totalCredit').val().replace(/,/g, '')) || 0;
        let isValid = true;

        // Validate all rows have accounts selected
        $('.account-select').each(function() {
            if (!$(this).val()) {
                isValid = false;
                $(this).addClass('is-invalid');
            } else {
                $(this).removeClass('is-invalid');
            }
        });

        // Validate all rows have amounts
        $('.amount').each(function() {
            if (!$(this).val() || parseFloat($(this).val().replace(/,/g, '')) <= 0) {
                isValid = false;
                $(this).addClass('is-invalid');
            } else {
                $(this).removeClass('is-invalid');
            }
        });

        if (!isValid) {
            alert('Please fill all account selections and amounts!');
            return false;
        }

        if (totalCredit !== totalDebit) {
            alert('Total Debit and Total Credit must be equal!');
            return false;
        }

        $('#PVForm').submit();
    }

    // Loading the page
    $(document).ready(function () {
        // Add initial debit and credit rows
        addDebitRow();
        addCreditRow();

        // Initialize ROE change handler
        $('#ROE').on('change', function() {
            calculateTotals();
        });
    });
</script>