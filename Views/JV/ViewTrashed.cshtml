@model IEnumerable<TMG.Models.Updated_Accounts.JV>
@{
    string modelName = "JV";
    string modelNamePlural = "Journal Voucher";
    string modelControllerRoute = "JV";
}


@if (TempData.ContainsKey("restored"))
{
    if ((bool)TempData["restored"]! == true)
    {
        <script>
            toastr.options.closeDuration = 100;
            toastr.options.closeButton = true;
            toastr.options.positionClass = "toast-top-center";
            toastr.options.showMethod = 'slideDown';
            toastr.options.hideMethod = 'slideUp';
            toastr.options.closeMethod = 'slideUp';
            toastr.success('', '@modelName Restored Successfully!', { timeOut: 2000 })
        </script>
        TempData["restored"] = false;
    }
}

<div class="container-xxl flex-grow-1 container-p-y">
    <h4 class="fw-bold" style="color:  #404040;"><span class="text-muted fw-light">@modelNamePlural</span>  / Trash</h4>

    <hr class="mb-4" />
    <div class="card p-2">
        <div class="table-responsive text-nowrap ">
            <table class="table table-hover" id="table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Date</th>
                        <th>JV-#</th>
                        <th>Total Debit</th>
                        <th>Total Credit</th>
                        <th>Debit Remarks</th>
                        <th>Credit Remarks</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody class="table-border-bottom-1">
                    @{
                        int i = 0;
                    }
                    @foreach (var py in Model)
                    {
                        <tr>
                            <td>
                                <i class="fab fa-bootstrap fa-lg text-primary me-3"></i> <strong>@(++i)</strong>
                            </td>
                            <td>@py.Date.ToString("dd/MMM/yyyy")</td>
                            <td>@py.PaymentVoucherNo</td>
                            <td>@py.TotalDebit?.ToString("N2")</td>
                            <td>@py.TotalCredit?.ToString("N2")</td>
                            <td>@py.DebitRemarks</td>
                            <td>@py.CreditRemarks</td>
                            <td>
                                <div class="dropdown">
                                    <button class="btn btn-info" onclick="confirmRestore(@py.JVId)">
                                        <i class="bx bx-recycle me-1"></i> Restore
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
<script>
    function confirmRestore(id) {
        let del = confirm("Are you sure?")
        if (del) {
            location.href = `/@modelControllerRoute/Restore/${id}`;
        }
    }

    let table = new DataTable('#table', {
    });
</script>

