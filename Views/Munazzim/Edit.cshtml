@model Munazzim
@{
    string modelName = "Munazzim";
    string modelNamePlural = "Munazzims";
    string modelControllerRoute = "Munazzim";
}


<div class="container-xxl flex-grow-1 container-p-y">
    <h4 class="fw-bold" style="color:  #404040;"><span class="text-muted fw-light"> @modelName / </span>  Edit</h4>

    <hr class="mb-4" />

    <div class="row">
        <div class="col-sm-12">
            <div class="card mb-4">
                <div class="card-body">
                    <form method="post">
                        <input type="hidden" asp-for="MunazzimId"/>
                        <div class="row">
                            <div class="col-sm-12 col-md-6 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname"
                                    asp-for="ClusterNumber"></label>
                                <span class="text-danger fw-bold"> *</span>
                                <div class="input-group input-group-merge">
                                    <input asp-for="ClusterNumber" class="form-control" min="1">
                                </div>
                                <span class="text-danger" asp-validation-for="ClusterNumber"></span>
                            </div>
                            <div class="col-sm-12 col-md-6 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname" asp-for="Name"></label>
                                <span class="text-danger fw-bold"> *</span>
                                <div class="input-group input-group-merge">
                                    <input asp-for="Name" class="form-control">
                                </div>
                                <span class="text-danger" asp-validation-for="Name"></span>
                            </div>
                            <div class="col-sm-12 mb-3">
                                <a asp-action="ChangeStampFile" asp-route-id="@Model.MunazzimId">Change Stamp</a>
                                <a asp-action="ChangeCeoFile" asp-route-id="@Model.MunazzimId">Change CEO </a>
                            </div>
                             <div class="col-sm-12 mb-3">
                                        <label class="form-label" for="basic-icon-default-fullname">Select
                                            Companies</label>
                                        <br />
                                        @{
                                            int i = 0;
                                        }
                                        @foreach (var company in ViewBag.Companies)
                                        {
                                            bool found = false;
                                            foreach (MunazzimCompanies ac in ViewBag.AssignedCompanies)
                                            {
                                                if (ac.CompanyId == company.CompanyId)
                                                {
                                                    found = true;
                                                    break;
                                                }
                                            }

                                            <div class="form-check form-check-inline">
                                                <input type="hidden" value="@company.CompanyId" asp-for="CompaniesId" />

                                                @if (found)
                                                {
                                                    <input class="form-check-input" type="checkbox" id="@company.CompanyId"
                                                        asp-for="SelectedCompanies[i]" checked>
                                                }
                                                else
                                                {
                                                    <input class="form-check-input" type="checkbox" id="@company.CompanyId"
                                                        asp-for="SelectedCompanies[i]">
                                                }

                                                <label class="form-check-label"
                                                    for="@company.CompanyId">@company.CompanyName</label>
                                            </div>
                                            i++;
                                        }
                                    </div>

                            <div class="col-sm-12 mt-4">
                                <button type="submit" class="btn btn-warning float-end">Save Changes</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>