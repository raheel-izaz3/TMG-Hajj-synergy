@{
    string modelName = "Chart Of Account";
    string modelNamePlural = "Chart Of Accounts";
}

@{
    var types = ViewBag.Types as IEnumerable<Type>;
    var company = ViewBag.Company as IEnumerable<Company>;
    var subTypes = ViewBag.SubTypes as IEnumerable<SubType>;
    var categories = ViewBag.Categories as IEnumerable<Category>;
    var accounts = ViewBag.Accounts as IEnumerable<Account>;

}


<div class="container-xxl flex-grow-1 container-p-y">
    <h4 class="fw-bold" style="color:  #404040;"><span class="text-muted fw-light"></span> @modelNamePlural</h4>

    <hr class="mb-4" />
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-12">
                            <label>Select Company</label>
                            <div class="input-group input-group-merge">
                                <select class="form-select"  id="companyId" >
                                    <option>Select Company...</option>
                                    @foreach (var currentCompany in company)
                                    {
                                        <option value="@currentCompany.CompanyId">@currentCompany.CompanyName</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div class="col-md-12">
                            <input type="button" value="Filter" class="btn btn-primary" onclick="getCOA()"/>
                        </div>
                    </div>
                   
                </div>
            </div>
        </div>
    </div>


    <div class="row mt-5">
        <div class="col-md-12">
            <div class="card p-3">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Account Name</th>
                        </tr>
                    </thead>
                    <tbody id="tbody">
                    </tbody>
                </table>
            </div>

        </div>
    </div>
</div>



<script>
    function getCOA() {
        var companyId = $("#companyId").val();
        if (companyId) {
            $.ajax({
                url: "/ChartOfAccount/GetCOA/",
                data: { companyId: companyId},
                method: "GET",
                success: res => {
                    console.log(res)
                    let html = ``;
                    for (let type of res.types) {
                        html += `<tr><td>${type.typeId} - <span style="font-weight: bolder;">${type.name}</span></td></tr>`
                        for (let subtype of res.subTypes) {
                            if (subtype.typeId == type.typeId) {
                                html += ` <tr><td>${type.typeId}  - ${subtype.subTypeId}  - <span style="font-weight: 700;">${subtype.name}</span></td></tr>`
                                for (let category of res.categories) {
                                    if (subtype.subTypeId == category.subTypeId) {
                                        html += `<tr><td>${type.typeId}  - ${subtype.subTypeId} - ${category.categoryId} - <span style="font-weight: 600;">${category.name}</span></td></tr>`;
                                        for (let account of res.accounts) {
                                            if (category.categoryId == account.categoryId) {
                                                html += `<tr><td>${type.typeId}  - ${subtype.subTypeId} - ${category.categoryId} - ${account.accountId} <span style="font-weight: 600;">${account.name}</span></td></tr>`;
                                            }                                           
                                        }
                                    }                                   
                                }
                            }
                         }
                    }
                    $("#tbody").html(html);
                },
                error: err => {
                    console.log(err)
                }
            });
        } 
    }
</script>