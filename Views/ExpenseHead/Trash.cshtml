@model IEnumerable<TMG.Models.ExpenseModels.ExpenseHeadIndexViewModel>

@{
    ViewData["Title"] = "Trashed Expense Heads";
}

@if (TempData.ContainsKey("restored") && (bool)TempData["restored"]!)
{
    <script>
        toastr.options = { closeDuration: 100, closeButton: true, positionClass: "toast-top-center", showMethod: 'slideDown', hideMethod: 'slideUp' };
        toastr.success('', 'Expense Head Restored Successfully!', { timeOut: 2500 });
    </script>
}
@if (TempData.ContainsKey("deleted") && (bool)TempData["deleted"]!)
{
    <script>
        toastr.options = { closeDuration: 100, closeButton: true, positionClass: "toast-top-center", showMethod: 'slideDown', hideMethod: 'slideUp' };
        toastr.success('', 'Expense Head Permanently Deleted!', { timeOut: 2500 });
    </script>
}

<div class="container-xxl flex-grow-1 container-p-y">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="fw-bold m-0"><span class="text-muted fw-light">Expense Heads /</span> Trash</h4>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="bx bx-arrow-back me-1"></i> Back to Expense Heads
        </a>
    </div>

    <hr class="mb-4" />

    <div class="card p-3 shadow-sm">
        <div class="table-responsive text-nowrap">
            <table class="table table-hover" id="trashedTable">
                <thead>
                    <tr>
                        <th style="width: 80px;">#</th>
                        <th>Expense Name</th>
                        <th>Created At</th>
                        <th style="width: 200px;" class="text-center">Action</th>
                    </tr>
                </thead>
                <tbody class="table-border-bottom-0">
                    @{
                        int index = 1;
                    }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><strong>@index</strong></td>
                            <td>@item.ExpenseName</td>
                            <td>@item.CreatedAt.ToString("dd MMM, yyyy")</td>
                            <td class="text-center">
                                <div class="d-flex justify-content-center gap-1">
                                    <a asp-action="Restore" asp-route-id="@item.Id" class="btn btn-sm btn-info" title="Restore">
                                        <i class="bx bx-undo me-1"></i> Restore
                                    </a>
                                    <button type="button" onclick="confirmDeletePermanent(@item.Id, '@item.ExpenseName')" class="btn btn-sm btn-danger" title="Delete Permanently">
                                        <i class="bx bx-trash me-1"></i> Delete
                                    </button>
                                </div>
                            </td>
                        </tr>
                        index++;
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<form id="trashActionForm" method="post" action="" style="display:none;">
    @Html.AntiForgeryToken()
</form>

<script>
    function confirmDeletePermanent(id, name) {
        if (confirm("Are you sure you want to PERMANENTLY delete '" + name + "'? This action cannot be undone.")) {
            var form = document.getElementById('trashActionForm');
            form.action = '/ExpenseHead/DeletePermanent/' + id;
            form.submit();
        }
    }

    $(document).ready(function () {
        $('#trashedTable').DataTable({
            pageLength: 10,
            responsive: true,
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search trashed...",
                lengthMenu: "Show _MENU_ entries",
                info: "Showing _START_ to _END_ of _TOTAL_ entries",
                paginate: {
                    previous: "Previous",
                    next: "Next"
                }
            }
        });
    });
</script>
