@model TMG.Models.ReservationModels.RoomDetails
@{
    string modelName = "PO - Hotel";
    string modelNamePlural = "PO - Hotel";
    string modelControllerRoute = "POHotel";
}

@if (TempData.ContainsKey("created"))
{
    if ((bool)TempData["created"]! == true)
    {
        <script>
            toastr.options.closeDuration = 100;
            toastr.options.closeButton = true;
            toastr.options.positionClass = "toast-top-center";
            toastr.options.showMethod = 'slideDown';
            toastr.options.hideMethod = 'slideUp';
            toastr.options.closeMethod = 'slideUp';
            toastr.success('', '@modelName Created Successfully!', { timeOut: 2000 })
        </script>
        TempData["created"] = false;
    }
}
@if (TempData.ContainsKey("deleted"))
{
    if ((bool)TempData["deleted"]! == true)
    {
        <script>
            toastr.options.closeDuration = 100;
            toastr.options.closeButton = true;
            toastr.options.positionClass = "toast-top-center";
            toastr.options.showMethod = 'slideDown';
            toastr.options.hideMethod = 'slideUp';
            toastr.options.closeMethod = 'slideUp';
            toastr.success('', '@modelName Trashed Successfully!', { timeOut: 2000 })
        </script>
        TempData["deleted"] = false;
    }
}
@if (TempData.ContainsKey("updated"))
{
    if ((bool)TempData["updated"]! == true)
    {
        <script>
            toastr.options.closeDuration = 100;
            toastr.options.closeButton = true;
            toastr.options.positionClass = "toast-top-center";
            toastr.options.showMethod = 'slideDown';
            toastr.options.hideMethod = 'slideUp';
            toastr.options.closeMethod = 'slideUp';
            toastr.success('', '@modelName Updated Successfully!', { timeOut: 2000 })
        </script>
        TempData["updated"] = false;
    }
}

<<div class="container-xxl flex-grow-1 container-p-y">
	<h4 class="fw-bold" style="color:  #404040;"><span class="text-muted fw-light"> @modelName / </span> Edit</h4>

	<hr class="mb-4" />

	<div class="row">
		<div class="col-sm-12">
			<div class="card mb-4">
				<div class="card-body">
					<form method="post" asp-action="Edit">
                        <input type="hidden" name="RoomDetailsId" asp-for="@Model.RoomDetailsId" />
						<div class="row">
							<div class="col-sm-12 col-md-3 mb-3">
								<label class="form-label" for="basic-icon-default-fullname"> RoomNumber</label>
								<div class="input-group input-group-merge">
                                    <input type="text" value="" name="RoomNumber" class="form-control">
								</div>
							</div>
							<div class="col-sm-12 col-md-3 mb-3">
								<label class="form-label" for="basic-icon-default-fullname">Select BedType</label>
								<div class="input-group input-group-merge">
                                    <select name="RoomBedTypeId" class="form-control">
										<option value="">Select BedType...</option>
										@foreach (RoomBedType fh in ViewBag.RoomTypes)
										{
											<!option value="@fh.RoomBedTypeId">@fh.BedType</!option>
										}
									</select>
								</div>
								<span class="text-danger"></span>
							</div>
							
						
							<div class="col-sm-12 mt-4">
								<button type="submit" class="btn btn-primary float-end">Save Changes</button>
							</div>
						</div>
					</form>
				</div>
			</div>

		</div>
	</div>

</div>