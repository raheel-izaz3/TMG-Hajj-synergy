@model IEnumerable<RoomDetails>
@{
    string modelName = "PO - Hotel";
    string modelNamePlural = "PO - Hotel";
    string modelControllerRoute = "POHotel";
}

@if (TempData.ContainsKey("created"))
{
    if ((bool)TempData["created"]! == true)
    {
        <script>
            toastr.options.closeDuration = 100;
            toastr.options.closeButton = true;
            toastr.options.positionClass = "toast-top-center";
            toastr.options.showMethod = 'slideDown';
            toastr.options.hideMethod = 'slideUp';
            toastr.options.closeMethod = 'slideUp';
            toastr.success('', '@modelName Created Successfully!', { timeOut: 2000 })
        </script>
        TempData["created"] = false;
    }
}
@if (TempData.ContainsKey("deleted"))
{
    if ((bool)TempData["deleted"]! == true)
    {
        <script>
            toastr.options.closeDuration = 100;
            toastr.options.closeButton = true;
            toastr.options.positionClass = "toast-top-center";
            toastr.options.showMethod = 'slideDown';
            toastr.options.hideMethod = 'slideUp';
            toastr.options.closeMethod = 'slideUp';
            toastr.success('', '@modelName Trashed Successfully!', { timeOut: 2000 })
        </script>
        TempData["deleted"] = false;
    }
}
@if (TempData.ContainsKey("updated"))
{
    if ((bool)TempData["updated"]! == true)
    {
        <script>
            toastr.options.closeDuration = 100;
            toastr.options.closeButton = true;
            toastr.options.positionClass = "toast-top-center";
            toastr.options.showMethod = 'slideDown';
            toastr.options.hideMethod = 'slideUp';
            toastr.options.closeMethod = 'slideUp';
            toastr.success('', '@modelName Updated Successfully!', { timeOut: 2000 })
        </script>
        TempData["updated"] = false;
    }
}

<div class="container-xxl flex-grow-1 container-p-y">
    <h4 class="fw-bold"><span class="text-muted fw-light"></span> @modelNamePlural</h4>

    <hr class="mb-4" />


    <a asp-action="Create" asp-route-hotelId="@ViewBag.POHotelsId" class="btn btn-info">Create New</a>
    <a asp-action="ViewTrash" class="btn btn-info float-end"><i class="bx bx-trash me-1"></i> Trash (@ViewBag.Trashed)</a>
    <br />
    <br />
    <div class="card p-2">
        <div class="table-responsive text-nowrap ">
            <table class="table table-hover" id="table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>ROOM #</th>
                        <th>PAX</th>
                        <th>ROOM TYPE</th>
                        <th>BED TYPE</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody class="table-border-bottom-1">
                    @{
                        int i = 0;
                    }
                    @foreach (RoomDetails po in Model)
                    {
                        <tr>
                            <td>
                                <i class="fab fa-bootstrap fa-lg text-primary me-3"></i> <strong>@(++i)</strong>
                            </td>
                            <td>@(po.RoomNumber ?? "N/A")</td>
                            <td>@(po.Room?.PAX ?? 0)</td>
                            <td>@(po.Room?.RoomCode ?? "N/A")</td>
                            <td>@(po.RoomBedType?.BedType ?? "N/A")</td> <!-- ✅ Handle null case -->
                            <td>
                                <div class="dropdown">
                                    @* <a class="btn btn-warning" asp-action="Print" asp-route-id="@po.POTicketId"><i class="bx bx-printer me-1"></i> Print</a> *@
                                    <a class="btn btn-warning" asp-action="Edit" asp-route-id="@po.RoomDetailsId"><i class="bx bx-printer me-1"></i> Edit</a>
                                    @* <a class="btn btn-warning" asp-action="AddPassenger" asp-route-id="@po.POTicketId"><i class="bx bx-edit-alt me-1"></i> Add</a> *@
                                    <button onclick="confirmDelete(@po.RoomDetailsId)" class="btn btn-outline-danger"><i class="bx bx-trash me-1"></i> Trash</button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
<script>
    function confirmDelete(id) {
        let del = confirm("Are you sure?")
        if (del) {
            location.href = `/@modelControllerRoute/Trash/${id}`;
        }
    }

    let table = new DataTable('#table', {
    });
</script>

