    <input type="hidden" id="PKRROE" value="@ViewBag.FamilyROE?.PKRROE">
    <input type="hidden" id="USDROE" value="@ViewBag.FamilyROE?.USDROE">
}
else
{
    <input type="hidden" id="SARROE" value="@ViewBag.ROE?.SARROE">
    <input type="hidden" id="PKRROE" value="@ViewBag.ROE?.PKRROE">
