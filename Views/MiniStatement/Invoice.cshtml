<script>

    function stampToggle(input) {
        if (input.checked == true) {
            document.getElementById('company_stamp').style.display = "block"
        } else {
            document.getElementById('company_stamp').style.display = "none"
        }
    }

    function forCompany(input) {
        if (input.checked == false) {
            document.getElementById('forCompany').style.display = 'none'
            document.getElementById('forSelf').style.display = 'block'
        } else {
            document.getElementById('forCompany').style.display = 'block'
            document.getElementById('forSelf').style.display = 'none'
        }
    }

    @* function getFormattedDate() {

        const today = new Date();
        const sevenDaysLater = new Date(today);
        sevenDaysLater.setDate(today.getDate() + 7);

        const options = { day: '2-digit', month: 'long', year: 'numeric' };
        let formattedDate = sevenDaysLater.toLocaleDateString('en-US', options);

        formattedDate = formattedDate.replace(',', '');
        const [monthName, day, year] = formattedDate.split(' ');

        const formattedDateResult = `${day}-${monthName}-${year}`;
        return formattedDateResult;
        }

        document.getElementById("validDate").innerHTML = getFormattedDate(); *@

        function showPkr(input) {
            if (input.checked == false) {
                document.getElementById('pkrcurrency').style.display = 'none'
            } else {
                document.getElementById('pkrcurrency').style.display = 'block'
            }
        }
    function showUsd(input) {
        if (input.checked == false) {
            document.getElementById('usdcurrency').style.display = 'none'
        } else {
            document.getElementById('usdcurrency').style.display = 'block'
        }
    }
    function showSar(input) {
        if (input.checked == false) {
            document.getElementById('sarcurrency').style.display = 'none'
        } else {
            document.getElementById('sarcurrency').style.display = 'block'
        }
    }
    function calculateAge(dateOfBirth) {
        let full_date = new Date(dateOfBirth);
        let only_date = full_date.toISOString().split('T')[0];

        var dob = new Date(full_date);
        var currentDate = new Date();
        var age = currentDate.getFullYear() - dob.getFullYear();
        if (
            currentDate.getMonth() < dob.getMonth() ||
            (currentDate.getMonth() === dob.getMonth() && currentDate.getDate() < dob.getDate())
        ) {
            age--;
        }

        return age;
    }


    function getFamilyDetail(familyId) {
        $.ajax({
            url: `/MiniStatement/GetFamilyDetail/${familyId}`,
            method: "GET",
            success: res => {
                opt.filename = res.headNameWithId + " Proforma Invoice.pdf";

                document.getElementById('company_name').innerText = res.company[0].companyName
                document.getElementById('company_address').innerText = res.companyAddress[0].address
                document.getElementById('company_zip').innerText = res.companyAddress[0].zipCode
                document.getElementById('company_country').innerText = res.companyAddress[0].country
                document.getElementById('company_city').innerText = res.companyAddress[0].city

                document.getElementById('company_email').innerText = res.companyEmail[0].companyEmail
                document.getElementById('company_phone').innerText = res.companyContact[0].companyContact
                document.getElementById('company_website').innerText = res.company[0].website

                document.getElementById('givenName').innerText = res.familyHead[0].givenName
                document.getElementById('surName').innerText = res.familyHead[0].surName
                document.getElementById('cnic').innerText = res.familyHead[0].cnic
                document.getElementById('passport').innerText = res.familyHead[0].passportNumber
                document.getElementById('contact').innerText = res.familyHeadContact
                document.getElementById('email').innerText = res.familyHeadEmail
                document.getElementById('address').innerText = res.familyHeadAddress
                document.getElementById('fcId').innerText = `HB #${res.familyHead[0].familyHeadId}`

                document.getElementById('pkrpackagename').innerText = res.familyHead[0].package.name
                document.getElementById('usdpackagename').innerText = res.familyHead[0].package.name
                document.getElementById('sarpackagename').innerText = res.familyHead[0].package.name

                let invoicefullDate = new Date(res.familyHead[0].createdAt);
                let invoiceonlyDate = invoicefullDate.toISOString().split('T')[0];

                document.getElementById('invoice_number').innerText = "INV-" + res.familyHead[0].familyHeadId
                document.getElementById('invoice_date').innerText = invoiceonlyDate
                document.getElementById('spo_name').innerText = res.spo[0].spo.name

                let countMember = res.familyMember.length
                document.getElementById('pax').innerText = countMember


                //company
                document.getElementById('c_givenName').innerText = res.familyHead[0].givenName
                document.getElementById('c_surName').innerText = res.familyHead[0].surName
                document.getElementById('c_cnic').innerText = res.familyHead[0].cnic
                document.getElementById('c_passport').innerText = res.familyHead[0].passportNumber
                document.getElementById('c_contact').innerText = res.familyHeadContact
                document.getElementById('c_email').innerText = res.familyHeadEmail
                document.getElementById('c_address').innerText = res.familyHeadAddress
                document.getElementById('c_fcId').innerText = `HB #${res.familyHead[0].familyHeadId}`



                document.getElementById('c_invoice_number').innerText = "INV-" + res.familyHead[0].familyHeadId
                document.getElementById('c_invoice_date').innerText = invoiceonlyDate
                document.getElementById('c_spo_name').innerText = res.spo[0].spo.name
                document.getElementById('c_pax').innerText = countMember


                // PKR Package Price


                let basicAirlinePkr = 0;
                let basicDifferentPkr = 0;

                let basicAirlineSar = 0;
                let basicDifferentSar = 0;

                let basicAirlineUsd = 0;
                let basicDifferentUsd = 0;

                let pkrpackageprice = 0
                let pkradditional = 0
                let pkraddons = 0
                let pkrextras = 0

                let sarpackageprice = 0
                let saradditional = 0
                let saraddons = 0
                let sarextras = 0

                let usdpackageprice = 0
                let usdadditional = 0
                let usdaddons = 0
                let usdextras = 0;

                for (let i of res.familyMember) {
                    if (i.familyHead.flightTicketType == 0) {

                        basicAirlinePkr += i.package.flightTicketPricePkr
                        basicAirlineSar += i.package.flightTicketPriceSar
                        basicAirlineUsd += i.package.flightTicketPriceUsd

                        basicDifferentPkr += 0
                        basicDifferentSar += 0
                        basicDifferentUsd += 0

                    } else if (i.familyHead.flightTicketType == 1) {

                        basicAirlinePkr += 0;
                        basicAirlineSar += 0;
                        basicAirlineUsd += 0;

                        basicDifferentPkr += 0
                        basicDifferentSar += 0
                        basicDifferentUsd += 0

                    } else if (i.familyHead.flightTicketType == 2) {

                        basicAirlinePkr += i.package.flightTicketPricePkr
                        basicAirlineSar += i.package.flightTicketPriceSar
                        basicAirlineUsd += i.package.flightTicketPriceUsd

                        basicDifferentPkr += i.familyHead.flightTicketDifferencesPkr
                        basicDifferentSar += i.familyHead.flightTicketDifferencesSar
                        basicDifferentUsd += i.familyHead.flightTicketDifferencesUsd

                    }


                    if (calculateAge(i.familyMember.familyHead.dateOfBirth) < 2) {

                        pkrpackageprice += parseInt(i.package.infantPkr)
                        sarpackageprice += parseInt(i.package.infantSar)
                        usdpackageprice += parseInt(i.package.infantUsd)

                    } else if (calculateAge(i.familyMember.familyHead.dateOfBirth) < 12) {

                        pkrpackageprice += parseInt(i.package.childPkr)
                        sarpackageprice += parseInt(i.package.childSar)
                        usdpackageprice += parseInt(i.package.childUsd)

                    } else {

                        pkrpackageprice += parseInt(i.package.adultPkr)
                        sarpackageprice += parseInt(i.package.adultSar)
                        usdpackageprice += parseInt(i.package.adultUsd)

                    }

                    for (let j of res.packageAddons) {
                        if (i.familyHead.package.packageId == j.packageId) {
                            pkraddons += parseInt(j.pkrPrice)
                            saraddons += parseInt(j.sarPrice)
                            usdaddons += parseInt(j.usdPrice)
                        }
                    }

                }

                for (let i of res.additionalFacility) {
                    if (calculateAge(i.familyHead.dateOfBirth) < 2) {

                        pkradditional += parseInt(i.additionalFacilities.infantPkr)
                        saradditional += parseInt(i.additionalFacilities.infantSar)
                        usdadditional += parseInt(i.additionalFacilities.infantUsd)

                    } else if (calculateAge(i.familyHead.dateOfBirth) < 12) {

                        pkradditional += parseInt(i.additionalFacilities.childPkr)
                        saradditional += parseInt(i.additionalFacilities.childSar)
                        usdadditional += parseInt(i.additionalFacilities.childUsd)

                    } else {

                        pkradditional += parseInt(i.additionalFacilities.adultPkr)
                        saradditional += parseInt(i.additionalFacilities.adultSar)
                        usdadditional += parseInt(i.additionalFacilities.adultUsd)

                    }

                }
                console.log(res)

                for (let i of res.extrasAdfs) {
                    pkrextras += parseInt(i.price ?? 0)
                    sarextras += parseInt(i.priceSar ?? 0)
                    usdextras += parseInt(i.priceUsd ?? 0)
                }




                document.getElementById('pkrpackage').innerText = (pkrpackageprice + pkraddons).toLocaleString();
                document.getElementById('sarpackage').innerText = (sarpackageprice + saraddons).toLocaleString();
                document.getElementById('usdpackage').innerText = (usdpackageprice + usdextras).toLocaleString();

    @* if (!res.isTentative) { *@
                    document.getElementById('pkradditional').innerText = pkradditional.toLocaleString();
    @* document.getElementById('pkraddons').innerText = pkraddons.toLocaleString(); *@
                    document.getElementById('pkrextras').innerText = pkrextras.toLocaleString();

                document.getElementById('saradditional').innerText = saradditional.toLocaleString();
    @* document.getElementById('saraddons').innerText = saraddons.toLocaleString(); *@
                    document.getElementById('sarextras').innerText = sarextras.toLocaleString();

                document.getElementById('usdadditional').innerText = usdadditional.toLocaleString();
    @* document.getElementById('usdaddons').innerText = usdaddons.toLocaleString(); *@
                    document.getElementById('usdextras').innerText = usdextras.toLocaleString();

    @* } *@



                    document.getElementById('basicAirlinePkr').innerText = basicAirlinePkr.toLocaleString();
                document.getElementById('basicDifferencePkr').innerText = `${basicDifferentPkr.toLocaleString()}`;

                document.getElementById('basicAirlineSar').innerText = basicAirlineSar.toLocaleString();
                document.getElementById('basicDifferenceSar').innerText = `${basicDifferentSar.toLocaleString()}`;

                document.getElementById('basicAirlineUsd').innerText = basicAirlineUsd.toLocaleString();
                document.getElementById('basicDifferenceUsd').innerText = `${basicDifferentUsd.toLocaleString()}`;


                // PKR Member
