                    } else if (calculateAge(i.familyMember.familyHead.dateOfBirth) < 12) {
                        // child
                        pkrtotalamount += i.package.childPkr
                        pkrpackage += i.package.childPkr
                        pkrmember += `<th>${i.package.childPkr}</th>`
                        var pkraddfacility = 0;
                        for (let j of res.additionalFacility) {
                            if (i.familyMember.familyHeadId == j.familyHeadId) {
                                if (i.package.packageId == j.additionalFacilities.packageId) {
                                    pkraddfacility += parseInt(j.additionalFacilities.childPkr)

                                }
                            }
                        }

                        pkrmember += `<th>${pkraddfacility.toLocaleString()}</th>`

                    } else {

                        // adult
                        pkrtotalamount += i.package.adultPkr
                        pkrpackage += i.package.adultPkr
                        pkrmember += `<th>${i.package.adultPkr}</th>`
                        var pkraddfacility = 0;
                        for (let j of res.additionalFacility) {
                            if (i.familyMember.familyHeadId == j.familyHeadId) {
                                if (i.package.packageId == j.additionalFacilities.packageId) {
                                    pkraddfacility += parseInt(j.additionalFacilities.adultPkr)
                                }
                            }
                        }
                        pkrmember += `<th>${pkraddfacility.toLocaleString()}</th>`

                    }


                    pkrtotalamount += pkraddfacility;
                    var pkrpacaddon = 0;
                    for (let j of res.packageAddons) {
                        if (i.package.packageId == j.packageId) {
                            pkrpacaddon += parseInt(j.pkrPrice)

                        }
                    }
                    pkrtotalamount += pkrpacaddon;

                    pkrmember += `<th>${pkrpacaddon.toLocaleString()}</th>`
                    pkrmember += `<th>${(pkrtotalamount / a).toLocaleString()}</th>`
                    pkrmember += `<th>${i.package.sarroe}</th>`
                    pkrmember += `<th>${i.package.usdroe}</th>`
                    pkrmember += `</tr>`
                }

                $('#pkrmember').html(pkrmember)

                // SAR Member

                let sarmember = "";
                let sartotalamount = 0;
                let sardiscount = 0;
                let sarpackage = 0;

                var a = 0;
                for (let i of res.familyMember) {
                    a += 1;
                    sardiscount = i.familyMember.familyHead.sarDiscountAmount;

                    sarmember += `<tr>`
                    sarmember += `<th>${i.familyMember.familyHead.givenName} ${i.familyMember.familyHead.surName}</th>`
                    if (calculateAge(i.familyMember.familyHead.dateOfBirth) < 2) {
                        sarmember += `<th>${i.package.infantSar}</th>`
                        sartotalamount += parseInt(i.package.infantSar)
                        sarpackage += parseInt(i.package.infantSar)
                        var saraddfacility = 0;
                        for (let j of res.additionalFacility) {
                            if (i.familyMember.familyHeadId == j.familyHeadId) {
                                if (i.package.packageId == j.additionalFacilities.packageId) {
                                    saraddfacility += parseInt(j.additionalFacilities.infantSar)

                                }
                            }
                        }


                        sarmember += `<th>${saraddfacility.toLocaleString()}</th>`

                    } else if (calculateAge(i.familyMember.familyHead.dateOfBirth) < 12) {
                        sarmember += `<th>${i.package.childSar}</th>`
                        sartotalamount += parseInt(i.package.childSar)
                        sarpackage += parseInt(i.package.childSar)
                        var saraddfacility = 0;
                        for (let j of res.additionalFacility) {
                            if (i.familyMember.familyHeadId == j.familyHeadId) {
                                if (i.package.packageId == j.additionalFacilities.packageId) {
                                    saraddfacility += parseInt(j.additionalFacilities.childSar)

                                }
                            }
                        }

                        sarmember += `<th>${saraddfacility.toLocaleString()}</th>`


                    } else {
                        sarmember += `<th>${i.package.adultSar}</th>`
                        sartotalamount += parseInt(i.package.adultSar)
                        sarpackage += parseInt(i.package.adultSar)
                        var saraddfacility = 0;
                        for (let j of res.additionalFacility) {
                            if (i.familyMember.familyHeadId == j.familyHeadId) {
                                if (i.package.packageId == j.additionalFacilities.packageId) {
                                    saraddfacility += parseInt(j.additionalFacilities.adultSar)
                                }
                            }
                        }

                        sarmember += `<th>${saraddfacility.toLocaleString()}</th>`


                    }

                    sartotalamount += saraddfacility
                    var sarpacaddon = 0;
                    for (let j of res.packageAddons) {
                        if (i.package.packageId == j.packageId) {
                            sarpacaddon += parseInt(j.sarPrice)
                        }
                    }
                    sartotalamount += sarpacaddon
                    sarmember += `<th>${sarpacaddon.toLocaleString()}</th>`

                    sarmember += `<th>${(sartotalamount / a).toLocaleString()}</th>`
                    sarmember += `<th>${i.package.sarroe}</th>`
                    sarmember += `<th>${i.package.usdroe}</th>`
                    sarmember += `</tr>`
                }
                $('#sarmember').html(sarmember)



                // USD Member

                let usdmember = "";
                let usdtotalamount = 0;
                let usddiscount = 0;
                let usdpackage = 0;
                var a = 0;
                for (let i of res.familyMember) {


                    usddiscount += i.familyMember.familyHead.usdDiscountAmount;
                    a += 1
                    usdmember += `<tr>`
                    usdmember += `<th>${i.familyMember.familyHead.givenName} ${i.familyMember.familyHead.surName}</th>`
                    if (calculateAge(i.familyMember.familyHead.dateOfBirth) < 2) {
                        usdmember += `<th>${i.package.infantUsd}</th>`
                        usdtotalamount += i.package.infantUsd
                        usdpackage += i.package.infantUsd
                        var usdaddfacility = 0;
                        for (let j of res.additionalFacility) {
                            if (i.familyMember.familyHeadId == j.familyHeadId) {
                                if (i.package.packageId == j.additionalFacilities.packageId) {
                                    usdaddfacility += parseInt(j.additionalFacilities.infantUsd)
                                }
                            }

                        }

                        usdmember += `<th>${usdaddfacility.toLocaleString()}</th>`

                    } else if (calculateAge(i.familyMember.familyHead.dateOfBirth) < 12) {
                        usdmember += `<th>${i.package.childUsd}</th>`
                        usdtotalamount += i.package.childUsd
                        usdpackage += i.package.childUsd
                        var usdaddfacility = 0;
                        for (let j of res.additionalFacility) {
                            if (i.familyMember.familyHeadId == j.familyHeadId) {
                                if (i.package.packageId == j.additionalFacilities.packageId) {
                                    usdaddfacility += parseInt(j.additionalFacilities.childUsd)
                                }
                            }

                        }

                        usdmember += `<th>${usdaddfacility.toLocaleString()}</th>`

                    } else {
                        usdmember += `<th>${i.package.adultUsd}</th>`
                        usdtotalamount += i.package.adultUsd
                        usdpackage += i.package.adultUsd
                        var usdaddfacility = 0;
                        for (let j of res.additionalFacility) {
                            if (i.familyMember.familyHeadId == j.familyHeadId) {
                                if (i.package.packageId == j.additionalFacilities.packageId) {
                                    usdaddfacility += parseInt(j.additionalFacilities.adultUsd)
                                }
                            }

                        }
                        usdmember += `<th>${usdaddfacility.toLocaleString()}</th>`

                    }

                    usdtotalamount += usdaddfacility
                    var usdpacaddon = 0;
                    for (let j of res.packageAddons) {
                        if (i.package.packageId == j.packageId) {
                            usdpacaddon += parseInt(j.usdPrice)

                        }
                    }
                    usdtotalamount += usdpacaddon

                    usdmember += `<th>${usdpacaddon.toLocaleString()}</th>`
                    usdmember += `<th>${(usdtotalamount / a).toLocaleString()}</th>`
                    usdmember += `<th>${i.package.sarroe}</th>`
                    usdmember += `<th>${i.package.usdroe}</th>`
                    usdmember += `</tr>`
                }

                $('#usdmember').html(usdmember)

                document.getElementById('pkrtotal').innerText = ((pkrtotalamount + pkrextras + basicAirlinePkr + basicDifferentPkr + pkrdiscount)).toLocaleString();
                document.getElementById('sartotal').innerText = ((sartotalamount + sarextras + basicAirlineSar + basicDifferentSar + sardiscount)).toLocaleString();
                document.getElementById('usdtotal').innerText = ((usdtotalamount + usdextras + basicAirlineUsd + basicDifferentUsd + usddiscount)).toLocaleString();

                $("#adult_price_package_pkr").html(res.adultBasicPackagePkr.toLocaleString());
                $("#child_price_package_pkr").html(res.childBasicPackagePkr.toLocaleString());
                $("#infant_price_package_pkr").html(res.infantBasicPackagePkr.toLocaleString());

                $("#adult_price_package_sar").html(res.adultBasicPackageSar.toLocaleString());
                $("#child_price_package_sar").html(res.childBasicPackageSar.toLocaleString());
                $("#infant_price_package_sar").html(res.infantBasicPackageSar.toLocaleString());

                $("#adult_price_package_usd").html(res.adultBasicPackageUsd.toLocaleString());
                $("#child_price_package_usd").html(res.childBasicPackageUsd.toLocaleString());
                $("#infant_price_package_usd").html(res.infantBasicPackageUsd.toLocaleString());

                $("#adult_count_pkr").html(res.adultCount);
                $("#adult_count_sar").html(res.adultCount);
                $("#adult_count_usd").html(res.adultCount);

                $("#child_count_pkr").html(res.childCount);
                $("#child_count_sar").html(res.childCount);
                $("#child_count_usd").html(res.childCount);


                $("#infant_count_pkr").html(res.infantCount);
                $("#infant_count_sar").html(res.infantCount);
                $("#infant_count_usd").html(res.infantCount);


                let bank_check = '';
                for (let bank of res.companyBank) {
                    bank_check += `
                        <label>${bank.bank}</label>
                        <input type="checkbox" onclick="bankToggle(this)" value="${bank.companyBankAccountId}"/> `
                }
                document.getElementById('checkBankDetail').innerHTML = bank_check

                const currencyMap = {
                    0: 'PKR', 1: 'SAR', 2: 'USD', 3: 'AED', 4: 'GBP', 5: 'EURO'
                }

                let bank_tbody = "";
                for (let bank of res.companyBank) {
                    bank_tbody += `
                    <div class="col-md-12" style="display:none" id="table_${bank.companyBankAccountId}">


                             <table class="table" >
                                <thead>
                                    <tr class="bg-grey text-center">
                                        <th colspan="2" class="text-white"><b class="">Bank Account Detail</b></th>
                                    </tr>
                                </thead>
                                <tbody>


                                            <tr class="bank-details" id="${bank.companyBankAccountId}_row">
                                                <td colspan="" style="background-color: rgb(232, 232, 232);">
                                                    <b class="toggle-bank-details" data-target="${bank.companyBankAccountId}">${bank.bank}</b>
                                                </td>
                                                 <td colspan="" style="background-color: rgb(232, 232, 232); text-align: right; text-align:left">
    <b class="" >Currency: ${currencyMap[bank.accountCurrency]}</b>
                                                </td>
                                            </tr>
                                            <tr class="bank-details bank-details-content hidden" id="${bank.companyBankAccountId}_details">
                                                <td>Account Title</td>
                                                <td>${bank.title}</td>
                                            </tr>
                                            <tr class="bank-details bank-details-content hidden" id="${bank.companyBankAccountId}_details">
                                                <td>Account Number</td>
                                                <td>${bank.number}</td>
                                            </tr>
                                            <tr class="bank-details bank-details-content hidden" id="${bank.companyBankAccountId}_details">
                                                <td>IBAN</td>
                                                <td>${bank.iban}</td>
                                            </tr>
                                            <tr class="bank-details bank-details-content hidden" id="${bank.companyBankAccountId}_details">
                                                <td>Branch Code</td>
                                                <td>${bank.branchCode}</td>
                                            </tr>
                                            <tr class="bank-details bank-details-content hidden" id="${bank.companyBankAccountId}_details">
                                                <td>Swift Code</td>
                                                <td>${bank.swift}</td>
                                            </tr>
                                            <tr class="bank-details bank-details-content hidden" id="${bank.companyBankAccountId}_details">
                                                <td>Goverment ID / NTN</td>
                                                <td>${bank.ntn}</td>
                                            </tr>
                                            <tr class="bank-details bank-details-content hidden" id="${bank.companyBankAccountId}_details">
                                                <td>Address</td>
                                                <td>${bank.bankAddress}</td>
                                            </tr>

                                            </tbody>

                            </table>

                               </div>`;
                }

                document.getElementById('bank_detail').innerHTML = bank_tbody;






            },
            error: err => {
                console.log(err)
            }
        });
    }

    function hideDiv(value) {
        value.style.display = "none"
    }

    function bankToggle(input) {
        if (input.checked == true) {
            document.getElementById(`table_${input.value}`).style.display = "block"
        } else {
            document.getElementById(`table_${input.value}`).style.display = "none"
        }
    }

    getFamilyDetail(@ViewBag.familyId)



    function convertToPkr(val) {
        let pkrROE = document.getElementById("PKRROE").value;

        let sanitizedVal = val.replace(/,/g, '');
        let converted = pkrROE * sanitizedVal;

        console.log(converted)
        document.getElementById("usdToPkr").innerHTML = converted.toLocaleString()
    }




</script>