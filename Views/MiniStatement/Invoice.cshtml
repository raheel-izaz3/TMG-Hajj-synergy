                let pkrdiscount = 0;

                let pkrpackage = 0;
                let pkrtotalamount = 0;
                var a = 0;
                for (let i of res.familyMember) {

                    pkrdiscount = i.familyMember.familyHead.pkrDiscountAmount;

                    a += 1;
                    pkrmember += `<tr>`
                    pkrmember += `<th>${i.familyMember.familyHead.givenName} ${i.familyMember.familyHead.surName}</th>`

                    if (calculateAge(i.familyMember.familyHead.dateOfBirth) < 2) {
                        // infant 
                        pkrtotalamount += i.package.infantPkr
                        pkrpackage += i.package.infantPkr
                        pkrmember += `<th>${i.package.infantPkr}</th>`
                        var pkraddfacility = 0;
                        for (let j of res.additionalFacility) {
                            if (i.familyMember.familyHeadId == j.familyHeadId) {
                                if (i.package.packageId == j.additionalFacilities.packageId) {
                                    pkraddfacility += parseInt(j.additionalFacilities.infantPkr)

                                }
                            }
                        }
