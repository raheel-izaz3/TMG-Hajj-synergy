@model Invoice

@{
    string modelName = "Mini Statement";
    string modelNamePlural = "Mini Statements";
    string modelControllerRoute = "MiniStatement";
}
@if (!string.IsNullOrEmpty(ViewBag.ErrorMessage))
{
    <div class="alert alert-danger" role="alert">
        @ViewBag.ErrorMessage
    </div>
}
<div class="container-xxl flex-grow-1 container-p-y">
    <h4 class="fw-bold" style="color:  #404040;">@modelName</h4>

    <hr class="mb-4" />

    <div class="row">
        <div class="col-sm-12">
            <div class="card mb-4">
                <div class="card-body">
                    <form method="post" enctype="multipart/form-data">
                        <div class="row">
                            <div class="col-sm-12 col-md-12 mb-3">
                                <label>Select Family Head</label>
                                <select name="familyId" id="familyId" class="form-select" onchange="getFamilyDetail()"
                                    aria-label="Default Select Family">
                                    <option selected disabled hidden>Select Family Head</option>
                                    @foreach (FamilyHead family in ViewBag.FamilyHead)
                                    {
                                        <option value="@family.FamilyHeadId">@family.GivenName @family.SurName (@family.FcId)</option>
                                    }
                                </select>

                            </div>
                        </div>

                        <div class="row mt-3">
                            @* <div class="col-md-3">
                                <input type="button" class="btn btn-primary w-100" value="Filter"
                                    onclick="getFamilyDetail()" />
                            </div> *@

                            <div class="col-md-3">
                               @*  <input class="btn btn-success w-100 text-white" id="printButton" onclick="printDiv()"
                                    value="Print" /> *@
                                <button class="btn btn-success w-100 text-white" id="printButton" onclick="printDiv()"
                                        value="Print">
                                    Print
                                </button>
                            </div>
                            <div class="col-md-3">
                              @*   <input class="btn btn-info w-100 text-white" id="printInvoice" asp onclick="printInv()"
                                    value="Proforma Invoice" /> *@
                                <button class="btn btn-info w-100 text-white" id="printInvoice" onclick="printInv()"
                                        value="Proforma Invoice">
                                    Proforma Invoice
                                </button>

                                
                            </div>
                            <div class="col-md-3">
                                <button class="btn btn-info w-100 text-white" id="printInvoiceV2" onclick="printInvV2()"
                                        value="Proforma Invoice">
                                    Proforma Invoice v2
                                </button>
                            </div>
                            <div class="col-md-3 mt-2">
                                <input type="checkbox" onclick="showSar(this)" checked />
                                <label>SAR</label>
                                <input type="checkbox" onclick="showUsd(this)" />
                                <label>USD</label>
                                <input type="checkbox" onclick="showPkr(this)" />
                                <label>PKR</label>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>

    <hr class="mb-4">


