<script>

    function printDiv() {
        var myElement = document.getElementById("printButton");
        var id = myElement.getAttribute("data-family-id");

        window.open(`/MiniStatement/Print/${id}`, '_blank');
    }

    function printInv() {
        var myElement = document.getElementById("printInvoice");
        var id = myElement.getAttribute("data-family-id");
        var familyId = document.getElementById('familyId').value;
        window.open(`/MiniStatement/NewInvoice/${familyId}`, '_blank');
    }

    function printInvV2() {
        var myElement = document.getElementById("printInvoiceV2");
        var id = myElement.getAttribute("data-family-id");
        var familyId = document.getElementById('familyId').value;
        window.open(`/MiniStatement/NewInvoiceV2/${familyId}`, '_blank');
    }


    function calculateAge(dateOfBirth) {
        let full_date = new Date(dateOfBirth);
        let only_date = full_date.toISOString().split('T')[0];

        var dob = new Date(full_date);
        var currentDate = new Date();
        var age = currentDate.getFullYear() - dob.getFullYear();
        if (
            currentDate.getMonth() < dob.getMonth() ||
            (currentDate.getMonth() === dob.getMonth() && currentDate.getDate() < dob.getDate())
        ) {
            age--;
        }

        return age;
    }

    function showPkr(input) {
        if (input.checked == false) {
            document.getElementById('pkrcurrency').style.display = 'none'
            document.getElementById('showpkrmember').style.display = 'none'
        } else {
            document.getElementById('pkrcurrency').style.display = 'block'
            document.getElementById('showpkrmember').style.display = 'block'
        }
    }
    function showUsd(input) {
        if (input.checked == false) {
            document.getElementById('usdcurrency').style.display = 'none'
            document.getElementById('showusdmember').style.display = 'none'
        } else {
            document.getElementById('usdcurrency').style.display = 'block'
            document.getElementById('showusdmember').style.display = 'block'
        }
    }
    function showSar(input) {
        if (input.checked == false) {
            document.getElementById('sarcurrency').style.display = 'none'
            document.getElementById('showsarmember').style.display = 'none'
        } else {
