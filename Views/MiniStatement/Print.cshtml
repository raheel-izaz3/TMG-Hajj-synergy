@{
    Layout = "_InvoiceLayout";

    ViewData["title"] = "Mini Statement";
}
<script>
    var opt = {
        margin: 0.2,
        filename: '',
        image: { type: 'jpeg', quality: 0.98 },
        html2canvas: { scale: 2 },
        jsPDF: { unit: 'in', format: 'letter', orientation: 'portrait' }
    };
    window.onload = function () {
        document.getElementById("download")
            .addEventListener("click", () => {
                const invoice = this.document.getElementById("recipt");
                console.log(invoice);
                console.log(window);
                html2pdf().from(invoice).set(opt).save();
            })
    }
</script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.9.2/html2pdf.bundle.js"></script>
<style>
    * {
        font-size: 12px;
    }

    body {
        background-color: white
    }

    .f-600 {
        font-weight: 600;
    }

    .bg-custome {
        background-color: #696969;
    }

    .table td,
    .table th {
        padding: 0;
        padding-top: 5px;
        vertical-align: top;
    }

    .table th {
        text-transform: uppercase;
        font-size: 8px;
        letter-spacing: 1px;
    }

    .table thead th {
        vertical-align: bottom;
        border-bottom: 0px solid #dee2e6;
    }

    .pkr,
    .sar {
        display: none;
    }


    .pkr_recive,
    .sar_recive,
    .usd_recive {
        display: none;
    }



    .bg-grey {
        background-color: #696969;
    }

    .table td,
    .table th {
        padding: 0.1rem;
        vertical-align: top;
        border-top: 1px solid #6f6f6f;
    }

    td,
    th {
        border: 1px solid #6f6f6f;
    }

    @@media print {
        .hideInPrint {
            display: none;
        }

        body {
            print-color-adjust: exact;
        }

        #recipt {
            margin: 0;
            print-color-adjust: exact;
        }
    }
</style>

<div class="container hideInPrint">
    <div class="row mt-1 ">
        <div class="col-sm-6">
            <button id="download" class="btn btn-success">Download</button>
            <button class="btn btn-success" onclick="print()">Print</button>
        </div>
        <div class="col-sm-6 mt-2">
            <input type="checkbox" id="sarCheckbox" onclick="showSar(this)" />
            <label>SAR</label>
            <input type="checkbox" id="usdCheckbox" onclick="showUsd(this)" checked />
            <label>USD</label>
            <input type="checkbox" id="pkrCheckbox" onclick="showPkr(this)" />
            <label>PKR</label>
            <input type="checkbox" onclick="toggleRecive('sar_recive')" id="sar_recive1" />
            <label>SAR-Receive</label>
            <input type="checkbox" onclick="toggleRecive('usd_recive')" id="usd_recive1" />
            <label>USD-Receive</label>
            <input type="checkbox" onclick="toggleRecive('pkr_recive')" id="pkr_recive1" />
            <label>PKR-Receive</label>
        </div>
    </div>
</div>

