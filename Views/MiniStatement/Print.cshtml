<script>

    function showColumnAndRows(currency) {
        var columns = document.querySelectorAll('.' + currency);
        var rows = document.querySelectorAll('tr.dataRow td.' + currency);

        columns.forEach(function (column) {
            column.style.display = 'table-cell';
        });

        rows.forEach(function (row) {
            row.style.display = 'table-row';
        });
    }

    function toggleRecive(currency) {
        var columns = document.querySelectorAll('.' + currency);
        var rows = document.querySelectorAll('tr.dataRow td.' + currency);

        columns.forEach(function (column) {
            if (column.style.display === 'none' || column.style.display === '') {
                column.style.display = 'table-cell';
            } else {
                column.style.display = 'none';
            }
        });

        rows.forEach(function (row) {
            if (row.style.display === 'none' || row.style.display === '') {
                row.style.display = 'table-row';
            } else {
                row.style.display = 'none';
            }
        });
    }


    function hideColumnAndRows(currency) {
        var columns = document.querySelectorAll('.' + currency);
        var rows = document.querySelectorAll('tr.dataRow td.' + currency);

        columns.forEach(function (column) {
            column.style.display = 'none';
        });

        rows.forEach(function (row) {
            row.style.display = 'none';
        });
    }


    function showPkr(input) {
        if (input.checked == false) {
            hideColumnAndRows('pkr', 'pkr2');
            document.getElementById('pkrcurrency').style.display = 'none'
            document.getElementById('currency').innerText = ""
        } else {
            document.getElementById('pkrcurrency').style.display = 'block'
            document.getElementById('currency').innerText = "PKR"
            showColumnAndRows('pkr', 'pkr2')
        }
    }
    function showUsd(input) {

        if (input.checked == false) {
            document.getElementById('usdcurrency').style.display = 'none'
            document.getElementById('currency').innerText = ""
            hideColumnAndRows('usd', 'usd2');
        } else {
            document.getElementById('usdcurrency').style.display = 'block'
            document.getElementById('currency').innerText = "USD"
            showColumnAndRows('usd', 'usd2');
        }
    }
    function showSar(input) {
        if (input.checked == false) {
            hideColumnAndRows('sar', 'sar2');
            document.getElementById('sarcurrency').style.display = 'none'
            document.getElementById('currency').innerText = ""
        } else {
            document.getElementById('sarcurrency').style.display = 'block'
            document.getElementById('currency').innerText = "SAR"
            showColumnAndRows('sar', 'sar2')
        }
    }


</script>