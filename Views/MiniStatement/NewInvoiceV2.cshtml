@model ProformaViewModel

@{
    Layout = "_InvoiceLayout";
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title></title>
    <style>
        * {
            box-sizing: border-box;
        }

        body {
            font-family: Calibri, Candara, Segoe, Segoe UI, Optima, Arial, sans-serif;
            overflow-x: hidden;
        }

        h1,
        h2,
        h3,
        h4,
        h5,
        h6 {
            margin: 0;
            padding: 0;
        }

        p {
            font-size: 9px;
            margin: 0;
            padding: 0;
        }

        /* Table styling  */
        table tr th {
            font-size: 10px;
        }

        table tr td {
            font-size: 9px !important;
        }

        .AMounttotelvalue {
            /* font-size: 12px !important; */
            color: white;
            background-color: black;
        }

        .TotalAMountTitle {
            /* font-size: 10px !important; */
            color: white;
            background-color: black;
        }

        /*   #discountRateHideShow {
                      display: table;
                    }

                    #totalAmountHideShow {
                      display: none;
                    } */


        /* Table styling  End */
        .downloade_btn {
            padding: 10px 45px;
            background-color: lightblue;
            outline: none;
            border: 1px solid black;
            font-weight: bold;
            font-family: Calibri, Candara, Segoe, Segoe UI, Optima, Arial, sans-serif;
            font-size: 14px;
            cursor: pointer;
        }

            .downloade_btn:hover {
                background-color: white;
            }

        /* Check-Box Styling  */
        .check_box_container {
            display: flex;
            justify-content: center;
            align-items: center;
        }

            .check_box_container .CheckBox {
                width: 20px;
                height: 12px;
                margin: 0;
                padding: 0;
            }

        @@media print {
            .check_box_container {
                display: none !important;
            }

            button {
                display: none;
            }
        }

        /* Check-Box Styling End */
        .parent {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .container {
            display: flex;
            align-items: center;
        }

            .container .logo {
                width: 55px;
            }

                .container .logo img {
                    width: 100%;
                }

        .AL_Khair_Title {
            font-size: 18px;
            margin-left: 15px;
            font-weight: bold;
        }

        .title_break {
            font-size: 12px;
            margin-left: 15px;
            font-weight: bold;
        }

        .qr-code p {
            padding: 0;
            margin: 0;
        }

        .qr-code {
            padding: 0;
            padding-top: 20px;
        }

        .qr_number {
            text-align: right;
            margin: 0px;
            font-weight: bold;
        }

        .horizantal_line {
            border: 1px solid black;
        }


        .Invoice_to_section {
            display: flex;
            justify-content: space-between;
            flex-wrap: wrap;
        }

        .proforma_title {
            text-align: center;
            padding-top: 10px;
            margin-bottom: 15px;
        }

        .Customer_Info p {
            padding: 1px 0;
            font-weight: bold !important;
        }

        .Customer_Col_2 p {
            padding: 1px 0;
            font-weight: bold;
        }

        .Customer_Col_2 span {
            font-weight: normal;
        }

        .Customer_Info span {
            font-weight: normal;
        }

        .ALL_MEMBERS_NAMES p {
            padding: 1px 0;
        }

        .ALL_MEMBERS_NAMES span {
            font-weight: bold;
        }

        /* Table Styling Start  */
        .Service_Table {
            width: 100%;
        }

            .Service_Table tr th {
                font-size: 10px;
                text-align: right;
            }

            .Service_Table tr td {
                border-bottom: 1px solid black;
                font-size: 10px;
            }

                .Service_Table tr td:nth-child(2) {
                    text-align: right;
                    width: 130px;
                }

            .Service_Table tr:nth-last-child(1) {
                font-weight: bold;
            }

        /* MEdia Querry  */
        @@media (max-width :768px) {
            .Bank_Table {
                width: 100% !important;
            }
        }

        .Bank_Table {
            margin-top: 20px;
            border: 1px solid black;
            border-collapse: collapse;
            width: 60%;
        }

            .Bank_Table tr {
                border: 1px solid black;
            }

                .Bank_Table tr th {
                    border: 1px solid black !important;
                    background-color: lightblue;
                    text-align: left;
                    padding-left: 5px;
                    font-size: 10px;
                }

                .Bank_Table tr td:nth-child(1) {
                    font-weight: bold;
                }

                .Bank_Table tr td {
                    text-align: left;
                    border: 1px solid black;
                    padding-left: 5px;
                    font-size: 10px;
                }

        /* ADF_Details_Table styling Start  */
        .Receipt_container {
            margin-top: 7px;
        }


        .ADF_Container {
            width: 60%;
        }

        .ADF_Details_Box {
            margin-bottom: 10px;
        }

        .ADF_heading {
            background-color: lightblue;
            font-weight: bold;
            font-size: 10px !important;
            text-align: center;
            color: black !important;
        }

        @@media (max-width:768px) {
            .ADF_Container {
                width: 100% !important;
            }
        }

        .ADF_Details_Box table {
            border-collapse: collapse;
            border: 1px solid black;
            width: 100%;
        }

        .ADF_Details_Box tr th {
            border: 1px solid black;
        }

        .ADF_Details_Box tr td {
            border: 1px solid black;
        }


        .totalText,
        .amountText {
            font-weight: bold !important;
            background-color: lightblue;
            font-size: 10px !important;
            color: black !important;
        }

        /*############ ADF_Details_Table styling End ############## */
        /* *********Note List ********** */
        .terms_condition_list {
            margin-left: 6px;
            margin: 3px 0px !important;
        }

        .note_heading {
            font-size: 10px;
            font-weight: bold;
            margin-top: 10px;
        }

        .Notes_order_list {
            padding: 0;
            margin: 8px;
        }

            .Notes_order_list li {
                font-size: 8px;
                padding: 2px;
            }

        /* *********Note List  END********** */
        footer {
            position: fixed;
            bottom: 0;
            left: 0;
            width: 100% !important;
        }

        .footer_address {
            border-top: 1px solid black;
            text-align: center;
        }

            .footer_address h6 {
                font-weight: normal !important;
            }



        .top_service_table {
            border: 1px solid black;
            border-collapse: collapse;
            width: 100%;
            margin-bottom: 0px;
            margin-top: 10px;
        }

            .top_service_table tr th,
            td {
                border: 1px solid black;
            }

            .top_service_table tr {
                border: 1px solid black;
            }

                .top_service_table tr:nth-child(1) {
                    border: none !important;
                    outline: none;
                }

                .top_service_table tr td:nth-child(2) {
                    text-align: right;
                }

                .top_service_table tr:nth-last-child(1) {
                    font-weight: bold;
                    font-size: 10px !important;
                    background-color: lightblue;
                    color: white;
                }

        /* ________Content_Editable Row _____ */
        [contenteditable] {
            width: 100px;
        }

        /* ________Content_Editable Row _____ */
        /* Hide And Show Table Styling  */
        #Receipt_PaymentRecord,
        #Payment_Subject {
            display: none;
        }


        #Memberbreaktable {
            display: none;
            text-align: center;
        }

        .MembersName tr th:nth-child(1) {
            text-align: left !important;
        }

        .MembersName tr,
        th,
        td:nth-child(1) {
            text-align: left;
        }

            .MembersName tr th:nth-child(2),
            .MembersName tr th:nth-child(3),
            .MembersName tr th:nth-child(4),
            .MembersName tr th:nth-child(5),
            .MembersName tr th:nth-child(6) {
                text-align: center !important;
            }

        .MembersName th:nth-child(1),
        .MembersName th:nth-child(1),
        .MembersName tH:nth-child(4) {
            text-align: left;
        }

        .MembersName th,
        td {
            text-align: center;
        }

        /* Media Querry Check-box and Label button  */
        label {
            font-size: 14px !important;
        }

        @@media (max-width: 768px) {
            label {
                font-size: 14px;
            }

            input[type="checkbox"] {
                transform: scale(0.8);
            }
        }

        .check_box_container span {
            font-weight: bold;
        }

        .flex-container {
            display: flex;
            justify-content: center;
            align-items: center;
            flex-wrap: wrap;
            margin-top: 10px;
        }

        .start-iadf td {
            text-align: left !important;
        }
    </style>


     <style>
        /* Adjusting the body margin and padding for better PDF fit */
        
        /* Adjusting the container to fit better in the PDF */
        #yourContent {
            padding: 0;
            width: 100%;
            box-sizing: border-box;
        }

        /* Add page breaks for better pagination */
        .page-break {
            page-break-before: always;
        }

        /* New styles to prevent content cropping */
        .prevent-crop {
            page-break-inside: avoid;
        }

        /* Additional styles to ensure specific sections do not break */
        .room-category, .terms-and-conditions {
            page-break-inside: avoid;
        }

        /* Ensure terms and conditions content is fully visible and does not break */
        .terms-and-conditions {
            overflow: visible;
            margin-top: 40px;
            margin-bottom: 10px;
            padding: 5px;
            background-color: #f9f9f9;
            border-radius: 5px;
            font-size: 6px;
            page-break-inside: avoid; /* Ensure the section does not break inside */
            page-break-after: avoid; /* Prevent breaking after the section */
        }

        .route-box {
            border: 2px solid black;
            position: relative;
            padding: 5px;
        }

        .route-number {
            position: absolute;
            border-radius: 50%;
            background-color: goldenrod;
            font-weight: normal;
            font-size: small;
            width: 20px;
            height: 20px;
        }

        .route-name,
        .route-date {
            font-weight: small;
        }

        .route-date {
            background-color: goldenrod;
            border-radius: 15px;
            width: max-content;
            padding-inline: 10px; /* Padding ko chota kiya */
            margin: 0 auto;
        }

        .prevent-crop {
            page-break-inside: avoid;
        }
        /* Override bootstrap containers */
        .container,
        .container-xxl,
        .container-p-y {
            max-width: 100% !important;
            width: 100% !important;
            margin: 0 !important;
            padding: 0 !important;
        }

        .itinerary, .terms-and-conditions {
            page-break-inside: avoid; /* Ensure the section does not break inside */
            overflow: visible; /* Ensure content is not cropped */
            margin: 0 !important; /* Remove all margins */
            padding: 0 !important; /* Remove all padding */
        }

        .row.itinerary, .row.terms-and-conditions {
            margin: 0 !important; /* Ensure no margin from row class */
            padding: 0 !important; /* Ensure no padding from row class */
        }

        /* Ensure the content fits within the page */
        #yourContent {
            width: 100%;
            box-sizing: border-box;
        }

        /* Styles specifically for PDF or print */
        @@media print {
            /* Target specific elements or classes for print */
            .pdf-content {
                margin-top: 40px;
                font-size: 10px; /* Adjust font size for print */
                color: black; /* Ensure text is black for print */
                margin: 0; /* Remove any extra margins */
                padding: 0; /* Remove any extra padding */
            }
            /* Example of targeting a specific section */
            #yourContent {
                width: 100%;
                box-sizing: border-box;
                margin: 0 !important; /* Remove margins for print */
                padding: 0 !important; /* Remove padding for print */
            }

            .MsoNormal {
                margin-top: 50px !important;
            }
            /* Hide elements that should not appear in print */
            .no-print {
                display: none !important;
            }
            /* Ensure page breaks are handled correctly */
            .page-break {
                page-break-before: always;
            }
            /* Add margin-top to Terms & Conditions section */
            .terms-and-conditions {
                margin-top: 20px !important; /* Adjust the value as needed */
            }
                /* Add margin-top to specific content within Terms & Conditions using pseudo-element */
                .terms-and-conditions p:nth-child(3)::before {
                    content: '';
                    display: block;
                    margin-top: 10px; /* Adjust the value as needed */
                }

            .terms-content {
                background-color: transparent !important;
            }

                .terms-content * {
                    background-color: transparent !important;
                }

            .terms-and-conditions {
                background-color: transparent !important;
            }
        }

        /* Ensure headings and paragraphs stay together */
        .keep-together {
            page-break-inside: avoid; /* Prevent breaking inside the element */
            page-break-after: auto; /* Allow breaking after the element if needed */
        }

            /* Adjust the margin and padding to reduce blank spaces */
            .keep-together h2, .keep-together p {
                margin: 0;
                padding: 0;
            }

        .small-font {
            font-size: 2px !important;
        }


        /* Additional styles to ensure specific sections do not break */
        .terms-and-conditions, .itinerary {
            page-break-inside: avoid; /* Ensure the section does not break inside */
            overflow: visible; /* Ensure content is not cropped */
            margin: 0 !important; /* Remove all margins */
            padding: 0 !important; /* Remove all padding */
        }

        .terms-content {
            padding: 15px !important; /* Add padding around the entire terms content */
            column-gap: 0;
            break-inside: auto !important;
            page-break-inside: auto !important;
        }

            .terms-content h1,
            .terms-content h2,
            .terms-content h3,
            .terms-content h4,
            .terms-content h5,
            .terms-content h6,
            .terms-content p,
            .terms-content p span,
            .terms-content span {
                font-size: 10px !important;
                margin-bottom: 4px !important;
                line-height: 1.2 !important;
                page-break-inside: avoid !important; /* Prevent paragraph splitting */
            }

            /* Add specific rules for paragraphs */
            .terms-content p {
                padding: 0 15px !important; /* Add left and right padding to paragraphs */
                margin-bottom: 8px !important; /* Add some space between paragraphs */
            }

            .terms-content .heading-wrapper {
                padding: 0 15px !important; /* Add left and right padding to headings */
                margin-top: 12px !important; /* Add space above headings */
                margin-bottom: 8px !important; /* Add space below headings */
            }

        .summernote-content {
            font-weight: normal;
        }

            .summernote-content h1,
            .summernote-content h2,
            .summernote-content h3,
            .summernote-content h4,
            .summernote-content h5,
            .summernote-content h6 {
                font-weight: normal;
                font-size: 7px;
            }

            .summernote-content p {
                font-size: 6px;
                font-weight: normal;
            }

        /* Modify heading behavior in terms section */
        .terms-content h1,
        .terms-content h2,
        .terms-content h3,
        .terms-content h4,
        .terms-content h5,
        .terms-content h6 {
            page-break-before: auto !important; /* Remove forced page breaks */
            page-break-after: avoid !important;
            page-break-inside: avoid !important;
            margin-top: 15px !important; /* Reduced from 20px */
            padding-top: 5px !important; /* Reduced from 10px */
            orphans: 3;
            widows: 3;
        }

        /* Modify heading wrapper to prevent forced breaks */
        .heading-wrapper {
            display: inline-block !important; /* Changed from block */
            page-break-before: auto !important;
            page-break-after: avoid !important;
            page-break-inside: avoid !important;
        }

        /* Ensure content flows naturally */
        .terms-content {
            column-gap: 0;
            break-inside: auto !important; /* Changed from avoid */
            page-break-inside: auto !important; /* Changed from avoid */
        }

    </style>
    <!-- html2pdf CDN Link  -->

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.4.0/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.0/jquery.min.js"
            integrity="sha512-3gJwYpMe3QewGELv8k/BX9vcqhryRdzRMxVfq6ngyWXwo03GFEzjsUm8Q7RZcHPHksttq7/GFoxjCVUjkjvPdw=="
            crossorigin="anonymous" referrerpolicy="no-referrer"></script>

</head>

<body>
    <div style="display: flex; justify-content: space-between; align-items: center;">
        <div>
            <button class="downloade_btn" onclick="generatePDF()">Download PDF</button>
            <button class="downloade_btn" id="send-pdf">Send Email</button>
        </div>
    </div>
    <div style="display: flex; justify-content: space-between; align-items: center;">
        <div>
           <label for="PackageDetail" style="margin-left: 8px;">EmailPackageDetail</label>
           <input type="checkbox" name="PackageDetail" id="PackageDetail" onclick="togglePackageDetail()" />
        </div>
    </div>

    <div id="content">
        <p class="printed_date" style="margin: 0;">Printed Date: @DateTime.Now.ToString("dd/MMM/yyyy HH:mm")</p>
        <div class="check_box_container">
            @* <label for="MiniTitleChange">Mini Statement</label>
            <input type="checkbox" name="MiniTitleChange" id="MiniTitleChange" class="CheckBox"
            onchange="Minititletoggle(this)" />

            <span>|</span> *@


            @* <label for="hideShow_I_ADF">* I-ADF-Details</label>
            <input type="checkbox" name="hideShow_I_ADF" id="hideShow_I_ADF" class="CheckBox" onchange="StarIADF(this)"
            checked /><span>|</span> *@

            <label for="start-E-IADF">** Addons</label>
            <input type="checkbox" name="start-E-IADF" id="start-E-IADF" class="CheckBox" onchange="Start_E_IADF(this)"
                   checked />
            <span> | </span>

            <label for="MembersName">All Members Name</label>
            <input type="checkbox" name="MembersName" id="MembersName" class="CheckBox" checked
                   onchange="MYCompanymembers(this)" />
            <span>|</span>
            @* <label for="CompanyName">Company Name</label>
            <input type="checkbox" name="CompanyName" id="CompanyName" class="CheckBox" onchange="TitleNameChanged(this)" />
            <span>|</span> *@
            <!-- Note Check Box Check  -->
            <label for="NoteCheckBox">Note</label>
            <input type="checkbox" name="NoteCheckBox" id="NoteCheckBox" checked onchange="noteCheckBox(this)" /> <span> | </span>
            @*  <label for="toggleApplicable">PKR Amount </label>
            <input type="checkbox" name="toggleApplicable" id="toggleApplicable" checked onchange="applicable()" /> <span> | </span> *@

            @* <label for="toggleDiscount">Discount</label>
            <input type="checkbox" name="toggleDiscount" id="toggleDiscount" onchange="discountFun()" /> <span> | </span> *@

            @*  <label for="lastPayment">Last Payment</label>
            <input type="checkbox" name="lastPayment" id="lastPayment" /> <span> | </span> *@

            @*  <label for="ticketNote">Show / Hide Ticket Note </label>
            <input type="checkbox" name="ticketNote" id="ticketNote" onchange="hideShowTicketNote(this)" checked /> <span> | </span> *@


            <label for="remarks">Remarks </label>
            <input type="checkbox" name="remarks" id="remarks" onchange="remarksShowHide(this)" checked /> <span> | </span>

            @foreach (CompanyBankAccount bank in Model.BankDetails)
            {
                <label>@bank.Title</label>
                <input type="checkbox" checked
                       onchange="document.getElementById('bank_@bank.CompanyBankAccountId').style.display = this.checked ? 'table' : 'none'" />
            }

        </div>
        <div id="incoice_page_body">
            <div class="parent">
                <div class="container">
                    <div class="logo">
                        <img src="~/@Model.CompanyLogo" id="companyLogo" alt="Logo" />
                    </div>

                    <div class="title">
                        <p class="AL_Khair_Title" id="companyName">@Model.CompanyName</p>
                    </div>
                </div>
                <div class="qr-code">
                    <img src="~/Group Logo.png" alt="QR-Code" style="width: 75px; height: 75px" />
                </div>
            </div>
            <div class="qr_number">
                <p>C.I.D: <span id="cid">@Model.CID</span></p>
            </div>
            <div class="horizantal_line"></div>
            <div class="proforma_title">
                <h4 id="miniStatement_Title">PROFORMA INVOICE</h4>
            </div>
            <div class="Invoice_to_section">
                <div>
                    <h6>
                        INVOICE TO: <span id="invoiceToCustomer">@Model.InvoiceToCustomer</span><span id="invoiceToCompany"
                                                                                                      style="display: none;">@Model.CompanyName</span>
                    </h6>
                    <div class="Customer_Info">
                        <p>GUEST NAME: <span id="headName">@Model.GuestName</span></p>
                        <p>CONTACT: <span id="headContact">@Model.Contact</span></p>
                        <p>CNIC: <span id="cnic"> @Model.CNIC</span> </p>
                        <p> PASSPORT: <span id="passport">@Model.Passport</span> </p>
                        <p>
                            ADDRESS: <span id="headAddress">@Model.Address</span>
                        </p>
                    </div>
                </div>
                <div class="Customer_Col_2">
                    <p>
                        <span id="invNumberText" style="font-weight: bold;">INVOICE NUMBER: </span><span>
                            @Model.FCID <span id="invNumber">@Model.InvoiceNumber</span>
                        </span>
                    </p>
                    <p>DATE: <span id="date">@Html.Raw(Model.Date)</span></p>
                    <p>SPO: <span id="spo">@Model.SPO</span> </p>
                    <p>PURPOSE:<span id="purpose">Travel Services</span></p>
                    @* <p>PURPOSE:<span id="purpose">@Model.Purpose</span></p> *@
                    <p>CATEGORY: <span id="category">@Model.Category</span> </p>
                    <p>REFERENCE: <span id="mega">@Model.MegaReference</span> </p>
                </div>
                <div class="ALL_MEMBERS_NAMES" id="MemebrsName_hide">
                    <p style="font-weight: bold;"> PAX: <span style="font-weight: normal;" id="pax">@Model.Pax</span> </p>
                    <p>
                        <u><b>ALL MEMBERS NAMES:</b></u>
                    </p>

                    <div id="allMembers">
                        @foreach (string s in Model.Members)
                        {
                            <p>@s</p>
                        }
                    </div>
                </div>
            </div>

            <!-- Top Service Section Start   -->
            <table class="top_service_table">
                <tr>
                    <th style="
                  text-align: left;
                  font-size: 10px;
                  color: black;
                  background-color: lightblue;
                  font-weight: bolder;
                ">
                        DESCRIPTION
                    </th>

                    <th style="
            text-align: right;
            font-size: 10px;
            color: black;
            background-color: lightblue;

          ">
                        AMOUNT (@Model.BaseCurrency)
                    </th>

                </tr>
                <tr>
                    <td colspan="1">PACKAGE WITHOUT AIR TICKET (@Model.PackageDetails) </td>
                    <td colspan="1"> @Model.PackageAmount </td>
                </tr>

                <tr>
                    <td>
                        **
                        Addons
                    </td>
                    @* <td style="text-align: center;">@Model.EIADFMembers</td> *@
                    <td id="eiadfPrice" style="text-align: right;">@Model.EIADFPriceUsd</td>
                <tr>
                <tr>
                    <td>
                        **
                        Addons Discount
                    </td>
                    <td id="eiadfPrice" style="text-align: right;">@Model.EIADFDiscount</td>
