    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.9.2/html2pdf.bundle.js"></script>
    <script>
        async function generatePDF() {
            const content = document.getElementById('content');
            const footer = document.querySelector('footer');
            const printed = document.getElementsByClassName('.printed_date');

            document.querySelectorAll('.check_box_container').forEach(el => el.style.visibility = 'hidden');
            footer.style.position = 'relative';
            footer.style.marginTop = "16px";

            const hajjiName = "@Model.GuestName".replace(/"/g, '');
            const hbNumber = "@Model.FCID".replace(/"/g, '');
            const pkgName = "@Model.PackageDetails".replace(/"/g, '');
            const invNumber = "@Model.InvoiceNumber".replace(/"/g, '');

            const filename = `ProformaInvoice_${hajjiName}_${hbNumber}_${pkgName}_${invNumber}.pdf`;

            const options = {
                margin: [25, 25, 25, 25],
                filename: filename,
                image: { type: 'jpeg', quality: 0.98 },
                html2canvas: { scale: 2 },
                jsPDF: { unit: 'pt', format: 'a4', orientation: 'portrait' }
            };

            await html2pdf().set(options).from(content).save();

            document.querySelectorAll('.check_box_container').forEach(el => el.style.visibility = 'visible');
            footer.style.position = 'fixed';
            footer.style.marginTop = "0px";
            document.querySelectorAll('.printed_date').forEach(el => el.style.visibility = 'hidden');
        }

        async function generatePDFforPackage() {
            console.log("Starting PDF generation for PackageDetails...");

            const element = document.getElementById('yourContent');
            if (!element) {
                console.error("Error: Element with ID 'yourContent' not found.");
                return null;
            }

            // Clone the hidden content and append to the body temporarily
            const clone = element.cloneNode(true);
            clone.style.display = 'block'; // Make the clone visible temporarily
            document.body.appendChild(clone);

            // Hide checkboxes before generating PDF
            const checkboxes = document.querySelectorAll('input[type="checkbox"]');
            checkboxes.forEach(checkbox => {
                checkbox.style.display = 'none';
            });

            // Remove any transformations or styles that might affect rendering
            clone.style.transform = 'none';
            clone.style.transformOrigin = 'top left';

            try {
                console.log("Generating PackageDetails PDF...");
                const pdf = await html2pdf()
                    .set({
                        margin: [0.5, 0.5, 0.5, 0.5], // Increase margins to prevent cropping
                        filename: 'PackageDetails.pdf',
                        image: { type: 'jpeg', quality: 0.98 },
                        html2canvas: { scale: 2, useCORS: true }, // Use CORS for better image handling
                        jsPDF: { unit: 'in', format: 'a4', orientation: 'portrait' },
                        pagebreak: { mode: ['avoid-all', 'css', 'legacy'] } // Use avoid-all to prevent breaks
                    })
                    .from(clone) // Use the cloned element
                    .toPdf()
                    .get('pdf'); // Get the PDF object

                var pdfPackageBase64 = pdf.output('datauristring'); // Convert PDF to base64 string
                console.log("PackageDetails PDF generated successfully:", pdfPackageBase64);

                return pdfPackageBase64; // Return the base64 string
            } catch (error) {
                console.error("Error generating PackageDetails PDF:", error);
                return null;
            } finally {
                // Cleanup: remove the clone from the DOM
                document.body.removeChild(clone);

                // Restore checkboxes
                checkboxes.forEach(checkbox => {
                    checkbox.style.display = '';
                });
            }
        }

        function generatePDFforPackageDetail() {
            const element = document.getElementById('yourContent');

            // Hide checkboxes before generating PDF
            const checkboxes = document.querySelectorAll('input[type="checkbox"]');
            checkboxes.forEach(checkbox => {
                checkbox.style.display = 'none';
            });

            // Koi transform scale nahi laga rahe:
            element.style.transform = 'none';
            element.style.transformOrigin = 'top left';

            html2pdf()
                .set({
                    margin: [0.5, 0.5, 0.5, 0.5], // Increase margins to prevent cropping
                    filename: 'PackageDetails.pdf',
                    image: { type: 'jpeg', quality: 0.98 },
                    html2canvas: { scale: 2, useCORS: true }, // Use CORS for better image handling
                    jsPDF: { unit: 'in', format: 'a4', orientation: 'portrait' },
                    pagebreak: { mode: ['avoid-all', 'css', 'legacy'] } // Use avoid-all to prevent breaks
                })
                .from(element)
                .save()
                .then(() => {
                    console.log('PDF downloaded successfully.');
                })
                .catch((error) => {
                    console.error("Error generating PDF: ", error);
                })
                .finally(() => {
                    checkboxes.forEach(checkbox => {
                        checkbox.style.display = '';
                    });
                });
        }

        document.getElementById('send-pdf').addEventListener('click', async function () {
            console.log("Send Email button clicked.");

            var element = document.getElementById('content');
            const footer = document.querySelector('footer');

            document.querySelectorAll('.check_box_container').forEach(el => el.style.visibility = 'hidden');
            footer.style.position = 'relative';
            footer.style.marginTop = "16px";

            const hajjiName = "@Model.GuestName".replace(/"/g, '');
            const hbNumber = "@Model.FCID".replace(/"/g, '');
            const invNumber = "@Model.InvoiceNumber".replace(/"/g, '');
            const pkgName = "@Model.PackageDetails".replace(/"/g, '');

            const filename = `ProformaInvoice_${hajjiName}_${hbNumber}_${invNumber}_${pkgName}.pdf`;
            console.log("Generated filename for Invoice PDF:", filename);

            const options = {
                margin: [25, 25, 25, 25],
                filename: filename,
                image: { type: 'jpeg', quality: 0.98 },
                html2canvas: { scale: 2 },
                jsPDF: { unit: 'pt', format: 'a4', orientation: 'portrait' }
            };

            // Check if PackageDetail checkbox is checked
            if (document.getElementById('PackageDetail').checked) {
                console.log("PackageDetail checkbox is checked, generating package PDF...");

                // If checked, generate the PDF for package details
                const pdfPackageBase64 = await generatePDFforPackage();

                if (pdfPackageBase64) {
                    console.log("Package PDF generated, now generating invoice PDF...");
                    // Once the package PDF is generated, generate the invoice PDF and send both
                    html2pdf().set(options).from(element).toPdf().get('pdf').then(function (pdf) {
                        var pdfBase64 = pdf.output('datauristring');  // Get the invoice PDF base64 string
                        console.log("Invoice PDF generated successfully:", pdfBase64);

                        // Send both the invoice and package PDF to the server
                        sendPdfToServer(pdfBase64, pdfPackageBase64);  // Pass both PDFs to server
                    }).finally(function () {
                        document.querySelectorAll('.check_box_container').forEach(el => el.style.visibility = 'visible');
                        footer.style.position = 'fixed';
                        footer.style.marginTop = "0px";
                    });
                } else {
                    console.error("Error: Package PDF was not generated.");
                    alert('Error generating package details PDF');
                }
            } else {
                console.log("PackageDetail checkbox is unchecked, generating only invoice PDF...");

                // If unchecked, generate the invoice PDF only
                html2pdf().set(options).from(element).toPdf().get('pdf').then(function (pdf) {
                    var pdfBase64 = pdf.output('datauristring');
                    console.log("Invoice PDF generated successfully:", pdfBase64);

                    sendPdfToServer(pdfBase64, null); // Send only the invoice, package is null
                }).finally(function () {
                    document.querySelectorAll('.check_box_container').forEach(el => el.style.visibility = 'visible');
                    footer.style.position = 'fixed';
                    footer.style.marginTop = "0px";
                });
            }
        });

        function sendPdfToServer(pdfBase64, pdfPackageBase64) {
            const id = @ViewBag.ID;
            console.log("Sending PDF to server. ID:", id);
            console.log("Invoice PDF base64:", pdfBase64);
            console.log("Package PDF base64:", pdfPackageBase64);

            // Prepare data to be sent as a JSON object     
            const data = {
                pdfBase64: pdfBase64,            // Invoice PDF
                pdfPackageBase64: pdfPackageBase64, // Package PDF (if available)
                id: id                          // Pass the ID as part of the data
            };

            $.ajax({
                url: `/Email/SendInvoice`,    // URL with the id
                type: 'POST',
                contentType: 'application/json',    // Ensure the content is JSON
                data: JSON.stringify(data),        // Convert data to JSON string
                success: function (response) {
                    console.log("Email sent successfully:", response);
                    alert("Email sent successfully!");
                },
                error: function (xhr, status, error) {
                    console.error("Error sending email:", error);
                    alert("Error sending email: " + error);
                }
            });
        }

