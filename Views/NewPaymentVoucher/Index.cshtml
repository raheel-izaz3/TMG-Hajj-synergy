@model IEnumerable<TMG.Models.Updated_Accounts.NewPaymentVoucher>
@{
    string modelName = "PaymentVoucher";
    string modelNamePlural = "Payment Vouchers";
    string modelControllerRoute = "NewPaymentVoucher";
}

@if (TempData.ContainsKey("created"))
{
    if ((bool)TempData["created"]! == true)
    {
        <script>
            toastr.options.closeDuration = 100;
            toastr.options.closeButton = true;
            toastr.options.positionClass = "toast-top-center";
            toastr.options.showMethod = 'slideDown';
            toastr.options.hideMethod = 'slideUp';
            toastr.options.closeMethod = 'slideUp';
            toastr.success('', '@modelName Created Successfully!', { timeOut: 2000 })
        </script>
        TempData["created"] = false;
    }
}
@if (TempData.ContainsKey("deleted"))
{
    if ((bool)TempData["deleted"]! == true)
    {
        <script>
            toastr.options.closeDuration = 100;
            toastr.options.closeButton = true;
            toastr.options.positionClass = "toast-top-center";
            toastr.options.showMethod = 'slideDown';
            toastr.options.hideMethod = 'slideUp';
            toastr.options.closeMethod = 'slideUp';
            toastr.success('', '@modelName Trashed Successfully!', { timeOut: 2000 })
        </script>
        TempData["deleted"] = false;
    }
}
@if (TempData.ContainsKey("updated"))
{
    if ((bool)TempData["updated"]! == true)
    {
        <script>
            toastr.options.closeDuration = 100;
            toastr.options.closeButton = true;
            toastr.options.positionClass = "toast-top-center";
            toastr.options.showMethod = 'slideDown';
            toastr.options.hideMethod = 'slideUp';
            toastr.options.closeMethod = 'slideUp';
            toastr.success('', '@modelName Updated Successfully!', { timeOut: 2000 })
        </script>
        TempData["updated"] = false;
    }
}

<div class="container-xxl flex-grow-1 container-p-y">
    <h4 class="fw-bold"><span class="text-muted fw-light"></span> @modelNamePlural</h4>

    <hr class="mb-4" />


    <a asp-action="Create" class="btn btn-info">Create Bank Transfer</a>
    <a asp-action="CreateVendor" class="btn btn-info">Create Vendor Payment</a>
    <a asp-action="CreateExpense" class="btn btn-info">Create Expense Payment</a>
    <a asp-action="CreatePayroll" class="btn btn-info">Create Payroll</a>
    <a asp-action="CreateRefund" class="btn btn-info">Create Client Refund</a>
    <a asp-action="ViewTrashed" class="btn btn-info float-end"><i class="bx bx-trash me-1"></i> Trash (@ViewBag.TrashCount)</a>
    <br />
    <br />
    <div class="card p-2">
        <div class="table-responsive text-nowrap ">
            <table class="table table-hover" id="table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Date</th>
                        <th>PV-#</th>
                        <th>Total Debit</th>
                        <th>Total Credit</th>
                        <th>Debit Remarks</th>
                        <th>Credit Remarks</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody class="table-border-bottom-1">
                    @{
                        int i = 0;
                    }
                    @foreach (var py in Model)
                    {
                        <tr>
                            <td>
                                <i class="fab fa-bootstrap fa-lg text-primary me-3"></i> <strong>@(++i)</strong>
                            </td>
                            <td>@py.Date.ToString("dd/MMM/yyyy")</td>
                            <td>@py.PaymentVoucherNo</td>
                            <td>@py.TotalDebit?.ToString("N2")</td>
                            <td>@py.TotalCredit?.ToString("N2")</td>
                            <td>@py.DebitRemarks</td>
                            <td>@py.CreditRemarks</td>
                            <td>
                                <div class="dropdown">
                                    <div class="btn-group">
                                        <button type="button" class="btn btn-primary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                                            Add Signatures
                                        </button>
                                        <ul class="dropdown-menu">
                                            <li><a class="dropdown-item" href="#" onclick="addSignature(@py.NewPaymentVoucherId, 'Authorizor')">Add Authorizor Sign</a></li>
                                            <li><a class="dropdown-item" href="#" onclick="addSignature(@py.NewPaymentVoucherId, 'Finance')">Add Finance Sign</a></li>
                                            <li><a class="dropdown-item" href="#" onclick="addSignature(@py.NewPaymentVoucherId, 'CEO')">Add CEO Sign</a></li>
                                        </ul>
                                    </div>
                                    @if (py.PaymentType == TMG.Controllers.AccountControllers.Updated_Accounts.PaymentType.Bank)
                                    {
                                        <a class="btn btn-warning" target="_blank" asp-action="Print" asp-route-id="@py.NewPaymentVoucherId"><i class="bx bx-printer me-1"></i> Print</a>
                                    }
                                    else if (py.PaymentType == TMG.Controllers.AccountControllers.Updated_Accounts.PaymentType.Vendor)
                                    {
                                    <a class="btn btn-warning" target="_blank" asp-action="PrintVendor" asp-route-id="@py.NewPaymentVoucherId"><i class="bx bx-printer me-1"></i> Print</a>
                                    }
                                    else if (py.PaymentType == TMG.Controllers.AccountControllers.Updated_Accounts.PaymentType.Expense)
                                    {
                                        <a class="btn btn-warning" target="_blank" asp-action="PrintExpense" asp-route-id="@py.NewPaymentVoucherId"><i class="bx bx-printer me-1"></i> Print</a>
                                    }
                                    else if (py.PaymentType == TMG.Controllers.AccountControllers.Updated_Accounts.PaymentType.Payroll)
                                    {
                                        <a class="btn btn-warning" target="_blank" asp-action="PrintPayroll" asp-route-id="@py.NewPaymentVoucherId"><i class="bx bx-printer me-1"></i> Print</a>
                                    }
                                    else if (py.PaymentType == TMG.Controllers.AccountControllers.Updated_Accounts.PaymentType.Refund)
                                    {
                                        <a class="btn btn-warning" target="_blank" asp-action="PrintRefund" asp-route-id="@py.NewPaymentVoucherId"><i class="bx bx-printer me-1"></i> Print</a>
                                    }
                                    @if(py.PaymentType == TMG.Controllers.AccountControllers.Updated_Accounts.PaymentType.Bank)
                                    {
                                        <a class="btn btn-warning" asp-action="Edit" asp-route-id="@py.NewPaymentVoucherId"><i class="bx bx-edit-alt me-1"></i> Edit</a>
                                    }
                                    else if(py.PaymentType == TMG.Controllers.AccountControllers.Updated_Accounts.PaymentType.Vendor)
                                    {
                                        <a class="btn btn-warning" asp-action="EditVendor" asp-route-id="@py.NewPaymentVoucherId"><i class="bx bx-edit-alt me-1"></i> Edit</a>
                                    }
                                    else if(py.PaymentType == TMG.Controllers.AccountControllers.Updated_Accounts.PaymentType.Expense)
                                    {
                                        <a class="btn btn-warning" asp-action="EditExpense" asp-route-id="@py.NewPaymentVoucherId"><i class="bx bx-edit-alt me-1"></i> Edit</a>
                                    }
                                    else if(py.PaymentType == TMG.Controllers.AccountControllers.Updated_Accounts.PaymentType.Payroll)
                                    {
                                        <a class="btn btn-warning" asp-action="EditPayroll" asp-route-id="@py.NewPaymentVoucherId"><i class="bx bx-edit-alt me-1"></i> Edit</a>
                                    }
                                    else if (py.PaymentType == TMG.Controllers.AccountControllers.Updated_Accounts.PaymentType.Refund)
                                    {
                                        <a class="btn btn-warning" asp-action="EditRefund" asp-route-id="@py.NewPaymentVoucherId"><i class="bx bx-edit-alt me-1"></i> Edit</a>
                                    }
                                    <a class="btn btn-warning" asp-action="ChangeStatus" asp-route-id="@py.NewPaymentVoucherId"><i class="bx bx-edit-alt me-1"></i> Change Status</a>
                                    <button onclick="confirmDelete(@py.NewPaymentVoucherId)" class="btn btn-outline-danger"><i class="bx bx-trash me-1"></i> Trash</button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
<script>

    function confirmDelete(id) {
        let del = confirm("Are you sure?")
        if (del) {
            location.href = `/@modelControllerRoute/Trash/${id}`;
        }
    }

    let table = new DataTable('#table', {
    });

    function addSignature(id, signType) {
        $.ajax({
            url: '/@modelControllerRoute/AddSignature',
            type: 'POST',
            data: {
                id: id,
                signatureType: signType
            },
            success: function(response) {
                if(response.success) {
                    alert(response.msg);
                } else {
                    alert(response.msg);
                }
            },
            error: function() {
                alert('An error occurred');
            }
        });
    }

</script>