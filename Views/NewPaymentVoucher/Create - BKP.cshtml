@model TMG.Models.Updated_Accounts.NewPaymentVoucher
@{
    string modelName = "PaymentVoucher";
    string modelNamePlural = "Payment Voucher";
    string modelControllerRoute = "NewPaymentVoucher";
}

<div class="container-xxl flex-grow-1 container-p-y">
    <h4 class="fw-bold" style="color: #404040;"><span class="text-muted fw-light"> @modelNamePlural / </span> Create</h4>
    <hr class="mb-4" />

    <div class="row">
        <div class="col-sm-12">
            <div class="card mb-4">
                <div class="card-body">
                    <form method="post" asp-action="Create" id="PVForm">
                        <div class="row">

                            <div class="col-sm-12 col-md-5 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname">Date</label>
                                <div class="input-group input-group-merge">
                                    <input type="date" class="form-control" value="@DateTimeManager.Today" max="@DateTimeManager.Today" asp-for="Date">
                                </div>
                            </div>

                            <div class="col-sm-12 col-md-3 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname">ROE</label>
                                <div class="input-group input-group-merge">
                                    <input type="number" step="0.01" min="1" id="ROE" class="form-control" style="display: inline-block; width: auto;" asp-for="ROE">
                                </div>
                                <span asp-validation-for="ROE" class="text-danger"></span>
                            </div>

                            <div class="col-sm-12 col-md-4 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname">Amount</label>
                                <div class="input-group input-group-merge">
                                    <input type="text" id="Amount" class="form-control" style="display: inline-block; width: auto;" oninput="formatNumber(this)" asp-for="Amount">
                                </div>
                                <span asp-validation-for="Amount" class="text-danger"></span>
                            </div>

                            <div class="col-sm-12 col-md-8 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname">Instrument Number</label>
                                <div class="input-group input-group-merge">
                                    <input class="form-control" id="instrumentNumber" type="text" placeholder="Enter Instrument Number..." asp-for="InstrumentNumber">
                                </div>
                                <span asp-validation-for="InstrumentNumber" class="text-danger"></span>
                            </div>

                            <div class="col-sm-12 col-md-12 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname">Debit Remarks</label>
                                <div class="input-group input-group-merge">
                                    <input class="form-control" id="debitRemarks" type="text" placeholder="Debit Remarks..." asp-for="DebitRemarks">
                                </div>
                                <span asp-validation-for="DebitRemarks" class="text-danger"></span>
                            </div>

                            <div class="col-sm-12 col-md-12 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname">Credit Remarks</label>
                                <div class="input-group input-group-merge">
                                    <input class="form-control" id="creditRemarks" type="text" placeholder="Credit Remarks..." asp-for="CreditRemarks">
                                </div>
                                <span asp-validation-for="CreditRemarks" class="text-danger"></span>
                            </div>

                            <hr class="my-3">

                            <div class="row pb-3 p-0">
                                <div class="col-sm-6">
                                    <p><b>Payment List</b></p>
                                </div>
                            </div>

                            <table class="table table-bordered">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Type</th>
                                        <th>Accounts</th>
                                        <th>Currency</th>
                                        <th>Taxes</th>
                                    </tr>
                                </thead>
                                <tbody id="paymentsBody">
                                    <!-- Empty tbody to start with no rows -->
                                </tbody>
                            </table>

@*                             <hr class="my-3">

                            <div class="row pb-3 p-0">
                                <div class="col-sm-6">
                                    <p><b>Taxes</b></p>
                                </div>
                                <div class="col-sm-6 text-end p-0">
                                    <button type="button" class="btn btn-primary" onclick="addTaxRow()"><i class='bx bxs-plus-circle'></i></button>
                                </div>
                            </div>

                            <table class="table table-bordered">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Credit Tax To</th>
                                        <th>Tax Type</th>
                                        <th>Percentage %</th>
                                        <th>Amount</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody id="taxesBody">
                                    <!-- Empty tbody to start with no rows -->
                                </tbody>
                            </table> *@

                            <hr class="my-3">

                            <div class="col-sm-12 col-md-6">
                                <p>
                                    <b>TOTAL DEBIT: </b>
                                    <input id="totalDebit" readonly class="form-control" asp-for="TotalDebit" style="display: inline-block; width: auto;">
                                </p>
                            </div>

                            <div class="col-sm-12 col-md-6 text-end">
                                <p>
                                    <b>TOTAL CREDIT: </b>
                                    <input id="totalCredit" readonly class="form-control" asp-for="TotalCredit" style="display: inline-block; width: auto;">
                                </p>
                            </div>

@*                             <div class="col-sm-6">
                                <p>
                                    <b>TOTAL TAX: </b>
                                    <input id="taxesSum" readonly class="form-control" style="display: inline-block; width: auto;">
                                </p>
                            </div> *@

                        </div>

                        <div class="col-sm-12 mt-4">
                            <button type="button" onclick="submitForm()" class="btn btn-success float-end">Create</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>

    const accounts = @Html.Raw(Json.Serialize(ViewBag.Accounts));
    const accountNatures = @Html.Raw(Json.Serialize(ViewBag.AccountNatures));
    const taxes = @Html.Raw(Json.Serialize(ViewBag.Taxes));

    let paymentRowIndex = 0;
    let taxRowIndex = 0;

    // Function to add account row
    function addRow() {
        const $tableBody = $('#paymentsBody');

        // Debit Row
        const $DebitRow = $(`
            <tr>
                <td>${paymentRowIndex + 1}</td>
                <td>
                    <select id="fixedTypes" name="Payments[0].AccountNature" class="form-control" required readonly>
                        <option value="1">Credit</option>
                    </select>
                </td>
                <td>
                    <div class="mb-2">
                        <div class="btn-group" role="group">
                            <input type="radio" class="btn-check debit-account-type-radio" name="accountType_${paymentRowIndex}" 
                                id="all_${paymentRowIndex}" value="all" checked>
                            <label class="btn btn-outline-primary btn-sm" for="all_${paymentRowIndex}">All</label>
                            
                            <input type="radio" class="btn-check debit-account-type-radio" name="accountType_${paymentRowIndex}" 
                                id="bank_${paymentRowIndex}" value="bank">
                            <label class="btn btn-outline-primary btn-sm" for="bank_${paymentRowIndex}">Banks</label>

                            <input type="radio" class="btn-check debit-account-type-radio" name="accountType_${paymentRowIndex}" 
                                id="vendor_${paymentRowIndex}" value="vendor">
                            <label class="btn btn-outline-primary btn-sm" for="vendor_${paymentRowIndex}">Vendor</label>

                            <input type="radio" class="btn-check debit-account-type-radio" name="accountType_${paymentRowIndex}" 
                                id="haji_${paymentRowIndex}" value="hajji">
                            <label class="btn btn-outline-primary btn-sm" for="haji_${paymentRowIndex}">Hajji</label>
                        
                            <input type="radio" class="btn-check debit-account-type-radio" name="accountType_${paymentRowIndex}" 
                                id="expense_${paymentRowIndex}" value="expense">
                            <label class="btn btn-outline-primary btn-sm" for="expense_${paymentRowIndex}">Expense</label>

                        </div>
                    </div>
                    ${generateDropdown('Payments[' + paymentRowIndex + '].AccountsId', accounts, 'accountsId', 'name', 'accountselect')}
                </td>
                <td>
                    <input type="text" class="form-control currency-display" readonly style="width: 80px; display: inline-block;">
                </td>
            </tr>
        `);

        // Credit Row
        const $CreditRow = $(`
            <tr>
                <td>${paymentRowIndex + 2}</td>
                <td>
                    <select id="fixedTypes" name="Payments[1].AccountNature" class="form-control" required readonly>
                        <option value="0">Debit</option>
                    </select>
                </td>
                <td>
                    <div class="mb-2">
                        <div class="btn-group" role="group">
                            <input type="radio" class="btn-check credit-account-type-radio" name="accountType_${paymentRowIndex + 1}" 
                                id="all_${paymentRowIndex + 1}" value="all" checked>
                            <label class="btn btn-outline-primary btn-sm" for="all_${paymentRowIndex + 1}">All</label>

                            <input type="radio" class="btn-check credit-account-type-radio" name="accountType_${paymentRowIndex + 1}" 
                                id="bank_${paymentRowIndex + 1}" value="bank">
                            <label class="btn btn-outline-primary btn-sm" for="bank_${paymentRowIndex + 1}">Banks</label>

                            <input type="radio" class="btn-check credit-account-type-radio" name="accountType_${paymentRowIndex + 1}" 
                                id="vendor_${paymentRowIndex + 1}" value="vendor">
                            <label class="btn btn-outline-primary btn-sm" for="vendor_${paymentRowIndex + 1}">Vendor</label>

                            <input type="radio" class="btn-check credit-account-type-radio" name="accountType_${paymentRowIndex + 1}" 
                                id="haji_${paymentRowIndex + 1}" value="hajji">
                            <label class="btn btn-outline-primary btn-sm" for="haji_${paymentRowIndex + 1}">Hajji</label>

                            <input type="radio" class="btn-check credit-account-type-radio" name="accountType_${paymentRowIndex + 1}" 
                                id="expense_${paymentRowIndex + 1}" value="expense">
                            <label class="btn btn-outline-primary btn-sm" for="expense_${paymentRowIndex + 1}">Expense</label>
                        </div>
                    </div>
                    ${generateDropdown('Payments[' + (paymentRowIndex + 1) + '].AccountsId', accounts, 'accountsId', 'name', 'accountselect')}
                </td>
                <td>
                    <input type="text" class="form-control currency-display" readonly style="width: 80px; display: inline-block;">
                </td>
            </tr>
        `);

        $tableBody.append($DebitRow, $CreditRow);
        paymentRowIndex += 2;
    }

    // Add this event handler for the debit radio buttons
    $(document).on('change', '.debit-account-type-radio', function() {
        const $row = $(this).closest('tr');
        const $select = $row.find('select[id="accountselect"]');
        const selectedValue = $(this).val();
        
        let filteredAccounts;
        switch(selectedValue) {
            
            case 'vendor':
                filteredAccounts = accounts.filter(acc => acc.vendor === true);
                break;

            case 'bank':
                filteredAccounts = accounts.filter(acc => acc.bank === true);
                break;
            
            case 'hajji':
                filteredAccounts = accounts.filter(acc => acc.hajji === true);
                break;

            case 'expense':
                filteredAccounts = accounts.filter(acc => acc.expense === true);
                break;

            default: // 'all'
                filteredAccounts = accounts;
                break;
        }
        
        updateDropdownOptions($select, filteredAccounts);
    });
    
    // Add this event handler for the radio buttons
    $(document).on('change', '.credit-account-type-radio', function () {
        const $row = $(this).closest('tr');
        const $select = $row.find('select[id="accountselect"]');
        const selectedValue = $(this).val();
        
        let filteredAccounts;
        switch(selectedValue) {
            
            case 'vendor':
                filteredAccounts = accounts.filter(acc => acc.vendor === true);
                break;

            case 'bank':
                filteredAccounts = accounts.filter(acc => acc.bank === true);
                break;
            
            case 'hajji':
                filteredAccounts = accounts.filter(acc => acc.hajji === true);
                break;

            case 'expense':
                filteredAccounts = accounts.filter(acc => acc.expense === true);
                break;

            default: // 'all'
                filteredAccounts = accounts;
                break;
        }
        
        updateDropdownOptions($select, filteredAccounts);
    });
    
    // Helper function to update dropdown options
    function updateDropdownOptions($select, filteredAccounts) {
        const currentValue = $select.val(); // Store current selection
        $select.empty();
        $select.append('<option value="" disabled selected>Select Account</option>');
        filteredAccounts.forEach(account => {
            $select.append(`<option value="${account.accountsId}">${account.name}</option>`);
        });
        if (currentValue && filteredAccounts.some(acc => acc.accountsId == currentValue)) {
            $select.val(currentValue); // Restore previous selection if it exists in new options
        }
    }

    // Function to generate dropdown for accounts (Payments)
    function generateDropdown(name, items, valueKey, displayKey, selector) {
        const defaultOptionText = name.includes('AccountsId') ? 'Select Account' : 'Select Account Nature';
        return `
            <select name="${name}" id="${selector}" class="form-control" required>
                <option value="" disabled selected>${defaultOptionText}</option>
                ${items.map(item => `<option value="${item[valueKey]}">${item[displayKey]}</option>`).join('')}
            </select>
        `;
    }

    // Function to add a new tax row
    function addTaxRow() {
        const $taxesBody = $('#taxesBody');

        // Increment row index for taxes
        const rowCount = taxRowIndex + 1;

        const $newTaxRow = $(`
            <tr>
                <td>${rowCount}</td>
                <td>
                    <select name="Taxes[${taxRowIndex}].AccountNature" id="TaxAccountNature" class="form-control" required>
                        <option value="" disabled selected>Select Debit/Credit Account</option>
                        <option value="0">Debit Account</option>
                        <option value="1">Credit Account</option>
                    </select>
                </td>
                <td>${generateTaxDropdown('Taxes[' + taxRowIndex + '].TaxId', taxes, 'taxId', 'taxName')}</td>
                <td><input type="number" name="Taxes[${taxRowIndex}].TaxPercentage" class="form-control tax-percentage" placeholder="Tax %" step="0.01"></td>
                <td><input type="number" name="Taxes[${taxRowIndex}].TaxAmount" class="form-control tax-input" placeholder="Enter Tax Amount" required></td>
                <td><button type="button" class="btn btn-danger" onclick="removeTaxRow(this)"><i class="bx bx-trash me-1"></i></button></td>
            </tr>
        `);

        $taxesBody.append($newTaxRow);

        taxRowIndex++;  // Increment the row index for the next tax row
    }

    // Function to generate tax dropdown for taxes
    function generateTaxDropdown(name, items, valueKey, displayKey, id) {
        const defaultOptionText = 'Select Tax';
        return `
            <select name="${name}" id="taxselect" class="form-control" required>
                <option value="" disabled selected>${defaultOptionText}</option>
                ${items.map(item => `<option value="${item[valueKey]}">${item[displayKey]}</option>`).join('')}
            </select>
        `;
    }

    // Function to remove a tax row
    function removeTaxRow(button) {
        $(button).closest('tr').remove();

        // Update serial numbers for remaining rows
        $('#taxesBody tr').each(function(index) {
            $(this).find('td:first').text(index + 1);
        });

        // Recalculate totals
        CalculateTotal();
    }

    // Add new function to handle currency conversion
    function handleCurrencyConversion() {
        const amount = parseFloat($('#Amount').val().replace(/,/g, '')) || 0;
        const roe = parseFloat($('#ROE').val()) || 1;

        const $creditRow = $('#paymentsBody tr:first');
        const $debitRow = $('#paymentsBody tr:last');
        
        const debitCurrency = $debitRow.find('.currency-display').val();
        const creditCurrency = $creditRow.find('.currency-display').val();
        
        
        // If both currencies are same, return original amount
        if (debitCurrency === creditCurrency) {
            $('#totalDebit').val(amount.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
            $('#totalCredit').val(amount.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
            return;
        }

        let convertedAmount = amount;

        if (debitCurrency === 'SAR') {
            if (creditCurrency === 'PKR') {
                convertedAmount = amount / roe;
            } else if (creditCurrency === 'USD') {
                convertedAmount = amount * roe;
            }
        } else if (debitCurrency === 'PKR') {
            if (creditCurrency === 'USD' || creditCurrency === 'SAR') {
                convertedAmount = amount * roe;
            }
        } else if (debitCurrency === 'USD') {
            if (creditCurrency === 'PKR' || creditCurrency === 'SAR') {
                convertedAmount = amount / roe;
            }
        }
        
        // Update totals
        $('#totalDebit').val(convertedAmount.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
        $('#totalCredit').val(amount.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
    }

    // Function to update all taxes when Amount changes
    function updateAllTaxes() {
        const creditAmount = parseFloat($('#totalCredit').val().replace(/,/g, '')) || 0;
        const debitAmount = parseFloat($('#totalDebit').val().replace(/,/g, '')) || 0;

        // Update each tax row
        $('#taxesBody tr').each(function() {
            const $row = $(this);
            const accountNature = $row.find('select[id="TaxAccountNature"]').val();
            const taxPercentage = parseFloat($row.find('.tax-percentage').val()) || 0;

            // Determine which amount to use based on account nature
            const amount = accountNature === "0" ? debitAmount : creditAmount;

            if (taxPercentage > 0 && amount > 0) {
                // Calculate tax amount
                const taxAmount = (amount * taxPercentage) / 100;
                $row.find('.tax-input').val(taxAmount.toFixed(2));
            }
        });

        // After updating all taxes, recalculate totals
        CalculateTotal();
    }

    function formatNumber(input) {

        let value = input.value.replace(/,/g, ''); // Remove existing commas
        if (value === "") return; // Do nothing if the field is empty
        
        // Add commas
        let formattedValue = parseFloat(value).toLocaleString('en-US');

        input.value = formattedValue;
    }

    // Add event listeners for Amount and ROE inputs
    $(document).on('input', '#Amount, #ROE', function() {
        handleCurrencyConversion();
        CalculateTotal();
        updateAllTaxes();
    });

    // Modify the account selection handler
    $(document).on('change', 'select[id="accountselect"]', function() {
        const selectedAccountId = $(this).val();
        const selectedAccount = accounts.find(acc => acc.accountsId == selectedAccountId);
        const $row = $(this).closest('tr');
        
        if (selectedAccount) {
            $row.find('.currency-display').val(selectedAccount.currency);
            handleCurrencyConversion();
            CalculateTotal();
            updateAllTaxes();
        } else {
            $row.find('.currency-display').val('');
        }
    });

    // Function to calculate total taxes
    function CalculateTotal() {
        let totalDebit = 0;
        let totalCredit = 0;
        let totalAmount = 0;
        let totalTaxes = 0;

        // Iterate through taxes and calculate total taxes
        $('#taxesBody tr').each(function() {
            const taxAmount = parseFloat($(this).find('.tax-input').val()) || 0; // Get tax amount
            totalTaxes += taxAmount; // Add to total taxes
        });

        $('#taxesSum').val(totalTaxes.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
    }

    // Function to set currencies based on selected accounts
    $(document).on('change', 'select[id="accountselect"]', function() {
        const selectedAccountId = $(this).val();
        const selectedAccount = accounts.find(acc => acc.accountsId == selectedAccountId);
        const $row = $(this).closest('tr');
        
        if (selectedAccount) {
            $row.find('.currency-display').val(selectedAccount.currency);
        } else {
            $row.find('.currency-display').val('');
        }
    });

    // Function to calculate total when amount changes
    $(document).on('input', '.amount-input', function() {
        CalculateTotal();
    });

    // Function to calculate total when account nature changes
    $(document).on('change', 'select[name="AccountNatures[]"]', function() {
        CalculateTotal();
    });

    // Function to calculate tax amount when tax percentage changes
    $(document).on('input', '.tax-percentage', function() {
        const $row = $(this).closest('tr');
        const creditAmount = parseFloat($('#totalCredit').val().replace(/,/g, ''))
        const debitAmount = parseFloat($('#totalDebit').val().replace(/,/g, ''))
        const taxPercentage = parseFloat($(this).val()) || 0;
        const accountNature = $row.closest('tr').find('select[id="TaxAccountNature"]').val();
        console.log(accountNature);
        
        const amount = accountNature === "0" ? debitAmount : creditAmount;
        
        if (taxPercentage > 0 && amount > 0) {
            // Calculate tax amount based on the selected nature's total
            const taxAmount = (amount * taxPercentage) / 100;
            $row.find('.tax-input').val(taxAmount.toFixed(2));
        }

        // After calculating the tax, call CalculateTotal to update the totals
        CalculateTotal();
    });

    // Function to calculate tax percentage when tax input changes
    $(document).on('input', '.tax-input', function() {
        const $row = $(this).closest('tr');
        const creditAmount = parseFloat($('#totalCredit').val().replace(/,/g, ''))
        const debitAmount = parseFloat($('#totalDebit').val().replace(/,/g, ''))
        const taxAmount = parseFloat($(this).val()) || 0; // Get tax amount from input
        const accountNature = $row.closest('tr').find('select[id="TaxAccountNature"]').val();
        console.log(accountNature);

        const amount = accountNature === "0" ? debitAmount : creditAmount;

        if (taxAmount > 0 && amount > 0) {
            // Calculate tax percentage as (taxAmount / amount) * 100
            const taxPercentage = (taxAmount / amount) * 100;
            $row.find('.tax-percentage').val(taxPercentage.toFixed(2));  // Set calculated tax percentage
        }

        // After updating the tax input, call CalculateTotal to update the totals
        CalculateTotal();
    });
    
    // Add event listener for TaxAccountNature change
    $(document).on('change', 'select[id="TaxAccountNature"]', function() {
        const $row = $(this).closest('tr');
        const creditAmount = parseFloat($('#totalCredit').val().replace(/,/g, ''));
        const debitAmount = parseFloat($('#totalDebit').val().replace(/,/g, ''));
        const accountNature = $(this).val();
        const taxPercentage = parseFloat($row.find('.tax-percentage').val()) || 0;
        
        const amount = accountNature === "0" ? debitAmount : creditAmount;
        
        if (taxPercentage > 0 && amount > 0) {
            // Recalculate tax amount based on the new nature selection
            const taxAmount = (amount * taxPercentage) / 100;
            $row.find('.tax-input').val(taxAmount.toFixed(2));
        }
        
        // Update totals
        CalculateTotal();
    });

    // Loading the page
    $(document).ready(function () {
        addRow();
    });

    // Function to submit the form
    function submitForm() {
        var totalDebit = parseFloat($('#totalDebit').val().replace(/,/g, '')) || 0;
        var totalCredit = parseFloat($('#totalCredit').val().replace(/,/g, '')) || 0;
        var taxSelected = true;
        var accountSelected = true;

        $('#taxesBody tr').each(function() {
            var tax = $(this).find('select[id="taxselect"]').val();
            if (tax === '') {
                taxSelected = false;
                return false;
            }
        });

        $('#paymentsBody tr').each(function() {
            var account = $(this).find('select[id="accountselect"]').val();
            if (account === '') {
                accountSelected = false;
                return false;
            }
        });

        if (totalCredit === 0 && totalDebit === 0) {
            alert('Total Debit and Total Credit cannot be 0!');
            return false;
        } else if (!taxSelected) {
            alert('Select Tax for all rows!');
            return false;
        } else if (!accountSelected) {
            alert('Select Account for all rows!');
            return false;
        }

        $('#PVForm').submit();
    }

</script>