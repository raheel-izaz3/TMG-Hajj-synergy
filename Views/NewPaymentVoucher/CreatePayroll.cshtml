    // Add this event handler for the debit radio buttons
    $(document).on('change', '.debit-account-type-radio', function() {
        const $row = $(this).closest('tr');
        const $select = $row.find('select[id="debitAccountSelect"]');
        const selectedValue = $(this).val();
        const rowIndex = paymentRowIndex - 2;

        // Remove existing debit tax inputs if any
        $row.next('.credit-tax-inputs').remove();

        if (selectedValue === 'bank') {
            $row.after(createCreditTaxInputs(rowIndex));
        }

        let filteredAccounts;
        switch(selectedValue) {

            case 'vendor':
                filteredAccounts = accounts.filter(acc => acc.vendor === true);
                break;

            case 'bank':
                filteredAccounts = accounts.filter(acc => acc.bank === true);
                break;

            case 'hajji':
                filteredAccounts = accounts.filter(acc => acc.hajji === true);
                break;

            case 'expense':
                filteredAccounts = accounts.filter(acc => acc.expense === true);
                break;

            default: // 'all'
                filteredAccounts = accounts;
                break;
        }

        updateDropdownOptions($select, filteredAccounts);
    });

    // Add this event handler for the radio buttons
    $(document).on('change', '.credit-account-type-radio', function () {
        const $row = $(this).closest('tr');
        const $select = $row.find('select[id="creditAccountSelect"]');
        const selectedValue = $(this).val();
        const rowIndex = paymentRowIndex - 1;

        // Remove existing credit tax inputs if any
        $row.next('.debit-tax-inputs').remove();

        if (selectedValue === 'bank') {
            $row.after(createDebitTaxInputs(rowIndex));
        }

        let filteredAccounts;
        switch(selectedValue) {

            case 'vendor':
                filteredAccounts = accounts.filter(acc => acc.vendor === true);
                break;

            case 'bank':
                filteredAccounts = accounts.filter(acc => acc.bank === true);
                break;

            case 'hajji':
                filteredAccounts = accounts.filter(acc => acc.hajji === true);
                break;

            case 'expense':
                filteredAccounts = accounts.filter(acc => acc.expense === true);
                break;

            default: // 'all'
                filteredAccounts = accounts;
                break;
        }

        updateDropdownOptions($select, filteredAccounts);
    });

    // Helper function to update dropdown options
    function updateDropdownOptions($select, filteredAccounts) {
        const currentValue = $select.val(); // Store current selection
        $select.empty();
        $select.append('<option value="" disabled selected>Select Account</option>');
        filteredAccounts.forEach(account => {
            $select.append(`<option value="${account.accountsId}">${account.name}</option>`);
        });
        if (currentValue && filteredAccounts.some(acc => acc.accountsId == currentValue)) {
            $select.val(currentValue); // Restore previous selection if it exists in new options
        }
    }

    // Function to generate dropdown for accounts (Payments)
    function generateDropdown(name, items, valueKey, displayKey, selector) {
        const defaultOptionText = name.includes('AccountsId') ? 'Select Account' : 'Select Account Nature';
        return `
            <select name="${name}" id="${selector}" class="form-control" required>
                <option value="" disabled selected>${defaultOptionText}</option>
                ${items.map(item => `<option value="${item[valueKey]}">${item[displayKey]}</option>`).join('')}
            </select>
        `;
    }

    document.addEventListener('DOMContentLoaded', () => {
        function handleCurrencyConversion() {
            const basicSalary = parseFloat(document.querySelector('#Amount').value) || 0;
            console.log(basicSalary);
            const fuelAllowance = parseFloat(document.querySelector('#debitOPAPTax').value) || 0;
            const medical = parseFloat(document.querySelector('#debitRemittanceTax').value) || 0;
            const others = parseFloat(document.querySelector('#debitThirdPartyTax').value) || 0;
            const otherTaxes = parseFloat(document.querySelector('#debitOtherTaxes').value) || 0;

            let totalDebit = basicSalary;

            totalDebit += fuelAllowance + medical + others - otherTaxes;

            let totalCredit = totalDebit;

            document.querySelector('#totalDebit').value = totalDebit.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            document.querySelector('#totalCredit').value = totalCredit.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }

        $(document).on('input', function () {
            handleCurrencyConversion();
        });

        document.querySelector('#creditAccountSelect').addEventListener('change', function () {
            handleCurrencyConversion();
        });
    });

    // For formating input
    function formatNumber(input) {

        let value = input.value.replace(/,/g, ''); // Remove existing commas
        if (value === "") return; // Do nothing if the field is empty

        // Add commas
        let formattedValue = parseFloat(value).toLocaleString('en-US');

        input.value = formattedValue;
    }

    // Add event listeners for Amount and ROE inputs
   

    // Loading the page
    $(document).ready(function () {
        addRow();

        // Initialize Select2 for the first account select
        $('select[id="creditAccountSelect"], select[id="debitAccountSelect"]').select2({
            placeholder: "Select Account",
            allowClear: true,
            width: '100%',
            dropdownCssClass: 'form-control',
            selectionCssClass: 'form-control'
        });

        $('select[id="creditAccountSelect"]').on('select2:select', function () {
            const selectedAccountId = $(this).val();
            const selectedAccount = accounts.find(acc => acc.accountsId == selectedAccountId);
            const $row = $(this).closest('tr'); // Get the closest row containing the select element

            if (selectedAccount && selectedAccount.currency) {
                // If currency exists, set it
                $row.find('#creditCurrency').val(selectedAccount.currency);
                console.log(selectedAccount.currency);
            } else {
                // Default to PKR if no currency or 0
                $row.find('#creditCurrency').val('PKR');
                console.log('Default currency set to PKR');
            }

            // Trigger currency conversion
            handleCurrencyConversion();
        });


        $('select[id="debitAccountSelect"]').on('select2:select', function () {
            const selectedAccountId = $(this).val();
            const selectedAccount = accounts.find(acc => acc.accountsId == selectedAccountId);
            const $row = $(this).closest('tr');  // Get the closest row containing the select element

            if (selectedAccount) {
                $row.find('#debitCurrency').val(selectedAccount.currency);
                handleCurrencyConversion();
            } else {
                $row.find('#debitCurrency').val('');
            }
        });

        $(document).on('change', '#creditAccountSelect', function () {
            const selectedEmployeeId = $(this).val();

            if (selectedEmployeeId) {
                $.ajax({
                    url: '@Url.Action("BasicSalary", "NewPaymentVoucher")',
                    type: 'GET',
                    data: { id: selectedEmployeeId },
                    success: function (basicSalary) {
                        $('#Amount').val(basicSalary); 
                    },
                    error: function () {
                        alert('Error fetching basic salary.');
                    }
                });
            } else {
                $('#Amount').val('');
            }
        });

    });

    // Function to submit the form
    function submitForm() {
        var totalDebit = parseFloat($('#totalDebit').val().replace(/,/g, '')) || 0;
        var totalCredit = parseFloat($('#totalCredit').val().replace(/,/g, '')) || 0;
        var accountSelected = true;

        $('#paymentsBody tr').each(function() {
            var account = $(this).find('select[id="accountselect"]').val();
            if (account === '') {
                accountSelected = false;
                return false;
            }
        });

        if (totalCredit === 0 && totalDebit === 0) {
            alert('Total Debit and Total Credit cannot be 0!');
            return false;
        } else if (!accountSelected) {
            alert('Select Account for all rows!');
            return false;
        }

        $('#PVForm').submit();
    }

</script>