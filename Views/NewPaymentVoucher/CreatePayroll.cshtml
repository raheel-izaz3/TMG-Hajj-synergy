@model TMG.Models.Updated_Accounts.NewPaymentVoucher
@{
    string modelName = "PaymentVoucher";
    string modelNamePlural = "Payment Voucher";
    string modelControllerRoute = "NewPaymentVoucher";
}

<div class="container-xxl flex-grow-1 container-p-y">
    <h4 class="fw-bold" style="color: #404040;"><span class="text-muted fw-light"> @modelNamePlural / </span> Create</h4>
    <hr class="mb-4" />

    <div class="row">
        <div class="col-sm-12">
            <div class="card mb-4">
                <div class="card-body">
                    <form method="post" asp-action="CreatePayroll" id="PVForm" enctype="multipart/form-data">
                        <div class="row">

                            <div class="col-sm-12 col-md-5 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname">Date</label>
                                <div class="input-group input-group-merge">
                                    <input type="date" class="form-control" value="@DateTimeManager.Today" max="@DateTimeManager.Today" asp-for="Date">
                                </div>
                            </div>

                            @* <div class="col-sm-12 col-md-4 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname">Amount</label>
                                <div class="input-group input-group-merge">
                                    <input type="text" id="Amount" class="form-control" style="display: inline-block; width: auto;" oninput="formatNumber(this)" asp-for="Amount">
                                </div>
                                <span asp-validation-for="Amount" class="text-danger"></span>
                            </div> *@

                            <div class="col-sm-12 col-md-3 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname">Payment Mode</label>
                                <div class="input-group input-group-merge">
                                    <select class="form-control" asp-for="PaymentMode">
                                        <option value="IBFT">IBFT</option>
                                        <option value="Cheque">Cheque</option>
                                        <option value="Pay Order">Pay Order</option>
                                        <option value="Cash">Cash</option>
                                    </select>
                                </div>
                                <span class="text-danger"></span>
                            </div>

                            <div class="col-sm-12 col-md-9 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname">Instrument Number</label>
                                <div class="input-group input-group-merge">
                                    <input class="form-control" id="instrumentNumber" type="text" placeholder="Enter Instrument Number..." asp-for="InstrumentNumber">
                                </div>
                                <span asp-validation-for="InstrumentNumber" class="text-danger"></span>
                            </div>

                            <div class="col-sm-12 col-md-3 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname">Proof</label>
                                <div class="input-group input-group-merge">
                                    <input class="form-control" type="file" name="image">
                                </div>
                                <span asp-validation-for="InstrumentNumber" class="text-danger"></span>
                            </div>

                            <div class="col-sm-12 col-md-12 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname">Debit | Receiver Remarks</label>
                                <div class="input-group input-group-merge">
                                    <input class="form-control" id="debitRemarks" type="text" placeholder="Debit Remarks..." asp-for="DebitRemarks">
                                </div>
                                <span asp-validation-for="DebitRemarks" class="text-danger"></span>
                            </div>

                            <div class="col-sm-12 col-md-12 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname">Credit | Sender Remarks</label>
                                <div class="input-group input-group-merge">
                                    <input class="form-control" id="creditRemarks" type="text" placeholder="Credit Remarks..." asp-for="CreditRemarks">
                                </div>
                                <span asp-validation-for="CreditRemarks" class="text-danger"></span>
                            </div>

                            <hr class="my-3">

                            <div class="row pb-3 p-0">
                                <div class="col-sm-6">
                                    <p><b>Payment List</b></p>
                                </div>
                            </div>

                            <table class="table table-bordered">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Type</th>
                                        <th>Accounts</th>
                                        <th>Currency</th>
                                    </tr>
                                </thead>
                                <tbody id="paymentsBody">
                                </tbody>
                            </table>

                           @*  <div class="col-sm-12 col-md-3 mb-3 mt-3">
                                <label class="form-label" for="basic-icon-default-fullname">ROE</label>
                                <div class="input-group input-group-merge">
                                    <input type="number" step="0.01" min="1" id="ROE" class="form-control" style="display: inline-block; width: auto;" asp-for="ROE">
                                </div>
                                <span asp-validation-for="ROE" class="text-danger"></span>
                            </div> *@

                            <hr class="my-3">

                            <div class="col-sm-12 col-md-6">
                                <p>
                                    <b>TOTAL DEBIT | RECEIVER: </b>
                                    <input id="totalDebit" readonly class="form-control" asp-for="TotalDebit" style="display: inline-block; width: auto;">
                                </p>
                            </div>

                            <div class="col-sm-12 col-md-6 text-end">
                                <p>
                                    <b>TOTAL CREDIT | SENDER: </b>
                                    <input id="totalCredit" readonly class="form-control" asp-for="TotalCredit" style="display: inline-block; width: auto;">
                                </p>
                            </div>

                        </div>

                        <div class="col-sm-12 mt-4">
                            <button type="button" onclick="submitForm()" class="btn btn-success float-end">Create</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>

    const accounts = @Html.Raw(Json.Serialize(ViewBag.Accounts));
    const accountNatures = @Html.Raw(Json.Serialize(ViewBag.AccountNatures));

    let paymentRowIndex = 0;

    // Function to add account row
    function addRow() {
        const $tableBody = $('#paymentsBody');

        // Debit Row
        const $DebitRow = $(`
            <tr>
                <td>${paymentRowIndex + 1}</td>
                <td>
                    <select id="fixedTypes" name="Payments[0].AccountNature" class="form-control" required readonly>
                        <option value="1">Credit | Sender</option>
                    </select>
                </td>
                <td>
                    <div class="mb-2">
                        ${generateDropdown('Payments[' + paymentRowIndex + '].AccountsId', accounts.filter(acc => acc.bank === true), 'accountsId', 'name', 'debitAccountSelect')}
                    </div>
                </td>
                <td>
                    <input type="text" class="form-control" id="debitCurrency" readonly style="width: 80px; display: inline-block;">
                </td>
            </tr>
        `);

        const employeeOptions = `
    @foreach (var employee in ViewBag.Employee)
    {
                <option value="@employee.EmployeeId">@employee.Name</option>
    }
    `;

        // Credit Row
        const $CreditRow = $(`
            <tr>
                <td>${paymentRowIndex + 2}</td>
                <td>
                    <select id="fixedTypes" name="Payments[1].AccountNature" class="form-control" required readonly>
                        <option value="0">Debit | Receiver</option>
                    </select>
                </td>
                <td>
                    <select id="creditAccountSelect" class="form-control creditAccountSelect" name="EmployeeId">
                    <option value="">Select Employee</option>
                       ${employeeOptions}
                    </select>
                </td>
                <td>
                    <input type="text" class="form-control" id="creditCurrency" readonly style="width: 80px; display: inline-block;">
                </td>
            </tr>
            <tr class="debit-tax-inputs">
                <td colspan="4">
                    <div class="row">
                        <div class="col-sm-2">
                            <label>Bank Charges</label>
                            <input type="text" value="0" class="form-control" name="DebitBankCharges" id="debitBankCharges">
                        </div>
                        <div class="col-sm-2">
                            <label>Basic Salary</label>
                            <input type="text" value="0" class="form-control" name="BasicSalary" id="Amount">
                        </div>
                        <div class="col-sm-2">
                            <label>Fuel Allowance</label>
                            <input type="text" value="0" class="form-control" name="Fuel" id="debitOPAPTax">
                        </div>
                        <div class="col-sm-2">
                            <label>Medical</label>
                            <input type="text" value="0" class="form-control" name="Medical" id="debitRemittanceTax">
                        </div>
                        <div class="col-sm-2">
                            <label>Others</label>
                            <input type="text" value="0" class="form-control" name="Others" id="debitThirdPartyTax">
                        </div>
                        <div class="col-sm-2">
                            <label>Leaves</label>
                            <input type="text" value="0" class="form-control" name="Leaves" id="leaves">
                        </div>
                        <div class="col-sm-2">
                            <label>Taxes</label>
                            <input type="text" value="0" class="form-control" name="DebitOtherTaxes" id="debitOtherTaxes">
                        </div>
                        <div class="col-sm-2">
                            <label>Receivale / Payable</label>
                            <select class="form-control" name="TypeDropDown">
                                <option value="Receivable">Receivable</option>
                                <option value="Payable">Payable</option>
                            </select>
                        </div>
                    </div>
                </td>
            </tr>
        `);

        $tableBody.append($DebitRow, $CreditRow);
        paymentRowIndex += 2;
    }

    // // Function to create debit tax input fields with labels in one row
    // function createDebitTaxInputs(rowIndex) {
    //     return `
    //         <tr class="debit-tax-inputs" data-row-index="${rowIndex}">
    //             <td colspan="4">
    //                 <div class="row">
    //                     <div class="col-sm-2">
    //                         <label>Bank Charges</label>
    //                         <input type="text" value="0" class="form-control" name="DebitBankCharges" id="debitBankCharges">
