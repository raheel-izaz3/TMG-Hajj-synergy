    //                         <input type="text" value="0" class="form-control" name="DebitOPAPTax" id="debitOPAPTax">
    //                     </div>
    //                     <div class="col-sm-2">
    //                         <label>Remittance Tax</label>
    //                         <input type="text" value="0" class="form-control" name="DebitRemittanceTax" id="debitRemittanceTax">
    //                     </div>
    //                     <div class="col-sm-2">
    //                         <label>Third Party Tax</label>
    //                         <input type="text" value="0" class="form-control" name="DebitThirdPartyTax" id="debitThirdPartyTax">
    //                     </div>
