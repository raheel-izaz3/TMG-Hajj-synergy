@{

    string modelName = "Report";
    string modelNamePlural = "";
    string modelControllerRoute = "Report";
}

<div class="container-xxl flex-grow-1 container-p-y">
    <h4 class="fw-bold" style="color:  #404040;"><span class="text-muted fw-light">Booking Wise - Receipt Report</span></h4>

    <hr class="mb-4" />

    <div class="row">
        <div class="col-sm-12">
            <div class="nav-align-top mb-4">
                <form method="get" action="/FamilyHeadReport/ReceiptReport">
                    <div class="card">
                        <div class="tab-content">
                            <div class="tab-pane fade  show active" role="tabpanel">
                                <div class="row">
                                    <div class="col-sm-12 col-md-12 mb-3">
                                        <label>Select Booking</label>
                                        <select name="id" id="id" class="form-select"
                                                aria-label="Default select example">
                                            <option selected disabled hidden>Select Booking</option>
                                            @foreach (FamilyHead family in ViewBag.Heads)
                                            {
                                                <option value="@family.FamilyHeadId">
                                                    @family.FullName
                                                    (@family.FcId)
                                                </option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-sm-12 mt-3">
                                        <button type="submit" class="btn btn-warning float-end" id="showReportButton">Show Report</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>

        </div>

    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(document).ready(function () {
        $('select[name="id"]').select2({
            placeholder: "Select Family Head",
            allowClear: true,
            width: '100%' // Adjust the width as needed
        });
    });
</script>

