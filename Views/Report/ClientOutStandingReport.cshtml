	<script>
		$(function () {
			var data = @Html.Raw(JsonConvert.SerializeObject(Model));

			var grid = $("#reportTable").dxDataGrid({
				dataSource: data,
				keyExpr: "HBNo",
				showBorders: true,
				columnAutoWidth: true,
				paging: {
					pageSize: 50 // ✅ paging optional, virtual ke sath bhi reh sakta hai
				},
				scrolling: {
					mode: "virtual", // ✅ tumhari demand ke mutabiq
					showScrollbar: "always"
				},
				filterRow: { visible: true },
				headerFilter: { visible: true },
				searchPanel: {
					visible: true,
					width: 240,
					placeholder: "Search..."
				},
				columns: [
					{ dataField: "SerialNumber", caption: "#" },
					{ dataField: "CompanyCode", caption: "HGO" },
					{ dataField: "SPOName", caption: "SPO" },
					{ dataField: "HajjiName", caption: "Hajji Name" },
					{ dataField: "HBNo", caption: "HbNo" },
					{ dataField: "PackageName", caption: "Package Name" },
					{ dataField: "RawCurrency", caption: "Currency" },
					{ dataField: "TotalPackage", caption: "Total Package Amount" },
					{ dataField: "Discount", caption: "Discount" },
					{ dataField: "Gross", caption: "Gross" },
					{ dataField: "ReceivedAmount", caption: "Received Amount" },
					{ dataField: "Balance", caption: "Balance" }
				],
				export: {
					enabled: true,
					fileName: "ClientOutStandingReport"
				},
				onContentReady: updateSummary,
				onOptionChanged: function (e) {
					if (e.fullName.includes("filterValue") || e.fullName.includes("searchPanel.text")) {
						updateSummary();
					}
				}
			}).dxDataGrid("instance");


			function updateSummary() {
				grid.getDataSource().load().done(function (allData) {
					function normCurrency(c) {
						if (!c) return "N/A";
						return String(c).trim().toUpperCase();
					}

					function toCents(val) {
						if (val == null) return 0;
						var n = Number(val);
						return isNaN(n) ? 0 : Math.round(n * 100);
					}

					var grouped = {};

					allData.forEach(x => {
						var cur = normCurrency(x.RawCurrency);

						if (!grouped[cur]) {
							grouped[cur] = {
								totalPackage: 0,
								discount: 0,
								gross: 0,
								received: 0,
								balance: 0
							};
						}

						grouped[cur].totalPackage += toCents(x.RawTotalPackage);
						grouped[cur].discount += toCents(x.RawDiscount);
						grouped[cur].gross += toCents(x.RawGross);
						grouped[cur].received += toCents(x.RawReceivedAmount);
						grouped[cur].balance += toCents(x.RawBalance);
					});

					var html = `<table class="table table-bordered table-striped mt-3 text-center align-middle" style="width:40%;">
							<thead style="background-color: #000; color: #fff;">
								<tr>
									<th>#</th>
									<th>Currency</th>
									<th>Total Package</th>
									<th>Total Discount</th>
									<th>Total Gross</th>
									<th>Total Received</th>
									<th>Total Balance</th>
								</tr>
							</thead>
							<tbody>`;

					var i = 1;
					Object.keys(grouped).forEach(cur => {
						var g = grouped[cur];
						html += `<tr>
									<td><strong>${i++}</strong></td>
									<td><strong>${cur}</strong></td>
									<td><strong>${(g.totalPackage / 100).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })}</strong></td>
									<td><strong>${(g.discount / 100).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })}</strong></td>
									<td><strong>${(g.gross / 100).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })}</strong></td>
									<td><strong>${(g.received / 100).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })}</strong></td>
									<td><strong>${(g.balance / 100).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })}</strong></td>
								</tr>`;
					});

					html += "</tbody></table>";

					$("#currencySummary").html(html);
				});
			}


			// Default summary render
			updateSummary();
		});


