@{
    Layout = null;
}
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Company Summary Report</title>
    <!-- Jquery  -->
    <script src="https://code.jquery.com/jquery-1.11.3.min.js"></script>

    <!-- Data Tables.min.js  -->
    <script type="text/javascript"
            src="https://cdn.datatables.net/v/dt/jszip-2.5.0/dt-1.10.16/b-1.5.1/b-colvis-1.5.1/b-html5-1.5.1/b-print-1.5.1/fh-3.1.3/datatables.min.js"></script>

    <!-- DataTable min.css -->
    <link rel="stylesheet" type="text/css"
          href="https://cdn.datatables.net/v/dt/jszip-2.5.0/dt-1.10.16/b-1.5.1/b-colvis-1.5.1/b-html5-1.5.1/b-print-1.5.1/fh-3.1.3/datatables.min.css" />

    <link href="https://cdn3.devexpress.com/jslib/23.1.3/css/dx.light.css" rel="stylesheet" />
    <script src="https://cdn3.devexpress.com/jslib/23.1.3/js/dx.all.js"></script>
    <!-- jsPDF for PDF export -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.13/jspdf.plugin.autotable.min.js"></script>





    <style>
        #gridContainer {
            /* height: 1040px; */
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        div#example_filter {
            margin-bottom: 10px;
        }

        body {
            /* width: 100vw; */
            /* height: 100vh; */
            /* overflow-x: hidden; */
            font-family: monospace;
            /* font-family: sans-serif; */
        }

        h1,
        h2,
        h3,
        h4,
        h5,
        h6,
        p {
            padding: 0;
            margin: 0;
        }

        table {
            border-collapse: collapse;
            width: 100%;
            border: none !important;
        }

            table th {
                position: sticky;
                top: 0;
                padding: 3px 4px !important;
                font-size: 10px !important;
                text-align: center !important;
                background-color: #f6f3ee !important;
                color: #b49164;
                font-weight: bold;
                border: 1px solid #b49164 !important;
            }

            table tfoot {
                position: sticky;
                bottom: 0;
                padding: 3px 4px !important;
                font-size: 10px !important;
                text-align: center !important;
                background-color: #f6f3ee !important;
                color: #b49164;
                font-weight: bold;
                border: 1px solid #b49164 !important;
            }

            table td {
                font-size: 8px !important;
                padding: 5px 2px !important;
                margin: 0 !important;
                text-align: center;
                border: 1px solid #b0872e;
            }



        caption {
            background-color: #b0872e;
            color: white;
            padding: 7px;
            font-size: 18px !important;
        }


        table.dataTable thead .sorting {
            background-image: none !important;
        }

        th.sorting {
        }

        .check-box {
            display: flex;
            justify-content: left;
            align-items: center;
            flex-wrap: wrap;
        }

        @@media print {

            label,
            input {
                display: none;
            }

            button.dt-button.buttons-excel.buttons-html5 {
                display: none;
            }

            button {
                display: none;
            }
        }

        label {
            font-size: 9px !important;
        }

        .check-box input {
            width: 20px;
        }

        .check-box {
            margin: 10px 0;
        }


        button.dt-button,
        div.dt-button,
        a.dt-button {
            background-color: #185B36 !important;
            background-image: none !important;
            color: aliceblue !important;
            border-radius: 10px;
            padding: 0.5em 24px;
            margin-bottom: 1rem;
        }
        /* Add this style for proper alignment */
        .header-container {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }

            .header-container h1,
            .header-container h3 {
                margin: 0;
            }

        /* Existing styles */
        button {
            float: left;
            box-sizing: border-box;
            margin-left: 15px;
            margin-top: 20px;
            border-radius: 8px;
            padding: 0.5em 24px;
            cursor: pointer;
            font-size: 0.88em;
            line-height: 1.6em;
            white-space: nowrap;
            background-color: #f6f3ee !important;
            color: #b49164;
            position: relative;
            border: 1px solid rgb(255, 255, 255);
            font-weight: 600;
        }


        .btn-right {
            float: right;
            margin-left: auto;
            margin-right: 0;
        }
    </style>
</head>

<body>
    <div class="header-container">
        <div>
            <h3>Company Name : @ViewBag.CompanyName</h3>
            <h3>Bank Name : @ViewBag.BankName</h3>
            <h3>For the period ended on : @ViewBag.Period</h3>
        </div>
        <button id="exportPdf" class="btn btn-primary btn-right">Export to PDF</button>
    </div>

    <div id="" class="package-div" style="">
        <div class="big-table-record" id="summaryData">
            <div id="gridContainer" style="margin-top: 20px;"></div>
        </div>

    </div>
</body>


<script>

    $(document).ready(function () {
        const dataSource = @Html.Raw(Json.Serialize(ViewBag.Result));

        var currencies = [...new Set(dataSource.map(x => x.currency))];

        var columns = [
            { dataField: "companyBankAccount", caption: "Company Bank Account" }
        ];
        console.log(currencies);

        currencies.forEach(function (currency) {
            columns.push({
                caption: currency,
                columns: [
                    {
                        dataField: currency + "_balance",
                        caption: "Closing Balance",
                        calculateCellValue: function (data) {
                            return data.currency === currency ? data.balance : null;
                        },
                        cellTemplate: function (container, options) {
                            if (options.value !== null) {
                                const formattedAmount = new Intl.NumberFormat('en-US', {
                                    minimumFractionDigits: 2,
                                    maximumFractionDigits: 2
                                }).format(options.value);
                                container.text(`${currency} ${formattedAmount}`).css("color", options.value < 0 ? 'red' : 'black');
                            }
                        },
                        summaryType: 'sum',
                        summaryText: `Total Balance: {0}`,
                    }
                ]
            });
        });

        $("#gridContainer").dxDataGrid({
            dataSource: dataSource,
            columns: columns,
            paging: {
                pageSize: 50,
                enabled: true
            },
            scrolling: {
                mode: 'infinite',
                useNative: true,
                rowRenderingMode: 'virtual',
            },
            height: 600,
            remoteOperations: {
                paging: true,
            },
            headerFilter: {
                visible: true
            },
            filterRow: {
                visible: false,
                applyFilter: "auto"
            },
            sorting: {
                mode: "multiple"
            },
            searchPanel: {
                visible: true,
                width: 240,
                placeholder: "Search..."
            },
            export: {
                enabled: true,
                fileName: "FamilyMembers",
                allowExportSelectedData: true
            },
            summary: {
                totalItems: currencies.map(function (currency) {
                    return [
                        {
                            column: currency + "_balance",
                            summaryType: "sum",
                            displayFormat: `Total Balance: {0}`,
                            valueFormat: function (value) {
                                return new Intl.NumberFormat('en-US', {
                                    style: 'currency',
                                    currency: currency
                                }).format(value);
                            }
                        }
                    ];
                }).flat()
            },
            onExporting: function (e) {
                var workbook = new ExcelJS.Workbook();
                var worksheet = workbook.addWorksheet('Main sheet');
                DevExpress.excelExporter.exportDataGrid({
                    worksheet: worksheet,
                    component: e.component,
                    customizeCell: function (options) {
                        options.excelCell.font = { name: 'Arial', size: 12 };
                        options.excelCell.alignment = { horizontal: 'left' };
                    }
                }).then(function () {
                    workbook.xlsx.writeBuffer().then(function (buffer) {
                        saveAs(new Blob([buffer], { type: 'application/octet-stream' }), 'DataGrid.xlsx');
                    });
                });
            },
        });

        $("#exportPdf").on("click", async function () {
            try {
                const { jsPDF } = window.jspdf;
                const doc = new jsPDF();

                if (doc.autoTable === undefined) {
                    console.error('autoTable plugin is not loaded correctly');
                    return;
                }

                const dataSource = @Html.Raw(Json.Serialize(ViewBag.Result));
                const currencies = [...new Set(dataSource.map(x => x.currency))];

                const headers = [['Company Bank Account', ...currencies.map(currency => `${currency} Closing Balance`)]];

                const data = dataSource.map(row => {
                    const rowData = [row.companyBankAccount];

                    currencies.forEach(currency => {
                        const formattedBalance = row.currency === currency
                            ? `${currency} ` + new Intl.NumberFormat('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(row.balance)
                            : '';
                        rowData.push(formattedBalance);
                    });

                    return rowData;
                });

                const totalRow = ['Total'];

                currencies.forEach(currency => {
                    const totalBalance = dataSource.reduce((sum, row) => sum + (row.currency === currency ? row.balance : 0), 0);
                    totalRow.push(`${currency} ` + new Intl.NumberFormat('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(totalBalance));
                });

                data.push(totalRow);

                const currentDate = new Date();

                const printedOnDate = `${currentDate.getDate().toString().padStart(2, '0')}/${currentDate.toLocaleString('en-US', { month: 'short' })}/${currentDate.getFullYear()}`;
                const printedOnTime = currentDate.toLocaleTimeString('en-GB', {
                    hour: '2-digit',
                    minute: '2-digit',
                    hour12: true
                });

                doc.autoTable({
                    head: headers,
                    body: data,
                    margin: { top: 50 },
                    styles: { fontSize: 8, cellPadding: 3 },
                    didDrawPage: function (data) {
                        const pageWidth = doc.internal.pageSize.width;
                        const textWidth = doc.getTextWidth(`PRINTED ON: ${printedOnDate} ${printedOnTime}`);
                        doc.text(`PRINTED ON: ${printedOnDate} ${printedOnTime}`, pageWidth - textWidth - 10, 10);

                        doc.text('Bank Summary Report', data.settings.margin.left, 20);
                        doc.text('Company Name: @Html.Raw(ViewBag.CompanyName)', data.settings.margin.left, 30);
                        doc.text('Bank Name: @ViewBag.BankName', data.settings.margin.left, 35);
                        doc.text('For the period ended on: @ViewBag.Period', data.settings.margin.left, 40);
                    }
                });

                const companyName = "@ViewBag.CompanyName".replace(/\s+/g, '_');
                const bankName = "@ViewBag.BankName".replace(/\s+/g, '_');
                const period = "@ViewBag.Period".replace(/\s+/g, '_');

                doc.save(`BankSummaryReport_${companyName}_${bankName}_${period}.pdf`);
            } catch (error) {
                console.error("Error generating PDF:", error);
            }
        });
    });

</script>


