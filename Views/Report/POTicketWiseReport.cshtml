	<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
	<script>
				document.getElementById("downloadPdf").addEventListener("click", async () => {
			// Select the element to export
			const element = document.getElementById("incoice_page_body");

			// Clone it to avoid modifying original DOM
			const clone = element.cloneNode(true);
			const container = document.createElement("div");
			container.appendChild(clone);
			container.style.position = "absolute";
			container.style.left = "-9999px";
			document.body.appendChild(container);

			// Add logo at the top of the cloned content
			const logo = document.createElement("img");
			logo.src = "/reportlogo/GroupLogo"; // 🔁 Use your correct path
			logo.style.width = "100px";
			logo.style.float = "right";
			logo.style.marginBottom = "20px";

			// Insert logo before everything in the clone
			clone.insertBefore(logo, clone.firstChild);

			// Configure options
			const options = {
				margin: 0.2,
				filename: 'VendorReport.pdf',
				image: { type: 'jpeg', quality: 0.98 },
				html2canvas: { scale: 2, useCORS: true },
				jsPDF: { unit: 'in', format: 'letter', orientation: 'portrait' }
			};

			// Convert and save
			await html2pdf().set(options).from(clone).save();

			// Clean up cloned container
			document.body.removeChild(container);
		});


		// Toggle column visibility based on checkbox state
		document.querySelectorAll('.column-toggle-checkbox').forEach(checkbox => {
			checkbox.addEventListener('change', function() {
				const columnIndex = this.getAttribute('data-column');
				const table = document.getElementById('reportTable');
				const rows = table.querySelectorAll('tr');

				rows.forEach(row => {
					const cell = row.cells[columnIndex];
					if (cell) {
						cell.style.display = this.checked ? '' : 'none';
					}
				});
			});
		});

		// excel export

			  document.getElementById("downloadExcel").addEventListener("click", function () {
			var table = document.getElementById("reportTable");
			var wb = XLSX.utils.book_new();
			var ws = XLSX.utils.table_to_sheet(table);

			XLSX.utils.book_append_sheet(wb, ws, "Package Report");
			XLSX.writeFile(wb, "Package_Report.xlsx");
		});

	</script>

