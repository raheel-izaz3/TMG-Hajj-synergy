				filename: 'BankStatement.pdf',
				image: { type: 'jpeg', quality: 0.98 },
				html2canvas: {
					scale: 1.5,     // Scale ko adjust kar sakte hain agar cut ho raha ho
					useCORS: true
				},
				jsPDF: {
					unit: 'pt',
					format: 'a4',
					orientation: 'portrait'
				},
				pagebreak: {
					mode: ['avoid-all', 'css', 'legacy']
				}
			};

			html2pdf().set(options).from(element).save();
		});
	</script>

