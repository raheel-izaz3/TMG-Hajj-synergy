@model IEnumerable<TMG.Controllers.BankStatment>
@{
	Layout = "";
}

<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title></title>
	<style>
		/* General reset */
		* {
			box-sizing: border-box;
		}

		body {
			font-family: Calibri, Candara, Segoe, Segoe UI, Optima, Arial, sans-serif;
			overflow-x: hidden;
			margin: 0;
			padding: 0;
		}

		h1, h2, h3, h4, h5, h6 {
			margin: 0;
			padding: 0;
		}

		p {
			font-size: 9px;
			margin: 0;
			padding: 0;
		}

		table tr th {
			font-size: 10px;
		}

		table tr td {
			font-size: 12px !important;
		}

		.AMounttotelvalue {
			color: white;
			background-color: black;
		}

		.TotalAMountTitle {
			color: white;
			background-color: black;
		}

		.downloade_btn {
			padding: 10px 45px;
			background-color: lightblue;
			outline: none;
			border: 1px solid black;
			font-weight: bold;
			font-family: Calibri, Candara, Segoe, Segoe UI, Optima, Arial, sans-serif;
			font-size: 14px;
			cursor: pointer;
		}

			.downloade_btn:hover {
				background-color: white;
			}

		.check_box_container {
			display: flex;
			justify-content: center;
			align-items: center;
		}

			.check_box_container .CheckBox {
				width: 20px;
				height: 12px;
				margin: 0;
				padding: 0;
			}

		@@media print {
			.check_box_container {
				display: none !important;
			}

			button {
				display: none;
			}
		}

		.parent {
			display: flex;
			justify-content: space-between;
			align-items: center;
		}

		.container {
			display: flex;
			align-items: center;
		}

			.container .logo {
				width: 55px;
			}

				.container .logo img {
					width: 100%;
				}

		.AL_Khair_Title {
			font-size: 18px;
			margin-left: 15px;
			font-weight: bold;
		}

		.title_break {
			font-size: 12px;
			margin-left: 15px;
			font-weight: bold;
		}

		.qr-code p {
			padding: 0;
			margin: 0;
		}

		.qr-code {
			padding: 0;
			padding-top: 20px;
		}

		.qr_number {
			text-align: right;
			margin: 0px;
			font-weight: bold;
		}

		.horizantal_line {
			border: 1px solid black;
		}

		.Invoice_to_section {
			display: flex;
			justify-content: space-between;
			flex-wrap: wrap;
		}

		.proforma_title {
			text-align: center;
			padding-top: 10px;
			margin-bottom: 15px;
		}

		.Customer_Info p {
			padding: 1px 0;
			font-weight: bold !important;
		}

		.Customer_Col_2 p {
			padding: 1px 0;
			font-weight: bold;
		}

		.Customer_Col_2 span {
			font-weight: normal;
		}

		.Customer_Info span {
			font-weight: normal;
		}

		.ALL_MEMBERS_NAMES p {
			padding: 1px 0;
		}

		.ALL_MEMBERS_NAMES span {
			font-weight: bold;
		}

		.Service_Table {
			width: 100%;
		}

			.Service_Table tr th {
				font-size: 10px;
				text-align: right;
			}

			.Service_Table tr td {
				border-bottom: 1px solid black;
				font-size: 10px;
			}

				.Service_Table tr td:nth-child(2) {
					text-align: right;
					width: 130px;
				}

			.Service_Table tr:nth-last-child(1) {
				font-weight: bold;
			}

		.Bank_Table {
			margin-top: 20px;
			border: 1px solid black;
			border-collapse: collapse;
			width: 60%;
		}

			.Bank_Table tr {
				border: 1px solid black;
			}

				.Bank_Table tr th {
					border: 1px solid black !important;
					background-color: lightblue;
					text-align: left;
					padding-left: 5px;
					font-size: 10px;
				}

				.Bank_Table tr td:nth-child(1) {
					font-weight: bold;
				}

				.Bank_Table tr td {
					text-align: left;
					border: 1px solid black;
					padding-left: 5px;
					font-size: 10px;
				}

		.Receipt_container {
			margin-top: 7px;
		}

		.ADF_Container {
			width: 60%;
		}

		.ADF_Details_Box {
			margin-bottom: 10px;
		}

		.ADF_heading {
			background-color: lightblue;
			font-weight: bold;
			font-size: 10px !important;
			text-align: center;
			color: black !important;
		}

		.totalText,
		.amountText {
			font-weight: bold !important;
			background-color: lightblue;
			font-size: 10px !important;
			color: black !important;
		}

		.terms_condition_list {
			margin-left: 6px;
			margin: 20px 0px !important;
		}

		.note_heading {
			font-size: 10px;
			font-weight: bold;
			margin-top: 10px;
		}

		.Notes_order_list {
			padding: 0;
			margin: 8px;
		}

			.Notes_order_list li {
				font-size: 8px;
				padding: 2px;
			}

		footer {
			position: fixed;
			bottom: 0;
			left: 0;
			width: 100% !important;
		}

		.footer_address {
			border-top: 1px solid black;
			text-align: center;
		}

			.footer_address h6 {
				font-weight: normal !important;
			}

		.top_service_table {
			border: 1px solid black;
			border-collapse: collapse;
			width: 100%;
			margin-bottom: 0px;
			margin-top: 10px;
		}

			.top_service_table tr th,
			.top_service_table tr td {
				border: 1px solid black;
			}

			.top_service_table tr:nth-last-child(1) {
				font-weight: bold;
				font-size: 14px !important;
				background-color: black;
				color: white;
			}

		[contenteditable] {
			width: 100px;
		}

		#Receipt_PaymentRecord,
		#Payment_Subject {
			display: none;
		}

		#Memberbreaktable {
			display: none;
			text-align: center;
		}

		label {
			font-size: 14px !important;
		}

		input[type="checkbox"] {
			transform: scale(0.8);
		}

		.check_box_container span {
			font-weight: bold;
		}

		.flex-container {
			display: flex;
			justify-content: center;
			align-items: center;
			flex-wrap: wrap;
			margin-top: 10px;
		}

		.start-iadf td {
			text-align: left !important;
		}

		/* e rule: extra space left, right aur top se */
		@@page {
			size: A4;
			margin: 15mm 15mm 10mm 15mm; /* top, right, bottom, left */
		}

		/* Content container ke andar extra padding daal rahe hain */
		#incoice_page_body {
			padding-top: 15px;
			padding-left: 15px;
			padding-right: 15px;
		}

		@@media print {
			.top_service_table {
				page-break-inside: auto;
			}

				.top_service_table tr {
					page-break-inside: avoid;
					page-break-after: auto;
				}
		}
	</style>
