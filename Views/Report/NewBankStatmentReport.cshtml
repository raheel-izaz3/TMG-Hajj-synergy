					<th style="
            text-align: left;
            font-size: 10px;
            color: black;
            background-color: lightblue;
            font-weight: bolder;
					">
						Voucher
					</th>
					<th style="
              text-align: left;
              font-size: 10px;
              color: black;
              background-color: lightblue;
              font-weight: bolder;
					">
						Name
					</th>
					<th style="
              text-align: left;
              font-size: 10px;
              color: black;
              background-color: lightblue;
              font-weight: bolder;
					">
						HBNo
					</th>
					<th style="
              text-align: left;
              font-size: 10px;
              color: black;
              background-color: lightblue;
              font-weight: bolder;
					">
						Remarks
					</th>

					<th style="
        text-align: right;
        font-size: 10px;
        color: black;
        background-color: lightblue;
					">
						Debit
					</th>
					<th style="
        text-align: right;
        font-size: 10px;
        color: black;
        background-color: lightblue;
					">
						Credit
					</th>
					<th style="
        text-align: right;
        font-size: 10px;
        color: black;
        background-color: lightblue;
					">
						Balance
					</th>
					<th style="
        text-align: right;
        font-size: 10px;
        color: black;
        background-color: lightblue;
					">
						Proof of Payment
					</th>

				</tr>
			</thead>
			@{
				float? totalDebit = 0;
				float? totalCredit = 0;
				float? lastBalance = 0;
			}
			@foreach (var item in Model)
			{
				totalDebit += item.Debit;
				totalCredit += item.Credit;
				lastBalance = item.Balance;

				<tr>
					<td>@item.Date.ToString("dd/MMM/yyyy")</td>
					<td>@item.Voucher</td>
					<td>@item.Name</td>
					<td>@item.HBNo</td>
					<td>@item.Remarks</td>
					<td style="text-align: right;">@item.Currency @item.Debit?.ToString("N2")</td>
					<td style="text-align: right;">@item.Currency @item.Credit?.ToString("N2")</td>
					<td style="text-align: right;">@item.Currency @item.Balance?.ToString("N2")</td>
					@if (item.Proof is not null)
					{
						<td style="text-align: right;">
							<a href="~/@item.Proof" target="_blank">View Proof</a>
						</td>
					}
					else
					{
						<td style="text-align: right;">No Proof Found</td>
					}
				</tr>
			}
			<tr style="background-color: black; font-weight: bold;">
				<td colspan="5" style="text-align: right;">Total:</td>
				<td style="text-align: right;">@Model.FirstOrDefault()?.Currency @totalDebit?.ToString("N2")</td>
				<td style="text-align: right;">@Model.FirstOrDefault()?.Currency @totalCredit?.ToString("N2")</td>
				<td style="text-align: right;">@Model.FirstOrDefault()?.Currency @lastBalance?.ToString("N2")</td>
				<td></td>
			</tr>

		</table>



		@* <footer>
        <div class="footer_address" id="footer">
        <h6 style="position: relative; top: -15px; font-weight: bold !important;">THIS IS A SYSTEM GENERATED INVOICE. IN CASE OF ANY DISCREPANCIES, PLEASE CONTACT YOUR COORDINATOR.</h6>
        <h6>
        Add: @ViewBag.CompanyAddress
        </h6>
        <h6>
        Phone: @ViewBag.Contact  Email: @ViewBag.Email  Web: @Model.CompanyBankAccount.Company.Website
        </h6>
        </div>
        </footer> *@
