	<script>
		document.getElementById("downloadPdf").addEventListener("click", () => {
			const element = document.getElementById("incoice_page_body");

			// ✅ Clone content
			const clone = element.cloneNode(true);
			const container = document.createElement("div");
			container.appendChild(clone);
			container.style.position = "absolute";
			container.style.left = "-9999px";
			document.body.appendChild(container);

			// ✅ Remove checkbox columns from cloned table
			const checkboxColumns = clone.querySelectorAll('.column-controls, .column-controls-container');
			checkboxColumns.forEach(el => el.remove());

			// ✅ Add logo at the top
			const logo = document.createElement("img");
			logo.src = "/reportlogo/GroupLogo.png"; // 🔁 Replace with your actual path
			logo.style.width = "100px";
			logo.style.marginBottom = "20px";
			logo.style.float = "right";
			clone.insertBefore(logo, clone.firstChild);

			// ✅ PDF export
			const options = {
				margin: 0.5,
				filename: 'SPOWiseSummaryReport.pdf',
				image: { type: 'jpeg', quality: 0.98 },
				html2canvas: { scale: 2, useCORS: true },
				jsPDF: { unit: 'in', format: 'a3', orientation: 'landscape' }
			};

			html2pdf().set(options).from(clone).save().then(() => {
				document.body.removeChild(container);
			});
		});

		// ✅ Excel Export Function
		document.getElementById("downloadExcel").addEventListener("click", () => {
			const originalTable = document.getElementById("reportTable");

			// Create a new table for export
			const newTable = document.createElement('table');
			newTable.className = originalTable.className;

			// Header
			const thead = document.createElement('thead');
			const headerRow = document.createElement('tr');

			const checkboxes = document.querySelectorAll('.column-controls input[type="checkbox"]');

			checkboxes.forEach(checkbox => {
				if (checkbox.checked) {
					const columnIndex = parseInt(checkbox.dataset.column);
					const originalHeader = originalTable.querySelector(`th:nth-child(${columnIndex + 1})`);
					if (originalHeader) {
						const newHeader = originalHeader.cloneNode(true);
						headerRow.appendChild(newHeader);
					}
				}
			});

			thead.appendChild(headerRow);
			newTable.appendChild(thead);

			// Body
			const tbody = document.createElement('tbody');
			const originalRows = originalTable.querySelectorAll('tbody tr');

			originalRows.forEach(row => {
				const newRow = document.createElement('tr');
				checkboxes.forEach(checkbox => {
					if (checkbox.checked) {
						const columnIndex = parseInt(checkbox.dataset.column);
						const cell = row.cells[columnIndex];
						if (cell) {
							newRow.appendChild(cell.cloneNode(true));
						}
					}
				});
				tbody.appendChild(newRow);
			});

			newTable.appendChild(tbody);

			// Export to Excel
			const wb = XLSX.utils.table_to_book(newTable, { sheet: "SPO Report" });
			XLSX.writeFile(wb, "SPOWiseSummaryReport.xlsx");
		});

		// ✅ Column Visibility Control
		document.addEventListener('DOMContentLoaded', function () {
			const checkboxes = document.querySelectorAll('.column-controls input[type="checkbox"]');
			const table = document.getElementById('reportTable');

			checkboxes.forEach(checkbox => {
				checkbox.addEventListener('change', function () {
					const columnIndex = parseInt(this.dataset.column);
					const cells = table.querySelectorAll(`th:nth-child(${columnIndex + 1}), td:nth-child(${columnIndex + 1})`);
					cells.forEach(cell => {
						cell.style.display = this.checked ? '' : 'none';
					});
				});
			});
		});
	</script>

