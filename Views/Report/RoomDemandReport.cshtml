    //         "searching": true,
    //     });
    // });

    $(function () {
        // Prepare data source from Razor model
        var dataSource = @Html.Raw(Json.Serialize(Model.Rows));
        console.log("DataSource:", dataSource); // Log data source to verify

        // Map roomCounts into individual fields like roomCount0, roomCount1, etc.
        const processedDataSource = dataSource.map(row => {
            row.roomCounts.forEach((count, index) => {
                row[`roomCount${index}`] = count; // Create fields like roomCount0, roomCount1, etc.
            });
            return row;
        });

        // Extract headers from Razor model (assuming Model.RoomWiseHeaders is a string with room names)
        var dynamicHeaders = @Html.Raw(Json.Serialize(Model.RoomWiseHeaders))
            .split('</th>')
            .filter(th => th.includes('<th'))
            .map(th => th.replace('<th>', '').trim()); // Assuming headers come as comma-separated values

        var dynamicColumns = dynamicHeaders.map((header, index) => {
            // Map to roomCount fields
            return {
                dataField: 'roomCount' + index,  // Data field matches roomCount0, roomCount1, etc.
                caption: header
            };
        });

        console.log("DynamicHeaders:", dynamicHeaders);
        console.log("DynamicColumns:", dynamicColumns); // Log dynamic columns to verify

        // Initialize DevExtreme DataGrid
        $("#gridContainer").dxDataGrid({
            dataSource: processedDataSource,  // Use the processed data source
            columns: [
                { dataField: "sNo", caption: "S.No" },
                { dataField: "company", caption: "Company" },
                { dataField: "package", caption: "Package" },
                { dataField: "place", caption: "Place" },
                { dataField: "hotel", caption: "Hotel" },
                { dataField: "checkIn", caption: "Check In" },
                { dataField: "packageCheckOut", caption: "Check Out (Package)" },
                ...dynamicColumns // Spread dynamic columns
            ],
            filterRow: {
                visible: true
            },
            headerFilter: {
                visible: true
            },
            sorting: {
                mode: "multiple"
            },
            columnAutoWidth: true,
            showBorders: true
        });
    });


    document.querySelectorAll('.toggle-checkbox').forEach(function (checkbox) {
        checkbox.addEventListener('change', function () {
            var sectionClass = this.id.replace('toggle', '').toLowerCase();
            var toggleSections = document.querySelectorAll('.toggle-section.' + sectionClass);
            toggleSections.forEach(function (section) {
                if (checkbox.checked) {
                    section.classList.remove('hide');
                } else {
                    section.classList.add('hide');
                }
            });

            // Check if checkbox is for hiding Outbound or Inbound
            if (checkbox.id === 'toggleHideOB') {
                var hideOBCheckbox = document.getElementById('toggleHideOB');
                if (hideOBCheckbox.checked) {
                    document.querySelectorAll('.toggle-section.OB').forEach(function (section) {
                        section.classList.add('hide');
                    });
                } else {
                    document.querySelectorAll('.toggle-section.OB').forEach(function (section) {
                        section.classList.remove('hide');
                    });
                }
            }

            if (checkbox.id === 'toggleHideIB') {
                var hideIBCheckbox = document.getElementById('toggleHideIB');
                if (hideIBCheckbox.checked) {
                    document.querySelectorAll('.toggle-section.IB').forEach(function (section) {
                        section.classList.add('hide');
                    });
                } else {
                    document.querySelectorAll('.toggle-section.IB').forEach(function (section) {
                        section.classList.remove('hide');
                    });
                }
            }
        });
    });

