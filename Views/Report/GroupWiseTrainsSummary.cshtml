<div class="big-table-record" id="summaryData">

    <div id="gridContainer"></div>

</div>

<script>
    $(function () {

        $("#gridContainer").dxDataGrid({

            dataSource: @Html.Raw(Json.Serialize(Model)),
            columns: [
                { dataField: "location", caption: "Location" },
                { dataField: "departureDate", caption: "Departure Date", dataType: "date", format: "dd-MMM-yyyy" },
                { dataField: "departureTime", caption: "Departure Time", dataType: "date", format: "HH:mm" },
                { dataField: "trainClass", caption: "Train Class" },
                { dataField: "companyCode", caption: "Company Code" },
                { dataField: "name", caption: "Package Name" },
                { dataField: "code", caption: "Group Code" },
                { dataField: "fcId", caption: "HB #" },
                { dataField: "honorifics", caption: "Honorifics" },
                { dataField: "givenName", caption: "Given Name" },
                { dataField: "surName", caption: "Surname" },
                { dataField: "passportNumber", caption: "Passport #" },
                { dataField: "passportDateOfIssue", caption: "Passport Date of Issue", dataType: "date", format: "dd-MMM-yyyy" },
                { dataField: "passportDateOfExpiry", caption: "Passport Date of Expiry", dataType: "date", format: "dd-MMM-yyyy" },
            ],
            paging: {
                pageSize: 1000
            },
            pager: {
                showPageSizeSelector: true,
                allowedPageSizes: [10, 20, 50],
                showInfo: true
            },
            searchPanel: {
                visible: true,
                width: 240,
                placeholder: "Search..."
            },
            sorting: {
                mode: "multiple"
            },
            filterRow: {
                visible: true
            },
            headerFilter: {
                visible: true
            },
            export: {
                enabled: true,
                fileName: "FamilyMembers",
                allowExportSelectedData: true
            },
            onExporting: function (e) {
                var workbook = new ExcelJS.Workbook();
                var worksheet = workbook.addWorksheet('Main sheet');
                DevExpress.excelExporter.exportDataGrid({
                    worksheet: worksheet,
                    component: e.component,
                    customizeCell: function (options) {
                        options.excelCell.font = { name: 'Arial', size: 12 };
                        options.excelCell.alignment = { horizontal: 'left' };
                    }
                }).then(function () {
                    workbook.xlsx.writeBuffer().then(function (buffer) {
                        saveAs(new Blob([buffer], { type: 'application/octet-stream' }), 'DataGrid.xlsx');
                    });
                });
            },
        });
    });
</script>
