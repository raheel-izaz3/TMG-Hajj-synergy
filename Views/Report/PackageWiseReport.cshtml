@{

    string modelName = "Report";
    string modelNamePlural = "Package Wise Report";
    string modelControllerRoute = "Report";
}

<div class="container-xxl flex-grow-1 container-p-y">
    <h4 class="fw-bold" style="color:  #404040;"><span class="text-muted fw-light"> Package Wise Report / </span> Index</h4>

    <hr class="mb-4" />

    <div class="row">
        <div class="col-sm-12">
            <div class="nav-align-top mb-4">
                @* <form method="post" enctype="multipart/form-data"> *@
                @*  <input type="hidden" asp-for="" /> *@
                <div class="card">
                    <div class="tab-content">
                        <div class="tab-pane fade  show active" role="tabpanel">
                            <div class="row">
                                <div class="col-sm-12 col-md-6 mb-3">
                                    <label class="form-label" for="basic-icon-default-fullname">Select Package</label>
                                    <span class="fw-bold text-danger"> *</span>
                                    <div class="input-group input-group-merge">
                                        <select class="form-control" id="companySelect">
                                            <option value="">Select Package</option>
                                            @foreach (var item in ViewBag.PackageWiseReport)
                                            {
                                                <option value="@item.PackageId">@item.Name</option>
                                            }
                                        </select>
                                    </div>
                                </div>
                                <div class="col-sm-12 mt-3">
                                    <button type="submit" class="btn btn-warning float-end" id="showReportButton">Show Report</button>
                                </div>
                            </div>
                        </div>
                    </div>


                </div>
            </div>

        </div>

    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(document).ready(function () {
        $('#showReportButton').on('click', function (e) {
            e.preventDefault();
            var companyId = $('#companySelect').val();

            if (companyId) {
                window.location.href = '@Url.Action("Report", "PackageReport")?id=' + companyId;
            } else {
                alert("Please select a company.");
            }
        });
    });
</script>


