<script>
    $(document).ready(function () {
        $('#summaryTable').DataTable({
            "paging": false,
            "searching": true,
            "ordering": true,
            "info": true,
        });

        $('#downloadExcel').click(function () {
            // Convert HTML table to SheetJS worksheet
            var ws = XLSX.utils.table_to_sheet(document.getElementById('summaryTable'));

            // Set custom column widths (in characters)
            // Adjust the widths as per your content
            ws['!cols'] = [
                { wch: 5 },   // #
                { wch: 20 },  // Package Name
                { wch: 15 },  // HB #
                { wch: 12 },  // Honorifics
                { wch: 15 },  // Given Name
                { wch: 15 },  // Surname
                { wch: 20 },  // Passport #
                { wch: 18 },  // Passport Date of Issue
                { wch: 18 }   // Passport Date of Expiry
            ];

            // Create workbook and add the worksheet
            var wb = XLSX.utils.book_new();
            XLSX.utils.book_append_sheet(wb, ws, "Sheet1");

            // Save file
            XLSX.writeFile(wb, 'FamilyHeads.xlsx');
        });
    });
</script>
