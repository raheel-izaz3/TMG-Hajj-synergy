@model IEnumerable<Group>

@{
    string modelName = "Group";
    string modelNamePlural = "Groups";
    string modelControllerRoute = "GroupMo";
    TMG.Data.TMGDbContext _db;
}

@if (TempData.ContainsKey("created"))
{
    if ((bool)TempData["created"]! == true)
    {
        <script>
            toastr.options.closeDuration = 100;
            toastr.options.closeButton = true;
            toastr.options.positionClass = "toast-top-center";
            toastr.options.showMethod = 'slideDown';
            toastr.options.hideMethod = 'slideUp';
            toastr.options.closeMethod = 'slideUp';
            toastr.success('', 'Group Created Successfully!', { timeOut: 2000 })
        </script>
        TempData["created"] = false;
    }
}
@if (TempData.ContainsKey("deleted"))
{
    if ((bool)TempData["deleted"]! == true)
    {
        <script>
            toastr.options.closeDuration = 100;
            toastr.options.closeButton = true;
            toastr.options.positionClass = "toast-top-center";
            toastr.options.showMethod = 'slideDown';
            toastr.options.hideMethod = 'slideUp';
            toastr.options.closeMethod = 'slideUp';
            toastr.success('', 'Group Trashed Successfully!', { timeOut: 2000 })
        </script>
        TempData["deleted"] = false;
    }
}
@if (TempData.ContainsKey("updated"))
{
    if ((bool)TempData["updated"]! == true)
    {
        <script>
            toastr.options.closeDuration = 100;
            toastr.options.closeButton = true;
            toastr.options.positionClass = "toast-top-center";
            toastr.options.showMethod = 'slideDown';
            toastr.options.hideMethod = 'slideUp';
            toastr.options.closeMethod = 'slideUp';
            toastr.success('', 'Group Updated Successfully!', { timeOut: 2000 })
        </script>
        TempData["updated"] = false;
    }
}

<div class="container-xxl flex-grow-1 container-p-y">
    <h4 class="fw-bold"><span class="text-muted fw-light"></span> Groups</h4>

    <hr class="mb-4" />

    @* @if (ViewBag.CreateAllowed == true)
    { *@
    <a asp-action="Create" class="btn btn-info">Create New</a>
    @* }
    @if (ViewBag.TrashAllowed == true)
    { *@
    <a asp-action="ViewTrash" class="btn btn-info float-end"><i class="bx bx-trash me-1"></i> Trash
        (@ViewBag.TrashCount)</a>
    @* } *@
    <br />
    <br />
    <div class="card p-2">
        <div class="table-responsive text-nowrap " style="padding-bottom: 500px">
            <table class="table table-hover" id="table">
                <thead>
                    <tr>
                        <th>#</th>
                        @* <th>Package</th> *@
                        <th>Code</th>
                        <th>Name</th>
                        <th>PAX</th>
                        <th>Selected</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody class="table-border-bottom-1">
                    @{
                        int i = 0;
                        var members = ViewBag.MemberCounts as IEnumerable<int>;
                    }
                    @foreach (Group group in Model)
                    {
                        i++;
                        <tr>
                            <td>
                                <i class="fab fa-bootstrap fa-lg text-primary me-3"></i> <strong>@group.GroupId</strong>
                            </td>
                            @* <td>@group.Package.Name</td> *@
                            <td>@group.Code</td>
                            <td>@group.Name</td>
                            <td>@group.PAX</td>
                            <td>@ViewBag.Selected[i-1]</td>
                            <td>
                                <div class="dropdown">
                                    <a class="btn btn-success" asp-action="AddMember" asp-route-GroupId="@group.GroupId"><i
                                            class="bx bx-add-to-queue me-1"></i> Add</a>

                                    <div class="btn-group" id="dropdown-icon-demo">
                                        <button type="button" class="btn btn-primary dropdown-toggle"
                                            data-bs-toggle="dropdown" aria-expanded="false">
                                            <i class="bx bxs-report"></i> Reports
                                        </button>
                                        <ul class="dropdown-menu" style="">
                                            <li>
                                                <a target="_blank" asp-controller="GroupReport" asp-action="Report"
                                                    asp-route-id="@group.PackageId" asp-route-Groupid="@group.GroupId"
                                                    class="dropdown-item d-flex align-items-center">1. Group Report</a>
                                            </li>
                                            <li>
                                                <a target="_blank" asp-controller="GroupReport"
                                                   asp-action="AziziaRoomListingSource" asp-route-id="@group.GroupId" asp-route-PackageId="@group.PackageId"
                                                    class="dropdown-item d-flex align-items-center">2. Room Listing Azizia
                                                    Source</a>
                                            </li>
                                            <li>
                                                <a target="_blank" asp-controller="GroupReport"
                                                    asp-action="AziziaRoomListing" asp-route-id="@group.GroupId"
                                                    class="dropdown-item d-flex align-items-center">3. Azizia Room
                                                    Listing</a>
                                            </li>
                                            <li>
                                                <a target="_blank" asp-controller="GroupReport"
                                                   asp-action="IndividualTokensV2" asp-route-id="@group.GroupId"
                                                   class="dropdown-item d-flex align-items-center">
                                                    4. Individual Qurbani Tokens
                                                </a>
                                            </li>
                                            <li>
                                                <a target="_blank" asp-controller="GroupReport"
                                                   asp-action="GroupWiseNusukCard" asp-route-id="@group.GroupId"
                                                   class="dropdown-item d-flex align-items-center">
                                                    5. Group Wise Nusuk Cards
                                                </a>
                                            </li>
                                            <li>
                                                <a target="_blank" asp-controller="GroupReport"
                                                   asp-action="Addresses" asp-route-id="@group.GroupId"
                                                   class="dropdown-item d-flex align-items-center">
                                                    6. Addresses Report
                                                </a>
                                            </li>
                                            @* <li>
                                                <a target="_blank" asp-controller="GroupReport"
                                                        asp-action="MedinaRoomListingSource" asp-route-id="@group.GroupId"
                                                    class="dropdown-item d-flex align-items-center">3. Medina Room
                                                    Listing</a>
                                            </li>
                                            <li>
                                                <a target="_blank" asp-controller="GroupReport"
                                                        asp-action="MakkahRoomListingSource" asp-route-id="@group.GroupId"
                                                    class="dropdown-item d-flex align-items-center">3. Makkah Room
                                                    Listing</a>
                                            </li> *@
                                        </ul>
                                    </div>
                                    @* @if (ViewBag.EditAllowed == true)
                                { *@
                                    <a class="btn btn-warning" asp-action="Edit" asp-route-id="@group.GroupId"><i
                                            class="bx bx-edit-alt me-1"></i> Edit</a>
                                    @* }
                                @if (ViewBag.TrashAllowed == true)
                                { *@
                                    <button onclick="confirmDelete(@group.GroupId)" class="btn btn-outline-danger"><i
                                            class="bx bx-trash me-1"></i> Trash</button>
                                    @* } *@
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
<script>
    function confirmDelete(id) {
        let del = confirm("Are you sure?")
        if (del) {
            location.href = `/Group/Trash/${id}`;
        }
    }

    let table = new DataTable('#table', {
        paging: false
    });
</script>
