@model TMG.Models.DepartureGroupModels.DepartureGroupCreateViewModel

@{
    ViewData["Title"] = "Edit Departure Group";
}

<div class="container-xxl flex-grow-1 container-p-y">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold m-0"><i class="bx bx-edit text-warning me-2"></i>Edit Departure Group</h4>
            <small class="text-muted">Update departure group metadata and passenger selection</small>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bx bx-arrow-back me-1"></i> Back to List
        </a>
    </div>

    <form asp-action="Edit" method="post" id="departureGroupForm">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <div class="row g-4">
            <!-- LEFT COLUMN: Departure Details Form & Passenger Selection -->
            <div class="col-lg-8">
                <!-- Top Section: Departure Group Details Card -->
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-light d-flex align-items-center">
                        <i class="bx bx-paper-plane text-success me-2 fs-4"></i>
                        <h5 class="card-title m-0 fw-bold">Departure Group Details</h5>
                    </div>
                    <div class="card-body mt-3">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="GroupName" class="form-label fw-semibold">Group Name <span class="text-danger">*</span></label>
                                <input asp-for="GroupName" class="form-control" placeholder="e.g. SV-787 VIP Departure Group A" required />
                                <span asp-validation-for="GroupName" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="PNRNumber" class="form-label fw-semibold">PNR Number</label>
                                <input asp-for="PNRNumber" class="form-control font-monospace" placeholder="e.g. XYZ789PNR" />
                                <span asp-validation-for="PNRNumber" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="AirlineId" class="form-label fw-semibold">Select Airline (From Airlines CRUD)</label>
                                <select asp-for="AirlineId" asp-items="Model.Airlines" class="form-select">
                                    <option value="">-- Select Airline --</option>
                                </select>
                                <span asp-validation-for="AirlineId" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="FlightId" class="form-label fw-semibold">Select Flight (From Flights CRUD)</label>
                                <select asp-for="FlightId" asp-items="Model.Flights" class="form-select">
                                    <option value="">-- Select Flight --</option>
                                </select>
                                <span asp-validation-for="FlightId" class="text-danger"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="FlightNumber" class="form-label fw-semibold">Flight Number</label>
                                <input asp-for="FlightNumber" class="form-control" placeholder="e.g. SV-787" />
                                <span asp-validation-for="FlightNumber" class="text-danger"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="FlightDepartureDate" class="form-label fw-semibold">Flight Departure Date</label>
                                <input asp-for="FlightDepartureDate" type="date" class="form-control" />
                                <span asp-validation-for="FlightDepartureDate" class="text-danger"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="FlightDepartureTime" class="form-label fw-semibold">Flight Departure Time</label>
                                <input asp-for="FlightDepartureTime" class="form-control" placeholder="e.g. 23:15 / 11:15 PM" />
                                <span asp-validation-for="FlightDepartureTime" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="DepartureCity" class="form-label fw-semibold">Departure City (From)</label>
                                <input asp-for="DepartureCity" class="form-control" placeholder="e.g. Jeddah / JED" />
                                <span asp-validation-for="DepartureCity" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="ArrivalCity" class="form-label fw-semibold">Arrival City (To)</label>
                                <input asp-for="ArrivalCity" class="form-control" placeholder="e.g. Lahore / LHE" />
                                <span asp-validation-for="ArrivalCity" class="text-danger"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="Remarks" class="form-label fw-semibold">Group Notes / Remarks</label>
                                <textarea asp-for="Remarks" class="form-control" rows="2" placeholder="Special luggage handling notes, departure gate instructions, etc."></textarea>
                                <span asp-validation-for="Remarks" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Bottom Section: Select Passengers from Bookings Card -->
                <div class="card shadow-sm">
                    <div class="card-header bg-light d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <div class="d-flex align-items-center">
                            <i class="bx bx-group text-success me-2 fs-4"></i>
                            <h5 class="card-title m-0 fw-bold">Select Passengers from Bookings (Multi-Select)</h5>
                        </div>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-sm btn-outline-success" id="btnSelectAll">
                                <i class="bx bx-check-square me-1"></i> Select All
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-secondary" id="btnDeselectAll">
                                <i class="bx bx-square me-1"></i> Deselect All
                            </button>
                        </div>
                    </div>
                    <div class="card-body mt-3">
                        <!-- Quick Search Box -->
                        <div class="mb-3">
                            <div class="input-group">
                                <span class="input-group-text bg-white"><i class="bx bx-search"></i></span>
                                <input type="text" id="passengerSearch" class="form-control" placeholder="Search passengers by name, passport, or CNIC..." />
                            </div>
                        </div>

                        <!-- Booking Cards -->
                        <div id="bookingCardsContainer">
                            @if (!Model.Bookings.Any())
                            {
                                <div class="text-center py-4 text-muted">
                                    <i class="bx bx-user-x display-6 d-block mb-2 text-secondary"></i>
                                    No active bookings found for the current season.
                                </div>
                            }
                            else
                            {
                                @foreach (var booking in Model.Bookings)
                                {
                                    <div class="card border mb-3 booking-card" data-booking-code="@booking.BookingCode.ToLower()" data-head-name="@booking.HeadName.ToLower()">
                                        <div class="card-header bg-light py-2 px-3 d-flex justify-content-between align-items-center">
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="badge bg-success fs-7 font-monospace">@booking.BookingCode</span>
                                                <span class="fw-bold text-dark">@booking.HeadName</span>
                                                <span class="badge bg-label-secondary font-monospace ms-1">@booking.Passengers.Count Pax</span>
                                            </div>
                                            <button type="button" class="btn btn-xs btn-outline-success btn-toggle-booking" data-booking-id="@booking.HeadId">
                                                <i class="bx bx-select-multiple me-1"></i> Select Booking Pax
                                            </button>
                                        </div>
                                        <div class="card-body p-3">
                                            <div class="row g-2">
                                                @foreach (var pax in booking.Passengers)
                                                {
                                                    <div class="col-md-6 passenger-item" data-search-text="@($"{pax.FullName} {pax.CNIC} {pax.PassportNumber} {pax.BookingCode}".ToLower())">
                                                        <div class="form-check p-2 border rounded d-flex align-items-start gap-2 h-100 bg-white">
                                                            <input type="checkbox" name="SelectedPassengerIds" value="@pax.IndividualId" class="form-check-input pax-checkbox mt-1 me-2" id="pax_@pax.IndividualId" @(pax.IsSelected ? "checked" : "") />
                                                            <label class="form-check-label w-100 cursor-pointer" for="pax_@pax.IndividualId">
                                                                <div class="d-flex justify-content-between align-items-center">
                                                                    <span class="fw-semibold text-dark">@pax.FullName</span>
                                                                    @if (pax.IsHead)
                                                                    {
                                                                        <span class="badge bg-label-success px-2 py-1">Head</span>
                                                                    }
                                                                    else
                                                                    {
                                                                        <span class="badge bg-label-secondary px-2 py-1">Member</span>
                                                                    }
                                                                </div>
                                                                <div class="small text-muted mt-1 d-flex flex-wrap gap-2">
                                                                    @if (!string.IsNullOrEmpty(pax.PassportNumber))
                                                                    {
                                                                        <span><i class="bx bx-id-card me-1"></i><strong>Pass:</strong> @pax.PassportNumber</span>
                                                                    }
                                                                    @if (!string.IsNullOrEmpty(pax.CNIC))
                                                                    {
                                                                        <span><i class="bx bx-credit-card me-1"></i><strong>CNIC:</strong> @pax.CNIC</span>
                                                                    }
                                                                </div>
                                                            </label>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- RIGHT COLUMN: Sticky Group Summary Box -->
            <div class="col-lg-4">
                <div class="card shadow-sm sticky-top" style="top: 20px; z-index: 10;">
                    <div class="card-header bg-warning text-dark py-3">
                        <h5 class="card-title m-0 fw-bold"><i class="bx bx-pie-chart-alt me-2"></i>Group Summary</h5>
                    </div>
                    <div class="card-body p-4 text-center">
                        <p class="text-muted small mb-3">
                            Select passengers from Bookings on the left to assign them to this Departure Group.
                        </p>

                        <div class="my-3">
                            <span class="text-uppercase text-muted fw-semibold d-block mb-1">Total Selected Pax</span>
                            <div class="display-4 fw-bold text-success"><span id="selectedPaxCount">0</span> Pax</div>
                            <span class="badge bg-label-success px-3 py-2 mt-2">Live Counter</span>
                        </div>

                        <hr class="my-4" />

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-warning btn-lg fw-bold shadow-sm">
                                <i class="bx bx-save me-1"></i> Update Departure Group
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            function updatePaxCount() {
                var count = $('.pax-checkbox:checked').length;
                $('#selectedPaxCount').text(count);
            }

            updatePaxCount();

            $(document).on('change', '.pax-checkbox', function () {
                updatePaxCount();
            });

            $(document).on('click', '.btn-toggle-booking', function () {
                var $card = $(this).closest('.booking-card');
                var $checkboxes = $card.find('.pax-checkbox:visible');

                if ($checkboxes.length === 0) {
                    $checkboxes = $card.find('.pax-checkbox');
                }

                var allChecked = $checkboxes.filter(':checked').length === $checkboxes.length;
                $checkboxes.prop('checked', !allChecked);
                updatePaxCount();
            });

            $('#btnSelectAll').on('click', function () {
                $('.pax-checkbox').prop('checked', true);
                updatePaxCount();
            });

            $('#btnDeselectAll').on('click', function () {
                $('.pax-checkbox').prop('checked', false);
                updatePaxCount();
            });

            $('#passengerSearch').on('keyup input', function () {
                var term = $(this).val().toLowerCase().trim();

                if (term === '') {
                    $('.passenger-item').show();
                    $('.booking-card').show();
                    return;
                }

                $('.booking-card').each(function () {
                    var $card = $(this);
                    var bookingCode = $card.attr('data-booking-code') || '';
                    var headName = $card.attr('data-head-name') || '';
                    var cardMatchesHeader = bookingCode.indexOf(term) !== -1 || headName.indexOf(term) !== -1;

                    var visiblePaxCount = 0;
                    $card.find('.passenger-item').each(function () {
                        var $item = $(this);
                        var text = $item.attr('data-search-text') || '';
                        if (cardMatchesHeader || text.indexOf(term) !== -1) {
                            $item.show();
                            visiblePaxCount++;
                        } else {
                            $item.hide();
                        }
                    });

                    if (visiblePaxCount > 0) {
                        $card.show();
                    } else {
                        $card.hide();
                    }
                });
            });
        });
    </script>
}
