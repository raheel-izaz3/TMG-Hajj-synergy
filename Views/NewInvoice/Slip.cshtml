<style>
    @@media print {
        body * {
            visibility: hidden;
        }

        #printThis,
        #printThis * {
            visibility: visible;
        }

        #printThis {
            position: absolute;
            left: 0;
            top: 0;
        }
    }
</style>

<div class="container mt-5">
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <h3>Acknowledgment Slip</h3>
                    <a class="btn btn-success" asp-action="Print"
                        asp-route-id="@ViewBag.Invoice.Invoice.NewInvoiceId">Print</a>
                </div>
                <div class="card-body" id="printThis">
                    <div class="row mt-3">
                        <div class="col-md-4">
                            <b>Received From: </b>@(ViewBag.Invoice != null ? ViewBag.Invoice.FamilyHead.GivenName :
                            "N/A")
                        </div>
                        <div class="col-md-4">
                            <b>Receipt Date: </b>@(ViewBag.Invoice != null ?
                            ViewBag.Invoice.Invoice.CreatedAt.ToString("yyyy-MM-dd") : "N/A")
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div class="col-md-4">
                            <b>Received Amount: </b>@(ViewBag.Invoice != null ? ViewBag.Invoice.Invoice.AmountRecieved :
                            "N/A")
                        </div>
                        <div class="col-md-4">
                            <b>Receipt No: </b>HB #@ViewBag.FamilyHead.FamilyHeadId  R#@(ViewBag.Invoice != null ? ViewBag.Invoice.Invoice.NewInvoiceId : "N/A")
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div class="col-md-4">
                            <b>Currency: </b>@(ViewBag.Invoice != null ? ViewBag.Invoice.Invoice.Currency : "N/A")
                        </div>
                        <div class="col-md-4">
                            <b>SPO Name: </b>@(ViewBag.Invoice != null ? ViewBag.Invoice.FamilyHead.GivenName : "N/A")
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div class="col-md-4">
                            <b>Payment Mode: </b>@(ViewBag.Invoice != null ? ViewBag.Invoice.Invoice.ModeOfPayment :
                            "N/A")
                        </div>
                        <div class="col-md-4">
                            <b>ROE: </b>@(ViewBag.Invoice != null ? ViewBag.Invoice.Invoice.PKRROE : "N/A"),
                            <b>SAR ROE: </b>@(ViewBag.Invoice != null ? ViewBag.Invoice.Invoice.SARROE : "N/A"),
                            <b>USD ROE: </b>@(ViewBag.Invoice != null ? ViewBag.Invoice.Invoice.USDROE : "N/A")
                        </div>
                    </div>

                    <div class="row mt-3">
                        <div class="col-md-4">
                            <b>Instrument Number: </b>@(ViewBag.Invoice != null ? ViewBag.Invoice.Invoice.Instrument :
                            "N/A")
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div class="col-sm-12">
                            <b>Remarks: </b>@(ViewBag.Invoice != null ? ViewBag.Invoice.Invoice.Remarks : "N/A")
                        </div>
                    </div>
                    <div class="row mt-5">
                        <div class="col-sm-12">
                            @if (ViewBag.Invoice.Invoice.ImagePath is not null)
                            {
                                <img loading="lazy" width="100%" src="~/@ViewBag.Invoice.Invoice.ImagePath" />
                            }
                            else
                            {
                                <img loading="lazy" width="100%" src="@ViewBag.Invoice.Invoice.ImageBase64" />
                            }
                        </div>
                    </div>
                    <style>
                        table {
                            border: none;
                            caption-side: bottom;
                            border-collapse: separate;
                            border-color: green;
                            margin-top: 200px;
                        }

                        tr td {
                            border-top: 1px solid black
                        }
                    </style>
                    <div class="row mt-5">
                        <div class="col-md-12">
                            <table class="table">
                                <tr>
                                    <td width="15%">Prepared By</td>
                                    <td width="15%">Posted By</td>
                                    <td width="15%">Checked By</td>
                                    <td width="15%">Approved By</td>
                                    <td width="15%">Received By</td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>

    @* function printDiv(divId) {
        var printContents = document.getElementById(divId).innerHTML;
        var originalContents = document.body.innerHTML;

        document.body.innerHTML = printContents;

        window.print();

        document.body.innerHTML = originalContents;
        } *@
</script>
