<script>
	$(function () {
		var dataSource = @Html.Raw(Json.Serialize(Model));
		console.log(dataSource);

		$("#invoiceTable").dxDataGrid({
			dataSource: dataSource,
			showBorders: true,
			paging: {
				pageSize: 10,
			},
			pager: {
				showPageSizeSelector: true,
				allowedPageSizes: [5, 10, 20],
				showInfo: true,
			},
			filterRow: {
				visible: true
			},
			headerFilter: {
				visible: true
			},
			scrolling: {
				mode: "virtual",
				showScrollbar: "always"
			},
			searchPanel: {
				visible: true,
				width: 240,
				placeholder: "Search..."
			},
			columns: [
				{
					caption: "#",
					cellTemplate: function (container, options) {
						$("<strong>")
							.text(options.rowIndex + 1)
							.appendTo(container);
					},
					width: 50
				},
				{ dataField: "receiptNumber", caption: "RV#", width: 80 },
				{ dataField: "date", caption: "Recipt Date", dataType: "date", width: 150, format: "dd/MMM/yyyy" },
				{ dataField: "clearanceDate", caption: "Clearance Date", dataType: "date", width: 150, format: "dd/MMM/yyyy" },
				{ dataField: "companyCode", caption: "Company", width: 150 },
				{ dataField: "chequeNumber", caption: "Cheque Number", width: 150 },
				{ dataField: "chequeDate", caption: "Cheque Date", dataType: "date", width: 150, format: "dd/MMM/yyyy" },
				{ dataField: "bankName", caption: "Bank Name", width: 150 },
				{ dataField: "packageName", caption: "Package", width: 200 },
				{ dataField: "name", caption: "SPO", width: 200 },
				{
					dataField: "fullName",
					caption: "Family Head",
					calculateCellValue: function (data) {
						return `${data.fullName} (${data.fcId}) - (${data.baseCurrency})`;
					},
					width: 200
				},
				{ dataField: "currencies", caption: "Currency", width: 100 },
				{ dataField: "roe", caption: "R.O.E", width: 100 },
				{
					dataField: "amountRecieved",
					caption: "Amount",
					format: { type: "fixedPoint", precision: 0 },
					width: 150
				},
				{ dataField: "receiptStatus", caption: "Status", width: 120 },
				{
					caption: "Actions",
					cellTemplate: function (container, options) {
						const data = options.data;

						var changeStatusAllowed = @Html.Raw(Json.Serialize(ViewBag.ChangeStatusAllowed));
						var slipAllowed = @Html.Raw(Json.Serialize(ViewBag.SlipAllowed));
						var editAllowed = @Html.Raw(Json.Serialize(ViewBag.EditAllowed));
						var trashAllowed = @Html.Raw(Json.Serialize(ViewBag.TrashAllowed));
						var financeSignatureAllowed = @Html.Raw(Json.Serialize(ViewBag.FinanceSignatureAllowed));

						var changeStatusUrl = `@Url.Action("ChangeStatus", "NewInvoice")?id=${data.newInvoiceId}`;
						var hajjPrintUrl = `@Url.Action("HajjPrint", "NewInvoice")?id=${data.newInvoiceId}`;
						var editUrl = `@Url.Action("Edit", "NewInvoice")?id=${data.newInvoiceId}`;

						var currentUserId = @Html.Raw(Json.Serialize(int.Parse(http.HttpContext.Session.GetString("UserId"))));

						if (financeSignatureAllowed === true) {
							if (data.financeSignature == null) {
								$("<button>")
									.addClass("btn btn-primary text-white")
									.text("Add Finance Signature")
									.on("click", function (e) {
										e.preventDefault();
										let id = data.newInvoiceId;
										let signType = 'Finance';

										if (confirm("Are you sure you want to add a finance signature?")) {
											$.ajax({
												url: "/NewInvoice/AddSignature",
												type: 'POST',
												data: {
													id: id,
													signatureType: signType
												},
												success: function (response) {
													if (response.success) {
														alert('Success', 'Signature added successfully!');
														$(this).hide();
													} else {
														alert('Error', 'Failed to add signature');
													}
												},
												error: function () {
													alert('Error', 'An error occurred');
												}
											});
										} else {
											alert("Action cancelled.");
										}

										return false;
									})
									.appendTo(container);
							}
						}

						if (changeStatusAllowed === true) {
							$("<a>")
								.addClass("btn btn-warning")
								.attr("href", changeStatusUrl)
								.attr("target", "_blank")
								.text("Change Status")
								.appendTo(container);
						}
						if (slipAllowed === true) {
							$("<a>")
								.addClass("btn btn-info")
								.attr("href", hajjPrintUrl)
								.attr("target", "_blank")
								.text("Hajj Slip")
								.appendTo(container);
						}
						if (editAllowed === true && currentUserId === 1) { 
							$("<a>")
								.addClass("btn btn-warning")
								.attr("href", editUrl)
								.html('<i class="bx bx-edit-alt me-1"></i> Edit')
								.appendTo(container);
						}
						// if (trashAllowed === true) {
						// 	$("<button>")
						// 		.addClass("btn btn-outline-danger")
						// 		.attr("onclick", `confirmDelete(${data.newInvoiceId})`)
						// 		.html('<i class="bx bx-trash me-1"></i> Trash')
						// 		.appendTo(container);
						// }
					},
					width: 600
				}
			],
		});
	});
</script>

