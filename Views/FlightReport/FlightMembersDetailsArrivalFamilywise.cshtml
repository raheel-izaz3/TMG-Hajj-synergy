@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
      

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            border: 2px solid #ecbe66;
            /* height: 100vh; */
          
        }



        .mytable table {
            /* border-collapse: collapse; */
            width: 100%;
            border-spacing: 5px !important;
        }



            .mytable table th {
                /* border-spacing: 30px !important; */
                /* border: 1px solid black; */
                text-align: center;
                font-size: 12px;
                background-color: #ecbe66;
                border-radius: 10px;
                color: #7c6435;
                font-weight: bold;
                padding: 4px;
            }

        .Pkgname {
            color: #816a3e;
            font-weight: bold;
            text-align: right;
            display: block;
            position: relative;
            top: -15px;
            right: 29%;
        }

        .airport-flighNo {
            margin-top: 15px;
        }




        .mytable table td {
            /* border: 1px solid black; */
            border-bottom: 1.5px solid #ecbe66;
            text-align: center;
            font-size: 8px;
            color: #7c6435;
            font-weight: bold;
            padding: 10px;
        }

        .arival-box {
            flex-grow: 1;
            text-align: center;
        }

        .top-header {
            max-height: 60px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            /* border: 1px solid green; */
        }




        .akh-pic {
            width: 150px;
            height: 100px;
            padding-top: 16px;
            padding-left: 10px;
        }

            .akh-pic img {
                width: 100%;
                padding: 10px;
            }

        .hajj-pic {
            width: 110px;
            height: 100px;
        }

            .hajj-pic img {
                width: 100%;
                padding: 10px;
            }
            @@media print{
                .hajj-pic img {
                margin-left: 10px !important;
            }
            }

        .welcome-text {
            text-align: center;
            color: #4c4d4d;
            letter-spacing: 5px;
            margin-bottom: 15px;
            font-size: 25px;
        }

        .clinet-name {
            text-align: center;
            color: #ddb25f;
            font-weight: bolder;
            letter-spacing: -4px;
            margin: 0;
            margin-right: 20px !important; 
            padding: 0;
            font-size: 50px;
            text-shadow: -2px 2px 1px rgba(81, 67, 21, 0.8);
            width:75%;
            /* border:2px solid red; */
        }

        .company-name {
            padding: 12px;
            margin-left: 2px;
        }

            .company-name h3 {
                color: #ae801f;
            }

        .clinet-name h1 {
            margin-left: -100px !important;
        }


        .chech-in-out-box {
            display: flex;
            justify-content: space-between;
            align-items: center;
            /* display: flex; */
            /* justify-content: space-between !important; */
            /* align-items: center; */
            /* background:red; */
        }

            .chech-in-out-box span {
                margin: 0px 3px;
                text-align: left !important;
                background-color: #ecbe66;
                padding: 3px;
                display: inline-block;
                border-radius: 5px;
                font-size: 10px;
            }

        
        .pax-box ul li {
            margin: 0 15px;
            color: #ecbe66;
            font-weight: bold;
        }

            .pax-box ul li span {
                color: #4c4d4d !important;
                font-weight: bold;
            }
            @@media print {
                .clinet-data{
                    padding:10px!important;  
                    margin-right:30px !important;
                    /* margin-top:10px; */
                }
               

            }

        .client-profile {
            /* width:60px; */
            /* border:1px solid red; */
            margin-left: 15px;
            border: 3px solid #7d663d;
            /* border:2px solid red; */
            /* object-fit: contain; */
            width: 135px;
            height: 135px;
            /* background:red;
            right:100px !important;
            top:0;
            position:fixed; */
            margin:0px !important;
            padding:0px !important;
        }

            .client-profile img {
                width: 100%;
                /* height: 100%; */
            }
            .fixed-img{
                /* position:relative; */
            }
    </style>
</head>

<body>
    <div class="top-header">
        <div class="akh-pic">
            @* <img src="/Images/TMG Logo.png" alt="TMG-Logo"> *@
        </div>
        <div class="welcome-text">
            <h1>WELCOME</h1>
        </div>
        <div class="hajj-pic" style="margin-right: 250px !important">
            @* <img style="height: 250px !important; width: 340px !important;" src="/Images/Hajj with Al TMG.png" alt="Hajj-With-AlKhair"> *@
        </div>
    </div>

    <div class="clinet-data" style="display: flex; margin-left: 10%;">
        <div class="client-profile">
            <img src="~/@ViewBag.details[0].MemberImage" alt="" width="135px;" height="135px">
        </div>
        <div class="clinet-name">
            <h1>@ViewBag.details[0].FullName</h1>
        </div>
    </div>

    <!-- Compnay Name -->
    <div class="company-name">
        <h3>@ViewBag.details[0].MunazimName</h3>
        <h5>@ViewBag.details[0].CompanyName</h5>
    </div>

    <div class="table-box" style="display: flex; justify-content: space-between; ">
        <div class="mytable" style="width: 75%; ">
            <table>
                <tr>
                    <th>NAME</th>
                    <th>CID</th>
                    <th>GENDER</th>
                    <th>PASSPORT</th>
                    <th>CONTACT NO</th>
                </tr>
                <tbody>
                    <tr>
                    </tr>
                    @foreach(var item in ViewBag.details)
                    {
                        <tr>
                            <td>@item.FullName</td>
                            <td>@item.CID</td>
                            <td>@item.Gender</td>
                            <td>@item.PassportNumber</td>
                            <td>@item.Contact</td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>

        <div style="  padding: 15px 15px; margin: 0px 10px; font-size: 11px; font-weight: bold; color: #7c6435; border: 2px solid #ecbe66;"
             class="arival-box">
            <span style="margin-left: 5px; background-color: #ecbe66; border-radius: 8px; padding: 5px 8px;">
                ARIVAL
                DATE
            </span>
            <span style="margin-left: 5px; background-color: #ecbe66; border-radius: 8px; padding: 5px 8px;">
                ARIVAL
                TIME
            </span>

            <div class="check-in-date " style="margin-top: 10px;">
                <span style="margin-right: 40px ; margin-left: 9px;  color: #7c6435; font-weight: bold;">@ViewBag.details[0].ArrivalDate.ToString("dd/MMM")</span>
                <span style="margin-left: 0px; color: #7c6435; font-weight: bold;">@ViewBag.details[0].ArrivalDate.ToString("HH:mm")</span>
            </div>

            <div class="airport-flighNo">
                <span style="margin-left: 5px; background-color: #ecbe66; border-radius: 8px; padding: 5px 15px;">
                    AIRPORT
                </span>
                <span style="margin-left: 5px; background-color: #ecbe66; border-radius: 8px; padding: 5px 8px;">
                    FLIGHT
                    NO.
                </span>

                <div class="check-in-date" style="margin-top: 10px;">
                    <span style="margin-left: 8px; margin-right: 35px; color: #7c6435; font-weight: bold;"></span>
                    <span style="margin-left: 45px; color: #7c6435; font-weight: bold;">@ViewBag.details[0].FlightNo</span>
                </div>
                <hr style="border-top:2px solid #ecbe66; margin-top: 10px;">
            </div>

            <div class="airport-flighNo">
                <span style="margin-left: 5px; background-color: #ecbe66; border-radius: 8px; padding: 5px 15px;">
                    VEHICLE
                    TYPE
                </span>
                <span style="margin-left: 5px; background-color: #ecbe66; border-radius: 8px; padding: 5px 8px;">
                    NO. OF VEHCILE
                </span>

                <div class="check-in-date " style="margin-top: 10px; text-align: center;">
                    @foreach (var vehicle in ViewBag.Vehicle)
                    {
                        <li style="margin-right: 90px; color: #7c6435; font-weight: bold; list-style: none !important">@vehicle.Type</li>
                    }
                    <li style="margin-left: 100px; color: #7c6435; margin-top: -20px !important; font-weight: bold; list-style: none !important">@ViewBag.VehiclesCount</li>
                </div>
                <hr style="border-top:2px solid #ecbe66; margin-top: 40px;">
            </div>
            <div class="hotel-name-text" style="margin-top: 10px;text-align: left;">
                <span style="background-color: #ecbe66; border-radius: 8px; padding: 4px 15px;">
                    HOTEL
                    NAME
                </span>
                <div class="qr-box" style="display: flex;   align-items: center; margin: 0; padding: 0;  justify-content:space-between;">
                    <h4>@ViewBag.details[0].HotelName</h4>
                    <div>
                    <p style="font-size: smaller !important; padding-left: 30px !important;margin-bottom: 2px !important">Location</p>
                    <img src="https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=.@ViewBag.details[0].Location" width="50px" height="50px" style="margin-left: 25px;">
                    </div>
                </div>
                <div class="night-div">
                    <span style="background-color: #ecbe66; border-radius: 5px; padding: 5px 10px; display: inline-block; margin-bottom: 10px;">NIGHTS</span>
                    <Span style="margin-left: 20px;">@ViewBag.details[0].Nights</Span>
                </div>

                <div class="chech-in-out-box">
                    <div>
                    <span>CHECK-IN</span>
                    <span>CHECK-OUT</span>
                    <span>CONTRACT-ID</span> 
                    </div>
                    <div>
                    <p style="font-size: smaller !important; margin-bottom: 2px !important">Hotel Contract ID</p>
                        <img src="~/@ViewBag.details[0].QR" style="margin-left: 25px !important" width="50px" height="50px">
                    </div>
                </div>

                <div class="input-check-in-out" style="display: flex; justify-content:left;  margin-top: -13px;">
                    <div class="checin-in-date-time" style="margin-right: 20px;">
                      <span style="margin-left: 8px;">@(ViewBag.details[0].CheckIn != DateTime.MinValue ? ViewBag.details[0].CheckIn.ToString() : "")</span>
                      <p style="margin-left: 9px;">@(ViewBag.details[0].CheckOut != DateTime.MinValue ? ViewBag.details[0].CheckOut.ToString() : "")</p>
                    </div>
                    <span style="margin-left: -2px;"> @ViewBag.details[0].EhajjContractNumber</span>
                </div>
            </div>
        </div>


    </div>
    </div>

    <div class="pax-box">
        <ul style="list-style: none; display: flex; ;">
            <li>PAX: <span>@ViewBag.PAX</span></li>
            <li>M: <span>@ViewBag.Male</span></li>
            <li>F: <span>@ViewBag.Female</span></li>
        </ul>
        <span class="Pkgname">@ViewBag.details[0].PackageName</span>
    </div>






</body>

</html>