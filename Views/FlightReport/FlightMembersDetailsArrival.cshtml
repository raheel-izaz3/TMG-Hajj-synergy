<body>

    <div class="checkbox-container" id="checkbox">
        <label for="checkbox1">SR</label>
        <input type="checkbox" name="checkbox1" id="checkbox1"
               onchange='document.getElementById("summaryData").classList.toggle("hide1")' checked>
        <label for="checkbox2">FULL-NAME</label>
        <input type="checkbox" name="checkbox2" id="checkbox2"
               onchange='document.getElementById("summaryData").classList.toggle("hide2")' checked>
        <!-- checkbox-2--- -->
        <label for="checkbox3">IMAGE</label>
        <input type="checkbox" name="checkbox3" id="checkbox3"
               onchange='document.getElementById("summaryData").classList.toggle("hide3")' checked>
        <label for="checkbox4"> CID</label>
        <input type="checkbox" name="checkbox" id="checkbox4"
               onchange='document.getElementById("summaryData").classList.toggle("hide4")' checked>
        <label for="checkbox5">PACKAGE</label>
        <input type="checkbox" name="checkbox" id="checkbox5"
               onchange='document.getElementById("summaryData").classList.toggle("hide5")' checked>
        <label for="checkbox6">PASSPORT</label>
        <input type="checkbox" name="checkbox" id="checkbox6"
               onchange='document.getElementById("summaryData").classList.toggle("hide6")' checked>
        <label for="checkbox7">GENDER</label>
        <input type="checkbox" name="checkbox" id="checkbox7"
               onchange='document.getElementById("summaryData").classList.toggle("hide7")' checked>
        <label for="checkbox8">HOTE CONTRACT ID</label>
        <input type="checkbox" name="checkbox" id="checkbox8"
               onchange='document.getElementById("summaryData").classList.toggle("hide8")' checked>
        <label for="checkbox9">HOTAL NAME</label>
        <input type="checkbox" name="checkbox" id="checkbox9"
               onchange='document.getElementById("summaryData").classList.toggle("hide9")' checked>
        <label for="checkbox10">CHECK-IN</label>
        <input type="checkbox" name="checkbox" id="checkbox10"
               onchange='document.getElementById("summaryData").classList.toggle("hide10")' checked>
        <label for="checkbox11">CHECK-IN DATE</label>
        <input type="checkbox" name="checkbox" id="checkbox11"
               onchange='document.getElementById("summaryData").classList.toggle("hide11")' checked>
        <label for="checkbox12">CHECK-OUT</label>
        <input type="checkbox" name="checkbox" id="checkbox12"
               onchange='document.getElementById("summaryData").classList.toggle("hide12")' checked>
        <label for="checkbox13">CHECK-OUT DATE</label>
        <input type="checkbox" name="checkbox" id="checkbox13"
               onchange='document.getElementById("summaryData").classList.toggle("hide13")' checked>
        <label for="checkbox14">VEHICLE</label>
        <input type="checkbox" name="checkbox" id="checkbox14"
               onchange='document.getElementById("summaryData").classList.toggle("hide14")' checked>



    </div>


    <!-- DataTable -->
    <!-- <h2 style="text-align: center; background-color: #fedf7b; padding: 5px;"></h2> -->
    <div class="myTable" id="summaryData">
        <table id="example" class="display " style="width: 100% !important;">


<div style="display: flex; background-color: #b49164; color: white; border-radius: 2px; align-items: center; padding: 10px !important">
    <h2 style="margin-right: auto;">Flight No: @ViewBag.details[0].FlightNo</h2>
    <h2 style="width: 70%; text-align: center; margin-right: 250px !important;">ARRIVAL REPORT FIGHT-WISE</h2>
</div>

            @foreach (var item in ViewBag.PNR)
            {
                <h2>@item.PNR</h2>
            }
            


            <button onclick="print()">Print</button>


            <thead>
            <th>Sr</th>
            <th hidden>Id</th>
            <th>HB #</th>
            <th>FULL-NAME</th>
            <th>IMAGE</th>
            <th>CID</th>
            <th> PACKAGE </th>
            <th>PASSPORT</th>
            <th>GENDER</th>
            <th>HOTEL CONTRACT ID</th>
            <th>HOTEL NAME</th>
            <th>CHECK-IN</th>
            <th>CHECK-IN DATE</th>
            <th>CHECK-OUT</th>
            <th>CHECK-OUT DATE</th>
            <th>VEHICLE TYPE</th>


            </thead>

            <tbody>
                @{
                    int index = 1;
                }
                @foreach (var item in ViewBag.details)
                {
                    <tr>
                        <td hidden class="FamilyMembersId">@item.FmId</td>
                        <td>@index</td>
                        @if (item.IsHead == true)
                        {
                            <td><a href="@Url.Action("FlightMembersDetailsArrivalFamilywise", "FlightReport", new { id = item.FcId })">@item.FcId</a></td>
                        }
                        else
                        {
                            <td></td>
                        }
                        <td>@item.FullName </td>
                        <td><img src="~/@item.MemberImage" alt="" width="40px" height="40px"></td>
                        <td>@item.CID</td>
                        <td>@item.PackageName</td>
                        <td>@item.PassportNumber</td>
                        <td>@item.Gender</td>
                        <td>@item.EhajjContractNumber</td>
                        <td>@item.HotelName</td>
                        <td>@(item.CheckIn == DateTime.MinValue ? "" : item.CheckIn.ToString("HH:mm"))</td>
                        <td>@(item.CheckIn == DateTime.MinValue ? "" : item.CheckIn.Date.ToString("yyyy-MM-dd"))</td>
                        <td>@(item.CheckOut == DateTime.MinValue ? "" : item.CheckOut.ToString("HH:mm"))</td>
                        <td>@(item.CheckOut == DateTime.MinValue ? "" : item.CheckOut.Date.ToString("yyyy-MM-dd"))</td>
                        <td>
                            <select name="vehicle[@index]" class="vehicle-dropdown" style="font-size: 8px;">
                                <option value="0">Select Vehicle</option>
                                @foreach (var vec in ViewBag.Vehicle)
                                {
                                    if (vec.VehicleId == item.AssignedVehicle)
                                    {
                                        <option value="@vec.VehicleId" selected>@vec.VehicleType</option>
                                    }
                                    else
                                    {
                                        <option value="@vec.VehicleId">@vec.VehicleType</option>
                                    }
                                }
                            </select>
                        </td>
                        @{
                            index++;
                        }
                    </tr>
                }
            </tbody>
        </table>
        <button id="save" class="btn btn-primary" onclick="btnSave_Click()">Save</button>
    </div>




    <script>
        document.getElementById("save").addEventListener("click", function () {
            var vehicleData = [];
            $('.vehicle-dropdown').each(function () {
                var vehicleId = $(this).val();
                var _FamilyMembersId = $(this).closest('tr').find('.FamilyMembersId').text();
                vehicleData.push({ _FamilyMembersId: _FamilyMembersId, VehicleId: vehicleId });
                console.log(vehicleId);
                console.log(_FamilyMembersId);
            });
            // Proceed with AJAX request
            $.ajax({
                type: 'POST',
                url: '/Flight/btnSave_Click',
                data: {
                    VehicleData: vehicleData
                },
                success: function (data) {
                    alert("Vehicles Assigned");
                    console.log(vehicleData);
                    console.log(data);
                    return
                    window.location.href = data.redirectTo;
                },
                error: function (error) {
                    console.error(error);
                }
            });
        });
    </script>



    <!-- JS Scripting  -->
    <script>
        // Initialize DataTable
        $(document).ready(function () {
            $('#example').DataTable({
                responsive: true,
                dom: '<"dom_wrapper fh-fixedHeader"Bf>tip',
                buttons: [
                    {
                        extend: "excel",
                        text: "Excel",
                        footer: true, // Include footer rows in Excel export
                    },
                ],
                // "scrollY": "200px", // Adjust height as needed
                "scrollCollapse": true,
                "paging": false, // Disable pagination if necessary
                "info": false,
                // "sScrollY": false,
                "ordering": true,

            });
        });
    </script>


</body>

</html>