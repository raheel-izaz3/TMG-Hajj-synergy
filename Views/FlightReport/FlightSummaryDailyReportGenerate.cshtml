<h1>Flight Summary Daily Report</h1>

<div class="big-table-record" id="summaryData">
    <button id="exportButton">Export To Excel</button>
    <button id="printButton" style="margin-bottom: 5vh !important">Print</button>
    <table style="width:100%" id="myTable" class="table-responsive">
        <thead>
            <tr>
                @foreach (var member in ViewBag.place)
                {
                    if (member.PlaceId == 2)
                    {
                        member.PlaceName = "Medinah";
                    }
                    else
                    {
                        member.PlaceName = "Jeddah";
                    }
                    <th>@member.PlaceName</th>
                }
                @foreach (var date in ViewBag.flight)
                {
                    if (date is DateTime)
                    {
                        <th>@(date.ToString("dd/MMM"))</th>
                    }
                }

                @foreach (var item in ViewBag.time)
                {
                    <th>@item.ArrivalDateTime.ToString("HH:mm")</th>
                }

            </tr>
            <tr>
                <th>SrNo</th>
                <th>HGO</th>
                @foreach (var member in ViewBag.flights)
                {
                    <th>@member.FNo</th>
                }
            </tr>
        </thead>
        <tbody>





            @{
                int trcount = 0;
            }
            @foreach (var company in ViewBag.Companies)
            {
                <tr>
                    <td></td>
                    <td>@company.CompanyCode</td>
                    @{
                        var correspondingResult1 = ViewBag.Results;
                        int tdcount = 0;
                        
                    }
                    @for (int i = 0; i < correspondingResult1.Count; i++)
                    {

                        @for (int j = 0; j < ViewBag.time.Count; j++)
                        {
                            var timeKey = ViewBag.time[j].ArrivalDateTime.ToString("HH:mm") + ViewBag.time[j].OutboundFlightNumber.ToString();


                            if (correspondingResult1[i].CompanyCode == company.CompanyCode && correspondingResult1[i].ArrivalDateTime.ToString("HH:mm") + correspondingResult1[i].OutboundFlightNumber.ToString() == timeKey)
                            {
                                if (tdcount != j)
                                {
                                    @* if (tdcount == 1)
                                    {
                                        <td></td>
                                        tdcount = tdcount + 1;
                                    } *@
                                    {
                                        var tdcount1 = tdcount;
                                        for (int k = 0; k < j - tdcount1; k++)
                                        {
                                            <td></td>
                                            tdcount = tdcount + 1;
                                        }
                                    }
                                    
                                }
                                @* if(j != 0 && trcount != 0)
                                {
                                    for (int k = 0; k < j -1; k++)
                                    {
                                        <td></td>
                                    }
                                } *@
                                <td>
                                    @if (correspondingResult1[i].FamilyHeadCount != null)
                                    {
                                        var flight1 = ViewBag.FlightId.Count;
                                        if (flight1 == i)
                                        {
                                            <a href="@Url.Action("FlightMembersDetailsArrival", "FlightReport", new { id = correspondingResult1[i].FlightId })">@correspondingResult1[i].FamilyHeadCount</a>
                                        }
                                        else
                                        {
                                            <a href="@Url.Action("FlightMembersDetailsArrival", "FlightReport", new { id = correspondingResult1[i].FlightId })">@correspondingResult1[i].FamilyHeadCount</a>
                                        }
                                        
                                        tdcount = tdcount + 1;
                                        break;
                                    }
                                </td>
                            }
                            else
                            {
                                

                            }
                        }
                    }
                   
                </tr>
                trcount++;
            }
        </tbody>
        <tfoot>
            <tr>
                <td colspan="2">Total</td>
                @{
                    var timeCounts = new Dictionary<string, int>();

                    var timecounter = 0;
                    foreach (var item in ViewBag.time)
                    {

                        var time = item.ArrivalDateTime.ToString("HH:mm") + item.OutboundFlightNumber.ToString();
                        timeCounts.Add(time, timecounter);
                    }
                    foreach (var result in ViewBag.Results)
                    {
                        var time = result.ArrivalDateTime.ToString("HH:mm") + result.OutboundFlightNumber.ToString();
                        timeCounts[time] += result.FamilyHeadCount ?? 0;
                    }

                    foreach (var item in ViewBag.time)
                    {
                        var time = item.ArrivalDateTime.ToString("HH:mm") + item.OutboundFlightNumber.ToString();
                        <td>@(timeCounts[time])</td>
                    }
                }
            </tr>
        </tfoot>
    </table>
</div>

<script>
    document.getElementById('exportButton').addEventListener('click', function () {
        // Get table data
        var table = document.getElementById('myTable');
        var wb = XLSX.utils.table_to_book(table, { sheet: "FlightSummary" });
        // Save as Excel file
        XLSX.writeFile(wb, 'FlightSummary.xlsx');
    });
    document.getElementById('printButton').addEventListener('click', function () {
        // Trigger the print functionality
        window.print();
    });
</script>