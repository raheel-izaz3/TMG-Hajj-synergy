    $(function () {
        var dataSource = @Html.Raw(Json.Serialize(Model));
        console.log(dataSource);

        $("#gridContainer").dxDataGrid({
            dataSource: dataSource,
            columns: [
                { dataField: "familyHeadGivenName", caption: "Given Name" },
                { dataField: "familyHeadSurName", caption: "Sur Name" },
                { dataField: "hbNo", caption: "HB #" },
                { dataField: "passportNumber", caption: "Passport Number" },
                { dataField: "passportExpiry", caption: "Passport Expiry", dataType: "date", format: "dd-MMM-yyyy" },
                { dataField: "dateOfBirth", caption: "Date of Birth", dataType: "date", format: "dd-MMM-yyyy" },
                { dataField: "groupName", caption: "Group Name" },
                { dataField: "packageName", caption: "Package Name" },
                { dataField: "airline", caption: "Airline" },
                { dataField: "flightType", caption: "Flight Type" },
                { dataField: "class", caption: "Class" },
                { dataField: "origin", caption: "Origin" },
                { dataField: "destination", caption: "Destination" },
                { dataField: "departureDate", caption: "Departure Date", dataType: "date", format: "dd-MMM-yyyy" },
                { dataField: "departureTime", caption: "Departure Time" },
                { dataField: "arrivalDate", caption: "Arrival Date", dataType: "date", format: "dd-MMM-yyyy" },
                { dataField: "arrivalTime", caption: "Arrival Time" },
                { dataField: "flightNo", caption: "Flight Number" },
                { dataField: "pnrNo", caption: "PNR Number" },
                { dataField: "total", caption: "Total", dataType: "number", format: { type: "fixedPoint", precision: 2 } },
                { dataField: "vehicleToHotel", caption: "Vehicle to Hotel / Airport" },
            ],
            paging: {
                pageSize: 15000,
            },
            searchPanel: {
                visible: true
            },
            filterRow: {
                visible: true
            },
            sorting: {
                mode: "multiple"
            },
            headerFilter: {
                visible: true
            },
            selection: {
                mode: "single"
            },
            summary: {
                totalItems: [
                    {
                        column: "total",
                        summaryType: "sum",
                        displayFormat: "Total: {0}",
                        valueFormat: "fixedPoint",
                        showInColumn: "total",
                        skipEmptyValues: false
                    }
                ]
            },
            export: {
                enabled: true,
                fileName: "FlightSummary"
            }
        });
    });

    document.querySelectorAll('.toggle-checkbox').forEach(function (checkbox) {
        checkbox.addEventListener('change', function () {
            var sectionClass = this.id.replace('toggle', '').toLowerCase();
            var toggleSections = document.querySelectorAll('.toggle-section.' + sectionClass);
            toggleSections.forEach(function (section) {
                if (checkbox.checked) {
                    section.classList.remove('hide');
                } else {
                    section.classList.add('hide');
                }
            });

            // Check if checkbox is for hiding Outbound or Inbound
            if (checkbox.id === 'toggleHideOB') {
                var hideOBCheckbox = document.getElementById('toggleHideOB');
                if (hideOBCheckbox.checked) {
                    document.querySelectorAll('.toggle-section.OB').forEach(function (section) {
                        section.classList.add('hide');
                    });
                } else {
                    document.querySelectorAll('.toggle-section.OB').forEach(function (section) {
                        section.classList.remove('hide');
                    });
                }
            }

            if (checkbox.id === 'toggleHideIB') {
                var hideIBCheckbox = document.getElementById('toggleHideIB');
                if (hideIBCheckbox.checked) {
                    document.querySelectorAll('.toggle-section.IB').forEach(function (section) {
                        section.classList.add('hide');
                    });
                } else {
                    document.querySelectorAll('.toggle-section.IB').forEach(function (section) {
                        section.classList.remove('hide');
                    });
                }
            }
        });
    });

    // document.getElementById('exportButton').addEventListener('click', function () {
