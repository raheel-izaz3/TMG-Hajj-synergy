@model EHajjModelRequest

@{
    string modelName = "E Hajj Contract";
    string modelNamePlural = "E Hajj Contracts";
    string modelControllerRoute = "EHajj";
}

<script>
    function getPackages(id) {
        $.ajax({
            url: "/EHajj/GetPackages/" + id,
            success: res => {
                console.log(res)
                const elem = document.getElementById("packages")
                for (let p of res) {
                    elem.innerHTML += `<option ${p.packageId == @Model.PackageId ? 'selected' : ''} value="${p.packageId}">${p.name}</option>`
                }
            },
            error: err => {
                console.log(err)
            }
        })
    }

