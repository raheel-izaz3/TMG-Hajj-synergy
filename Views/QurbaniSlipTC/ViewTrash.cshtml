@model IEnumerable<QurbaniSlipTC>
@{
    string modelName = "Qurbani Slip T&C";
    string modelNamePlural = "Qurbani Slip T&Cs";
    string modelControllerRoute = "QurbaniSlipTC";
    TMG.Data.TMGDbContext _db;
}

@if (TempData.ContainsKey("restored"))
{
    if ((bool)TempData["restored"]! == true)
    {
        <script>
            toastr.options.closeDuration = 100;
            toastr.options.closeButton = true;
            toastr.options.positionClass = "toast-top-center";
            toastr.options.showMethod = 'slideDown';
            toastr.options.hideMethod = 'slideUp';
            toastr.options.closeMethod = 'slideUp';
            toastr.success('', '@modelName Restored Successfully!', { timeOut: 2000 })
        </script>
        TempData["restored"] = false;
    }
}

<div class="container-xxl flex-grow-1 container-p-y">
    <h4 class="fw-bold" style="color:  #404040;"><span class="text-muted fw-light"></span> @modelNamePlural / Trash</h4>

    <hr class="mb-4" />
    <div class="card p-2">
        <div class="table-responsive text-nowrap ">
            <table class="table table-hover" id="table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Notes</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody class="table-border-bottom-1">
                    @{
                        int i = 0;
                    }
                    @*    @if (Model.Count() == 0)
                    {
                    <tr>
                    <td colspan="3" class="text-danger text-center">No Data Found!</td>
                    </tr>
                    } *@
                    @foreach (QurbaniSlipTC tc in Model)
                    {
                        i++;
                        <tr>
                            <td>
                                <i class="fab fa-bootstrap fa-lg text-primary me-3"></i> <strong>@tc.QurbaniSlipTCId</strong>
                            </td>

                            @if (tc.SlipTC.Length >= 100)
                            {
                                <td title="@tc.SlipTC">@tc.SlipTC.Substring(0, 100)...</td>
                            }
                            else
                            {
                                <td title="@tc.SlipTC">@tc.SlipTC</td>
                            }
                            <td>
                                <div class="dropdown">
                                    <button class="btn btn-info" onclick="confirmRestore(@tc.QurbaniSlipTCId)">
                                        <i class="bx bx-recycle me-1"></i> Restore
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

        </div>
    </div>
</div>
<script>
    function confirmRestore(id) {
        let del = confirm("Are you sure?")
        if (del) {
            location.href = `/@modelControllerRoute/Restore/${id}`;
        }
    }

    let table = new DataTable('#table', {
    });
</script>

