                        }   

                        usddebit += (parseInt(res.model.debits[i]) / parseInt(res.model.usdRoe[i]))
                        usdcredit += (parseInt(res.model.credits[i]) / parseInt(res.model.usdRoe[i]))
                        usdbalance += (i == 0) ? (usddebit - usdcredit) : ((usdbalance + usddebit) - usdcredit)

                    }
                    else if (res.model.currency[i] == 'GBP') {

                        var r_debit = (parseInt(res.model.debits[i]) / parseInt(res.model.usdRoe[i]))
                        var r_credit = (parseInt(res.model.credits[i]) / parseInt(res.model.usdRoe[i]))
                         if(res.accountNature == 0){
                            var r_balance = (i == 0) ? ((open_pkrbalance + r_debit) - r_credit) : ((r_balance + r_debit) - r_credit)
                        }else{
                            var r_balance = (i == 0) ? ((open_pkrbalance + r_credit) - r_debit) : ((r_balance + r_credit) - r_debit)
                        }   

                        usddebit += (parseInt(res.model.debits[i]) / parseInt(res.model.usdRoe[i]))
                        usdcredit += (parseInt(res.model.credits[i]) / parseInt(res.model.usdRoe[i]))
                        usdbalance += (i == 0) ? (usddebit - usdcredit) : ((usdbalance + usddebit) - usdcredit)

                    }

                    else if (res.model.currency[i] == 'EURO') {

                        var r_debit = (parseInt(res.model.debits[i]) / parseInt(res.model.usdRoe[i]))
                        var r_credit = (parseInt(res.model.credits[i]) / parseInt(res.model.usdRoe[i]))
                        if(res.accountNature == 0){
                            var r_balance = (i == 0) ? ((open_pkrbalance + r_debit) - r_credit) : ((r_balance + r_debit) - r_credit)
                        }else{
                            var r_balance = (i == 0) ? ((open_pkrbalance + r_credit) - r_debit) : ((r_balance + r_credit) - r_debit)
                        }   


                        usddebit += (parseInt(res.model.debits[i]) / parseInt(res.model.usdRoe[i]))
                        usdcredit += (parseInt(res.model.credits[i]) / parseInt(res.model.usdRoe[i]))
                        usdbalance += (parseInt(res.model.balances[i]) / parseInt(res.model.usdRoe[i]))

                    }



                    usdledger += `<tr>`
                    usdledger += `<td>${res.model.dateTimes[i].split("T")[0]}</td>`
                    usdledger += `<td>${res.model.voucherIds[i]}</td>`
                    usdledger += `<td>INV-HB #${res.invoiceId}</td>`
                    usdledger += `<td>${res.model.details[i]}</td>`
                    usdledger += `<td>USD ${r_debit.toLocaleString()}</td>`
                    usdledger += `<td>USD ${r_credit.toLocaleString()}</td>`
                    if(r_balance < 0){
                            usdledger += `<td>PKR (${Math.abs(r_balance).toLocaleString()}) </td>`
                        }else{
                            usdledger += `<td>PKR ${r_balance.toLocaleString()} </td>`
                        }
                    usdledger += `</tr>`


                }


                
                 if(res.accountNature == 0){
                     usdbalance = (open_usdbalance + usddebit) - usdcredit;
                }else{
                     usdbalance = (open_usdbalance + usdcredit) - usddebit;
                }
               

                usdledger += `</tbody>`
                usdledger += `<tfoot>`
                usdledger += `<tr class="bg-custome">`
                usdledger += `<td colspan=4 class="text-white"><b>Total</b></td>`
                usdledger += `<td class="text-white">USD ${usddebit.toLocaleString()}</td>`
                usdledger += `<td class="text-white">USD ${usdcredit.toLocaleString()}</td>`
               if(usdbalance < 0){
                            usdledger += `<td class="text-white">PKR (${Math.abs(usdbalance).toLocaleString()})</td>`
                        }else{
                            usdledger += `<td class="text-white">PKR ${usdbalance.toLocaleString()}</td>`
                        }
                usdledger += `</tr>`
                usdledger += `</tfoot>`
                usdledger += `</table>`
                usdledger += `</div>`


                $('#usdledger').html(usdledger)









                // Print Opening Balance

                document.getElementById('pkr_open').innerText = open_pkrbalance.toLocaleString()
                document.getElementById('sar_open').innerText = open_sarbalance.toLocaleString()
                document.getElementById('usd_open').innerText = open_usdbalance.toLocaleString()


                // Print Date Differ
                 document.getElementById('pkr_from').innerText = startDate
                 document.getElementById('pkr_to').innerText = endDate

                 document.getElementById('sar_from').innerText = startDate
                document.getElementById('sar_to').innerText =  endDate

                 document.getElementById('usd_from').innerText = startDate
                 document.getElementById('usd_to').innerText =  endDate


            },
            error: err => {
                console.log(err)
            }
        });
    }


    getLedger(@ViewBag.Account.id,"@ViewBag.Account.startDate","@ViewBag.Account.endDate")

  
</script>





<script>
    function getAccount() {
        var categoryId = $("#category_id").val();
        console.log(categoryId)

        if (categoryId) {
            $.ajax({
                url: "/Type/GetAccount/",
                data: { categoryId: categoryId },
                method: "GET",
                success: res => {
                    console.log(res)
                    let html = `<option value="">Select Account</option>`;

                    for (let i of res) {
                        html += `<option value="${i.accountId}">${i.name}</option>`;
                    }
                    $("#account_id").html(html);
                },
                error: err => {
                    console.log(err)
                }
            });
        } else {
            $("#category_id").html('<option value="">Third Select Sub Type </option>');
        }
    }


    
</script>

