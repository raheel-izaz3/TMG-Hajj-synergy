@model IEnumerable<LedgerReportModel>

<div class="container-xxl flex-grow-1 container-p-y">
    <h4 class="fw-bold" style="color:  #404040;"><span class="text-muted fw-light">Accounts / </span> Ledger Account</h4>
    <hr class="mb-4" />

    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-body">
                    <div class="row">
                      
                        <div class="col-md-12 mb-2">
                            <lable>Select Account</lable>
                            <select class="form-control" id="account_id" name="accountId" aria-label="Default Account Name">
                                <option selected disabled hidden>Select Accuont Name</option>
                                 @foreach (Account account in ViewBag.Account)
                                {
                                    <option value="@account.AccountId">@account.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label>Start Date</label>
                            <input type="date" id="startDate" class="form-control"/>
                        </div>
                        <div class="col-md-6">
                            <label>End Date</label>
                            <input type="date" id="endDate" class="form-control" />
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div class="col-md-3">
                            <input type="button" class="btn btn-primary w-100" value="Get Ledger" onclick="getLedger()" />
                        </div>
                           <div class="col-md-3">
                            <input type="button" class="btn btn-success w-100" id="printButton" value="Print" onclick="getPrint()" />
                        </div>
                         <div class="col-md-6 mt-2">
                              <input type="checkbox" onclick="showPkr(this)" checked/>
                                <label>PKR</label>
                                <input type="checkbox" onclick="showSar(this)"  />
                                <label>SAR</label>
                                <input type="checkbox" onclick="showUsd(this)" />
                                <label>USD</label>
                              
                            </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-5" id="showpkrledger">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <h4 class="text-center"> Statement (PKR)</h4>
                </div>
                <div class="card-body" id="pkrledger">

                </div>
            </div>
        </div>
    </div>

    
    <div class="row mt-5" id="showsarledger" style="display: none;">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <h4 class="text-center"> Statement (SAR)</h4>
                </div>
                <div class="card-body" id="sarledger">

                </div>
            </div>
        </div>
    </div>

    
    <div class="row mt-5" id="showusdledger" style="display: none;">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <h4 class="text-center"> Statement (USD)</h4>
                </div>
                <div class="card-body" id="usdledger">

                </div>
            </div>
        </div>
    </div>

</div>



<script>


    function getPrint(){
        var myElement = document.getElementById("printButton");
        var id = myElement.getAttribute("data-account-id");

        var startDate = document.getElementById('startDate').value;
        var endDate = document.getElementById('endDate').value;
        location.href = `/Ledger/Print?id=${id}&startDate=${startDate}&endDate=${endDate}`;
    }
    function getCategories() {
        var subTypeId = $("#subTypes").val();

        if (subTypeId) {
            $.ajax({
                url: "/Account/GetCategories/" + subTypeId,
                method: "GET",
                success: res => {
                    console.log(res)
                    let html = `<option value="">Select Category...</option>`;
                    for (let category of res) {
                        html += `<option value="${category.categoryId}">${category.name}</option>`;
                    }
                    $("#category_id").html(html);
                },
                error: err => {
                    console.log(err)
                }
            });
        } else {
            $("#categories").html('<option value="">First Select Sub Type</option>');
        }
    }
</script>
<script>
    function getSubTypes() {
        var companyId = $("#companyId").val();
        var typeId = $("#typeId").val();

        if (companyId && typeId) {
            $.ajax({
                url: "/Type/GetSubTypes/",
                data: { companyId: companyId, typeId: typeId },
                method: "GET",
                success: res => {
                    console.log(res)
                    let html = `<option value="">Select Sub Type</option>`;

                    for (let subtype of res) {
                        html += `<option value="${subtype.subTypeId}">${subtype.name}</option>`;
                    }
                    $("#subTypes").html(html);
                },
                error: err => {
                    console.log(err)
                }
            });
        } else {
            $("#subTypes").html('<option value="">Second Select Type </option>');
        }
    }
</script>
<script>
    function getCategory() {
        var subTypeId = $("#subTypeId").val();

        if (subTypeId) {
            $.ajax({
                url: "/Type/GetCategory/",
                data: { subTypeId: subTypeId },
                method: "GET",
                success: res => {
                    console.log(res)
                    let html = `<option value="">Select Category</option>`;

                    for (let i of res) {
                        html += `<option value="${i.categoryId}">${i.name}</option>`;
                    }
                    $("#category_id").html(html);
                },
                error: err => {
                    console.log(err)
                }
            });
        } else {
            $("#category_id").html('<option value="">Third Select Sub Type </option>');
        }
    }
</script>
<script>


    function showPkr(input) {
        if (input.checked == false) {
            document.getElementById('showpkrledger').style.display = 'none'
        } else {
            document.getElementById('showpkrledger').style.display = 'block'
        }
    }
    function showUsd(input) {
        if (input.checked == false) {
            document.getElementById('showusdledger').style.display = 'none'
        } else {
            document.getElementById('showusdledger').style.display = 'block'
        }
    }
    function showSar(input) {
        if (input.checked == false) {
            document.getElementById('showsarledger').style.display = 'none'
        } else {
            document.getElementById('showsarledger').style.display = 'block'
        }
    }


    function getLedger() {
        $('#ledger').html("")

        var account_id = document.getElementById('account_id').value;        
        document.getElementById('printButton').setAttribute('data-account-id',account_id);
        var startDate = document.getElementById('startDate').value;
        var endDate = document.getElementById('endDate').value;


           $.ajax({
            url: "/Ledger/GetLedger/",
            data: {
                account_id: account_id,
                startDate: startDate,
                endDate: endDate,
              
            },

            method: "GET",
            success: res => {
                console.log(res)


                // Opening Balance

                let open_pkrdebit = 0;
                let open_pkrcredit = 0;
                let open_pkrbalance = 0;

                for (let i in res.model_open.voucherIds) {



                    if (res.model_open.currency[i] == 'PKR') {

                        var r_debit = (parseInt(res.model_open.debits[i]))
                        var r_credit = (parseInt(res.model_open.credits[i]))

                        if(res.model_open.creditDebit[i] == 'Debit'){
                            var r_balance = (i == 0) ? (r_debit - r_credit) : ((r_balance + r_debit) - r_credit)
                        }else{
                            var r_balance = (i == 0) ? (r_debit - r_credit) : ((r_balance + r_credit) - r_debit)
                        }
                   

                        open_pkrdebit += (parseInt(res.model_open.debits[i]))
                        open_pkrcredit += (parseInt(res.model_open.credits[i]))
                        open_pkrbalance += (i == 0) ? (open_pkrdebit - open_pkrcredit) : ((open_pkrbalance + open_pkrdebit) - open_pkrcredit)

                    }
