<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(document).ready(function () {
        $("#gridContainer").dxDataGrid({
            dataSource: @Html.Raw(Json.Serialize(Model)),
            // keyExpr: "DepartmentFilingId",
            columns: [
                {
                    caption: "#",
                    width: 50,
                    cellTemplate: function (container, options) {
                        container.text(options.rowIndex + 1);
                    }
                },
                {
                    dataField: "company.companyName",
                    caption: "Company",
                    width: 150 // Set a fixed width or allow it to auto-resize
                },
                {
                    dataField: "companyDepartment.companyDepartmentName",
                    caption: "Department",
                    width: 150 // Set a fixed width or allow it to auto-resize
                },
                {
                    dataField: "date",
                    caption: "Date",
                    dataType: "date",
                    format: "dd/MMM/yyyy",
                    width: 100 // Set a fixed width or allow it to auto-resize
                },
                {
                    dataField: "note",
                    caption: "Note",
                    width: 200 // Set a fixed width or allow it to auto-resize
                },
                {
                    caption: "Actions",
                    cellTemplate: function (container, options) {
                        let departmentFilingId = options.data.departmentFilingId;
                        let viewButton = `<a class="btn btn-info" href="@Url.Content("~/")` + options.data.document + `" target="_blank">View Document</a>`;
                        let editButton = `<a class="btn btn-warning" href="/@modelControllerRoute/Edit/` + departmentFilingId + `"><i class="bx bx-edit-alt me-1"></i> Edit</a>`;
                        let deleteButton = `<button onclick="confirmDelete(` + departmentFilingId + `)" class="btn btn-outline-danger"><i class="bx bx-trash me-1"></i> Trash</button>`;

                        let actionButtons = '';

                        if (options.data.document != null) {
                            actionButtons += viewButton + ' ';
                        }
                        actionButtons += editButton + ' ';
                        actionButtons += deleteButton;

                        $(container).append(actionButtons);
                    }

                }
            ],
            showBorders: true,
            paging: {
                pageSize: 10
            },
            pager: {
                showPageSizeSelector: true,
                allowedPageSizes: [10, 25, 50, 100],
                showInfo: true
            },
            searchPanel: {
                visible: true,
                width: 240,
                placeholder: "Search..."
            },
            sorting: {
                mode: "multiple"
            },
            filterRow: {
                visible: true
            },
            headerFilter: {
                visible: true
            },
            scrolling: {
                mode: "virtual", 
                showScrollbar: "always" 
            },
            columnAutoWidth: true, 
            wordWrapEnabled: true, 
        });
    });


    function confirmDelete(id) {
        let del = confirm("Are you sure?");
        if (del) {
            location.href = `/@modelControllerRoute/Trash/${id}`;
        }
    }
</script>

