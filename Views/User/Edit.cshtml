@model UserEditRequest

<div class="container-xxl flex-grow-1 container-p-y">
    <h4 class="fw-bold" style="color:  #404040;"><span class="text-muted fw-light"> Users / </span>  Edit</h4>

    <hr class="mb-4" />

    <div class="row">
        <div class="col-sm-12">
            <div class="card mb-4">
                <div class="card-body">
                    <form method="post" enctype="multipart/form-data">
                        <input type="hidden" asp-for="UserId" />
                        <div class="row">
                            <div class="col-sm-12 col-md-6 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname" asp-for="Username"></label>
                                <div class="input-group input-group-merge">
                                    <span id="basic-icon-default-fullname2" class="input-group-text"><i class="bx bx-user"></i></span>
                                    <input asp-for="Username" class="form-control" id="basic-icon-default-fullname" placeholder="Enter Username..." aria-describedby="basic-icon-default-fullname2">
                                </div>
                                <span class="text-danger" asp-validation-for="Username"></span>
                            </div>
                            <div class="col-sm-12 col-md-6 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname" asp-for="Email"></label>
                                <div class="input-group input-group-merge">
                                    <span id="basic-icon-default-fullname2" class="input-group-text"><i class="bx bx-envelope"></i></span>
                                    <input asp-for="Email" class="form-control" id="basic-icon-default-fullname" placeholder="Enter Email..." aria-describedby="basic-icon-default-fullname2">
                                </div>
                                <span class="text-danger" asp-validation-for="Email"></span>
                            </div>
                            <div class="col-sm-12 col-md-6 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname" asp-for="PinCode"></label>
                                <div class="input-group input-group-merge">
                                    <span id="basic-icon-default-fullname2" class="input-group-text"><i class="bx bx-envelope"></i></span>
                                    <input asp-for="PinCode" class="form-control" id="basic-icon-default-fullname" placeholder="Enter Pin Code..." aria-describedby="basic-icon-default-fullname2">
                                </div>
                                <span class="text-danger" asp-validation-for="PinCode"></span>
                            </div>

                            <div class="col-sm-12 col-md-12 mb-3">
                                <label class="form-label">User Signature:</label>
                                <div class="mt-2">
                                    <img src="~/@Model.UserSignature" alt="User Signature" style="height: 100px; width: 100px;" />
                                    <a href="#" onclick="toggleSignatureInput(event)" style="color: #007bff; cursor: pointer;" class="d-block mt-2">Want to replace?</a>
                                </div>
                            </div>

                            <div id="signatureInputContainer" class="col-sm-12 col-md-6 mb-3" style="display: none;">
                                <label class="form-label d-block" for="UserSignatureFile">User Signature</label>
                                <div class="input-group input-group-merge">
                                    <span class="input-group-text"><i class="bx bx-image"></i></span>
                                    <input type="file" class="form-control" id="UserSignatureFile" name="UserSignatureFile">
                                </div>
                            </div>

                            <div class="col-sm-12 mb-3">
                                <a asp-action="ChangePassword" asp-route-id="@Model.UserId" class="float-end">Change Password?</a>
                            </div>
          
                               
                            <div class="col-sm-12 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname">Assign Role</label>
                                <br />
                                @foreach (Role role in ViewBag.Roles)
                                {
                                    if(Model.RoleId == role.RoleId)
                                    {
                                        <div class="form-check form-check-inline">
                                            <input class="form-check-input" type="radio" asp-for="RoleId" id="@role.RoleId" checked value="@role.RoleId">
                                            <label class="form-check-label" for="@role.RoleId">@role.RoleName</label>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="form-check form-check-inline">
                                            <input class="form-check-input" type="radio" asp-for="RoleId" id="@role.RoleId" value="@role.RoleId">
                                            <label class="form-check-label" for="@role.RoleId">@role.RoleName</label>
                                        </div>
                                    }
                                }
                                <br />
                                <span asp-validation-for="RoleId" class="text-danger"></span>
                            </div>

                            <div class="col-sm-12 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname">Assign Companies</label>
                                <br />
                                @if(ViewBag.CompaniesCount == 0)
                                {
                                    <p>No Companies Exists. <a asp-controller="Company" asp-action="Create">Create a company</a></p>
                                }
                                @foreach (Company company in ViewBag.Companies)
                                {
                                    bool found = false;
                                    foreach (UserCompanies assignedCompany in ViewBag.AssignedCompanies)
                                    {
                                        if (assignedCompany.CompanyId == company.CompanyId)
                                        {
                                            found = true;
                                            break;
                                        }
                                    }

                                    if (found)
                                    {
                                        <div class="form-check form-check-inline">
                                            <input checked class="form-check-input" type="checkbox" id="@company.CompanyId" name="CompanyId[]" value="@company.CompanyId">
                                            <label class="form-check-label" for="@company.CompanyId">@company.CompanyName</label>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="form-check form-check-inline">
                                            <input class="form-check-input" type="checkbox" id="@company.CompanyId" name="CompanyId[]" value="@company.CompanyId">
                                            <label class="form-check-label" for="@company.CompanyId">@company.CompanyName</label>
                                        </div>
                                    }
                                }
                                <br />
                                <span asp-validation-for="CompanyId" class="text-danger"></span>
                                
                            </div>

                        </div>


                        <button type="submit" class="btn btn-warning float-end">Save Changes</button>
                    </form>
                </div>
            </div>

        </div>
    </div>

</div>

<script>
    function toggleSignatureInput(event) {
        event.preventDefault();
        document.getElementById('signatureInputContainer').style.display = 'block';
        event.target.style.display = 'none';
    }
</script>