@model PasswordChangeRequest


<div class="container-xxl flex-grow-1 container-p-y">
    <h4 class="fw-bold" style="color:  #404040;"><span class="text-muted fw-light"> User / </span>  Change Password</h4>

    <hr class="mb-4" />

    <div class="row">
        <div class="col-sm-12">
            <div class="card mb-4">
                <div class="card-body">
                    <form method="post">
                        <input type="hidden" asp-for="UserId">
                        <div class="row">
                            <div class="col-sm-12 col-md-6 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname" asp-for="NewPassword"></label>
                                <div class="input-group input-group-merge">
                                    <span id="basic-icon-default-fullname2" class="input-group-text"><i class="bx bx-lock"></i></span>
                                    <input asp-for="NewPassword" class="form-control" id="basic-icon-default-fullname" placeholder="Enter Password..." aria-describedby="basic-icon-default-fullname2">
                                </div>
                                <span class="text-danger" asp-validation-for="NewPassword"></span>
                            </div>
                            <div class="col-sm-12 col-md-6 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname" asp-for="ConfirmNewPassword"></label>
                                <div class="input-group input-group-merge">
                                    <span id="basic-icon-default-fullname2" class="input-group-text"><i class="bx bx-lock"></i></span>
                                    <input asp-for="ConfirmNewPassword" class="form-control" id="basic-icon-default-fullname" placeholder="Enter Confirm Password..." aria-describedby="basic-icon-default-fullname2">
                                </div>
                                <span class="text-danger" asp-validation-for="ConfirmNewPassword"></span>
                            </div>
                            @if (ViewBag.UserId == 1)
                            {
                                <div class="col-sm-12 col-md-6 mb-3">
                                    <label class="form-label" for="basic-icon-default-fullname" asp-for="PinCode"></label>
                                    <div class="input-group input-group-merge">
                                        <span id="basic-icon-default-fullname2" class="input-group-text"><i class="bx bx-lock"></i></span>
                                        <input asp-for="PinCode" class="form-control" id="basic-icon-default-fullname" placeholder="Enter Pin Code..." aria-describedby="basic-icon-default-fullname2">
                                    </div>
                                    <span class="text-danger" asp-validation-for="PinCode"></span>
                                </div>
                            }
                        </div>

                        <button type="submit" class="btn btn-warning float-end">Change Password</button>
                    </form>
                </div>
            </div>

        </div>
    </div>

</div>