@model RoomListingModel

@{
    Layout = "_PrintReportLayout";
}
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<style>
    @@media print {
        .hideInPrint, button, .btn, #copyTable, #copyTableContent

    {
        display: none !important;
    }

    a {
        display: none !important;
    }

    input, select {
        border: none !important;
        background: transparent !important;
        pointer-events: none !important;
    }

    .passport-img,
    .visa-img {
        max-width: 100%;
        height: auto;
    }

    canvas {
        width: 100% !important;
        height: auto !important;
    }

    body {
        -webkit-print-color-adjust: exact !important;
    }

    .container-fluid {
        padding: 0;
        margin: 0;
    }

    table {
        page-break-inside: auto;
    }

    tr {
        page-break-inside: avoid;
        page-break-after: auto;
    }

    hr {
        border: 1px solid #000 !important;
    }

    }

    /* .passport-div {
        max-height: 55% !important;
        max-width: 55% !important;
        }

        .passport-img {
        width: 55% !important;
        } */

    .passport-div {
        max-height: 55% !important;
        max-width: 55% !important;
        overflow: hidden;
        margin: auto;
    }

    .passport-img {
        width: 55% !important;
        object-fit: cover;
        border: 1px solid #ccc;
        border-radius: 5px;
    }

    .visa-div {
        width: 400px;
        height: 700px; /* Increase height here */
        margin: auto;
        border: 1px solid #ccc;
        border-radius: 5px;
        overflow: hidden;
    }

    .visa-iframe {
        width: 100%;
        height: 100%;
        border: none;
    }

    #pdf-canvas-@@i {
        width: 100%;
        height: auto; /* Ensure it scales properly */
        max-height: 100%; /* Restrict the height to the container's max height */
    }
</style>

<div class="chk-box">
    <input type="checkbox" id="toggleSrNo" onclick="toggleColumn('SrNo')"> SrNO
    <input type="checkbox" id="toggleCompany" onclick="toggleColumn('Company')"> Company
    <input type="checkbox" id="togglePackage" onclick="toggleColumn('Package')"> Package
    <input type="checkbox" id="toggleGroup" onclick="toggleColumn('Group')"> Group
    <input type="checkbox" id="toggleGroupName" onclick="toggleColumn('GroupName')"> Group Name
    @* <input type="checkbox" id="toggleRoomType" onclick="toggleColumn('RoomType')"> Room Type *@
    <input type="checkbox" id="toggleFcId" onclick="toggleColumn('FcId')"> HB #
    <input type="checkbox" id="toggleName" onclick="toggleColumn('Name')"> Name
    <input type="checkbox" id="toggleEmail" onclick="toggleColumn('Email')"> Email
    <input type="checkbox" id="toggleAge" onclick="toggleColumn('Age')"> Age
    <input type="checkbox" id="togglePassport" onclick="toggleColumn('Passport')"> Passport
    <input type="checkbox" id="toggleCompanyName" onclick="toggleColumn('CompanyName')"> CompanyName
    <input type="checkbox" id="toggleVisaNumber" onclick="toggleColumn('VisaNumber')"> Visa Number
    <input type="checkbox" id="toggleCheckIn" onclick="toggleColumn('CheckIn')"> CheckIn
    <input type="checkbox" id="toggleCheckOut" onclick="toggleColumn('CheckOut')"> CheckOut
    <input type="checkbox" id="toggleGender" onclick="toggleColumn('Gender')"> Gender
    <input type="checkbox" id="toggleRoomNumber" onclick="toggleColumn('RoomNumber')"> RoomType
    <input type="checkbox" id="toggleStayWith" onclick="toggleColumn('StayWith')"> Stay With
    <input type="checkbox" id="toggleConnectedFloorNumber" onclick="toggleColumn('ConnectedFloorNumber')"> Floor #
    Connection
    <input type="checkbox" id="toggleConnectedRoomNumber" onclick="toggleColumn('ConnectedRoomNumber')"> Room #
</div>


<a asp-controller="Group" asp-action="Index" class="btn btn-primary text-white m-2 hideInPrint">Back To Dashboard</a>
<button onclick="document.memberForm.submit()" class="btn btn-success m-2 hideInPrint">Save</button>
<button onclick="window.print()" class="btn btn-secondary m-2 hideInPrint">Print</button>

<div class="container-fluid mt-3">

    <h5 class="text-center hideInPrint"><u>Hotel Rooming List</u></h5>
    <p class="text-center mb-0 fw-bold hideInPrint">Report</p>

    <p class="text-center mt-1 hideInPrint"><u>Group: @Model.Group</u></p>

    <hr class="my-3">

    <form action="/ItineraryBlock/SaveForMadinah/@Model.GroupId" name="memberForm" method="post">
        <table style="width: 100%" class="table-bordered">
            <thead>
                <tr>
                    <th class="text-start" data-column="SrNo">#</th>
                    <th class="text-start" data-column="Company">Company</th>
                    <th class="text-start" data-column="Package">Package</th>
                    <th class="text-start" data-column="Group">Group</th>
                    <th class="text-start" data-column="GroupName">Group Name</th>
                    @* <th class="text-start" data-column="RoomType">Room Type</th> *@
                    <th class="text-start" data-column="FcId">HB #</th>
                    <th class="text-start" data-column="Name">Name</th>
                    <th class="text-start" data-column="Email">Email</th>
                    <th class="text-start" data-column="Age">Age</th>
                    <th class="text-start" data-column="Passport">Passport</th>
                    <th class="text-start" data-column="CompanyName">Twafa / Third Party</th>
                    <th class="text-start" data-column="VisaNumber">Visa No</th>
                    <th class="text-start" data-column="CheckIn">Check In</th>
                    <th class="text-start" data-column="CheckOut">Check Out</th>
                    <th class="text-start" data-column="Gender">Gender</th>
                    @* <th class="text-start" data-column="FloorNumber">Floor #</th> *@
                    <th class="text-start" data-column="RoomNumber">Room Type</th>
                    <th class="text-start" data-column="StayWith">Stay With</th>
                    <th class="text-start" data-column="ConnectedFloorNumber">Floor # Con</th>
                    <th class="text-start" data-column="ConnectedRoomNumber">Room #</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Members)
                {
                    <input type="hidden" id="packageid" value="@item.PackageId" />
                    <input type="hidden" name="FamilyHeadIds[]" value="@item.FamilyHeadId">
                    <input type="hidden" name="RoomIds[]" value="@item.RoomId">
                    <tr style="border-top: @(item.IsHead ? "4px solid black" : "");">
                        <td class="text-start" data-column="SrNo">@item.SNo</td>
                        <td class="text-start" data-column="Company">@item.Company</td>
                        <td class="text-start" data-column="Package">@item.Package</td>
                        <td class="text-start" data-column="Group">@item.Group</td>
                        <td class="text-start" data-column="GroupName">@item.GroupName</td>
                        @* <td class="text-start" data-column="RoomType">@item.RoomType</td> *@
                        <td class="text-start" data-column="FcId">@item.FcId</td>
                        <td class="text-start" data-column="Name">@item.Name</td>
                        <td class="text-start" data-column="Email">@item.Email</td>
                        <td class="text-start" data-column="Age">@item.Age</td>
                        <td class="text-start" data-column="Passport">@item.Passport</td>
                        <td class="text-start" data-column="CompanyName">@item.CompanyNames</td>
                        <td class="text-start" data-column="VisaNumber">@item.VisaNumber</td>
                        <td class="text-start" data-column="CheckIn">@DateTimeManager.DateToHtmlFormat(item.CheckIn)</td>
                        <td class="text-start" data-column="CheckOut">@DateTimeManager.DateToHtmlFormat(item.CheckOut)</td>
                        <td class="text-start" data-column="Gender">@item.Gender</td>
                        <td class="text-start" data-column="RoomNumber">
                            <select class="form-control" id="select-room[@item.SNo]" name="StayRoomNumbers[]"
                                    onchange="checkRoomPax(this)">
                                <option value="">Select a Room...</option>
                                @{
                                    int serialNumber = 1; // Initialize serial number
                                }
                                @foreach (var room in ViewBag.FloorRooms)
                                {
                                    var isRoomSelected = item.FloorRoomId == room.FloorRoomId;
                                    var isRoomMaxed = room.Availability == "Maxed";

                                    if (isRoomSelected) // If room is already assigned to this member, always show it (even if Maxed)
                                    {
                                        <option value="@room.FloorRoomId" data-pax="@room.PAX" selected>
                                            @room.RoomName (@room.RoomCode)
                                        </option>
                                        @* serialNumber++; // Increment here because we are showing *@
                                    }
                                    else if (!isRoomMaxed) // Only show available (Open) rooms
                                    {
                                        <option value="@room.FloorRoomId" data-pax="@room.PAX">
                                            @serialNumber. @room.RoomName (@room.RoomCode)
                                        </option>
                                        serialNumber++; // Increment only when shown
                                    }
                                    // If Maxed and not selected, do nothing (skip without increment)
                                }
                            </select>
                        </td>
                        <td class="text-start" data-column="StayWith">
                            <input style="width: 100%" class="form-control" type="text" name="StayFloorNumbers[]"
                                   value="@item.StayWith">
                        </td>
                        <td class="text-start" data-column="ConnectedFloorNumber">
                            <input style="width: 100%" class="form-control" type="text" name="ConnectedFloorNumbers[]"
                                   value="@item.ConnectedFloorNumber">
                        </td>
                        <td class="text-start" data-column="ConnectedRoomNumber">
                            <input style="width: 100%" class="form-control" type="text" name="ConnectedRoomNumbers[]"
                                   value="@item.ConnectedRoomNumber">
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </form>


    <hr class="mb-4" />

    <div class="card p-2">
        <div class="table-responsive text-nowrap ">
            <button onclick="copyTable()" id="copyTable">Copy Table</button>
            <table class="table">
                <tr>
                    <th class="border-bottom text-center" colspan="3">
                        Total Members: @Model.MemberSummary.TotalMembers
                    </th>
                </tr>
                <tr>
                    <th class="text-center" colspan="3">Male: @Model.MemberSummary.MaleCount</th>
                </tr>
                <tr>
                    <td class="text-center">Adult: @Model.MemberSummary.AdultMales</td>
                    <td class="text-center">Child: @Model.MemberSummary.ChildMales</td>
                    <td class="text-center">Infant: @Model.MemberSummary.InfantMales</td>
                </tr>
                <tr>
                    <th class="text-center" colspan="3">Female: @Model.MemberSummary.FemaleCount</th>
                </tr>
                <tr>
                    <td class="text-center">Adult: @Model.MemberSummary.AdultFemales</td>
                    <td class="text-center">Child: @Model.MemberSummary.ChildFemales</td>
                    <td class="text-center">Infant: @Model.MemberSummary.InfantFemales</td>
                </tr>
            </table>
        </div>
    </div>

    <hr class="mb-4" />

    <div class="card p-2">
        <div class="table-responsive text-nowrap">
            <button onclick="copyTableContent()" id="copyTableContent">Copy Table</button>
            <table class="table">
                <thead>
                    <tr>
                        <th>Room Name</th>
                        <th>Quantity</th>
                    </tr>
                </thead>
                <tbody>
                    @if (ViewBag.RoomAssignments != null && ((List<RoomAssignment>)ViewBag.RoomAssignments).Any())
                    {
                        var roomAssignments = (List<RoomAssignment>)ViewBag.RoomAssignments;

                        foreach (var assignment in roomAssignments)
                        {
                            <tr>
                                <td>@assignment.RoomName</td>
                                <td>@assignment.Quantity</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="2">No room assignments available</td>
                        </tr>
                    }
                </tbody>
            </table>


            <table class="table table-bordered mt-4">
                <thead class="table-light">
                    <tr>
                        <th class="text-center">Passport Image</th>
                        <th class="text-center">Visa Document</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Model.Members.Count; i++)
                    {
                        var currentMember = Model.Members.ElementAt(i);
                        <tr>
                            <td class="text-center">
                                <div class="passport-div">
                                    @if (currentMember.PassporFileExtension == ".pdf")
                                    {
                                        <canvas id="pdfpassport-canvas-@i" style="width: 100%; height: auto;"></canvas>
                                    }
                                    else
                                    {
                                        <img src="~/@currentMember.PassportImage" class="passport-img" />
                                    }
                                </div>
                            </td>
                            <td class="text-center">
                                <div class="visa-div">
                                    @if (currentMember.FileExtension == ".pdf")
                                    {
                                        <div class="invoice-container">
                                            <div class="image-container">
                                                <canvas id="pdf-canvas-@i" style="width: 100%; height: auto;"></canvas>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <img src="~/@currentMember.VisaImage" class="visa-img" />
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <!-- ✅ Load PDF.js only once -->
            <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/2.14.305/pdf.min.js"></script>

            <!-- ✅ After table is complete, now add rendering scripts -->
            <script>
                pdfjsLib.GlobalWorkerOptions.workerSrc = "https://cdnjs.cloudflare.com/ajax/libs/pdf.js/2.14.305/pdf.worker.min.js";

                @for (int i = 0; i < Model.Members.Count; i++)
                {
                    var currentMember = Model.Members.ElementAt(i);
                    if (currentMember.FileExtension == ".pdf")
                    {
                        var fileUrl = Url.Content("~/" + currentMember.VisaImage);

                        <text>
                                    (function () {
                                        const url = '@fileUrl';
                                        const loadingTask = pdfjsLib.getDocument(url);
                                        loadingTask.promise.then(pdf => pdf.getPage(1)).then(page => {
                                            const scale = 1.5;
                                            const viewport = page.getViewport({ scale });

                                            const canvas = document.getElementById('pdf-canvas-@i');
                                            const context = canvas.getContext('2d');
                                            canvas.width = viewport.width;
                                            canvas.height = viewport.height;

                                            const renderContext = {
                                                canvasContext: context,
                                                viewport: viewport
                                            };

                                            return page.render(renderContext).promise.then(() => {
                                                const stampImg = new Image();
                                                stampImg.src = '/hajj%20mabroor%20By%20TMG%201.png'; // stamp ka path

                                                stampImg.onload = function () {
                                                    const padding = 20;
                                                    const stampWidth = 120;
                                                    const stampHeight = (stampImg.height / stampImg.width) * stampWidth;

                                                    const x = canvas.width - stampWidth - padding;
                                                    const y = canvas.height - stampHeight - padding - 40;

                                                    context.drawImage(stampImg, x, y, stampWidth, stampHeight);
                                                };
                                            });
                                        });
                                    })();
                        </text>
                    }
                    @if (currentMember.PassporFileExtension == ".pdf")
                    {
                        var fileUrl = Url.Content("~/" + currentMember.PassportImage);

                        <text>
                                    (function () {
                                        const url = '@fileUrl';
                                        const loadingTask = pdfjsLib.getDocument(url);

                                        loadingTask.promise
                                            .then(pdf => {
                                                return pdf.getPage(1);
                                            })
                                            .then(page => {
                                                const scale = 1.5;
                                                const viewport = page.getViewport({ scale });

                                                const canvas = document.getElementById('pdfpassport-canvas-@i');
                                                const context = canvas.getContext('2d');

                                                canvas.width = viewport.width;
                                                canvas.height = viewport.height;

                                                page.render({
                                                    canvasContext: context,
                                                    viewport: viewport
                                                });
                                            })
                                            .catch(error => {
                                                console.error("Error loading PDF:", error);
                                            });
                                    })();
                        </text>
                    }
                }
            </script>
        </div>
    </div>
</div>

