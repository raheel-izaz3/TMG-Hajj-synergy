@model ItineraryBlock

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    string modelName = "ItineraryBlock";
    string modelNamePlural = "ItineraryBlocks";
    string modelControllerRoute = "ItineraryBlock";
}


<div class="container-xxl flex-grow-1 container-p-y">
    <h4 class="fw-bold" style="color:  #404040;"><span class="text-muted fw-light"> @modelName / </span> Create</h4>

    <hr class="mb-4" />

    <div class="row">
        <div class="col-sm-12">
            <div class="card mb-4">
                <div class="card-body">
                    <form method="post">
                        <div class="row">
                            <div class="col-sm-12 col-md-3 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname">Select Code</label>
                                <div class="input-group input-group-merge">
                                    <select name="POHotelsId" id="POHotelsId" class="form-control">
                                        <option value="">Select Code...</option>
                                        @foreach (POHotels fh in ViewBag.POHotelCode)
                                        {
                                            <option value="@fh.POHotelsId">@fh.Code</option>
                                        }
                                    </select>
                                </div>
                                <span class="text-danger"></span>
                            </div>
                            <div class="col-sm-12 col-md-4 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname" asp-for="PAX"></label>
                                <div class="input-group input-group-merge">
                                    <span id="basic-icon-default-fullname2" class="input-group-text"><i class="bx bx-building"></i></span>
                                    <input asp-for="PAX" class="form-control">
                                </div>
                                <span class="text-danger" asp-validation-for="PAX"></span>
                            </div>
                            <div class="col-sm-12 col-md-3 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname">Gender Type</label>
                                <div class="input-group input-group-merge">
                                    <select class="form-control" name="Gender">
                                        <option value="">Select Ticket Type</option>
                                        @foreach (var gender in ViewBag.GenderType)
                                        {
                                            <option value="@gender.Id">@gender.Name</option>
                                        }
                                    </select>
                                </div>
                                <span class="text-danger"></span>
                            </div>
                            <div class="col-sm-12 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname">
                                    Select
                                    Packages
                                </label>
                                <br />
                                @{
                                    int i = 0;
                                }
                                @foreach (var package in ViewBag.Packages1)
                                {
                                    <div class="form-check form-check-inline">
                                        <input type="hidden" value="@package.PackageId" asp-for="PackageIds" />

                                        <input class="form-check-input" type="checkbox" id="@package.PackageId"
                                               asp-for="PackagesSelected[i]">

                                        <label class="form-check-label"
                                               for="@package.PackageId">@package.Name</label>
                                    </div>
                                    i++;
                                }
                            </div>
                            <div class="col-sm-12 mt-4">
                                <button type="submit" class="btn btn-success float-end">Create</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>

</div>