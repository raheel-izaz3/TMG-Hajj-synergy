<script>
     const itineraryData = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.ItineraryBlocks));
    const selectedMemberCounts = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.SelectedMemberCounts));
    const checkInDates = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.CheckIn));
    const checkOutDates = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.CheckOut));

       $(function () {
        $("#gridContainer").dxDataGrid({
            dataSource: itineraryData,
            keyExpr: "ItineraryBlockId",
            showBorders: true,
            columnAutoWidth: true,

            // ✅ Added search panel
            searchPanel: {
                visible: true,
                highlightCaseSensitive: false,
                placeholder: "Search..."
            }, 
            columns: [
                {
                    caption: "#",
                    cellTemplate: function (container, options) {
                        container.text(options.rowIndex + 1);
                    },
                    width: 50
                },
                {
                    dataField: "POHotels.Hotel.HotelName",
                    caption: "Hotel Name"
                },
                {
                    dataField: "POHotels.Code",
                    caption: "Code"
                },
                {
                    dataField: "PAX",
                    caption: "PAX"
                },
                {
                    caption: "CheckIn",
                    cellTemplate: function (container, options) {
                        const index = options.rowIndex;
                        const date = checkInDates[index];
                        container.text(date ? new Date(date).toLocaleDateString() : "");
                    }
                },
                {
                    caption: "CheckOut",
                    cellTemplate: function (container, options) {
                        const index = options.rowIndex;
                        const date = checkOutDates[index];
                        container.text(date ? new Date(date).toLocaleDateString() : "");
                    }
                },
                {
                    caption: "Selected",
                    cellTemplate: function (container, options) {
                        const index = options.rowIndex;
                        container.text(selectedMemberCounts[index]);
                    }
                },
                {
                    caption: "Actions",
                    cellTemplate: function (container, options) {
                        const data = options.data;
                        const id = data.ItineraryBlockId;
                        const placeId = data.POHotels.PlaceId;
                        const packageId = data.PackageId;
                        const poHotelsId = data.POHotelsId;

                        const editBtn = `<a class='btn btn-warning btn-sm me-1' href='/ItineraryBlock/Edit/${id}'>
                                            <i class='bx bx-edit-alt'></i> Edit</a>`;

                        const addBtn = `<a class='btn btn-success btn-sm me-1' href='/ItineraryBlock/AddMember?GroupId=${id}&PlaceId=${placeId}'>
                                            <i class='bx bx-add-to-queue'></i> Add</a>`;

                        // Common group report
                        let reportLinks = `<a class='btn btn-info btn-sm me-1' target='_blank' href='/ItineraryBlock/Report?id=${packageId}&Groupid=${id}&PlaceId=${placeId}'>Group Report</a>`;

                        // Place-specific reports
                        if (placeId === 4) {
                            reportLinks += `<a class='btn btn-info btn-sm me-1' target='_blank' href='/ItineraryBlock/AziziaRoomListingSource?id=${id}&PlaceId=${placeId}&POHotelsId=${poHotelsId}&PackageId=${packageId}'>Room Listing Azizia</a>`;
                            reportLinks += `<a class='btn btn-info btn-sm me-1' target='_blank' href='/ItineraryBlock/UnAllocatedMember?id=${id}&PackageId=${packageId}'>Unallocated Azizia</a>`;
                        } else if (placeId === 1) {
                            reportLinks += `<a class='btn btn-info btn-sm me-1' target='_blank' href='/ItineraryBlock/MakkahRoomListingSource?id=${id}&PlaceId=${placeId}&POHotelsId=${poHotelsId}'>Room Listing Makkah</a>`;
                            reportLinks += `<a class='btn btn-info btn-sm me-1' target='_blank' href='/ItineraryBlock/UnAllocatedMemberForMakkah?id=${id}&PackageId=${packageId}'>Unallocated Makkah</a>`;
                        } else if (placeId === 2) {
                            reportLinks += `<a class='btn btn-info btn-sm me-1' target='_blank' href='/ItineraryBlock/MadinahRoomListingSource?id=${id}&PlaceId=${placeId}&POHotelsId=${poHotelsId}&PackageId=${packageId}'>Room Listing Madinah</a>`;
                            reportLinks += `<a class='btn btn-info btn-sm me-1' target='_blank' href='/ItineraryBlock/UnAllocatedMemberForMadinah?id=${id}&PackageId=${packageId}'>Unallocated Madinah</a>`;
                        } else if (placeId === 3) {
                            reportLinks += `<a class='btn btn-info btn-sm me-1' target='_blank' href='/ItineraryBlock/MinaRoomListingSource?id=${id}&PlaceId=${placeId}&POHotelsId=${poHotelsId}&PackageId=${packageId}'>Room Listing Minah</a>`;
                            reportLinks += `<a class='btn btn-info btn-sm me-1' target='_blank' href='/ItineraryBlock/UnAllocatedMemberForMinah?id=${id}&PackageId=${packageId}'>Unallocated Minah</a>`;
                        }

                        const deleteBtn = `<button onclick='confirmDelete(${id})' class='btn btn-outline-danger btn-sm'><i class='bx bx-trash'></i> Trash</button>`;

                        container.append(editBtn + addBtn + reportLinks + deleteBtn);
                    }
                }

            ]
        });
    });


    function confirmDelete(id) {
        if (confirm("Are you sure you want to delete this itinerary block?")) {
            window.location.href = `/ItineraryBlock/Delete/${id}`;
        }
    }
</script>
<script>
    function confirmDelete(id) {
        let del = confirm("Are you sure?")
        if (del) {
            location.href = `/ItineraryBlock/Trash/${id}`;
        }
    }

    let table = new DataTable('#table', {
        paging: false
    });
</script>
