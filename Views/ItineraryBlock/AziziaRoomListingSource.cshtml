@model RoomListingModel

@{
	Layout = "_PrintReportLayout";
	var members = Newtonsoft.Json.JsonConvert.SerializeObject(Model.Members);
	var floors = Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.FloorRooms);
}
