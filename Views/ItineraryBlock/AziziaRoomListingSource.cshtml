<script>
	var members = @Html.Raw(members);
	var rooms = @Html.Raw(floors);

	console.log(members);
	console.log(rooms);

	rooms = rooms.map(r => ({
		...r,
		RoomDisplayText: `${r.RoomName} (${r.RoomCode})`
	}));

	let gridInstance;

	$(function () {
		$("#gridContainer").dxDataGrid({
			dataSource: members,
			keyExpr: "FamilyHeadId",
			editing: {
				mode: "cell",
				allowUpdating: true,
				allowAdding: false,
				allowDeleting: false
			},
			filterRow: { visible: true, showEnabled: true },
			headerFilter: { visible: true },
			searchPanel: {
				visible: true,
				width: 240,
				placeholder: "Search…",
				searchVisibleColumnsOnly: true
			},
			export: {
				enabled: true,
				formats: ['pdf']
			},
			columns: [
				{
					dataField: "sNo",
					caption: "#",
					width: 50,
					allowEditing: false,
					calculateCellValue: function () { return ""; },
					cellTemplate: function (container, options) {
						const visibleIndex = options.component.getRowIndexByKey(options.key);
						$("<div>").text(visibleIndex + 1).appendTo(container);
					}
				},
				{ dataField: "Company", allowEditing: false },
				{ dataField: "Package", allowEditing: false },
				{ dataField: "Group", allowEditing: false },
				{ dataField: "GroupName", allowEditing: false },
				{ dataField: "FcId", caption: "HB #", allowEditing: false },
				{ dataField: "Name", allowEditing: false },
				{ dataField: "Email", allowEditing: false },
				{ dataField: "Age", allowEditing: false },
				{ dataField: "Passport", allowEditing: false },
				{ dataField: "CompanyNames", caption: "Twafa / Third Party", allowEditing: false },
				{ dataField: "VisaNumber", caption: "Visa No", allowEditing: false },
				{ dataField: "NextHotelName", caption: "Hotel Name", allowEditing: false },
				{ dataField: "CheckIn", caption: "Check In", allowEditing: false },
				{ dataField: "CheckOut", caption: "Check Out", allowEditing: false },
				{ dataField: "Gender", allowEditing: false },
				{
					dataField: "FloorRoomId",
					caption: "Room Type",
					allowEditing: true,

					cellTemplate: function (container, options) {
						const room = rooms.find(r => r.FloorRoomId === options.value);
						const displayText = room ? `${room.RoomName} (${room.RoomCode})` : "";
						container.text(displayText);
					},

					editCellTemplate: function (cellElement, cellInfo) {
						const $select = $("<select>")
							.addClass("form-control")
							.append($("<option>").val("").text("Select a Room..."))
							.on("change", function () {
								const selectedValue = $(this).val();
								cellInfo.setValue(parseInt(selectedValue) || null);

								// ✅ check room before saving
								const isRoomAvailable = checkRoomPax(this);

								if (isRoomAvailable) {
									const rowData = cellInfo.row?.data;
									if (rowData) {
										rowData.FloorRoomId = parseInt(selectedValue) || null;
										saveRowToServer(rowData);
									}
								}
							});


						let serialNumber = 1;

						rooms.forEach(room => {
							// const isSelected = cellInfo.value === room.FloorRoomId;
							const isSelected = parseInt(cellInfo.value) == room.FloorRoomId;
							const isRoomMaxed = room.Availability === "Maxed";

							if (isSelected || !isRoomMaxed) {
								const optionText = isSelected
									? `${room.RoomName} (${room.RoomCode})`
									: `${serialNumber++}. ${room.RoomName} (${room.RoomCode})`;

								const $option = $("<option>")
									.val(room.FloorRoomId)
									.attr("data-pax", room.PAX)
									.text(optionText);

								if (isSelected) {
									$option.attr("selected", "selected");
								}

								$select.append($option);
							}
						});

						$select.appendTo(cellElement);
					}
				},
				{
					dataField: "StayWith",
					caption: "Stay With",
					dataType: "string"
				},
				{
					dataField: "ConnectedFloorNumber",
					caption: "Connected Floor #",
					dataType: "string"
				},
				{
					dataField: "ConnectedRoomNumber",
					caption: "Room #",
					dataType: "string"
				},
				{ dataField: "FamilyHeadId", dataType: "number", visible: false }
			],
			showBorders: true,
			paging: { enabled: false },
			columnAutoWidth: true,

			// 👇 Yahan lagao
			// onCellValueChanged: function (e) {
			// 	if (e.dataField === "FloorRoomId") {
			// 		const cellElement = e.cellElement && e.cellElement.get(0);
			// 		if (cellElement) {
			// 			const select = cellElement.querySelector("select");
			// 			if (select) {
			// 				checkRoomPax(select);
			// 			}
			// 		}
			// 	}
			// },

			// onEditorPrepared: function (e) {
			// 	if (e.dataField === "FloorRoomId" && e.editorElement) {
			// 		e.editorElement.find("select").on("change", function () {
			// 			checkRoomPax(this);
			// 			setTimeout(() => checkRoomPax(this), 50);
			// 		});
			// 	}
			// }

			columnChooser: {
				enabled: true,
				mode: "select"
			},

			// onCellValueChanged: ab sirf StayWith and connected fields ke liye
			onCellValueChanged: function (e) {
				if (["StayWith", "ConnectedFloorNumber", "ConnectedRoomNumber"].includes(e.dataField)) {
					saveRowToServer(e.data);
				}
			},

			onEditorPrepared: function (e) {
				if (["StayWith", "ConnectedFloorNumber", "ConnectedRoomNumber"].includes(e.dataField) && e.editorElement) {
					e.editorElement.find("input").on("blur", function () {
						const rowData = gridInstance.getVisibleRows()[e.row.rowIndex].data;
						saveRowToServer(rowData);
					});
				}
			}
		});

		// Assign instance AFTER grid is created
		gridInstance = $("#gridContainer").dxDataGrid("instance");

		// Export PDF Button
		$('#export-pdf').on('click', function () {
			const { jsPDF } = window.jspdf;

			const doc = new jsPDF({ orientation: "landscape" });
			DevExpress.pdfExporter.exportDataGrid({
				jsPDFDocument: doc,
				component: gridInstance,
				margin: { top: 10, left: 10, right: 10, bottom: 10 },
				customizeCell: function (options) {
					if (options.pdfCell && options.pdfCell.styles) {
						options.pdfCell.styles.fontSize = 8;
					}

					// ✅ Replace FloorRoomId with RoomDisplayText
					if (options.gridCell.column && options.gridCell.column.dataField === "FloorRoomId") {
						const room = rooms.find(r => r.FloorRoomId === options.gridCell.value);
						options.pdfCell.text = room ? `${room.RoomName} (${room.RoomCode})` : "";
					}
				}
			}).then(() => {
				doc.save('Itinerary_Landscape.pdf');
			});

		});


	});

	function saveRowToServer(rowData) {
		$.ajax({
			url: '@Url.Action("SaveRoomAssignment", "ItineraryBlock")',
			method: 'POST',
			data: {
				id: @Model.GroupId,
				familyHeadId: rowData.FamilyHeadId,
				floorRoomId: rowData.FloorRoomId,
				stayWith: rowData.StayWith,
				connectedFloorNumber: rowData.ConnectedFloorNumber,
				connectedRoomNumber: rowData.ConnectedRoomNumber
			},
			success: function () {
				console.log("Saved");
			},
			error: function () {
				alert("Error saving room.");
			}
		});
	}


	// Toggle column visibility — works if you manually apply `data-column` attributes
	function toggleColumn(columnName) {
		const columnCells = document.querySelectorAll(`td[data-column="${columnName}"]`);
		const headerCell = document.querySelector(`th[data-column="${columnName}"]`);
		const isChecked = document.getElementById(`toggle${columnName}`).checked;

		columnCells.forEach(cell => {
			cell.style.display = isChecked ? '' : 'none';
		});

		if (headerCell) {
			headerCell.style.display = isChecked ? '' : 'none';
		}
	}

	// Ensure checkboxes start checked
	document.addEventListener('DOMContentLoaded', function () {
		const checkboxes = document.querySelectorAll('[id^="toggle"]');
		checkboxes.forEach(checkbox => {
			checkbox.checked = true;
		});
	});
</script>

<script>
	let colorMap = {};

	function getRandomLightColor() {
		let color;
		do {
			const r = Math.floor(Math.random() * 156) + 100;
			const g = Math.floor(Math.random() * 156) + 100;
			const b = Math.floor(Math.random() * 156) + 100;

			color = "#" + r.toString(16) + g.toString(16) + b.toString(16);
		} while (Object.values(colorMap).includes(color));

		return color;
	}

	function checkRoomPax(elem) {
		const selectedOption = elem.selectedOptions[0];
		if (!selectedOption) return false;

		const roomPax = parseInt(selectedOption.getAttribute('data-pax')) || 0;
		const floorRoomId = parseInt(selectedOption.value);
		console.log("Selected Room ID:", floorRoomId, "PAX:", roomPax);

		const visibleRows = gridInstance.getVisibleRows() || [];
		const assignedCount = visibleRows.filter(row => row.data.FloorRoomId === floorRoomId).length;

		console.log("Already assigned:", assignedCount);

		if (assignedCount > roomPax) {
			alert("Room Capacity Exceeded");

			// Reset selection in UI
			elem.value = "";
			gridInstance.cellValue($(elem).closest("tr").index(), "FloorRoomId", null);

			elem.style.backgroundColor = "#fff";
			elem.style.color = "#000";
			return false; // ❌ Don't allow save
		}

		// ✅ Coloring
		let optionValue = elem.value;
		let randomColor = colorMap[optionValue];
		if (!randomColor) {
			randomColor = getRandomLightColor();
			colorMap[optionValue] = randomColor;
		}

		elem.style.backgroundColor = randomColor;
		elem.style.color = "#000";
		selectedOption.style.backgroundColor = randomColor;

		console.log("Room left: " + (roomPax - assignedCount));
		return true; // ✅ Allow save
	}



	function getRooms(sno) {
