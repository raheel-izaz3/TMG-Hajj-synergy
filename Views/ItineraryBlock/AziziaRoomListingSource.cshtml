<style>
	@@media print {
		.hideInPrint, button, .btn, #copyTable, #copyTableContent {
			display: none !important;
		}

		a {
			display: none !important;
		}

		input, select {
			border: none !important;
			background: transparent !important;
			pointer-events: none !important;
		}

		.passport-img,
		.visa-img {
			max-width: 100%;
			height: auto;
		}

		canvas {
			width: 100% !important;
			height: auto !important;
		}

		body {
			-webkit-print-color-adjust: exact !important;
		}

		.container-fluid {
			padding: 0;
			margin: 0;
		}

		table {
			page-break-inside: auto;
		}

		tr {
			page-break-inside: avoid;
			page-break-after: auto;
		}

		hr {
			border: 1px solid #000 !important;
		}
	}

	/* .passport-div {
			max-height: 55% !important;
			max-width: 55% !important;
			}

			.passport-img {
			width: 55% !important;
			} */

	.passport-div {
		max-height: 55% !important;
		max-width: 55% !important;
		overflow: hidden;
		margin: auto;
	}

	.passport-img {
		width: 55% !important;
		object-fit: cover;
		border: 1px solid #ccc;
		border-radius: 5px;
	}

	.visa-div {
		width: 400px;
		height: 700px; /* Increase height here */
		margin: auto;
		border: 1px solid #ccc;
		border-radius: 5px;
		overflow: hidden;
	}

	.visa-iframe {
		width: 100%;
		height: 100%;
		border: none;
	}

	#pdf-canvas-@@i {
		width: 100%;
		height: auto; /* Ensure it scales properly */
		max-height: 100%; /* Restrict the height to the container's max height */
	}
</style>

