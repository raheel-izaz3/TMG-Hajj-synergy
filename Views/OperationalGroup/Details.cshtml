@using TMG.Models.OperationalGroupModels
@model TMG.Models.OperationalGroupModels.OperationalGroup

@{
    ViewData["Title"] = "Operational Group Details - " + Model.GroupName;
    int count = 1;
}

<div class="container-xxl flex-grow-1 container-p-y">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h4 class="fw-bold m-0"><i class="bx bx-layer text-primary me-2"></i>Operational Group Details</h4>
            <span class="text-muted">Group: <strong>@Model.GroupName</strong></span>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                <i class="bx bx-edit me-1"></i> Edit Group
            </a>
            <a asp-action="Index" asp-route-category="@Model.Category" class="btn btn-outline-secondary">
                <i class="bx bx-arrow-back me-1"></i> Back to Groups
            </a>
        </div>
    </div>

    <!-- Basic Details & Resource Allocation Card -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-light py-3 d-flex justify-content-between align-items-center">
            <h5 class="card-title m-0 fw-bold"><i class="bx bx-info-circle text-primary me-2"></i>Basic & Resource Allocation Details</h5>
            <span class="badge bg-primary px-3 py-2 fs-6">@Model.Category Group</span>
        </div>
        <div class="card-body mt-3">
            <div class="row g-3">
                <div class="col-md-3">
                    <span class="text-muted d-block small">Group Name</span>
                    <strong class="fs-6 text-dark">@Model.GroupName</strong>
                </div>
                <div class="col-md-3">
                    <span class="text-muted d-block small">Group Leader</span>
                    <strong class="fs-6 text-dark">@(string.IsNullOrEmpty(Model.GroupLeaderName) ? "N/A" : Model.GroupLeaderName)</strong>
                </div>
                <div class="col-md-3">
                    <span class="text-muted d-block small">Leader Mobile Number</span>
                    <strong class="fs-6 text-dark">@(string.IsNullOrEmpty(Model.LeaderMobileNumber) ? "N/A" : Model.LeaderMobileNumber)</strong>
                </div>
                <div class="col-md-3">
                    <span class="text-muted d-block small">Assigned Passengers</span>
                    <span class="badge bg-success px-3 py-2 fs-6">
                        @(Model.Members?.Count(m => !m.Trashed) ?? 0) @(Model.Category == GroupCategory.Bus || Model.Category == GroupCategory.General ? $"/ {Model.BusCapacity} Seats" : "Pax")
                    </span>
                </div>

                @if (Model.Category == GroupCategory.Flight || Model.Category == GroupCategory.General)
                {
                    <div class="col-12"><hr class="my-2" /></div>
                    <div class="col-md-3">
                        <span class="text-muted d-block small">Airline</span>
                        <strong class="fs-6 text-dark">@(ViewBag.AirlineName ?? "N/A")</strong>
                    </div>
                    <div class="col-md-3">
                        <span class="text-muted d-block small">Flight Number</span>
                        <strong class="fs-6 text-dark">@(Model.FlightNumber ?? "N/A")</strong>
                    </div>
                    <div class="col-md-3">
                        <span class="text-muted d-block small">PNR Reference</span>
                        <span class="badge bg-label-info font-monospace fs-6">@(Model.PNRReference ?? "N/A")</span>
                    </div>
                    <div class="col-md-3">
                        <span class="text-muted d-block small">Flight Date</span>
                        <strong class="fs-6 text-dark">@(Model.FlightDate?.ToString("dd-MMM-yyyy") ?? "N/A")</strong>
                    </div>
                }

                @if (Model.Category == GroupCategory.Bus || Model.Category == GroupCategory.General)
                {
                    <div class="col-12"><hr class="my-2" /></div>
                    <div class="col-md-4">
                        <span class="text-muted d-block small">Vehicle Model</span>
                        <strong class="fs-6 text-dark">@(ViewBag.VehicleType ?? "N/A")</strong>
                    </div>
                    <div class="col-md-4">
                        <span class="text-muted d-block small">Bus Identifier / Plate #</span>
                        <strong class="fs-6 text-dark">@(Model.BusIdentifierPlateNo ?? "N/A")</strong>
                    </div>
                    <div class="col-md-4">
                        <span class="text-muted d-block small">Bus Seat Capacity</span>
                        <strong class="fs-6 text-dark">@Model.BusCapacity Seats</strong>
                    </div>
                }

                @if (Model.Category == GroupCategory.Hotel || Model.Category == GroupCategory.General)
                {
                    <div class="col-12"><hr class="my-2" /></div>
                    <div class="col-md-6">
                        <span class="text-muted d-block small">Hotel Accommodation</span>
                        <strong class="fs-6 text-dark">@(ViewBag.HotelName ?? "N/A")</strong>
                    </div>
                    <div class="col-md-6">
                        <span class="text-muted d-block small">Target Room Type</span>
                        <strong class="fs-6 text-dark">@(ViewBag.RoomName ?? "N/A")</strong>
                    </div>
                }

                @if (Model.Category == GroupCategory.Route || Model.Category == GroupCategory.General)
                {
                    <div class="col-12"><hr class="my-2" /></div>
                    <div class="col-md-6">
                        <span class="text-muted d-block small">Bus Route Sector</span>
                        <strong class="fs-6 text-dark">@(ViewBag.RouteName ?? "N/A")</strong>
                    </div>
                    <div class="col-md-6">
                        <span class="text-muted d-block small">Itinerary Schedule</span>
                        <strong class="fs-6 text-dark">@(Model.ItineraryScheduleId.HasValue ? "Standard Schedule #" + Model.ItineraryScheduleId : "N/A")</strong>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Passenger Manifest Table Card -->
    <div class="card shadow-sm">
        <div class="card-header bg-light py-3 d-flex justify-content-between align-items-center">
            <h5 class="card-title m-0 fw-bold"><i class="bx bx-group text-primary me-2"></i>Passenger Manifest</h5>
            <span class="badge bg-label-primary px-3 py-2 font-monospace">
                Total: @(Model.Members?.Count(m => !m.Trashed) ?? 0) Passengers
            </span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive text-nowrap">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 60px;">S:NO</th>
                            <th>Booking #</th>
                            <th>Full Name</th>
                            <th class="text-center">Role</th>
                            <th>CNIC / B-Form</th>
                            <th>Passport #</th>
                            <th class="text-center">Gender</th>
                            <th>Company / Client</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Members == null || !Model.Members.Any(m => !m.Trashed))
                        {
                            <tr>
                                <td colspan="8" class="text-center py-4 text-muted">
                                    <i class="bx bx-user-x display-6 d-block mb-2 text-secondary"></i>
                                    No passengers assigned to this group.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var member in Model.Members.Where(m => !m.Trashed).OrderBy(m => m.BookingCode).ThenByDescending(m => m.IsHead))
                            {
                                <tr>
                                    <td class="fw-bold">@(count++)</td>
                                    <td>
                                        <span class="badge bg-label-secondary font-monospace">@member.BookingCode</span>
                                    </td>
                                    <td class="fw-semibold text-dark">@member.FullName</td>
                                    <td class="text-center">
                                        @if (member.IsHead)
                                        {
                                            <span class="badge bg-primary px-2 py-1"><i class="bx bx-user-voice me-1"></i> Head</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary px-2 py-1"><i class="bx bx-user me-1"></i> Member</span>
                                        }
                                    </td>
                                    <td class="font-monospace">@(string.IsNullOrEmpty(member.CNIC) ? "N/A" : member.CNIC)</td>
                                    <td class="font-monospace">@(string.IsNullOrEmpty(member.PassportNumber) ? "N/A" : member.PassportNumber)</td>
                                    <td class="text-center">
                                        @if (member.Gender == "Female")
                                        {
                                            <span class="badge bg-label-danger px-2 py-1"><i class="bx bx-female me-1"></i> Female</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-label-info px-2 py-1"><i class="bx bx-male me-1"></i> Male</span>
                                        }
                                    </td>
                                    <td class="small text-muted">@member.ClientCompanyName</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
