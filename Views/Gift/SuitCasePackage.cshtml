@model IEnumerable<Suitcase>

@{
    string modelName = "Suitcase";
    string modelNamePlural = "Suitcases";
    string modelControllerRoute = "Gift";
    TMG.Data.TMGDbContext _db;
}
<div class="container-xxl flex-grow-1 container-p-y">
    <h4 class="fw-bold"><span class="text-muted fw-light"></span> Suitcases</h4>

    <hr class="mb-4" />

    <a asp-action="SuitcaseCreate" class="btn btn-info">Create New</a>

    <br />
    <br />
    <div class="card p-2">
        <div class="table-responsive text-nowrap " style="padding-bottom: 500px">
            <table class="table table-hover" id="table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Code</th>
                        <th>Color</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody class="table-border-bottom-1">
                    @{
                        int i = 0;
                       
                    }
                    @foreach (Suitcase group in Model)
                    {
                        i++;
                        <tr>
                            <td>
                                <i class="fab fa-bootstrap fa-lg text-primary me-3"></i> <strong>@group.SuitcaseId</strong>
                            </td>

                            <td>@group.SuitcaseCode</td>
                            <td>@group.Color</td>
                           
                            <td>
                                <div class="dropdown">
                                  
                                   
                                    @* @if (ViewBag.EditAllowed == true)
                                { *@
                                    <a class="btn btn-warning" asp-action="SuitcaseEdit" asp-route-id="@group.SuitcaseId">
                                        <i class="bx bx-edit-alt me-1"></i> Edit
                                    </a>
                                    @* }
                                @if (ViewBag.TrashAllowed == true)
                                { *@
                                    <button onclick="confirmDelete(@group.SuitcaseId)" class="btn btn-outline-danger">
                                        <i class="bx bx-trash me-1"></i> Trash
                                    </button>
                                    @* } *@
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>