@model IncomeStatementModel

<div class="container-xxl flex-grow-1 container-p-y">
    <h4 class="fw-bold">Income Statement</h4>
    <h4 class="fw-bold">For the year ended on December 31, 2023</h4>
    <hr class="mb-4" />

    <div class="card pt-3">
        
        <table class="table">
            <thead>
                <tr>
                    <th colspan="3"><b>Revenue</b></th>
                </tr>
                <tr>
                    <th colspan="1">Account Title</th>
                    <th colspan="1">Amount</th>
                    <th colspan="1">Total</th>
                </tr>
            </thead>
            <tbody>
                @foreach(VoucherEntry entry in Model.RevenueEntries)
                {
                    <tr>
                        <td>@entry.Account.Category.SubType.TypeId - @entry.Account.Category.SubTypeId - @entry.Account.CategoryId - @entry.AccountId - @entry.Account.Name</td>
                        <td>@entry.Credit.ToString("N0")</td>
                        <td></td>
                    </tr>
                }
                <tr>
                    <td colspan="2"></td>
                    <td>@Model.TotalRevenue.ToString("N0")</td>
                </tr>
            </tbody>
            <thead>
                <tr>
                    <th colspan="3"><b>Expense</b></th>
                </tr>
                <tr>
                    <th colspan="1">Account Title</th>
                    <th colspan="1">Amount</th>
                    <th colspan="1">Total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (VoucherEntry entry in Model.ExpenseEntries)
                {
                    <tr>
                        <td>@entry.Account.Category.SubType.TypeId - @entry.Account.Category.SubTypeId - @entry.Account.CategoryId - @entry.AccountId - @entry.Account.Name</td>
                        <td>@entry.Debit.ToString("N0")</td>
                        <td></td>
                    </tr>
                }
                <tr>
                    <td colspan="2"></td>
                    <td>@Model.TotalExpense.ToString("N0")</td>
                </tr>
            </tbody>
            <tfoot>
                <tr>
                    <td></td>
                    <td><b>Net Income: </b></td>
                    @if(Model.NetIncome < 0)
                    {
                        <td>(@Model.NetIncome.ToString("N0"))</td>
                    }
                    else
                    {
                        <td>@Model.NetIncome.ToString("N0")</td>
                    }
                </tr>
            </tfoot>
        </table>
    </div>
</div>

