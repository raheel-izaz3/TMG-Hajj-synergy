@model IEnumerable<ExpenseSubType>

@{
    string modelName = "Expense Sub Types";
    string modelNamePlural = "Expense Sub Types";
    string modelControllerRoute = "ExpenseSubType";
}

@if (TempData.ContainsKey("created"))
{
    if ((bool)TempData["created"]! == true)
    {
        <script>
            toastr.options.closeDuration = 100;
            toastr.options.closeButton = true;
            toastr.options.positionClass = "toast-top-center";
            toastr.options.showMethod = 'slideDown';
            toastr.options.hideMethod = 'slideUp';
            toastr.options.closeMethod = 'slideUp';
            toastr.success('', '@modelName Created Successfully!', { timeOut: 2000 })
        </script>
        TempData["created"] = false;
    }
}
@if (TempData.ContainsKey("deleted"))
{
    if ((bool)TempData["deleted"]! == true)
    {
        <script>
            toastr.options.closeDuration = 100;
            toastr.options.closeButton = true;
            toastr.options.positionClass = "toast-top-center";
            toastr.options.showMethod = 'slideDown';
            toastr.options.hideMethod = 'slideUp';
            toastr.options.closeMethod = 'slideUp';
            toastr.success('', '@modelName Trashed Successfully!', { timeOut: 2000 })
        </script>
        TempData["deleted"] = false;
    }
}
@if (TempData.ContainsKey("updated"))
{
    if ((bool)TempData["updated"]! == true)
    {
        <script>
            toastr.options.closeDuration = 100;
            toastr.options.closeButton = true;
            toastr.options.positionClass = "toast-top-center";
            toastr.options.showMethod = 'slideDown';
            toastr.options.hideMethod = 'slideUp';
            toastr.options.closeMethod = 'slideUp';
            toastr.success('', '@modelName Updated Successfully!', { timeOut: 2000 })
        </script>
        TempData["updated"] = false;
    }
}

<div class="container-xxl flex-grow-1 container-p-y">
    <h4 class="fw-bold"><span class="text-muted fw-light"></span> @modelNamePlural</h4>

    <hr class="mb-4" />

    <a asp-action="Create" class="btn btn-info">Create New</a>

    <a asp-action="ViewTrash" class="btn btn-info float-end"><i class="bx bx-trash me-1"></i> Trash (@ViewBag.TrashCount)</a>

    <br />
    <br />
    <div class="card p-2">
        <div class="table-responsive text-nowrap ">
            <table class="table table-hover" id="table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Company</th>
                        <th>Expense Type</th>
                        <th>Expense Sub Type</th>
                        <th>Currency</th>
                        <th>Account Title</th>
                        <th>Account Number</th>
                        <th>IBAN</th>
                        <th>Swift Code</th>
                        <th>NTN</th>
                        <th>Beneficiary Address</th>
                        <th>Bank Address</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody class="table-border-bottom-1">
                    @{
                        int i = 0;
                    }
                    @foreach (var item in Model)
                    {
                        i++;
                        <tr>
                            <td>
                                <i class="fab fa-bootstrap fa-lg text-primary me-3"></i> <strong>@item.ExpenseSubTypeId</strong>
                            </td>
                            <td>@item.Company.CompanyName</td>
                            <td>@item.ExpenseType.TypeName</td>
                            <td>@item.ExpenseSubTypeName</td>
                            <td>@item.Currency</td>
                            <td>@item.AccountTitle</td>
                            <td>@item.AccountNumber</td>
                            <td>@item.IBAN</td>
                            <td>@item.SwiftCode</td>
                            <td>@item.NTN</td>
                            <td>@item.BeneficiaryAddress</td>
                            <td>@item.BankAddress</td>
                            <td>
                                <div class="dropdown">
                                    <a class="btn btn-success" asp-action="Print" asp-route-id="@item.ExpenseSubTypeId"><i class="bx bx-printer me-1"></i> Print</a>
                                    <a class="btn btn-warning" asp-action="Edit" asp-route-id="@item.ExpenseSubTypeId"><i class="bx bx-edit-alt me-1"></i> Edit</a>
                                    <button onclick="confirmDelete(@item.ExpenseSubTypeId)" class="btn btn-outline-danger"><i class="bx bx-trash me-1"></i> Trash</button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
<script>
    function confirmDelete(id) {
        let del = confirm("Are you sure?")
        if (del) {
            location.href = `/@modelControllerRoute/Trash/${id}`;
        }
    }

    let table = new DataTable('#table', {
    });
</script>

