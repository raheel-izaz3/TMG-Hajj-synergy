            /* width: 335px; */
            margin-top: 10px;
            /* float: left !important; */
        }


        .table_profile {
            border-collapse: collapse;
            width: 100%;
        }

        .table_profile tr {
            display: flex;
            justify-content: space-between;
            font-size: 12px !important;
            /* border-bottom: 1px solid black; */
            border: 1px solid black;

        }

        .table_profile th {
            font-size: 8px !important;

        }

        .table_profile td {
            /* text-align: right; */
            font-size: 8px !important;
            padding: 2px 0;
        }

        .table_profile tr td:nth-child(2) {
            text-align: right;
        }

        /* Package__Details ___ */
        .packagesection {
            margin-top: 30px;
        }

        .Our_Package {
            border-collapse: collapse;
            width: 100%;
            border: 1px solid black;
        }

        .Our_Package td {
            font-size: 8px !important;
        }

        .Our_Package th {
            font-size: 8px !important;
            padding: 3px 0;
            text-align: left;
        }

        .Our_Package tr {
            border-bottom: 1px solid black;
        }

        .Our_Package th:nth-child(2) {
            padding-left: 100px;
        }

        .Our_Package td:nth-child(2) {
            padding-left: 100px;
        }

        /* Package__Details ___ END*/

        /* Terms_contidions_form  */
        .termsConditions {
            margin-top: 15px;
        }

        @*.termsConditionsp{text-align:justify;}.termsConditionsh5{font-size:10px;/*background-image:linear-gradient(315deg,#74d6800%,#378b2974%);*/background-color:lightblue;/*color:white;*/color:black;display:inline-block;padding:08px!important;}*@@*.termsConditionsh5,p,li{margin:0;padding:0;}.termsConditionsp{font-size:8px;}*@.profile_image img {
            width: 100%;
        }

        .profile_image {
            width: 130px !important;
            height: 170px;
            float: left !important;
            /* width: 100%; */
            border: 1px solid black;
            /* margin-top: 15px; */
            /* box-shadow: rgba(0, 0, 0, 0.12) 0px 1px 3px, rgba(0, 0, 0, 0.24) 0px 1px 2px; */
            box-shadow: rgba(6, 24, 44, 0.4) 0px 0px 0px 2px, rgba(6, 24, 44, 0.65) 0px 4px 6px -1px, rgba(255, 255, 255, 0.08) 0px 1px 0px inset;
            margin: 11px 0px;
            text-align: left !important;
        }

        .UnOrded_list li {
            font-size: 8px;
        }

        footer {
            display: flex;
            justify-content: space-between;
            margin-top: 2px;
        }

        .QR_Code_logo {
            text-align: right;
        }

        .footer-text {
            display: flex;
            justify-content: center;
            align-items: center;
            text-align: center;

        }

        .signature-part {
            display: flex;
            justify-content: center;
            align-items: center;
        }

        #signatureCanvas {
            border: 1px solid black;
        }
