            <div class="row">

                <div class="col-sm-12 col-md-6">
                    <label>Verify Email: </label>
                    <input type="email" asp-for="Email" class="form-control" style="width: 300px;" />
                </div>
            </div>
            <div class="row mt-5">
                <div class="col-md-12 mt-3">
                   @*  <div class="form-check-inline" id="signatureBox">
                        <input class="form-check-input" type="hidden" checked id="dataform" value="true">
                        <label class="form-check-label" for="dataform">
                            I want to sign my Hajj Agreement
                        </label>
                    </div> *@
                    <div class="form-check-inline" id="signatureBox">
                        <input class="form-check-input" type="hidden" asp-for="SignDataForm" checked id="signdata" value="true">
                        @* <label class="form-check-label" for="signdata">
                            I want to sign my Data Form
                        </label> *@
                    </div>
                     @* <div class="form-check-inline" id="signatureBox">
                        <input class="form-check-input" type="checkbox" asp-for="SignMISDataForm" checked id="medical">
                        <label class="form-check-label" for="medical">
                            I want to sign my MIS Data Form
                        </label>
                    </div> *@
                    <div class="form-check" id="signatureBox">
                        <input class="form-check-input" type="hidden" asp-for="SignMedicalAffidavit" checked
                            id="medical" value="true">
                        @* <label class="form-check-label" for="medical">
                            <b>Medical Fitness Certificate:</b><br>
                            I want to sign my Medical Affidavit as I am medically fit for Hajj journey & I do not
