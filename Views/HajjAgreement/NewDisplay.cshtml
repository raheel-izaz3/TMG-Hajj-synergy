                        </label>
                    </div>

                </div>


                <div class="col-md-12 mt-3">
                    <input type="hidden" name="SignatureBase64" id="signature_data" />
                    <div class="btn-group" id="signatureButtons" style="display: none;">
                        <button class="btn btn-primary" type="button" onclick=" captureSignature(); enableSaveBtn(); SaveToBase64(); ">
                            Sign
                            Document
                        </button>
                        <button class="btn btn-danger" type="button" onclick="clearSignature()">Clear Signature</button>
                        <button class="btn btn-success" id="saveBtn" style="display: none;">Save</button>
                    </div>
                </div>
            </div>
        </div>


    </form>
    <script>
        function enableSaveBtn(){
            const emptyBase64 = "data:image/png;base64,"

            const val = document.getElementById("signature_data").value
            
            if(val == emptyBase64){
                alert("Please provide your signature")
                return
            }

            document.getElementById('saveBtn').style.display = ''
        }
    </script>
    <script src="~/assets/js/mainFromSign.js"></script>
    <script src="~/assets/js/signature.js"></script>
