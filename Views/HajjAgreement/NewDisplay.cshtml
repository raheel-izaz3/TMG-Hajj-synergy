    <form action="/HajjAgreement/Save" method="post" onsubmit="return confirm('Are You Sure?')">
        <div class="signature-bottom" style="margin-top: 30px;">
            <div class="footer-text">
                <p><b> I HAVE CAREFULLY READ AND UNDERSTOOD THE TERMS AND CONDITIONS OF THIS AGREEMENT AND THESE ARE
                        CORRECT
                        <br>
                        IN WITNESS WHEREOF </b> , the parties hereto have executed this Hajj Program Reservation
                    Agreement
                    as of the date first above written.</p>
            </div>



            <ul>
                @foreach(FamilyMembers members in ViewBag.Members)
                {
                    <li>@members.FamilyHead.FullName</li>
                }
            </ul>
            <div class="signature-part">
