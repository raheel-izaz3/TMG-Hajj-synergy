@model TMG.Models.ExpenseModels.ExpenseTransactionIndexViewModel

@{
    ViewData["Title"] = "Expense Transaction Details";
}

<div class="container-xxl flex-grow-1 container-p-y">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="fw-bold m-0"><span class="text-muted fw-light">Expense Transactions /</span> Details</h4>
        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-success">
                <i class="bx bx-pencil me-1"></i> Edit
            </a>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="bx bx-arrow-back me-1"></i> Back
            </a>
        </div>
    </div>

    <hr class="mb-4" />

    <div class="row">
        <div class="col-lg-8 mx-auto">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-light d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0 fw-bold">Transaction Details #@Model.Id</h5>
                    <span class="badge bg-primary fs-6">@Model.Currency @Model.Amount.ToString("N2")</span>
                </div>
                <div class="card-body mt-3">
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted font-weight-bold">Expense Head:</div>
                        <div class="col-sm-8 fw-bold text-dark">@Model.ExpenseHeadName</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted font-weight-bold">Type:</div>
                        <div class="col-sm-8"><span class="badge bg-label-info">@Model.Type</span></div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted font-weight-bold">Amount & Currency:</div>
                        <div class="col-sm-8">@Model.Amount.ToString("N2") <strong>@Model.Currency</strong> (Rate: @Model.ExchangeRate.ToString("0.0000"))</div>
                    </div>
                    @if (Model.Currency != "PKR")
                    {
                        var pkrValue = Model.Amount * Model.ExchangeRate;
                        <div class="row mb-3">
                            <div class="col-sm-4 text-muted font-weight-bold">Equivalent PKR:</div>
                            <div class="col-sm-8 text-success fw-bold">PKR @pkrValue.ToString("N2")</div>
                        </div>
                    }
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted font-weight-bold">Payment Type:</div>
                        <div class="col-sm-8">@Model.PaymentType</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted font-weight-bold">Year & Date:</div>
                        <div class="col-sm-8">Year @Model.Year | Date: @Model.Date.ToString("dd-MMM-yyyy")</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted font-weight-bold">Reference No:</div>
                        <div class="col-sm-8">@(string.IsNullOrEmpty(Model.ReferenceNo) ? "-" : Model.ReferenceNo)</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted font-weight-bold">Proof Document:</div>
                        <div class="col-sm-8">
                            @if (!string.IsNullOrEmpty(Model.ProofDocumentPath))
                            {
                                <a href="@Model.ProofDocumentPath" target="_blank" class="btn btn-sm btn-outline-primary">
                                    <i class="bx bx-file me-1"></i> Open Proof File
                                </a>
                            }
                            else
                            {
                                <span class="text-muted">No proof uploaded</span>
                            }
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted font-weight-bold">Description:</div>
                        <div class="col-sm-8">@(string.IsNullOrEmpty(Model.Description) ? "-" : Model.Description)</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted font-weight-bold">Created At:</div>
                        <div class="col-sm-8 text-muted">@Model.CreatedAt.ToString("dd-MMM-yyyy hh:mm tt")</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
