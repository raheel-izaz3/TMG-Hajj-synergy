@model EIslamic

@{
    Layout = "";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Print</title>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/summernote/0.8.18/summernote-lite.min.css" rel="stylesheet">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/summernote/0.8.18/summernote-lite.min.js"></script>

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: Arial, sans-serif;
            background: #f8f8f8;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            flex-direction: column;
            padding: 10px;
        }

        .invoice-container {
            position: relative;
            background-image: url('@Url.Content(Model.Image)');
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            width: 70%;
            max-width: 741px;
            height: 495px;
            padding: 20px;
            border: 2px solid #ddd;
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }

        .image-container {
            position: relative;
            width: 100%;
            height: 100%;
        }

       
        .left-image {
            position: absolute;
            top: 20px;
            left: 20px;
            width: 120px;
        }

            .left-image img {
                margin-top: -40px;
                margin-left: -40px;
                width: 90px;
                height: 110px;
            }


        .right-images {
            position: absolute;
            top: 20px;
            right: 20px;
            display: flex;
            flex-direction: column;
            align-items: flex-end;
            gap: 10px;
        }

            .right-images img:first-child {
                width: 108px;
                margin-right: -71px;
                margin-top: -50px;
                height: 106px;
            }

            .right-images img:last-child {
                margin-top: -26px;
                margin-right: -43px;
                width: 60px;
                height: auto;
            }

        
        .content-area {
            padding: 100px 140px 60px; 
            text-align: center;
            overflow-wrap: break-word;
            font-size: 18px;
            color: #000;
            height: 100%;
            overflow-y: auto;
        }

        .footer {
            position: absolute;
            bottom: 0;
            width: 100%;
            text-align: center;
        }

            .footer img {
                margin-bottom: -4px;
                width: 100%;
            }
     
        .export-btn {
            margin-top: 40px;
            padding: 12px 24px;
            font-size: 13px;
            font-weight: bold;
            color: white;
            background-color: #404346;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            transition: background 0.3s ease-in-out;
        }

            .export-btn:hover {
                background-color: red;
            }

        @@media (max-width: 768px) {
            .invoice-container {
                width: 90%;
                height: auto;
            }

            .content-area {
                padding: 80px 80px 60px;
            }

            .left-image, .right-images {
                display: none; 
            }
        }
    </style>
</head>
<body>

    <div id="invoice" class="invoice-container">
        <div class="image-container">
            <div class="left-image">
                <img src="@Url.Content("~/EIslamic/updatedleft.jpg")" alt="Left Logo" />
            </div>

            <div class="right-images">
                <img src="@Url.Content("~/EIslamic/rightlogo.png")" alt="Right Top Logo" />
                <img src="@Url.Content("~/EIslamic/rightbottom.png")" alt="Right Bottom Logo" />
            </div>

            <div class="content-area">
                @Html.Raw(Model.Content)
            </div>
        </div>

        <div class="footer">
            <img src="@Url.Content("~/EIslamic/footer.jpg")" alt="Footer" />
        </div>
    </div>

    <button class="export-btn" onclick="exportToImage()">Export as Image</button>

    <script>
        function exportToImage() {
            var invoice = document.getElementById("invoice");

            html2canvas(invoice, {
                scrollY: -window.scrollY,
                width: invoice.scrollWidth,
                height: invoice.scrollHeight,
                backgroundColor: null,
                scale: 2,
                useCORS: true
            }).then(function (canvas) {
                var link = document.createElement("a");
                link.href = canvas.toDataURL("image/png");
                link.download = "invoice.png";
                link.click();
            });
        }
    </script>
</body>
</html>
