    <script>

    function updateSelected(elem, familyHeadId, type) {

        const isHead = elem.getAttribute("data-is-head")
        const headId = elem.getAttribute("data-head-id")
        const elemFcId = elem.getAttribute("data-HB #")

        if (isHead == "True" && elem.checked) {
            const attributeName = 'data-head-id';
            let elements = null
            if(type == 'Excluded'){
                elements = document.querySelectorAll(`[${attributeName}="${headId}"][data-ex]`);
            }
            if(type == 'Complimentry'){
                elements = document.querySelectorAll(`[${attributeName}="${headId}"][data-compl]`);
            }
            if(type == 'Paid'){
                elements = document.querySelectorAll(`[${attributeName}="${headId}"][data-paid]`);
            }

            if (elem.checked) {
                for (let check of elements) {
                    if (check.hasAttribute('disabled')) continue;
                    check.checked = true
                    let fcId = check.getAttribute('data-HB #')
                    @* addMember(fcId) *@
                    console.log(check)
                }
            }
            else {
                elem.checked = false;
                @* removeMember(elemFcId) *@
                console.log(check)

            }
        }
        else if (elem.checked && isHead == "False") {
            @* addMember(elemFcId) *@
        }
        else{
            @* removeMember(elemFcId) *@
        }

    }

    $(document).ready(function () {
            var table = $('#reportTable').DataTable({
                dom: '<"dom_wrapper fh-fixedHeader"f>tip',
                pageLength: 20,
                fixedHeader: true,
                paging: false,
                info: false,
                ordering: false
            });

            const checkHeaders = document.querySelectorAll(".check-header");
            let i = 0;
            for (let check of checkHeaders) {
                check.setAttribute("data-column-index", i);
                i++;
            }

            $(".check-header").change(function () {
                colVis(this, table);
            });

            $("#printPage").click(function () {
                window.print();
            });

            $("#saveState").click(function () {
                saveDataTableState(table);
            });
        });

        function exportToExcel(tableId, filename) {
            var table = $('#' + tableId).DataTable();
            var header = table.columns().header().toArray().map(function (th) {
                return $(th).text();
            });

            var data = table.rows().data().toArray().map(function (row) {
                var rowData = [];
                $(row).find('td').each(function () {
                    var input = $(this).find('input');
                    if (input.length > 0) {
                        rowData.push(input.val());
                    } else {
                        rowData.push($(this).text());
                    }
                });
                return rowData;
            });

            var workbook = XLSX.utils.book_new();
            var worksheet = XLSX.utils.aoa_to_sheet([header]);

            for (var i = 0; i < data.length; i++) {
                XLSX.utils.sheet_add_aoa(worksheet, [data[i]], { origin: -1 });
            }

            XLSX.utils.book_append_sheet(workbook, worksheet, 'Sheet1');

            XLSX.writeFile(workbook, filename + '.xlsx');
        }



        function colVis(elem, table) {
            let index = elem.getAttribute('data-column-index');
            if (elem.checked) {
                table.column(index).visible(true);
            } else {
                table.column(index).visible(false);
            }
        }

        function saveDataTableState(table) {
            let state = {
                columnsVisibility: table.columns().visible(),
                rowData: []
            };

            table.rows().every(function () {
                let rowData = this.data();
                let inputs = $(this.node()).find('input');
                if (inputs.length > 0) {
                    inputs.each(function (index, input) {
                        rowData[index + 1] = input.value;
                    });
                }
                state.rowData.push(rowData);
            });

            let serializedState = JSON.stringify(state, function (key, value) {
                if (key === '_fixedHeader') {
                    return undefined;
                }
                return value;
            });

            localStorage.setItem('dataTableState', serializedState);

            alert('Table state saved successfully!');
        }






        function colVis(elem, table) {
            let index = elem.getAttribute('data-column-index');
            if (elem.checked) {
                table.column(index).visible(true);
            } else {
                table.column(index).visible(false);
            }
        }
        function copyTablee() {
            var table = document.getElementById('reportTable');
            var range = document.createRange();
            range.selectNode(table);
            window.getSelection().removeAllRanges();
            window.getSelection().addRange(range);
            document.execCommand("copy");
            window.getSelection().removeAllRanges();
            alert('Table content copied to clipboard!');
        }
