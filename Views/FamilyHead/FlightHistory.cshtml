@model IEnumerable<FamilyHeadFlight>

<div class="container">
    <h4 class="mt-5">
        Flight History Of
        <span>
            @ViewBag.Name (@ViewBag.HBNo)
        </span>
    </h4>
    <div class="card mt-5">
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                <th>Flight Class</th>
                <th>Flight Type</th>
                <th>Airline</th>
                <th>Flight No</th>
                <th>Origin</th>
                <th>Destination</th>
                <th>Departure</th>
                <th>Arrival</th>
                <th>PNR No</th>
                <th>Ticket No</th>
                <th>Ticket PDF</th>
                @* <th>Currency</th> *@
                <th>Fare Amount</th>
                @* <th>Taxes</th>
                <th>Commission</th> *@
                @* <th>Issuing Agent</th> *@
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.FlightClass</td>
                            <td>@item.FlightType</td>
                            <td>@item.Airline.Name</td>
                            <td>@item.FlightNo</td>
                            <td>@item.Origin</td>
                            <td>@item.Destination</td>
                            <td>@item.DepartureDateTime?.ToString("dd/MMM/yyyy HH:mm")</td>
                            <td>@item.ArrivalDateTime?.ToString("dd/MMM/yyyy HH:mm")</td>
                            <td>@item.PNRNo</td>
                            <td>@item.TicketNo</td>
                            <td>
                                @if (item.TicketPDF is not null)
                                {
                                    <a href="~/@item.TicketPDF" target="_blank">
                                        View Document
                                    </a>
                                }
                                else
                                {
                                    <p>No PDF Found</p>
                                }
                            </td>
                             @* <td>@item.Currency.CurrencyName</td>  *@
                            <td>@item.FareAmount</td>
                            @*<td>@item.Taxes</td>
                             <td>@item.Commission</td>
                             <td>@item.IssuingAgent.AgentName</td>  *@
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>