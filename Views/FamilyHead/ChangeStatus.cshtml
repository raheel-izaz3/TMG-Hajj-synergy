@{
    ViewData["Title"] = "ChangeRemarks";
}

<div class="container-xxl flex-grow-1 container-p-y">
    <div class="card">
        <div class="row">
            <form method="post">
                <input type="hidden" value="@ViewBag.Id" id="CustomerPortfolioId" />
                <div class="col-md-12 col-sm-12 p-5">
                    <label class="form-label">Status</label>
                    <select class="form-control" id="Status">
                        @foreach (CustomerStatus item in ViewBag.Status)
                        {
                            <!option value="@item.CustomerStatusId" @(item.CustomerStatusId == ViewBag.SelectedStatusId ? "selected" : "")>
                                @item.Status
                            </!option>
                        }
                    </select>
                </div>
                <div class="col-sm-12 p-4">
                    <button type="submit" class="btn btn-warning float-end" id="saveStatusButton">Save</button>
                    <a asp-action="IndexCustomerProfile" class="btn btn-success">Back</a>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        $("#saveStatusButton").on("click", function () {
            var id = $("#CustomerPortfolioId").val();

            var passportData = {
                Status: $("#Status").val(),
            };

            $.ajax({
                url: '/CustomerPortfolioForm/SaveStatus',
                type: 'POST',
                data: $.extend({ id: id }, passportData),
                success: function (response) {
                    console.log(response);
                    if (response.status === 200) {
                        alert("Status saved successfully!");
                    } else {
                        alert("Error: " + response.msg);
                    }
                },
                error: function (xhr, status, error) {
                    alert("An error occurred: " + xhr.responseText);
                }
            });
        });
    });
</script>
