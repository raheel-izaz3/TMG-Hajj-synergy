<script>

    function addRemarks() {
        const id = Date.now() + Math.floor(Math.random() * 10000)
        let row = "";

        row += `
                                                                        <div class="row mt-2" id="remark_${id}">
                                                                            <div class="col-sm-11 mt-2">
                                                                                <input type="text" name="Remarks[]" placeholder="Enter Remarks..." class="form-control">
                                                                            </div>
                                                                            <div class="col-sm-12 col-md-1" style="display:flex;flex-direction: column;justify-content: center;flex-wrap: wrap;align-content: center;">
                                                                                <button type="button" class="btn btn-icon btn-danger" onclick="removeRemarks(${id})"><i class='bx bxs-trash'></i></button>
                                                                            </div>
                                                                        </div>
                                                                    `

        $("#remarks").append(row);
    }

