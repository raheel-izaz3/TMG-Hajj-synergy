@model FamilyHeadIndexModel
@using Microsoft.AspNetCore.Http
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor http

@{
    string modelName = "Family Head";
    string modelNamePlural = "Family Heads";
    string modelControllerRoute = "FamilyHead";
}

<style>
    #congratulations-dropdown:hover .dropdown-menu {
        display: block;
    }
</style>
@if (TempData.ContainsKey("created"))
{
    if ((bool)TempData["created"]! == true)
    {
        <script>
            toastr.options.closeDuration = 100;
            toastr.options.closeButton = true;
            toastr.options.positionClass = "toast-top-center";
            toastr.options.showMethod = 'slideDown';
            toastr.options.hideMethod = 'slideUp';
            toastr.options.closeMethod = 'slideUp';
            toastr.success('', '@modelName Created Successfully!', { timeOut: 2000 })
        </script>
        TempData["created"] = false;
    }
}
@if (TempData.ContainsKey("deleted"))
{
    if ((bool)TempData["deleted"]! == true)
    {
        <script>
            toastr.options.closeDuration = 100;
            toastr.options.closeButton = true;
            toastr.options.positionClass = "toast-top-center";
            toastr.options.showMethod = 'slideDown';
            toastr.options.hideMethod = 'slideUp';
            toastr.options.closeMethod = 'slideUp';
            toastr.success('', '@modelName Trashed Successfully!', { timeOut: 2000 })
        </script>
        TempData["deleted"] = false;
    }
}
@if (TempData.ContainsKey("updated"))
{
    if ((bool)TempData["updated"]! == true)
    {
        <script>
            toastr.options.closeDuration = 100;
            toastr.options.closeButton = true;
            toastr.options.positionClass = "toast-top-center";
            toastr.options.showMethod = 'slideDown';
            toastr.options.hideMethod = 'slideUp';
            toastr.options.closeMethod = 'slideUp';
            toastr.success('', '@modelName Updated Successfully!', { timeOut: 2000 })
        </script>
        TempData["updated"] = false;
    }
}

<style>
    .tooltip {
        position: fixed;
        top: 10px;
        left: 50%;
        transform: translateX(-50%);
        background-color: rgba(0, 0, 0, 0.8);
        color: #fff;
        padding: 10px 20px;
        border-radius: 5px;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.3s ease;
    }

        .tooltip.show {
            opacity: 1;
        }

    .custom-dropdown {
        display: inline-block;
    }

    .custom-dropdown-button {
        padding: 6px 12px;
        font-size: 14px;
        cursor: pointer;
        background-color: #7e3639;
        color: white;
        /* border: 1px solid #007bff; */
        border-radius: 4px;
    }

    .custom-dropdown-menu {
        display: none;
        position: absolute;
        background-color: white;
        min-width: 160px;
        box-shadow: 0px 8px 16px rgba(0, 0, 0, 0.2);
        z-index: 1;
        border: 1px solid #ddd;
        border-radius: 4px;
        padding: 0;
        margin-top: 8px;
    }

        .custom-dropdown-menu.show {
            display: block;
        }

    .custom-dropdown-item {
        padding: 8px 12px;
        text-decoration: none;
        display: block;
        color: black;
    }

        .custom-dropdown-item:hover {
            background-color: #f1f1f1;
        }

</style>

<div class="container-xxl flex-grow-1 container-p-y">
    <h4 class="fw-bold">
        <span class="text-muted fw-light"></span> @modelNamePlural

    </h4>
    <span class="text-right">
        <b>Total # of Hajj Bookings:</b> @Model.FamilyCount<b>
            | Total # of Members:
        </b> @Model.FamilyMemberCount
    </span>
    <span class="text-right">
        <b> | Total # of Tentative:</b> @Model.TentativeCount<b>
            | Total # of Booked:
        </b> @Model.BookedCount
        <b> | Total # of Cancelled: </b> @Model.CancelledCount
    </span>
    <span class="text-right">
        <b>
            | Total # of Bio Verified:
        </b>
        @Model.ENumberVerifiedCount
    </span>
    <span class="text-right">
        <b>
            | Total # of Form Verified:
        </b>
        @Model.FormVerifiedCount
    </span>
    <span class="text-right">
        <b>
            | Total # of E-Hajj Visa Verified:
        </b>
        @Model.EHajjVerifiedCount
    </span>

    <hr class="mb-4" />

    @if (ViewBag.CreateAllowed == true)
    {
        @* <a asp-action="Create" class="btn btn-info">Create New</a> *@
        <a asp-action="CreateTentative" class="mx-2 btn btn-info">Create New Hajj Booking</a>
    }


    @if (Model.IsAdmin)
    {
        <a asp-action="ViewTrashMainPage" class="btn btn-info float-end">
            <i class="bx bx-trash me-1"></i> Trash
            (@ViewBag.TrashCount)
        </a>
    }
    <br />
    <br />
    <div class="card p-2">
        <div class="table-responsive text-nowrap ">

            <button id="exportPDF" class="btn btn-success">PDF</button>
            <button id="exportExcel" class="btn btn-outline-success">Excel</button>
            <div id="dataGrid"></div>

        </div>
    </div>
</div>

@{
    var options = new System.Text.Json.JsonSerializerOptions
            {
                NumberHandling = System.Text.Json.Serialization.JsonNumberHandling.AllowNamedFloatingPointLiterals
            };

    var dataSource = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Entries, options));
}

<script src="https://cdnjs.cloudflare.com/ajax/libs/exceljs/4.3.0/exceljs.min.js"></script>
<script src="https://cdn3.devexpress.com/jslib/22.2.3/js/jquery.min.js"></script>
<script src="https://cdn3.devexpress.com/jslib/22.2.3/js/jszip.min.js"></script>

<script>

    $(function () {
        var gridData = @dataSource;
        var isAdmin = @Html.Raw(Model.IsAdmin.ToString().ToLower());
        var viewFamilyAllowed = @Html.Raw(ViewBag.ViewFamilyAllowed.ToString().ToLower());
        var modelControllerRoute = '@modelControllerRoute';
        var currentUserId = @Html.Raw(Json.Serialize(int.Parse(http.HttpContext.Session.GetString("UserId"))));

        console.log(gridData);

        var dataGrid = $("#dataGrid").dxDataGrid({
            dataSource: gridData,
            keyExpr: "FamilyHeadId",
            columnAutoWidth: true,
            showBorders: true,
            hoverStateEnabled: true,
            showColumnHeaders: true,
            paging: {
                pageSize: 50
            },
            pager: {
                showPageSizeSelector: true,
                allowedPageSizes: [10, 25, 50, 100],
                showInfo: true
            },
            filterRow: {
                visible: true
            },
            headerFilter: {
                visible: true
            },
            scrolling: {
                mode: "virtual",
                showScrollbar: "always"
            },
            columns: [
                { dataField: "SerialNumber", caption: "#" },
                { dataField: "BookedBy", caption: "Booked By" },
                { dataField: "FeedBy", caption: "Feed By" },
                { dataField: "Company", caption: "HGO" },
                { dataField: "Package", caption: "PKG" },
                { dataField: "FcId", caption: "HB #" },
                { dataField: "Head", caption: "Family Head Name" },
                { dataField: "NumberOfMembers", caption: "PAX" },
                { dataField: "HajjiBookingStatus", caption: "Status" },
                {
                    dataField: "RemaingAmount",
                    caption: "Remaining Amount",
                    visible: [1, 5, 11, 12].includes(currentUserId),
                    cellTemplate: function (container, options) {
                        let currency = options.data.Currency;
                        let formattedAmount = new Intl.NumberFormat('en-US', {
                        }).format(options.value);

                        container.text(`${currency}  ${formattedAmount}`);
                    }
                },
                {
                    dataField: "Bookings",
                    caption: "Booking",
                    calculateCellValue: (rowData) => `${rowData.Bookings} / ${rowData.NumberOfMembers}`
                },
                {
                    caption: "Actions",
                    cellTemplate: function (container, options) {
                        let familyHeadId = options.data.FamilyHeadId;

                        let dropdown = $("<div>").addClass("custom-dropdown").attr("id", `dropdown-${familyHeadId}`);
                        let dropdownButton = $("<button>")
                            .addClass("custom-dropdown-button")
                            .text("Reports")
                            .on("click", function () {
                                $(this).siblings(".custom-dropdown-menu").toggleClass("show");
                            })
                            .appendTo(dropdown);

                        let dropdownMenu = $("<ul>").addClass("custom-dropdown-menu").appendTo(dropdown);

                        [
                            { action: "FamilyHeadReport/DataFormv3", text: "1. Data Form" },
                            { action: "MiniStatement/NewInvoiceV2", text: "2. Proforma Invoice" },
                            { action: "FamilyHeadReport/NewMedicalAffidavit", text: "3. Medical Affidavit" },
                            { action: "FamilyHeadReport/UploadBiometric", text: "4. Biometric Link" },
                            { action: "FamilyHeadReport/VerifyBiometric", text: "5. Verify Biometric" },
                            { action: "FamilyHeadReport/DownloadProof", text: "6. Download Proof of Payment" },
                            { action: "FamilyHeadReport/DownloadMedia", text: "7. Download Media" },
                            { action: "FamilyHeadReport/Addresses", text: "8. Addresses" },
                            { action: "FamilyHeadReport/EHajjReport", text: "9. E Hajj Report" },
                            { action: "FamilyHeadReport/EHajjDataForm", text: "10. E Hajj Visa Form" },
                            { action: "FamilyHeadReport/NewItinerary", text: "11. Itinerary" },
                            { action: "FamilyHeadReport/GiftReport", text: "12. Gift Report" },
                            { action: "FamilyHeadReport/SuitCaseReport", text: "13. Suit Case Report" },
                            { action: "FamilyHeadReport/Booklet", text: "14. Booklet" },
                            { action: "FamilyHeadReport/Cards", text: "15. Government ID Card" },
                            { action: "FamilyHeadReport/IdCard", text: "16. ID Card" },
                            { action: "FamilyHeadReport/LuggageCard", text: "17. Luggage Card" },
                            { action: "FamilyHeadReport/NusukCard", text: "18. Nusuk Card" },
                            { action: "FamilyHeadReport/SendCards", text: "19. Mail Cards" },
                            { action: "FamilyHeadReport/ReceiptReport", text: "20. Receipts" },
                            { action: "HajjAgreement/DisplayDataForm", text: "21. Hajj Aggrement" },
                            { action: "MiniStatement/NewMiniStatement", text: "22. Mini Statement" },
                            { action: "FamilyHeadReport/NusukArrivalReport", text: "23. Nusuk Arrival" }
                        ].forEach(item => {
                            $("<li>").append(
                                $("<a>")
                                    .attr("href", `/${item.action}?id=${familyHeadId}`)
                                    .attr("target", "_blank")
                                    .addClass("custom-dropdown-item")
                                    .text(item.text)
                            ).appendTo(dropdownMenu);
                        });

                        dropdown.appendTo(container);

                        if (isAdmin) {
                            $("<button>")
                                .addClass("btn btn-danger")
                                .text("Trash")
                                .on("click", function () { confirmDelete(familyHeadId); })
                                .appendTo(container);
                        }

                        if (viewFamilyAllowed) {
                            $("<a>")
                                .addClass("btn btn-warning")
                                .attr("href", `/${modelControllerRoute}/ViewFamily?id=` + familyHeadId)
                                .text("View Family")
                                .appendTo(container);
                        }
                    }
                }
            ],
            summary: {
                totalItems: [{
                    column: "RemaingAmount",
                    summaryType: "custom",
                    displayFormat: "Total: {0}",
                    valueFormat: "#,##0.##",
                    customizeText: function (data) {
                        let currencyTotals = {};
                        let dataSource = $("#dataGrid").dxDataGrid("instance").option("dataSource");

                        dataSource.forEach(item => {
                            if (item.HajjiBookingStatus !== "Cancelled") {
                                let currency = item.Currency || "Unknown";
                                let amount = parseFloat(item.RemaingAmount) || 0;

                                if (!currencyTotals[currency]) {
                                    currencyTotals[currency] = 0;
                                }
                                currencyTotals[currency] += amount;
                            }
                        });

                        let totalText = Object.entries(currencyTotals)
                            .map(([currency, total]) => `${currency}: ${total.toLocaleString()}`)
                            .join(" | ");

                        return totalText;
                    }
                }]
            }
        }).dxDataGrid("instance");

        $("#exportPDF").on("click", function () {
            const { jsPDF } = window.jspdf;
            const doc = new jsPDF("portrait");

            const dataSource = dataGrid.getDataSource();
            const combinedFilter = dataGrid.getCombinedFilter();

            dataSource.store().load({ filter: combinedFilter }).then(filteredData => {
                doc.setFontSize(10);
                doc.text("Family Head Report", 10, 10);

                const tableData = [];
                let currencyTotals = {};

                filteredData.forEach((row, index) => {
                    const rowData = [
                        index + 1,
                        row.BookedBy,
                        row.FeedBy,
                        row.Company,
                        row.Package,
                        row.FcId,
                        row.Head,
                        row.NumberOfMembers
                    ];

                    if ([1, 5, 11, 12].includes(currentUserId)) {
                        let currency = row.Currency || "Unknown";
                        let amount = parseFloat(row.RemaingAmount) || 0;

                        if (row.HajjiBookingStatus !== "Cancelled") {
                            if (!currencyTotals[currency]) {
                                currencyTotals[currency] = 0;
                            }
                            currencyTotals[currency] += amount;
                            rowData.push(`${currency} ${amount.toLocaleString()}`);
                        } else {
                            rowData.push("-");
                        }
                    }

                    tableData.push(rowData);
                });

                if ([1, 5, 11, 12].includes(currentUserId)) {
                    Object.keys(currencyTotals).forEach(currency => {
                        tableData.push([
                            "", "", "", "", "", "", `Total (${currency}):`, "", `${currency} ${currencyTotals[currency].toLocaleString()}`
                        ]);
                    });
                }

                const headers = [
                    "#", "Booked By", "Feed By", "HGO", "PKG", "HB #", "Family Head Name", "PAX"
                ];
                if ([1, 5, 11, 12].includes(currentUserId)) {
                    headers.push("Remaining Amount");
                }

                const columnStyles = {
                    0: { cellWidth: 10 },
                    1: { cellWidth: 20 },
                    2: { cellWidth: 20 },
                    3: { cellWidth: 23 },
                    4: { cellWidth: 25 },
                    5: { cellWidth: 15 },
                    6: { cellWidth: 25 },
                    7: { cellWidth: 20 },
                    8: { cellWidth: 28 },
                    9: { cellWidth: 25 }
                };

                doc.autoTable({
                    head: [headers],
                    body: tableData,
                    startY: 30,
                    theme: 'striped',
                    columnStyles: columnStyles,
                });

                doc.save("FamilyHeadReport.pdf");
            });
        });

        $("#exportExcel").on("click", function () {
            let workbook = new ExcelJS.Workbook();
            let worksheet = workbook.addWorksheet("Family Head Report");

            let headers = ["#", "Booked By", "Feed By", "HGO", "PKG", "HB #", "Family Head Name", "PAX"];
            if ([1, 5, 11, 12].includes(currentUserId)) {
                headers.push("Remaining Amount");
            }
            worksheet.addRow(headers);

            const combinedFilter = dataGrid.getCombinedFilter();
            const hasFilters = combinedFilter && combinedFilter.length > 0;

            const dataToExport = hasFilters ? dataGrid.getDataSource().items() : gridData;
            let currencyTotals = {};

            dataToExport.forEach((row, index) => {
                let rowData = [
                    index + 1,
                    row.BookedBy,
                    row.FeedBy,
                    row.Company,
                    row.Package,
                    row.FcId,
                    row.Head,
                    row.NumberOfMembers
                ];

                if ([1, 5, 11, 12].includes(currentUserId)) {
                    let currency = row.Currency || "Unknown";
                    let amount = parseFloat(row.RemaingAmount) || 0;

                    if (row.HajjiBookingStatus !== "Cancelled") {
                        if (!currencyTotals[currency]) {
                            currencyTotals[currency] = 0;
                        }
                        currencyTotals[currency] += amount;
                        rowData.push(`${currency} ${amount.toLocaleString()}`);
                    } else {
                        rowData.push("-");
                    }
                }

                worksheet.addRow(rowData);
            });

            Object.keys(currencyTotals).forEach(currency => {
                worksheet.addRow([
                    "", "", "", "", "", "", `Total (${currency}):`, "", `${currency} ${currencyTotals[currency].toLocaleString()}`
                ]);
            });

            worksheet.columns.forEach(column => {
                column.width = 15;
            });

            workbook.xlsx.writeBuffer().then(function (buffer) {
                var blob = new Blob([buffer], { type: "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" });
                var link = document.createElement("a");
                link.href = URL.createObjectURL(blob);
                link.download = "FamilyHeadReport.xlsx";
                link.click();
            });
        });

    });

    function confirmDelete(id) {
        let del = confirm("Are you sure?")
        if (del) {
            location.href = `/FamilyHead/TrashFamily/${id}`;
        }
    }

    function copyHref(event, link) {
        event.preventDefault();
        var href = link.href;

        var tempInput = document.createElement('input');
        tempInput.setAttribute('value', href);
        document.body.appendChild(tempInput);

        tempInput.select();
        tempInput.setSelectionRange(0, 99999); // For mobile devices

        document.execCommand('copy');

        document.body.removeChild(tempInput);

        var tooltip = document.getElementById('tooltip');
        tooltip.classList.add('show');
        setTimeout(function () {
            tooltip.classList.remove('show');
        }, 2000); // Hide tooltip after 2 seconds
    }

    $(document).ready(function () {
        $('#congratulations-dropdown').hover(function () {
            $(this).find('.dropdown-toggle').dropdown('toggle');
        });
    });

    let tablee = new DataTable('#table', {
        dom: 'Bfrtip',
        buttons: [{
            text: 'Export to Excel',
            extend: 'excelHtml5',
            className: 'btn btn-dark',
            exportOptions: {
                columns: ':visible'
            }
        }],
        paging: true,
        pageLength: 50,
        order: [0, 'desc']
    });

</script>