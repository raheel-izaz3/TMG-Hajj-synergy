<script>

    function remove(event) {
        let row = event.target.closest('.row.mt-2');
        if (row) {
            row.remove();
        }
    }

    document.addEventListener("DOMContentLoaded", function () {
        var airlines = @Html.Raw(Json.Serialize(ViewBag.Airline));

        console.log("Airlines Loaded: ", airlines);

        window.addFFNumber = function () {
            var ffNumberContainer = document.getElementById("ffnumber");
            if (!ffNumberContainer) {
                console.error("Error: #ffnumber container not found!");
                return;
            }

            var index = new Date().getTime(); // Unique index
            var newRow = document.createElement("div");
            newRow.className = "row mt-2";
            newRow.id = "license_" + index;

            var airlineOptions = `<option value="">Select Airline</option>`;
            airlines.forEach(airline => {
                airlineOptions += `<option value="${airline.airlineId}">${airline.name}</option>`;
            });

            newRow.innerHTML = `
                <div class="col-md-5">
                    <select name="AirlineId[]" class="form-control">
                        ${airlineOptions}
                    </select>
                </div>
                <div class="col-md-5">
                    <input type="text" name="FFNumbers[]" placeholder="Enter FFNumber..." class="form-control">
                </div>
                <div class="col-md-2">
                    <button class="btn btn-outline-danger" type="button" onclick="removeFFNumber(${index})">
                        Remove <i class="bx bx-trash"></i>
                    </button>
                </div>
            `;

            ffNumberContainer.appendChild(newRow);
            console.log("New FFNumber row added with ID:", index);

            document.querySelector(".btn-outline-info").disabled = false; // Ensure Add button stays enabled
        };

        window.removeFFNumber = function (index) {
            var row = document.getElementById("license_" + index);
            if (row) {
                row.parentNode.removeChild(row); // Force remove
                console.log("Row removed:", index);
            }
        };
    });

</script>

<script>

        function calculateDaysNights(checkInId, checkOutId, dayId, nightId) {
    const checkIn = document.getElementById(checkInId)?.value;
    const checkOut = document.getElementById(checkOutId)?.value;

    if (checkIn && checkOut) {
        const inDate = new Date(checkIn);
        const outDate = new Date(checkOut);

        const diffTime = outDate - inDate;

        if (diffTime >= 0) {
            const diffDays = Math.floor(diffTime / (1000 * 60 * 60 * 24));
            const isExtraHour = (diffTime % (1000 * 60 * 60 * 24)) > 0;
            const totalNights = diffDays;

            document.getElementById(dayId).value = diffDays + (isExtraHour ? 1 : 0);
            document.getElementById(nightId).value = totalNights;
        } else {
            document.getElementById(dayId).value = '';
            document.getElementById(nightId).value = '';
        }
    }
}

function attachEvents(place) {
    const variants = ["", "_1"];
    variants.forEach(variant => {
        const checkIn = document.getElementById(`CheckIn_${place}${variant}`);
        const checkOut = document.getElementById(`CheckOut_${place}${variant}`);
        if (checkIn && checkOut) {
            checkIn.addEventListener("change", () =>
                calculateDaysNights(`CheckIn_${place}${variant}`, `CheckOut_${place}${variant}`, `Day_${place}${variant}`, `Night_${place}${variant}`)
            );
            checkOut.addEventListener("change", () =>
                calculateDaysNights(`CheckIn_${place}${variant}`, `CheckOut_${place}${variant}`, `Day_${place}${variant}`, `Night_${place}${variant}`)
            );
        }
    });
}

// Places you want to support
const places = ["Makkah", "Medina", "Azizia", "Mina"];

places.forEach(attachEvents);

window.onload = () => {
    places.forEach(place => {
        ["", "_1"].forEach(variant => {
            calculateDaysNights(`CheckIn_${place}${variant}`, `CheckOut_${place}${variant}`, `Day_${place}${variant}`, `Night_${place}${variant}`);
        });
    });
};

