@model IEnumerable<FamilyMembers>

@{
    string modelName = "Family Member";
    string modelNamePlural = "Family Members";
    string modelControllerRoute = "FamilyHead";

    var hajjiBookingStatuses = ViewBag.HajjiBookingStatus;
    var ticketStatus = ViewBag.TicketStatus;
    var VisaStatus = ViewBag.VisaStatus;

    if (hajjiBookingStatuses == null)
    {
        hajjiBookingStatuses = new List<dynamic>();
    }

    if (ticketStatus == null)
    {
        ticketStatus = new List<dynamic>();
    }

    if (VisaStatus == null)
    {
        VisaStatus = new List<dynamic>();
    }
}

<style>
    .tooltip {
        position: fixed;
        top: 10px;
        left: 50%;
        transform: translateX(-50%);
        background-color: rgba(0, 0, 0, 0.8);
        color: #fff;
        padding: 10px 20px;
        border-radius: 5px;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.3s ease;
    }

        .tooltip.show {
            opacity: 1;
        }
</style>

<div class="container-xxl flex-grow-1 container-p-y">
    <div class="tooltip" id="tooltip">Link copied</div>

    <h4 class="fw-bold" style="color:  #404040;"><span class="text-muted fw-light"></span> @modelNamePlural</h4>

    <hr class="mb-4" />
    <a class="btn btn-success float-start" asp-action="AddMember" asp-route-familyHeadId="@ViewBag.FamilyHeadId">
        <i class="bx bx-add-to-queue me-1"></i> Add
    </a>


    @if (ViewBag.RestoreAllowed == true)
    {
        <a asp-action="ViewTrash" asp-route-id="@Model.ElementAtOrDefault(0)?.HeadId" class="btn btn-info float-end">
            <i class="bx bx-trash me-1"></i> Trash
            (@ViewBag.TrashCount)
        </a>
    }
    <a asp-controller="FamilyHead" asp-action="Index" class="btn btn-warning">Back</a>
    <br />
    <br />
    <div class="card p-2 mt-2">
        <div class="table-responsive text-nowrap " style="padding-bottom: 200px;">
            @Html.AntiForgeryToken()
            <table class="table table-hover" id="table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Name</th>
                        <th>Family Head</th>
                        <th>Gender</th>
                        <th>Age</th>
                        <th>D.O.B</th>
                        <th>CNIC</th>
                        <th>Passport</th>
                        @if (ViewBag.VerifyAllowed == true)
                        {
                            <th>Ver.</th>
                        }
                        @* <th>Tentative</th> *@
                        <th>Status</th>
                        <th>Ticket Status</th>
                        <th>Visa Status</th>
                        <th>Visa Company</th>
                        <th>Reciever Name</th>
                        <th>Delivery Date</th>
                        <th>DD Reciever</th>
                        <th>DD Date</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody class="table-border-bottom-1">

                    @{
                        var SrNo = 1;
                    }


                    @foreach (FamilyMembers fm in Model)
                    {
                        // Save today's date.
                        var today = DateTime.Today;

                        // Calculate the age.
                        var age = today.Year - fm.FamilyHead.DateOfBirth.Year;

                        // Go back to the year in which the person was born in case of a leap year
                        if (fm.FamilyHead.DateOfBirth.Date > today.AddYears(-age)) age--;

                        <tr>
                            <td>
                                <i class="fab fa-bootstrap fa-lg text-primary me-3"></i>
                                <strong>@(SrNo++)</strong>
                            </td>
                            <td>@fm.FamilyHead.GivenName</td>
                            <td>@(fm.FamilyHead.IsHead ? "Yes" : "No")</td>
                            <td>@fm.FamilyHead.Gender</td>
                            <td>@age</td>
                            <td>@DateTimeManager.GetDate(@fm.FamilyHead.DateOfBirth)</td>
                            <td>@fm.FamilyHead.CNIC</td>
                            <td>@fm.FamilyHead.PassportNumber</td>
                            @if (ViewBag.VerifyAllowed == true)
                            {
                                <td>
                                    <input type="checkbox" onchange="verifyMember(this, @fm.FamilyHeadId)"
                                    @(fm.FamilyHead.Verified ? "checked" : "") class="form-control-check">
                                </td>

                            }
                            @* <td>
                        <input type="checkbox" onchange="bookMember(this, @fm.FamilyHeadId)"
                        @(fm.FamilyHead.Tentative ? "checked" : "") class="form-control-check">
                        </td> *@
                            <td>
                                <select class="form-control" id="hajjiBookingStatus" name="HajjiBookingStatus" onchange="updateStatus(@fm.FamilyHeadId, this.value)" style="width: 100px;">
                                    @foreach (var status in hajjiBookingStatuses)
                                    {
                                        @if ((int)fm.FamilyHead.HajjiBookingStatus == status.Value)
                                        {
                                            <option selected value="@status.Value">@status.Name</option>
                                        }
                                        else
                                        {
                                            <option value="@status.Value">@status.Name</option>
                                        }
                                    }
                                </select>
                            </td>
                            <td>
                                @if (fm.FamilyHead.FamilyHeadFlights != null &&
                               fm.FamilyHead.FamilyHeadFlights.Any(e => e.FlightClass == FlightClass.Self))
                                {
                                    <p>Self</p>
                                }
                                else
                                {
                                    <select class="form-control" id="ticketStatus" name="TicketStatus" onchange="updateTicket(@fm.FamilyHeadId, this.value)" style="width: 100px;">
                                        @foreach (var tkt in ticketStatus)
                                        {
                                            <!option value="@tkt.Value" selected="@(fm.FamilyHead.TicketStatus == (TktStatus)tkt.Value ? "selected" : null)">
                                                @tkt.Name
                                            </!option>
                                        }
                                    </select>
                                }
                            </td>
                            <td>
                                <select class="form-control" id="VisaStatus" name="VisaStatus"
                                        onchange="updateVisaStatus(@fm.FamilyHeadId, this.value)" style="width: 100px;">

                                    @* Show default option if VisaStatus is null *@
                                    @if (!fm.FamilyHead.VisaStatus.HasValue)
                                    {
                                        <option value="" selected>-- Select Status --</option>
                                    }

                                    @* List all enum options *@
                                    @foreach (var status in ViewBag.VisaStatus)
                                    {
                                        if (fm.FamilyHead.VisaStatus.HasValue && (int)fm.FamilyHead.VisaStatus.Value == status.Value)
                                        {
                                            <option value="@status.Value" selected>@status.Name</option>
                                        }
                                        else
                                        {
                                            <option value="@status.Value">@status.Name</option>
                                        }
                                    }
                                </select>
                            </td>
                            <td>
                                <select class="form-control" id="VisaStatus" name="VisaStatus"
                                        onchange="updateCompanyStatus(@fm.FamilyHeadId, this.value)" style="width: 100px;">

                                    @* Show default option if CompanyVisasId is null *@
                                    @if (!fm.FamilyHead.CompanyVisasId.HasValue)
                                    {
                                        <option value="" selected>-- Select Company --</option>
                                    }

                                    @* List all company options *@
                                    @foreach (var company in ViewBag.CompanyVisa)
                                    {
                                        if (fm.FamilyHead.CompanyVisasId == company.CompanyVisasId)
                                        {
                                            <option value="@company.CompanyVisasId" selected>@company.CompanyName</option>
                                        }
                                        else
                                        {
                                            <option value="@company.CompanyVisasId">@company.CompanyName</option>
                                        }
                                    }
                                </select>
                            </td>
                            @if (fm.IsHead == true || fm.FamilyHeadId == 635 || fm.FamilyHeadId == 562 || fm.FamilyHeadId == 647 || fm.FamilyHeadId == 442)
                            {
                                <td>
                                    <input class="form-control"
                                           onchange="updaRecieverStatus(@fm.FamilyHeadId, this.value)"
                                           type="text" value="@fm.FamilyHead.RecieverName"
                                           name="RecieverName" />
                                </td>
                                <td>
                                    <input class="form-control" onchange="updateDateStatus(@fm.FamilyHeadId, this.value)" type="date" name="DateTime"
                                           value="@(DateTimeManager.DateToHtmlFormat(fm.FamilyHead.DeliveryDate))" />
                                </td>
                            }
                            else
                            {
                                <td></td>
                                <td></td>
                            }

                            @if (fm.IsHead == true || fm.FamilyHeadId == 635 || fm.FamilyHeadId == 562 || fm.FamilyHeadId == 647 || fm.FamilyHeadId == 442)
                            {
                                <td>
                                    <input class="form-control"
                                           onchange="updaDDRecieverStatus(@fm.FamilyHeadId, this.value)"
                                           type="text" value="@fm.FamilyHead.DDReceiver"
                                           name="DDReceiver" />
                                </td>
                                <td>
                                    <input class="form-control" onchange="updateDDDateStatus(@fm.FamilyHeadId, this.value)" type="date" name="DDDate"
                                           value="@(DateTimeManager.DateToHtmlFormat(fm.FamilyHead.DDDate))" />
                                </td>
                            }
                            else
                            {
                                <td></td>
                                <td></td>
                            }



                            <td>
                                <div class="dropdown">
                                    @* <a class="btn btn-info" target="_blank" asp-controller="FamilyHead"
                                       asp-action="GiveAway" asp-route-id="@fm.FamilyHeadId">GiveAway</a> *@

                                    <a class="btn btn-info" target="_blank" asp-controller="FamilyHeadReport"
                                       asp-action="FeedBack" asp-route-id="@fm.FamilyHeadId">Feedback Form</a>

                                    <a class="btn btn-warning" target="_blank" asp-controller="FamilyHeadReport"
                                       asp-action="Certificate" asp-route-id="@fm.FamilyHeadId">Certificate</a>

                                    <a class="btn btn-success" target="_blank" asp-controller="FamilyHead"
                                       asp-action="Visa" asp-route-id="@fm.FamilyHeadId">Visa Image</a>

                                    <a class="btn btn-success" target="_blank" asp-controller="FamilyHeadReport"
                                       asp-action="QurbaniSlip" asp-route-id="@fm.FamilyHeadId">Qurbani Slip</a>

                                    @* @if (fm.FamilyHead.SignatureBase64 is not null)
                                    {
                                        <a class="btn btn-info" target="_blank" asp-controller="HajjAgreement"
                                           asp-action="ViewAgreement" asp-route-id="@fm.FamilyHeadId">View Agreement</a>
                                    } *@
                                    <div class="btn-group" id="dropdown-icon-demo">
                                        <button type="button" class="btn btn-primary dropdown-toggle"
                                                data-bs-toggle="dropdown" aria-expanded="false">
                                            <i class="bx bxs-report"></i> Reports
                                        </button>
                                        <ul class="dropdown-menu" style="">
                                            <li>
                                                <a target="_blank" asp-controller="HajjAgreement"
                                                   asp-action="DisplayDataForm" asp-route-id="@fm.FamilyHeadId"
                                                   class="dropdown-item d-flex align-items-center"
                                                   onclick="copyHref(event, this)">
                                                    1. Agreement
                                                </a>
                                            </li>
                                            <li>
                                                <a target="_blank" asp-controller="FamilyHeadReport"
                                                   asp-action="MedicalAffidavitIndvidualView"
                                                   asp-route-id="@fm.FamilyHeadId"
                                                   class="dropdown-item d-flex align-items-center">
                                                    2. Medical Letter
                                                </a>
                                            </li>
                                            <li>
                                                <a target="_blank" href="~/@fm.FamilyHead.SignedMISPdfPath"
                                                   class="dropdown-item d-flex align-items-center">
                                                    3. View Signed MIS
                                                </a>
                                            </li>
                                            <li>
                                                <a target="_blank" asp-controller="FamilyHeadReport"
                                                   asp-action="DownloadDocuments" asp-route-id="@fm.FamilyHeadId"
                                                   class="dropdown-item d-flex align-items-center">
                                                    4. Download Documents
                                                </a>
                                            </li>
                                            <li>
                                                <a target="_blank" asp-controller="FamilyHeadReport"
                                                   asp-action="TicketBoardingStamp" asp-route-id="@fm.FamilyHeadId"
                                                   class="dropdown-item d-flex align-items-center">
                                                    5. Ticket Boarding Stamp
                                                </a>
                                            </li>
                                            <li>
                                                <a target="_blank" asp-controller="FamilyHeadReport"
                                                   asp-action="DownloadTicketBoardingStamp" asp-route-id="@fm.FamilyHeadId"
                                                   class="dropdown-item d-flex align-items-center">
                                                    6. Download Ticket w/ Boarding Stamp
                                                </a>
                                            </li>
                                            <li>
                                                <a target="_blank" asp-controller="FamilyHeadReport" asp-action="ItineraryRouteVehicles"
                                                   asp-route-id="@fm.FamilyHeadId"
                                                   class="dropdown-item d-flex align-items-center">
                                                    7. Itinerary
                                                </a>
                                            </li>
                                        </ul>
                                    </div>
                                    @if (ViewBag.EditAllowed == true)
                                    {
                                        <a class="btn btn-warning" asp-action="PinCode" asp-route-id="@fm.FamilyHeadId">
                                            <i class="bx bx-edit-alt me-1"></i> Edit
                                        </a>
                                    }
                                    @if (ViewBag.TrashAllowed == true && !fm.IsHead)
                                    {
                                        <button onclick="confirmDelete(@fm.FamilyHeadId)" class="btn btn-outline-danger">
                                            <i class="bx bx-trash me-1"></i> Trash
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }

                </tbody>
            </table>
        </div>
    </div>
</div>

<script>



    function updaRecieverStatus(familyHeadId, receiverName) {
        var token = document.querySelector('input[name="__RequestVerificationToken"]').value;

        $.ajax({
            type: "POST",
            url: '/FamilyHead/UpdateRecieverName',
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            headers: {
                'RequestVerificationToken': token
            },
            data: JSON.stringify({
                FamilyHeadId: familyHeadId,
                ReceiverName: receiverName
            }),
            success: function (response) {
                if (response.success) {
                    alert('Receiver name updated successfully!');
                } else {
                    alert('Error: ' + response.message);
                }
            },
            error: function (xhr, status, error) {
                alert('AJAX error: ' + error);
            }
        });
    }

    function updaDDRecieverStatus(familyHeadId, receiverName) {
        var token = document.querySelector('input[name="__RequestVerificationToken"]').value;

        $.ajax({
            type: "POST",
            url: '/FamilyHead/UpdateDDRecieverName',
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            headers: {
                'RequestVerificationToken': token
            },
            data: JSON.stringify({
                FamilyHeadId: familyHeadId,
                ReceiverName: receiverName
            }),
            success: function (response) {
                if (response.success) {
                    alert('Receiver name updated successfully!');
                } else {
                    alert('Error: ' + response.message);
                }
            },
            error: function (xhr, status, error) {
                alert('AJAX error: ' + error);
            }
        });
    }


    function updateVisaStatus(familyHeadId, newStatus) {
        $.ajax({
            url: '/FamilyHead/UpdateVisaStatus',
            type: 'POST',
            data: {
                familyHeadId: familyHeadId,
                newStatus: newStatus
            },
            success: function (response) {
                alert('Visa status updated successfully!');
            },
            error: function (xhr, status, error) {
                alert('Error updating visa status: ' + error);
            }
        });
    }

    function updateDateStatus(familyHeadId, selectedDate) {
        var token = document.querySelector('input[name="__RequestVerificationToken"]').value;

        $.ajax({
            type: "POST",
            url: '/FamilyHead/UpdateDate', // Change this to match your controller name
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            headers: {
                'RequestVerificationToken': token
            },
            data: JSON.stringify({
                FamilyHeadId: familyHeadId,
                Date: selectedDate
            }),
            success: function (response) {
                if (response.success) {
                    alert('Date updated successfully!');
                } else {
                    alert('Error: ' + response.message);
                }
            },
            error: function (xhr, status, error) {
                alert('AJAX error: ' + error);
            }
        });
    }

    function updateDDDateStatus(familyHeadId, selectedDate) {
        var token = document.querySelector('input[name="__RequestVerificationToken"]').value;

        $.ajax({
            type: "POST",
            url: '/FamilyHead/UpdateDDDate', // Change this to match your controller name
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            headers: {
                'RequestVerificationToken': token
            },
            data: JSON.stringify({
                FamilyHeadId: familyHeadId,
                Date: selectedDate
            }),
            success: function (response) {
                if (response.success) {
                    alert('Date updated successfully!');
                } else {
                    alert('Error: ' + response.message);
                }
            },
            error: function (xhr, status, error) {
                alert('AJAX error: ' + error);
            }
        });
    }

    function updateCompanyStatus(familyHeadId, companyId) {
        $.ajax({
            url: '/FamilyHead/UpdatesCompanyStatus',  // Endpoint in your controller
            type: 'POST',
            data: {
                familyHeadId: familyHeadId,
                companyId: companyId
            },
            success: function (response) {
                alert('Company updated successfully!');
            },
            error: function (xhr, status, error) {
                alert('Error updating Company status: ' + error);
            }
        });
    }

     function copyHref(event, link) {
         event.preventDefault();
         var href = link.href;

         var tempInput = document.createElement('input');
         tempInput.setAttribute('value', href);
         document.body.appendChild(tempInput);

         tempInput.select();
         tempInput.setSelectionRange(0, 99999); // For mobile devices

         document.execCommand('copy');

         document.body.removeChild(tempInput);

         var tooltip = document.getElementById('tooltip');
         tooltip.classList.add('show');
         setTimeout(function () {
             tooltip.classList.remove('show');
         }, 2000); // Hide tooltip after 2 seconds
     }

     function confirmDelete(id) {
         let del = confirm("Are you sure?")
         if (del) {
             location.href = `/@modelControllerRoute/Trash/${id}`;
         }
     }

     let table = new DataTable('#table', {

     });

     function verifyMember(elem, id) {
         $.ajax({
             url: "/FamilyHead/VerifyMember/" + id,
             method: "POST",
             data: {
                 value: elem.checked
             },
             success: res => {
                 console.log(res)
             },
             error: err => {
                 console.error(err)
             }

         });
     }

     function bookMember(elem, id) {
         $.ajax({
             url: "/FamilyHead/BookMember/" + id,
             method: "POST",
             data: {
                 value: elem.checked
             },
             success: res => {
                 console.log(res)
             },
             error: err => {
                 console.error(err)
             }

         });
     }

     function updateStatus(familyHeadId, status) {
         var formData = new FormData();
         formData.append('familyHeadId', familyHeadId);
         formData.append('status', status);
         formData.append('date', new Date().toISOString());

         fetch('/FamilyHead/UpdateStatus', {
             method: 'POST',
             body: formData,
             headers: {
                 'X-Requested-With': 'XMLHttpRequest'
             }
         })
         .then(response => response.json())
         .then(data => {
             if (data.success === false) {
                 alert(data.message);
                 location.reload();
             }
             else if(data.success === true)
             {
                 alert(data.message);
             }
         })
         .catch(error => {
             console.error('Error:', error);
         });
     }

      function updateTicket(familyHeadId, status) {
          var formData = new FormData();
          formData.append('familyHeadId', familyHeadId);
          formData.append('status', status);
          formData.append('date', new Date().toISOString());

          fetch('/FamilyHead/UpdateTicket', {
              method: 'POST',
              body: formData,
              headers: {
                  'X-Requested-With': 'XMLHttpRequest'
              }
          })
          .then(response => response.json())
          .then(data => {
              if (data.success === false) {
                  alert(data.message);
                  location.reload();
              }
              else if(data.success === true)
              {
                  alert(data.message);
              }
          })
          .catch(error => {
              console.error('Error:', error);
          });
      }

