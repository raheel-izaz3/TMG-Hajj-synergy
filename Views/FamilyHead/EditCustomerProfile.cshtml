    function submitForm(e, index) {
        e.preventDefault();

        console.log(index)

        var id = document.querySelector(`#CustomerPortfolioId_${index}`).value
        var visaFile = document.querySelector(`#VisaFile_${index}`).files[0]
        var insuranceFile = document.querySelector(`#InsuranceFile_${index}`).files[0]
        var passportImage = document.querySelector(`#PassportImage_${index}`).files[0]
        var vaccinationImage = document.querySelector(`#VaccinationImage_${index}`).files[0]
        var memberImage = document.querySelector(`#MemberImage_${index}`).files[0]
        var misImage = document.querySelector(`#MISPdfPath_${index}`).files[0]

        console.log(id)
        console.log(visaFile)
        console.log(insuranceFile)
        console.log(passportImage)
        console.log(vaccinationImage)
        console.log(memberImage)
        console.log(misImage)

        var formData = new FormData();
        formData.append("VisaImage", visaFile)
        formData.append("InsuranceImage", insuranceFile)
        formData.append("PassportImage", passportImage)
        formData.append("MemberVaccinationImage", vaccinationImage)
        formData.append("MemberImage", memberImage)
        formData.append("MISPdfPath", misImage)
        console.log(formData)

        $.ajax({
            url: `/CustomerPortfolioForm/SaveDocuments/${id}`,
            type: 'POST',
            data: formData,
            contentType: false,
            processData: false,
            success: function (res) {
                console.log('File uploaded successfully');
                // console.log(res);
                if (passportImage != null) {
                    document.querySelector(`#PassportImage_${index}`).parentElement.innerHTML += ` <a href="@(ApplicationManager.BASE_URL)${passportImage.name}" target="_blank" class="text-success fw-bold">View Document</a>`
                }
                if (insuranceFile != null) {
                    document.querySelector(`#InsuranceFile_${index}`).parentElement.innerHTML += ` <a href="@(ApplicationManager.BASE_URL)${insuranceFile.name}" target="_blank" class="text-success fw-bold">View Document</a>`
                }
                if (memberImage != null) {
                    document.querySelector(`#MemberImage_${index}`).parentElement.innerHTML += `<a href="@(ApplicationManager.BASE_URL)${memberImage.name}" target="_blank" class="text-success fw-bold">View Document</a>`
                }
                if (vaccinationImage != null) {
                    document.querySelector(`#VaccinationImage_${index}`).parentElement.innerHTML += `<a href="@(ApplicationManager.BASE_URL)${vaccinationImage.name}" target="_blank" class="text-success fw-bold">View Document</a>`

                }
                if (visaFile != null) {
                    document.querySelector(`#VisaFile_${index}`).parentElement.innerHTML += `<a href="@(ApplicationManager.BASE_URL)${visaFile.name}" target="_blank" class="text-success fw-bold">View Document</a>`
                }
                if (misImage != null) {
                    document.querySelector(`#MISPdfPath_${index}`).parentElement.innerHTML += `<a href="@(ApplicationManager.BASE_URL)${misImage.name}" target="_blank" class="text-success fw-bold">View Document</a>`
                }
            },
            error: function (xhr, status, error) {
                console.error('Error uploading file:', error);
            }
        });
    }

