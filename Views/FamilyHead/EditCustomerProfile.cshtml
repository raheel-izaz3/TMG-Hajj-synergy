@using Microsoft.AspNetCore.Http
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor http

@model FamilyHeadEditRequest

<style>
    .d-width {
        width: 111px;
    }

    .f-width {
        width: 185px;
    }
</style>

<div class="container-xxl flex-grow-1 container-p-y">
    <a asp-controller="FamilyHead" asp-action="ViewCustomerMember" asp-route-id="@ViewBag.ViewFamilyId" class="btn btn-success float-end mb-2">Back</a>
    <h4 class="fw-bold" style="color:  #404040;"><span class="text-muted fw-light"> Family Head / </span> Edit</h4>

    <hr class="mb-4" />

    <div class="row">
        <div class="col-sm-12">
            <div class="nav-align-top mb-4">
                <ul class="nav nav-pills mb-3 nav-fill" role="tablist">
                    <li class="nav-item">
                        <button type="button" class="nav-link active" role="tab" data-bs-toggle="tab" data-bs-target="#navs-pills-justified-passport" aria-controls="navs-pills-justified-passport" aria-selected="false">
                            Passport
                        </button>
                    </li>
                    <li class="nav-item">
                        <button type="button" class="nav-link " role="tab" data-bs-toggle="tab" data-bs-target="#navs-pills-justified-contact" aria-controls="navs-pills-justified-contact" aria-selected="true">
                            Contacts
                        </button>
                    </li>
                    <li class="nav-item">
                        <button type="button" class="nav-link " role="tab" data-bs-toggle="tab" data-bs-target="#navs-pills-justified-reference" aria-controls="navs-pills-justified-reference" aria-selected="true">
                            Refferel
                        </button>
                    </li>
                    @if (Model.IsHead)
                    {
                        <li class="nav-item">
                            <button type="button" class="nav-link" role="tab" data-bs-toggle="tab" data-bs-target="#navs-pills-justified-family" aria-controls="navs-pills-justified-references" aria-selected="false">
                                Family Member
                            </button>
                        </li>
                        <li class="nav-item">
                            <button type="button" class="nav-link" role="tab" data-bs-toggle="tab" data-bs-target="#navs-pills-justified-document" aria-controls="navs-pills-justified-references" aria-selected="false">
                                Documentation
                            </button>
                        </li>
                    }
                </ul>
                <input type="hidden" asp-for="CustomerPortfolioId" />
                <div class="card">
                    <div class="tab-content">
                        <div class="tab-pane fade active show" id="navs-pills-justified-passport" role="tabpanel">
                            <div class="row">
                                <div class="col-sm-12 col-md-6 mb-3">
                                    <label class="form-label" for="basic-icon-default-fullname" asp-for="SPOId"></label>
                                    <span class="fw-bold text-danger"> *</span>
                                    <div class="input-group input-group-merge">
                                        <select class="form-control" asp-for="SPOId">
                                            <option value="">Select SPO</option>
                                            @foreach (SPO spo in ViewBag.SPOs)
                                            {
                                                <option value="@spo.SPOId">@spo.Name</option>
                                            }
                                        </select>
                                    </div>
                                    <span class="text-danger" asp-validation-for="SPOId"></span>
                                </div>
                                <div class="col-sm-12 col-md-6 mb-3">
                                    <label class="form-label" for="basic-icon-default-fullname" asp-for="FeedBy"></label>
                                    <span class="fw-bold text-danger"> *</span>
                                    <div class="input-group input-group-merge">
                                        <span id="basic-icon-default-fullname2" class="input-group-text"><i class="bx bx-building"></i></span>
                                        <input asp-for="FeedBy" class="form-control"
                                               value="@http.HttpContext.Session.GetString("Username")">
                                    </div>
                                    <span class="text-danger" asp-validation-for="FeedBy"></span>
                                </div>
                                <div class="col-sm-12 mb-3">
                                    <label class="form-label" for="basic-icon-default-fullname" asp-for="ApplicantType"></label>
                                    <span class="fw-bold text-danger"> *</span>
                                    <div class="input-group input-group-merge">
                                        <select class="form-control" asp-for="ApplicantType"
                                                asp-items="Html.GetEnumSelectList<ApplicantType>()">
                                        </select>
                                    </div>
                                    <span class="text-danger" asp-validation-for="ApplicantType"></span>
                                </div>
                                <div class="col-sm-12 col-md-4 mb-3">
                                    <label class="form-label" for="basic-icon-default-fullname" asp-for="HonorificsId"></label>
                                    <span class="fw-bold text-danger"> *</span>
                                    <div class="input-group input-group-merge">
                                        <span id="basic-icon-default-fullname2" class="input-group-text"><i class="bx bx-building"></i></span>
                                        <select class="form-select" asp-for="HonorificsId">
                                            <option value="">Select Honorifics...</option>
                                            @foreach (Honorifics honorifics in ViewBag.Honorifics)
                                            {
                                                <option value="@honorifics.HonorificsId">@honorifics.Title </option>
                                            }
                                        </select>
                                    </div>
                                    <span class="text-danger" asp-validation-for="HonorificsId"></span>
                                </div>
                                <div class="col-sm-12 col-md-4 mb-3">
                                    <label class="form-label" for="basic-icon-default-fullname" asp-for="SurName"></label>
                                    <span class="fw-bold text-danger"> *</span>
                                    <div class="input-group input-group-merge">
                                        <span id="basic-icon-default-fullname2" class="input-group-text"><i class="bx bx-building"></i></span>
                                        <input asp-for="SurName" class="form-control">
                                    </div>
                                    <span class="text-danger" asp-validation-for="SurName"></span>
                                </div>
                                <div class="col-sm-12 col-md-4 mb-3">
                                    <label class="form-label" for="basic-icon-default-fullname" asp-for="GivenName"></label>
                                    <span class="fw-bold text-danger"> *</span>
                                    <div class="input-group input-group-merge">
                                        <span id="basic-icon-default-fullname2" class="input-group-text"><i class="bx bx-calendar"></i></span>
                                        <input asp-for="GivenName" class="form-control">
                                    </div>
                                    <span class="text-danger" asp-validation-for="GivenName"></span>
                                </div>
                                <div class="col-sm-12 col-md-6 mb-3">
                                    <label class="form-label" for="basic-icon-default-fullname" asp-for="FatherName"></label>
                                    <span class="fw-bold text-danger"> *</span>
                                    <div class="input-group input-group-merge">
                                        <span id="basic-icon-default-fullname2" class="input-group-text"><i class="bx bx-building"></i></span>
                                        <input asp-for="FatherName" class="form-control">
                                    </div>
                                    <span class="text-danger" asp-validation-for="FatherName"></span>
                                </div>
                                <div class="col-sm-12 col-md-6 mb-3">
                                    <label class="form-label" for="basic-icon-default-fullname" asp-for="CNIC"></label>
                                    <span class="fw-bold text-danger"> *</span>
                                    <div class="input-group input-group-merge">
                                        <span id="basic-icon-default-fullname2" class="input-group-text"><i class="bx bx-building"></i></span>
                                        <input asp-for="CNIC" class="form-control" maxlength="15" oninput="formatCnicInput(this)">
                                    </div>
                                    <span class="text-danger" asp-validation-for="CNIC"></span>
                                </div>
                                <div class="col-sm-12 col-md-4 mb-3">
                                    <label class="form-label" for="basic-icon-default-fullname" asp-for="DateOfBirth"></label>
                                    <span class="fw-bold text-danger"> *</span>
                                    <div class="input-group input-group-merge">
                                        <span id="basic-icon-default-fullname2" class="input-group-text"><i class="bx bx-globe"></i></span>
                                        <input asp-for="DateOfBirth" max="@DateTimeManager.Today" class="form-control">
                                    </div>
                                    <span class="text-danger" asp-validation-for="DateOfBirth"></span>
                                </div>
                                <div class="col-sm-12 col-md-4 mb-3">
                                    <label class="form-label" for="basic-icon-default-fullname" asp-for="PlaceOfBirth"></label>
                                    <span class="fw-bold text-danger"> *</span>
                                    <div class="input-group input-group-merge">
                                        <span id="basic-icon-default-fullname2" class="input-group-text"><i class="bx bx-globe"></i></span>
                                        <input asp-for="PlaceOfBirth" class="form-control">
                                    </div>
                                    <span class="text-danger" asp-validation-for="PlaceOfBirth"></span>
                                </div>
                                <div class="col-sm-12 col-md-4 mb-3">
                                    <label class="form-label" for="basic-icon-default-fullname" asp-for="Nationality"></label>
                                    <span class="fw-bold text-danger"> *</span>
                                    <div class="input-group input-group-merge">
                                        <span id="basic-icon-default-fullname2" class="input-group-text"><i class="bx bx-globe"></i></span>
                                        <select class="form-control" asp-for="NationalityId">
                                            @foreach (Nationality item in ViewBag.Nationality)
                                            {
                                                <option value="@item.NationalityId">@item.Name</option>
                                            }
                                        </select>
                                    </div>
                                    <span class="text-danger" asp-validation-for="NationalityId"></span>
                                </div>
                                <div class="col-sm-12 col-md-4 mb-3">
                                    <label class="form-label" for="basic-icon-default-fullname" asp-for="Gender"></label>
                                    <span class="fw-bold text-danger"> *</span>
                                    <div class="input-group input-group-merge">
                                        <select class="form-select" asp-for="Gender" onchange="showMehram(this.value)">
                                            <option value="0">Male</option>
                                            <option value="1">Female</option>
                                        </select>
                                    </div>
                                    <span class="text-danger" asp-validation-for="Gender"></span>
                                </div>
                                <div class="col-sm-12 col-md-2 mb-3">
                                    <label class="form-label" for="basic-icon-default-fullname" asp-for="BloodGroup"></label>
                                    <span class="fw-bold text-danger"> *</span>
                                    <div class="input-group input-group-merge">
                                        <span id="basic-icon-default-fullname2" class="input-group-text"><i class="bx bx-building"></i></span>
                                        <select class="form-select" asp-for="BloodGroup">
                                            <option value="">Select Blood Group...</option>
                                            <option value="A-">A-</option>
                                            <option value="A+">A+</option>
                                            <option value="B-">B-</option>
                                            <option value="B+">B+</option>
                                            <option value="AB-">AB-</option>
                                            <option value="AB+">AB+</option>
                                            <option value="O-">O-</option>
                                            <option value="O+">O+</option>
                                        </select>
                                    </div>
                                    <span class="text-danger" asp-validation-for="BloodGroup"></span>
                                </div>

                                <div class="col-sm-12 col-md-4 mb-3">
                                    <label class="form-label" for="basic-icon-default-fullname" asp-for="FiqahId"></label>
                                    <span class="fw-bold text-danger"> *</span>
                                    <div class="input-group input-group-merge">
                                        <span id="basic-icon-default-fullname2" class="input-group-text"><i class="bx bx-building"></i></span>
                                        <select class="form-select" asp-for="FiqahId">
                                            <option value="">Select Fiqah...</option>
                                            @foreach (Fiqah fiqah in ViewBag.Fiqahs)
                                            {
                                                <option value="@fiqah.FiqahId">@fiqah.Name</option>
                                            }
                                        </select>
                                    </div>
                                    <span class="text-danger" asp-validation-for="FiqahId"></span>
                                </div>


                                <div class="col-sm-12 col-md-2 mb-3">
                                    <label class="form-label" for="basic-icon-default-fullname" asp-for="IsMarried"></label>
                                    <div class="input-group input-group-merge">
                                        <div class="form-check form-check-inline">
                                            <input class="form-check-input" asp-for="IsMarried" type="checkbox">
                                            <label class="form-check-label" for="before">Yes</label>
                                        </div>

                                    </div>
                                    <span class="text-danger" asp-validation-for="IsMarried"></span>
                                </div>

                                <div class="col-sm-12 col-md-3 mb-3">
                                    <label class="form-label" for="basic-icon-default-fullname" asp-for="Residency"></label>
                                    <div class="input-group input-group-merge">
                                        <select class="form-control" asp-for="CountryId">
                                            @foreach (Country item in ViewBag.Country)
                                            {
                                                <option value="@item.CountryId">@item.Name</option>
                                            }
                                        </select>
                                    </div>
                                    <span class="text-danger" asp-validation-for="CountryId"></span>
                                </div>

                                <div class="col-sm-12 col-md-3 mb-3">
                                    <label class="form-label" for="basic-icon-default-fullname" asp-for="PassportType"></label>
                                    <div class="input-group input-group-merge">
                                        <select class="form-control" asp-for="PassportTypeId">
                                            @foreach (PassportType item in ViewBag.PassportType)
                                            {
                                                <option value="@item.PassportTypeId">@item.PassportTypeName</option>
                                            }
                                        </select>
                                    </div>
                                    <span class="text-danger" asp-validation-for="PassportTypeId"></span>
                                </div>

                                <div class="col-sm-12 col-md-3 mb-3">
                                    <label class="form-label" for="basic-icon-default-fullname" asp-for="CountryCode"></label>
                                    <div class="input-group input-group-merge">
                                        <select class="form-control" asp-for="CountryCodeId">
                                            @foreach (CountryCode item in ViewBag.CountryCode)
                                            {
                                                <option value="@item.CountryCodeId">@item.Code</option>
                                            }
                                        </select>
                                    </div>
                                    <span class="text-danger" asp-validation-for="CountryCode"></span>
                                </div>

                                <div class="col-sm-12 col-md-3 mb-3">
                                    <label class="form-label" for="basic-icon-default-fullname">City</label>
                                    <div class="input-group input-group-merge">
                                        <select class="form-control" asp-for="CityId">
                                            @foreach (City city in ViewBag.City)
                                            {
                                                <option value="@city.CityId">@city.Name</option>
                                            }
                                        </select>
                                    </div>
                                    <span class="text-danger" asp-validation-for="CityId"></span>
                                </div>

                                <div class="col-sm-12 col-md-3 mb-3">
                                    <label class="form-label" for="basic-icon-default-fullname" asp-for="PassportNumber"></label>
                                    <span class="fw-bold text-danger"> *</span>
                                    <div class="input-group input-group-merge">
                                        <input asp-for="PassportNumber" class="form-control">
                                    </div>
                                    <span class="text-danger" asp-validation-for="PassportNumber"></span>
                                </div>

                                <div class="col-sm-12 col-md-3  mb-3">
                                    <label class="form-label" for="basic-icon-default-fullname" asp-for="PassportDateOfIssue"></label>
                                    <span class="fw-bold text-danger"> *</span>
                                    <div class="input-group input-group-merge">
                                        <input asp-for="PassportDateOfIssue" class="form-control">
                                    </div>
                                    <span class="text-danger" asp-validation-for="PassportDateOfIssue"></span>
                                </div>

                                <div class="col-sm-12 col-md-3  mb-3">
                                    <label class="form-label" for="basic-icon-default-fullname" asp-for="PassportDateOfExpiry"></label>
                                    <span class="fw-bold text-danger"> *</span>
                                    <div class="input-group input-group-merge">
                                        <input asp-for="PassportDateOfExpiry" class="form-control">
                                    </div>
                                    <span class="text-danger" asp-validation-for="PassportDateOfExpiry"></span>
                                </div>

                                <div class="col-sm-12 col-md-3  mb-3">
                                    <label class="form-label" for="basic-icon-default-fullname">Hajj Department</label>
                                    <span class="fw-bold text-danger"> *</span>
                                    <div class="input-group input-group-merge">
                                        <select asp-for="HajjDepartmentId" class="form-control">
                                            @foreach(HajjDepartment department in ViewBag.HajjDepartment)
                                            {
                                                <option value="@department.HajjDepartmentId">@department.Name</option>
                                            }
                                        </select>
                                    </div>
                                    <span class="text-danger" asp-validation-for="HajjDepartmentId"></span>
                                </div>
                                <div class="col-sm-12 col-md-3 mb-3">
                                    <label class="form-label" for="basic-icon-default-fullname" asp-for="DateOfEmail"></label>
                                    <div class="input-group input-group-merge">
                                        <input type="date" asp-for="DateOfEmail" class="form-control">
                                    </div>
                                    <span class="text-danger" asp-validation-for="DateOfEmail"></span>
                                </div>
                            </div>

                            <div class="col-sm-12 mt-3">
                                <button type="submit" class="btn btn-warning float-end" id="savePassportButton">Save Changes</button>
                            </div>
                        </div>

                        <div class="tab-pane fade" id="navs-pills-justified-contact" role="tabpanel">
                            <div id="addresses">
                                <div class="row" id="address_0">
                                    <div class="col-sm-12 mb-2">
                                        <h5 class="float-start">Address</h5>
                                        <button class="btn btn-outline-info float-end" type="button" onclick="addAddress(event)">Add <i class="bx bx-add-to-queue"></i></button>
                                    </div>
                                    @foreach (CustomerPortfolioAddress address in ViewBag.AssignedAddresses)
                                    {
                                        <div class="row" id="address_@address.CustomerPortfolioAddressId">
                                            <div class="col-sm-12 col-md-3 mb-3">
                                                <label class="form-label" for="basic-icon-default-fullname" name="">Address Of</label>
                                                <span class="fw-bold text-danger"> *</span>
                                                <div class="input-group input-group-merge">
                                                    <select class="form-select" name="MemberAddressTypeIds[]">
                                                        <option value="">Select Address...</option>
                                                        @foreach (MemberAddressType at in ViewBag.AddressTypes)
                                                        {
                                                            if (at.MemberAddressTypeId == address.MemberAddressTypeId)
                                                            {
                                                                <option value="@at.MemberAddressTypeId" selected>@at.AddressType</option>
                                                            }
                                                            else
                                                            {
                                                                <option value="@at.MemberAddressTypeId">@at.AddressType</option>
                                                            }
                                                        }
                                                    </select>
                                                </div>
                                                <span class="text-danger"></span>
                                            </div>
                                            <div class="col-sm-12 col-md-6 mb-3">
                                                <label class="form-label" for="basic-icon-default-fullname" name="">Address</label>
                                                <div class="input-group input-group-merge">
                                                    <input type="text" name="MemberAddresses[]" value="@address.Address" class="form-control" placeholder="Enter Address" />
                                                </div>
                                                <span class="text-danger"></span>
                                            </div>
                                            <div class="col-sm-6 col-md-3 mb-3">
                                                <label class="form-label" for="basic-icon-default-fullname" name="">Country</label>
                                                <div class="input-group input-group-merge">
                                                    <input type="text" name="MemberAddressCountries[]" value="@address.Country" class="form-control" placeholder="Enter Country" />
                                                </div>
                                                <span class="text-danger"></span>
                                            </div>
                                            <div class="col-sm-6 col-md-3 mb-3">
                                                <label class="form-label" for="basic-icon-default-fullname" name="">City</label>
                                                <div class="input-group input-group-merge">
                                                    <input type="text" name="MemberAddressCities[]" value="@address.City" class="form-control" placeholder="Enter City" />
                                                </div>
                                                <span class="text-danger"></span>
                                            </div>

                                            <div class="col-sm-12 col-md-2 mb-3">
                                                <label class="form-label" for="basic-icon-default-fullname" name="">Po Box</label>
                                                <div class="input-group input-group-merge">
                                                    <input type="text" name="MemberAddressPoBoxes[]" value="@address.PoBox" class="form-control" placeholder="Enter Po Box" />
                                                </div>
                                                <span class="text-danger"></span>
                                            </div>
                                            <div class="col-sm-6 col-md-2 mb-3">
                                                <label class="form-label" for="basic-icon-default-fullname" name="">Zip Code</label>
                                                <div class="input-group input-group-merge">
                                                    <input type="text" name="MemberAddressZipCodes[]" value="@address.ZipCode" class="form-control" placeholder="Enter Zip Code" />
                                                </div>
                                                <span class="text-danger"></span>
                                            </div>
                                            <div class="col-sm-12 col-md-2 mb-3">
                                                <label class="form-label" for="basic-icon-default-fullname" name="">Tehsil</label>
                                                <span class="fw-bold text-danger"> *</span>
                                                <div class="input-group input-group-merge">
                                                    <select class="form-select" name="MemberAddressTehsilCodes[]">
                                                        <option value="">Select Tehsil...</option>
                                                        @foreach (Tehsil tehsil in ViewBag.Tehsils)
                                                        {
                                                            @if (tehsil.TehsilId == address.TehsilId)
                                                            {
                                                                <option value="@tehsil.TehsilId" selected>@tehsil.Code - @tehsil.Name</option>
                                                            }
                                                            else
                                                            {
                                                                <option value="@tehsil.TehsilId">@tehsil.Code - @tehsil.Name</option>
                                                            }
                                                        }
                                                    </select>
                                                </div>
                                                <span class="text-danger"></span>
                                            </div>
                                            <div class="col-sm-6 col-md-2 mb-3">
                                                <label class="form-label" for="basic-icon-default-fullname" name="">Preferred?</label>
                                                <div class="input-group input-group-merge">
                                                    <select class="form-select" name="MemberAddressPreferred[]">
                                                        @if (address.Preferred)
                                                        {
                                                            <option value="true" selected>Yes</option>
                                                            <option value="false">No</option>
                                                        }
                                                        else
                                                        {
                                                            <option value="true">Yes</option>
                                                            <option value="false" selected>No</option>
                                                        }
                                                    </select>
                                                </div>
                                            </div>

                                            <div class="col-sm-12 col-md-1" style="display:flex;flex-direction: column;justify-content: center;flex-wrap: wrap;align-content: center;">
                                                <label class="form-label"></label>
                                                <button type="button" class="btn btn-icon btn-danger" onclick="removeAddress(@address.CustomerPortfolioAddressId)"><i class='bx bxs-trash'></i></button>
                                            </div>
                                            <hr />
                                        </div>
                                    }

                                </div>
                            </div>

                            <div id="contacts">
                                <div class="row mt-2" id="contact_0">
                                    <div class="col-sm-12 mb-2 ">
                                        <h5 class="float-start">Contact</h5>
                                        <button class="btn btn-outline-info float-end" type="button" onclick="addContact(event)">Add <i class="bx bx-add-to-queue"></i></button>
                                    </div>
                                    @foreach (CustomerPortfolioContact contact in ViewBag.AssignedContacts)
                                    {
                                        <div class="row" id="contact_@contact.CustomerPortfolioContactId">
                                            <div class="col-sm-12 col-md-3 mb-3">
                                                <label class="form-label" for="basic-icon-default-fullname" name="">Contact Type</label>
                                                <span class="fw-bold text-danger"> *</span>
                                                <div class="input-group input-group-merge">
                                                    <select class="form-select" name="MemberContactTypeIds[]">
                                                        <option value="">Select Contact Type...</option>
                                                        @foreach (MemberContactType ct in ViewBag.ContactTypes)
                                                        {
                                                            if (ct.MemberContactTypeId == contact.MemberContactTypeId)
                                                            {
                                                                <option selected value="@ct.MemberContactTypeId">@ct.ContactType</option>
                                                            }
                                                            else
                                                            {
                                                                <option value="@ct.MemberContactTypeId">@ct.ContactType</option>
                                                            }
                                                        }
                                                    </select>
                                                </div>
                                                <span class="text-danger"></span>
                                            </div>
                                            <div class="col-sm-12 col-md-6 mb-3">
                                                <label class="form-label" for="basic-icon-default-fullname" name="">Contact</label>
                                                <span class="fw-bold text-danger"> *</span>
                                                <div class="input-group input-group-merge">
                                                    <input type="text" value="@contact.Contact" name="MemberContacts[]" class="form-control" placeholder="Enter Contact" />
                                                </div>
                                                <span class="text-danger"></span>
