                                                                                                                                                            <input type="text" name="MemberAddressCities[]" class="form-control" placeholder="Enter City" />
                                                                                                                                                        </div>
                                                                                                                                                        <span class="text-danger"></span>
                                                                                                                                                    </div>

                                                                                                                                                    <div class="col-sm-12 col-md-2 mb-3">
