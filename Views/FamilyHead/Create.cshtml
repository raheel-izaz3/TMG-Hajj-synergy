    function addContact() {

        let id = Date.now()
        let rootNode = document.getElementById("contacts");

        let row = document.createElement("DIV");
        row.classList.add("row");
        row.setAttribute("id", "contact_" + id);

        rootNode.appendChild(row);

        let colContactType = document.createElement("DIV");
        let colContact = document.createElement("DIV");
        let colDelete = document.createElement("DIV");
        let colPreferred = document.createElement("DIV");
        let hr = document.createElement("HR");

        colContactType.classList.add("col-sm-12", "col-md-3", "mb-3");
        colContact.classList.add("col-sm-12", "col-md-6", "mb-3");
        colDelete.classList.add("col-sm-12", "col-md-1", "mb-3", "d-flex", "justify-content-center", "align-items-end");
        colPreferred.classList.add("col-sm-12", "col-md-2", "mb-3");

        colContactType.innerHTML = `
                                                                                                                                <label class="form-label" for="basic-icon-default-fullname" name="">Contact Type</label>
                                                                                                                                <div class="input-group input-group-merge">
                                                                                                                                    <select class="form-select" name="MemberContactTypeIds[]">
                                                                                                                                        <option value="">Select Contact Type...</option>
    @foreach (MemberContactType ma in ViewBag.ContactTypes)
    {
                                                                                                                                                                                                                                                                        <option value="@ma.MemberContactTypeId">@ma.ContactType</option>
    }
                                                                                                                                    </select>
                                                                                                                                </div>
                                                                                                                                `;

        colContact.innerHTML = `
                                                                                                                                <label class="form-label" for="basic-icon-default-fullname" name="">Contact</label>
                                                                                                                                <div class="input-group input-group-merge">
                                                                                                                                    <input type="text" name="MemberContacts[]" class="form-control" placeholder="Enter Contact" />
                                                                                                                                </div>
                                                                                                                                <span class="text-danger"></span>`;

        colPreferred.innerHTML = `
                                                                                                                                <label class="form-label" for="basic-icon-default-fullname" name="">Preferred</label>
                                                                                                                                <div class="input-group input-group-merge">
                                                                                                                                        <select class="form-select" name="MemberContactPreferred[]">
                                                                                                                                        <option value="true">Yes</option>
                                                                                                                                        <option value="false" selected>No</option>
                                                                                                                                    </select>
                                                                                                                                </div>
                                                                                                                                `;


        colDelete.innerHTML = `
                                                                                                                                <button type="button" class="btn btn-icon btn-danger" onclick="removeContact(${id})"><i class="bx bx-trash"></i></button>
                                                                                                                                `;

        row.appendChild(colContactType);
        row.appendChild(colContact);
        row.appendChild(colPreferred);
        row.appendChild(colDelete);
        row.appendChild(hr);

    }
    function removeContact(id) {
        document.getElementById("contact_" + id).remove();
    }

    function addEmail() {
        let rootNode = document.getElementById("emails");
        let id = Date.now()
        let row = document.createElement("DIV");
        row.classList.add("row");
        row.setAttribute("id", "email_" + id);

        rootNode.appendChild(row);


        let colEmailType = document.createElement("DIV");
        let colEmail = document.createElement("DIV");

        let colPreferred = document.createElement("DIV");
        let colDelete = document.createElement("DIV");
        let hr = document.createElement("HR");

        colEmailType.classList.add("col-sm-12", "col-md-3", "mb-3");
        colEmail.classList.add("col-sm-12", "col-md-6", "mb-3");
        colDelete.classList.add("col-sm-12", "col-md-1", "mb-3", "d-flex", "justify-content-center", "align-items-end");
        colPreferred.classList.add("col-sm-12", "col-md-2", "mb-3");

        colEmailType.innerHTML = `
                                                                                                                                <label class="form-label" for="basic-icon-default-fullname" name="">Email Type</label>
                                                                                                                                <div class="input-group input-group-merge">
                                                                                                                                        <select class="form-select" name="MemberEmailTypeIds[]">
                                                                                                                                        <option value="">Select Email Type...</option>
    @foreach (MemberEmailType ma in ViewBag.EmailTypes)
    {
                                                                                                                                                                                                                                                                        <option value="@ma.MemberEmailTypeId">@ma.EmailType</option>
    }
                                                                                                                                    </select>
                                                                                                                                </div>
                                                                                                                                <span class="text-danger"></span>
                                                                                                                                `;

        colEmail.innerHTML = `
                                                                                                                                <label class="form-label" for="basic-icon-default-fullname" name="">Email</label>
                                                                                                                                <div class="input-group input-group-merge">
                                                                                                                                    <input type="text" name="MemberEmails[]" class="form-control" placeholder="Enter Email Address" />
                                                                                                                                </div>
                                                                                                                                <span class="text-danger"></span>
                                                                                                                                `;

        colPreferred.innerHTML = `
                                                                                                                                <label class="form-label" for="basic-icon-default-fullname" name="">Preferred</label>
                                                                                                                                <div class="input-group input-group-merge">
                                                                                                                                    <select class="form-select" name="MemberEmailPreferred[]">
                                                                                                                                        <option value="true">Yes</option>
                                                                                                                                        <option value="false" selected>No</option>
                                                                                                                                    </select>
                                                                                                                                </div>
                                                                                                                                `;


        colDelete.innerHTML = `
                                                                                                                                <button type="button" class="btn btn-icon btn-danger" onclick="removeEmail(${id})"><i class="bx bx-trash"></i></button>
                                                                                                                                `;

        row.appendChild(colEmailType);
        row.appendChild(colEmail);
        row.appendChild(colPreferred);
        row.appendChild(colDelete);
        row.appendChild(hr);
    }
    function removeEmail(id) {
        document.getElementById("email_" + id).remove();
    }


    function showMehram(val) {
        if (val == "0") {
            document.getElementById("MehramCNIC").setAttribute('disabled', 'true')
            document.getElementById("SearchMehramButton").setAttribute('disabled', 'true')
            document.getElementById("RelationWithMehramId").setAttribute('disabled', 'true')
        }
        else if (val == "1") {
            document.getElementById("MehramCNIC").removeAttribute('disabled')
            document.getElementById("SearchMehramButton").removeAttribute('disabled')
            document.getElementById("RelationWithMehramId").removeAttribute('disabled')
        }
    }

    function getTransport(id) {
        if (id != '') {
            $.ajax({
                url: "/Package/GetTransport/" + id,
                method: "GET",
                success: res => {
                    console.log(res)
                    let html = ``
                    const transportDiv = document.getElementById("transports")

                    let x = 0;
                    for (let route of res) {
                        html += `
                                               <input type="hidden" name="RouteIds[${x}]" value="${route.routeId}">
                                                                <div class="col-sm-12 col-md-2 mb-3">
                                                                    <label class="form-label">Route</label>
                                                                    <div class="input-group input-group-merge">
                                                                                <span class="mx-2 mt-2 fw-bold">${route.route.startPlace} To ${route.route.destination}</span>
                                                                    </div>
                                                                </div>
                                                                <div class="col-sm-12 col-md-2 mb-3">
                                                                    <label class="form-label" >Check In</label>
                                                                    <div class="input-group input-group-merge">
                                                                        <input class="form-control" type="date" name="CheckIns[${x}]">
                                                                    </div>
                                                                </div>
                                                                <div class="col-sm-12 col-md-2 mb-3">
                                                                    <label class="form-label" >Check Out</label>
                                                                    <div class="input-group input-group-merge">
                                                                            <input class="form-control" type="date" name="CheckOuts[${x}]">
                                                                    </div>
                                                                </div>

                                                                <div class="col-sm-12 col-md-2 mb-3">
                                                                    <label class="form-label" >Time In</label>
                                                                    <div class="input-group input-group-merge">
                                                                            <input class="form-control" name="TimeIns[${x}]">
                                                                    </div>
                                                                    <span class="text-danger"></span>
                                                                </div>
                                                                <div class="col-sm-12 col-md-2 mb-3">
                                                                    <label class="form-label" >Time Out</label>
                                                                    <div class="input-group input-group-merge">
                                                                            <input class="form-control" name="TimeOuts[${x}]">
                                                                    </div>
                                                                    <span class="text-danger"></span>
                                                                </div>

                                                                <div class="col-sm-12 col-md-2 mb-3">
                                                                    <label class="form-label" >Vehicle</label>
                                                                    <div class="input-group input-group-merge">
                                                                            <select class="form-select" name="VehicleIds[${x}]">
                                                                            <option value="">Select Vehicle...</option>
    @foreach (Vehicle v in ViewBag.Vehicles)
    {
                                                                                                    <option value="@v.VehicleId">@v.VehicleType</option>
    }
                                                                        </select>
                                                                    </div>
                                                                </div>

                                        `
                        x++;
                    }

                    transportDiv.innerHTML = html
                },
                error: err => {
                    console.log(err)
                }
            })
        }
    }

    function getFlightClass(id) {
        $.ajax({
            url: `/FamilyHead/GetFlightClass/${id}`,
            method: "GET",
            success: res => {
                console.log(res)
                document.querySelector("#FlightClass").value = res
            },
            error: err => {
                console.log(err)
            }
        })
    }

    function getPackageROE(id) {
        $.ajax({
            url: `/FamilyHead/GetPackageROE/${id}`,
            method: "GET",
            success: res => {
                console.log(res)
                document.querySelector("#USDROE").value = res.usdroe
                document.querySelector("#SARROE").value = res.sarroe
            },
            error: err => {
                console.log(err)
            }
        })
    }
    function getPackagePOD(id) {
        $.ajax({
            url: `/FamilyHead/GetPOD/${id}`,
            method: "GET",
            success: res => {
                console.log(res)
                document.querySelector("#POD").value = res.pod
            },
            error: err => {
                console.log(err)
            }
        })
    }
</script>


