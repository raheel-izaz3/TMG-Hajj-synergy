                            <div class="tab-pane fade" id="navs-pills-justified-sector" role="tabpanel">
                                <div id="sectors">
                                    <div class="row" id="address_0">
                                        <div class="col-sm-12 mb-2">
                                            <h5 class="float-start">Sector</h5>
                                            <button class="btn btn-outline-info float-end" type="button"
                                                onclick="addSector(event)">Add <i
                                                    class="bx bx-add-to-queue"></i></button>
                                        </div>
                                        <hr />
                                    </div>
                                    @foreach (Sector s in ViewBag.Sectors)
                                    {
                                        <div class="row" id="sector_@s.SectorId">

                                            <div class="col-sm-12 col-md-2 mb-3">
                                                <label class="form-label">FlightNo</label>
                                                <div class="input-group input-group-merge">
                                                    <input class="form-control" value="@s.FlightNo"
                                                           placeholder="FlightNo..." name="FlightNo[]">
                                                </div>
                                            </div>


                                            <div class="col-sm-12 col-md-2 mb-3">
                                                <label class="form-label">Type</label>
                                                <div class="input-group input-group-merge">
                                                    <select name="FlightTypes[]" class="form-control">
                                                        @if (s.FlightType == FlightType.Inbound)
                                                        {
                                                            <option value="1">Outbound</option>
                                                            <option value="0" selected>Inbound</option>
                                                        }
                                                        else
                                                        {
                                                            <option value="1" selected>Outbound</option>
                                                            <option value="0">Inbound</option>
                                                        }
                                                    </select>
                                                </div>
                                            </div>


                                            <div class="col-sm-12 col-md-2 mb-3">
                                                <label class="form-label">Destination</label>
                                                <div class="input-group input-group-merge">
                                                    <input class="form-control" placeholder="Destination..."
                                                        value="@s.Destination" name="Destinations[]">
                                                </div>
                                            </div>

                                            <div class="col-sm-12 col-md-3 mb-3">
                                                <label class="form-label">Departure</label>
                                                <div class="input-group input-group-merge">
                                                    <input class="form-control"
                                                        value="@DateTimeManager.DateTimeToHtmlFormat(s.DepartureDateTime)"
                                                        type="datetime-local" name="SectorDepartures[]">
                                                </div>
                                            </div>

                                            <div class="col-sm-12 col-md-2 mb-3">
                                                <label class="form-label">Arrival</label>
                                                <div class="input-group input-group-merge">
                                                    <input class="form-control" type="datetime-local"
                                                        value="@DateTimeManager.DateTimeToHtmlFormat(s.ArrivalDateTime)"
                                                        name="SectorArrivals[]">
                                                </div>
                                            </div>

                                            <div class="col-sm-12 col-md-1"
                                                style="display:flex;flex-direction: column;justify-content: center;flex-wrap: wrap;align-content: center;">
                                                <label class="form-label"></label>
                                                <button type="button" class="btn btn-icon btn-danger"
                                                    onclick="removeSector(@s.SectorId)">
                                                    <i class='bx bxs-trash'></i>
                                                </button>
                                            </div>
                                            <hr>
                                        </div>
                                    }

                                </div>
                                <div class="row">
                                    <div class="col-sm-12 mb-3">
                                        <button type="submit" class="btn btn-warning float-end">Save Changes</button>
                                    </div>
                                </div>
                            </div>

