<script>
    function onCapacityInput(elem) {


    }

    function checkCapacities() {
        let economySeats = document.querySelector(`#EconomySeats`).valueAsNumber
        let businessSeats = document.querySelector(`#BusinessSeats`).valueAsNumber

        const economyInputs = document.querySelectorAll(`[data-pnr-type="0"]`)
        const businessInputs = document.querySelectorAll(`[data-pnr-type="1"]`)

        let ecoTotal = 0;
        let busiTotal = 0;
        if (economyInputs.length > 0) {
            for (let e of economyInputs) {
                ecoTotal += parseInt(e.value)
            }
        }
        if (businessInputs.length > 0) {
            for (let e of businessInputs) {
                busiTotal += parseInt(e.value)
            }
        }
        let valid = economySeats == ecoTotal && businessSeats == busiTotal;

        if (!valid) alert("Seats Count do not match")

        return valid
    }

    function onTypeSelect(elem) {
        let val = elem.value
        let id = elem.getAttribute('data-pnr-type-id')

        const input = document.querySelector(`#Capacity_${id}`)

        input.setAttribute('data-pnr-type', val)
    }
