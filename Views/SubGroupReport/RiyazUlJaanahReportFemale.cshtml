@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hotel-Summary</title>
    <!-- Jquery  -->
    <script src="https://code.jquery.com/jquery-1.11.3.min.js"></script>

    <!-- Data Tables.min.js  -->
    <script type="text/javascript"
            src="https://cdn.datatables.net/v/dt/jszip-2.5.0/dt-1.10.16/b-1.5.1/b-colvis-1.5.1/b-html5-1.5.1/b-print-1.5.1/fh-3.1.3/datatables.min.js"></script>

    <!-- DataTable min.css -->
    <link rel="stylesheet" type="text/css"
          href="https://cdn.datatables.net/v/dt/jszip-2.5.0/dt-1.10.16/b-1.5.1/b-colvis-1.5.1/b-html5-1.5.1/b-print-1.5.1/fh-3.1.3/datatables.min.css" />

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        div#example_filter {
            margin-bottom: 10px;
        }

        body {
            width: 100vw;
            height: 100vh;
            /* overflow-x: hidden; */
            font-family: monospace;
            /* font-family: sans-serif; */
        }

        h1,
        h2,
        h3,
        h4,
        h5,
        h6,
        p {
            padding: 0;
            margin: 0;
        }

        table {
            border-collapse: collapse;
            width: 100%;
            /* border: none; */
        }

            table th {
                /* border: 1px solid #fedf7b !important; */
                padding: 3px 4px !important;
                font-size: 10px !important;
                /* width: fit-content !important; */
                text-align: center !important;
                background-color: #f6f3ee !important;
                color: #b49164;
                font-weight: bold;
                border: 1px solid #b49164 !important;
            }

            table td {
                font-size: 8px !important;
                /* outline: 1px solid #fedf7b; */
                /* border: 1px solid #fedf7b; */
                padding: 5px 2px !important;
                margin: 0 !important;
                text-align: center;
                border: 1px solid #b0872e;
            }



        caption {
            background-color: #b0872e;
            color: white;
            padding: 7px;
            font-size: 18px !important;
        }


        table.dataTable thead .sorting {
            background-image: none !important;
        }

        th.sorting {
            /* background: none !important; */
            /* border: none !important; */
        }

        .check-box {
            display: flex;
            justify-content: left;
            align-items: center;
            flex-wrap: wrap;
        }

        @@media print {

            label,
            input {
                display: none;
            }
        }

        label {
            font-size: 9px !important;
        }

        .check-box input {
            width: 20px;
        }

        .check-box {
            margin: 10px 0;
        }
    </style>



</head>

<body>

    <h1 style="text-align: center; margin-bottom: 30px;">Riaz-Ul-Jannah Sub Group Report</h1>

    @{
        var femalecount = 0;
        var malecount = 0;

    }
    <div class="myTable" style="margin-bottom: 30px;" id="summaryData">
        <table id="roomData" class="display nowrap" style="width: 100%;">
            <div style="background-color: #b49164; color: white; padding: 6px;">
                <p style="text-align: center; ">@ViewBag.MunazzimName</p>
                <p style="text-align: center; ">@ViewBag.SubGroupName</p>
            </div>
            <thead>
            <th>Sr #</th>
            <th>FCID</th>
            <th>CID</th>
            <th>Company</th>
            <th>Package</th>
            <th>PNR Name</th>
            <th>ArrivalDateTime</th>

            <th>Image </th>
            <th>Name </th>
            <th>Gender </th>
            <th>Passport </th>
            <th>EHajj Id </th>
            <th>Mofa Number</th>
            <th>Visa Number</th>

            </thead>
            <tbody>

                @foreach (var row in ViewBag.report)
                {
                    <tr>
                        <td>@row.SerialNumber</td>
                        <td>@row.FCid</td>
                        <td>@row.CID</td>
                        <td>@row.CompanyName</td>
                        <td>@row.PackageName</td>
                        <td>@row.PNRName</td>
                        <td>@row.ArrivalDateTime</td>

                        <td><img src="~/@row.Image" width="30" /></td>
                        <td>@row.Name</td>
                        <td>@row.Gender</td>
                        <td>@row.Passport</td>
                        <td>@row.EHajjId</td>
                        <td>@row.MofaNumber</td>
                        <td>@row.VisaNumber</td>
                    </tr>
                    @if (row.Gender != null && row.Gender.ToString() == "Female")
                    {
                        femalecount = femalecount + 1;
                    }
                    else
                    {
                        malecount = malecount + 1;
                    }
                }
            </tbody>
            <tfoot>
                <tr>

                    <td colspan="3"></td>
                   @*  <td colspan="1">Male :@malecount</td> *@
                     <td colspan="1">Female :@femalecount</td>
                    <td colspan="3"></td>
                </tr>
            </tfoot>
        </table>
    </div>
