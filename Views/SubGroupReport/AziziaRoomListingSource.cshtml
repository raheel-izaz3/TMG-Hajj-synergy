@model RoomListingModel

@{
    Layout = "_PrintReportLayout";
}
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<style>
    @@media print {
        .hideInPrint {
            display: none;
        }

        @@page {
            size: A4;
            margin: .2cm;
            zoom: 80%;
        }
    }
</style>

<a asp-controller="SubGroup" asp-action="Index" class="btn btn-primary text-white m-2 hideInPrint">Back To Dashboard</a>
<button onclick="document.memberForm.submit()" class="btn btn-success m-2 hideInPrint">Save</button>
<div class="container-fluid mt-3">

    <h5 class="text-center"><u>@Model.Company</u></h5>
    @* <p class="text-center mb-0"><u>(MUNAZZIM# 2712) [HP# 4187/K]</u></p> *@
    <p class="text-center mb-0"><u>Sub Group: @Model.SubGroup</u></p>
    <p class="text-center mb-0 fw-bold">Report</p>

    <p class="text-center mt-1"><u>Group: @Model.Group</u></p>

    <hr class="my-3">

    <form action="/SubGroupReport/Save/@Model.SubGroupId" name="memberForm" method="post">
        <table style="width: 100%" class="table-bordered">
            <thead>
                <tr >
                    <th class="text-center">#</th>
                    <th class="text-center">Company</th>
                    <th class="text-center">Package</th>
                    <th class="text-center">Group</th>
                    <th class="text-center">Room Type</th>
                    <th class="text-center">HB #</th>
                    <th class="text-center">Name</th>
                    <th class="text-center">Age</th>
                    <th class="text-center">Gender</th>
                    <th class="text-center">Passport</th>
                    <th class="text-center">Floor #</th>
                    <th class="text-center">Room #</th>
                    <th class="text-center">Stay With</th>
                    <th class="text-center">Floor # Connection</th>
                    <th class="text-center">Room #</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Members)
                {
                    <input type="hidden" id="packageid" value="@item.PackageId" />
                    <input type="hidden" name="FamilyHeadIds[]" value="@item.FamilyHeadId">
                    <input type="hidden" name="RoomIds[]" value="@item.RoomId">
                    <tr style="border-top: @(item.IsHead ? "4px solid black" : "");">
                        <td class="text-center">@item.SNo</td>
                        <td class="text-center">@item.Company</td>
                        <td class="text-center">@item.Package</td>
                        <td class="text-center">@item.Group</td>
                        <td class="text-center">@item.RoomType</td>
                        <td class="text-center">@item.FcId</td>
                        <td class="text-center">@item.Name</td>
                        <td class="text-center">@item.Age</td>
                        <td class="text-center">@item.Gender</td>
                        <td class="text-center">@item.Passport</td>
                        <td class="text-center">
                            <select class="form-control" id="StayFloorNumbers[]" name="StayFloorNumbers[]"
                                onchange="getRooms(this.value,@item.SNo)">
                                <option value="0">Select Floor</option>
                                @if (ViewBag.floorNumber != null)
                                {
                                    @foreach (var item1 in ViewBag.floorNumber)
                                    {
                                        @if(item1 == item.FloorNumber){
                                            <option selected value="@item1">@item1</option>
                                        }else{
                                            <option value="@item1">@item1</option>
                                        }
                                    }
                                }

                            </select>

                        </td>
                        <td class="text-center">
                            <select class="form-control" id="select-room[@item.SNo]" name="StayRoomNumbers[]"
                                onchange="checkRoomPax(this)">
                                <option value="">Select a Room...</option>
                                @if(item.FloorRoomId is not null){
                                    <option selected value="@item.FloorRoomId" data-pax="@item.RoomNumberPax">@item.RoomNumberWithCode</option>
                                }
                            </select>
                        </td>
                        <td class="text-center">
                            @item.StayWith
                        </td>
                        <td class="text-center">
                            <input style="width: 100px" type="text" name="ConnectedFloorNumbers[]"
                                value="@item.ConnectedFloorNumber">
                        </td>
                        <td class="text-center">
                            <input style="width: 100px" type="text" name="ConnectedRoomNumbers[]"
                                value="@item.ConnectedRoomNumber">
                        </td>
                    </tr>
                }

            </tbody>
        </table>
    </form>

    <h5 class="text-center mt-4"><u>Room Summary</u></h5>
    <div class="row">
        <div class="col-sm-6">
            <table class="table">
                <tr>
                    <th class="border-bottom text-center" colspan="3">
                        Total Members: @Model.MemberSummary.TotalMembers
                    </th>
                </tr>
                <tr>
                    <th class="text-center" colspan="3">Male: @Model.MemberSummary.MaleCount</th>
                </tr>
                <tr>
                    <td class="text-center">Adult: @Model.MemberSummary.AdultMales</td>
                    <td class="text-center">Child: @Model.MemberSummary.ChildMales</td>
                    <td class="text-center">Infant: @Model.MemberSummary.InfantMales</td>
                </tr>
                <tr>
                    <th class="text-center" colspan="3">Female: @Model.MemberSummary.FemaleCount</th>
                </tr>
                <tr>
                    <td class="text-center">Adult: @Model.MemberSummary.AdultFemales</td>
                    <td class="text-center">Child: @Model.MemberSummary.ChildFemales</td>
                    <td class="text-center">Infant: @Model.MemberSummary.InfantFemales</td>
                </tr>
            </table>
        </div>

        <div class="col-sm-6">
            <table class="table">
                <tr>
                    <th class="border-bottom text-center" colspan="3">Total Rooms</th>
                </tr>
                @foreach (var room in Model.Rooms)
                {
                    <tr>
                        <td><b>@room.RoomCode:</b> @room.Quantity</td>
                    </tr>
                }
            </table>
        </div>
    </div>
</div>

<script>
    let colorMap = {};

    function getRandomLightColor() {
        let color;
        do {
            const r = Math.floor(Math.random() * 156) + 100; 
            const g = Math.floor(Math.random() * 156) + 100; 
            const b = Math.floor(Math.random() * 156) + 100; 

            color = "#" + r.toString(16) + g.toString(16) + b.toString(16);
        } while (Object.values(colorMap).includes(color)); 

        return color;
    }



    function checkRoomPax(elem) {
        let roomPax = elem.selectedOptions[0].getAttribute('data-pax')
        let floorRoomId = elem.selectedOptions[0].value
        console.log(roomPax, floorRoomId)

        let allSelectedFloorRoomOptions = document.querySelectorAll(`option:checked[value="${floorRoomId}"]`)
        console.log(allSelectedFloorRoomOptions)

        if (allSelectedFloorRoomOptions.length > roomPax) {
            elem.selectedOptions[0].selected = false
            alert("Room Capacity Exceeded")
            
            elem.style.backgroundColor = "#fff";
            elem.style.color = "#000";
            selectedOption.style.backgroundColor = "#fff";
            
        }
        else {
            console.log("room left: " + (roomPax - allSelectedFloorRoomOptions.length))
            const selectedOption = elem.options[elem.selectedIndex];
            const optionValue = elem.value;
            let randomColor = colorMap[optionValue];
            if (!randomColor) {
                randomColor = getRandomLightColor();
                colorMap[optionValue] = randomColor;
            }

            elem.style.backgroundColor = randomColor;
            elem.style.color = "#000";
            selectedOption.style.backgroundColor = randomColor;
        }

    }

    function getRooms(val, sno) {
        if (val != '') {
            $.ajax({
                url: "/SubGroupReport/GetRooms",
                method: "GET",
                data: {
                    floorNumber: val,
                    hotelId: @ViewBag.HotelId
                },
                success: res => {
                    console.log(res)
                    const pack = document.getElementById('select-room[' + sno + ']');
                    let html = '<option value="">Select a Room...</option>'
                    for (let r of res) {
                        html += `<option value="${r.floorRoomId}" data-pax="${r.pax}">${r.roomCode}</option>`
                    }
                    pack.innerHTML = html
                },
                error: err => {
                    console.log(err)
                }
            })
        }
    }
