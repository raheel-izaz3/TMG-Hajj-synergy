@model MemberContactType


@{
    string modelName = "Member Contact";
    string modelNamePlural = "Member Contacts";
    string modelControllerRoute = "MemberContactType";
    TMG.Data.TMGDbContext _db;
}


<div class="container-xxl flex-grow-1 container-p-y">
    <h4 class="fw-bold" style="color:  #404040;"><span class="text-muted fw-light"> @modelName / </span>  Edit</h4>

    <hr class="mb-4" />

    <div class="row">
        <div class="col-sm-12">
            <div class="card mb-4">
                <div class="card-body">
                    <form method="post">
                        <input type="hidden" asp-for="MemberContactTypeId">
                        <div class="row">
                            <div class="col-sm-12 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname" asp-for="ContactType"></label>
                                <div class="input-group input-group-merge">
                                    <span id="basic-icon-default-fullname2" class="input-group-text"><i class="bx bx-cog"></i></span>
                                    <input asp-for="ContactType" class="form-control" id="basic-icon-default-fullname" placeholder="Enter Role Name..." aria-describedby="basic-icon-default-fullname2">
                                </div>
                                <span class="text-danger" asp-validation-for="ContactType"></span>
                            </div>

                        </div>

                        <button type="submit" class="btn btn-warning float-end">Save Changes</button>
                    </form>
                </div>
            </div>

        </div>
    </div>

</div>