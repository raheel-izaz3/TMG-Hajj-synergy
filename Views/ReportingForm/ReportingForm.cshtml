        }




        .report-table {
            width: 100%;
            border-collapse: collapse;
        }

            .report-table th {
            }

            .report-table th,
            td {
                border: 1px solid black;
                text-align: left;
                padding: 5px 5px;
                font-size: 13px;
            }

        .govt-logo img {
            width: 70px;
            height: 70px;
        }

        .office-report-heading {
            text-align: center;
            line-height: 1.1;
            /* margin-top: 5px; */
        }

            .office-report-heading h3 {
                /* line-height: 40px; */
                margin: 4px;
                padding: 0px;
                font-size: 14px;
                /* font-weight: 500; */
            }

        .first-section-titile {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .report-table td:first-child {
            text-align: center;
            font-family: 'Times New Roman', Times, serif;
            font-size: 14px;
        }

        .hujjaj_arrived-table {
            border-collapse: collapse;
            width: 100%;
        }



            .hujjaj_arrived-table th td {
                font-size: 14px;
            }

            .hujjaj_arrived-table td:first-child {
                text-align: center;
            }

        .filled-form {
            margin: 0;
            padding: 0;
        }
    </style>
</head>


