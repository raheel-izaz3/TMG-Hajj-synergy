@using TMG.Models.Updated_Accounts
@model TMG.Models.Updated_Accounts.Tax

@{
    string modelName = "Tax";
    string modelNamePlural = "Taxes";
    string modelControllerRoute = "Tax";
}

<div class="container-xxl flex-grow-1 container-p-y">
    <h4 class="fw-bold" style="color: #404040;"><span class="text-muted fw-light"> @modelName / </span> Edit</h4>

    <hr class="mb-4" />

    <div class="row">
        <div class="col-sm-12">
            <div class="card mb-4">
                <div class="card-body">
                    <form method="post" asp-action="Edit">
                        <input hidden asp-for="TaxId" />
                        <div class="row">
                            <div class="col-sm-12 col-md-6 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname" asp-for="TaxName">Tax Name</label>
                                <div class="input-group input-group-merge">
                                    <span id="basic-icon-default-fullname2" class="input-group-text"><i class="bx bx-building"></i></span>
                                    <input asp-for="TaxName" class="form-control" value="@Model.TaxName">
                                </div>
                                <span class="text-danger" asp-validation-for="TaxName"></span>
                            </div>
                            <div class="col-sm-12 col-md-3 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname" asp-for="TaxTypes">Tax Type</label>
                                <div class="input-group input-group-merge">
                                    <span id="basic-icon-default-fullname2" class="input-group-text"><i class="bx bx-building"></i></span>
                                    <select class="form-control" asp-for="TaxTypes" asp-items="@Html.GetEnumSelectList<TaxType>()">
                                        <option disabled selected>Select Tax Type</option>
                                    </select>
                                </div>
                                <span class="text-danger" asp-validation-for="TaxTypes"></span>
                            </div>
                            <div class="col-sm-12 col-md-3 mt-5">
                                <div class="form-check mt-2">
                                    <input class="form-check-input" type="checkbox" asp-for="IsClaimable" id="isClaimable" checked="@Model.IsClaimable">
                                    <label class="form-check-label" asp-for="IsClaimable">
                                        Claimable Tax
                                    </label>
                                </div>
                                <span class="text-danger" asp-validation-for="IsClaimable"></span>
                            </div>
                            <div class="col-sm-12 mt-4">
                                <button type="submit" class="btn btn-success float-end">Save</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
