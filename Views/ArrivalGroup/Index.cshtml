@model IEnumerable<TMG.Models.ArrivalGroupModels.ArrivalGroupIndexItemViewModel>

@{
    ViewData["Title"] = "Arrival Groups";
    int count = 1;
}

<div class="container-xxl flex-grow-1 container-p-y">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bx bx-check-circle me-1"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <h4 class="fw-bold m-0"><i class="bx bx-group text-primary me-2"></i>Arrival Groups</h4>
                <small class="text-muted">Manage isolated flight arrival groups and passenger assignments</small>
            </div>
            <div class="d-flex align-items-center gap-2">
                <form method="get" asp-action="Index" class="d-flex align-items-center">
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="bx bx-search"></i></span>
                        <input type="text" name="search" class="form-control" placeholder="Search groups, PNR, flight..." value="@ViewData["CurrentSearch"]" />
                        @if (!string.IsNullOrEmpty((string)ViewData["CurrentSearch"]))
                        {
                            <a asp-action="Index" class="btn btn-outline-secondary"><i class="bx bx-x"></i></a>
                        }
                        <button type="submit" class="btn btn-secondary">Search</button>
                    </div>
                </form>
                <a asp-action="Create" class="btn btn-primary text-nowrap">
                    <i class="bx bx-plus me-1"></i> Add Arrival Group
                </a>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive text-nowrap">
                <table class="table table-hover align-middle mb-0" id="arrivalGroupsTable">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 60px;">S:NO</th>
                            <th>Group Name</th>
                            <th>Airline / Flight</th>
                            <th>Flight Date & Time</th>
                            <th>PNR</th>
                            <th>Route (From - To)</th>
                            <th class="text-center">Passengers</th>
                            <th class="text-center" style="width: 140px;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="8" class="text-center py-4 text-muted">
                                    <i class="bx bx-folder-open display-6 d-block mb-2 text-secondary"></i>
                                    No arrival groups found for the active season.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="fw-bold">@(count++)</td>
                                    <td>
                                        <span class="fw-semibold text-dark">@item.GroupName</span>
                                    </td>
                                    <td>
                                        <div><i class="bx bx-paper-plane text-primary me-1"></i> @item.AirlineName</div>
                                        <small class="text-muted">Flight #: @item.FlightNumber</small>
                                    </td>
                                    <td>
                                        <div><i class="bx bx-calendar me-1"></i> @(item.FlightArrivalDate?.ToString("dd-MMM-yyyy") ?? "N/A")</div>
                                        @if (!string.IsNullOrEmpty(item.FlightArrivalTime))
                                        {
                                            <small class="text-muted"><i class="bx bx-time-five me-1"></i> @item.FlightArrivalTime</small>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge bg-label-info font-monospace">@item.PNRNumber</span>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.DepartureCity) || !string.IsNullOrEmpty(item.ArrivalCity))
                                        {
                                            <span>@(string.IsNullOrEmpty(item.DepartureCity) ? "N/A" : item.DepartureCity) <i class="bx bx-right-arrow-alt text-muted mx-1"></i> @(string.IsNullOrEmpty(item.ArrivalCity) ? "N/A" : item.ArrivalCity)</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">N/A</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <span class="badge rounded-pill bg-primary px-3 py-2 fs-6">
                                            <i class="bx bx-user me-1"></i> @item.PassengerCount Pax
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <div class="d-inline-flex gap-1">
                                            <!-- View Manifest -->
                                            <a asp-action="Details" asp-route-id="@item.Id"
                                               class="btn btn-sm btn-icon btn-outline-info"
                                               data-bs-toggle="tooltip"
                                               data-bs-placement="top"
                                               title="View Manifest">
                                                <i class="bx bx-list-ul"></i>
                                            </a>

                                            <!-- Edit -->
                                            <a asp-action="Edit" asp-route-id="@item.Id"
                                               class="btn btn-sm btn-icon btn-outline-warning"
                                               data-bs-toggle="tooltip"
                                               data-bs-placement="top"
                                               title="Edit Group">
                                                <i class="bx bx-edit-alt"></i>
                                            </a>

                                            <!-- Move To Trash -->
                                            <a asp-action="MoveToTrash" asp-route-id="@item.Id"
                                               class="btn btn-sm btn-icon btn-outline-danger"
                                               data-bs-toggle="tooltip"
                                               data-bs-placement="top"
                                               title="Move to Trash"
                                               onclick="return confirm('Are you sure you want to move this arrival group to trash?');">
                                                <i class="bx bx-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Initialize Bootstrap 5 tooltips for the action icon buttons
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
        var tooltipList = tooltipTriggerList.map(function(tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl);
        });
    </script>
}