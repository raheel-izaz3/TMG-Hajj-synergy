@model POTicketFlightData

@{
    string modelName = "POTicketAirline";
    string modelNamePlural = "AirPort";
    string modelControllerRoute = "POTicketAirline";
    TMG.Data.TMGDbContext _db;
}


<div class="container-xxl flex-grow-1 container-p-y">
    <h4 class="fw-bold" style="color:  #404040;"><span class="text-muted fw-light"> @modelName / </span>  Edit</h4>

    <hr class="mb-4" />

    <div class="row">
        <div class="col-sm-12">
            <div class="card mb-4">
                <div class="card-body">
                    <form method="post">
                        <input type="hidden" asp-for="POTicketFlightDataId" />
                        <div class="row">
                            <div class="col-sm-4 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname" asp-for="FlightNumber"></label>
                                <div class="input-group input-group-merge">
                                    <span id="basic-icon-default-fullname2" class="input-group-text"><i class="bx bx-building"></i></span>
                                    <input asp-for="FlightNumber" class="form-control">
                                </div>
                                <span class="text-danger" asp-validation-for="FlightNumber"></span>
                            </div>
                            <div class="col-sm-4 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname">DepartureAirport</label>
                                <div class="input-group input-group-merge">
                                    <select asp-for="DepartureAirportId" class="form-control">
                                        <option value="value">Select Departure Airport</option>
                                        @foreach (Airport flightData in ViewBag.Airport)
                                        {
                                            <option value="@flightData.AirportId">@flightData.AirportName - (@flightData.Code)</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="col-sm-4 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname">ArrivalAirport</label>
                                <div class="input-group input-group-merge">
                                    <select asp-for="ArrivalAirportId" class="form-control">
                                        <option value="value">Select Departure Airport</option>
                                        @foreach (Airport flightData in ViewBag.Airport)
                                        {
                                            <option value="@flightData.AirportId">@flightData.AirportName - (@flightData.Code)</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="col-sm-4 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname">Airline</label>
                                <div class="input-group input-group-merge">
                                    <select asp-for="AirlineId" class="form-control">
                                        <option value="value">Select Airline</option>
                                        @foreach (Airline airline in ViewBag.Airline)
                                        {
                                            <option value="@airline.AirlineId">@airline.Name</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="col-sm-4 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname" asp-for="DepartureTime"></label>
                                <div class="input-group input-group-merge">
                                    <span id="basic-icon-default-fullname2" class="input-group-text"><i class="bx bx-building"></i></span>
                                    <input type="time" asp-for="DepartureTime" class="form-control">
                                </div>
                                <span class="text-danger" asp-validation-for="DepartureTime"></span>
                            </div>
                            <div class="col-sm-4 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname" asp-for="ArrivalTime"></label>
                                <div class="input-group input-group-merge">
                                    <span id="basic-icon-default-fullname2" class="input-group-text"><i class="bx bx-building"></i></span>
                                    <input type="time" asp-for="ArrivalTime" class="form-control">
                                </div>
                                <span class="text-danger" asp-validation-for="ArrivalTime"></span>
                            </div>

                            <div class="col-sm-12 mt-4">
                                <button type="submit" class="btn btn-success float-end">Save Changes</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>

</div>